ty/*.json\",\"test/flows/steps/*\"],\"outputs\":[\"scripts/release-gate.mjs\",\"test/unit/release-gate.test.mjs\",\"test/fixtures/release-gate/**\",\"test/integration/flow-complete.test.mjs\"],\"depends_on\":[\"T-001\",\"T-012\",\"T-029\"],\"write_scope\":[\"scripts/release-gate.mjs\",\"test/unit/release-gate.test.mjs\",\"test/fixtures/release-gate/**\",\"test/integration/flow-complete.test.mjs\",\"test/traceability/T-030.json\"],\"acceptance\":[\"AC-070\",\"AC-071\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-070\",\"node scripts/run-tests.mjs --ac AC-071\",\"node scripts/release-gate.mjs --ci-artifacts <dir> --smoke-report <file>\"],\"test_levels\":[\"unit\",\"integration\"]}]}}"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1198,"cache_read_input_tokens":95975,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1198},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"20d0d5e9-5917-459b-8072-687c02d6e593","uuid":"8d7891ad-5523-4d18-8a28-4cd0a3933428","timestamp":"2026-11-07T11:22:54.398Z","request_id":"req_011CgoU1ZGsQT7NkL3eNydDW"}
{"duration_api_ms":714221,"stop_reason":"end_turn","session_id":"20d0d5e9-5917-459b-8072-687c02d6e593","total_cost_usd":2.3656800000000002,"usage":{"input_tokens":16,"cache_creation_input_tokens":81340,"cache_read_input_tokens":453380,"output_tokens":81211,"output_tokens_details":{"thinking_tokens":35675},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":81340,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":79220,"cache_read_input_tokens":95975,"cache_creation_input_tokens":1198,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1198},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-opus-5-5":{"inputTokens":16,"outputTokens":81211,"cacheReadInputTokens":453380,"cacheCreationInputTokens":81340,"webSearchRequests":0,"costUSD":2.3656800000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":35675,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":81340,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":9,"subtype":"success","api_error_status":null,"result":"# CLIWorker v2 设计稿（第二轮修订，设计师，只读）\n\n这一轮没有改动、创建或删除任何文件。我重新读了 `lib/*.mjs`、`bin/cliworker.mjs`、`config/cliworker.example.json`、`package.json`、`.gitignore`、`dsh.plugin.json`，以及 `.collab/blueprint/cliworker-v2/` 下的上一轮产物和 review-v1 评审。另外确认了两点环境：本机 `pwsh` 是 7.6.9，`node` 是 v22.23.3。\n\n## 0. 本轮结论\n\n1. **契约提前到 M1 冻结。** 冻结后只许加字段，不许改。\n   - 所有错误码、退出码、警告码、拒选原因、risk 阈值表、draft 与 v1 的原因映射、可用性枚举，在 T-004 一次性写进 `lib/contract/registry.mjs`，并与 `contracts/registry.snapshot.json` 逐项比对。\n   - 后续任务不得修改注册表。如果需要新码，走蓝图变更，并递增 `snapshot_version`。\n2. **可注入缝也提前到 M1（T-003）。**\n   - `createContext` 提供可替换的 exec、fs、now、fetch、env、platform、stdout、stderr。\n   - `lib/cli.mjs` 改成 import-safe，导出 `main(argv, ctx)`。全仓只有 `bin/cliworker.mjs` 调 `process.exit`。\n   - 插件的注册结果可以查到，不再被 `console.error` 吞掉。\n   - 宿主契约写进 `contracts/host/dsh-host.v1.json`，测试用的宿主 stub 必须符合它。\n3. **预测公式一次写成最终形态（T-006，纯函数）。** M4 只负责提供数据（账本、CLI 读数、容量学习），不再改 `lib/forecast.mjs` 和 `lib/pools.mjs` 里的公式。M1 的测试只断言冻结的接口面和 draft 视图，M4 重写选模不会让它们返工。\n4. **unknown 的语义定死。**\n   - 没有样本时，`tasks_left` 一律为 null。按配置估出的值放进单独字段 `tasks_left_assumed`。\n   - risk 只能由任务数（tasks）、剩余比例（fraction）或美元余额（usd）三类依据推出，绝不由 assumed 推出。\n   - UI 把它显示成「unknown（估计 N，assumed）」。\n5. **HTTP 路由分两级。**\n   - AgentLine 级：只有 `POST /cliworker/select`，只输出 AgentLine 视图。\n   - 管理级：四条兼容路由里的 providers、models、forecast，`select` 的 `view:'full'` 或 `compat:'draft'`，以及全部 `/cliworker/api/*`。都要求 loopback 会话令牌，否则返回 `E_ADMIN_REQUIRED`。\n   - HTTP 响应和 CLI 输出用同一个扫描器检查。\n6. **租约可以跨进程使用。**\n   - 包装调用里同时带选模进程实际使用的绝对 `--config` 和 `--state-dir`。两个入口都用同一个 `resolvePaths` 求路径。\n   - 租约记录配置摘要，执行时摘要不一致返回 `E_LEASE_CONFIG_MISMATCH`。\n   - 第 i 个租约的 `expires_at = selected_at + lease_ttl_s + i × timeout_s`，所以 AgentLine 按顺序执行时，排在后面的不会先过期。\n   - 新增跨进程端到端验收（AC-064）：HTTP 选模，新进程执行 `calls[0]`，得到 event/v1 输出，再执行一次得到 `E_LEASE_CONSUMED`。\n7. **测试体系配齐。**\n   - 测试层级与目录一一对应。\n   - 发现校验改成集合相等。\n   - 跳过的用例写进结构化跳过清单，跳过永远不算通过。\n   - AC 到测试文件的追踪按任务拆成分片，避免多任务写同一文件。\n   - CI 矩阵是 3 个系统 × Node 20/22，性能作业单独跑、不作合并门禁。\n   - 泄露检查由一个共享 harness 承担，全流程测试会自动发现各步骤，每次 `npm test` 都重跑完整流程。\n   - 发布门禁由脚本按规则机读判定。\n\n## 1. 评审意见处理\n\n| 编号 | 处理 |\n|---|---|\n| F-01 | 新增 T-003：`lib/context.mjs`、import-safe 入口、`createPlugin` 返回注册报告、`getRegistration()` 可以查到失败；宿主 stub 契约在 `contracts/host/`。`scripts/check-seams.mjs` 限定 `node:child_process` 只能出现在 `lib/exec.mjs`；`node:fs` 只能出现在 `lib/context.mjs`、`lib/store.mjs`、`lib/fsx.mjs`；不带参数的 `Date.now` 和 `new Date` 只能出现在 `lib/context.mjs`；脚本带一个故意违规的自测夹具（AC-006/007/008） |\n| F-02 | 冻结前移到 T-004（M1），注册表加快照，删除或改名会让测试失败（AC-009/010）。T-002 先写特征化测试：稳定行为放在 `stable.test.mjs`，用 sha256 锁定、不许再改；每条缺陷单独一个文件，由修它的任务把断言翻转过来（AC-005） |\n| F-03 | 公式、取整、阈值表、置信度、分位数、错误码判定规则全部写进 interfaces 第 6～8 节和注册表；每条 AC 只有唯一预期值（AC-015～019、AC-053） |\n| F-04 | CI 断言改成结构不变量：exec 计数、预留之和 ≤ 剩余、行数和 id 唯一、重放结果相同、用文件屏障代替 sleep。性能单独作业，`npm run perf` 不作门禁。补 lockfile，CI 矩阵由 `ci-matrix.json` 生成并校验。pwsh 已确认可用，而且 `check-fast.ps1` 只是包一层 `node scripts/check-fast.mjs`，没有 pwsh 也能跑（AC-002/003/028/054/055） |\n| F-05 | 路由分级、管理入口门控、HTTP 响应递归扫描（AC-059）；CLI 侧完整视图只在 `admin select` 提供（AC-056） |\n| F-06 | 见第 0 节第 6 条和第 11 节（AC-058、AC-064） |\n| F-07 | 见第 0 节第 4 条（AC-018、AC-062） |\n| F-08 | draft 视图的 Heavy 拒选只断言拒选集合和原因，不断言排序（AC-021）；排序只由 M4 的策略金标断言（AC-051）。forecast 按模型记忆化，计数器统计的是调用次数，不是调用点（AC-020） |\n| F-09 | 见第 2 节勘误 |\n| F-10 | `test/helpers/leak-scan.mjs` 统一做字节扫描（stdout、stderr、state_dir 全部文件、audit、HTTP）和只走 env、不进 argv 的断言，并带 canary 自测；`test/flows/steps/*.mjs` 每个步骤一个文件，由全流程测试自动发现；M5 断言步骤集合与必需集合相等（AC-031、AC-071）。视图扫描规则：键名精确匹配，值按整词匹配，`call` 子树不参与值扫描，但必须逐项等于包装模板（AC-011） |\n| F-11 | 层级与目录对应，跳过清单格式 `cliworker.skip/v1`，每条 AC 指定基线平台，发布门禁规则（AC-070），smoke 有 dry-run 并在 `test/smoke/` 下（AC-069） |\n| F-12 | example 带 `_example:true` 和 `schema:'cliworker.config/v1'`。判定为示例配置的条件是：有这个标记，或解析后（忽略该标记）与 example 深相等，所以空白差异绕不过去。没有 schema 的配置一律按 v1 处理。两个入口对同一配置算出的 state_dir 必须相同（AC-012/013/034） |\n| F-13 | 不引入 devDependency。`check-unused` 用窄范围的词法检查，配故意未使用的导入和函数做自测（AC-022）。打包检查断言 `bin` 字段，以及 `npm pack` 不含 local 配置、state、jsonl、test、scripts（AC-025）。`check-docs` 只在仓库里运行，`doctor` 随包发布 |\n| F-14 | forecast/v1 新增 `tasks_left_basis`、`risk_basis`；`docs/migration.md` 写明语义变化，每个注册表里标为 `semantic_change` 的条目都必须在文档里有对应段落（AC-067） |\n| F-15 | 已确认，保留 |\n| F-16 | 接受降为 minor，但目录映射和追踪矩阵照做 |\n\n## 2. 现状勘误\n\n1. `lib/config.mjs:19` 抛出的 TypeError 不是来自 `&&` 条件。raw 为 null 时 `!raw` 已经短路，真正出错的是抛错模板字面量里对 `raw.schema` 的插值。另外第 19～21 行的三个 throw 都没有设 `error.code`。修法：先判断类型，再插值，并统一补上 `E_CONFIG`。\n2. `.gitignore` 现在只有字面的 `config/cliworker.local.json` 和 `usage.jsonl` 两行，没有通配。要改成 `config/*.local.json`、`state/`、`*.jsonl`，并用 `git check-ignore -v` 断言命中，同时断言 example 不被忽略。\n3. `run --lease`、`cli resolve`、包装调用目前都不存在，是 v2 的新功能，不是回归，按新功能单独立金标。\n4. `config/cliworker.local.json` 没有被 git 跟踪（`git ls-files` 里没有），是用户本机文件，不应删除。修法是加载时识别出它是占位配置，返回 `E_CONFIG_EXAMPLE`。\n5. `select.mjs` 有三处 forecast 调用点（:94、:102、:116），其中 :102 在排序比较器里，实际调用次数是 O(n log n)。修法是按模型记忆化。\n\n## 3. 模块分层\n\n| 位置 | 职责 |\n|---|---|\n| `lib/context.mjs` | 依赖注入 |\n| `lib/contract/` | 注册表、校验器、视图生成、扫描器 |\n| `lib/paths.mjs`、`lib/config.mjs`、`lib/config-migrate.mjs` | 路径与配置 |\n| `lib/store.mjs`、`lib/lock.mjs`、`lib/audit.mjs`、`lib/redact.mjs`、`lib/fsx.mjs` | 存储、锁、审计、脱敏、带拒读清单的 fs |\n| `lib/exec.mjs` | 唯一的子进程出口 |\n| `lib/secrets/` | 令牌引用与平台后端 |\n| `lib/discovery/` | 平台识别、CLI 识别规则、扫描、WSL 枚举 |\n| `lib/models/` | 按 CLI 的模型枚举 |\n| `lib/adapters/` | 按 CLI 生成调用、解析输出 |\n| `lib/catalog.mjs` | 白名单、等级、别名、弃用 |\n| `lib/probe.mjs`、`lib/availability.mjs` | 真实探测与可用性 |\n| `lib/pools.mjs`、`lib/forecast.mjs` | 额度池与预测（纯函数，M1 定稿） |\n| `lib/usage.mjs`、`lib/usage-readers/`、`lib/capacity.mjs` | 账本、额度读数、容量学习 |\n| `lib/select.mjs`、`lib/select-draft.mjs`、`lib/policy.mjs`、`lib/leases.mjs` | 选模、draft 兼容、策略、租约 |\n| `lib/runner.mjs`、`lib/events.mjs` | 执行器与输出归一 |\n| `lib/index.js`、`lib/http/`、`lib/health.mjs` | 插件、路由、健康检查 |\n| `lib/cli.mjs`、`lib/commands/<cmd>/<sub>.mjs` | 命令路由 |\n| `ui/` | 管理界面 |\n\n## 4. 可注入缝与入口\n\n- **业务函数的签名统一为 `fn(input, ctx)`。** 测试用的 `test/helpers/ctx.mjs` 提供带计数的假 exec、fs、fetch，固定时钟，以及内存 stdout。\n- **插件入口：**\n  - `lib/index.js` 导出 `apply(ctx, config)` 和 `createPlugin(hostCtx, settings, deps)`。\n  - `createPlugin` 返回 `{registered:[...], errors:[...]}`，结果存进模块状态，`getRegistration()` 可以读到。\n  - 配置 `strict:true` 时，注册失败直接抛出；否则 health 显示 `registration:'failed'`，状态为 degraded。\n- **CLI 入口：** `bin/cliworker.mjs` 只做两件事：调用 `main(process.argv.slice(2), createContext())`，再用返回的 exitCode 调 `process.exit`。\n\n## 5. 契约冻结\n\n- **T-004 一次性登记 interfaces 第 5 节的全部码与枚举。**\n- **`npm run snapshot:update` 是唯一的快照更新入口。** 测试规则：\n  - 有删除，或改名（等于一删一增）：失败。\n  - 新增项未进快照：失败。\n  - 快照的 `snapshot_version` 没有递增：失败。\n- **`contracts/examples/`** 下包含正例、反例和 draft 样例，反例要断言具体的错误路径。\n- **`contracts/agentline-forbidden.json`** 是 AgentLine 视图的禁用键表。值的禁用表在运行时由当前目录生成（模型 id、key、CLI 可执行名），不写死。\n- **扫描语义：**\n  - 键：在所有对象和数组深度上做大小写不敏感的精确匹配。\n  - 值：按 `[^A-Za-z0-9._-]` 切词，整词匹配。所以 `cliworker`、`config`、`dsh-CLIWorker` 都不会误报。\n  - `call` 子树不做值扫描，但必须逐项等于包装模板。\n\n## 6. 边界与路由分级\n\n**AgentLine 只接触以下内容：**\n- 请求：`level`、`count`、`usage`、`importance`、`require_readonly`、`cwd`、`timeout_ms`、`request_id`、`exclude_handles`。\n- 响应：不透明的 `handle_id` 和 `lease_id`、包装后的 `call`、`rejected` 中的不透明引用和原因码、错误码。\n\n**路由：**\n\n| 级别 | 路由 | 鉴权 |\n|---|---|---|\n| AgentLine 级 | `POST /cliworker/select` | 不需要，只输出 AgentLine 视图；请求带 `view:'full'` 或 `compat:'draft'` 而没有会话时，返回 403 `E_VIEW_FORBIDDEN` |\n| 管理级 | `GET /cliworker/providers`、`GET /cliworker/models`、`GET /cliworker/forecast`、`/cliworker/api/*`、`/cliworker/ui` | 需要 `x-cliworker-session` |\n| 公共 | `GET /cliworker/health` | 不需要，只输出状态，不含 provider 细节 |\n\n- 会话令牌由 `GET /cliworker/api/session` 签发，只对 loopback 来源签发，保存在进程内存里。\n- 写接口还需要 `x-cliworker-csrf`；插件为 readonly 时返回 `E_READONLY`。\n\n**CLI：**\n- `models select` 默认输出 AgentLine 视图。\n- 完整视图只在 `admin select` 提供。\n- `compat:'draft'` 保留到 0.3.0，带 `W_DRAFT_DEPRECATED` 警告。\n\n**消费者：**\n- AgentLine 使用 CLI 的 `models select` 或 HTTP 的 `POST /cliworker/select`。\n- 管理界面使用 `/cliworker/api/*`。\n- 旧版 UI 改用管理会话；迁移写在 `docs/migration.md`。\n\n## 7. Provider 层\n\n**平台识别：**\n- win32、darwin、linux 由 `process.platform` 判断。\n- 在 linux 下，`/proc/version` 含 microsoft，或存在 `WSL_DISTRO_NAME`，判为 wsl。\n\n**WSL 跨发行版：**\n- 用 `wsl.exe -l -q` 列发行版，输出按 UTF-16LE 解码，去掉 BOM、NUL 和 CRLF。\n- 对每个发行版执行 `wsl.exe -d <d> --exec sh -c <常量脚本>`，只查 `command -v` 和版本。\n- 每个发行版生成独立条目，platform 为 `wsl:<d>`。\n\n**扫描范围：**\n- PATH 各段（Windows 上考虑 PATHEXT）。\n- 常见安装目录：npm 全局、`~/.local/bin`、`/usr/local/bin`、`/opt/homebrew/bin`、`~/.bun/bin`、`~/.cargo/bin`、`%LOCALAPPDATA%/Programs`、`/Applications/*.app` 内的 bin。\n- 配置里的 `extra_dirs`。\n\n**识别规则表：**\n- 规则表只是数据：id、候选可执行名、版本参数、认证状态命令、枚举策略、适配器 id，不含任何模型表。\n- 覆盖 11 个已知 CLI：codex、claude、dsh、cursor（cursor-agent 或 agent）、codebuddy、antigravity、trae、zcode、qoder、kimi、opencode。\n- 冷门 CLI 的可执行名先作为候选，由真机采集的夹具确认，可用 `cli_overrides` 覆盖。\n\n**未知 CLI：** 文件名命中 `unknown_patterns` 的标为 `recognized:false`，证据只有路径、大小和修改时间。默认不执行，只有加 `--probe-unknown` 时才跑 `--version`。\n\n**凭据保护：**\n- 所有文件读取都经过 `lib/fsx.mjs`，凭据路径的拒读清单（例如 `~/.claude/.credentials.json`、`~/.codex/auth.json`）命中即拒。\n- 认证状态只通过 CLI 自己的 status 命令获得，只记录布尔结果和脱敏摘要。\n\n**清单落盘：**\n- 写到 `state_dir/inventory.json`（`cliworker.inventory/v1`）。\n- 指纹包括大小、修改时间、实际路径。指纹不变且在 TTL 内就不重新执行；找不到的 CLI 标为 gone，不删除；`--full` 强制全量刷新。\n\n**安全执行（`lib/exec.mjs`）：**\n- 任何地方都不用 `shell:true`。\n- win32 的 `.cmd` 垫片（npm v6、v7+、pnpm、bun）先解析出 node 和脚本路径，直接执行。\n- 解析不了时才走 `cmd.exe /d /s /c`，且参数必须匹配 `^[A-Za-z0-9_./:=@+,-]+$`，否则返回 `E_UNSAFE_ARG`。\n- 超时后杀整棵进程树；并发上限默认 4。\n\n**模型枚举：**\n- 每个 CLI 按顺序尝试：子命令、`--help` 中 `--model` 的可选值、非凭据的本地缓存、官方 API（令牌来自 SecretRef）。\n- 全部失败时回退到手工补录（`source.kind:'manual'`），并给出 `W_MODELS_MANUAL_REQUIRED`。\n- `scripts/check-no-model-table.mjs` 禁止 `lib/` 下出现模型 id 字面量表。\n\n**调用适配器：**\n- `buildCall` 按平台返回参数数组形式的调用：command、args、cwd、input、只读方式、需要的环境变量名。\n- `parseEvent` 把输出归一成 `cliworker.event/v1`。\n- WSL 用 `--cd` 和 `--exec`，不拼 shell 字符串。\n- 参数形态确认不了时返回 `call:null` 和 `adapter_unverified`，对应模型不可选。\n\n**真实探测：**\n- 发一条要求原样回复 `OK-<nonce>` 的极小提示。\n- 判定结果：callable、blocked（auth 或 quota）、unavailable、deprecated；报告的模型与请求不一致时，identity 记为 mismatch，判 blocked。\n- 只在超时时重试一次。\n- 探测消耗以 `kind:'probe'` 记入账本，幂等键为 `probe:<probe_id>`。\n- callable 过了 TTL 后，选模时按 `availability_stale` 拒选。\n\n## 8. 模型目录\n\n- 白名单 `catalog.allow` 是唯一入口。不在白名单的模型不探测、不计费、不进预测，也不出现在候选和 AgentLine 视图的 `rejected` 里；管理视图里仍可见，标为 `not_allowed`。\n- 等级来源优先级：config > measured > cli，记录 `level_source`（kind、ref、at）。白名单里没有等级的模型以 `level_unassigned` 拒选。\n- 别名解析到同一个 key；弃用模型的可用性为 deprecated。\n- 价格标注来源，只用于付费池换算和同类排序的平手比较。\n\n## 9. 额度与预测（公式定稿，`lib/pools.mjs` 和 `lib/forecast.mjs` 纯函数）\n\n**单位与 token 计数：**\n- 1 Mtok = 1,000,000 tokens。\n- 计费 token = `input + output + cache_write + cache_read_weight × cache_read`，`cache_read_weight` 默认 0。\n\n**剩余量：**\n- `remaining_mtok(m) = min_p cap_p(m) × (1 − used_p)`，`used_p` 截到 [0, 1]。\n- 中间计算不取整；输出保留 3 位小数，四舍五入（远离零）。\n\n**`used_p` 的取法：**\n- 有新鲜读数（`age ≤ reading_ttl_s`，默认 600）时：`used_p = reading + Σ(读数之后的账本行) tokens_i / (cap_p(model_i) × 1e6)`。\n- 没有时：`used_p = Σ(窗口内的账本行) tokens_i / (cap_p(model_i) × 1e6)`。\n- 窗口内只要有一行的模型容量未知，`used_p` 就是 unknown，reason 为 `ledger_capacity_unknown`。\n\n**四种额度形状的归一：**\n- `remaining_pct`：剩余比例 = pct/100，换成 Mtok 需要容量。\n- `remaining + unit:'credits'`：Mtok = remaining / `credits_per_mtok`。没有换算率时：remaining ≤ 0 判 exhausted，否则 unknown，reason 为 `credits_conversion_missing`。\n- `remaining_usd`：`tasks_left = floor(remaining_usd / 每任务平均成本)`，basis 为 usd。\n- `unit:'tokens'`：remaining / 1e6。\n\n**每任务用量与分位数：**\n- 分位数用 nearest-rank：`sorted[ceil(p × n) − 1]`，n ≥ 3 才有效。\n- Heavy、Normal、Light 分别取 p90、p50、p25。\n- `tasks_left = floor(remaining_mtok / 分位数)`，basis 为 tasks。\n\n**risk 阈值表：**\n\n| 依据 | exhausted | critical | low_reserve | ok |\n|---|---|---|---|---|\n| tasks | ≤ 0 | 1～2 | 3～5 | ≥ 6 |\n| fraction | ≤ 0 | < 0.05 | < 0.15 | 其余 |\n\n- 优先级：tasks > usd > fraction > unknown。\n\n**样本不足时：**\n- `tasks_left` 为 null。\n- `tasks_left_assumed = floor(remaining_mtok / policy.usage_estimate_mtok[usage])`，basis 为 assumed，confidence 为 none。\n- risk 只能来自 fraction 依据，或为 unknown。\n\n**置信度：**\n\n| 样本数 n | 置信度 |\n|---|---|\n| 0 | none |\n| 1～4 | low |\n| 5～19 | medium |\n| ≥ 20 | high（每任务 token 的变异系数 > 1 时降为 medium） |\n\n**消耗速度与耗尽时间：**\n- `burn_mtok_per_hour` = 窗口内已用 Mtok / max(距窗口起点的小时数, 1/60)；滚动窗口的起点是窗口内最早一条样本。\n- `eta_exhaust_at = now + remaining / burn`；burn 为 0 时为 null。\n- `exhausts_before_reset = eta < reset_at`，任一项未知时为 null。\n\n**重置时间：** 来源优先级 cli > config > estimated（滚动窗口为最早样本 + 窗口长度）> unknown，并标注 `reset_source`。窗口过期后 `used_p` 归零。\n\n**容量学习（`lib/capacity.mjs`，M4）：**\n- 只用 Δfraction ≥ 0.01 的读数对。\n- `cap = Σtokens / Σ Δfraction / 1e6`。\n- 读数对数 k < 3 为 low，3～9 为 medium，k ≥ 10 为 high；`source:'measured'`。\n\n## 10. 选模策略与租约（M4）\n\n**过滤条件：** 在白名单内、等级匹配、callable 且未过 TTL、identity 已验证、只读能力满足、没被排除、适配器已确认。\n\n**预计用量：** `est` 取分位数，样本不足时取 assumed 值。\n\n**每个池的可用量：** `avail_p = remaining_p − 有效预留 − (importance 为 normal 时 reserve_fraction_for_high × cap_p)`。\n\n**分类与排序：**\n\n| 类别 | 条件 | 类内排序 |\n|---|---|---|\n| A | 计划内池全部已知且 min avail ≥ est | 紧迫度 = min_p remaining_p / max(reset_in_h_p, 0.25) 降序，再按价格升序、key 升序 |\n| B | 计划内剩余量未知，且 `unknown_policy` 为 `after_known` | key 升序 |\n| C | 付费池已知且 ≥ est，标 `funding:'paid'` | 价格升序、key 升序 |\n\n**拒选原因：**\n- `quota_low`：已知，但各类都装不下。\n- `reserve_protected`：只有动用储备才够，而 importance 为 normal。\n- `quota_unknown_policy`：剩余量未知，且策略为拒选。\n\n**数量与多样性：** `count > 1` 时先按 `identity_group` 去重贪心选，再按顺序补齐。\n\n**数量不足与错误码：**\n- 选到的少于 count：`ok:true`、`truncated:true`、`shortfall`。\n- 一个都没选到：\n  - 至少有一个候选通过了全部非额度过滤，且全部因额度原因被拒 → `E_INSUFFICIENT_QUOTA`。\n  - 否则 → `E_NO_CANDIDATE`。\n  - `retry_after` = 被额度拒选的池中最早的 `reset_at`，没有则为 null。\n\n**租约：**\n- 选中后预留 `est`，写进加锁的 `leases.json`。\n- 相同 `request_id` 重放时返回原结果，不重复预留。\n- 选模只读缓存，不起子进程、不访问网络。\n\n## 11. 执行器与跨进程\n\n**包装调用：** `node <pkg>/bin/cliworker.mjs run --lease <id> --state-dir <abs> --config <abs>`。\n\n**`run` 的执行步骤：**\n1. 读取租约，核对配置摘要。\n2. 把租约标为 running。\n3. 用适配器生成直接调用，令牌只通过环境变量注入。\n4. 写任务前账本行，幂等键 `<lease>:pre`。\n5. 把输出归一成 event/v1。\n6. 写任务后账本行，幂等键 `<lease>:post`。\n7. 把租约标为 consumed。\n\n**租约过期：** 只针对还没开始执行的租约。\n\n**失败回写：** 认证失败或额度用尽时，把可用性置为 blocked，下一次选模就会避开。\n\n## 12. 密钥\n\n- SecretRef 三种形式：`env:NAME`、`keychain:<name>`（win32 用 DPAPI 经 pwsh，macOS 用 `security`，Linux 用 `secret-tool`）、`session`（只在插件进程内存里）。\n- `auth set` 从 stdin 或 `--from-env` 读取令牌，绝不经过 argv。\n- 后端不可用时报 `E_SECRET_BACKEND`，不回退成明文文件。\n- 配置里出现明文令牌，报 `E_CONFIG_SECRET_INLINE`。\n- 所有输出都经过 redact。\n- `auth status` 只显示 set 或 unset。\n\n## 13. 界面与实时数据\n\n**六列：** 白名单开关、等级（含来源）、可用性（状态、时间、证据摘要）、余量（Mtok，按池展开）、刷新或重置时间、最近一次实测证据。\n\n**数据怎么来、怎么刷新：**\n- 页面每 15 秒拉一次 `api/snapshot?since=rev`。这个接口只读状态文件，不触发探测。\n- 发现、枚举、探测、读取额度通过 job 接口异步执行，前端轮询 job 状态。\n\n**怎么显示失败和缺数据：**\n- 每个值都带 source 和 at，按 TTL 显示 fresh、stale 或 unknown。\n- 刷新失败时显示最近一次错误和时间，保留上次的值但标为 stale。\n- 缺样本一律显示 unknown，不显示 0 或 100%。\n- assumed 显示为「unknown（估计 N，assumed）」。\n- 渲染逻辑写成纯函数 `ui/render.mjs`，方便单元测试。\n\n## 14. 可靠性与恢复\n\n- **原子写：** 先写临时文件再改名，Windows 上遇到 EPERM 会重试。\n- **锁：** 用 `wx` 创建，记录 pid 和时间戳。持有进程已死或超过 `lock_stale_ms` 的锁会被回收；等锁超时返回 `E_STATE_LOCKED`。\n- **启动时：** 回收陈旧锁，释放过期租约。\n- **升级：** 先把 state 备份到 `backup-<ver>-<ts>`，再按 `state/VERSION` 迁移。\n- **回滚：** 重装旧包，再执行 `state restore`。\n\n## 15. 测试体系\n\n**层级与目录：**\n\n| 层级 | 目录 |\n|---|---|\n| unit | `test/unit` |\n| integration | `test/integration` |\n| contract | `test/contract` |\n| e2e | `test/e2e` |\n| smoke | `test/smoke`（只测 dry-run） |\n| 特征化 | `test/characterization` |\n| 全流程 | `test/flows` |\n\n- `test/perf` 不进 `npm test`。\n- `test/fixtures` 和 `test/helpers` 不参与发现。\n\n**发现校验：** `scripts/reporters/files.mjs` 收集实际执行过的文件集合，与枚举出的集合做集合相等比较。\n\n**追踪：** 每个任务写自己的 `test/traceability/<T>.json` 分片。测试标题带 `[AC-xxx]`。`scripts/run-tests.mjs --ac AC-xxx` 只运行该 AC 关联的测试。\n\n**平台门控：** `test/helpers/platform-gate.mjs` 调用 `t.skip`，并把跳过记录写进 `CLIWORKER_TEST_OUT` 下的 `skips.jsonl`。默认输出目录在系统临时目录，CI 设到工作区再上传。\n\n**发布门禁（`scripts/release-gate.mjs`）：**\n- 每条 AC 都必须在它的基线平台上至少有一次 pass。\n- skip 永远不算 pass。\n- 任何 fail 都阻断发布。\n- 必需的 smoke 步骤被跳过，也阻断发布。\n\n## 16. 缺陷与成熟度对照\n\n**A 节缺陷：**\n\n| 缺陷 | 任务 | 验收 |\n|---|---|---|\n| A1 额度形状 | T-006、T-007 | AC-015、AC-021 |\n| A2 打包 | T-009 | AC-025 |\n| A3 测试脚本 | T-001 | AC-001 |\n| A4 落盘位置、`.gitignore`、占位配置、null 配置 | T-005 | AC-012～014 |\n| A5 重复的 cli/call 与重复 forecast | T-007 | AC-020 |\n| A5 未使用的导入 | T-007 | AC-022 |\n| A5 被静默忽略的字段 | T-008 | AC-024 |\n| A5 shell 风险 | T-010 | AC-026、AC-027 |\n| A5 无缓存 | T-022 | AC-055 |\n\n**E 节成熟度：**\n\n| 清单项 | 任务 |\n|---|---|\n| E1 契约 | T-004、T-022 |\n| E2 Provider 层 | T-010、T-013、T-016～T-020 |\n| E3 模型目录 | T-019 |\n| E4 用量与预测 | T-006、T-021 |\n| E5 插件形态 | T-003、T-024、T-027 |\n| E6 可靠性 | T-011、T-022、T-023、T-026、T-027 |\n| E7 测试 | T-001、T-002、T-012、T-015、T-029、T-030 |\n\n## 17. 待用户确认\n\n1. 冷门 CLI 的参数形态需要真机采集；采集之前一律按 `adapter_unverified` 处理，不可选。\n2. 每池容量由用户在配置里给出，或通过读数学习，不内置厂商数字。\n3. 管理会话只信任 loopback。如果 DSH 宿主在反向代理后面，需要宿主提供自己的鉴权。\n\n{\"interfaces\":\"【1 ModelRequest v1】CLI：cliworker models select --request-file <f>，或 --level Top --count 2 --usage Heavy --importance high --cwd <p> --request-id r-001；HTTP：POST /cliworker/select。{schema:'cliworker.request/v1', request_id:'r-001', level:'Top', count:2, usage:'Heavy', importance:'normal', require_readonly:true, cwd:'C:/work/repo', timeout_ms:1800000, exclude_handles:['h_1a2b']}。规则：level 必填，取 Top/High/Middle/Quick，大小写不敏感，缺失返回 E_LEVEL_REQUIRED，非法返回 E_LEVEL_UNKNOWN；count 取 1..10，默认 1；usage 取 Heavy/Normal/Light，默认 Normal；importance 取 normal/high，默认 normal，其他值返回 E_REQUEST_INVALID；未知字段给 W_FIELD_IGNORED:{field}；tier 是 level 的别名，给 W_FIELD_DEPRECATED；candidates 与 view 只在管理入口有效。不带 schema 或带 compat:'draft' 的请求得到 draft 视图并带 W_DRAFT_DEPRECATED，0.3.0 移除。【2 ModelSelection v1（AgentLine 视图）】成功：{schema:'cliworker.selection/v1', ok:true, request_id:'r-001', level:'Top', usage:'Heavy', count_requested:2, count_returned:1, truncated:true, shortfall:1, models:[ModelHandle], calls:[Call], rejected:[{ref:'c3', reason:'quota_low'}], warnings:[{code:'W_STALE_DATA', ref:'c2'}], error:null, generated_at:'2026-11-07T10:00:00Z'}。失败：{schema:'cliworker.selection/v1', ok:false, request_id:'r-001', models:[], calls:[], truncated:false, shortfall:2, rejected:[], error:{code:'E_INSUFFICIENT_QUOTA', message:'...', retryable:true, retry_after:'2026-11-07T15:00:00Z'}}。错误码规则：至少一个候选通过了全部非额度过滤，且全部因 quota_low、reserve_protected 或 quota_unknown_policy 被拒时返回 E_INSUFFICIENT_QUOTA，否则返回 E_NO_CANDIDATE；retry_after 取被额度拒选的池中最早的 reset_at，没有则为 null。【3 ModelHandle v1】{schema:'cliworker.handle/v1', handle_id:'h_9f2c', lease_id:'l_7d1e', level:'Top', label:'Top-1', readonly:true, expires_at:'2026-11-07T12:00:00Z', call:{command:'<node 绝对路径>', args:['<pkg>/bin/cliworker.mjs','run','--lease','l_7d1e','--state-dir','<abs state_dir>','--config','<abs config>'], cwd:'C:/work/repo', input:'stdin', output:'cliworker.event/v1', timeout_ms:1800000}}。calls[i] 与 models[i].call 深相等；expires_at_i = selected_at + lease_ttl_s + i * timeout_s。handle 只在同时满足三点时生成：call 非空、模型为 callable 且未过 TTL、额度检查通过。完整视图（admin select 或带会话的 HTTP）另加 detail:{model_key:'claude:claude-sonnet-5-5', cli:'claude', vendor:'anthropic', funding:'plan', pools:[], forecast:{}, direct_call:{command:'claude', args:['-p','--model','claude-sonnet-5-5','--output-format','stream-json','--verbose','--permission-mode','plan'], cwd:'C:/work/repo', input:'stdin', env_names:['ANTHROPIC_API_KEY']}}。draft 视图为 0.1 的扁平形状 key/provider/id/level/prices/quota/forecast/call，不含 cli 键。【4 Event v1（run 的 stdout，JSONL）】{schema:'cliworker.event/v1', seq:1, lease_id:'l_7d1e', type:'start', at:'...'}；type 取 start/text/usage/result/error；result 形如 {type:'result', ok:true, exit_code:0, text:'...', usage:{input_tokens:1200, output_tokens:300}}；error 形如 {type:'error', code:'E_PROVIDER_QUOTA', retryable:false, message:'...'}。【5 注册表（T-004 冻结，contracts/registry.snapshot.json，snapshot_version:1）】退出码：0 成功（含 truncated）；1 E_INTERNAL；2 E_REQUEST_INVALID, E_LEVEL_REQUIRED, E_LEVEL_UNKNOWN, E_SCHEMA_UNSUPPORTED, E_UNSAFE_ARG, E_UNKNOWN_COMMAND, E_VIEW_FORBIDDEN；3 E_CONFIG, E_CONFIG_EXAMPLE, E_CONFIG_EXISTS, E_CONFIG_SECRET_INLINE, E_SECRET_BACKEND；4 E_STATE_LOCKED, E_TIMEOUT（可重试）；5 E_NO_CANDIDATE, E_INSUFFICIENT_QUOTA（可重试）；6 E_LEASE_UNKNOWN, E_LEASE_EXPIRED（可重试，需重新申请）, E_LEASE_CONSUMED, E_LEASE_CONFIG_MISMATCH；7 E_PROVIDER_AUTH, E_PROVIDER_QUOTA, E_PROVIDER_FAILED；8 E_ADMIN_REQUIRED, E_READONLY, E_CSRF（对应 HTTP 403）；9 E_HEALTH_DEGRADED, E_SMOKE_DISABLED。警告码：W_FIELD_IGNORED, W_FIELD_DEPRECATED, W_CONFIG_V1, W_STALE_DATA, W_DRAFT_DEPRECATED, W_MODELS_MANUAL_REQUIRED, W_LEGACY_USAGE。v1 拒选原因：excluded, level_mismatch, level_unassigned, availability_unverified, availability_blocked, availability_unavailable, availability_stale, deprecated, identity_unverified, identity_mismatch, readonly_unavailable, adapter_unverified, quota_low, quota_unknown_policy, reserve_protected；not_allowed 只出现在管理视图。draft 拒选原因：excluded, not_in_workspace_order, level:<Level>, availability:<state>, identity_unverified, readonly_unavailable, E_FORECAST_EXHAUSTION。forecast 的 reason：no_samples, capacity_unknown, ledger_capacity_unknown, credits_conversion_missing, usd_samples_missing, reading_stale, window_unknown。risk 取 ok/low_reserve/critical/exhausted/unknown；risk_basis 取 tasks/usd/fraction/none；tasks_left_basis 取 tasks/usd/none。阈值表：tasks 依据下 ≤0 为 exhausted、1..2 为 critical、3..5 为 low_reserve、≥6 为 ok；fraction 依据下 ≤0 为 exhausted、<0.05 为 critical、<0.15 为 low_reserve、其余为 ok；优先级 tasks > usd > fraction > unknown。可用性取 unverified/callable/blocked/unavailable/deprecated；identity 取 verified/unverified/mismatch。语义变更标记（semantic_change）：forecast.tasks_left、forecast.risk。【6 额度池】{id:'claude:plan-5h', cli:'claude', kind:'plan_window', funding:'plan', window:{length_s:18000, anchor:'rolling', start_at:'...', reset_at:'...', reset_source:'cli|config|estimated|unknown'}, capacity_mtok:{'claude:claude-opus-5-5':{value:2, source:'config'}, 'claude:claude-sonnet-5-5':{value:10, source:'measured', confidence:'medium'}}, used_fraction:{value:0.5, source:'cli', at:'...'}, credits_per_mtok:null}。kind 取 plan_window/plan_weekly/credits/prepaid_usd；funding 取 plan/paid。v1 配置的 quotas 映射：remaining_pct 映射为计划内池，used=1-pct/100；remaining+credits 映射为 credits 池；remaining_usd 映射为 prepaid_usd 池；unit tokens 映射为容量已知的池。【7 forecast v1（只加字段）】{schema:'cliworker.forecast/v1', status:'known|unknown', model:'claude:claude-sonnet-5-5', remaining_mtok:5, remaining_fraction:0.5, pools:[{pool_id:'claude:plan-5h', remaining_mtok:5, remaining_fraction:0.5, reset_at:'...', reset_in_h:3, reset_source:'cli'}], tokens_per_task:{p25:0.05, p50:0.2, p90:0.9, n:12}, tasks_left:5, tasks_left_basis:'tasks', tasks_left_assumed:null, burn_mtok_per_hour:1.1, eta_exhaust_at:'...', exhausts_before_reset:false, risk:'ok', risk_basis:'tasks', confidence:'medium', reason:null, burn_per_task:0.42, samples:12}。公式：remaining(m)=min_p cap_p(m)*(1-clamp(used_p))；有新鲜读数（age<=reading_ttl_s，默认 600）时 used_p=reading+sum(读数之后的行) tokens_i/(cap_p(model_i)*1e6)，否则为窗口内的同样求和；窗口内任一行的模型容量未知时为 unknown(ledger_capacity_unknown)。计费 tokens=input+output+cache_write+cache_read_weight*cache_read，cache_read_weight 默认 0。分位数用 nearest-rank：sorted[ceil(p*n)-1]，n>=3；Heavy/Normal/Light 分别取 p90/p50/p25。tasks_left=floor(remaining/分位数)。样本不足时 tasks_left 为 null，tasks_left_assumed=floor(remaining/policy.usage_estimate_mtok[usage])，confidence 为 none，risk 只能来自 fraction 依据或为 unknown。confidence：n=0 为 none，1..4 为 low，5..19 为 medium，>=20 为 high（变异系数>1 时降为 medium）。burn=窗口内已用 Mtok/max(距窗口起点的小时数,1/60)；eta=now+remaining/burn；输出保留 3 位小数，四舍五入远离零。容量学习：只用 Δfraction>=0.01 的读数对，cap=sum(tokens)/sum(Δfraction)/1e6，k<3 为 low，3..9 为 medium，>=10 为 high。【8 选模策略】est 取分位数，样本不足时取 assumed 值；avail_p=remaining_p-有效预留-(importance 为 normal 时 reserve_fraction_for_high*cap_p)。A 类：计划内池全部已知且 min avail>=est，按紧迫度 min_p remaining_p/max(reset_in_h_p,0.25) 降序，再按价格升序、key 升序。B 类：计划内剩余未知且 unknown_policy 为 after_known，按 key 升序。C 类：付费池已知且 >=est，标 funding paid，按价格升序、key 升序。count>1 时先按 identity_group 去重贪心选，再按顺序补齐。【9 用量行 cliworker.usage/v1（只加字段）】{schema:'cliworker.usage/v1', id:'u_1', idempotency_key:'l_7d1e:post', lease_id:'l_7d1e', model:'claude:claude-sonnet-5-5', pools:['claude:plan-5h'], kind:'task|probe|manual', input_tokens:1200, output_tokens:300, cache_read_tokens:0, cache_write_tokens:0, cost_usd:0.0081, pool_fraction_before:0.48, pool_fraction_after:0.5, at:'...'}。同一 idempotency_key 写入时返回已有 id，读取时只计一次。【10 cliworker.model/v1 与 inventory/v1】model：{schema:'cliworker.model/v1', key, id, cli, provider, vendor, aliases, allowed, level, level_source:{kind:'config|measured|cli', ref, at}, availability:{state, reason, at, ttl_s, evidence:{probe_id, cmd_redacted, exit, duration_ms, nonce_ok, reported_model, tokens}}, identity, capabilities:{context_tokens, readonly, stdin}, prices:{input_per_mtok, output_per_mtok, source}, source:{kind:'subcommand|help|cache|api|manual', ref, at}, deprecated}。inventory：{schema:'cliworker.inventory/v1', generated_at, host:{platform, arch, wsl_distros:[]}, entries:[{id, recognized, platform:'win32|darwin|linux|wsl:<d>', path, realpath, version, fingerprint:{size, mtime, realpath}, auth:{state:'logged_in|logged_out|token_ref|unknown', source:'cli_status'}, evidence:[{kind, cmd_redacted, exit, at, digest}], first_seen, last_seen, status:'present|gone'}]}。【11 配置 cliworker.config/v2 与路径】{schema:'cliworker.config/v2', state_dir:'./state', secrets:{kimi:{ref:'env:KIMI_API_KEY'}}, discovery:{extra_dirs:[], wsl:true, probe_unknown:false, unknown_patterns:['*-cli','*agent*'], cli_overrides:{}}, catalog:{allow:[], levels:{}, aliases:{}, deprecated:{}, manual:[]}, pools:[], policy:{probe_ttl_s:21600, lease_ttl_s:7200, reading_ttl_s:600, lock_stale_ms:30000, lock_wait_ms:5000, reserve_fraction_for_high:0.15, unknown_policy:'after_known|reject', usage_estimate_mtok:{Heavy:2, Normal:0.5, Light:0.1}, cache_read_weight:0, probe_schedule:null}}。resolvePaths({configPath, env})：configPath 依次取参数、CLIWORKER_CONFIG、CLIWORKER_HOME/config.json；state_dir 依次取显式值（相对路径按配置文件所在目录解析）、CLIWORKER_HOME/state/<sha256(规范化绝对路径，win32 下转小写) 前 12 位>。CLI 与插件共用这一个函数。没有 schema 或 schema 为 v1 的配置按 v1 处理，在内存中迁移并给 W_CONFIG_V1。带 _example:true，或解析后（忽略 _example）与随包 example 深相等的配置返回 E_CONFIG_EXAMPLE。【12 HTTP 路由分级】AgentLine 级：POST /cliworker/select，只输出 AgentLine 视图，带 view 或 compat 但无会话时返回 403 E_VIEW_FORBIDDEN。管理级（需要 x-cliworker-session，由 GET /cliworker/api/session 签发，只对 loopback 来源签发，保存在内存中）：GET /cliworker/providers、GET /cliworker/models、GET /cliworker/forecast?model=<key>、GET /cliworker/ui、GET /cliworker/api/snapshot?since=<rev>、GET /cliworker/api/jobs/<id>、POST /cliworker/api/discover|enumerate|probe|read-usage（返回 job_id）、POST /cliworker/api/allow|deny|level|alias|manual-model|pool、POST /cliworker/api/secret（只写，响应只有 state:'set'）。写接口另需 x-cliworker-csrf，readonly 时返回 E_READONLY。公共：GET /cliworker/health 返回 {status:'ok|degraded', checks:[{id, ok, detail}], registration:'ok|failed'}，不含 provider 细节。【13 CLI】init | paths | doctor | discover [--full] [--probe-unknown] | models enumerate|list|add|allow|deny|level|alias|probe|forecast|select | admin select | pools list|set | usage record|summary|import | cli resolve --model <key> --cwd <p> [--platform win32|darwin|linux|wsl:<d>] [--readonly] | run --lease <id> --state-dir <d> --config <c> | auth set <cli> [--from-env NAME]（不加该参数时从 stdin 读）|status|clear | config migrate --in <v1> --out <v2> | state backup|restore|migrate | --version。除 run 输出 JSONL 外，所有命令的 stdout 都是单个 JSON，错误体为 {ok:false, error:{code, message, retryable, retry_after}}，退出码按注册表。【14 宿主契约 contracts/host/dsh-host.v1.json】ctx.inject(['webServer'], fn(httpCtx))；httpCtx.effect(fn, name)；httpCtx.webServer.register({kind:'exact', path, handler(req,res)})。createPlugin(hostCtx, settings, deps) 返回 {registered:[path], errors:[{path, message}]}；getRegistration() 返回 {status:'ok|failed', registered, errors}；strict:true 时注册失败直接抛出。【15 测试设施格式】跳过记录：{schema:'cliworker.skip/v1', test, file, ac:'AC-027', requires:'win32|wsl|darwin|linux|pwsh|secret-tool|security', platform, node, reason, at}。追踪分片 test/traceability/<T>.json：{task:'T-006', entries:[{ac:'AC-015', files:['test/unit/pools.test.mjs'], baseline:['linux'], status:'planned|covered'}]}，baseline 可取 linux/win32/darwin/smoke。smoke 报告：{schema:'cliworker.smoke/v1', mode:'real|dry-run', version, platform, node, steps:[{id, mandatory, status:'pass|fail|skip', reason, duration_ms}], redacted:true}。全流程步骤 test/flows/steps/<id>.mjs 导出 {id, introduced_by, run(env)}，必需集合为 auth, doctor, discover, enumerate, probe, select, run, http-select, http-admin。test/helpers/ctx.mjs 提供 fakeExec（记录 argv 与 env 名，统计调用次数）、fakeFs（访问探针）、fixedNow、fakeFetch。\",\"risks\":\"R1 冷门 CLI（antigravity、trae、zcode、qoder、kimi）的可执行名与非交互参数可能与假设不同。缓解：规则表可用配置覆盖，用真机 --help 采集夹具确认，确认前一律 adapter_unverified、不可选。R2 多数 CLI 没有正式的用量接口。缓解：读数尽力而为并标注 source/at，否则用账本或 unknown，risk 绝不来自 assumed。R3 窗口语义不一（滚动、按周、credits）且彼此叠加。缓解：一个模型挂多个池时取最小剩余，估算出的重置时间标 estimated。R4 真实探测会消耗额度并可能触发风控。缓解：只探测白名单，默认手动触发，带 TTL，消耗记入账本。R5 win32 的 .cmd 垫片在 Node 20 修复 CVE-2024-27980 后不能直接 spawn。缓解：先解析垫片直接用 node 执行，否则走带参数白名单的 cmd.exe，其余参数报 E_UNSAFE_ARG。R6 OS 密钥后端缺失。缓解：报 E_SECRET_BACKEND，只允许 env 或 session，不落明文。R7 注册表冻结过早，后续发现需要新码。缓解：新码只能走蓝图变更，递增 snapshot_version 并更新迁移文档，实现任务不得自行修改注册表。R8 管理会话只信任 loopback，DSH 宿主若在反向代理后面会误判来源。缓解：doctor 检测代理头并告警，文档要求宿主自带鉴权，默认拒绝。R9 租约改为跨进程后会在多条路径上出错：配置路径不一致、count>1 时排在后面的调用过期、进程被杀后租约悬空。缓解：call 带绝对路径并核对配置摘要，按位置递延过期时间，启动时回收。R10 Windows 下的并发改名与锁（EPERM、杀毒软件占用）。缓解：原子写带重试，锁带 pid 和时间戳以便回收，并发测试用屏障而非 sleep。R11 GitHub 的 Windows runner 不一定有 WSL 发行版，原生 WSL 用例在 CI 上只能跳过。缓解：解析逻辑做全平台单测，原生用例的基线设为 smoke，由维护者真机冒烟承担，门禁不接受 skip。R12 check-unused 和 check-no-model-table 用词法检查，可能漏报或误报。缓解：范围限定在 lib/，配自测夹具，局限写进 docs。R13 forecast 字段的语义变化会误导旧消费者。缓解：新增 basis 字段，在注册表中标 semantic_change，由 check-docs 强制迁移文档覆盖。R14 发现过程可能误执行恶意同名可执行文件。缓解：未识别的不执行；识别的只执行 --version 和 status，带超时，输出脱敏，文件读取走拒读清单。R15 用户本机的 config/cliworker.local.json 是占位数据，修复后会被拒绝加载，影响现有 AgentLine 集成。缓解：返回 E_CONFIG_EXAMPLE 并提示执行 init 或 config migrate，迁移文档写明步骤。\",\"task_graph\":{\"schema\":\"agentline.taskgraph/v1\",\"milestones\":[{\"id\":\"M1\",\"title\":\"基线：工程化、特征化、注入缝、契约冻结、修复 A 节全部缺陷\"},{\"id\":\"M2\",\"title\":\"基础设施：安全执行、状态存储、泄露检查 harness、密钥、配置 v2、provider 夹具\"},{\"id\":\"M3\",\"title\":\"Provider 层：发现、模型枚举、适配器、目录、真实探测\"},{\"id\":\"M4\",\"title\":\"用量与选模：账本与读数、选模策略与租约、执行器\"},{\"id\":\"M5\",\"title\":\"插件与交付：路由分级与健康检查、界面、跨进程 e2e、安装回滚、文档、smoke、发布门禁\"}],\"acceptance\":[{\"id\":\"AC-001\",\"text\":\"npm test 以 0 退出。run-tests 枚举 test 下 unit、integration、contract、e2e、smoke、characterization、flows 中的 *.test.mjs，排除 test/fixtures、test/helpers、test/perf。check-test-discovery 断言枚举集合与 reporter 实际执行的文件集合相等（集合相等，不是计数相等）。自测：故意放在 test/fixtures 下的 x.test.mjs 不会被执行。\",\"levels\":[\"unit\"]},{\"id\":\"AC-002\",\"text\":\"check-ci 校验 .github/workflows/ci.yml 是由 scripts/ci-matrix.json 生成的最新版本；矩阵含 os ubuntu、windows、macos 与 node 20、22，每格运行 npm run check；perf 作业单独存在且标为不阻断。\",\"levels\":[\"unit\"]},{\"id\":\"AC-003\",\"text\":\"node scripts/check-fast.mjs 按字母序执行 scripts/check-*.mjs（不含自身），最后执行 npm test。任一步非 0 时立即停止，输出该步名称并以该步的退出码退出。pwsh -NoProfile -File scripts/check-fast.ps1 只包一层 node 调用，并原样传递 $LASTEXITCODE。自测：注入一个失败步骤，两个入口都以同一个非 0 码退出。\",\"levels\":[\"integration\"]},{\"id\":\"AC-004\",\"text\":\"check-traceability 合并 test/traceability/*.json：AC 集合必须恰为 AC-001..AC-071；status 为 covered 的条目，其文件必须存在，且至少一个测试标题含对应的 [AC-xxx]；每条 AC 都声明 baseline。\",\"levels\":[\"unit\"]},{\"id\":\"AC-005\",\"text\":\"特征化测试：stable.test.mjs 通过 0.1 的库导出（selectModels、listModels、forecast、estimateCost）锁定保留行为（弃用和未验证模型不入候选、等级过滤、exclude 的原因、schema 名），其 sha256 记录在 test/characterization/frozen-files.json，check-frozen-files 在文件被修改时失败。A1..A5 每条缺陷各有一个 defects/<id>.test.mjs，在 M5 结束时全部断言已修复的行为。\",\"levels\":[\"unit\"]},{\"id\":\"AC-006\",\"text\":\"在子进程中 import lib/cli.mjs 与 lib/index.js：stdout 和 stderr 都是 0 字节，退出码 0。main(argv, ctx) 返回 {exitCode}，输出写入 ctx.stdout。lib 下没有任何 process.exit。\",\"levels\":[\"unit\"]},{\"id\":\"AC-007\",\"text\":\"check-seams 断言：lib 下只有 lib/exec.mjs 导入 node:child_process；只有 lib/context.mjs、lib/store.mjs、lib/fsx.mjs 导入 node:fs；不带参数的 Date.now 和 new Date 只出现在 lib/context.mjs。test/fixtures/seams 下的违规样例必须被报出。\",\"levels\":[\"unit\"]},{\"id\":\"AC-008\",\"text\":\"宿主 stub 通过 contracts/host/dsh-host.v1.json 的契约测试。createPlugin 返回已注册路径列表。stub 的 register 抛错时：report.errors 非空，getRegistration().status 为 failed；strict:true 时 apply 抛出；任何情况下都不能只把错误写进 console 就当通过。\",\"levels\":[\"contract\",\"integration\"]},{\"id\":\"AC-009\",\"text\":\"lib/contract/registry.mjs 与 contracts/registry.snapshot.json 深相等。contracts/examples 下的正例全部通过校验；每个反例都失败，且错误路径与样例声明一致。\",\"levels\":[\"contract\"]},{\"id\":\"AC-010\",\"text\":\"冻结规则测试：在注册表副本上删除一项、改名一项，compareRegistry 分别报告 removed、removed+added，测试失败；只新增但快照未更新时失败；snapshot:update 之后 snapshot_version 必须加 1，否则失败。拒选原因、risk 阈值、可用性、警告码、draft 映射都在注册表中。\",\"levels\":[\"contract\"]},{\"id\":\"AC-011\",\"text\":\"视图扫描器：禁用键在任意深度（对象、数组、warnings、error、rejected 内）都被检出，大小写不敏感精确匹配；禁用值按切词后的整词匹配目录里的模型 id、key 和 CLI 可执行名；call 子树不做值扫描，但必须逐项等于包装模板。canary：每个禁用键和值在深度 1 和 3 注入后都被检出；干净样例 0 命中；cliworker、config、dsh-CLIWorker 不会误报。\",\"levels\":[\"contract\",\"unit\"]},{\"id\":\"AC-012\",\"text\":\"resolvePaths 规则按 interfaces 第 11 节。cliworker paths --config X 与 createPlugin 使用 configPath X 时，报告完全相同的 config 绝对路径和 state_dir；两份不同的配置得到不相交的 state_dir；usage 写到该 state_dir；存在旧的 ~/.cliworker/usage.jsonl 时，doctor 给出 W_LEGACY_USAGE。\",\"levels\":[\"integration\",\"unit\"]},{\"id\":\"AC-013\",\"text\":\"git check-ignore -v 命中 config/a.local.json、state/x、a.jsonl，不命中 config/cliworker.example.json。加载带 _example:true 的配置返回 E_CONFIG_EXAMPLE、退出码 3；加载重新缩进过的 example 副本（无该标记）同样返回 E_CONFIG_EXAMPLE。init 遇到已存在的目标文件时返回 E_CONFIG_EXISTS，且文件不变。\",\"levels\":[\"unit\"]},{\"id\":\"AC-014\",\"text\":\"配置根为 null、[]、42、非 JSON，或缺 providers、缺 models 时，CLI 输出 ok:false、error.code 为 E_CONFIG、退出码 3，message 含配置文件绝对路径和原因；stderr 中没有 TypeError。defects/a4-null-config 已翻转为修复后的断言。\",\"levels\":[\"unit\"]},{\"id\":\"AC-015\",\"text\":\"额度形状金标：{remaining_pct:5} 且无容量时，remaining_fraction 为 0.05、remaining_mtok 为 null、risk 为 low_reserve、risk_basis 为 fraction；pct 为 4 时 risk 为 critical，pct 为 0 时为 exhausted，pct 为 15 时为 ok。{remaining:1, unit:credits} 无换算率时 risk 为 unknown、reason 为 credits_conversion_missing；remaining 为 0 时为 exhausted。{remaining:1, unit:credits, credits_per_mtok:1000} 加 3 个各 0.2 Mtok 的样本、usage 为 Normal 时，remaining_mtok 为 0.001、tasks_left 为 0、risk 为 exhausted、basis 为 tasks。{remaining:2000000, unit:tokens} 时 remaining_mtok 为 2。{remaining_usd:3} 加每任务 0.5 USD 的样本时，tasks_left 为 6、basis 为 usd。\",\"levels\":[\"unit\"]},{\"id\":\"AC-016\",\"text\":\"B.4.4 金标：5h 池中 opus 容量 2、sonnet 容量 10；used 为 0 时剩余 2 和 10，读数 0.5 时剩余 1 和 5。账本窗口内有 sonnet 的 1,000,000 tokens 时，used 为 0.1，剩余 1.8 和 9。读数 0.5 之后再有 1,000,000 tokens 时，剩余 0.8 和 4。窗口内有容量未知模型的行时为 unknown(ledger_capacity_unknown)。一个模型挂两个池时取最小值。输出保留 3 位小数。\",\"levels\":[\"unit\"]},{\"id\":\"AC-017\",\"text\":\"test/fixtures/forecast/*.json 的输入在固定 now 下产生的输出与 expected 深相等，覆盖：tasks 与 fraction 两张阈值表的全部边界值；nearest-rank 分位数且 n<3 时无效；置信度的全部区间与变异系数降级；burn_mtok_per_hour、eta_exhaust_at、exhausts_before_reset；Heavy、Normal、Light 分别取 p90、p50、p25。\",\"levels\":[\"unit\"]},{\"id\":\"AC-018\",\"text\":\"unknown 语义：没有样本时 tasks_left 为 null，tasks_left_assumed 按 usage_estimate_mtok 算出，basis 为 assumed，confidence 为 none；此时有剩余比例则 risk 只取 fraction 依据，否则为 unknown；任何测试都不能从 assumed 得到 ok、critical 等 risk。既无容量也无比例时 status 与 risk 都为 unknown，reason 属于注册表枚举。\",\"levels\":[\"unit\"]},{\"id\":\"AC-019\",\"text\":\"reset_at 按 cli > config > estimated（滚动窗口为最早样本 + 窗口长度）> unknown 取值并标注 reset_source；now 超过 reset_at 后 used_fraction 归零；固定 now 的夹具给出确定结果。\",\"levels\":[\"unit\"]},{\"id\":\"AC-020\",\"text\":\"draft handle 只有 call，没有 cli 键。在 12 个模型的夹具上，注入的 ctx.forecast 计数器（统计调用次数，不统计调用点）等于通过前置过滤的模型数，与排序时比较器被调用的次数无关。defects/a5-dup-call 和 a5-forecast-x3 已翻转。\",\"levels\":[\"unit\"]},{\"id\":\"AC-021\",\"text\":\"draft 视图在 usage 为 Heavy 时，用 AC-015 的夹具，risk 为 exhausted、critical 或 low_reserve 的模型全部进入 rejected，原因为 E_FORECAST_EXHAUSTION；Normal 和 Light 不因此拒选。断言只针对拒选集合与原因，不针对排序。defects/a1-quota 已翻转。\",\"levels\":[\"unit\"]},{\"id\":\"AC-022\",\"text\":\"check-unused 对 lib 报告 0 个未使用的导入和顶层函数；对 test/fixtures/unused 报告恰好其中声明的未使用导入和未使用函数。defects/a5-unused 已翻转。\",\"levels\":[\"unit\"]},{\"id\":\"AC-023\",\"text\":\"除 run 外，每个 CLI 命令的完整 stdout 都能被 JSON.parse 解析为单个值。按表驱动覆盖 CLI 可触发的注册表错误码（E_REQUEST_INVALID、E_LEVEL_REQUIRED、E_LEVEL_UNKNOWN、E_UNKNOWN_COMMAND、E_CONFIG、E_CONFIG_EXAMPLE），每个都是 ok:false、对应的 error.code、注册表规定的退出码。\",\"levels\":[\"integration\"]},{\"id\":\"AC-024\",\"text\":\"请求解析：--request、--request-file、--level/--count/--usage/--importance/--request-id 三种写法得到等价的请求；role 产生 W_FIELD_IGNORED 且 field 为 role；tier 产生 W_FIELD_DEPRECATED；importance 为非法值时返回 E_REQUEST_INVALID。把 README 中所有请求示例交给解析器，warnings 都为空。\",\"levels\":[\"unit\"]},{\"id\":\"AC-025\",\"text\":\"check-pack 解析 npm pack --dry-run --json：包含 bin/cliworker.mjs、config/cliworker.example.json、lib 下的文件、contracts 下的文件；package.json 的 bin.cliworker 为 bin/cliworker.mjs；不含 config/*.local.json、state/、*.jsonl、test/、scripts/、.collab/；dsh.plugin.json 的 version 与 package.json 一致。\",\"levels\":[\"integration\"]},{\"id\":\"AC-026\",\"text\":\"exec 层每次 spawn 都是 shell:false（由注入的 spawn 记录断言）。10 个敌意参数（& | ; ^ % ! 空格 双引号 换行 反引号）在直接执行时原样传递，在 cmd 回退路径上返回 E_UNSAFE_ARG。npm v6、npm v7+、pnpm、bun 四种 .cmd 垫片夹具都能解析出 {node, script}，这部分是纯单测，三平台都跑。\",\"levels\":[\"unit\"]},{\"id\":\"AC-027\",\"text\":\"win32 原生用例（其他平台写跳过记录）：带 a&b 参数的 .cmd 垫片被解析后直接用 node 执行，脚本收到的 argv 完全一致；不经 shell 直接 spawn .cmd 得到 EINVAL 的分支被捕获并转入解析路径。baseline 为 win32。\",\"levels\":[\"integration\"]},{\"id\":\"AC-028\",\"text\":\"超时：夹具脚本派生孙进程并写出 pid；得到 E_TIMEOUT 后，对子进程和孙进程 process.kill(pid,0) 都抛 ESRCH（轮询上限 5 秒）。并发上限 4 时运行 10 个任务：用 wx 计数文件观测到的最大并发 ≤ 4，且 10 个全部完成。不断言墙钟时间。\",\"levels\":[\"integration\"]},{\"id\":\"AC-029\",\"text\":\"20 个进程各追加 50 行后，1000 行全部可解析且 id 唯一。ctx.fs 在改名前抛错时，原文件字节不变。持有 pid 已死或超过 lock_stale_ms（注入时钟）的锁会被回收。活锁在等待 lock_wait_ms 后返回 E_STATE_LOCKED（注入时钟加屏障，不用 sleep）。\",\"levels\":[\"integration\",\"unit\"]},{\"id\":\"AC-030\",\"text\":\"redact 对 sk- 前缀、Bearer、三段 base64url 形状的 JWT、已登记的密钥值（包括嵌套对象和 error.message 里的）全部打码。audit.jsonl 每行有 at、entry（cli 或 http）、action、result；select、lease、run、probe、白名单与等级变更、密钥设置各写一行；用 leak-scan 检查不含已登记的密钥。\",\"levels\":[\"unit\"]},{\"id\":\"AC-031\",\"text\":\"leak-scan 的 canary 测试：把哨兵分别放进 stdout、stderr、state_dir 下深层文件、audit、HTTP 响应体、子进程 argv，每处都被检出并报告位置；干净运行 0 命中。flows 测试自动发现 test/flows/steps/*.mjs，在同一个临时 state_dir 中用 env 提供哨兵，依次运行全部已有步骤。\",\"levels\":[\"unit\",\"integration\"]},{\"id\":\"AC-032\",\"text\":\"flows 的 auth 步骤：auth set kimi --from-env SENTINEL 和从 stdin 设置两种方式都成功；fake-cli 的记录显示令牌只出现在适配器声明的环境变量里（sha256 一致），argv 中没有；leak-scan 在所有位置都 0 命中。\",\"levels\":[\"integration\"]},{\"id\":\"AC-033\",\"text\":\"配置中键名匹配 token、api_key、secret、password（不区分大小写）且值是字符串而非 SecretRef 时，返回 E_CONFIG_SECRET_INLINE。注入的 exec 让 secret-tool、security、pwsh 返回 ENOENT 时，对应后端返回 E_SECRET_BACKEND，state_dir 的文件列表不变。auth status 只输出 set 或 unset。三个平台后端的命令构造是纯单测；原生后端按平台门控。\",\"levels\":[\"unit\"]},{\"id\":\"AC-034\",\"text\":\"无 schema 和 schema 为 v1 的配置都在内存中迁移为 v2，并给 W_CONFIG_V1。config migrate 生成的 v2 文件中：models 转为 catalog.manual、allow 和 levels（level_source 为 config）；quotas 按 interfaces 第 6 节映射为 pools；providers 转为 cli_overrides。同一夹具迁移前后，在注入可用性的情况下 draft 选模结果深相等。\",\"levels\":[\"unit\"]},{\"id\":\"AC-035\",\"text\":\"fake-cli 生成器在当前平台为 11 个已知 CLI 和 1 个未知 CLI 生成可执行垫片（win32 为 .cmd 加 node，posix 为带 shebang 的脚本）；支持 ok、auth、quota、timeout、deprecated、mismatch 六种模式；--help、--version、模型列表输出都可配置；把 argv、环境变量名以及值的 sha256 写到记录目录。\",\"levels\":[\"integration\"]},{\"id\":\"AC-036\",\"text\":\"在夹具 PATH 和已知安装目录下发现 11 个已知 CLI，每个都记录 path、realpath、version、platform 和 evidence；未知 CLI 标为 recognized:false，对它的 exec 计数为 0；只有 --probe-unknown 时才执行它的 --version。\",\"levels\":[\"integration\"]},{\"id\":\"AC-037\",\"text\":\"平台识别表（process.platform、/proc/version、WSL_DISTRO_NAME 均注入）判定正确。wsl -l -q 的 UTF-16LE 夹具（含 BOM、CRLF、NUL、默认发行版标记）解析出发行版列表；每个发行版生成 platform 为 wsl:<d> 的独立条目；每个发行版调用的 args 与常量模板深相等，不含插值。\",\"levels\":[\"unit\"]},{\"id\":\"AC-038\",\"text\":\"原生 WSL 枚举（win32 且装有 WSL 时运行，否则写跳过记录）：列出的发行版与 wsl.exe -l -q 的结果一致，并且每个发行版都生成条目。baseline 为 smoke，由真机 smoke 的 wsl-discover 步骤承担。\",\"levels\":[\"integration\"]},{\"id\":\"AC-039\",\"text\":\"第二次运行 discover 时，指纹不变且在 TTL 内的条目 exec 计数为 0；被删除的 CLI 标为 gone 且条目保留；--full 重新执行；inventory.json 通过 inventory/v1 校验。\",\"levels\":[\"integration\"]},{\"id\":\"AC-040\",\"text\":\"discover 全程对拒读清单路径的 fsx 访问探针计数为 0；evidence 中只有 digest 和脱敏摘要，leak-scan 检查原始输出哨兵 0 命中。\",\"levels\":[\"integration\"]},{\"id\":\"AC-041\",\"text\":\"每个已知 CLI 的枚举器至少有一种策略（子命令、--help、缓存、API）的夹具测试；所有策略都失败时回退为 source.kind manual，并给 W_MODELS_MANUAL_REQUIRED；models add 录入后可以列出；归一字段 id、cli、vendor、capabilities、source.kind、source.at 齐全。\",\"levels\":[\"unit\"]},{\"id\":\"AC-042\",\"text\":\"check-no-model-table 对 lib 报告 0 个模型 id 字面量表，对 test/fixtures/model-table 下的违规样例报出。\",\"levels\":[\"unit\"]},{\"id\":\"AC-043\",\"text\":\"每个已知 CLI 在 win32、darwin、linux、wsl:Ubuntu 上的 buildCall 输出与 test/fixtures/adapters/golden 深相等；cwd 含空格和单引号时结果正确；wsl 用 --cd 和 --exec，任何参数都不同时含 cd 和 &&；cli resolve 返回带模型的 direct_call，以及 pwsh 和 posix 两种展示串，posix 展示串经纯函数解析后与 args 一致。\",\"levels\":[\"unit\"]},{\"id\":\"AC-044\",\"text\":\"参数形态未确认的 CLI，buildCall 返回 call:null 和 adapter_unverified；在选模夹具中，这类模型只出现在 rejected 里，models 和 calls 中没有对应的 handle。\",\"levels\":[\"unit\"]},{\"id\":\"AC-045\",\"text\":\"不在白名单的模型不出现在候选、AgentLine 视图的 rejected、探测队列和 forecast 输入中（注入计数器为 0）；管理视图中可见，标为 not_allowed。\",\"levels\":[\"unit\"]},{\"id\":\"AC-046\",\"text\":\"等级来源优先级 config > measured > cli，并记录 level_source 的 kind、ref、at；白名单中没有等级的模型以 level_unassigned 拒选；别名解析到同一个 key；弃用模型可用性为 deprecated，并以 deprecated 拒选。\",\"levels\":[\"unit\"]},{\"id\":\"AC-047\",\"text\":\"fake-cli 各模式的探测结果：ok 为 callable，auth 为 blocked(auth)，quota 为 blocked(quota)，timeout 和 enoent 为 unavailable，deprecated 为 deprecated，mismatch 为 identity mismatch 且 blocked。只有 timeout 时 exec 计数为 2，其他都为 1。evidence 字段齐全并带 nonce_ok。过了 TTL 的 callable 在选模时以 availability_stale 拒选。\",\"levels\":[\"integration\"]},{\"id\":\"AC-048\",\"text\":\"只有白名单模型被探测；每次探测写一行 kind 为 probe、幂等键为 probe:<probe_id> 的用量记录，并计入所属池的 used；同一次探测重放不会重复计入。\",\"levels\":[\"integration\"]},{\"id\":\"AC-049\",\"text\":\"同一 idempotency_key 写入两次时返回同一个 id，读取时只计一次。codex 会话文件夹具和 claude 事件夹具解析出 {used_fraction, reset_at, source:cli, at}；读数超过 reading_ttl_s 时被视为过期，forecast 改用账本计算，并给 W_STALE_DATA。\",\"levels\":[\"unit\"]},{\"id\":\"AC-050\",\"text\":\"容量学习金标：Δfraction<0.01 的读数对被丢弃；cap=sum(tokens)/sum(Δfraction)/1e6；k 为 2、3、10 时置信度分别为 low、medium、high；source 为 measured；输出与 expected 深相等。\",\"levels\":[\"unit\"]},{\"id\":\"AC-051\",\"text\":\"策略金标 test/fixtures/policy/*.json 的输出顺序与 expected 深相等。P1：计划内池 A 剩余 3、1 小时后重置，计划内池 B 剩余 8、4 小时后重置，付费池 C，est=1，顺序为 A、B、C，C 标 funding paid。P2：A 剩余 0.5<est，A 以 quota_low 拒选，选中 C。P3：计划内剩余未知、策略 after_known 时排在已知可完成的之后，策略 reject 时以 quota_unknown_policy 拒选。P4：count=2 时优先选不同的 identity_group。\",\"levels\":[\"unit\"]},{\"id\":\"AC-052\",\"text\":\"储备：cap 10、reserve_fraction 0.15、remaining 2、est 1 时，normal 以 reserve_protected 拒选，high 被选中；储备比例取自配置。\",\"levels\":[\"unit\"]},{\"id\":\"AC-053\",\"text\":\"可用数小于 count 时返回 ok:true、truncated:true，shortfall 等于差额。一个都没有时，按 interfaces 第 2 节的规则返回 E_INSUFFICIENT_QUOTA 或 E_NO_CANDIDATE（两个夹具各对应唯一结果），retry_after 等于被额度拒选的池中最早的 reset_at。models 与 calls 一一对应且深相等。每个 handle 都满足三点：call 非空、callable 未过 TTL、额度通过。\",\"levels\":[\"contract\",\"unit\"]},{\"id\":\"AC-054\",\"text\":\"50 个进程等文件屏障打开后同时选模：每个池的有效预留之和 ≤ 剩余量；用相同 request_id 重放返回深相等的 handle，预留不增加；用 exclude_handles 再次申请能补足数量且不重复。全程不用 sleep。\",\"levels\":[\"integration\"]},{\"id\":\"AC-055\",\"text\":\"在 50 个白名单模型的夹具上，选模过程中注入的 exec 和 fetch 计数都为 0；defects/a5-nocache 已翻转。p95 只由 npm run perf 测量并作为报告产出，不作门禁。\",\"levels\":[\"unit\"]},{\"id\":\"AC-056\",\"text\":\"所有 contracts/examples，以及 AC-051..053 各夹具在 AgentLine 视图下的实际输出，经视图扫描器检查都是 0 命中；models select 带 view:full 时返回 E_VIEW_FORBIDDEN；admin select 返回含 detail 的完整视图；compat:draft 返回 draft 形状并带 W_DRAFT_DEPRECATED。\",\"levels\":[\"contract\"]},{\"id\":\"AC-057\",\"text\":\"run --lease 的 stdout 每行都通过 event/v1 校验，最后一行是带 usage 的 result；账本有 <lease>:pre 和 <lease>:post 两行，并带池读数；stdin 透传给 fake-cli，fake-cli 记录到的 cwd 等于 handle 的 cwd。\",\"levels\":[\"integration\"]},{\"id\":\"AC-058\",\"text\":\"已成功的租约再次 run 返回 E_LEASE_CONSUMED，退出码 6，账本行数不变。fake-cli 为 auth 或 quota 模式时返回 E_PROVIDER_AUTH 或 E_PROVIDER_QUOTA，可用性被置为 blocked，下一次选模以 availability_blocked 拒选。timeout 模式时整棵进程树被杀，返回 E_TIMEOUT。过期租约返回 E_LEASE_EXPIRED。--config 与租约记录的配置摘要不一致时返回 E_LEASE_CONFIG_MISMATCH。\",\"levels\":[\"integration\"]},{\"id\":\"AC-059\",\"text\":\"用宿主 stub 加载插件：POST /cliworker/select 返回 AgentLine 视图，扫描 0 命中；没有会话时，providers、models、forecast、api 下全部接口、带 view 的 select 都返回 403 和 E_ADMIN_REQUIRED 或 E_VIEW_FORBIDDEN；loopback 会话可以访问；伪造非 loopback 来源请求 session 时返回 403。\",\"levels\":[\"integration\"]},{\"id\":\"AC-060\",\"text\":\"readonly 时所有写接口返回 403 E_READONLY；缺 csrf 头时返回 403 E_CSRF；flows 的 http-select 和 http-admin 步骤中，leak-scan 对 HTTP 响应体的哨兵检查 0 命中。\",\"levels\":[\"integration\"]},{\"id\":\"AC-061\",\"text\":\"doctor 与 /cliworker/health 都报告：配置有效性、state_dir 是否可写、锁状态、密钥后端、清单年龄、过期探测数量、注册状态。注入任一故障时，doctor 以 E_HEALTH_DEGRADED 退出（退出码 9），health 返回 status degraded，并列出故障项。\",\"levels\":[\"integration\",\"unit\"]},{\"id\":\"AC-062\",\"text\":\"ui/render.mjs 的纯函数测试：六列齐全；缺失或过期的值显示 unknown 或 stale，并附 source 和 at；输出中不出现由缺失数据生成的 0 或 100%；assumed 渲染为「unknown（估计 N，assumed）」。\",\"levels\":[\"unit\"]},{\"id\":\"AC-063\",\"text\":\"界面通过 api/snapshot 轮询取数，期间 exec 计数为 0；刷新和探测走 job 接口并返回 job_id；job 失败时，snapshot 中该项保留上次的值、标为 stale，并给出 last_error 和 at。\",\"levels\":[\"integration\"]},{\"id\":\"AC-064\",\"text\":\"跨进程端到端：用宿主 stub 和 HTTP 选模，再在新进程中按 calls[0] 的 command、args、cwd、stdin 原样执行，得到 event/v1 流和 ok 的 result；再执行一次得到 E_LEASE_CONSUMED。用 CLI 选模走同样流程，结果相同。count=3 时，在注入时钟下按顺序执行，三个租约都没有过期。插件和 CLI 对同一配置给出的 --config 和 --state-dir 相同。\",\"levels\":[\"e2e\"]},{\"id\":\"AC-065\",\"text\":\"npm pack 后安装到临时目录：cliworker --version 成功；cliworker doctor --config <临时配置> 成功；import 包入口，用宿主 stub 注册后 getRegistration().status 为 ok。\",\"levels\":[\"e2e\"]},{\"id\":\"AC-066\",\"text\":\"升级时自动生成 backup-<ver>-<ts>，state/VERSION 被迁移；state restore 后与备份逐字节一致；kill -9 后重启，未过期的租约、账本、探测状态都完整，过期租约被释放，陈旧锁被回收。\",\"levels\":[\"e2e\",\"integration\"]},{\"id\":\"AC-067\",\"text\":\"check-docs 针对夹具配置执行 README 和 docs 中标为可运行的命令，全部成功；README 中没有会被忽略的字段；docs/migration.md 为注册表中每个 semantic_change 项都有一段说明（含 tasks_left_basis、risk_basis，以及 draft 到 v1 的映射）。\",\"levels\":[\"integration\"]},{\"id\":\"AC-068\",\"text\":\"docs/agentline-integration.md 只描述 level、count、usage、importance、按顺序执行 calls、再申请、错误码与流程状态；用 agentline-forbidden 键表对它做整词扫描，0 命中。\",\"levels\":[\"unit\"]},{\"id\":\"AC-069\",\"text\":\"smoke-real --dry-run 在 fake-cli 环境下运行：步骤依次为发现、枚举、探测、选模、run 极小提示、http-select，全部 pass，生成通过 cliworker.smoke/v1 校验的报告，leak-scan 0 命中。未设置 CLIWORKER_SMOKE=1 时运行 real 模式，返回 E_SMOKE_DISABLED。\",\"levels\":[\"smoke\"]},{\"id\":\"AC-070\",\"text\":\"release-gate 的夹具测试：全部通过时放行；任一 fail 时阻断；某条 AC 在其 baseline 平台上只有 skip 时阻断；smoke 中的 mandatory 步骤为 skip 时阻断；有 status 为 planned 的 AC 时阻断；real 报告缺失或未脱敏时阻断。\",\"levels\":[\"unit\"]},{\"id\":\"AC-071\",\"text\":\"flows 发现的步骤集合恰为 auth, doctor, discover, enumerate, probe, select, run, http-select, http-admin，且整条流程在同一个哨兵下 leak-scan 0 命中，令牌只出现在 env 中。\",\"levels\":[\"integration\"]}],\"tasks\":[{\"id\":\"T-001\",\"title\":\"测试运行器、集合发现校验、CI 矩阵、check-fast 与追踪骨架（A3）\",\"milestone\":\"M1\",\"inputs\":[\"package.json\",\"test/select.test.mjs\",\"本蓝图 AC 列表\"],\"outputs\":[\"package.json 的 scripts（test、check、perf、snapshot:update）\",\"scripts/run-tests.mjs 与 reporters/files.mjs\",\"scripts/check-test-discovery.mjs、check-fast.mjs、check-fast.ps1、check-traceability.mjs、check-ci.mjs、gen-ci.mjs、ci-matrix.json\",\".github/workflows/ci.yml\",\"package-lock.json\",\"test/unit/select.test.mjs（迁入）\",\"test/helpers/platform-gate.mjs\",\"test/traceability/T-001.json（列出全部 AC，初始为 planned）\"],\"depends_on\":[],\"write_scope\":[\"package.json\",\"package-lock.json\",\"scripts/run-tests.mjs\",\"scripts/reporters/**\",\"scripts/check-test-discovery.mjs\",\"scripts/check-fast.mjs\",\"scripts/check-fast.ps1\",\"scripts/check-traceability.mjs\",\"scripts/check-ci.mjs\",\"scripts/gen-ci.mjs\",\"scripts/ci-matrix.json\",\".github/workflows/**\",\"test/select.test.mjs\",\"test/unit/select.test.mjs\",\"test/unit/runner-selftest.test.mjs\",\"test/helpers/platform-gate.mjs\",\"test/fixtures/discovery-selftest/**\",\"test/traceability/T-001.json\"],\"acceptance\":[\"AC-001\",\"AC-002\",\"AC-003\",\"AC-004\"],\"acceptance_direction\":[\"npm test\",\"node scripts/check-test-discovery.mjs\",\"node scripts/check-ci.mjs\",\"pwsh -NoProfile -File scripts/check-fast.ps1\",\"node scripts/check-traceability.mjs\",\"node scripts/run-tests.mjs --ac AC-003\"],\"test_levels\":[\"unit\",\"integration\"]},{\"id\":\"T-002\",\"title\":\"特征化测试：锁定保留行为，A 节缺陷逐条建档\",\"milestone\":\"M1\",\"inputs\":[\"lib/*.mjs 现状\",\"config/cliworker.example.json\",\"第 2 节勘误\"],\"outputs\":[\"test/characterization/stable.test.mjs\",\"test/characterization/defects/<A-id>.test.mjs（a1-quota、a2-pack、a3-runner、a4-paths、a4-null-config、a5-dup-call、a5-forecast-x3、a5-unused、a5-shell、a5-nocache、a5-ignored-fields）\",\"test/characterization/frozen-files.json\",\"scripts/check-frozen-files.mjs\"],\"depends_on\":[\"T-001\"],\"write_scope\":[\"test/characterization/**\",\"test/fixtures/characterization/**\",\"scripts/check-frozen-files.mjs\",\"test/traceability/T-002.json\"],\"acceptance\":[\"AC-005\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-005\",\"node scripts/check-frozen-files.mjs\"],\"test_levels\":[\"unit\"]},{\"id\":\"T-003\",\"title\":\"可注入缝、import-safe 入口、命令路由骨架与宿主 stub 契约\",\"milestone\":\"M1\",\"inputs\":[\"lib/cli.mjs\",\"bin/cliworker.mjs\",\"lib/index.js\",\"lib/availability.mjs\",\"lib/config.mjs\",\"lib/forecast.mjs\",\"review F-01\"],\"outputs\":[\"lib/context.mjs（createContext）\",\"lib/exec.mjs（迁入现有 spawn 逻辑，安全化在 T-010）\",\"lib/cli.mjs 导出 main(argv, ctx)\",\"lib/commands/<cmd>/<sub>.mjs（迁入现有命令）\",\"lib/index.js 的 createPlugin、getRegistration、strict\",\"contracts/host/dsh-host.v1.json\",\"test/helpers/ctx.mjs、host-stub.mjs\",\"scripts/check-seams.mjs\"],\"depends_on\":[\"T-001\"],\"write_scope\":[\"lib/context.mjs\",\"lib/exec.mjs\",\"lib/cli.mjs\",\"lib/commands/**\",\"bin/cliworker.mjs\",\"lib/index.js\",\"lib/availability.mjs\",\"lib/config.mjs\",\"lib/forecast.mjs\",\"contracts/host/**\",\"test/helpers/ctx.mjs\",\"test/helpers/host-stub.mjs\",\"scripts/check-seams.mjs\",\"test/fixtures/seams/**\",\"test/unit/seams.test.mjs\",\"test/unit/import-safe.test.mjs\",\"test/contract/host-stub.test.mjs\",\"test/integration/registration.test.mjs\",\"test/traceability/T-003.json\"],\"acceptance\":[\"AC-006\",\"AC-007\",\"AC-008\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-006\",\"node scripts/check-seams.mjs\",\"node scripts/run-tests.mjs --ac AC-008\"],\"test_levels\":[\"unit\",\"contract\",\"integration\"]},{\"id\":\"T-004\",\"title\":\"契约冻结：注册表与快照、示例、校验器、视图扫描器与 canary\",\"milestone\":\"M1\",\"inputs\":[\"interfaces 第 1～15 节\",\"review F-02、F-03、F-10\"],\"outputs\":[\"lib/contract/registry.mjs、validate.mjs、views.mjs、scan.mjs\",\"contracts/registry.snapshot.json\",\"contracts/examples/**（正例、反例、draft）\",\"contracts/agentline-forbidden.json\",\"contracts/schemas/**\",\"scripts/snapshot-update.mjs\",\"docs/contract.md\"],\"depends_on\":[\"T-001\"],\"write_scope\":[\"lib/contract/**\",\"contracts/registry.snapshot.json\",\"contracts/examples/**\",\"contracts/schemas/**\",\"contracts/agentline-forbidden.json\",\"scripts/snapshot-update.mjs\",\"docs/contract.md\",\"test/contract/registry.test.mjs\",\"test/contract/examples.test.mjs\",\"test/contract/freeze.test.mjs\",\"test/contract/scan-canary.test.mjs\",\"test/traceability/T-004.json\"],\"acceptance\":[\"AC-009\",\"AC-010\",\"AC-011\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-009\",\"node scripts/run-tests.mjs --ac AC-010\",\"node scripts/run-tests.mjs --ac AC-011\"],\"test_levels\":[\"contract\",\"unit\"]},{\"id\":\"T-005\",\"title\":\"路径统一与配置健壮性：resolvePaths、state_dir、.gitignore、示例识别、null 配置（A4）\",\"milestone\":\"M1\",\"inputs\":[\"lib/config.mjs\",\"lib/index.js\",\"lib/commands/usage/**\",\".gitignore\",\"config/cliworker.example.json\",\"第 2 节勘误第 1、2、4 条\"],\"outputs\":[\"lib/paths.mjs\",\"lib/config.mjs（所有错误补 E_CONFIG，_example 与深相等识别）\",\"lib/commands/paths.mjs、init.mjs\",\".gitignore 通配规则\",\"example 带 _example、schema 与 credits_per_mtok\",\"defects/a4-* 翻转\"],\"depends_on\":[\"T-002\",\"T-003\",\"T-004\"],\"write_scope\":[\"lib/paths.mjs\",\"lib/config.mjs\",\"lib/index.js\",\"lib/commands/paths.mjs\",\"lib/commands/init.mjs\",\"lib/commands/usage/**\",\".gitignore\",\"config/cliworker.example.json\",\"test/unit/paths.test.mjs\",\"test/unit/config.test.mjs\",\"test/unit/gitignore.test.mjs\",\"test/integration/paths-entries.test.mjs\",\"test/characterization/defects/a4-paths.test.mjs\",\"test/characterization/defects/a4-null-config.test.mjs\",\"test/traceability/T-005.json\"],\"acceptance\":[\"AC-012\",\"AC-013\",\"AC-014\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-012\",\"node scripts/run-tests.mjs --ac AC-013\",\"node scripts/run-tests.mjs --ac AC-014\",\"node bin/cliworker.mjs paths --config config/cliworker.example.json\"],\"test_levels\":[\"unit\",\"integration\"]},{\"id\":\"T-006\",\"title\":\"额度池归一与预测引擎定稿（A1，纯函数，最终公式）\",\"milestone\":\"M1\",\"inputs\":[\"lib/forecast.mjs\",\"interfaces 第 5～7 节\",\"第 9 节公式\"],\"outputs\":[\"lib/pools.mjs（四种形状归一、多池、重置时间优先级）\",\"lib/forecast.mjs（remaining、used、分位数、阈值表、置信度、burn、eta、assumed 语义）\",\"test/fixtures/forecast/**\",\"defects/a1-quota 的预测部分翻转\"],\"depends_on\":[\"T-002\",\"T-003\",\"T-004\"],\"write_scope\":[\"lib/pools.mjs\",\"lib/forecast.mjs\",\"test/unit/pools.test.mjs\",\"test/unit/forecast-engine.test.mjs\",\"test/unit/forecast-unknown.test.mjs\",\"test/unit/reset.test.mjs\",\"test/fixtures/forecast/**\",\"test/characterization/defects/a1-quota.test.mjs\",\"test/traceability/T-006.json\"],\"acceptance\":[\"AC-015\",\"AC-016\",\"AC-017\",\"AC-018\",\"AC-019\"],\"acceptance_direction\":[\"node scripts/run-tests.mjs --ac AC-015\",\"node scripts/run-tests.mjs --ac AC-016\",\"node scripts/run-tests.mjs --ac AC-017\",\"node scripts/run-tests.mjs --ac AC-018\",\"node scripts/run-tests.mjs --ac AC-019\"],\"test_levels\":[\"unit\"]},{\"id\":\"T-007\",\"title\":\"选模卫生与 draft 兼容：去掉重复 cli、forecast 记忆化、Heavy 拒选、check-unused（A1、A5）\",\"milestone\":\"M1\",\"inputs\":[\"lib/select.mjs\",\"lib/forecast.mjs（T-006 定稿）\",\"注册表中的 draft 原因\"],\"outputs\":[\"lib