: \"top\",\n538\t   133\t      \"identity\": \"verified\",\n539\t   134\t      \"identity_group\": \"deepseek-flash\",\n540\t   135\t      \"vendor\": \"tencent\",\n541\t   136\t      \"deprecated\": false,\n542\t   137\t      \"prices\": {\n543\t   138\t        \"input_per_mtok\": 0.5,\n544\t   139\t        \"output_per_mtok\": 2\n545\t   140\t      },\n546\t   141\t      \"level\": \"High\"\n547\t   142\t    },\n548\t   143\t    \"deepseek-v4-pro\": {\n549\t   144\t      \"provider\": \"codebuddy\",\n550\t   145\t      \"id\": \"deepseek-v4-pro\",\n551\t   146\t      \"tier\": \"top\",\n552\t   147\t      \"identity\": \"unverified\",\n553\t   148\t      \"identity_group\": \"deepseek-pro\",\n554\t   149\t      \"vendor\": \"tencent\",\n555\t   150\t      \"deprecated\": true,\n556\t   151\t      \"deprecated_reason\": \"CodeBuddy only allows deepseek-v4.1-flash (1017)\"\n557\t   152\t    },\n558\t   153\t    \"claude-opus-4-5\": {\n559\t   154\t      \"provider\": \"claude\",\n560\t   155\t      \"id\": \"claude-opus-4-5\",\n561\t   156\t      \"tier\": \"advanced\",\n562\t   157\t      \"identity\": \"unverified\",\n563\t   158\t      \"identity_group\": \"anthropic-opus-4-5\",\n564\t   159\t      \"vendor\": \"anthropic\",\n565\t   160\t      \"deprecated\": true,\n566\t   161\t      \"deprecated_reason\": \"superseded by opus 5.5\"\n567\t   162\t    },\n568\t   163\t    \"cursor-wsl-grok-4.7\": {\n569\t   164\t      \"provider\": \"cursor-wsl\",\n570\t   165\t      \"id\": \"grok-4.7\",\n571\t   166\t      \"tier\": \"top\",\n572\t   167\t      \"identity\": \"verified\",\n573\t   168\t      \"identity_group\": \"xai-grok-4-7\",\n574\t   169\t      \"vendor\": \"xai\",\n575\t   170\t      \"deprecated\": false,\n576\t   171\t      \"prices\": {\n577\t   172\t        \"input_per_mtok\": 3,\n578\t   173\t        \"output_per_mtok\": 15\n579\t   174\t      },\n580\t   175\t      \"readonly\": false,\n581\t   176\t      \"level\": \"High\"\n582\t   177\t    },\n583\t   178\t    \"gemini-4-argon-high\": {\n584\t   179\t      \"provider\": \"gemini\",\n585\t   180\t      \"id\": \"gemini-4-argon-high\",\n586\t   181\t      \"tier\": \"top\",\n587\t   182\t      \"identity\": \"unverified\",\n588\t   183\t      \"identity_group\": \"google-gemini-4-argon\",\n589\t   184\t      \"vendor\": \"google\",\n590\t   185\t      \"deprecated\": false,\n591\t   186\t      \"prices\": {\n592\t   187\t        \"input_per_mtok\": 1.25,\n593\t   188\t        \"output_per_mtok\": 10\n594\t   189\t      },\n595\t   190\t      \"level\": \"High\"\n596\t   191\t    },\n597\t   192\t    \"hy3\": {\n598\t   193\t      \"provider\": \"codebuddy\",\n599\t   194\t      \"id\": \"hy3\",\n600\t   195\t      \"tier\": \"advanced\",\n601\t   196\t      \"level\": \"Middle\",\n602\t   197\t      \"identity\": \"verified\",\n603\t   198\t      \"identity_group\": \"hy3\",\n604\t   199\t      \"vendor\": \"tencent\",\n605\t   200\t      \"deprecated\": false,\n606\t   201\t      \"prices\": {\n607\t   202\t        \"input_per_mtok\": 0.2,\n608\t   203\t        \"output_per_mtok\": 0.8\n609\t   204\t      }\n610\t   205\t    },\n611\t   206\t    \"hy3x\": {\n612\t   207\t      \"provider\": \"codebuddy\",\n613\t   208\t      \"id\": \"hy3-x\",\n614\t   209\t      \"tier\": \"advanced\",\n615\t   210\t      \"level\": \"Middle\",\n616\t   211\t      \"identity\": \"verified\",\n617\t   212\t      \"identity_group\": \"hy3-x\",\n618\t   213\t      \"vendor\": \"tencent\",\n619\t   214\t      \"deprecated\": false,\n620\t   215\t      \"prices\": {\n621\t   216\t        \"input_per_mtok\": 0.3,\n622\t   217\t        \"output_per_mtok\": 1\n623\t   218\t      }\n624\t   219\t    },\n625\t   220\t    \"gemini-3.7-flash-high\": {\n626\t   221\t      \"provider\": \"gemini\",\n627\t   222\t      \"id\": \"gemini-3.7-flash-high\",\n628\t   223\t      \"tier\": \"standard\",\n629\t   224\t      \"level\": \"Quick\",\n630\t   225\t      \"identity\": \"unverified\",\n631\t   226\t      \"identity_group\": \"google-gemini-3.7-flash\",\n632\t   227\t      \"vendor\": \"google\",\n633\t   228\t      \"deprecated\": false,\n634\t   229\t      \"prices\": {\n635\t   230\t        \"input_per_mtok\": 0.3,\n636\t   231\t        \"output_per_mtok\": 1.2\n637\t   232\t      }\n638\t   233\t    },\n639\t   234\t    \"claude-haiku-5-5\": {\n640\t   235\t      \"provider\": \"claude\",\n641\t   236\t      \"id\": \"claude-haiku-5-5\",\n642\t   237\t      \"tier\": \"standard\",\n643\t   238\t      \"level\": \"Quick\",\n644\t   239\t      \"identity\": \"unverified\",\n645\t   240\t      \"identity_group\": \"anthropic-haiku-5-5\",\n646\t   241\t      \"vendor\": \"anthropic\",\n647\t   242\t      \"deprecated\": false,\n648\t   243\t      \"prices\": {\n649\t   244\t        \"input_per_mtok\": 0.8,\n650\t   245\t        \"output_per_mtok\": 4\n651\t   246\t      }\n652\t   247\t    }\n653\t   248\t  },\n654\t   249\t  \"quotas\": {\n655\t   250\t    \"claude\": {\n656\t   251\t      \"window\": \"5h\",\n657\t   252\t      \"remaining_pct\": 100,\n658\t   253\t      \"reset_at\": null\n659\t   254\t    },\n660\t   255\t    \"codex\": {\n661\t   256\t      \"window\": \"7d\",\n662\t   257\t      \"remaining_pct\": 100,\n663\t   258\t      \"reset_at\": null\n664\t   259\t    },\n665\t   260\t    \"codebuddy\": {\n666\t   261\t      \"window\": \"credits\",\n667\t   262\t      \"remaining\": 1000,\n668\t   263\t      \"unit\": \"credits\"\n669\t   264\t    }\n670\t   265\t  }\n671\t   266\t}\n672\t=== cordis.patch.yml\n673\t     1\t# dsh-cliworker bundle layer: registers the host half (model routes).\n674\t     2\t- insert:\n675\t     3\t    - id: dsh-cliworker\n676\t     4\t      name: dsh-cliworker\n677\t=== README.md\n678\t     1\t# CLIWorker\n679\t     2\t\n680\t     3\tAgentLine 的独立模型层。AgentLine 只保留“模型来源”指针；provider/CLI、模型列举、可用性、价格、用量与预测全部由 CLIWorker 负责。\n681\t     4\t\n682\t     5\t## 边界\n683\t     6\t\n684\t     7\t```text\n685\t     8\tAgentLine  --ModelRequest JSON-->  CLIWorker  --ModelSelection JSON-->  AgentLine\n686\t     9\t```\n687\t    10\t\n688\t    11\t- AgentLine 不读取 provider CLI、不维护价格表、不做预测。\n689\t    12\t- CLIWorker 可以独立安装、替换、禁用。\n690\t    13\t- AgentLine 的 `modelSource` 只保存 CLIWorker 的启动配置。\n691\t    14\t\n692\t    15\t## CLI\n693\t    16\t\n694\t    17\t```bash\n695\t    18\tnode bin/cliworker.mjs providers\n696\t    19\tnode bin/cliworker.mjs models list\n697\t    20\tnode bin/cliworker.mjs models list --all\n698\t    21\tnode bin/cliworker.mjs models select --request '{\"role\":\"dev\",\"tier\":\"top\",\"count\":2,\"importance\":\"high\"}'\n699\t    22\tnode bin/cliworker.mjs models forecast --model hy4free\n700\t    23\tnode bin/cliworker.mjs usage record --json '{\"model\":\"hy4free\",\"input_tokens\":1000,\"output_tokens\":500}'\n701\t    24\tnode bin/cliworker.mjs usage summary\n702\t    25\t```\n703\t    26\t\n704\t    27\t所有输出都是 JSON。\n705\t    28\t\n706\t    29\t## 配置\n707\t    30\t\n708\t    31\t默认配置：`$CLIWORKER_HOME/config.json`（默认 `~/.cliworker/config.json`）。  \n709\t    32\t参考 `config/cliworker.example.json`。\n710\t    33\t\n711\t    34\t配置包含：\n712\t    35\t\n713\t    36\t- providers：CLI、adapter、版本/认证命令、是否可强制只读\n714\t    37\t- models：provider、id、tier、identity、vendor、价格、弃用\n715\t    38\t- quotas：各渠道剩余额度/窗口\n716\t    39\t\n717\t    40\t## AgentLine 集成\n718\t    41\t\n719\t    42\tAgentLine 仅保存：\n720\t    43\t\n721\t    44\t```json\n722\t    45\t\"modelSource\": {\n723\t    46\t  \"kind\": \"cliworker\",\n724\t    47\t  \"command\": \"node\",\n725\t    48\t  \"args\": [\"C:/git/dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"C:/git/dsh-CLIWorker/config/cliworker.local.json\"]\n726\t    49\t}\n727\t    50\t```\n728\t    51\t\n729\t    52\t选模时调用：\n730\t    53\t\n731\t    54\t```text\n732\t    55\tcliworker models select --request <ModelRequest>\n733\t    56\t```\n734\t    57\t\n735\t    58\t返回的 `models[]` 是 `ModelHandle[]`，AgentLine 按顺序尝试。\n736\t    59\t\n737\t    60\t## 安全\n738\t    61\t\n739\t    62\t- 未验证 identity、不可调用、弃用模型不会出现在候选中。\n740\t    63\t- `rejected[]` 保留原因，便于审计。\n741\t    64\t- 预测缺样本返回 `unknown`，不伪造通过。\n742\t    65\t\n743\t.collab:\n744\tblueprint\n745\t\n746\t.collab/blueprint:\n747\tcliworker-v2\n748\t\n749\t.collab/blueprint/cliworker-v2:\n750\tacceptance-matrix.md\n751\tdesign.md\n752\tinterfaces.md\n753\tlogs\n754\treview-v1.verdict.json\n755\trisks.md\n756\troles.lock.json\n757\tstate.json\n758\ttask-graph.json\n759\ttest-strategy.md\n760\ttestability.json\n761\t\n762\t.collab/blueprint/cliworker-v2/logs:\n763\tdesigner.log\n764\treviewer.log\n765\ttest_architect.log\n766\t"}]},"parent_tool_use_id":null,"session_id":"20d0d5e9-5917-459b-8072-687c02d6e593","uuid":"5da0d250-8cb7-4a6f-a029-919b8bcb097d","timestamp":"2026-11-07T11:11:11.825Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\kayz\\.claude\\projects\\C--git-dsh-CLIWorker\\20d0d5e9-5917-459b-8072-687c02d6e593\\tool-results\\bflgp1wji.txt","content":"=== bin/cliworker.mjs\n     1\t#!/usr/bin/env node\n     2\timport '../lib/cli.mjs'\n=== lib/index.js\n     1\t/**\n     2\t * dsh-cliworker — DSH host plugin.\n     3\t *\n     4\t * AgentLine and other clients only need the model source pointer:\n     5\t *   modelSource = { kind: \"cliworker\", command: \"node\",\n     6\t *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n     7\t *\n     8\t * The plugin exposes the same selection contract over DSH routes for UI use.\n     9\t */\n    10\timport path from 'node:path'\n    11\timport os from 'node:os'\n    12\timport { fileURLToPath } from 'node:url'\n    13\timport { loadConfig } from '../lib/config.mjs'\n    14\timport { providerStatus } from '../lib/availability.mjs'\n    15\timport { listModels, selectModels } from '../lib/select.mjs'\n    16\timport { forecast } from '../lib/forecast.mjs'\n    17\t\n    18\tconst __dirname = path.dirname(fileURLToPath(import.meta.url))\n    19\tconst DEFAULTS = {\n    20\t  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\n    21\t  readonly: false,\n    22\t}\n    23\t\n    24\tfunction send(res, body, code = 200) {\n    25\t  res.statusCode = code\n    26\t  res.setHeader('content-type', 'application/json; charset=utf-8')\n    27\t  res.setHeader('cache-control', 'no-store')\n    28\t  res.end(JSON.stringify(body))\n    29\t}\n    30\t\n    31\tfunction readBody(req) {\n    32\t  return new Promise((resolve, reject) => {\n    33\t    let raw = ''\n    34\t    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n    35\t    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n    36\t    req.on('error', reject)\n    37\t  })\n    38\t}\n    39\t\n    40\texport const name = 'cliworker'\n    41\t\n    42\texport function apply(ctx, config = {}) {\n    43\t  const settings = { ...DEFAULTS, ...(config || {}) }\n    44\t  const getConfig = () => loadConfig({ file: settings.configPath })\n    45\t\n    46\t  try {\n    47\t    ctx.inject(['webServer'], (httpCtx) => {\n    48\t      const route = (p, name, handler) => httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\n    49\t\n    50\t      route('/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n    51\t        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n    52\t      })\n    53\t      route('/cliworker/models', 'cliworker: models', async (_req, res) => {\n    54\t        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n    55\t      })\n    56\t      route('/cliworker/select', 'cliworker: select', async (req, res) => {\n    57\t        try {\n    58\t          const c = getConfig()\n    59\t          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n    60\t          const request = body.request || body\n    61\t          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c) }) })\n    62\t        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n    63\t      })\n    64\t      route('/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n    65\t        try {\n    66\t          const c = getConfig()\n    67\t          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n    68\t          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null }) })\n    69\t        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n    70\t      })\n    71\t    })\n    72\t  } catch (e) {\n    73\t    console.error('[cliworker] webServer inject failed:', e.message)\n    74\t  }\n    75\t}\n    76\t\n=== lib/availability.mjs\n     1\timport { spawnSync } from 'node:child_process'\n     2\t\n     3\tfunction run(command, args, timeout = 20_000) {\n     4\t  try {\n     5\t    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n     6\t    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n     7\t  } catch (e) {\n     8\t    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n     9\t  }\n    10\t}\n    11\t\n    12\texport function checkProvider(provider, { probe = true } = {}) {\n    13\t  const cli = provider.cli\n    14\t  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n    15\t  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n    16\t  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n    17\t  const v = run(cli, versionArgs)\n    18\t  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n    19\t  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n    20\t  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n    21\t  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n    22\t  const auth = run(cli, [...prefix, ...provider.auth_args])\n    23\t  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n    24\t  const ok = auth.ok && (\n    25\t    !provider.auth_ok ||\n    26\t    text.includes(String(provider.auth_ok).toLowerCase()) ||\n    27\t    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n    28\t    /\\blogged in\\b/.test(text)\n    29\t  )\n    30\t  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n    31\t}\n    32\t\n    33\texport function providerStatus(config, opts = {}) {\n    34\t  const out = {}\n    35\t  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n    36\t  return out\n    37\t}\n=== lib/cli.mjs\n     1\timport fs from 'node:fs'\n     2\timport path from 'node:path'\n     3\timport { loadConfig, defaultHome, readUsage, appendUsage } from './config.mjs'\n     4\timport { providerStatus } from './availability.mjs'\n     5\timport { listModels, selectModels, SCHEMA as SELECT_SCHEMA } from './select.mjs'\n     6\timport { forecast, estimateCost } from './forecast.mjs'\n     7\t\n     8\tfunction out(x) { process.stdout.write(JSON.stringify(x, null, 2) + '\\n') }\n     9\tfunction fail(message, code = 1) { process.stderr.write(`ERROR: ${message}\\n`); process.exit(code) }\n    10\tfunction arg(name, fallback) { const i = process.argv.indexOf(name); return i >= 0 ? process.argv[i + 1] : fallback }\n    11\tfunction flag(name) { return process.argv.includes(name) }\n    12\tfunction usageFile(config) { return path.join(config._home || defaultHome(), 'usage.jsonl') }\n    13\t\n    14\tfunction load() {\n    15\t  try { return loadConfig({ file: arg('--config') }) } catch (e) { fail(e.message) }\n    16\t}\n    17\t\n    18\tfunction main() {\n    19\t  const cmd = process.argv[2]\n    20\t  const sub = process.argv[3]\n    21\t  const config = load()\n    22\t  if (cmd === 'providers') {\n    23\t    const status = providerStatus(config)\n    24\t    out({ schema: 'cliworker.providers/v1', providers: Object.entries(config.providers).map(([id, p]) => ({ id, cli: p.cli, readonly: !!p.readonly, ...status[id] })) })\n    25\t    return\n    26\t  }\n    27\t  if (cmd === 'models' && (!sub || sub === 'list')) {\n    28\t    const status = providerStatus(config)\n    29\t    out({ schema: 'cliworker.models/v1', models: listModels(config, { status, includeDeprecated: flag('--all') }) })\n    30\t    return\n    31\t  }\n    32\t  if (cmd === 'models' && sub === 'select') {\n    33\t    let req = {}\n    34\t    const raw = arg('--request')\n    35\t    if (raw) { try { req = JSON.parse(raw) } catch (e) { fail(`bad --request JSON: ${e.message}`) } }\n    36\t    const status = providerStatus(config)\n    37\t    out(selectModels(config, req, { status, usage: readUsage(usageFile(config)) }))\n    38\t    return\n    39\t  }\n    40\t  if (cmd === 'models' && sub === 'forecast') {\n    41\t    const key = arg('--model', null)\n    42\t    const usage = readUsage(usageFile(config))\n    43\t    out({ schema: 'cliworker.forecast/v1', forecast: forecast({ records: usage, model: key, prices: key ? config.models[key]?.prices : undefined, quota: key ? config.quotas?.[config.models[key]?.provider] : null }) })\n    44\t    return\n    45\t  }\n    46\t  if (cmd === 'usage' && sub === 'record') {\n    47\t    let row\n    48\t    const raw = arg('--json')\n    49\t    try { row = JSON.parse(raw) } catch (e) { fail(`bad --json: ${e.message}`) }\n    50\t    if (!row.model) fail('usage record requires model')\n    51\t    const m = config.models[row.model]\n    52\t    if (m) row.cost_usd = row.cost_usd ?? estimateCost({ input_tokens: row.input_tokens, output_tokens: row.output_tokens, prices: m.prices })\n    53\t    row.at = row.at || new Date().toISOString()\n    54\t    appendUsage(usageFile(config), row)\n    55\t    out({ schema: 'cliworker.usage/v1', ok: true, recorded: row })\n    56\t    return\n    57\t  }\n    58\t  if (cmd === 'usage' && sub === 'summary') {\n    59\t    out({ schema: 'cliworker.usage/v1', records: readUsage(usageFile(config)) })\n    60\t    return\n    61\t  }\n    62\t  fail('usage: cliworker providers | models list|select|forecast | usage record|summary')\n    63\t}\n    64\t\n    65\tmain()\n=== lib/config.mjs\n     1\timport fs from 'node:fs'\n     2\timport os from 'node:os'\n     3\timport path from 'node:path'\n     4\t\n     5\texport const SCHEMA = 'cliworker.config/v1'\n     6\t\n     7\texport function defaultHome() {\n     8\t  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n     9\t}\n    10\t\n    11\texport function loadConfig({ file } = {}) {\n    12\t  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n    13\t  let raw\n    14\t  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n    15\t    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n    16\t    error.code = 'E_CONFIG'\n    17\t    throw error\n    18\t  }\n    19\t  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n    20\t  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n    21\t  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n    22\t  return { ...raw, _file: root, _home: defaultHome() }\n    23\t}\n    24\t\n    25\texport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n    26\t\n    27\texport function readUsage(file) {\n    28\t  try {\n    29\t    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n    30\t  } catch { return [] }\n    31\t}\n    32\t\n    33\texport function appendUsage(file, row) {\n    34\t  ensureDir(path.dirname(file))\n    35\t  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n    36\t}\n=== lib/forecast.mjs\n     1\texport const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n     2\t\n     3\texport function normalizePrices(m = {}) {\n     4\t  const p = m.prices || {}\n     5\t  return {\n     6\t    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n     7\t    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n     8\t  }\n     9\t}\n    10\t\n    11\texport function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n    12\t  const p = { ...DEFAULT_PRICES, ...prices }\n    13\t  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n    14\t}\n    15\t\n    16\t/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n    17\texport function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\n    18\t  const rows = records.filter((r) => !model || r.model === model)\n    19\t  const samples = rows.map((r) => ({\n    20\t    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n    21\t    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n    22\t  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n    23\t  if (!samples.length) {\n    24\t    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n    25\t  }\n    26\t  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n    27\t  const use = recent.length ? recent : samples.slice(-10)\n    28\t  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n    29\t  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n    30\t  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n    31\t  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n    32\t  let tasksLeft = null\n    33\t  let etaHours = null\n    34\t  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n    35\t    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n    36\t    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n    37\t  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n    38\t    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n    39\t  }\n    40\t  const confidence = use.length >= 5 ? 'medium' : 'low'\n    41\t  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n    42\t  return {\n    43\t    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n    44\t    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n    45\t    confidence, risk,\n    46\t  }\n    47\t}\n    48\t\n    49\tfunction round(n) { return Math.round(n * 1e6) / 1e6 }\n=== lib/select.mjs\n     1\timport { normalizePrices, forecast } from './forecast.mjs'\n     2\t\n     3\texport const SCHEMA = 'cliworker.selection/v1'\n     4\texport const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n     5\texport const USAGES = ['Heavy', 'Normal', 'Light']\n     6\t\n     7\tfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n     8\tfunction normLevel(v) {\n     9\t  const s = String(v || '').trim().toLowerCase()\n    10\t  return LEVELS.find((x) => x.toLowerCase() === s) || null\n    11\t}\n    12\tfunction normUsage(v) {\n    13\t  const s = String(v || '').trim().toLowerCase()\n    14\t  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n    15\t}\n    16\t\n    17\tfunction vendorOf(provider) {\n    18\t  const p = String(provider || '').toLowerCase()\n    19\t  if (p.includes('claude')) return 'anthropic'\n    20\t  if (p.includes('codex') || p.includes('openai')) return 'openai'\n    21\t  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n    22\t  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n    23\t  if (p.includes('gemini') || p.includes('google')) return 'google'\n    24\t  return p\n    25\t}\n    26\t\n    27\tfunction levelOf(m) {\n    28\t  if (m.level && LEVELS.includes(m.level)) return m.level\n    29\t  if (m.tier === 'top') return 'Top'\n    30\t  if (m.tier === 'advanced') return 'High'\n    31\t  if (m.tier === 'standard') return 'Middle'\n    32\t  return 'Quick'\n    33\t}\n    34\t\n    35\tfunction cliCall(config, model, request) {\n    36\t  const p = config.providers?.[model.provider] || {}\n    37\t  const id = model.id\n    38\t  const cwd = request.cwd || '<workspace>'\n    39\t  if (model.provider === 'claude') {\n    40\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n    41\t  }\n    42\t  if (model.provider === 'codex') {\n    43\t    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n    44\t  }\n    45\t  if (model.provider === 'codebuddy') {\n    46\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n    47\t  }\n    48\t  if (model.provider === 'cursor-wsl') {\n    49\t    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n    50\t  }\n    51\t  if (model.provider === 'gemini') {\n    52\t    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n    53\t  }\n    54\t  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n    55\t}\n    56\t\n    57\texport function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n    58\t  return Object.entries(config.models).map(([key, m]) => {\n    59\t    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n    60\t    const callable = st.state === 'callable' && !m.deprecated\n    61\t    return {\n    62\t      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n    63\t      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n    64\t      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n    65\t      identity_group: m.identity_group || null,\n    66\t      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n    67\t      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n    68\t      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n    69\t      prices: normalizePrices(m), source: 'config',\n    70\t      provider_detail: st.detail || null,\n    71\t    }\n    72\t  }).filter((m) => includeDeprecated || !m.deprecated)\n    73\t}\n    74\t\n    75\texport function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n    76\t  const level = normLevel(request.level || request.tier)\n    77\t  const usageKind = normUsage(request.usage)\n    78\t  const models = listModels(config, { status, includeDeprecated: true })\n    79\t  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n    80\t  const requireVerified = request.require_verified !== false\n    81\t  const requireReadonly = request.require_readonly === true\n    82\t  const exclude = new Set(request.exclude || [])\n    83\t  const allowed = request.candidates ? new Set(request.candidates) : null\n    84\t  const rejected = []\n    85\t  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n    86\t\n    87\t  const candidates = models.filter((m) => {\n    88\t    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n    89\t    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n    90\t    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n    91\t    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n    92\t    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n    93\t    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n    94\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n    95\t    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n    96\t      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n    97\t    }\n    98\t    return true\n    99\t  })\n   100\t\n   101\t  const rank = (m) => {\n   102\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n   103\t    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n   104\t    const unknown = f.risk === 'unknown' ? 1 : 0\n   105\t    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n   106\t    if (usageKind === 'Light') return [price, unknown, m.key]\n   107\t    return [unknown, price, m.key]\n   108\t  }\n   109\t  candidates.sort((a, b) => {\n   110\t    const ra = rank(a), rb = rank(b)\n   111\t    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n   112\t    return 0\n   113\t  })\n   114\t\n   115\t  const picked = candidates.slice(0, count).map((m) => {\n   116\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n   117\t    const call = cliCall(config, m, request)\n   118\t    return {\n   119\t      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n   120\t      adapter: config.providers[m.provider]?.adapter || null,\n   121\t      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n   122\t      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n   123\t      forecast: f, cli: call, call,\n   124\t    }\n   125\t  })\n   126\t  return {\n   127\t    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n   128\t    models: picked, calls: picked.map((x) => x.call), rejected,\n   129\t    reason: picked.length ? null : 'no_eligible_model',\n   130\t    truncated: picked.length < count,\n   131\t  }\n   132\t}\n=== config/cliworker.example.json\n     1\t{\n     2\t  \"providers\": {\n     3\t    \"claude\": {\n     4\t      \"cli\": \"claude\",\n     5\t      \"adapter\": \"claude\",\n     6\t      \"version_args\": [\n     7\t        \"--version\"\n     8\t      ],\n     9\t      \"auth_args\": [\n    10\t        \"auth\",\n    11\t        \"status\"\n    12\t      ],\n    13\t      \"auth_ok\": \"logged in\",\n    14\t      \"readonly\": true\n    15\t    },\n    16\t    \"codex\": {\n    17\t      \"cli\": \"codex\",\n    18\t      \"adapter\": \"codex\",\n    19\t      \"version_args\": [\n    20\t        \"--version\"\n    21\t      ],\n    22\t      \"auth_args\": [\n    23\t        \"login\",\n    24\t        \"status\"\n    25\t      ],\n    26\t      \"auth_ok\": \"logged in\",\n    27\t      \"readonly\": true\n    28\t    },\n    29\t    \"codebuddy\": {\n    30\t      \"cli\": \"codebuddy\",\n    31\t      \"adapter\": \"codebuddy\",\n    32\t      \"version_args\": [\n    33\t        \"--version\"\n    34\t      ],\n    35\t      \"auth_args\": [],\n    36\t      \"readonly\": true\n    37\t    },\n    38\t    \"cursor-wsl\": {\n    39\t      \"cli\": \"wsl.exe\",\n    40\t      \"args_prefix\": [\n    41\t        \"-e\",\n    42\t        \"bash\",\n    43\t        \"-lc\",\n    44\t        \"agent\"\n    45\t      ],\n    46\t      \"adapter\": \"cursor-wsl\",\n    47\t      \"readonly\": false\n    48\t    },\n    49\t    \"gemini\": {\n    50\t      \"cli\": \"gemini\",\n    51\t      \"adapter\": \"gemini\",\n    52\t      \"readonly\": true\n    53\t    }\n    54\t  },\n    55\t  \"models\": {\n    56\t    \"claude-opus-5-5\": {\n    57\t      \"provider\": \"claude\",\n    58\t      \"id\": \"claude-opus-5-5\",\n    59\t      \"tier\": \"top\",\n    60\t      \"identity\": \"verified\",\n    61\t      \"identity_group\": \"anthropic-opus-5-5\",\n    62\t      \"vendor\": \"anthropic\",\n    63\t      \"deprecated\": false,\n    64\t      \"prices\": {\n    65\t        \"input_per_mtok\": 15,\n    66\t        \"output_per_mtok\": 75\n    67\t      },\n  