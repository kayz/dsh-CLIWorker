.includes(name) }\n131\t    12\tfunction usageFile(config) { return path.join(config._home || defaultHome(), 'usage.jsonl') }\n132\t    13\t\n133\t    14\tfunction load() {\n134\t    15\t  try { return loadConfig({ file: arg('--config') }) } catch (e) { fail(e.message) }\n135\t    16\t}\n136\t    17\t\n137\t    18\tfunction main() {\n138\t    19\t  const cmd = process.argv[2]\n139\t    20\t  const sub = process.argv[3]\n140\t    21\t  const config = load()\n141\t    22\t  if (cmd === 'providers') {\n142\t    23\t    const status = providerStatus(config)\n143\t    24\t    out({ schema: 'cliworker.providers/v1', providers: Object.entries(config.providers).map(([id, p]) => ({ id, cli: p.cli, readonly: !!p.readonly, ...status[id] })) })\n144\t    25\t    return\n145\t    26\t  }\n146\t    27\t  if (cmd === 'models' && (!sub || sub === 'list')) {\n147\t    28\t    const status = providerStatus(config)\n148\t    29\t    out({ schema: 'cliworker.models/v1', models: listModels(config, { status, includeDeprecated: flag('--all') }) })\n149\t    30\t    return\n150\t    31\t  }\n151\t    32\t  if (cmd === 'models' && sub === 'select') {\n152\t    33\t    let req = {}\n153\t    34\t    const raw = arg('--request')\n154\t    35\t    if (raw) { try { req = JSON.parse(raw) } catch (e) { fail(`bad --request JSON: ${e.message}`) } }\n155\t    36\t    const status = providerStatus(config)\n156\t    37\t    out(selectModels(config, req, { status, usage: readUsage(usageFile(config)) }))\n157\t    38\t    return\n158\t    39\t  }\n159\t    40\t  if (cmd === 'models' && sub === 'forecast') {\n160\t    41\t    const key = arg('--model', null)\n161\t    42\t    const usage = readUsage(usageFile(config))\n162\t    43\t    out({ schema: 'cliworker.forecast/v1', forecast: forecast({ records: usage, model: key, prices: key ? config.models[key]?.prices : undefined, quota: key ? config.quotas?.[config.models[key]?.provider] : null }) })\n163\t    44\t    return\n164\t    45\t  }\n165\t    46\t  