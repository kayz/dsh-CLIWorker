23\t      \"tier\": \"standard\",\n   224\t      \"level\": \"Quick\",\n   225\t      \"identity\": \"unverified\",\n   226\t      \"identity_group\": \"google-gemini-3.7-flash\",\n   227\t      \"vendor\": \"google\",\n   228\t      \"deprecated\": false,\n   229\t      \"prices\": {\n   230\t        \"input_per_mtok\": 0.3,\n   231\t        \"output_per_mtok\": 1.2\n   232\t      }\n   233\t    },\n   234\t    \"claude-haiku-5-5\": {\n   235\t      \"provider\": \"claude\",\n   236\t      \"id\": \"claude-haiku-5-5\",\n   237\t      \"tier\": \"standard\",\n   238\t      \"level\": \"Quick\",\n   239\t      \"identity\": \"unverified\",\n   240\t      \"identity_group\": \"anthropic-haiku-5-5\",\n   241\t      \"vendor\": \"anthropic\",\n   242\t      \"deprecated\": false,\n   243\t      \"prices\": {\n   244\t        \"input_per_mtok\": 0.8,\n   245\t        \"output_per_mtok\": 4\n   246\t      }\n   247\t    }\n   248\t  },\n   249\t  \"quotas\": {\n   250\t    \"claude\": {\n   251\t      \"window\": \"5h\",\n   252\t      \"remaining_pct\": 100,\n   253\t      \"reset_at\": null\n   254\t    },\n   255\t    \"codex\": {\n   256\t      \"window\": \"7d\",\n   257\t      \"remaining_pct\": 100,\n   258\t      \"reset_at\": null\n   259\t    },\n   260\t    \"codebuddy\": {\n   261\t      \"window\": \"credits\",\n   262\t      \"remaining\": 1000,\n   263\t      \"unit\": \"credits\"\n   264\t    }\n   265\t  }\n   266\t}\n=== dsh.plugin.json\n     1\t{\n     2\t  \"name\": \"dsh-cliworker\",\n     3\t  \"description\": \"CLIWorker for DSH: independent model/provider selection, availability, cost and forecast layer\",\n     4\t  \"version\": \"0.1.0\",\n     5\t  \"entry\": {\n     6\t    \"name\": \"dsh-cliworker\",\n     7\t    \"inject\": []\n     8\t  }\n     9\t}\n=== cordis.patch.yml\n     1\t# dsh-cliworker bundle layer: registers the host half (model routes).\n     2\t- insert:\n     3\t    - id: dsh-cliworker\n     4\t      name: dsh-cliworker\n=== test/select.test.mjs\n     1\timport test from 'node:test'\n     2\timport assert from 'node:assert/strict'\n     3\timport fs from 'node:fs'\n     4\timport os from 'node:os'\n     5\timport path from 'node:path'\n     6\timport { selectModels, listModels } from '../lib/select.mjs'\n     7\timport { forecast, estimateCost } from '../lib/forecast.mjs'\n     8\t\n     9\tfunction config() {\n    10\t  return {\n    11\t    providers: {\n    12\t      claude: { cli: 'claude', adapter: 'claude', readonly: true },\n    13\t      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\n    14\t      codex: { cli: 'codex', adapter: 'codex', readonly: true },\n    15\t    },\n    16\t    models: {\n    17\t      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\n    18\t      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\n    19\t      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\n    20\t      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\n    21\t    },\n    22\t    quotas: {},\n    23\t  }\n    24\t}\n    25\t\n    26\ttest('deprecated and unverified models never enter candidates', () => {\n    27\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    28\t  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\n    29\t  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\n    30\t  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\n    31\t  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\n    32\t})\n    33\t\n    34\ttest('read-only requirement rejects providers without it', () => {\n    35\t  const c = config()\n    36\t  c.models.b.readonly = false\n    37\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    38\t  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\n    39\t  assert.deepEqual(r.models.map((m) => m.key), ['a'])\n    40\t  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\n    41\t})\n    42\t\n    43\ttest('forecast is unknown without samples and deterministic with fixed samples', () => {\n    44\t  assert.equal(forecast({ records: [], model: 'a' }).status, 'unknown')\n    45\t  const now = Date.parse('2026-11-07T00:00:00Z')\n    46\t  const records = [\n    47\t    { model: 'a', at: '2026-11-06T23:00:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n    48\t    { model: 'a', at: '2026-11-06T23:30:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n    49\t  ]\n    50\t  const f = forecast({ records, model: 'a', now, quota: { remaining_usd: 100 } })\n    51\t  assert.equal(f.status, 'known')\n    52\t  assert.equal(f.burn_per_task, 10)\n    53\t  assert.equal(f.tasks_left, 10)\n    54\t  assert.equal(f.risk, 'ok')\n    55\t  assert.equal(estimateCost({ input_tokens: 1_000_000, output_tokens: 0, prices: { input_per_mtok: 10, output_per_mtok: 20 } }), 10)\n    56\t})\n    57\t\n    58\ttest('models list hides deprecated by default, includes with flag', () => {\n    59\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    60\t  const a = listModels(config(), { status })\n    61\t  assert.ok(!a.some((m) => m.key === 'old'))\n    62\t  const b = listModels(config(), { status, includeDeprecated: true })\n    63\t  assert.ok(b.some((m) => m.key === 'old' && m.deprecated))\n    64\t})\n    65\t\r\n    66\t\n    67\ttest('requests return CLI calls and honor level/usage/count', () => {\n    68\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    69\t  const c = config()\n    70\t  c.models.a.level = 'Top'; c.models.b.level = 'Top'; c.models.old.level = 'Top'; c.models.unverified.level = 'High'\n    71\t  const r = selectModels(c, { level: 'Top', count: 2, usage: 'Heavy' }, { status })\n    72\t  assert.equal(r.ok, true)\n    73\t  assert.equal(r.level, 'Top')\n    74\t  assert.equal(r.calls.length, 2)\n    75\t  assert.ok(r.calls.every((x) => x.command && Array.isArray(x.args) && x.input === 'stdin'))\n    76\t  assert.equal(r.calls[0].cwd, '<workspace>')\n    77\t})\n    78\t\n    79\ttest('missing level is rejected and no model is returned', () => {\n    80\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    81\t  const r = selectModels(config(), { count: 2 }, { status })\n    82\t  assert.equal(r.ok, false)\n    83\t  assert.equal(r.reason, 'E_LEVEL_REQUIRED')\n    84\t  assert.deepEqual(r.models, [])\n    85\t})\r\n=== README.md\n     1\t# CLIWorker\n     2\t\n     3\tAgentLine 的独立模型层。AgentLine 只保留“模型来源”指针；provider/CLI、模型列举、可用性、价格、用量与预测全部由 CLIWorker 负责。\n     4\t\n     5\t## 边界\n     6\t\n     7\t```text\n     8\tAgentLine  --ModelRequest JSON-->  CLIWorker  --ModelSelection JSON-->  AgentLine\n     9\t```\n    10\t\n    11\t- AgentLine 不读取 provider CLI、不维护价格表、不做预测。\n    12\t- CLIWorker 可以独立安装、替换、禁用。\n    13\t- AgentLine 的 `modelSource` 只保存 CLIWorker 的启动配置。\n    14\t\n    15\t## CLI\n    16\t\n    17\t```bash\n    18\tnode bin/cliworker.mjs providers\n    19\tnode bin/cliworker.mjs models list\n    20\tnode bin/cliworker.mjs models list --all\n    21\tnode bin/cliworker.mjs models select --request '{\"role\":\"dev\",\"tier\":\"top\",\"count\":2,\"importance\":\"high\"}'\n    22\tnode bin/cliworker.mjs models forecast --model hy4free\n    23\tnode bin/cliworker.mjs usage record --json '{\"model\":\"hy4free\",\"input_tokens\":1000,\"output_tokens\":500}'\n    24\tnode bin/cliworker.mjs usage summary\n    25\t```\n    26\t\n    27\t所有输出都是 JSON。\n    28\t\n    29\t## 配置\n    30\t\n    31\t默认配置：`$CLIWORKER_HOME/config.json`（默认 `~/.cliworker/config.json`）。  \n    32\t参考 `config/cliworker.example.json`。\n    33\t\n    34\t配置包含：\n    35\t\n    36\t- providers：CLI、adapter、版本/认证命令、是否可强制只读\n    37\t- models：provider、id、tier、identity、vendor、价格、弃用\n    38\t- quotas：各渠道剩余额度/窗口\n    39\t\n    40\t## AgentLine 集成\n    41\t\n    42\tAgentLine 仅保存：\n    43\t\n    44\t```json\n    45\t\"modelSource\": {\n    46\t  \"kind\": \"cliworker\",\n    47\t  \"command\": \"node\",\n    48\t  \"args\": [\"C:/git/dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"C:/git/dsh-CLIWorker/config/cliworker.local.json\"]\n    49\t}\n    50\t```\n    51\t\n    52\t选模时调用：\n    53\t\n    54\t```text\n    55\tcliworker models select --request <ModelRequest>\n    56\t```\n    57\t\n    58\t返回的 `models[]` 是 `ModelHandle[]`，AgentLine 按顺序尝试。\n    59\t\n    60\t## 安全\n    61\t\n    62\t- 未验证 identity、不可调用、弃用模型不会出现在候选中。\n    63\t- `rejected[]` 保留原因，便于审计。\n    64\t- 预测缺样本返回 `unknown`，不伪造通过。\n    65\t\r\n{\n  \"schema\": \"agentline.blueprint/v1\",\n  \"id\": \"cliworker-v2\",\n  \"title\": \"CLIWorker v2：CLI 发现、模型白名单与额度调度\",\n  \"input\": \"# CLIWorker v2 需求书（Blueprint 输入）\\n\\n目标仓库：C:\\\\git\\\\dsh-CLIWorker（DSH 插件 `dsh-cliworker`，Node 20+，ESM，零第三方依赖，现有 16 个文件、3 次提交在 main）。\\n\\n## A. 现状与已确认的缺陷\\n\\n现有结构：`bin/cliworker.mjs`（外壳）、`lib/index.js`（DSH 宿主插件，注册 /cliworker/providers、/models、/select、/forecast）、`lib/cli.mjs`（CLI 实现）、`lib/select.mjs`（选模）、`lib/forecast.mjs`（成本/余量预测）、`lib/availability.mjs`（provider 探测）、`lib/config.mjs`（配置与 usage.jsonl）、`config/cliworker.example.json`、`test/select.test.mjs`（6 个用例）。\\n\\n已复现的问题（必须在本次改动中修掉）：\\n\\n1. 配额形状与预测器不匹配：配置用 `remaining_pct`（claude 5h、codex 7d）和 `remaining + unit:\\\"credits\\\"`（codebuddy），但 `forecast()` 只认 `remaining_usd` 或 `unit===\\\"tokens\\\"`。实测 `{remaining_pct:5}` 与 `{remaining:1,unit:\\\"credits\\\"}` 的 risk 恒为 `unknown`，导致 `usage:\\\"Heavy\\\"` 的耗尽拒选永不触发、按剩余任务排序永不生效。\\n2. 打包漏文件：`package.json` 无 `bin` 字段，`files` 不含 `bin/` 与 `config/`，而 README 与 AgentLine 集成都指向 `bin/cliworker.mjs`、`config/cliworker.local.json`。\\n3. 无 `scripts`，`node --test test` 在 Node 22 报 MODULE_NOT_FOUND（目录参数被当模块解析）；测试只覆盖 select/forecast，cli/index/availability/config 无用例。\\n4. usage 落盘位置固定在 `~/.cliworker/usage.jsonl`，与 `--config` 无关；`.gitignore` 忽略的却是仓库根 `usage.jsonl`，规则永不命中。`config/cliworker.local.json` 与 example 逐字节相同（占位数据）。\\n5. 小问题：句柄同时输出完全相同的 `cli` 与 `call`（响应体翻倍）；`fs`/`SELECT_SCHEMA`/`isObject` 未使用；`config.mjs` 在配置为 null 时抛 TypeError 而非可读错误；`availability.mjs` 在 win32 用 `shell:true` 拼参数且有被 shell 改写的风险、每次选模同步探测全部 provider 无缓存（实测 3.4s）；`select.mjs` 每个模型重复算 3 次 forecast；README 请求示例里的 `role`/`importance` 被静默忽略。\\n\\n## B. 本次要交付的能力\\n\\n### 1. 修复上述缺陷\\n所有第 A 节列出的缺陷都要修掉，并且每条修复都要能被一条可执行命令验证。\\n\\n### 2. 插件扫描本地硬盘，发现已安装的 CLI 工具\\n- 支持 Linux、macOS、Windows、WSL 四个平台；WSL 需要能跨发行版枚举。\\n- 已知要覆盖的 CLI 至少包括：codex、claudecode（claude）、deepseek harness（dsh）、cursor、codebuddy、antigravity、trae、zcode、qoder、kimi、opencode；未知 CLI 也要能按规则被发现并标记为未识别。\\n- 扫描不得把用户机上的凭据读出来或写进日志；**CLI 的登录 token 由用户提供**（用户输入/配置项），程序只使用、不落盘明文、不回显。\\n- 发现结果要落盘成可复查的清单（路径、版本、平台、探测证据），并能增量刷新。\\n\\n### 3. 获取每个 CLI 支持的 model 列表\\n- 每个 CLI 有自己的模型枚举方式（子命令、`--help` 文本、本地缓存文件、API）；要按 CLI 分别实现，失败要能回退到“用户手工补录”，不允许写死模型表。\\n- 结果要归一：模型 id、所属 CLI、厂商、能力标记、来源与获取时间。\\n\\n### 4. 模型管理（白名单 + 等级 + 可用性 + 用量）\\n- **4.1 白名单**：用户显式选择；不在白名单的模型一律不参与选模、不出现在候选中，也不被探测/计费。\\n- **4.2 等级**：模型分四档（Top / High / Middle / Quick），等级来源要可追溯（配置、CLI 声明或实测）。\\n- **4.3 可用性**：用小 token 的真实调用验证，而不是只看“已安装”；要区分 unverified / callable / blocked / deprecated，并记录验证时间与证据。\\n- **4.4 用量评估**：既要读取各 CLI 的计划用量/余额，也要随用户使用估算“还能用多少 token”（单位 Mtoken）。示例：claudecode 5 小时窗口下，opus5.5 可用 2M token、sonnet5.5 可用 10M token；已用 50% 时 sonnet5.5 降到 5M。要能知道额度刷新时间（窗口起点/重置时刻）。\\n- **4.5 选模策略**：用户请求 model 时，按可用量给出模型；在保证任务能完成的前提下尽量用足时间窗口限额；充值/付费额度放在兜底位置（先用计划内额度，快见底才用充值额度），并保留拒选原因。\\n\\n### 5. 模型管理界面与实时数据\\n- 设计模型管理界面（白名单、等级、可用性、余量、刷新时间、最近一次实测证据）。\\n- 实时数据怎么来、怎么刷新、失败怎么显示，都要写清楚；页面不要假装有数据——缺样本就显示 unknown。\\n\\n### 6. 返回 CLI 调用方式\\n- 用户请求 CLI 时返回可直接执行的调用方式，并且带上选定的 model；不同平台/CLI 的形态差异（命令、参数、只读模式、cwd、stdin）要覆盖。\\n\\n## C. 约束\\n\\n- 保持零第三方运行时依赖（Node 20+ 内置模块）；插件与 CLI 两种入口都要能用。\\n- 沿用现有契约：`cliworker.selection/v1`、`cliworker.model/v1`、`cliworker.handle/v1`、`cliworker.forecast/v1`；如需升级 schema，必须写清兼容与迁移。\\n- 密钥/令牌不进仓库、不进日志、不进 JSON 输出。\\n- 每个任务都要有可执行的验收命令，不写“看起来正确”。\\n\\n## D. 边界（用户已拍板，硬约束）\\n\\nAgentLine 不再拥有：provider/CLI 管理、模型目录、模型身份、价格、额度、消耗速度、预测、排序/降级。\\n\\nAgentLine 只负责：\\n- 指定 level / count / usage；\\n- 接收 `calls[]`；\\n- 按顺序调用；\\n- 数量不够时再申请；\\n- 记录流程状态。\\n\\n这个边界必须体现在契约上：CLIWorker 要对 AgentLine 隐藏 provider 细节，只暴露 `ModelRequest` / `ModelSelection` / `ModelHandle` 与稳定的错误码；AgentLine 侧不应再保留任何模型逻辑。AgentLine 侧代码改动不属于本仓库范围，但 CLIWorker 必须提供它依赖的契约与错误语义。\\n\\n## E. CLIWorker 成熟度清单（验收口径）\\n\\n一个“成熟可信”的 CLIWorker 至少要具备下面这些，缺哪项就要在任务图里单列一个任务：\\n\\n1. **稳定契约**：ModelRequest v1、ModelSelection v1、ModelHandle v1；明确错误码、超时、部分失败、无候选、数量不足。\\n2. **Provider 层**：CLI 发现、版本、认证；模型列表；真实 probe；可用性状态 `callable / blocked / unavailable / deprecated`；只读能力；identity 证据来源；超时/重试/降级。\\n3. **模型目录**：Top / High / Middle / Quick 四档；弃用与别名；白名单；价格；能力（上下文、只读）。\\n4. **用量与预测**：任务前后 token/usage；按模型/渠道的 burn rate；剩余额度、预计耗尽时间、可跑任务数；Heavy / Normal / Light；重要任务储备；`unknown` 状态不伪造。\\n5. **插件形态**：DSH host 路由；安装/升级/回滚；配置与密钥隔离；健康检查；审计日志；不向 AgentLine 泄漏 provider 细节。\\n6. **可靠性**：并发选择/申请；数量不足时返回 `truncated`；重试不重复扣减；失败不返回假 handle；服务重启后状态可恢复。\\n7. **测试**：契约测试；provider fixture；用量/预测确定性测试；插件安装 e2e；发布前真实 skill 冒烟。\\n\\n## F. 输出格式硬约束（直接影响自动校验，必须遵守）\\n\\n- 最后只输出一个 JSON 对象，不要加代码块标记，JSON 必须是整段输出的结尾。\\n- **正文里禁止出现 ASCII 双引号字符（U+0022）**：引用字段名用反引号，示例值用单引号或中文引号「」；所有 JSON 接口示例都放进最后那个 JSON 对象的 `interfaces` 字段里。\\n- 原因：自动校验用花括号扫描定位最后的 JSON，正文里的双引号会被当成字符串边界，导致整段输出被判为无 JSON。\\n- `task_graph` 的每个任务都必须齐备 `id / title / inputs / outputs / write_scope / depends_on / acceptance / acceptance_direction / test_levels`，且 `depends_on` 只能引用真实存在的任务 ID。\",\n  \"from\": null,\n  \"status\": \"running\",\n  \"phase\": \"design\",\n  \"round\": {\n    \"current\": 1,\n    \"max\": 3\n  },\n  \"roles\": {\n    \"designer\": {\n      \"model\": \"claude-opus-5-5\",\n      \"id\": \"claude-opus-5-5\",\n      \"tier\": \"top\",\n      \"provider\": \"claude\",\n      \"vendor\": \"anthropic\",\n      \"identity_group\": \"anthropic-opus-5-5\",\n      \"identity\": \"verified\"\n    },\n    \"reviewer\": {\n      \"model\": \"hy4std\",\n      \"id\": \"hy4std\",\n      \"tier\": \"top\",\n      \"provider\": \"codebuddy\",\n      \"vendor\": \"tencent\",\n      \"identity_group\": \"hy4-std\",\n      \"identity\": \"verified\"\n    },\n    \"test_architect\": {\n      \"model\": \"hy4free\",\n      \"id\": \"hy4free\",\n      \"tier\": \"top\",\n      \"provider\": \"codebuddy\",\n      \"vendor\": \"tencent\",\n      \"identity_group\": \"hy4-free\",\n      \"identity\": \"verified\"\n    }\n  },\n  \"awaiting\": null,\n  \"last_error\": null,\n  \"calls\": [],\n  \"created_at\": \"2026-11-07T10:42:17.590Z\",\n  \"updated_at\": \"2026-11-07T10:42:17.591Z\",\n  \"revision\": 1\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f","uuid":"28555ad0-702a-4044-9e7b-3f244567377a","timestamp":"2026-11-07T10:42:36.594Z","tool_use_result":{"stdout":"=== lib/availability.mjs\n     1\timport { spawnSync } from 'node:child_process'\n     2\t\n     3\tfunction run(command, args, timeout = 20_000) {\n     4\t  try {\n     5\t    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n     6\t    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n     7\t  } catch (e) {\n     8\t    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n     9\t  }\n    10\t}\n    11\t\n    12\texport function checkProvider(provider, { probe = true } = {}) {\n    13\t  const cli = provider.cli\n    14\t  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n    15\t  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n    16\t  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n    17\t  const v = run(cli, versionArgs)\n    18\t  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n    19\t  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n    20\t  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n    21\t  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n    22\t  const auth = run(cli, [...prefix, ...provider.auth_args])\n    23\t  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n    24\t  const ok = auth.ok && (\n    25\t    !provider.auth_ok ||\n    26\t    text.includes(String(provider.auth_ok).toLowerCase()) ||\n    27\t    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n    28\t    /\\blogged in\\b/.test(text)\n    29\t  )\n    30\t  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n    31\t}\n    32\t\n    33\texport function providerStatus(config, opts = {}) {\n    34\t  const out = {}\n    35\t  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n    36\t  return out\n    37\t}\n=== lib/config.mjs\n     1\timport fs from 'node:fs'\n     2\timport os from 'node:os'\n     3\timport path from 'node:path'\n     4\t\n     5\texport const SCHEMA = 'cliworker.config/v1'\n     6\t\n     7\texport function defaultHome() {\n     8\t  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n     9\t}\n    10\t\n    11\texport function loadConfig({ file } = {}) {\n    12\t  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n    13\t  let raw\n    14\t  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n    15\t    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n    16\t    error.code = 'E_CONFIG'\n    17\t    throw error\n    18\t  }\n    19\t  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n    20\t  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n    21\t  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n    22\t  return { ...raw, _file: root, _home: defaultHome() }\n    23\t}\n    24\t\n    25\texport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n    26\t\n    27\texport function readUsage(file) {\n    28\t  try {\n    29\t    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n    30\t  } catch { return [] }\n    31\t}\n    32\t\n    33\texport function appendUsage(file, row) {\n    34\t  ensureDir(path.dirname(file))\n    35\t  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n    36\t}\n=== bin/cliworker.mjs\n     1\t#!/usr/bin/env node\n     2\timport '../lib/cli.mjs'\n=== config/cliworker.example.json\n     1\t{\n     2\t  \"providers\": {\n     3\t    \"claude\": {\n     4\t      \"cli\": \"claude\",\n     5\t      \"adapter\": \"claude\",\n     6\t      \"version_args\": [\n     7\t        \"--version\"\n     8\t      ],\n     9\t      \"auth_args\": [\n    10\t        \"auth\",\n    11\t        \"status\"\n    12\t      ],\n    13\t      \"auth_ok\": \"logged in\",\n    14\t      \"readonly\": true\n    15\t    },\n    16\t    \"codex\": {\n    17\t      \"cli\": \"codex\",\n    18\t      \"adapter\": \"codex\",\n    19\t      \"version_args\": [\n    20\t        \"--version\"\n    21\t      ],\n    22\t      \"auth_args\": [\n    23\t        \"login\",\n    24\t        \"status\"\n    25\t      ],\n    26\t      \"auth_ok\": \"logged in\",\n    27\t      \"readonly\": true\n    28\t    },\n    29\t    \"codebuddy\": {\n    30\t      \"cli\": \"codebuddy\",\n    31\t      \"adapter\": \"codebuddy\",\n    32\t      \"version_args\": [\n    33\t        \"--version\"\n    34\t      ],\n    35\t      \"auth_args\": [],\n    36\t      \"readonly\": true\n    37\t    },\n    38\t    \"cursor-wsl\": {\n    39\t      \"cli\": \"wsl.exe\",\n    40\t      \"args_prefix\": [\n    41\t        \"-e\",\n    42\t        \"bash\",\n    43\t        \"-lc\",\n    44\t        \"agent\"\n    45\t      ],\n    46\t      \"adapter\": \"cursor-wsl\",\n    47\t      \"readonly\": false\n    48\t    },\n    49\t    \"gemini\": {\n    50\t      \"cli\": \"gemini\",\n    51\t      \"adapter\": \"gemini\",\n    52\t      \"readonly\": true\n    53\t    }\n    54\t  },\n    55\t  \"models\": {\n    56\t    \"claude-opus-5-5\": {\n    57\t      \"provider\": \"claude\",\n    58\t      \"id\": \"claude-opus-5-5\",\n    59\t      \"tier\": \"top\",\n    60\t      \"identity\": \"verified\",\n    61\t      \"identity_group\": \"anthropic-opus-5-5\",\n    62\t      \"vendor\": \"anthropic\",\n    63\t      \"deprecated\": false,\n    64\t      \"prices\": {\n    65\t        \"input_per_mtok\": 15,\n    66\t        \"output_per_mtok\": 75\n    67\t      },\n    68\t      \"limits\": {\n    69\t        \"context_tokens\": 200000\n    70\t      },\n    71\t      \"level\": \"Top\"\n    72\t    },\n    73\t    \"gpt-6-astra\": {\n    74\t      \"provider\": \"codex\",\n    75\t      \"id\": \"gpt-6-astra\",\n    76\t      \"tier\": \"top\",\n    77\t      \"identity\": \"unverified\",\n    78\t      \"identity_group\": \"openai-astra\",\n    79\t      \"vendor\": \"openai\",\n    80\t      \"deprecated\": false,\n    81\t      \"prices\": {\n    82\t        \"input_per_mtok\": 2,\n    83\t        \"output_per_mtok\": 12\n    84\t      },\n    85\t      \"level\": \"Top\"\n    86\t    },\n    87\t    \"gpt-6.1-sol\": {\n    88\t      \"provider\": \"codex\",\n    89\t      \"id\": \"gpt-6.1-sol\",\n    90\t      \"tier\": \"top\",\n    91\t      \"identity\": \"unverified\",\n    92\t      \"identity_group\": \"openai-sol\",\n    93\t      \"vendor\": \"openai\",\n    94\t      \"deprecated\": false,\n    95\t      \"prices\": {\n    96\t        \"input_per_mtok\": 2,\n    97\t        \"output_per_mtok\": 12\n    98\t      },\n    99\t      \"level\": \"Top\"\n   100\t    },\n   101\t    \"gpt-6.1-terra\": {\n   102\t      \"provider\": \"codex\",\n   103\t      \"id\": \"gpt-6.1-terra\",\n   104\t      \"tier\": \"top\",\n   105\t      \"identity\": \"unverified\",\n   106\t      \"identity_group\": \"openai-terra\",\n   107\t      \"vendor\": \"openai\",\n   108\t      \"deprecated\": false,\n   109\t      \"prices\": {\n   110\t        \"input_per_mtok\": 1.5,\n   111\t        \"output_per_mtok\": 9\n   112\t      },\n   113\t      \"level\": \"High\"\n   114\t    },\n   115\t    \"hy4free\": {\n   116\t      \"provider\": \"codebuddy\",\n   117\t      \"id\": \"hy4free\",\n   118\t      \"tier\": \"top\",\n   119\t      \"identity\": \"verified\",\n   120\t      \"identity_group\": \"hy4-free\",\n   121\t      \"vendor\": \"tencent\",\n   122\t      \"deprecated\": false,\n   123\t      \"prices\": {\n   124\t        \"input_per_mtok\": 0,\n   125\t        \"output_per_mtok\": 0\n   126\t      },\n   127\t      \"level\": \"Top\"\n   128\t    },\n   129\t    \"deepseek-v4.1-flash\": {\n   130\t      \"provider\": \"codebuddy\",\n   131\t      \"id\": \"deepseek-v4.1-flash\",\n   132\t      \"tier\": \"top\",\n   133\t      \"identity\": \"verified\",\n   134\t      \"identity_group\": \"deepseek-flash\",\n   135\t      \"vendor\": \"tencent\",\n   136\t      \"deprecated\": false,\n   137\t      \"prices\": {\n   138\t        \"input_per_mtok\": 0.5,\n   139\t        \"output_per_mtok\": 2\n   140\t      },\n   141\t      \"level\": \"High\"\n   142\t    },\n   143\t    \"deepseek-v4-pro\": {\n   144\t      \"provider\": \"codebuddy\",\n   145\t      \"id\": \"deepseek-v4-pro\",\n   146\t      \"tier\": \"top\",\n   147\t      \"identity\": \"unverified\",\n   148\t      \"identity_group\": \"deepseek-pro\",\n   149\t      \"vendor\": \"tencent\",\n   150\t      \"deprecated\": true,\n   151\t      \"deprecated_reason\": \"CodeBuddy only allows deepseek-v4.1-flash (1017)\"\n   152\t    },\n   153\t    \"claude-opus-4-5\": {\n   154\t      \"provider\": \"claude\",\n   155\t      \"id\": \"claude-opus-4-5\",\n   156\t      \"tier\": \"advanced\",\n   157\t      \"identity\": \"unverified\",\n   158\t      \"identity_group\": \"anthropic-opus-4-5\",\n   159\t      \"vendor\": \"anthropic\",\n   160\t      \"deprecated\": true,\n   161\t      \"deprecated_reason\": \"superseded by opus 5.5\"\n   162\t    },\n   163\t    \"cursor-wsl-grok-4.7\": {\n   164\t      \"provider\": \"cursor-wsl\",\n   165\t      \"id\": \"grok-4.7\",\n   166\t      \"tier\": \"top\",\n   167\t      \"identity\": \"verified\",\n   168\t      \"identity_group\": \"xai-grok-4-7\",\n   169\t      \"vendor\": \"xai\",\n   170\t      \"deprecated\": false,\n   171\t      \"prices\": {\n   172\t        \"input_per_mtok\": 3,\n   173\t        \"output_per_mtok\": 15\n   174\t      },\n   175\t      \"readonly\": false,\n   176\t      \"level\": \"High\"\n   177\t    },\n   178\t    \"gemini-4-argon-high\": {\n   179\t      \"provider\": \"gemini\",\n   180\t      \"id\": \"gemini-4-argon-high\",\n   181\t      \"tier\": \"top\",\n   182\t      \"identity\": \"unverified\",\n   183\t      \"identity_group\": \"google-gemini-4-argon\",\n   184\t      \"vendor\": \"google\",\n   185\t      \"deprecated\": false,\n   186\t      \"prices\": {\n   187\t        \"input_per_mtok\": 1.25,\n   188\t        \"output_per_mtok\": 10\n   189\t      },\n   190\t      \"level\": \"High\"\n   191\t    },\n   192\t    \"hy3\": {\n   193\t      \"provider\": \"codebuddy\",\n   194\t      \"id\": \"hy3\",\n   195\t      \"tier\": \"advanced\",\n   196\t      \"level\": \"Middle\",\n   197\t      \"identity\": \"verified\",\n   198\t      \"identity_group\": \"hy3\",\n   199\t      \"vendor\": \"tencent\",\n   200\t      \"deprecated\": false,\n   201\t      \"prices\": {\n   202\t        \"input_per_mtok\": 0.2,\n   203\t        \"output_per_mtok\": 0.8\n   204\t      }\n   205\t    },\n   206\t    \"hy3x\": {\n   207\t      \"provider\": \"codebuddy\",\n   208\t      \"id\": \"hy3-x\",\n   209\t      \"tier\": \"advanced\",\n   210\t      \"level\": \"Middle\",\n   211\t      \"identity\": \"verified\",\n   212\t      \"identity_group\": \"hy3-x\",\n   213\t      \"vendor\": \"tencent\",\n   214\t      \"deprecated\": false,\n   215\t      \"prices\": {\n   216\t        \"input_per_mtok\": 0.3,\n   217\t        \"output_per_mtok\": 1\n   218\t      }\n   219\t    },\n   220\t    \"gemini-3.7-flash-high\": {\n   221\t      \"provider\": \"gemini\",\n   222\t      \"id\": \"gemini-3.7-flash-high\",\n   223\t      \"tier\": \"standard\",\n   224\t      \"level\": \"Quick\",\n   225\t      \"identity\": \"unverified\",\n   226\t      \"identity_group\": \"google-gemini-3.7-flash\",\n   227\t      \"vendor\": \"google\",\n   228\t      \"deprecated\": false,\n   229\t      \"prices\": {\n   230\t        \"input_per_mtok\": 0.3,\n   231\t        \"output_per_mtok\": 1.2\n   232\t      }\n   233\t    },\n   234\t    \"claude-haiku-5-5\": {\n   235\t      \"provider\": \"claude\",\n   236\t      \"id\": \"claude-haiku-5-5\",\n   237\t      \"tier\": \"standard\",\n   238\t      \"level\": \"Quick\",\n   239\t      \"identity\": \"unverified\",\n   240\t      \"identity_group\": \"anthropic-haiku-5-5\",\n   241\t      \"vendor\": \"anthropic\",\n   242\t      \"deprecated\": false,\n   243\t      \"prices\": {\n   244\t        \"input_per_mtok\": 0.8,\n   245\t        \"output_per_mtok\": 4\n   246\t      }\n   247\t    }\n   248\t  },\n   249\t  \"quotas\": {\n   250\t    \"claude\": {\n   251\t      \"window\": \"5h\",\n   252\t      \"remaining_pct\": 100,\n   253\t      \"reset_at\": null\n   254\t    },\n   255\t    \"codex\": {\n   256\t      \"window\": \"7d\",\n   257\t      \"remaining_pct\": 100,\n   258\t      \"reset_at\": null\n   259\t    },\n   260\t    \"codebuddy\": {\n   261\t      \"window\": \"credits\",\n   262\t      \"remaining\": 1000,\n   263\t      \"unit\": \"credits\"\n   264\t    }\n   265\t  }\n   266\t}\n=== dsh.plugin.json\n     1\t{\n     2\t  \"name\": \"dsh-cliworker\",\n     3\t  \"description\": \"CLIWorker for DSH: independent model/provider selection, availability, cost and forecast layer\",\n     4\t  \"version\": \"0.1.0\",\n     5\t  \"entry\": {\n     6\t    \"name\": \"dsh-cliworker\",\n     7\t    \"inject\": []\n     8\t  }\n     9\t}\n=== cordis.patch.yml\n     1\t# dsh-cliworker bundle layer: registers the host half (model routes).\n     2\t- insert:\n     3\t    - id: dsh-cliworker\n     4\t      name: dsh-cliworker\n=== test/select.test.mjs\n     1\timport test from 'node:test'\n     2\timport assert from 'node:assert/strict'\n     3\timport fs from 'node:fs'\n     4\timport os from 'node:os'\n     5\timport path from 'node:path'\n     6\timport { selectModels, listModels } from '../lib/select.mjs'\n     7\timport { forecast, estimateCost } from '../lib/forecast.mjs'\n     8\t\n     9\tfunction config() {\n    10\t  return {\n    11\t    providers: {\n    12\t      claude: { cli: 'claude', adapter: 'claude', readonly: true },\n    13\t      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\n    14\t      codex: { cli: 'codex', adapter: 'codex', readonly: true },\n    15\t    },\n    16\t    models: {\n    17\t      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\n    18\t      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\n    19\t      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\n    20\t      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\n    21\t    },\n    22\t    quotas: {},\n    23\t  }\n    24\t}\n    25\t\n    26\ttest('deprecated and unverified models never enter candidates', () => {\n    27\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    28\t  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\n    29\t  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\n    30\t  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\n    31\t  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\n    32\t})\n    33\t\n    34\ttest('read-only requirement rejects providers without it', () => {\n    35\t  const c = config()\n    36\t  c.models.b.readonly = false\n    37\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    38\t  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\n    39\t  assert.deepEqual(r.models.map((m) => m.key), ['a'])\n    40\t  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\n    41\t})\n    42\t\n    43\ttest('forecast is unknown without samples and deterministic with fixed samples', () => {\n    44\t  assert.equal(forecast({ records: [], model: 'a' }).status, 'unknown')\n    45\t  const now = Date.parse('2026-11-07T00:00:00Z')\n    46\t  const records = [\n    47\t    { model: 'a', at: '2026-11-06T23:00:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n    48\t    { model: 'a', at: '2026-11-06T23:30:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n    49\t  ]\n    50\t  const f = forecast({ records, model: 'a', now, quota: { remaining_usd: 100 } })\n    51\t  assert.equal(f.status, 'known')\n    52\t  assert.equal(f.burn_per_task, 10)\n    53\t  assert.equal(f.tasks_left, 10)\n    54\t  assert.equal(f.risk, 'ok')\n    55\t  assert.equal(estimateCost({ input_tokens: 1_000_000, output_tokens: 0, prices: { input_per_mtok: 10, output_per_mtok: 20 } }), 10)\n    56\t})\n    57\t\n    58\ttest('models list hides deprecated by default, includes with flag', () => {\n    59\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    60\t  const a = listModels(config(), { status })\n    61\t  assert.ok(!a.some((m) => m.key === 'old'))\n    62\t  const b = listModels(config(), { status, includeDeprecated: true })\n    63\t  assert.ok(b.some((m) => m.key === 'old' && m.deprecated))\n    64\t})\n    65\t\r\n    66\t\n    67\ttest('requests return CLI calls and honor level/usage/count', () => {\n    68\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    69\t  const c = config()\n    70\t  c.models.a.level = 'Top'; c.models.b.level = 'Top'; c.models.old.level = 'Top'; c.models.unverified.level = 'High'\n    71\t  const r = selectModels(c, { level: 'Top', count: 2, usage: 'Heavy' }, { status })\n    72\t  assert.equal(r.ok, true)\n    73\t  assert.equal(r.level, 'Top')\n    74\t  assert.equal(r.calls.length, 2)\n    75\t  assert.ok(r.calls.every((x) => x.command && Array.isArray(x.args) && x.input === 'stdin'))\n    76\t  assert.equal(r.calls[0].cwd, '<workspace>')\n    77\t})\n    78\t\n    79\ttest('missing level is rejected and no model is returned', () => {\n    80\t  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n    81\t  const r = selectModels(config(), { count: 2 }, { status })\n    82\t  assert.equal(r.ok, false)\n    83\t  assert.equal(r.reason, 'E_LEVEL_REQUIRED')\n    84\t  assert.deepEqual(r.models, [])\n    85\t})\r\n=== README.md\n     1\t# CLIWorker\n     2\t\n     3\tAgentLine 的独立模型层。AgentLine 只保留“模型来源”指针；provider/CLI、模型列举、可用性、价格、用量与预测全部由 CLIWorker 负责。\n     4\t\n     5\t## 边界\n     6\t\n     7\t```text\n     8\tAgentLine  --ModelRequest JSON-->  CLIWorker  --ModelSelection JSON-->  AgentLine\n     9\t```\n    10\t\n    11\t- AgentLine 不读取 provider CLI、不维护价格表、不做预测。\n    12\t- CLIWorker 可以独立安装、替换、禁用。\n    13\t- AgentLine 的 `modelSource` 只保存 CLIWorker 的启动配置。\n    14\t\n    15\t## CLI\n    16\t\n    17\t```bash\n    18\tnode bin/cliworker.mjs providers\n    19\tnode bin/cliworker.mjs models list\n    20\tnode bin/cliworker.mjs models list --all\n    21\tnode bin/cliworker.mjs models select --request '{\"role\":\"dev\",\"tier\":\"top\",\"count\":2,\"importance\":\"high\"}'\n    22\tnode bin/cliworker.mjs models forecast --model hy4free\n    23\tnode bin/cliworker.mjs usage record --json '{\"model\":\"hy4free\",\"input_tokens\":1000,\"output_tokens\":500}'\n    24\tnode bin/cliworker.mjs usage summary\n    25\t```\n    26\t\n    27\t所有输出都是 JSON。\n    28\t\n    29\t## 配置\n    30\t\n    31\t默认配置：`$CLIWORKER_HOME/config.json`（默认 `~/.cliworker/config.json`）。  \n    32\t参考 `config/cliworker.example.json`。\n    33\t\n    34\t配置包含：\n    35\t\n    36\t- providers：CLI、adapter、版本/认证命令、是否可强制只读\n    37\t- models：provider、id、tier、identity、vendor、价格、弃用\n    38\t- quotas：各渠道剩余额度/窗口\n    39\t\n    40\t## AgentLine 集成\n    41\t\n    42\tAgentLine 仅保存：\n    43\t\n    44\t```json\n    45\t\"modelSource\": {\n    46\t  \"kind\": \"cliworker\",\n    47\t  \"command\": \"node\",\n    48\t  \"args\": [\"C:/git/dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"C:/git/dsh-CLIWorker/config/cliworker.local.json\"]\n    49\t}\n    50\t```\n    51\t\n    52\t选模时调用：\n    53\t\n    54\t```text\n    55\tcliworker models select --request <ModelRequest>\n    56\t```\n    57\t\n    58\t返回的 `models[]` 是 `ModelHandle[]`，AgentLine 按顺序尝试。\n    59\t\n    60\t## 安全\n    61\t\n    62\t- 未验证 identity、不可调用、弃用模型不会出现在候选中。\n    63\t- `rejected[]` 保留原因，便于审计。\n    64\t- 预测缺样本返回 `unknown`，不伪造通过。\n    65\t\r\n{\n  \"schema\": \"agentline.blueprint/v1\",\n  \"id\": \"cliworker-v2\",\n  \"title\": \"CLIWorker v2：CLI 发现、模型白名单与额度调度\",\n  \"input\": \"# CLIWorker v2 需求书（Blueprint 输入）\\n\\n目标仓库：C:\\\\git\\\\dsh-CLIWorker（DSH 插件 `dsh-cliworker`，Node 20+，ESM，零第三方依赖，现有 16 个文件、3 次提交在 main）。\\n\\n## A. 现状与已确认的缺陷\\n\\n现有结构：`bin/cliworker.mjs`（外壳）、`lib/index.js`（DSH 宿主插件，注册 /cliworker/providers、/models、/select、/forecast）、`lib/cli.mjs`（CLI 实现）、`lib/select.mjs`（选模）、`lib/forecast.mjs`（成本/余量预测）、`lib/availability.mjs`（provider 探测）、`lib/config.mjs`（配置与 usage.jsonl）、`config/cliworker.example.json`、`test/select.test.mjs`（6 个用例）。\\n\\n已复现的问题（必须在本次改动中修掉）：\\n\\n1. 配额形状与预测器不匹配：配置用 `remaining_pct`（claude 5h、codex 7d）和 `remaining + unit:\\\"credits\\\"`（codebuddy），但 `forecast()` 只认 `remaining_usd` 或 `unit===\\\"tokens\\\"`。实测 `{remaining_pct:5}` 与 `{remaining:1,unit:\\\"credits\\\"}` 的 risk 恒为 `unknown`，导致 `usage:\\\"Heavy\\\"` 的耗尽拒选永不触发、按剩余任务排序永不生效。\\n2. 打包漏文件：`package.json` 无 `bin` 字段，`files` 不含 `bin/` 与 `config/`，而 README 与 AgentLine 集成都指向 `bin/cliworker.mjs`、`config/cliworker.local.json`。\\n3. 无 `scripts`，`node --test test` 在 Node 22 报 MODULE_NOT_FOUND（目录参数被当模块解析）；测试只覆盖 select/forecast，cli/index/availability/config 无用例。\\n4. usage 落盘位置固定在 `~/.cliworker/usage.jsonl`，与 `--config` 无关；`.gitignore` 忽略的却是仓库根 `usage.jsonl`，规则永不命中。`config/cliworker.local.json` 与 example 逐字节相同（占位数据）。\\n5. 小问题：句柄同时输出完全相同的 `cli` 与 `call`（响应体翻倍）；`fs`/`SELECT_SCHEMA`/`isObject` 未使用；`config.mjs` 在配置为 null 时抛 TypeError 而非可读错误；`availability.mjs` 在 win32 用 `shell:true` 拼参数且有被 shell 改写的风险、每次选模同步探测全部 provider 无缓存（实测 3.4s）；`select.mjs` 每个模型重复算 3 次 forecast；README 请求示例里的 `role`/`importance` 被静默忽略。\\n\\n## B. 本次要交付的能力\\n\\n### 1. 修复上述缺陷\\n所有第 A 节列出的缺陷都要修掉，并且每条修复都要能被一条可执行命令验证。\\n\\n### 2. 插件扫描本地硬盘，发现已安装的 CLI 工具\\n- 支持 Linux、macOS、Windows、WSL 四个平台；WSL 需要能跨发行版枚举。\\n- 已知要覆盖的 CLI 至少包括：codex、claudecode（claude）、deepseek harness（dsh）、cursor、codebuddy、antigravity、trae、zcode、qoder、kimi、opencode；未知 CLI 也要能按规则被发现并标记为未识别。\\n- 扫描不得把用户机上的凭据读出来或写进日志；**CLI 的登录 token 由用户提供**（用户输入/配置项），程序只使用、不落盘明文、不回显。\\n- 发现结果要落盘成可复查的清单（路径、版本、平台、探测证据），并能增量刷新。\\n\\n### 3. 获取每个 CLI 支持的 model 列表\\n- 每个 CLI 有自己的模型枚举方式（子命令、`--help` 文本、本地缓存文件、API）；要按 CLI 分别实现，失败要能回退到“用户手工补录”，不允许写死模型表。\\n- 结果要归一：模型 id、所属 CLI、厂商、能力标记、来源与获取时间。\\n\\n### 4. 模型管理（白名单 + 等级 + 可用性 + 用量）\\n- **4.1 白名单**：用户显式选择；不在白名单的模型一律不参与选模、不出现在候选中，也不被探测/计费。\\n- **4.2 等级**：模型分四档（Top / High / Middle / Quick），等级来源要可追溯（配置、CLI 声明或实测）。\\n- **4.3 可用性**：用小 token 的真实调用验证，而不是只看“已安装”；要区分 unverified / callable / blocked / deprecated，并记录验证时间与证据。\\n- **4.4 用量评估**：既要读取各 CLI 的计划用量/余额，也要随用户使用估算“还能用多少 token”（单位 Mtoken）。示例：claudecode 5 小时窗口下，opus5.5 可用 2M token、sonnet5.5 可用 10M token；已用 50% 时 sonnet5.5 降到 5M。要能知道额度刷新时间（窗口起点/重置时刻）。\\n- **4.5 选模策略**：用户请求 model 时，按可用量给出模型；在保证任务能完成的前提下尽量用足时间窗口限额；充值/付费额度放在兜底位置（先用计划内额度，快见底才用充值额度），并保留拒选原因。\\n\\n### 5. 模型管理界面与实时数据\\n- 设计模型管理界面（白名单、等级、可用性、余量、刷新时间、最近一次实测证据）。\\n- 实时数据怎么来、怎么刷新、失败怎么显示，都要写清楚；页面不要假装有数据——缺样本就显示 unknown。\\n\\n### 6. 返回 CLI 调用方式\\n- 用户请求 CLI 时返回可直接执行的调用方式，并且带上选定的 model；不同平台/CLI 的形态差异（命令、参数、只读模式、cwd、stdin）要覆盖。\\n\\n## C. 约束\\n\\n- 保持零第三方运行时依赖（Node 20+ 内置模块）；插件与 CLI 两种入口都要能用。\\n- 沿用现有契约：`cliworker.selection/v1`、`cliworker.model/v1`、`cliworker.handle/v1`、`cliworker.forecast/v1`；如需升级 schema，必须写清兼容与迁移。\\n- 密钥/令牌不进仓库、不进日志、不进 JSON 输出。\\n- 每个任务都要有可执行的验收命令，不写“看起来正确”。\\n\\n## D. 边界（用户已拍板，硬约束）\\n\\nAgentLine 不再拥有：provider/CLI 管理、模型目录、模型身份、价格、额度、消耗速度、预测、排序/降级。\\n\\nAgentLine 只负责：\\n- 指定 level / count / usage；\\n- 接收 `calls[]`；\\n- 按顺序调用；\\n- 数量不够时再申请；\\n- 记录流程状态。\\n\\n这个边界必须体现在契约上：CLIWorker 要对 AgentLine 隐藏 provider 细节，只暴露 `ModelRequest` / `ModelSelection` / `ModelHandle` 与稳定的错误码；AgentLine 侧不应再保留任何模型逻辑。AgentLine 侧代码改动不属于本仓库范围，但 CLIWorker 必须提供它依赖的契约与错误语义。\\n\\n## E. CLIWorker 成熟度清单（验收口径）\\n\\n一个“成熟可信”的 CLIWorker 至少要具备下面这些，缺哪项就要在任务图里单列一个任务：\\n\\n1. **稳定契约**：ModelRequest v1、ModelSelection v1、ModelHandle v1；明确错误码、超时、部分失败、无候选、数量不足。\\n2. **Provider 层**：CLI 发现、版本、认证；模型列表；真实 probe；可用性状态 `callable / blocked / unavailable / deprecated`；只读能力；identity 证据来源；超时/重试/降级。\\n3. **模型目录**：Top / High / Middle / Quick 四档；弃用与别名；白名单；价格；能力（上下文、只读）。\\n4. **用量与预测**：任务前后 token/usage；按模型/渠道的 burn rate；剩余额度、预计耗尽时间、可跑任务数；Heavy / Normal / Light；重要任务储备；`unknown` 状态不伪造。\\n5. **插件形态**：DSH host 路由；安装/升级/回滚；配置与密钥隔离；健康检查；审计日志；不向 AgentLine 泄漏 provider 细节。\\n6. **可靠性**：并发选择/申请；数量不足时返回 `truncated`；重试不重复扣减；失败不返回假 handle；服务重启后状态可恢复。\\n7. **测试**：契约测试；provider fixture；用量/预测确定性测试；插件安装 e2e；发布前真实 skill 冒烟。\\n\\n## F. 输出格式硬约束（直接影响自动校验，必须遵守）\\n\\n- 最后只输出一个 JSON 对象，不要加代码块标记，JSON 必须是整段输出的结尾。\\n- **正文里禁止出现 ASCII 双引号字符（U+0022）**：引用字段名用反引号，示例值用单引号或中文引号「」；所有 JSON 接口示例都放进最后那个 JSON 对象的 `interfaces` 字段里。\\n- 原因：自动校验用花括号扫描定位最后的 JSON，正文里的双引号会被当成字符串边界，导致整段输出被判为无 JSON。\\n- `task_graph` 的每个任务都必须齐备 `id / title / inputs / outputs / write_scope / depends_on / acceptance / acceptance_direction / test_levels`，且 `depends_on` 只能引用真实存在的任务 ID。\",\n  \"from\": null,\n  \"status\": \"running\",\n  \"phase\": \"design\",\n  \"round\": {\n    \"current\": 1,\n    \"max\": 3\n  },\n  \"roles\": {\n    \"designer\": {\n      \"model\": \"claude-opus-5-5\",\n      \"id\": \"claude-opus-5-5\",\n      \"tier\": \"top\",\n      \"provider\": \"claude\",\n      \"vendor\": \"anthropic\",\n      \"identity_group\": \"anthropic-opus-5-5\",\n      \"identity\": \"verified\"\n    },\n    \"reviewer\": {\n      \"model\": \"hy4std\",\n      \"id\": \"hy4std\",\n      \"tier\": \"top\",\n      \"provider\": \"codebuddy\",\n      \"vendor\": \"tencent\",\n      \"identity_group\": \"hy4-std\",\n      \"identity\": \"verified\"\n    },\n    \"test_architect\": {\n      \"model\": \"hy4free\",\n      \"id\": \"hy4free\",\n      \"tier\": \"top\",\n      \"provider\": \"codebuddy\",\n      \"vendor\": \"tencent\",\n      \"identity_group\": \"hy4-free\",\n      \"identity\": \"verified\"\n    }\n  },\n  \"awaiting\": null,\n  \"last_error\": null,\n  \"calls\": [],\n  \"created_at\": \"2026-11-07T10:42:17.590Z\",\n  \"updated_at\": \"2026-11-07T10:42:17.591Z\",\n  \"revision\": 1\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01W1pnkeQPfYQ5Y7FvB4oQU7","permission_decision":{"decision":"accept","source":"config","reason_type":"classifier"}}]}
