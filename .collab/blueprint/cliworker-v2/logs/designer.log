0\t    18\t  const rows = records.filter((r) => !model || r.model === model)\n241\t    19\t  const samples = rows.map((r) => ({\n242\t    20\t    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n243\t    21\t    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n244\t    22\t  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n245\t    23\t  if (!samples.length) {\n246\t    24\t    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n247\t    25\t  }\n248\t    26\t  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n249\t    27\t  const use = recent.length ? recent : samples.slice(-10)\n250\t    28\t  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n251\t    29\t  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n252\t    30\t  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n253\t    31\t  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n254\t    32\t  let tasksLeft = null\n255\t    33\t  let etaHours = null\n256\t    34\t  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n257\t    35\t    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n258\t    36\t    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n259\t    37\t  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n260\t    38\t    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n261\t    39\t  }\n262\t    40\t  const confidence = use.length >= 5 ? 'medium' : 'low'\n263\t    41\t  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n264\t    42\t  return {\n265\t    43\t    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n266\t    44\t    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n267\t    45\t    confidence, risk,\n268\t    46\t  }\n269\t    47\t}\n270\t    48\t\n271\t    49\tfunction round(n) { return Math.round(n * 1e6) / 1e6 }\n272\t=== lib/select.mjs\n273\t     1\timport { normalizePrices, forecast } from './forecast.mjs'\n274\t     2\t\n275\t     3\texport const SCHEMA = 'cliworker.selection/v1'\n276\t     4\texport const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n277\t     5\texport const USAGES = ['Heavy', 'Normal', 'Light']\n278\t     6\t\n279\t     7\tfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n280\t     8\tfunction normLevel(v) {\n281\t     9\t  const s = String(v || '').trim().toLowerCase()\n282\t    10\t  return LEVELS.find((x) => x.toLowerCase() === s) || null\n283\t    11\t}\n284\t    12\tfunction normUsage(v) {\n285\t    13\t  const s = String(v || '').trim().toLowerCase()\n286\t    14\t  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n287\t    15\t}\n288\t    16\t\n289\t    17\tfunction vendorOf(provider) {\n290\t    18\t  const p = String(provider || '').toLowerCase()\n291\t    19\t  if (p.includes('claude')) return 'anthropic'\n292\t    20\t  if (p.includes('codex') || p.includes('openai')) return 'openai'\n293\t    21\t  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n294\t    22\t  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n295\t    23\t  if (p.includes('gemini') || p.includes('google')) return 'google'\n296\t    24\t  return p\n297\t    25\t}\n298\t    26\t\n299\t    27\tfunction levelOf(m) {\n300\t    28\t  if (m.level && LEVELS.includes(m.level)) return m.level\n301\t    29\t  if (m.tier === 'top') return 'Top'\n302\t    30\t  if (m.tier === 'advanced') return 'High'\n303\t    31\t  if (m.tier === 'standard') return 'Middle'\n304\t    32\t  return 'Quick'\n305\t    33\t}\n306\t    34\t\n307\t    35\tfunction cliCall(config, model, request) {\n308\t    36\t  const p = config.providers?.[model.provider] || {}\n309\t    37\t  const id = model.id\n310\t    38\t  const cwd = request.cwd || '<workspace>'\n311\t    39\t  if (model.provider === 'claude') {\n312\t    40\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n313\t    41\t  }\n314\t    42\t  if (model.provider === 'codex') {\n315\t    43\t    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n316\t    44\t  }\n317\t    45\t  if (model.provider === 'codebuddy') {\n318\t    46\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n319\t    47\t  }\n320\t    48\t  if (model.provider === 'cursor-wsl') {\n321\t    49\t    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n322\t    50\t  }\n323\t    51\t  if (model.provider === 'gemini') {\n324\t    52\t    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n325\t    53\t  }\n326\t    54\t  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n327\t    55\t}\n328\t    56\t\n329\t    57\texport function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n330\t    58\t  return Object.entries(config.models).map(([key, m]) => {\n331\t    59\t    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n332\t    60\t    const callable = st.state === 'callable' && !m.deprecated\n333\t    61\t    return {\n334\t    62\t      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n335\t    63\t      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n336\t    64\t      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n337\t    65\t      identity_group: m.identity_group || null,\n338\t    66\t      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n339\t    67\t      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n340\t    68\t      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n341\t    69\t      prices: normalizePrices(m), source: 'config',\n342\t    70\t      provider_detail: st.detail || null,\n343\t    71\t    }\n344\t    72\t  }).filter((m) => includeDeprecated || !m.deprecated)\n345\t    73\t}\n346\t    74\t\n347\t    75\texport function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n348\t    76\t  const level = normLevel(request.level || request.tier)\n349\t    77\t  const usageKind = normUsage(request.usage)\n350\t    78\t  const models = listModels(config, { status, includeDeprecated: true })\n351\t    79\t  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n352\t    80\t  const requireVerified = request.require_verified !== false\n353\t    81\t  const requireReadonly = request.require_readonly === true\n354\t    82\t  const exclude = new Set(request.exclude || [])\n355\t    83\t  const allowed = request.candidates ? new Set(request.candidates) : null\n356\t    84\t  const rejected = []\n357\t    85\t  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n358\t    86\t\n359\t    87\t  const candidates = models.filter((m) => {\n360\t    88\t    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n361\t    89\t    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n362\t    90\t    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n363\t    91\t    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n364\t    92\t    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n365\t    93\t    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n366\t    94\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n367\t    95\t    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n368\t    96\t      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n369\t    97\t    }\n370\t    98\t    return true\n371\t    99\t  })\n372\t   100\t\n373\t   101\t  const rank = (m) => {\n374\t   102\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n375\t   103\t    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n376\t   104\t    const unknown = f.risk === 'unknown' ? 1 : 0\n377\t   105\t    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n378\t   106\t    if (usageKind === 'Light') return [price, unknown, m.key]\n379\t   107\t    return [unknown, price, m.key]\n380\t   108\t  }\n381\t   109\t  candidates.sort((a, b) => {\n382\t   110\t    const ra = rank(a), rb = rank(b)\n383\t   111\t    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n384\t   112\t    return 0\n385\t   113\t  })\n386\t   114\t\n387\t   115\t  const picked = candidates.slice(0, count).map((m) => {\n388\t   116\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n389\t   117\t    const call = cliCall(config, m, request)\n390\t   118\t    return {\n391\t   119\t      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n392\t   120\t      adapter: config.providers[m.provider]?.adapter || null,\n393\t   121\t      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n394\t   122\t      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n395\t   123\t      forecast: f, cli: call, call,\n396\t   124\t    }\n397\t   125\t  })\n398\t   126\t  return {\n399\t   127\t    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n400\t   128\t    models: picked, calls: picked.map((x) => x.call), rejected,\n401\t   129\t    reason: picked.length ? null : 'no_eligible_model',\n402\t   130\t    truncated: picked.length < count,\n403\t   131\t  }\n404\t   132\t}\n405\t=== config/cliworker.example.json\n406\t     1\t{\n407\t     2\t  \"providers\": {\n408\t     3\t    \"claude\": {\n409\t     4\t      \"cli\": \"claude\",\n410\t     5\t      \"adapter\": \"claude\",\n411\t     6\t      \"version_args\": [\n412\t     7\t        \"--version\"\n413\t     8\t      ],\n414\t     9\t      \"auth_args\": [\n415\t    10\t        \"auth\",\n416\t    11\t        \"status\"\n417\t    12\t      ],\n418\t    13\t      \"auth_ok\": \"logged in\",\n419\t    14\t      \"readonly\": true\n420\t    15\t    },\n421\t    16\t    \"codex\": {\n422\t    17\t      \"cli\": \"codex\",\n423\t    18\t      \"adapter\": \"codex\",\n424\t    19\t      \"version_args\": [\n425\t    20\t        \"--version\"\n426\t    21\t      ],\n427\t    22\t      \"auth_args\": [\n428\t    23\t        \"login\",\n429\t    24\t        \"status\"\n430\t    25\t      ],\n431\t    26\t      \"auth_ok\": \"logged in\",\n432\t    27\t      \"readonly\": true\n433\t    28\t    },\n434\t    29\t    \"codebuddy\": {\n435\t    30\t      \"cli\": \"codebuddy\",\n436\t    31\t      \"adapter\": \"codebuddy\",\n437\t    32\t      \"version_args\": [\n438\t    33\t        \"--version\"\n439\t    34\t      ],\n440\t    35\t      \"auth_args\": [],\n441\t    36\t      \"readonly\": true\n442\t    37\t    },\n443\t    38\t    \"cursor-wsl\": {\n444\t    39\t      \"cli\": \"wsl.exe\",\n445\t    40\t      \"args_prefix\": [\n446\t    41\t        \"-e\",\n447\t    42\t        \"bash\",\n448\t    43\t        \"-lc\",\n449\t    44\t        \"agent\"\n450\t    45\t      ],\n451\t    46\t      \"adapter\": \"cursor-wsl\",\n452\t    47\t      \"readonly\": false\n453\t    48\t    },\n454\t    49\t    \"gemini\": {\n455\t    50\t      \"cli\": \"gemini\",\n456\t    51\t      \"adapter\": \"gemini\",\n457\t    52\t      \"readonly\": true\n458\t    53\t    }\n459\t    54\t  },\n460\t    55\t  \"models\": {\n461\t    56\t    \"claude-opus-5-5\": {\n462\t    57\t      \"provider\": \"claude\",\n463\t    58\t      \"id\": \"claude-opus-5-5\",\n464\t    59\t      \"tier\": \"top\",\n465\t    60\t      \"identity\": \"verified\",\n466\t    61\t      \"identity_group\": \"anthropic-opus-5-5\",\n467\t    62\t      \"vendor\": \"anthropic\",\n468\t    63\t      \"deprecated\": false,\n469\t    64\t      \"prices\": {\n470\t    65\t        \"input_per_mtok\": 15,\n471\t    66\t        \"output_per_mtok\": 75\n472\t    67\t      },\n473\t    68\t      \"limits\": {\n474\t    69\t        \"context_tokens\": 200000\n475\t    70\t      },\n476\t    71\t      \"level\": \"Top\"\n477\t    72\t    },\n478\t    73\t    \"gpt-6-astra\": {\n479\t    74\t      \"provider\": \"codex\",\n480\t    75\t      \"id\": \"gpt-6-astra\",\n481\t    76\t      \"tier\": \"top\",\n482\t    77\t      \"identity\": \"unverified\",\n483\t    78\t      \"identity_group\": \"openai-astra\",\n484\t    79\t      \"vendor\": \"openai\",\n485\t    80\t      \"deprecated\": false,\n486\t    81\t      \"prices\": {\n487\t    82\t        \"input_per_mtok\": 2,\n488\