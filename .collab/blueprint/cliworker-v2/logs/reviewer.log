lease','l_7d1e','--state-dir','<abs state_dir>','--config','<abs config>'], cwd:'C:/work/repo', input:'stdin', output:'cliworker.event/v1', timeout_ms:1800000}}。calls[i] 与 models[i].call 深相等；expires_at_i = selected_at + lease_ttl_s + i * timeo... [truncated]\n   2→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b5cacde6715c92361da7d1b89a28","_messageId":"01a1b5cbf43a78cab3b5612456e7b3d5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b5cacde6715c92361da7d1b89a28","codebuddy.ai/modelRequestId":"01a1b5cbf43a78cab3b5612456e7b3d5","codebuddy.ai/llmMessageId":"01a1b5cbf43a78cab3b5612456e7b3d5","traceparent":"00-6f8cf613b00173bba4efd2f6486c24b9-6439b0180255bad9-01","baggage":"codebuddy.session_id=01a1b5ca-cb08-780f-9329-83341daeb0e2,codebuddy.conversation_request_id=01a1b5cacde6715c92361da7d1b89a28"},"__timestamp":"2026-11-07T11:36:51.491Z"}
{"type":"user","uuid":"01a1b5cc-0e26-7ade-9cd8-2eea43ac9906","session_id":"01a1b5ca-cb08-780f-9329-83341daeb0e2","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-aec0ab2091fd5764","content":[{"type":"text","text":"   1→=== PROMPT ===\n   2→你是 Blueprint 的设计师（designer）。这是只读讨论：不要修改、创建或删除任何文件，也不要运行会改变工作区的命令。\n   3→\n   4→用户输入：\n   5→# CLIWorker v2 需求书（Blueprint 输入）\n   6→\n   7→目标仓库：C:\\git\\dsh-CLIWorker（DSH 插件 `dsh-cliworker`，Node 20+，ESM，零第三方依赖，现有 16 个文件、3 次提交在 main）。\n   8→\n   9→## A. 现状与已确认的缺陷\n  10→\n  11→现有结构：`bin/cliworker.mjs`（外壳）、`lib/index.js`（DSH 宿主插件，注册 /cliworker/providers、/models、/select、/forecast）、`lib/cli.mjs`（CLI 实现）、`lib/select.mjs`（选模）、`lib/forecast.mjs`（成本/余量预测）、`lib/availability.mjs`（provider 探测）、`lib/config.mjs`（配置与 usage.jsonl）、`config/cliworker.example.json`、`test/select.test.mjs`（6 个用例）。\n  12→\n  13→已复现的问题（必须在本次改动中修掉）：\n  14→\n  15→1. 配额形状与预测器不匹配：配置用 `remaining_pct`（claude 5h、codex 7d）和 `remaining + unit:\"credits\"`（codebuddy），但 `forecast()` 只认 `remaining_usd` 或 `unit===\"tokens\"`。实测 `{remaining_pct:5}` 与 `{remaining:1,unit:\"credits\"}` 的 risk 恒为 `unknown`，导致 `usage:\"Heavy\"` 的耗尽拒选永不触发、按剩余任务排序永不生效。\n  16→2. 打包漏文件：`package.json` 无 `bin` 字段，`files` 不含 `bin/` 与 `config/`，而 README 与 AgentLine 集成都指向 `bin/cliworker.mjs`、`config/cliworker.local.json`。\n  17→3. 无 `scripts`，`node --test test` 在 Node 22 报 MODULE_NOT_FOUND（目录参数被当模块解析）；测试只覆盖 select/forecast，cli/index/availability/config 无用例。\n  18→4. usage 落盘位置固定在 `~/.cliworker/usage.jsonl`，与 `--config` 无关；`.gitignore` 忽略的却是仓库根 `usage.jsonl`，规则永不命中。`config/cliworker.local.json` 与 example 逐字节相同（占位数据）。\n  19→5. 小问题：句柄同时输出完全相同的 `cli` 与 `call`（响应体翻倍）；`fs`/`SELECT_SCHEMA`/`isObject` 未使用；`config.mjs` 在配置为 null 时抛 TypeError 而非可读错误；`availability.mjs` 在 win32 用 `shell:true` 拼参数且有被 shell 改写的风险、每次选模同步探测全部 provider 无缓存（实测 3.4s）；`select.mjs` 每个模型重复算 3 次 forecast；README 请求示例里的 `role`/`importance` 被静默忽略。\n  20→\n  21→## B. 本次要交付的能力\n  22→\n  23→### 1. 修复上述缺陷\n  24→所有第 A 节列出的缺陷都要修掉，并且每条修复都要能被一条可执行命令验证。\n  25→\n  26→### 2. 插件扫描本地硬盘，发现已安装的 CLI 工具\n  27→- 支持 Linux、macOS、Windows、WSL 四个平台；WSL 需要能跨发行版枚举。\n  28→- 已知要覆盖的 CLI 至少包括：codex、claudecode（claude）、deepseek harness（dsh）、cursor、codebuddy、antigravity、trae、zcode、qoder、kimi、opencode；未知 CLI 也要能按规则被发现并标记为未识别。\n  29→- 扫描不得把用户机上的凭据读出来或写进日志；**CLI 的登录 token 由用户提供**（用户输入/配置项），程序只使用、不落盘明文、不回显。\n  30→- 发现结果要落盘成可复查的清单（路径、版本、平台、探测证据），并能增量刷新。\n  31→\n  32→### 3. 获取每个 CLI 支持的 model 列表\n  33→- 每个 CLI 有自己的模型枚举方式（子命令、`--help` 文本、本地缓存文件、API）；要按 CLI 分别实现，失败要能回退到“用户手工补录”，不允许写死模型表。\n  34→- 结果要归一：模型 id、所属 CLI、厂商、能力标记、来源与获取时间。\n  35→\n  36→### 4. 模型管理（白名单 + 等级 + 可用性 + 用量）\n  37→- **4.1 白名单**：用户显式选择；不在白名单的模型一律不参与选模、不出现在候选中，也不被探测/计费。\n  38→- **4.2 等级**：模型分四档（Top / High / Middle / Quick），等级来源要可追溯（配置、CLI 声明或实测）。\n  39→- **4.3 可用性**：用小 token 的真实调用验证，而不是只看“已安装”；要区分 unverified / callable / blocked / deprecated，并记录验证时间与证据。\n  40→- **4.4 用量评估**：既要读取各 CLI 的计划用量/余额，也要随用户使用估算“还能用多少 token”（单位 Mtoken）。示例：claudecode 5 小时窗口下，opus5.5 可用 2M token、sonnet5.5 可用 10M token；已用 50% 时 sonnet5.5 降到 5M。要能知道额度刷新时间（窗口起点/重置时刻）。\n  41→- **4.5 选模策略**：用户请求 model 时，按可用量给出模型；在保证任务能完成的前提下尽量用足时间窗口限额；充值/付费额度放在兜底位置（先用计划内额度，快见底才用充值额度），并保留拒选原因。\n  42→\n  43→### 5. 模型管理界面与实时数据\n  44→- 设计模型管理界面（白名单、等级、可用性、余量、刷新时间、最近一次实测证据）。\n  45→- 实时数据怎么来、怎么刷新、失败怎么显示，都要写清楚；页面不要假装有数据——缺样本就显示 unknown。\n  46→\n  47→### 6. 返回 CLI 调用方式\n  48→- 用户请求 CLI 时返回可直接执行的调用方式，并且带上选定的 model；不同平台/CLI 的形态差异（命令、参数、只读模式、cwd、stdin）要覆盖。\n  49→\n  50→## C. 约束\n  51→\n  52→- 保持零第三方运行时依赖（Node 20+ 内置模块）；插件与 CLI 两种入口都要能用。\n  53→- 沿用现有契约：`cliworker.selection/v1`、`cliworker.model/v1`、`cliworker.handle/v1`、`cliworker.forecast/v1`；如需升级 schema，必须写清兼容与迁移。\n  54→- 密钥/令牌不进仓库、不进日志、不进 JSON 输出。\n  55→- 每个任务都要有可执行的验收命令，不写“看起来正确”。\n  56→\n  57→## D. 边界（用户已拍板，硬约束）\n  58→\n  59→AgentLine 不再拥有：provider/CLI 管理、模型目录、模型身份、价格、额度、消耗速度、预测、排序/降级。\n  60→\n  61→AgentLine 只负责：\n  62→- 指定 level / count / usage；\n  63→- 接收 `calls[]`；\n  64→- 按顺序调用；\n  65→- 数量不够时再申请；\n  66→- 记录流程状态。\n  67→\n  68→这个边界必须体现在契约上：CLIWorker 要对 AgentLine 隐藏 provider 细节，只暴露 `ModelRequest` / `ModelSelection` / `ModelHandle` 与稳定的错误码；AgentLine 侧不应再保留任何模型逻辑。AgentLine 侧代码改动不属于本仓库范围，但 CLIWorker 必须提供它依赖的契约与错误语义。\n  69→\n  70→## E. CLIWorker 成熟度清单（验收口径）\n  71→\n  72→一个“成熟可信”的 CLIWorker 至少要具备下面这些，缺哪项就要在任务图里单列一个任务：\n  73→\n  74→1. **稳定契约**：ModelRequest v1、ModelSelection v1、ModelHandle v1；明确错误码、超时、部分失败、无候选、数量不足。\n  75→2. **Provider 层**：CLI 发现、版本、认证；模型列表；真实 probe；可用性状态 `callable / blocked / unavailable / deprecated`；只读能力；identity 证据来源；超时/重试/降级。\n  76→3. **模型目录**：Top / High / Middle / Quick 四档；弃用与别名；白名单；价格；能力（上下文、只读）。\n  77→4. **用量与预测**：任务前后 token/usage；按模型/渠道的 burn rate；剩余额度、预计耗尽时间、可跑任务数；Heavy / Normal / Light；重要任务储备；`unknown` 状态不伪造。\n  78→5. **插件形态**：DSH host 路由；安装/升级/回滚；配置与密钥隔离；健康检查；审计日志；不向 AgentLine 泄漏 provider 细节。\n  79→6. **可靠性**：并发选择/申请；数量不足时返回 `truncated`；重试不重复扣减；失败不返回假 handle；服务重启后状态可恢复。\n  80→7. **测试**：契约测试；provider fixture；用量/预测确定性测试；插件安装 e2e；发布前真实 skill 冒烟。\n  81→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b5cacde6715c92361da7d1b89a28","_messageId":"01a1b5cbf43a78cab3b5612456e7b3d5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b5cacde6715c92361da7d1b89a28","codebuddy.ai/modelRequestId":"01a1b5cbf43a78cab3b5612456e7b3d5","codebuddy.ai/llmMessageId":"01a1b5cbf43a78cab3b5612456e7b3d5","traceparent":"00-6f8cf613b00173bba4efd2f6486c24b9-6439b0180255bad9-01","baggage":"codebuddy.session_id=01a1b5ca-cb08-780f-9329-83341daeb0e2,codebuddy.conversation_request_id=01a1b5cacde6715c92361da7d1b89a28"},"__timestamp":"2026-11-07T11:36:51.494Z"}
