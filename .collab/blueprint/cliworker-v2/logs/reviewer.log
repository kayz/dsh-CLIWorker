{"type":"user","uuid":"01a1b5cb-d8ab-7664-af8d-c1803ec8a0e7","session_id":"01a1b5ca-cb08-780f-9329-83341daeb0e2","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-be0a354b01d6a4e3","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import os from 'node:os'\n   3→import path from 'node:path'\n   4→\n   5→export const SCHEMA = 'cliworker.config/v1'\n   6→\n   7→export function defaultHome() {\n   8→  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   9→}\n  10→\n  11→export function loadConfig({ file } = {}) {\n  12→  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome() }\n  23→}\n  24→\n  25→export function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file) {\n  28→  try {\n  29→    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row) {\n  34→  ensureDir(path.dirname(file))\n  35→  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b5cacde6715c92361da7d1b89a28","_messageId":"01a1b5cbcd557819a33e9cf6c7d8b942","_meta":{"codebud