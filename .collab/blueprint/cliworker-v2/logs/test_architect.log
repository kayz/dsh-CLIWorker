0.79,\"overageStatus\":\"rejected\",\"overageDisabledReason\":\"org_level_disabled\",\"isUsingOverage\":false,\"surpassedThreshold\":0.75,\"unifiedWindows\":{\"five_hour\":{\"utilization\":0.19,\"resetsAt\":1794064800,\"status\":\"allowed\"},\"seven_day\":{\"utilization\":0.79,\"resetsAt\":1794070800,\"status\":\"allowed_warning\",\"surpassedThreshold\":0.75}},\"overageEnabled\":false},\"uuid\":\"85875da0-c39d-46db-afb8-10329c2f32ae\",\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\"}\n 106→{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018bu5cUJpThB4tLyYX1E1KL\",\"type\":\"tool_result\",\"content\":\"=== lib/index.js\\n     1\\t/**\\n     2\\t * dsh-cliworker — DSH host plugin.\\n     3\\t *\\n     4\\t * AgentLine and other clients only need the model source pointer:\\n     5\\t *   modelSource = { kind: \\\"cliworker\\\", command: \\\"node\\\",\\n     6\\t *                   args: [\\\".../dsh-CLIWorker/bin/cliworker.mjs\\\", \\\"--config\\\", \\\"...\\\"] }\\n     7\\t *\\n     8\\t * The plugin exposes the same selection contract over DSH routes for UI use.\\n     9\\t */\\n    10\\timport path from 'node:path'\\n    11\\timport os from 'node:os'\\n    12\\timport { fileURLToPath } from 'node:url'\\n    13\\timport { loadConfig } from '../lib/config.mjs'\\n    14\\timport { providerStatus } from '../lib/availability.mjs'\\n    15\\timport { listModels, selectModels } from '../lib/select.mjs'\\n    16\\timport { forecast } from '../lib/forecast.mjs'\\n    17\\t\\n    18\\tconst __dirname = path.dirname(fileURLToPath(import.meta.url))\\n    19\\tconst DEFAULTS = {\\n    20\\t  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\\n    21\\t  readonly: false,\\n    22\\t}\\n    23\\t\\n    24\\tfunction send(res, body, code = 200) {\\n    25\\t  res.statusCode = code\\n    26\\t  res.setHeader('content-type', 'application/json; charset=utf-8')\\n    27\\t  res.setHeader('cache-control', 'no-store')\\n    28\\t  res.end(JSON.stringify(body))\\n    29\\t}\\n    30\\t\\n    31\\tfunction readBody(req) {\\n    32\\t  return new Promise((resolve, reject) => {\\n    33\\t    let raw = ''\\n    34\\t    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\\n    35\\t    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\\n    36\\t    req.on('error', reject)\\n    37\\t  })\\n    38\\t}\\n    39\\t\\n    40\\texport const name = 'cliworker'\\n    41\\t\\n    42\\texport function... [truncated]\n 107→{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01W1pnkeQPfYQ5Y7FvB4oQU7\",\"type\":\"tool_result\",\"content\":\"=== lib/availability.mjs\\n     1\\timport { spawnSync } from 'node:child_process'\\n     2\\t\\n     3\\tfunction run(command, args, timeout = 20_000) {\\n     4\\t  try {\\n     5\\t    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\\n     6\\t    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\\n     7\\t  } catch (e) {\\n     8\\t    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\\n     9\\t  }\\n    10\\t}\\n    11\\t\\n    12\\texport function checkProvider(provider, { probe = true } = {}) {\\n    13\\t  const cli = provider.cli\\n    14\\t  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\\n    15\\t  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\\n    16\\t  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\\n    17\\t  const v = run(cli, versionArgs)\\n    18\\t  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\\n    19\\t  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\\n    20\\t  const version = (v.stdout.match(/\\\\d+\\\\.\\\\d+\\\\.\\\\d+(?:[-+][\\\\w.]+)?/) || [''])[0] || null\\n    21\\t  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\\n    22\\t  const auth = run(cli, [...prefix, ...provider.auth_args])\\n    23\\t  const text = (auth.stdout + '\\\\n' + auth.stderr).toLowerCase()\\n    24\\t  const ok = auth.ok && (\\n    25\\t    !provider.auth_ok ||\\n    26\\t    text.includes(String(provider.auth_ok).toLowerCase()) ||\\n    27\\t    /\\\"loggedin\\\"\\\\s*:\\\\s*true/.test(text) ||\\n    28\\t    /\\\\blogged in\\\\b/.test(text)\\n    29\\t  )\\... [truncated]\n 108→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"5ba2b4ac-69f7-41ca-9db1-635e5e079db2\"}\n 109→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":150,\"estimated_tokens_delta\":100,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"38d4e6f8-3710-4dc4-80d1-dbf5fba2c275\"}\n 110→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":250,\"estimated_tokens_delta\":100,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"a7bf8e58-78d8-4596-bfaf-8c8c65c5dff1\"}\n 111→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":400,\"estimated_tokens_delta\":150,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"a1c95c9c-910b-4c13-ad9d-fd2595610d03\"}\n 112→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":500,\"estimated_tokens_delta\":100,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"b4ad5840-f111-4c14-9a46-3f73bb98f1a8\"}\n 113→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":600,\"estimated_tokens_delta\":100,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"e6d04a6f-ba34-4ee4-8dfb-1aab2642d0f4\"}\n 114→{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":700,\"estimated_tokens_delta\":100,\"session_id\":\"fb48192a-fb8b-4a3d-b8f0-8bb0b4cd0c4f\",\"uuid\":\"efc38a65-3007-46fa-ba04-2631493a958c\"}\n 115→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-abe45278a4067d6a","_requestId":"d60943bc739a41c58711266701bd9b8b","_messageId":"01a1b5c5a6d478da9494e9b9a38da295","_meta":{"codebuddy.ai/conversationRequestId":"d60943bc739a41c58711266701bd9b8b","codebuddy.ai/modelRequestId":"01a1b5c5a6d478da9494e9b9a38da295","codebuddy.ai/llmMessageId":"01a1b5c5a6d478da9494e9b9a38da295"},"__timestamp":"2026-11-07T11:30:45.597Z"}
