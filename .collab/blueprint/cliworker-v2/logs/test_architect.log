y\": \"unverified\",\n 183→      \"identity_group\": \"google-gemini-4-argon\",\n 184→      \"vendor\": \"google\",\n 185→      \"deprecated\": false,\n 186→      \"prices\": {\n 187→        \"input_per_mtok\": 1.25,\n 188→        \"output_per_mtok\": 10\n 189→      },\n 190→      \"level\": \"High\"\n 191→    },\n 192→    \"hy3\": {\n 193→      \"provider\": \"codebuddy\",\n 194→      \"id\": \"hy3\",\n 195→      \"tier\": \"advanced\",\n 196→      \"level\": \"Middle\",\n 197→      \"identity\": \"verified\",\n 198→      \"identity_group\": \"hy3\",\n 199→      \"vendor\": \"tencent\",\n 200→      \"deprecated\": false,\n 201→      \"prices\": {\n 202→        \"input_per_mtok\": 0.2,\n 203→        \"output_per_mtok\": 0.8\n 204→      }\n 205→    },\n 206→    \"hy3x\": {\n 207→      \"provider\": \"codebuddy\",\n 208→      \"id\": \"hy3-x\",\n 209→      \"tier\": \"advanced\",\n 210→      \"level\": \"Middle\",\n 211→      \"identity\": \"verified\",\n 212→      \"identity_group\": \"hy3-x\",\n 213→      \"vendor\": \"tencent\",\n 214→      \"deprecated\": false,\n 215→      \"prices\": {\n 216→        \"input_per_mtok\": 0.3,\n 217→        \"output_per_mtok\": 1\n 218→      }\n 219→    },\n 220→    \"gemini-3.7-flash-high\": {\n 221→      \"provider\": \"gemini\",\n 222→      \"id\": \"gemini-3.7-flash-high\",\n 223→      \"tier\": \"standard\",\n 224→      \"level\": \"Quick\",\n 225→      \"identity\": \"unverified\",\n 226→      \"identity_group\": \"google-gemini-3.7-flash\",\n 227→      \"vendor\": \"google\",\n 228→      \"deprecated\": false,\n 229→      \"prices\": {\n 230→        \"input_per_mtok\": 0.3,\n 231→        \"output_per_mtok\": 1.2\n 232→      }\n 233→    },\n 234→    \"claude-haiku-5-5\": {\n 235→      \"provider\": \"claude\",\n 236→      \"id\": \"claude-haiku-5-5\",\n 237→      \"tier\": \"standard\",\n 238→      \"level\": \"Quick\",\n 239→      \"identity\": \"unverified\",\n 240→      \"identity_group\": \"anthropic-haiku-5-5\",\n 241→      \"vendor\": \"anthropic\",\n 242→      \"deprecated\": false,\n 243→      \"prices\": {\n 244→        \"input_per_mtok\": 0.8,\n 245→        \"output_per_mtok\": 4\n 246→      }\n 247→    }\n 248→  },\n 249→  \"quotas\": {\n 250→    \"claude\": {\n 251→      \"window\": \"5h\",\n 252→      \"remaining_pct\": 100,\n 253→      \"reset_at\": null\n 254→    },\n 255→    \"codex\": {\n 256→      \"window\": \"7d\",\n 257→      \"remaining_pct\": 100,\n 258→      \"reset_at\": null\n 259→    },\n 260→    \"codebuddy\": {\n 261→      \"window\": \"credits\",\n 262→      \"remaining\": 1000,\n 263→      \"unit\": \"credits\"\n 264→    }\n 265→  }\n 266→}\n 267→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8be95c3139080423","_requestId":"8f47e50de44b4d20abf86a2f89384f73","_messageId":"01a1b5c21aed7424bebd7a38485c3762","_meta":{"codebuddy.ai/conversationRequestId":"8f47e50de44b4d20abf86a2f89384f73","codebuddy.ai/modelRequestId":"01a1b5c21aed7424bebd7a38485c3762","codebuddy.ai/llmMessageId":"01a1b5c21aed7424bebd7a38485c3762"},"__timestamp":"2026-11-07T11:26:23.858Z"}
{"type":"user","uuid":"01a1b5c2-7a78-7fb8-ba5d-97de689ed7eb","session_id":"01a1b5bf-5519-7a7b-8d8d-80d1042af7bf","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-9b1661f4ad012289","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import os from 'node:os'\n   3→import path from 'node:path'\n   4→\n   5→export const SCHEMA = 'cliworker.config/v1'\n   6→\n   7→export function defaultHome() {\n   8→  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   9→}\n  10→\n  11→export function loadConfig({ file } = {}) {\n  12→  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome() }\n  23→}\n  24→\n  25→export function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file) {\n  28→  try {\n  29→    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row) {\n  34→  ensureDir(path.dirname(file))\n  35→  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8be95c3139080423","_requestId":"8f47e50de44b4d20abf86a2f89384f73","_messageId":"01a1b5c21aed7424bebd7a38485c3762","_meta":{"codebuddy.ai/conversationRequestId":"8f47e50de44b4d20abf86a2f89384f73","codebuddy.ai/modelRequestId":"01a1b5c21aed7424bebd7a38485c3762","codebuddy.ai/llmMessageId":"01a1b5c21aed7424bebd7a38485c3762"},"__timestamp":"2026-11-07T11:26:23.865Z"}
{"type":"user","uuid":"01a1b5c2-7a7d-7e7d-bc25-4ab9afb6a69f","session_id":"01a1b5bf-5519-7a7b-8d8d-80d1042af7bf","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-aef6539ce720f456","content":[{"type":"text","text":"   1→import { normalizePrices, forecast } from './forecast.mjs'\n   2→\n   3→export const SCHEMA = 'cliworker.selection/v1'\n   4→export const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n   5→export const USAGES = ['Heavy', 'Normal', 'Light']\n   6→\n   7→function isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n   8→function normLevel(v) {\n   9→  const s = String(v || '').trim().toLowerCase()\n  10→  return LEVELS.find((x) => x.toLowerCase() === s) || null\n  11→}\n  12→function normUsage(v) {\n  13→  const s = String(v || '').trim().toLowerCase()\n  14→  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n  15→}\n  16→\n  17→function vendorOf(provider) {\n  18→  const p = String(provider || '').toLowerCase()\n  19→  if (p.includes('claude')) return 'anthropic'\n  20→  if (p.includes('codex') || p.includes('openai')) return 'openai'\n  21→  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n  22→  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n  23→  if (p.includes('gemini') || p.includes('google')) return 'google'\n  24→  return p\n  25→}\n  26→\n  27→function levelOf(m) {\n  28→  if (m.level && LEVELS.includes(m.level)) return m.level\n  29→  if (m.tier === 'top') return 'Top'\n  30→  if (m.tier === 'advanced') return 'High'\n  31→  if (m.tier === 'standard') return 'Middle'\n  32→  return 'Quick'\n  33→}\n  34→\n  35→function cliCall(config, model, request) {\n  36→  const p = config.providers?.[model.provider] || {}\n  37→  const id = model.id\n  38→  const cwd = request.cwd || '<workspace>'\n  39→  if (model.provider === 'claude') {\n  40→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  41→  }\n  42→  if (model.provider === 'codex') {\n  43→    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n  44→  }\n  45→  if (model.provider === 'codebuddy') {\n  46→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  47→  }\n  48→  if (model.provider === 'cursor-wsl') {\n  49→    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n  50→  }\n  51→  if (model.provider === 'gemini') {\n  52→    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n  53→  }\n  54→  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n  55→}\n  56→\n  57→export function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n  58→  return Object.entries(config.models).map(([key, m]) => {\n  59→    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n  60→    const callable = st.state === 'callable' && !m.deprecated\n  61→    return {\n  62→      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n  63→      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n  64→      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n  65→      identity_group: m.identity_group || null,\n  66→      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n  67→      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n  68→      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n  69→      prices: normalizePrices(m), source: 'config',\n  70→      provider_detail: st.detail || null,\n  71→    }\n  72→  }).filter((m) => includeDeprecated || !m.deprecated)\n  73→}\n  74→\n  75→export function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n  76→  const level = normLevel(request.level || request.tier)\n  77→  const usageKind = normUsage(request.usage)\n  78→  const models = listModels(config, { status, includeDeprecated: true })\n  79→  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n  80→  const requireVerified = request.require_verified !== false\n  81→  const requireReadonly = request.require_readonly === true\n  82→  const exclude = new Set(request.exclude || [])\n  83→  const allowed = request.candidates ? new Set(request.candidates) : null\n  84→  const rejected = []\n  85→  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n  86→\n  87→  const candidates = models.filter((m) => {\n  88→    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n  89→    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n  90→    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n  91→    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n  92→    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n  93→    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n  94→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n  95→    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n  96→      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n  97→    }\n  98→    return true\n  99→  })\n 100→\n 101→  const rank = (m) => {\n 102→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 103→    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n 104→    const unknown = f.risk === 'unknown' ? 1 : 0\n 105→    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n 106→    if (usageKind === 'Light') return [price, unknown, m.key]\n 107→    return [unknown, price, m.key]\n 108→  }\n 109→  candidates.sort((a, b) => {\n 110→    const ra = rank(a), rb = rank(b)\n 111→    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n 112→    return 0\n 113→  })\n 114→\n 115→  const picked = candidates.slice(0, count).map((m) => {\n 116→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 117→    const call = cliCall(config, m, request)\n 118→    return {\n 119→      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n 120→      adapter: config.providers[m.provider]?.adapter || null,\n 121→      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n 122→      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n 123→      forecast: f, cli: call, call,\n 124→    }\n 125→  })\n 126→  return {\n 127→    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n 128→    models: picked, calls: picked.map((x) => x.call), rejected,\n 129→    reason: picked.length ? null : 'no_eligible_model',\n 130→    truncated: picked.length < count,\n 131→  }\n 132→}\n 133→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8be95c3139080423","_requestId":"8f47e50de44b4d20abf86a2f89384f73","_messageId":"01a1b5c21aed7424bebd7a38485c3762","_meta":{"codebuddy.ai/conversationRequestId":"8f47e50de44b4d20abf86a2f89384f73","codebuddy.ai/modelRequestId":"01a1b5c21aed7424bebd7a38485c3762","codebuddy.ai/llmMessageId":"01a1b5c21aed7424bebd7a38485c3762"},"__timestamp":"2026-11-07T11:26:23.870Z"}
