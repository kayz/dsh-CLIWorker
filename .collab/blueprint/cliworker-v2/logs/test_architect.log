{"type":"user","uuid":"01a1b5a5-febe-763c-962f-0d50f43ff4ec","session_id":"01a1b5a4-00dc-7683-9b43-241448a2c172","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-9d7928a042bc2e04","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→import '../lib/cli.mjs'\n   3→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8fbc2389571ddb10","_requestId":"98ba3086a6dd465998684e3779ab2961","_messageId":"01a1b5a5533a77fdad4d1c834c58fe2f","_meta":{"codebuddy.ai/conversationRequestId":"98ba3086a6dd465998684e3779ab2961","codebuddy.ai/modelRequestId":"01a1b5a5533a77fdad4d1c834c58fe2f","codebuddy.ai/llmMessageId":"01a1b5a5533a77fdad4d1c834c58fe2f"},"__timestamp":"2026-11-07T10:55:17.183Z"}
{"type":"user","uuid":"01a1b5a5-fec3-7410-8de1-4c4bf1d73165","session_id":"01a1b5a4-00dc-7683-9b43-241448a2c172","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-acf5e9357defe6b7","content":[{"type":"text","text":"   1→/**\n   2→ * dsh-cliworker — DSH host plugin.\n   3→ *\n   4→ * AgentLine and other clients only need the model source pointer:\n   5→ *   modelSource = { kind: \"cliworker\", command: \"node\",\n   6→ *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n   7→ *\n   8→ * The plugin exposes the same selection contract over DSH routes for UI use.\n   9→ */\n  10→import path from 'node:path'\n  11→import os from 'node:os'\n  12→import { fileURLToPath } from 'node:url'\n  13→import { loadConfig } from '../lib/config.mjs'\n  14→import { providerStatus } from '../lib/availability.mjs'\n  15→import { listModels, selectModels } from '../lib/select.mjs'\n  16→import { forecast } from '../lib/forecast.mjs'\n  17→\n  18→const __dirname = path.dirname(fileURLToPath(import.meta.url))\n  19→const DEFAULTS = {\n  20→  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\n  21→  readonly: false,\n  22→}\n  23→\n  24→function send(res, body, code = 200) {\n  25→  res.statusCode = code\n  26→  res.setHeader('content-type', 'application/json; charset=utf-8')\n  27→  res.setHeader('cache-control', 'no-store')\n  28→  res.end(JSON.stringify(body))\n  29→}\n  30→\n  31→function readBody(req) {\n  32→  return new Promise((resolve, reject) => {\n  33→    let raw = ''\n  34→    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n  35→    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n  36→    req.on('error', reject)\n  37→  })\n  38→}\n  39→\n  40→export const name = 'cliworker'\n  41→\n  42→export function apply(ctx, config = {}) {\n  43→  const settings = { ...DEFAULTS, ...(config || {}) }\n  44→  const getConfig = () => loadConfig({ file: settings.configPath })\n  45→\n  46→  try {\n  47→    ctx.inject(['webServer'], (httpCtx) => {\n  48→      const route = (p, name, handler) => httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\n  49→\n  50→      route('/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n  51→        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  52→      })\n  53→      route('/cliworker/models', 'cliworker: models', async (_req, res) => {\n  54→        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  55→      })\n  56→      route('/cliworker/select', 'cliworker: select', async (req, res) => {\n  57→        try {\n  58→          const c = getConfig()\n  59→          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n  60→          const request = body.request || body\n  61→          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c) }) })\n  62→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n  63→      })\n  64→      route('/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n  65→        try {\n  66→          const c = getConfig()\n  67→          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n  68→          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null }) })\n  69→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  70→      })\n  71→    })\n  72→  } catch (e) {\n  73→    console.error('[cliworker] webServer inject failed:', e.message)\n  74→  }\n  75→}\n  76→\n  77→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8fbc2389571ddb10","_requestId":"98ba3086a6dd465998684e3779ab2961","_messageId":"01a1b5a5533a77fdad4d1c834c58fe2f","_meta":{"codebuddy.ai/conversationRequestId":"98ba3086a6dd465998684e3779ab2961","codebuddy.ai/modelRequestId":"01a1b5a5533a77fdad4d1c834c58fe2f","codebuddy.ai/llmMessageId":"01a1b5a5533a77fdad4d1c834c58fe2f"},"__timestamp":"2026-11-07T10:55:17.187Z"}
{"type":"user","uuid":"01a1b5a5-fec7-770a-a373-b93580b6c04f","session_id":"01a1b5a4-00dc-7683-9b43-241448a2c172","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-9c88c1de0cc60a3b","content":[{"type":"text","text":"   1→# CLIWorker v2 设计稿（设计师）\n   2→\n   3→我只读了仓库，没有改动任何文件。下面的现状判断依据 `lib/*.mjs`、`config/cliworker.example.json`、`test/select.test.mjs`、`package.json` 和 `.gitignore`。\n   4→\n   5→## 0. 结论摘要\n   6→\n   7→- **AgentLine 拿到的调用是包装过的。** `calls[i]` 固定为 `node <pkg>/bin/cliworker.mjs run --lease <id> --config <cfg>`，不直接暴露各家 CLI 的命令。\n   8→  - AgentLine 只看到不透明的 `handle_id`、`lease_id`、`level` 和这条 `call`，看不到 provider、模型、价格或额度。\n   9→  - 这样做的另一个好处：执行器能注入令牌、统一输出格式、记录任务前后的用量，并保证重试不重复扣减。\n  10→- **直接调用另走管理入口。** 第 B.6 节要的 CLI 直接调用由 `cliworker cli resolve` 和 `view:'full'` 提供，只给人和管理界面用。\n  11→- **契约名不变。** `cliworker.selection/v1` 和 `cliworker.handle/v1` 保留，0.1 的扁平形状改称 draft。\n  12→  - 默认输出 AgentLine 视图。\n  13→  - `compat:'draft'` 再保留一个小版本，0.3.0 移除。\n  14→  - `cliworker.model/v1` 和 `cliworker.forecast/v1` 只加字段，不删字段。\n  15→  - 新增 `cliworker.request/v1`、`cliworker.event/v1`、`cliworker.inventory/v1`、`cliworker.config/v2`。\n  16→- **额度统一换算成 Mtoken。** 引入额度池（pool）：每个模型在每个池里有一个容量 `cap_p(m)`。\n  17→  - 剩余量 = 该模型所属各池中 `cap_p(m) × (1 − used_p)` 的最小值。\n  18→  - `used_p` 优先用 CLI 读数；读数过期或没有时，用账本累加 `tokens_i / cap_p(model_i)`。\n  19→  - 第 B.4.4 节的例子（opus 2M、sonnet 10M，用掉 50% 后 sonnet 剩 5M）正好是这个公式的特例。\n  20→  - 容量未知时，用 CLI 前后读数的百分比差值反推（来源标为 measured）。仍然算不出就报 unknown，不编数。\n  21→- **选模只读缓存，探测是单独动作。** 选模不起任何子进程，目标 p95 < 300ms（现状是同步探测，实测 3.4s）。探测只对白名单模型做，用小 token 加随机数做真实调用，结果带 TTL 缓存。\n  22→- **任务图共 24 个任务、5 个里程碑**，覆盖第 A 节全部缺陷和第 E 节七项成熟度要求。每个验收条件（AC）都有可执行命令。\n  23→\n  24→## 1. 现状判断（读代码得到的结论）\n  25→\n  26→- `forecast()` 只在 `quota.remaining_usd` 存在、或 `unit === 'tokens'` 时才能算出 `tasks_left`。示例配置里三个渠道都不满足，所以 `risk` 始终是 unknown（A1 成立）。\n  27→- `select.mjs` 在过滤、排序、输出三处各调一次 `forecast`；`cliCall` 的结果被同时写进 `cli` 和 `call`。\n  28→- `cursor-wsl` 分支把 cwd 拼进 `bash -lc` 字符串，存在注入风险。\n  29→- `availability.mjs` 在 win32 上用 `shell:true` 同步调 `spawnSync`。注意 Node 20 修复 CVE-2024-27980 后，不经 shell 直接 spawn `.cmd` 会被拒绝，所以修法必须包括「解析 npm 垫片后直接用 node 执行」。\n  30→- usage 文件路径由 `defaultHome()` 决定，和 `--config` 无关。`config.mjs` 里 `raw.schema && ...` 这行，在 raw 为 null 时会落进 `raw.schema` 读取而抛 TypeError。\n  31→- `package.json` 没有 `bin` 和 `scripts`，`files` 里缺 `bin` 和 `config`。\n  32→\n  33→## 2. 模块分层（新目录）\n  34→\n  35→| 位置 | 内容 |\n  36→|---|---|\n  37→| `lib/contract/` | 契约、校验器、错误码注册表、draft 兼容映射 |\n  38→| `lib/config.mjs`、`lib/paths.mjs`、`lib/config-migrate.mjs` | v1/v2 配置加载；`state_dir` 由配置推导 |\n  39→| `lib/store.mjs`、`lib/audit.mjs`、`lib/redact.mjs` | 原子写（先写临时文件再改名，Windows 上 EPERM 时重试）、JSONL 追加、文件锁（`wx` 创建，记录 pid 和时间戳，可回收陈旧锁）、审计日志、脱敏 |\n  40→| `lib/exec.mjs` | 唯一的子进程出口：异步 `execFile`、不用 shell、解析 win32 `.cmd` 垫片、参数白名单、超时后杀整棵进程树、并发上限 |\n  41→| `lib/secrets/` | 令牌引用（SecretRef）与各平台后端 |\n  42→| `lib/discovery/` | 平台识别、CLI 识别规则表、扫描、WSL 枚举 |\n  43→| `lib/models/` | 每个 CLI 一个模型枚举器，加归一化 |\n  44→| `lib/adapters/` | 每个 CLI 一个：生成调用参数、只读方式、输出事件解析 |\n  45→| `lib/catalog.mjs` | 白名单、等级、别名、弃用、能力、价格 |\n  46→| `lib/probe.mjs`、`lib/availability.mjs` | 真实探测与可用性状态机 |\n  47→| `lib/pools.mjs`、`lib/usage.mjs`、`lib/usage-readers/`、`lib/forecast.mjs`、`lib/quota.mjs` | 额度池、用量账本、额度读取、预测 |\n  48→| `lib/select.mjs`、`lib/leases.mjs` | 选模策略与租约 |\n  49→| `lib/runner.mjs`、`lib/events.mjs` | 执行器与输出归一 |\n  50→| `lib/index.js`、`lib/http/`、`lib/health.mjs` | DSH 插件、管理 API、健康检查 |\n  51→| `lib/cli.mjs` + `lib/commands/<cmd>/<sub>.mjs` | 命令路由：命令名按正则校验后动态 import，各任务新增命令时互不改同一个文件 |\n  52→| `ui/` | 管理界面：一个静态页面，原生 JS，不需要构建 |\n  53→\n  54→## 3. 边界与契约\n  55→\n  56→- **AgentLine 默认视图：** 请求只有 `level`、`count`、`usage`、`importance`、`require_readonly`、`cwd`、`timeout_ms`、`request_id`、`exclude_handles`。\n  57→  - 响应里只有不透明的 handle 和 call。`rejected` 只给不透明引用和原因码。\n  58→  - 有一条契约测试会递归扫描默认视图的键和值，确认不出现 cli、provider、vendor、模型 id、价格、额度、forecast 或直接调用命令。\n  59→- **数量不足：**\n  60→  - 返回 `ok:true`、`truncated:true` 和 `shortfall`。AgentLine 用新的 `request_id` 加 `exclude_handles` 再申请。\n  61→  - 一个都没有时返回 `ok:false`，错误码为 `E_NO_CANDIDATE` 或 `E_INSUFFICIENT_QUOTA`，可能带 `retry_after`（最近一个池的重置时刻）。\n  62→- **超时：**\n  63→  - 选模时等锁超时返回 `E_STATE_LOCKED`（可重试）。\n  64→  - 执行器按 `timeout_ms` 杀掉进程树，返回 `E_TIMEOUT`。\n  65→- **部分失败：** 部分数据过期或读数失败时仍然返回结果，同时在 `warnings` 里带 `W_STALE_DATA`。\n  66→- **不返回假 handle：** handle 必须同时满足：适配器生成了非空 call、模型可用性为 callable 且未过 TTL、额度检查已通过。\n  67→- **出错时的输出：** stdout 仍是单个 JSON，形如 `ok:false` 加 `error.code`。退出码按注册表固定（见 interfaces 第 5 节）。\n  68→- **未知字段：** 不再静默忽略，返回 `W_FIELD_IGNORED`（例如 `role`）。`importance` 改为正式字段，`high` 可以动用储备额度。\n  69→- **兼容与迁移：**\n  70→  - 带 `schema:'cliworker.request/v1'` 的请求得到新的 v1 视图。\n  71→  - 不带 schema 的旧请求，或带 `compat:'draft'` 的请求，得到 0.1 的扁平形状（去掉重复的 `cli`），并附带 deprecation 警告。\n  72→  - 字段对照表写在 `docs/migration.md`。\n  73→\n  74→## 4. Provider 层\n  75→\n  76→### 4.1 发现\n  77→\n  78→**平台识别：**\n  79→- win32、darwin、linux 按 `process.platform` 判断。\n  80→- 在 linux 下，如果 `/proc/version` 含 microsoft 或存在 `WSL_DISTRO_NAME`，判为 wsl。\n  81→\n  82→**WSL 跨发行版：**\n  83→- 在 Windows 宿主上用 `wsl.exe -l -q` 列发行版（输出是 UTF-16LE，需要按此解码）。\n  84→- 对每个发行版执行 `wsl.exe -d <d> --exec sh -c <固定脚本>`，查 `command -v` 和版本。脚本是常量，不拼接任何外部输入。\n  85→- 每个发行版生成独立条目，`platform` 为 `wsl:<distro>`。\n  86→\n  87→**扫描范围：**\n  88→- `PATH` 各段（Windows 上考虑 `PATHEXT`）。\n  89→- 常见安装目录：npm 全局目录、`~/.local/bin`、`/usr/local/bin`、`/opt/homebrew/bin`、`~/.bun/bin`、`~/.cargo/bin`、`%LOCALAPPDATA%/Programs`，以及 `/Applications/*.app` 内的 `bin`。\n  90→- 配置里的 `extra_dirs`。\n  91→\n  92→**识别规则表：**\n  93→- 规则表只是数据，内容是 id、候选可执行名、版本参数、认证状态命令、枚举策略、适配器 id，不含任何模型表。\n  94→- 覆盖 11 个已知 CLI：codex、claude、dsh、cursor（cursor-agent/agent）、codebuddy、antigravity、trae、zcode、qoder、kimi、opencode。\n  95→- 冷门 CLI（antigravity、trae、zcode、qoder）的可执行名先作为候选，用真机采集的夹具确认；配置项 `cli_overrides` 可以覆盖。\n  96→\n  97→**未知 CLI：**\n  98→- 文件名命中 `unknown_patterns` 的标为 `recognized:false`，证据只有路径、大小和修改时间。\n  99→- 默认不执行。只有加 `--probe-unknown` 时才跑 `--version`。\n 100→\n 101→**凭据：**\n 102→- 凭据路径有拒读清单，例如 `~/.claude/.credentials.json`、`~/.codex/auth.json`。所有文件读取都经过带拒读检查的 fs 包装，测试里用访问探针确认读取次数为 0。\n 103→- 认证状态只通过 CLI 自己的 status 命令获得，只记录布尔结果和脱敏后的摘要。\n 104→\n 105→**清单落盘：**\n 106→- 写到 `state_dir/inventory.json`（`cliworker.inventory/v1`）。\n 107→- 每个条目记录：路径、实际路径、版本、平台、指纹（大小、修改时间、实际路径）、证据（含命令、退出码、时间、摘要哈希）、首次和最近一次看到的时间。\n 108→- 增量刷新：指纹没变且在 TTL 内就不重新执行；找不到的 CLI 标为 gone，不删除；`--full` 强制全量刷新。\n 109→\n 110→### 4.2 安全执行\n 111→\n 112→- 所有地方都不用 `shell:true`。\n 113→- win32 上的 `.cmd` 垫片：先解析出 node 和脚本路径直接执行；解析不了时才走 `cmd.exe /d /s /c`，而且只接受符合严格正则的参数，否则返回 `E_UNSAFE_ARG`。\n 114→- WSL 调用用 `wsl.exe -d <d> --cd <cwd> --exec <cli> ...` 的参数数组形式，不拼 bash 字符串。\n 115→\n 116→### 4.3 模型枚举\n 117→\n 118→**每个 CLI 一个枚举器，按以下顺序尝试：**\n 119→1. 子命令（例如 `models` 一类）\n 120→2. 解析 `--help` 中 `--model` 的可选值\n 121→3. 白名单内的非凭据本地缓存或配置文件\n 122→4. 官方 API：Node 20 内置 fetch，令牌来自用户提供的 SecretRef\n 123→\n 124→**全部失败时：** 回退到手工补录（`models add` 或配置项 `catalog.manual`），结果中带 `source.kind = manual` 并提示用户补录。\n 125→\n 126→**归一字段：** key（`<cli>:<id>`）、id、cli、vendor、capabilities（上下文长度、只读、stdin）、source（kind、ref、at）、aliases。\n 127→\n 128→**不写死模型表：** 检查脚本扫描 `lib/` 下的模型 id 字面量。\n 129→\n 130→### 4.4 调用适配器\n 131→\n 132→**每个适配器提供两样东西：**\n 133→- `buildCall`：按平台返回参数数组形式的调用，包括 command、args、cwd、input（stdin、arg 或 file）、只读实现方式、需要的环境变量名。\n 134→- `parseEvent`：把该 CLI 的输出行归一成 `cliworker.event/v1`。\n 135→\n 136→**参数确认不了时：** 返回 `call:null` 和 `adapter_unverified`，对应模型不可选。\n 137→\n 138→**`cli resolve` 的输出：**\n 139→- 带上选定 model 的直接调用。\n 140→- 按 pwsh 和 posix 两种规则引用的展示串，只用于展示。\n 141→\n 142→### 4.5 真实探测与可用性\n 143→\n 144→**探测方式：** 发一条要求原样回复 `OK-<nonce>` 的极小提示。CLI 支持时限制输出长度。\n 145→\n 146→**判定规则：**\n 147→\n 148→| 情况 | 结果 |\n 149→|---|---|\n 150→| 退出码 0 且回复里有 nonce | callable |\n 151→| 认证失败、401/403、额度用尽 | blocked（附子原因 auth 或 quota） |\n 152→| 找不到可执行文件、超时 | unavailable |\n 153→| CLI 报模型不存在，或配置标了弃用 | deprecated |\n 154→| 输出里报告的模型与请求的不一致 | identity 记为 mismatch，判 blocked |\n 155→\n 156→**其他规则：**\n 157→- 证据包括：探测 id、脱敏后的命令、退出码、耗时、nonce 是否匹配、报告的模型、消耗的 token。\n 158→- 只在超时时重试一次。\n 159→- 探测消耗以 `kind=probe` 记入账本。\n 160→- callable 过了 TTL 后，选模时按 `availability_stale` 拒选。\n 161→\n 162→## 5. 模型目录\n 163→\n 164→- **白名单：** `catalog.allow` 是唯一入口。\n 165→  - 不在白名单的模型不探测、不计费、不进预测，也不出现在候选列表和 AgentLine 视图的 `rejected` 里。\n 166→  - 管理视图里仍然可见，标为 not_allowed，方便用户加入。\n 167→- **等级来源优先级：** 用户配置 > 实测 > CLI 声明，并记录 `level_source`（kind、ref、at）。白名单里没有等级的模型以 `level_unassigned` 拒选。\n 168→- **别名和弃用：** 别名解析到同一个 key；弃用模型可用性为 deprecated。\n 169→- **价格：** 来自配置或 API，标注来源，只用于付费池的成本换算。\n 170→\n 171→## 6. 额度池、用量与预测\n 172→\n 173→**池的类型：**\n 174→- 计划内（funding 为 plan）：`plan_window`（例如 claude 5 小时滚动窗口）、`plan_weekly`。\n 175→- 付费（funding 为 paid）：`credits`、`prepaid_usd`。\n 176→- 一个模型可以同时属于多个池（例如 5 小时池和周池），剩余量取最小值。\n 177→\n 178→**`used_p` 的取法：**\n 179→1. CLI 读数新鲜时直接用。例如 codex 的 json 事件和会话文件里的额度字段；claude 的输出里如果有额度事件也会捕获。\n 180→2. 否则用账本累加：窗口内每条记录的 `tokens_i / cap_p(model_i)` 之和。\n 181→\n 182→**重置时间：**\n 183→- 来源优先级：CLI > 配置 > 由账本估算（滚动窗口从首条样本起算）> unknown，并标注 `reset_source`。\n 184→- 窗口过期后 `used_p` 归零。\n 185→\n 186→**预测：**\n 187→- 输入固定的 `now` 和样本，输出是确定的，可直接测试。\n 188→- 输出项：`burn_mtok_per_hour`、`eta_exhaust_at`、`exhausts_before_reset`，以及按任务量分位数算的 `tasks_left`（Heavy、Normal、Light 分别用 p90、p50、p25；没有样本时用配置估计值，并标为 assumed）。\n 189→- `cliworker.forecast/v1` 只加字段，旧的 `burn_per_task` 和 `risk` 枚举不变。\n 190→\n 191→**账本：**\n 192→- `cliworker.usage/v1` 只加字段，新增 `idempotency_key`（`<lease_id>:<phase>`），读和写两侧都去重。\n 193→\n 194→**第 A1 节的修复：** 先在 `lib/quota.mjs` 把四种额度形状统一成 Mtok（需要容量、credits 换算率或价格）。M4 在这个基础上扩展成多池模型。\n 195→\n 196→## 7. 选模策略与租约\n 197→\n 198→**过滤条件：** 在白名单内、等级匹配、callable 且未过 TTL、只读能力满足、没被排除、适配器已确认。\n 199→\n 200→**排序：**\n 201→1. 计划内池能完成本次任务（剩余量减去储备 ≥ 预计用量）的排在最前。\n 202→2. 同为计划内时，优先选「离重置越近、剩余越多」的池，也就是按 `剩余量 / 距重置小时数` 从大到小排，尽量用完窗口额度。\n 203→3. 剩余量 unknown 的计划内池，按 `unknown_policy` 处理：默认排在已知可完成的之后，也可配置为直接拒选。\n 204→4. 付费池（充值或付费额度）兜底，并标记 `funding=paid`。\n 205→5. 并列时依次比较价格和 key。`count > 1` 时优先选不同的 `identity_group`。\n 206→\n 207→**储备：** `importance:high` 才能动用 `reserve_fraction_for_high` 那部分额度。\n 208→\n 209→**租约：**\n 210→- 选中后按预计用量做软预留，状态写进加锁的 `leases.json`。50 个并发请求的预留总量不会超过剩余量。\n 211→- 相同 `request_id` 重放时返回相同结果，不重复预留。\n 212→- 租约过期或执行完毕后释放。\n 213→\n 214→## 8. 密钥\n 215→\n 216→**SecretRef 的三种形式：**\n 217→- `env:NAME`\n 218→- `keychain:<name>`：win32 走 DPAPI（经 pwsh 调用），macOS 走 `security`，Linux 走 `secret-tool`。\n 219→- `session`：只保存在插件进程内存里。\n 220→\n 221→**规则：**\n 222→- 后端不可用时报 `E_SECRET_BACKEND`，绝不回退成明文文件。\n 223→- 配置文件里出现明文令牌，报 `E_CONFIG_SECRET_INLINE`。\n 224→- 令牌只通过环境变量注入子进程，不放进 argv，也不出现在返回的 call 里。\n 225→- 所有输出、审计、证据都经过脱敏：已登记的密钥值、`sk-` 前缀、Bearer、JWT 形状的字符串。\n 226→- `auth status` 只显示 set 或 unset。\n 227→\n 228→## 9. 插件、界面与实时数据\n 229→\n 230→**路由：**\n 231→- 保留四条兼容路由：providers、models、select、forecast。\n 232→- 新增 `/cliworker/health`、`/cliworker/ui`、`/cliworker/api/*`。\n 233→- 写接口要求 `x-cliworker-csrf` 头，插件为 readonly 时一律返回 403。\n 234→\n 235→**界面六列：** 白名单开关、等级（及来源）、可用性（状态、时间、证据摘要）、余量（Mtok，按池展开）、刷新或重置时间、最近一次实测证据。\n 236→\n 237→**数据怎么来、怎么刷新：**\n 238→- 页面每 15 秒拉一次 `api/snapshot?since=rev`。这个接口只读状态文件，不触发探测。\n 239→- 发现、枚举、探测、读取额度通过 job 接口异步执行，前端轮询 job 状态。\n 240→\n 241→**怎么显示失败和缺数据：**\n 242→- 每个值都带 source 和 at，按 TTL 显示 fresh、stale 或 unknown。\n 243→- 刷新失败时显示最近一次错误和时间，保留上次的值但标为 stale。\n 244→- 缺样本一律显示 unknown，不显示 0 或 100%。\n 245→- 渲染逻辑写成纯函数 `ui/render.mjs`，方便单元测试。\n 246→\n 247→## 10. 可靠性与恢复\n 248→\n 249→**运行时：**\n 250→- 所有状态都落盘，原子写入，写前加锁。\n 251→- 启动时回收陈旧锁、释放过期租约。\n 252→- 执行器按 lease 幂等：已成功的租约再次执行返回 `E_LEASE_CONSUMED`。\n 253→- 执行失败会按原因归类，并反过来更新可用性状态（例如认证失败判 blocked），下一次选模就会避开。\n 254→\n 255→**升级与回滚：**\n 256→- 升级时先把 state 备份到 `backup-<ver>-<ts>`，然后按 `state/VERSION` 迁移。\n 257→- 回滚 = 重装旧包，再执行 `state restore`。\n 258→\n 259→## 11. 缺陷修复对照\n 260→\n 261→| 缺陷 | 任务 | 验收 |\n 262→|---|---|---|\n 263→| A1 额度形状 | T-004（最终形态在 T-017） | AC-007、AC-008 |\n 264→| A2 打包 | T-002 | AC-003 |\n 265→| A3 测试脚本 | T-001 | AC-001、AC-002；新增覆盖分散在各任务 |\n 266→| A4 落盘位置、.gitignore、占位配置 | T-003 | AC-004、AC-005 |\n 267→| A4 配置为 null 抛 TypeError | T-003 | AC-006 |\n 268→| A5 重复字段、未使用导入、重复 forecast | T-005 | AC-009 |\n 269→| A5 role/importance 被忽略 | T-005 | AC-010 |\n 270→| A5 shell 风险 | T-008 | AC-016 |\n 271→| A5 无缓存与性能 | T-016、T-018 | AC-018 |\n 272→\n 273→**测试脚本说明：**\n 274→- `npm test` 改为 `node scripts/run-tests.mjs test`：脚本自己列出文件，再以文件参数调用 `node --test`。这样同时避开 Node 22 把目录当模块解析的问题，以及 Node 20 不支持 glob 参数的问题。\n 275→- 按全局约定，新增 `scripts/check-fast.ps1` 作为完成前的检查。\n 276→\n 277→## 12. 成熟度清单对照\n 278→\n 279→| 清单项 | 任务 |\n 280→|---|---|\n 281→| E1 契约 | T-006、T-018 |\n 282→| E2 Provider 层 | T-008、T-012、T-013、T-014、T-016 |\n 283→| E3 模型目录 | T-015 |\n 284→| E4 用量与预测 | T-017、T-019 |\n 285→| E5 插件形态 | T-020、T-021、T-022、T-009、T-007 |\n 286→| E6 可靠性 | T-018、T-019、T-022、T-007 |\n 287→| E7 测试 | T-011（provider 夹具）、T-006（契约）、T-017（确定性预测）、T-022（安装 e2e）、T-024（真机冒烟） |\n 288→\n 289→## 13. 假设与待用户确认\n 290→\n 291→1. **冷门 CLI 的命令和参数形态需要真机采集。** antigravity、trae、zcode、qoder 的可执行名和非交互参数，在采集前一律按 `adapter_unverified` 处理，不可选。\n 292→2. **模型容量（每池 Mtok）缺省由用户在配置里给出，或通过 CLI 前后读数的百分比差值学习得到。** 不内置厂商的容量数字。\n 293→3. **探测会消耗额度。** 默认只手动触发；定时探测需要在 `policy` 里显式开启。\n 294→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"chatcmpl-tool-8fbc2389571ddb10","_requestId":"98ba3086a6dd465998684e3779ab2961","_messageId":"01a1b5a5533a77fdad4d1c834c58fe2f","_meta":{"codebuddy.ai/conversationRequestId":"98ba3086a6dd465998684e3779ab2961","codebuddy.ai/modelRequestId":"01a1b5a5533a77fdad4d1c834c58fe2f","codebuddy.ai/llmMessageId":"01a1b5a5533a77fdad4d1c834c58fe2f"},"__timestamp":"2026-11-07T10:55:17.191Z"}
