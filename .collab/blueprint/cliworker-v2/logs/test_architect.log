{"type":"user","uuid":"01a1b5a5-6975-7d5e-8710-4cfc7fb11431","session_id":"01a1b5a4-00dc-7683-9b43-241448a2c172","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-92c177bf882410f0","content":[{"type":"text","text":"   1→{\n   2→  \"schema\": \"agentline.taskgraph/v1\",\n   3→  \"milestones\": [\n   4→    {\n   5→      \"id\": \"M1\",\n   6→      \"title\": \"基线修复与工程化：修掉第 A 节全部缺陷，测试与打包可复现\"\n   7→    },\n   8→    {\n   9→      \"id\": \"M2\",\n  10→      \"title\": \"契约与基础设施：v1 契约定稿、状态存储、安全执行、密钥、配置 v2、provider 夹具\"\n  11→    },\n  12→    {\n  13→      \"id\": \"M3\",\n  14→      \"title\": \"Provider 层：本地发现、模型枚举、调用适配器、模型目录、真实探测\"\n  15→    },\n  16→    {\n  17→      \"id\": \"M4\",\n  18→      \"title\": \"用量与选模：额度池与预测、选模策略与租约、执行器\"\n  19→    },\n  20→    {\n  21→      \"id\": \"M5\",\n  22→      \"title\": \"插件与交付：DSH 路由与健康检查、管理界面、安装/升级/回滚、文档、真机冒烟\"\n  23→    }\n  24→  ],\n  25→  \"acceptance\": [\n  26→    {\n  27→      \"id\": \"AC-001\",\n  28→      \"text\": \"npm test 在 Node 20 和 Node 22 上都以 0 退出；test 下所有子目录里的 *.test.mjs 都被执行，执行数与文件数一致（check-test-discovery 校验）\",\n  29→      \"levels\": [\n  30→        \"unit\"\n  31→      ]\n  32→    },\n  33→    {\n  34→      \"id\": \"AC-002\",\n  35→      \"text\": \"scripts/check-fast.ps1 依次运行未使用导入检查、打包检查和全部测试，任一步失败即以非 0 退出\",\n  36→      \"levels\": [\n  37→        \"unit\"\n  38→      ]\n  39→    },\n  40→    {\n  41→      \"id\": \"AC-003\",\n  42→      \"text\": \"npm pack 产物包含 bin/cliworker.mjs、config/cliworker.example.json、lib/ 和 package.json 中的 bin.cliworker；不含 config/*.local.json、state/ 和 *.jsonl\",\n  43→      \"levels\": [\n  44→        \"integration\"\n  45→      ]\n  46→    },\n  47→    {\n  48→      \"id\": \"AC-004\",\n  49→      \"text\": \"usage 和所有状态文件写到由 --config 推导出的 state_dir（显式 state_dir 优先，否则为 CLIWORKER_HOME/state/<配置路径摘要>）；两份不同配置互不串扰；cliworker paths 输出解析结果\",\n  50→      \"levels\": [\n  51→        \"integration\",\n  52→        \"unit\"\n  53→      ]\n  54→    },\n  55→    {\n  56→      \"id\": \"AC-005\",\n  57→      \"text\": \".gitignore 规则确实命中 config/*.local.json、state/ 和 *.jsonl（git check-ignore 验证）；example 带 _example:true，直接加载 example 或与之逐字节相同的配置返回 E_CONFIG_EXAMPLE；init 不覆盖已存在的配置\",\n  58→      \"levels\": [\n  59→        \"unit\"\n  60→      ]\n  61→    },\n  62→    {\n  63→      \"id\": \"AC-006\",\n  64→      \"text\": \"配置根为 null、数组、非 JSON 或缺 providers 时，返回 E_CONFIG 和包含文件路径与原因的可读信息，不抛 TypeError\",\n  65→      \"levels\": [\n  66→        \"unit\"\n  67→      ]\n  68→    },\n  69→    {\n  70→      \"id\": \"AC-007\",\n  71→      \"text\": \"forecast 能处理四种额度形状：remaining_pct（结合 capacity_mtok 或含 pct 增量的样本）、remaining 加 unit credits（结合换算率或价格）、remaining_usd、tokens；remaining_pct 为 5 且容量已知时 risk 为 critical 或 exhausted，Heavy 请求以 E_FORECAST_EXHAUSTION 被拒选，按剩余任务数排序生效\",\n  72→      \"levels\": [\n  73→        \"unit\"\n  74→      ]\n  75→    },\n  76→    {\n  77→      \"id\": \"AC-008\",\n  78→      \"text\": \"缺容量或缺样本时 risk 保持 unknown 并给出 reason，不会用默认值算出 ok\",\n  79→      \"levels\": [\n  80→        \"unit\"\n  81→      ]\n  82→    },\n  83→    {\n  84→      \"id\": \"AC-009\",\n  85→      \"text\": \"handle 不再同时输出相同的 cli 和 call；每个候选模型的 forecast 只计算一次（注入计数器断言）；check-unused 在 lib 下报告 0 个未使用的导入和顶层函数\",\n  86→      \"levels\": [\n  87→        \"unit\"\n  88→      ]\n  89→    },\n  90→    {\n  91→      \"id\": \"AC-010\",\n  92→      \"text\": \"所有 CLI 命令的 stdout 只输出一个 JSON；出错时输出 ok:false 和 error.code，退出码符合注册表；支持 --request-file 和 --level/--count/--usage/--importance；role 等未知字段返回 W_FIELD_IGNORED；importance 正式生效\",\n  93→      \"levels\": [\n  94→        \"integration\",\n  95→        \"unit\"\n  96→      ]\n  97→    },\n  98→    {\n  99→      \"id\": \"AC-011\",\n 100→      \"text\": \"contracts/examples 下的 ModelRequest、ModelSelection、ModelHandle、Event 和错误样例全部通过校验器；错误码注册表与快照一致，删除或改名会让测试失败\",\n 101→      \"levels\": [\n 102→        \"contract\"\n 103→      ]\n 104→    },\n 105→    {\n 106→      \"id\": \"AC-012\",\n 107→      \"text\": \"compat:'draft' 请求和不带 schema 的旧请求得到 0.1 扁平形状（不含重复的 cli），并带 deprecation 警告；docs/contract.md 给出字段映射\",\n 108→      \"levels\": [\n 109→        \"contract\"\n 110→      ]\n 111→    },\n 112→    {\n 113→      \"id\": \"AC-013\",\n 114→      \"text\": \"20 个并发进程各追加 50 行后，账本 1000 行全部可解析、互不交错；模拟写到一半崩溃后旧文件仍完整；陈旧锁可被回收\",\n 115→      \"levels\": [\n 116→        \"integration\",\n 117→        \"unit\"\n 118→      ]\n 119→    },\n 120→    {\n 121→      \"id\": \"AC-014\",\n 122→      \"text\": \"redact 能打码 sk- 前缀、Bearer、JWT 和已登记的密钥值；审计、错误信息和探测证据都经过 redact\",\n 123→      \"levels\": [\n 124→        \"unit\"\n 125→      ]\n 126→    },\n 127→    {\n 128→      \"id\": \"AC-015\",\n 129→      \"text\": \"select、lease、run、probe、白名单与等级变更、密钥设置都在 audit.jsonl 留一条记录，包含时间、入口（cli 或 http）和结果，不含密钥值\",\n 130→      \"levels\": [\n 131→        \"unit\"\n 132→      ]\n 133→    },\n 134→    {\n 135→      \"id\": \"AC-016\",\n 136→      \"text\": \"exec 层在任何平台都不使用 shell:true；含 & | ; ^ % 空格或引号的参数要么原样传递，要么以 E_UNSAFE_ARG 拒绝，不会被 shell 改写；win32 上的 npm .cmd 垫片被解析为 node 加脚本直接执行\",\n 137→      \"levels\": [\n 138→        \"integration\",\n 139→        \"unit\"\n 140→      ]\n 141→    },\n 142→    {\n 143→      \"id\": \"AC-017\",\n 144→      \"text\": \"超时会杀掉整个子进程树；N 个各睡 1 秒的伪 CLI 在并发上限 4 时总耗时小于 N/4+1 秒\",\n 145→      \"levels\": [\n 146→        \"integration\",\n 147→        \"unit\"\n 148→      ]\n 149→    },\n 150→    {\n 151→      \"id\": \"AC-018\",\n 152→      \"text\": \"选模只读缓存状态：注入 exec 探针断言选模过程中 0 次子进程；在 50 个白名单模型的夹具上 p95 小于 300ms\",\n 153→      \"levels\": [\n 154→        \"unit\"\n 155→      ]\n 156→    },\n 157→    {\n 158→      \"id\": \"AC-019\",\n 159→      \"text\": \"用户提供的哨兵令牌在经过 auth、doctor、discover、probe、select、run 和 HTTP 全流程后，不出现在 stdout、stderr、state_dir 下的任何文件、audit 和 HTTP 响应中；只以环境变量注入子进程，不出现在 argv 里\",\n 160→      \"levels\": [\n 161→        \"integration\"\n 162→      ]\n 163→    },\n 164→    {\n 165→      \"id\": \"AC-020\",\n 166→      \"text\": \"配置里出现明文令牌字段时返回 E_CONFIG_SECRET_INLINE；OS 密钥后端不可用时返回 E_SECRET_BACKEND，不回退成明文文件；auth status 只显示 set 或 unset\",\n 167→      \"levels\": [\n 168→        \"unit\"\n 169→      ]\n 170→    },\n 171→    {\n 172→      \"id\": \"AC-021\",\n 173→      \"text\": \"v1 配置在内存中迁移为 v2 并给出 W_CONFIG_V1；config migrate 生成的 v2 文件把原有模型保留为手工补录项、白名单和等级（level_source 为 config）；同一夹具在迁移前后的选模结果一致\",\n 174→      \"levels\": [\n 175→        \"unit\"\n 176→      ]\n 177→    },\n 178→    {\n 179→      \"id\": \"AC-022\",\n 180→      \"text\": \"fake-cli 夹具能在当前平台为 11 个已知 CLI 和 1 个未知 CLI 生成可执行垫片，支持 ok、auth、quota、timeout、deprecated、mismatch 六种模式，--help、--version 和模型列表的输出都可配置\",\n 181→      \"levels\": [\n 182→        \"integration\"\n 183→      ]\n 184→    },\n 185→    {\n 186→      \"id\": \"AC-023\",\n 187→      \"text\": \"在夹具 PATH 和已知安装目录下发现 11 个已知 CLI，记录路径、版本、平台和证据；未知的可疑 CLI 标为 recognized:false，默认不执行（exec 计数为 0），只在 --probe-unknown 时执行 --version\",\n 188→      \"levels\": [\n 189→        \"integration\",\n 190→        \"unit\"\n 191→      ]\n 192→    },\n 193→    {\n 194→      \"id\": \"AC-024\",\n 195→      \"text\": \"WSL：解析 wsl.exe -l -q 的 UTF-16LE 输出夹具得到多个发行版，每个发行版生成 platform 为 wsl:<distro> 的独立条目；在 WSL 内运行时识别自身为 wsl；没有 WSL 时跳过并记录原因\",\n 196→      \"levels\": [\n 197→        \"unit\"\n 198→      ]\n 199→    },\n 200→    {\n 201→      \"id\": \"AC-025\",\n 202→      \"text\": \"inventory.json 增量刷新：指纹未变且在 TTL 内的条目不重新执行；被删除的 CLI 标为 gone 而不是删掉；--full 强制刷新；清单通过 inventory/v1 校验\",\n 203→      \"levels\": [\n 204→        \"integration\"\n 205→      ]\n 206→    },\n 207→    {\n 208→      \"id\": \"AC-026\",\n 209→      \"text\": \"发现过程中，对拒读清单内凭据路径的 fs 读取次数为 0（访问探针断言）；证据里只有脱敏后的命令输出摘要\",\n 210→      \"levels\": [\n 211→        \"integration\"\n 212→      ]\n 213→    },\n 214→    {\n 215→      \"id\": \"AC-027\",\n 216→      \"text\": \"每个已知 CLI 的枚举器都有夹具测试（子命令、--help、缓存文件、API 至少一种）；所有策略都失败时回退到 source manual 并提示补录；models add 可以录入；归一字段齐全（id、cli、vendor、capabilities、source.kind、source.at）\",\n 217→      \"levels\": [\n 218→        \"unit\"\n 219→      ]\n 220→    },\n 221→    {\n 222→      \"id\": \"AC-028\",\n 223→      \"text\": \"check-no-model-table 确认 lib 下没有模型 id 字面量表（测试夹具和示例配置除外）\",\n 224→      \"levels\": [\n 225→        \"unit\"\n 226→      ]\n 227→    },\n 228→    {\n 229→      \"id\": \"AC-029\",\n 230→      \"text\": \"适配器为每个已知 CLI 在 win32、darwin、linux、wsl 上生成参数数组形式的调用（command、args、cwd、input、只读方式、env 名），与金标夹具一致；cwd 含空格和单引号时依然正确；WSL 用 --cd 和 --exec，不拼 shell 字符串；cli resolve 返回带选定 model 的直接调用\",\n 231→      \"levels\": [\n 232→        \"unit\"\n 233→      ]\n 234→    },\n 235→    {\n 236→      \"id\": \"AC-030\",\n 237→      \"text\": \"参数形态无法确认的 CLI，适配器返回 call:null 和 adapter_unverified，其模型不可被选中，选择结果里不会出现假 handle\",\n 238→      \"levels\": [\n 239→        \"unit\"\n 240→      ]\n 241→    },\n 242→    {\n 243→      \"id\": \"AC-031\",\n 244→      \"text\": \"不在白名单的模型不出现在候选、AgentLine 视图的 rejected、探测队列和用量预测里；管理视图里可见并标为 not_allowed\",\n 245→      \"levels\": [\n 246→        \"unit\"\n 247→      ]\n 248→    },\n 249→    {\n 250→      \"id\": \"AC-032\",\n 251→      \"text\": \"等级来源优先级为 config > measured > cli，并记录 level_source（kind、ref、at）；没有等级的白名单模型以 level_unassigned 拒选；别名解析到同一模型；弃用模型可用性为 deprecated\",\n 252→      \"levels\": [\n 253→        \"unit\"\n 254→      ]\n 255→    },\n 256→    {\n 257→      \"id\": \"AC-033\",\n 258→      \"text\": \"探测发出带 nonce 的小 token 真实调用；fake CLI 的各模式分别得到 callable、blocked（auth 或 quota）、unavailable（timeout 或 enoent）、deprecated，身份不符时为 blocked；记录时间、TTL 和证据；只有超时重试 1 次；过期的 callable 在选模时视为 availability_stale\",\n 259→      \"levels\": [\n 260→        \"integration\"\n 261→      ]\n 262→    },\n 263→    {\n 264→      \"id\": \"AC-034\",\n 265→      \"text\": \"只有白名单模型会被探测；探测消耗以 kind=probe 写入用量账本，并计入对应额度池\",\n 266→      \"levels\": [\n 267→        \"integration\"\n 268→      ]\n 269→    },\n 270→    {\n 271→      \"id\": \"AC-035\",\n 272→      \"text\": \"claudecode 5h 池的例子：容量 opus 2 Mtok、sonnet 10 Mtok；used_fraction 为 0 时剩余分别为 2 和 10，为 0.5 时分别为 1 和 5；used_fraction 来自 CLI 读数和来自账本按 tokens/容量加权累加，两种情况都有测试\",\n 273→      \"levels\": [\n 274→        \"unit\"\n 275→      ]\n 276→    },\n 277→    {\n 278→      \"id\": \"AC-036\",\n 279→      \"text\": \"reset_at 按 cli > config > 账本估算 > unknown 的优先级取得并标注 reset_source；窗口过期后 used_fraction 归零\",\n 280→      \"levels\": [\n 281→        \"unit\"\n 282→      ]\n 283→    },\n 284→    {\n 285→      \"id\": \"AC-037\",\n 286→      \"text\": \"给定固定的 now 和样本，burn_mtok_per_hour、eta_exhaust_at、exhausts_before_reset 和 tasks_left（Heavy/Normal/Light 分别用 p90/p50/p25）结果确定；模型挂多个池时取最小剩余\",\n 287→      \"levels\": [\n 288→        \"unit\"\n 289→      ]\n 290→    },\n 291→    {\n 292→      \"id\": \"AC-038\",\n 293→      \"text\": \"同一 idempotency_key 的用量行重复写入只计一次；容量能从 pct 增量样本学到（source 为 measured，带置信度）\",\n 294→      \"levels\": [\n 295→        \"unit\"\n 296→      ]\n 297→    },\n 298→    {\n 299→      \"id\": \"AC-039\",\n 300→      \"text\": \"计划内额度够完成任务时优先用计划内；计划内不足或会跌破储备时才用付费池（funding=paid）；同为计划内时优先选重置更早且足够完成任务的池；每个拒选都有原因\",\n 301→      \"levels\": [\n 302→        \"unit\"\n 303→      ]\n 304→    },\n 305→    {\n 306→      \"id\": \"AC-040\",\n 307→      \"text\": \"importance=high 可以动用储备，normal 不可以；储备比例来自配置\",\n 308→      \"levels\": [\n 309→        \"unit\"\n 310→      ]\n 311→    },\n 312→    {\n 313→      \"id\": \"AC-041\",\n 314→      \"text\": \"可用数小于 count 时返回 ok:true、truncated:true 和 shortfall；一个都没有时返回 ok:false 和 E_NO_CANDIDATE 或 E_INSUFFICIENT_QUOTA；models 与 calls 一一对应，每个 handle 的 call 都非空，且对应模型状态为 callable\",\n 315→      \"levels\": [\n 316→        \"contract\",\n 317→        \"unit\"\n 318→      ]\n 319→    },\n 320→    {\n 321→      \"id\": \"AC-042\",\n 322→      \"text\": \"50 个并发选模请求不会让同一池的预留总量超过剩余量；相同 request_id 重放返回相同 handle，不重复预留；exclude_handles 可用于再次申请补足数量\",\n 323→      \"levels\": [\n 324→        \"integration\"\n 325→      ]\n 326→    },\n 327→    {\n 328→      \"id\": \"AC-043\",\n 329→      \"text\": \"默认（AgentLine）视图的 selection、handle、rejected 和 error 里不出现 cli、provider、vendor、模型 id、价格、额度、forecast 或直接 CLI 命令（契约测试递归扫描键和值）；view=full 只在管理入口可用\",\n 330→      \"levels\": [\n 331→        \"contract\"\n 332→      ]\n 333→    },\n 334→    {\n 335→      \"id\": \"AC-044\",\n 336→      \"text\": \"run --lease 以 cliworker.event/v1 JSONL 输出归一事件，结束时输出带 usage 的 result；任务前后都写账本（含池读数）；stdin 透传，cwd 生效\",\n 337→      \"levels\": [\n 338→        \"integration\"\n 339→      ]\n 340→    },\n 341→    {\n 342→      \"id\": \"AC-045\",\n 343→      \"text\": \"已成功的租约再次 run 返回 E_LEASE_CONSUMED，不重复扣减；失败归为 E_PROVIDER_AUTH 或 E_PROVIDER_QUOTA 时，模型可用性被置为 blocked，并影响下一次选模；超时杀掉进程树并返回 E_TIMEOUT；过期租约返回 E_LEASE_EXPIRED\",\n 344→      \"levels\": [\n 345→        \"integration\"\n 346→      ]\n 347→    },\n 348→    {\n 349→      \"id\": \"AC-046\",\n 350→      \"text\": \"用伪 ctx 和 webServer 加载插件后，四条兼容路由以及 /cliworker/api/*、/cliworker/health、/cliworker/ui 都能访问；select 路由的输出与 CLI 一致\",\n 351→      \"levels\": [\n 352→        \"integration\"\n 353→      ]\n 354→    },\n 355→    {\n 356→      \"id\": \"AC-047\",\n 357→      \"text\": \"插件为 readonly 时所有写 API 返回 403；写 API 缺 csrf 头时返回 403；任何 HTTP 响应都不含密钥\",\n 358→      \"levels\": [\n 359→        \"integration\"\n 360→      ]\n 361→    },\n 362→    {\n 363→      \"id\": \"AC-048\",\n 364→      \"text\": \"doctor 和 /cliworker/health 报告配置有效性、state_dir 是否可写、锁状态、密钥后端、清单年龄、过期探测数量；有问题时 doctor 非 0 退出，health 返回 degraded 而不是 ok\",\n 365→      \"levels\": [\n 366→        \"integration\",\n 367→        \"unit\"\n 368→      ]\n 369→    },\n 370→    {\n 371→      \"id\": \"AC-049\",\n 372→      \"text\": \"界面渲染函数对缺失或过期的数据显示 unknown 或 stale，并附 source 和 at，不显示 0 或 100% 之类的默认值；白名单、等级、可用性、余量（Mtok）、刷新时间、最近实测证据六列齐全\",\n 373→      \"levels\": [\n 374→        \"unit\"\n 375→      ]\n 376→    },\n 377→    {\n 378→      \"id\": \"AC-050\",\n 379→      \"text\": \"界面通过 snapshot 轮询取数，不触发探测；刷新和探测走 job 接口；失败时显示最近一次错误和时间，保留上次的值并标为 stale\",\n 380→      \"levels\": [\n 381→        \"integration\"\n 382→      ]\n 383→    },\n 384→    {\n 385→      \"id\": \"AC-051\",\n 386→      \"text\": \"npm pack 后安装到临时目录：cliworker --version 和 cliworker doctor --config <临时配置> 能运行；插件的 apply 可以被导入并注册路由\",\n 387→      \"levels\": [\n 388→        \"e2e\"\n 389→      ]\n 390→    },\n 391→    {\n 392→      \"id\": \"AC-052\",\n 393→      \"text\": \"升级时自动备份 state 并迁移 state/VERSION；state restore 能回滚到备份；进程被杀后重启，未过期的租约、账本和探测状态完整恢复，过期租约被释放\",\n 394→      \"levels\": [\n 395→        \"e2e\",\n 396→        \"integration\"\n 397→      ]\n 398→    },\n 399→    {\n 400→      \"id\": \"AC-053\",\n 401→      \"text\": \"check-docs 执行 README 和 docs 中标为可运行的命令（针对夹具配置），全部成功；README 的请求示例里不再有会被忽略的字段\",\n 402→      \"levels\": [\n 403→        \"integration\"\n 404→      ]\n 405→    },\n 406→    {\n 407→      \"id\": \"AC-054\",\n 408→      \"text\": \"docs/agentline-integration.md 只描述 level/count/usage/importance、按顺序调用 calls[]、再申请、错误码和流程状态；检查脚本确认其中没有 provider、价格或额度字段名\",\n 409→      \"levels\": [\n 410→        \"unit\"\n 411→      ]\n 412→    },\n 413→    {\n 414→      \"id\": \"AC-055\",\n 415→      \"text\": \"发布前在真机上设置 CLIWORKER_SMOKE=1 运行 smoke-real，依次执行发现、枚举、白名单模型探测、选模、用 run 跑一个极小的提示，并生成报告；每一步为 pass 或带原因的 skip，任何 fail 都阻断发布；报告经过脱敏\",\n 416→      \"levels\": [\n 417→        \"smoke\"\n 418→      ]\n 419→    }\n 420→  ],\n 421→  \"tasks\": [\n 422→    {\n 423→      \"id\": \"T-001\",\n 424→      \"title\": \"测试运行器与快速检查基线（A3）\",\n 425→      \"inputs\": [\n 426→        \"package.json\",\n 427→        \"test/select.test.mjs\",\n 428→        \"缺陷 A3\"\n 429→      ],\n 430→      \"outputs\": [\n 431→        \"package.json scripts（test、test:unit、test:contract、check）\",\n 432→        \"scripts/run-tests.mjs（枚举文件后调用 node --test）\",\n 433→        \"scripts/check-test-discovery.mjs\",\n 434→        \"scripts/check-fast.ps1\",\n 435→        \"test/unit/select.test.mjs（从原位置迁移）\"\n 436→      ],\n 437→      \"depends_on\": [],\n 438→      \"write_scope\": [\n 439→        \"package.json\",\n 440→        \"scripts/run-tests.mjs\",\n 441→        \"scripts/check-test-discovery.mjs\",\n 442→        \"scripts/check-fast.ps1\",\n 443→        \"test/select.test.mjs\",\n 444→        \"test/unit/select.test.mjs\"\n 445→      ],\n 446→      \"acceptance\": [\n 447→        \"AC-001\",\n 448→        \"AC-002\"\n 449→      ],\n 450→      \"acceptance_direction\": [\n 451→        \"npm test\",\n 452→        \"node scripts/check-test-discovery.mjs\",\n 453→        \"pwsh -NoProfile -File scripts/check-fast.ps1\"\n 454→      ],\n 455→      \"test_levels\": [\n 456→        \"unit\"\n 457→      ],\n 458→      \"milestone\": \"M1\"\n 459→    },\n 460→    {\n 461→      \"id\": \"T-002\",\n 462→      \"title\": \"打包清单与 bin 入口修复（A2）\",\n 463→      \"inputs\": [\n 464→        \"package.json\",\n 465→        \"dsh.plugin.json\",\n 466→        \"缺陷 A2\"\n 467→      ],\n 468→      \"outputs\": [\n 469→        \"package.json 中的 bin.cliworker 与 files（bin、lib、config/cliworker.example.json、ui、contracts、cordis.patch.yml、dsh.plugin.json、README.md）\",\n 470→        \"scripts/check-pack.mjs\"\n 471→      ],\n 472→      \"depends_on\": [\n 473→        \"T-001\"\n 474→      ],\n 475→      \"write_scope\": [\n 476→        \"package.json\",\n 477→        \"dsh.plugin.json\",\n 478→        \"scripts/check-pack.mjs\"\n 479→      ],\n 480→      \"acceptance\": [\n 481→        \"AC-003\"\n 482→      ],\n 483→      \"acceptance_direction\": [\n 484→        \"node scripts/check-pack.mjs\"\n 485→      ],\n 486→      \"test_levels\": [\n 487→        \"integration\"\n 488→      ],\n 489→      \"milestone\": \"M1\"\n 490→    },\n 491→    {\n 492→      \"id\": \"T-003\",\n 493→      \"title\": \"配置加载健壮性与 state_dir 跟随配置（A4、null 配置）\",\n 494→      \"inputs\": [\n 495→        \"lib/config.mjs\",\n 496→        \"lib/cli.mjs 中的 usageFile\",\n 497→        \"缺陷 A4\",\n 498→        \"缺陷 A5 中的 null 配置\"\n 499→      ],\n 500→      \"outputs\": [\n 501→        \"lib/paths.mjs（resolveStateDir、paths）\",\n 502→        \"lib/config.mjs（E_CONFIG 可读错误、_example 检测）\",\n 503→        \"修正后的 .gitignore\",\n 504→        \"带 _example 标记的 config/cliworker.example.json\"\n 505→      ],\n 506→      \"depends_on\": [\n 507→        \"T-001\"\n 508→      ],\n 509→      \"write_scope\": [\n 510→        \"lib/config.mjs\",\n 511→        \"lib/paths.mjs\",\n 512→        \".gitignore\",\n 513→        \"config/cliworker.example.json\",\n 514→        \"test/unit/config.test.mjs\",\n 515→        \"test/unit/gitignore.test.mjs\"\n 516→      ],\n 517→      \"acceptance\": [\n 518→        \"AC-004\",\n 519→        \"AC-005\",\n 520→        \"AC-006\"\n 521→      ],\n 522→      \"acceptance_direction\": [\n 523→        \"node --test test/unit/config.test.mjs\",\n 524→        \"node --test test/unit/gitignore.test.mjs\"\n 525→      ],\n 526→      \"test_levels\": [\n 527→        \"integration\",\n 528→        \"unit\"\n 529→      ],\n 530→      \"milestone\": \"M1\"\n 531→    },\n 532→    {\n 533→      \"id\": \"T-004\",\n 534→      \"title\": \"额度形状归一与预测修复（A1）\",\n 535→      \"inputs\": [\n 536→        \"lib/forecast.mjs\",\n 537→        \"config/cliworker.example.json 中的 quotas\",\n 538→        \"缺陷 A1\"\n 539→      ],\n 540→      \"outputs\": [\n 541→        \"lib/quota.mjs（normalizeQuota：把 pct/credits/usd/tokens 统一换算成 Mtok）\",\n 542→        \"lib/forecast.mjs（新增风险计算路径，unknown 保持不变）\"\n 543→      ],\n 544→      \"depends_on\": [\n 545→        \"T-001\"\n 546→      ],\n 547→      \"write_scope\": [\n 548→        \"lib/forecast.mjs\",\n 549→        \"lib/quota.mjs\",\n 550→        \"test/unit/forecast.test.mjs\"\n 551→      ],\n 552→      \"acceptance\": [\n 553→        \"AC-007\",\n 554→        \"AC-008\"\n 555→      ],\n 556→      \"acceptance_direction\": [\n 557→        \"node --test test/unit/forecast.test.mjs\"\n 558→      ],\n 559→      \"test_levels\": [\n 560→        \"unit\"\n 561→      ],\n 562→      \"milestone\": \"M1\"\n 563→    },\n 564→    {\n 565→      \"id\": \"T-005\",\n 566→      \"title\": \"CLI 命令路由、统一 JSON 错误与 A5 清理\",\n 567→      \"inputs\": [\n 568→        \"lib/cli.mjs\",\n 569→        \"lib/select.mjs\",\n 570→        \"README.md\",\n 571→        \"缺陷 A5\"\n 572→      ],\n 573→      \"outputs\": [\n 574→        \"lib/cli.mjs（按命令名动态加载 lib/commands/<cmd>/<sub>.mjs）\",\n 575→        \"lib/commands/**（迁移现有命令）\",\n 576→        \"lib/contract/errors.mjs（初版错误码与退出码）\",\n 577→        \"lib/select.mjs（forecast 每模型只算一次、去掉重复 cli、清理未使用代码）\",\n 578→        \"scripts/check-unused.mjs\",\n 579→        \"修正后的 README 请求示例\"\n 580→      ],\n 581→      \"depends_on\": [\n 582→        \"T-003\",\n 583→        \"T-004\"\n 584→      ],\n 585→      \"write_scope\": [\n 586→        \"lib/cli.mjs\",\n 587→        \"lib/commands/**\",\n 588→        \"lib/contract/errors.mjs\",\n 589→        \"lib/select.mjs\",\n 590→        \"scripts/check-unused.mjs\",\n 591→        \"README.md\",\n 592→        \"test/unit/cli.test.mjs\",\n 593→        \"test/unit/select-hygiene.test.mjs\"\n 594→      ],\n 595→      \"acceptance\": [\n 596→        \"AC-009\",\n 597→        \"AC-010\"\n 598→      ],\n 599→      \"acceptance_direction\": [\n 600→        \"node --test test/unit/cli.test.mjs test/unit/select-hygiene.test.mjs\",\n 601→        \"node scripts/check-unused.mjs\"\n 602→      ],\n 603→      \"test_levels\": [\n 604→        \"integration\",\n 605→        \"unit\"\n 606→      ],\n 607→      \"milestone\": \"M1\"\n 608→    },\n 609→    {\n 610→      \"id\": \"T-006\",\n 611→      \"title\": \"ModelRequest/Selection/Handle/Event v1 契约定稿与校验器\",\n 612→      \"inputs\": [\n 613→        \"lib/contract/errors.mjs\",\n 614→        \"第 3 节边界设计\",\n 615→        \"interfaces 第 1 到 5 节\"\n 616→      ],\n 617→      \"outputs\": [\n 618→        \"lib/contract/**（schema 常量、零依赖校验器、错误码注册表、draft 兼容映射、视图裁剪 projectAgentlineView）\",\n 619→        \"contracts/examples/*.json\",\n 620→        \"contracts/error-codes.snapshot.json\",\n 621→        \"docs/contract.md\"\n 622→      ],\n 623→      \"depends_on\": [\n 624→        \"T-005\"\n 625→      ],\n 626→      \"write_scope\": [\n 627→      