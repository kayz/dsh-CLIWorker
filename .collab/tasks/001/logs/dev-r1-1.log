cordSkip:\n```js\nexport function recordSkip({ test: name, file, ac, requires, reason }) {\n  const dir = process.env.CLIWORKER_RESULTS_DIR\n  if (!dir) return false\n  const record = {\n    schema: 'cliworker.skip/v1',\n    test: name,\n    file,\n    ac: ac ?? null,\n    requires,\n    platform: process.platform,\n    node: process.version,\n    reason,\n    at: new Date().toISOString(),\n  }\n  fs.mkdirSync(dir, { recursive: true })\n  fs.appendFileSync(path.join(dir, 'skips.jsonl'), `${JSON.stringify(record)}\\n`)\n  return true\n}\n```\n\nplatformTest:\n```js\nexport function platformTest(name, options, fn) {\n  const { ac = null, requires, file, reason } = options ?? {}\n  test(name, (t) => {\n    if (satisfies(requires)) return fn(t)\n    const why = reason ?? `requires ${requires} not satisfied on ${process.platform}`\n    recordSkip({ test: name, file: relativeFile(file), ac, requires, reason: why })\n    t.skip(why)\n  })\n}\n```\nrelativeFile: convert file URL to repo-relative posix. root = process.env.CLIWORKER_ROOT ? resolve : process.cwd(). If file is a URL string → fileURLToPath.\n\nNote: `fn` may be sync; return value fine.\n\nCareful: `test()` returns a promise; node:test handles.\n\nAlso design: \"该文件在 test/helpers/ 下，不会被当作测试执行\". ✓\n\nA1-13 requires these 4 literals present. ✓\n\nNow write.","signature":""}],"model":"deepseek-v4.1-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":null,"cache_read_input_tokens":null,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b64c02387d24acacbd4a13028c46","_messageId":"01a1b64f8cc77558a8e18f089b84d876","_meta":{"codebuddy.ai/conversationRequestId":"01a1b64c02387d24acacbd4a13028c46","codebuddy.ai/modelRequestId":"01a1b64f8cc77558a8e18f089b84d876","codebuddy.ai/llmMessageId":"01a1b64f8cc77558a8e18f089b84d876","codebuddy.ai/messageId":"01a1b64f-8c