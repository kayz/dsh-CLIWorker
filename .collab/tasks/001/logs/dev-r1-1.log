d}`)\n  lines.push('      - uses: actions/upload-artifact@v4')\n  lines.push('        if: always()')\n  lines.push('        with:')\n  lines.push('          name: test-results-${{ matrix.name }}-node${{ matrix.node }}')\n  lines.push('          path: |')\n  for (const artifact of matrix.artifacts) {\n    lines.push(`            ${resultsDir}/${artifact}`)\n  }\n  lines.push('          if-no-files-found: warn')\n  lines.push('  perf:')\n  lines.push(`    runs-on: ${matrix.perf.runs_on}`)\n  lines.push('    continue-on-error: true')\n  lines.push('    steps:')\n  lines.push('      - uses: actions/checkout@v4')\n  lines.push('      - uses: actions/setup-node@v4')\n  lines.push('        with:')\n  lines.push(`          node-version: ${matrix.perf.node}`)\n  lines.push('      - run: npm ci')\n  lines.push(`      - run: ${matrix.perf.command}`)\n\n  return `${lines.join('\\n')}\\n`\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n  let toStdout = false\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--stdout') {\n      toStdout = true\n    } else if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else {\n      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/gen-ci.mjs [--root <dir>] [--stdout]\\n`)\n      process.exitCode = 2\n      return\n    }\n  }\n\n  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  let matrix\n  try {\n    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  } catch {\n    process.stderr.write(`gen-ci: cannot read ${matrixFile}\\n`)\n    process.exitCode = 2\n    return\n  }\n\n  const text = renderCi(matrix)\n  if (toStdout) {\n    process.stdout.write(text)\n    return\n  }\n\n  const ta