{"type":"user","uuid":"01a1b654-5934-797e-a621-775f797e14dc","session_id":"01a1b64b-fe4d-73dd-9fb2-26f680d0b3a8","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_JWzY0L0BRaELxCQogF8Y2885","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Traceability: validates contracts/spec/ac-index.json and merges test/traceability/*.json.\n   3→// Exported helpers are reused by milestone-gate.mjs and check-defects.mjs.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const REPO_ROOT = path.resolve(HERE, '..')\n  10→\n  11→const SCHEMA = 'cliworker.ac-index/v1'\n  12→const INDEX_KEYS = ['ac', 'owner', 'milestone', 'levels', 'baseline']\n  13→const LEVELS = ['unit', 'integration', 'contract', 'e2e', 'smoke']\n  14→const BASELINES = ['linux', 'win32', 'darwin', 'real-smoke']\n  15→const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\n  16→const NON_SMOKE_LEVELS = ['unit', 'contract', 'integration', 'e2e']\n  17→\n  18→const TITLE_RE = /(?<![\\w.])(test|it|describe|platformTest)(\\.(skip|todo|only))?\\s*\\(\\s*(['\"`])((?:\\\\.|(?!\\4).)*)\\4/g\n  19→\n  20→export function extractTitles(source) {\n  21→  const titles = []\n  22→  const text = String(source ?? '')\n  23→  for (const match of text.matchAll(TITLE_RE)) {\n  24→    titles.push({ kind: match[3] ? match[3] : 'plain', title: match[5] })\n  25→  }\n  26→  return titles\n  27→}\n  28→\n  29→function expectedAcs() {\n  30→  const list = []\n  31→  for (let i = 1; i <= 74; i += 1) list.push(`AC-${String(i).padStart(3, '0')}`)\n  32→  return list\n  33→}\n  34→\n  35→function isStringArray(value) {\n  36→  return Array.isArray(value) && value.every((item) => typeof item === 'string')\n  37→}\n  38→\n  39→export function validateIndex(index) {\n  40→  const errors = []\n  41→  const push = (id, ac, detail) => errors.push({ id, ac, detail })\n  42→\n  43→  if (!index || typeof index !== 'object' || Array.isArray(index)) {\n  44→    push('index.schema', undefined, 'index must be a JSON object')\n  45→    return errors\n  46→  }\n  47→  if (index.schema !== SCHEMA) push('index.schema', undefined, `schema must be ${SCHEMA}`)\n  48→\n  49→  if (!Array.isArray(index.acs)) {\n  50→    push('index.schema', undefined, 'acs must be an array')\n  51→    return errors\n  52→  }\n  53→\n  54→  for (const entry of index.acs) {\n  55→    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n  56→      push('index.schema', undefined, 'every entry must be a JSON object')\n  57→      continue\n  58→    }\n  59→    const keys = Object.keys(entry)\n  60→    const missing = INDEX_KEYS.filter((key) => !keys.includes(key))\n  61→    const extra = keys.filter((key) => !INDEX_KEYS.includes(key))\n  62→    if (missing.length > 0 || extra.length > 0) {\n  63→      push(\n  64→        'index.schema',\n  65→        typeof entry.ac === 'string' ? entry.ac : undefined,\n  66→        `entry keys must be exactly ${INDEX_KEYS.join(',')} (missing=${missing.join('|') || '-'} extra=${extra.join('|') || '-'})`\n  67→      )\n  68→    }\n  69→\n  70→    if (typeof entry.owner !== 'string' || !/^T-\\d{3}$/.test(entry.owner)) {\n  71→      push('index.owner', entry.ac, 'owner must match ^T-\\\\d{3}$')\n  72→    }\n  73→    if (!MILESTONES.includes(entry.milestone)) {\n  74→      push('index.milestone', entry.ac, `milestone must be one of ${MILESTONES.join(',')}`)\n  75→    }\n  76→\n  77→    if (!isStringArray(entry.levels) || entry.levels.length === 0) {\n  78→      push('index.levels', entry.ac, 'levels must be a non-empty array of strings')\n  79→    } else {\n  80→      const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\n  81→      const duplicates = entry.levels.filter((level, i) => entry.levels.indexOf(level) !== i)\n  82→      if (unknown.length > 0) push('index.levels', entry.ac, `unknown level(s): ${unknown.join(',')}`)\n  83→      if (duplicates.length > 0) push('index.levels', entry.ac, `duplicate level(s): ${duplicates.join(',')}`)\n  84→    }\n  85→\n  86→    if (!isStringArray(entry.baseline) || entry.baseline.length === 0) {\n  87→      push('index.baseline', entry.ac, 'baseline must be a non-empty array of strings')\n  88→    } else {\n  89→      const unknown = entry.baseline.filter((base) => !BASELINES.includes(base))\n  90→      const duplicates = entry.baseline.filter((base, i) => entry.baseline.indexOf(base) !== i)\n  91→      if (unknown.length > 0) push('index.baseline', entry.ac, `unknown baseline(s): ${unknown.join(',')}`)\n  92→      if (duplicates.length > 0) push('index.baseline', entry.ac, `duplicate baseline(s): ${duplicates.join(',')}`)\n  93→    }\n  94→\n  95→    if (isStringArray(entry.levels) && isStringArray(entry.baseline)) {\n  96→      const hasCodeLevel = entry.levels.some((level) => NON_SMOKE_LEVELS.includes(level))\n  97→      const hasSmoke = entry.levels.includes('smoke')\n  98→      const hasRealSmoke = entry.baseline.includes('real-smoke')\n  99→      const hasNativeOnly = entry.baseline.includes('win32') || entry.baseline.includes('darwin')\n 100→      if (hasCodeLevel && hasRealSmoke) {\n 101→        push('index.baseline_incompatible', entry.ac, 'real-smoke baseline cannot back code levels')\n 102→      }\n 103→      if (hasSmoke && hasNativeOnly) {\n 104→        push('index.baseline_incompatible', entry.ac, 'smoke levels only allow linux or real-smoke baselines')\n 105→      }\n 106→    }\n 107→  }\n 108→\n 109→  const expected = expectedAcs()\n 110→  const got = index.acs.map((entry) => (entry && typeof entry === 'object' ? entry.ac : undefined))\n 111→  const inOrder = got.length === expected.length && got.every((ac, i) => ac === expected[i])\n 112→  if (!inOrder) {\n 113→    const seen = new Set()\n 114→    const duplicates = new Set()\n 115→    for (const ac of got) {\n 116→      if (seen.has(ac)) duplicates.add(ac)\n 117→      seen.add(ac)\n 118→    }\n 119→    const parts = [`expected exactly ${expected[0]}..${expected[expected.length - 1]} in order`]\n 120→    parts.push(`got ${got.length} entries`)\n 121→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b64c02387d24acacbd4a13028c46","_messageId":"01a1b654288a7bc48052cb31f185c08f","_meta":{"codebuddy.ai/conversationRequestId":"01a1b64c02387d24acacbd4a13028c46","codebuddy.ai/modelRequestId":"01a1b654288a7bc48052cb31f185c08f","codebuddy.ai/llmMessageId":"01a1b654288a7bc48052cb31f185c08f","traceparent":"00-1491732b1efa8226a936b146e12cfead-98331ebc19389995-01","baggage":"codebuddy.session_id=01a1b64b-fe4d-73dd-9fb2-26f680d0b3a8,codebuddy.conversation_request_id=01a1b64c02387d24acacbd4a13028c46"},"__timestamp":"2026-11-07T14:05:43.605Z"}
