{"type":"user","uuid":"01a1b65e-f78d-7d34-bac0-111e5a548e1a","session_id":"01a1b65d-b1c4-7fc0-a14a-b22b3e77b836","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_SX6ejArpu2OlyiNmVb040966","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Generates .github/workflows/ci.yml from scripts/ci-matrix.json. There is no YAML dependency:\n   3→// renderCi is a pure, deterministic string builder so check-ci can compare byte for byte.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const REPO_ROOT = path.resolve(HERE, '..')\n  10→const HEADER = '# generated by scripts/gen-ci.mjs from scripts/ci-matrix.json - do not edit'\n  11→const WORKFLOW_PATH = path.join('.github', 'workflows', 'ci.yml')\n  12→\n  13→export function renderCi(matrix) {\n  14→  const resultsDir = matrix.results_dir\n  15→  const lines = []\n  16→\n  17→  lines.push(HEADER)\n  18→  lines.push('name: ci')\n  19→  lines.push('on: [push, pull_request]')\n  20→  lines.push('permissions:')\n  21→  lines.push('  contents: read')\n  22→  lines.push('jobs:')\n  23→  lines.push('  check:')\n  24→  lines.push('    strategy:')\n  25→  lines.push('      fail-fast: false')\n  26→  lines.push('      matrix:')\n  27→  lines.push('        include:')\n  28→  for (const os of matrix.os) {\n  29→    for (const node of matrix.node) {\n  30→      lines.push(`          - name: ${os.name}`)\n  31→      lines.push(`            runs_on: ${os.runs_on}`)\n  32→      lines.push(`            node: ${node}`)\n  33→    }\n  34→  }\n  35→  lines.push('    runs-on: ${{ matrix.runs_on }}')\n  36→  lines.push('    env:')\n  37→  lines.push(`      CLIWORKER_RESULTS_DIR: \\${{ github.workspace }}/${resultsDir}`)\n  38→  lines.push('    steps:')\n  39→  lines.push('      - uses: actions/checkout@v4')\n  40→  lines.push('      - uses: actions/setup-node@v4')\n  41→  lines.push('        with:')\n  42→  lines.push('          node-version: ${{ matrix.node }}')\n  43→  lines.push('      - run: npm ci')\n  44→  lines.push(`      - run: ${matrix.check_command}`)\n  45→  lines.push('      - uses: actions/upload-artifact@v4')\n  46→  lines.push('        if: always()')\n  47→  lines.push('        with:')\n  48→  lines.push('          name: test-results-${{ matrix.name }}-node${{ matrix.node }}')\n  49→  lines.push('          path: |')\n  50→  for (const artifact of matrix.artifacts) {\n  51→    lines.push(`            ${resultsDir}/${artifact}`)\n  52→  }\n  53→  lines.push('          if-no-files-found: warn')\n  54→  lines.push('  perf:')\n  55→  lines.push(`    runs-on: ${matrix.perf.runs_on}`)\n  56→  lines.push('    continue-on-error: true')\n  57→  lines.push('    steps:')\n  58→  lines.push('      - uses: actions/checkout@v4')\n  59→  lines.push('      - uses: actions/setup-node@v4')\n  60→  lines.push('        with:')\n  61→  lines.push(`          node-version: ${matrix.perf.node}`)\n  62→  lines.push('      - run: npm ci')\n  63→  lines.push(`      - run: ${matrix.perf.command}`)\n  64→\n  65→  return `${lines.join('\\n')}\\n`\n  66→}\n  67→\n  68→function main() {\n  69→  const args = process.argv.slice(2)\n  70→  let root = REPO_ROOT\n  71→  let toStdout = false\n  72→\n  73→  for (let i = 0; i < args.length; i += 1) {\n  74→    const flag = args[i]\n  75→    if (flag === '--stdout') {\n  76→      toStdout = true\n  77→    } else if (flag === '--root') {\n  78→      const value = args[i + 1]\n  79→      if (typeof value !== 'string' || value === '') {\n  80→        process.stderr.write('--root requires a directory\\n')\n  81→        process.exitCode = 2\n  82→        return\n  83→      }\n  84→      root = path.resolve(value)\n  85→      i += 1\n  86→    } else {\n  87→      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/gen-ci.mjs [--root <dir>] [--stdout]\\n`)\n  88→      process.exitCode = 2\n  89→      return\n  90→    }\n  91→  }\n  92→\n  93→  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  94→  let matrix\n  95→  try {\n  96→    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  97→  } catch {\n  98→    process.stderr.write(`gen-ci: cannot read ${matrixFile}\\n`)\n  99→    process.exitCode = 2\n 100→    return\n 101→  }\n 102→\n 103→  const text = renderCi(matrix)\n 104→  if (toStdout) {\n 105→    process.stdout.write(text)\n 106→    return\n 107→  }\n 108→\n 109→  const target = path.join(root, WORKFLOW_PATH)\n 110→  fs.mkdirSync(path.dirname(target), { recursive: true })\n 111→  fs.writeFileSync(target, text)\n 112→  process.stdout.write(`gen-ci: wrote ${WORKFLOW_PATH.split(path.sep).join('/')}\\n`)\n 113→}\n 114→\n 115→const invokedDirectly =\n 116→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 117→\n 118→if (invokedDirectly) main()\n 119→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b65db5727ea58fa7ee2be908c6eb","_messageId":"01a1b65ee9fc726ab84f7ae8a0121c34","_meta":{"codebuddy.ai/conversationRequestId":"01a1b65db5727ea58fa7ee2be908c6eb","codebuddy.ai/modelRequestId":"01a1b65ee9fc726ab84f7ae8a0121c34","codebuddy.ai/llmMessageId":"01a1b65ee9fc726ab84f7ae8a0121c34","traceparent":"00-15ffef3552dd5d8b26c254c367358e26-0dddb10982c6d8a7-01","baggage":"codebuddy.session_id=01a1b65d-b1c4-7fc0-a14a-b22b3e77b836,codebuddy.conversation_request_id=01a1b65db5727ea58fa7ee2be908c6eb"},"__timestamp":"2026-11-07T14:17:19.501Z"}
