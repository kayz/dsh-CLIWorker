{"type":"user","uuid":"01a1b654-73c3-73ff-b279-0aa961a7676f","session_id":"01a1b64b-fe4d-73dd-9fb2-26f680d0b3a8","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_cVSQSF2fUifwApnka8C34066","content":[{"type":"text","text":" 270→      }\n 271→      if (!tagged) {\n 272→        errors.push({\n 273→          id: 'shard.missing_title',\n 274→          ac,\n 275→          file: rel,\n 276→          detail: `no plain test title contains [${ac}]`,\n 277→        })\n 278→      }\n 279→    }\n 280→  }\n 281→\n 282→  const acs = {}\n 283→  for (const ac of indexAcs) {\n 284→    const entry = declared.get(ac)\n 285→    acs[ac] = entry ? entry.status : 'planned'\n 286→  }\n 287→\n 288→  return { errors, acs }\n 289→}\n 290→\n 291→function checkTaskGraph(taskGraphPath, index) {\n 292→  const errors = []\n 293→  let graph\n 294→  try {\n 295→    graph = JSON.parse(fs.readFileSync(taskGraphPath, 'utf8'))\n 296→  } catch {\n 297→    errors.push({ id: 'graph.mismatch', detail: `cannot read task graph: ${taskGraphPath}` })\n 298→    return errors\n 299→  }\n 300→\n 301→  const owners = new Map()\n 302→  const milestones = new Map()\n 303→  for (const task of Array.isArray(graph.tasks) ? graph.tasks : []) {\n 304→    for (const ac of Array.isArray(task.acceptance) ? task.acceptance : []) {\n 305→      owners.set(ac, task.id)\n 306→      milestones.set(ac, task.milestone)\n 307→    }\n 308→  }\n 309→  const levels = new Map()\n 310→  for (const item of Array.isArray(graph.acceptance) ? graph.acceptance : []) {\n 311→    if (item && typeof item.id === 'string') levels.set(item.id, item.levels)\n 312→  }\n 313→\n 314→  const sameSet = (a, b) => {\n 315→    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false\n 316→    const left = [...a].sort()\n 317→    const right = [...b].sort()\n 318→    return left.every((value, i) => value === right[i])\n 319→  }\n 320→\n 321→  for (const entry of index?.acs ?? []) {\n 322→    if (!entry || typeof entry !== 'object') continue\n 323→    if (owners.get(entry.ac) !== entry.owner) {\n 324→      errors.push({\n 325→        id: 'graph.mismatch',\n 326→        ac: entry.ac,\n 327→        detail: `owner ${entry.owner} != task graph ${owners.get(entry.ac) ?? 'none'}`,\n 328→      })\n 329→    }\n 330→    if (milestones.get(entry.ac) !== entry.milestone) {\n 331→      errors.push({\n 332→        id: 'graph.mismatch',\n 333→        ac: entry.ac,\n 334→        detail: `milestone ${entry.milestone} != task graph ${milestones.get(entry.ac) ?? 'none'}`,\n 335→      })\n 336→    }\n 337→    if (levels.has(entry.ac) && !sameSet(levels.get(entry.ac), entry.levels)) {\n 338→      errors.push({\n 339→        id: 'graph.mismatch',\n 340→        ac: entry.ac,\n 341→        detail: `levels ${JSON.stringify(entry.levels)} != task graph ${JSON.stringify(levels.get(entry.ac))}`,\n 342→      })\n 343→    }\n 344→  }\n 345→\n 346→  return errors\n 347→}\n 348→\n 349→function fail(message) {\n 350→  console.error(message)\n 351→  process.exitCode = 2\n 352→}\n 353→\n 354→function takeValue(args, index, flag) {\n 355→  const value = args[index + 1]\n 356→  if (typeof value !== 'string' || value === '') {\n 357→    fail(`${flag} requires a value`)\n 358→    return null\n 359→  }\n 360→  return value\n 361→}\n 362→\n 363→function main() {\n 364→  const args = process.argv.slice(2)\n 365→  let root = REPO_ROOT\n 366→  let indexPath = null\n 367→  let taskGraphPath = null\n 368→  let json = false\n 369→\n 370→  for (let i = 0; i < args.length; i += 1) {\n 371→    const flag = args[i]\n 372→    if (flag === '--root') {\n 373→      const value = takeValue(args, i, flag)\n 374→      if (value === null) return\n 375→      root = path.resolve(value)\n 376→      i += 1\n 377→    } else if (flag === '--index') {\n 378→      const value = takeValue(args, i, flag)\n 379→      if (value === null) return\n 380→      indexPath = path.resolve(value)\n 381→      i += 1\n 382→    } else if (flag === '--task-graph') {\n 383→      const value = takeValue(args, i, flag)\n 384→      if (value === null) return\n 385→      taskGraphPath = path.resolve(value)\n 386→      i += 1\n 387→    } else if (flag === '--json') {\n 388→      json = true\n 389→    } else {\n 390→      fail(`unknown argument: ${flag}\\nusage: node scripts/check-traceability.mjs [--root <dir>] [--index <file>] [--task-graph <file>] [--json]`)\n 391→      return\n 392→    }\n 393→  }\n 394→\n 395→  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n 396→  const errors = []\n 397→\n 398→  let index = null\n 399→  try {\n 400→    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n 401→  } catch {\n 402→    errors.push({ id: 'index.schema', detail: `cannot read index: ${indexFile}` })\n 403→  }\n 404→\n 405→  let acs = {}\n 406→  if (index) {\n 407→    errors.push(...validateIndex(index))\n 408→    const merged = mergeShards({ root, index })\n 409→    errors.push(...merged.errors)\n 410→    acs = merged.acs\n 411→  }\n 412→  if (taskGraphPath && index) errors.push(...checkTaskGraph(taskGraphPath, index))\n 413→\n 414→  const entries = Object.keys(acs)\n 415→    .sort()\n 416→    .map((ac) => ({ ac, status: acs[ac] }))\n 417→  const covered = entries.filter((item) => item.status === 'covered').length\n 418→  const planned = entries.filter((item) => item.status === 'planned').length\n 419→\n 420→  if (json) {\n 421→    const payload = {\n 422→      ok: errors.length === 0,\n 423→      errors: errors.map((error) => {\n 424→        const out = { id: error.id }\n 425→        if (error.ac !== undefined) out.ac = error.ac\n 426→        if (error.file !== undefined) out.file = error.file\n 427→        out.detail = error.detail ?? ''\n 428→        return out\n 429→      }),\n 430→      covered,\n 431→      planned,\n 432→      acs: entries,\n 433→    }\n 434→    process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`)\n 435→  } else {\n 436→    for (const error of errors) {\n 437→      const where = error.ac ?? error.file ?? '-'\n 438→      process.stdout.write(`FAIL ${error.id} ${where} ${error.detail ?? ''}`.trimEnd() + '\\n')\n 439→    }\n 440→    if (errors.length > 0) {\n 441→      process.stdout.write(`check-traceability: FAILED (${errors.length} errors)\\n`)\n 442→    } else {\n 443→      process.stdout.write(`check-traceability: ok (covered=${covered} planned=${planned})\\n`)\n 444→    }\n 445→  }\n 446→\n 447→  process.exitCode = errors.length > 0 ? 1 : 0\n 448→}\n 449→\n 450→const invokedDirectly =\n 451→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 452→\n 453→if (invokedDirectly) main()\n 454→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b64c02387d24acacbd4a13028c46","_messageId":"01a1b654665e7e91b645f458cc91901b","_meta":{"codebuddy.ai/conversationRequestId":"01a1b64c02387d24acacbd4a13028c46","codebuddy.ai/modelRequestId":"01a1b654665e7e91b645f458cc91901b","codebuddy.ai/llmMessageId":"01a1b654665e7e91b645f458cc91901b","traceparent":"00-1491732b1efa8226a936b146e12cfead-98331ebc19389995-01","baggage":"codebuddy.session_id=01a1b64b-fe4d-73dd-9fb2-26f680d0b3a8,codebuddy.conversation_request_id=01a1b64c02387d24acacbd4a13028c46"},"__timestamp":"2026-11-07T14:05:50.404Z"}
