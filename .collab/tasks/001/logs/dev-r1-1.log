unit|integration|contract|e2e|smoke|characterization|flows)\\//.test(f)))\n})\n\ntest('[fixed] package.json exposes test, check, perf and snapshot:update', () => {\n  const pkg = JSON.parse(fs.readFileSync(path.join(ROOT,'package.json'),'utf8'))\n  assert.deepEqual(Object.keys(pkg.scripts).sort(), ['check','perf','snapshot:update','test'])\n  assert.equal(pkg.scripts.test, 'node scripts/run-tests.mjs')\n  assert.equal(pkg.scripts.check, 'node scripts/check-fast.mjs')\n  assert.equal(pkg.scripts.perf, 'node scripts/run-tests.mjs --perf')\n  assert.equal(pkg.scripts['snapshot:update'], 'node scripts/run-tests.mjs --update-snapshots')\n})\n\ntest('[fixed] the migrated select test is discovered and nothing is orphaned', () => {\n  assert.ok(enumerateTestFiles(ROOT).includes('test/unit/select.test.mjs'))\n  assert.deepEqual(findOrphans(ROOT), [])\n  assert.equal(fs.existsSync(path.join(ROOT,'test','select.test.mjs')), false)\n})\n```\n\nA74-08 checks the file contains '[repro] ' and '[fixed] ' (with trailing space) — `test('[repro] ...')` ✓.\n\nNote: A74-08 runs `node --test test/characterization/defects/a3-runner.test.mjs` directly. Fine.\n\nAlso this file is enumerated in npm test — must pass.\n\nNow write runner-selftest.test.mjs carefully.\n\nOne more consideration: check-ci test in runner-selftest copies ci.yml; the temp root has no other files. check-ci only reads scripts/ci-matrix.json and .github/workflows/ci.yml. ✓\n\nAnother: for the [AC-002] mutation \"删一个 Node 版本\" → matrix.node = [20] → matrix_invalid. Also after mutating matrix we don't restore before the next mutation? I'll build fresh copies each time.\n\nLet me write the test file with a small helper to reset the temp root.\n\nI'll write:\n\n```js\nfunction freshCiRoot() {\n  const dir = tmp()\n  fs.mkdirSync(path.join(dir, 'scripts'), { recursive: true })\n  fs.mkdirSync(path.join(dir, '.github', 'workflows'), { recursive: true })\n  fs.copyFileSync(path.join(ROOT,'scripts','ci-matrix.json'), path.join(