latest\n    continue-on-error: true\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      - run: npm ci\n      - run: npm run perf\n```\n\nUse matrix.check_command for `- run: ${matrix.check_command}`.\n\nNote `on: [push, pull_request]` — A2-03 doesn't check. Fine.\n\ngen-ci main: --stdout, --root.\n\n```js\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT, stdout = false\n  ...\n  const matrixPath = path.join(root, 'scripts', 'ci-matrix.json')\n  const matrix = JSON.parse(fs.readFileSync(matrixPath, 'utf8'))\n  const text = renderCi(matrix)\n  if (stdout) { process.stdout.write(text); return }\n  const target = path.join(root, '.github', 'workflows', 'ci.yml')\n  fs.mkdirSync(path.dirname(target), { recursive: true })\n  fs.writeFileSync(target, text)\n  process.stdout.write(`gen-ci: wrote ${path.relative(process.cwd(), target)}\\n`)\n}\n```\n\ncheck-ci.mjs: import renderCi from './gen-ci.mjs'.\n\nDeep equal helper.\n\nLet me write these.","signature":""}],"model":"deepseek-v4.1-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":null,"cache_read_input_tokens":null,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b64c02387d24acacbd4a13028c46","_messageId":"01a1b6501e6a721f8dd4a46a08cc95f3","_meta":{"codebuddy.ai/conversationRequestId":"01a1b64c02387d24acacbd4a13028c46","codebuddy.ai/modelRequestId":"01a1b6501e6a721f8dd4a46a08cc95f3","codebuddy.ai/llmMessageId":"01a1b6501e6a721f8dd4a46a08cc95f3","codebuddy.ai/messageId":"01a1b650-1e6a-721f-8dd4-a46c87f4ca8d","traceparent":"00-1491732b1efa8226a936b146e12cfead-98331ebc19389995-01","baggage":"codebuddy.session_id=01a1b64b-fe4d-73dd-9fb2-26f680d0b3a8,codebuddy.conversation_request_id=01a1b64c02387d24acacbd4a13028c46"},"__timestamp":"2026-11-07T14: