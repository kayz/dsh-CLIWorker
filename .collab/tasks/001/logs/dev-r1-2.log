h $_ }) }\nCheck 'V-01' (-not $v01) (($v01 | Out-String).Trim())\n\n# V-02\n$v02a = node -p \"const p=require('./package.json'); ['dependencies','devDependencies','optionalDependencies','peerDependencies'].some(k=>k in p)\"\n$v02b = node -p \"JSON.stringify(Object.keys(require('./package-lock.json').packages))\"\nCheck 'V-02' (($v02a.Trim() -eq 'false') -and ($v02b.Trim() -eq '[\"\"]')) \"a=$v02a b=$v02b\"\n\n# V-03\n$v03 = node -p \"JSON.stringify(require('./package.json').scripts)\"\n$exp03 = '{\"test\":\"node scripts/run-tests.mjs\",\"check\":\"node scripts/check-fast.mjs\",\"perf\":\"node scripts/run-tests.mjs --perf\",\"snapshot:update\":\"node scripts/run-tests.mjs --update-snapshots\"}'\nCheck 'V-03' ($v03.Trim() -eq $exp03) $v03\n\n# V-04\n$v04 = git status --porcelain --untracked-files=all | ForEach-Object { $_.Substring(3) } | Where-Object { $_ -match '\\.(mjs|json|ps1|yml|md)$' -and $_ -notmatch '^\\.collab/' -and (Test-Path $_ -PathType Leaf) } | Where-Object { $b = [IO.File]::ReadAllBytes($_); ($b.Length -ge 3 -and $b[0] -eq 0xEF -and $b[1] -eq 0xBB -and $b[2] -eq 0xBF) -or ([Text.Encoding]::UTF8.GetString($b) -match \"`r\") }\nCheck 'V-04' (-not $v04) (($v04 | Out-String).Trim())\n\n# V-05\n$p1 = Test-Path test/select.test.mjs\n$p2 = Test-Path test/unit/select.test.mjs\nnode --test test/unit/select.test.mjs *>$null\nCheck 'V-05' ((-not $p1) -and $p2 -and ($LASTEXITCODE -eq 0)) \"exists=$p1 unit=$p2 exit=$LASTEXITCODE\"\n\n# A1-01\n$o = NewTmp\nnpm test *>$null\n$npmExit = $LASTEXITCODE\n$r = Run scripts/run-tests.mjs --out-dir $o\nCheck 'A1-01' (($npmExit -eq 0) -and ($r.Exit -eq 0) -and ($r.Out -match 'run-tests: full')) \"npm=$npmExit exit=$($r.Exit) match=$($r.Out -match 'run-tests: full')\"\n\n# A1-02\n$a102 = node -p \"const m=require(process.argv[1]); [m.mode, m.filter, m.files.length>0, m.files.includes('test/unit/select.test.mjs'), m.files.includes('test/characterization/defects/a3-runner.test.mjs'), m.files.some(f=>/^test\\/(fixtures|helpers|perf)\\//.test(f)), Object.keys(m).sort().join(',')].join('|')\" \"$o/files-executed.json\"\n$skip = Test-Path \"$o/skips.jsonl\"\nCheck 'A1-02' (($a102.Trim() -eq 'full||true|true|true|false|files,filter,mode,node,platform') -and $skip) \"line=$a102 skip=$skip\"\n\n# A1-03\n$r = Run scripts/run-tests.mjs --ac AC-074 --out-dir $o\n$a103 = node -p \"const m=require(process.argv[1]); [m.mode, m.filter, m.files.join(',')].join('|')\" \"$o/files-executed.json\"\nCheck 'A1-03' (($r.Exit -eq 0) -and ($a103.Trim() -eq 'filtered|AC-074|test/unit/milestone-gate.test.mjs')) \"exit=$($r.Exit) line=$a103\"\n\n# A1-04\n$r = Run scripts/run-tests.mjs --ac foo --out-dir $o\n$e1 = $r.Exit\n$r = Run scripts/run-tests.mjs --ac AC-999 --out-dir $o\nCheck 'A1-04' (($e1 -eq 2) -and ($r.Exit -eq 1) -and ($r.Out -match 'run\\.no_match')) \"e1=$e1 e2=$($r.Exit) match=$($r.Out -match 'run\\.no_match') out=$($r.Out)\"\n\n# A1-05\n$r = Run scripts/run-tests.mjs --root test/fixtures/discovery-selftest/ok --out-dir $o\n$a105 = node -p \"const m=require(process.argv[1]); [m.mode, m.files.join(',')].join('|')\" \"$o/files-executed.json\"\nCheck 'A1-05' (($r.Exit -eq 0) -and ($a105.Trim() -eq 'full|test/flows/c.test.mjs,test/integration/b.test.mjs,test/unit/a.test.mjs')) \"exit=$($r.Exit) line=$a105 out=$($r.Out)\"\n\n# A1-06\n$r = Run scripts/run-tests.mjs --root test/fixtures/discovery-selftest/ok --ac AC-001 --out-dir $o\n$a106 = node -p \"const m=require(process.argv[1]); [m.mode, m.filter, m.files.join(',')].join('|')\" \"$o/files-executed.json\"\nCheck 'A1-06' (($r.Exit -eq 0) -and ($a106.Trim() -eq 'filtered|AC-001|test/unit/a.test.mjs')) \"exit=$($r.Exit) line=$a106\"\n\n# A1-07\n$r = Run scripts/run-tests.mjs --root test/fixtures/discovery-selftest/orphan --out-dir $o\nCheck 'A1-07' (($r.Exit -eq 1) -and ($r.Out -match 'discovery\\.orphan') -and ($r.Out -match 'test/loose\\.test\\.mjs')) \"exit=$($r.Exit) out=$($r.Out)\"\n\n# A1-08\n$r = Run scripts/check-test-discovery.mjs\nCheck 'A1-08' (($r.Exit -eq 0) -and ($r.Out -match 'check-test-discovery: ok')) \"exit=$($r.Exit) out=$($r.Out)\"\n\n# A1-09\n$d = 'test/fixtures/discovery-selftest/drift'\n$lines = @()\nforeach ($c in @(@('manifest-ok.json',0,$null), @('manifest-missing.json',1,'discovery\\.missing'), @('manifest-extra.json',1,'discovery\\.unexpected'), @('manifest-filtered.json',1,'discovery\\.mode_not_full'))) {\n  $r = Run scripts/check-test-discovery.mjs --root $d --manifest \"$d/$($c[0])\"\n  $lines += \"$($c[0]) exit=$($r.Exit) ok=$(($r.Exit -eq $c[1]) -and ($null -eq $c[2] -or $r.Out -match $c[2]))\"\n}\n$exp09 = \"manifest-ok.json exit=0 ok=True`nmanifest-missing.json exit=1 ok=True`nmanifest-extra.json exit=1 ok=True`nmanifest-filtered.json exit=1 ok=True\"\nCheck 'A1-09' (($lines -join \"`n\") -eq $exp09) ($lines -join ' || ')\n\n# A1-10\n$r = Run scripts/run-tests.mjs --ac AC-001 --out-dir $o\n$a110 = node -p \"const m=require(process.argv[1]); m.mode+'|'+m.files.includes('test/unit/runner-selftest.test.mjs')\" \"$o/files-executed.json\"\nCheck 'A1-10' (($r.Exit -eq 0) -and ($a110.Trim() -eq 'filtered|true')) \"exit=$($r.Exit) line=$a110\"\n\n# A1-11\n$env:CLIWORKER_RUN_ACTIVE = '1'; $env:CLIWORKER_RESULTS_DIR = $o\n$r = Run scripts/run-tests.mjs --ac AC-074 --out-dir $o\nRemove-Item Env:CLIWORKER_RUN_ACTIVE, Env:CLIWORKER_RESULTS_DIR\nCheck 'A1-11' ($r.Exit -eq 2) \"exit=$($r.Exit) out=$($r.Out)\"\n\n# A1-12\n$before = Get-ChildItem -Recurse -File -Filter files-executed.json -ErrorAction SilentlyContinue | Select-Object -ExpandProperty FullName\nnpm run perf *>&1 | Out-String | Set-Variable perfOut\n$perfExit = $LASTEXITCODE\n$after = Get-ChildItem -Recurse -File -Filter files-executed.json -ErrorAction SilentlyContinue | Select-Object -ExpandProperty FullName\n$newFiles = Compare-Object $before $after | Where-Object { $_.SideIndicator -eq '=>' }\nCheck 'A1-12' (($perfExit -eq 0) -and ($perfOut -match 'no perf tests') -and (-not $newFiles)) \"exit=$perfExit new=$($newFiles | Out-String) out=$perfOut\"\n\n# A1-13\n$pats = Select-String -Path test/helpers/platform-gate.mjs -SimpleMatch 'cliworker.skip/v1','platformTest','recordSkip','satisfies' | Select-Object -ExpandProperty Pattern -Unique | Sort-Object\nCheck 'A1-13' (($pats -join ',') -eq 'cliworker.skip/v1,platformTest,recordSkip,satisfies') ($pats -join ',')\n\n# A2-01\n$r = Run scripts/check-ci.mjs\nCheck 'A2-01' (($r.Exit -eq 0) -and ($r.Out -match 'check-ci: ok')) \"exit=$($r.Exit) out=$($r.Out)\"\n\n# A2-02\n$a202 = node -p \"const m=require('./scripts/ci-matrix.json'); [m.os.map(o=>o.name).join(','), m.node.join(','), m.check_command, m.artifacts.join(','), m.perf.blocking].join('|')\"\nCheck 'A2-02' ($a202.Trim() -eq 'ubuntu,windows,macos|20,22|npm run check|files-executed.json,skips.jsonl|false') $a202\n\n# A2-03\n$y = '.github/workflows/ci.yml'\n$flags = @()\nforeach ($s in 'continue-on-error: true','npm run check','actions/upload-artifact@v4','ubuntu-latest','windows-latest','macos-latest','files-executed.json','skips.jsonl','CLIWORKER_RESULTS_DIR') {\n  $flags += [bool]((Select-String -Path $y -SimpleMatch $s).Count -ge 1)\n}\n$c1 = (Select-String -Path $y -SimpleMatch 'continue-on-error: true').Count\n$c2 = (Select-String -Path $y -SimpleMatch 'needs:').Count\nCheck 'A2-03' (($flags -notcontains $false) -and ($c1 -eq 1) -and ($c2 -eq 0)) \"flags=$($flags -join ',') c1=$c1 c2=$c2\"\n\n# A2-04\n$t = NewTmp\nNew-Item -ItemType Directory \"$t/scripts\",\"$t/.github/workflows\" | Out-Null\nCopy-Item scripts/ci-matrix.json \"$t/scripts/\"; Copy-Item .github/workflows/ci.yml \"$t/.github/workflows/\"\n$r = Run scripts/check-ci.mjs --root $t; $l1 = \"clean: $($r.Exit)\"\nAdd-Content \"$t/.github/workflows/ci.yml\" '# x'\n$r = Run scripts/check-ci.mjs --root $t; $l2 = \"stale: $($r.Exit) $($r.Out -match 'ci\\.stale')\"\nCopy-Item .github/workflows/ci.yml \"$t/.github/workflows/ci.yml\" -Force\n$m = Get-Content -Raw scripts/ci-matrix.json | ConvertFrom-Json; $m.perf.blocking = $true\n$m | ConvertTo-Json -Depth 8 | Set-Content -Encoding utf8NoBOM \"$t/scripts/ci-matrix.json\"\n$r = Run scripts/check-ci.mjs --root $t; $l3 = \"blocking: $($r.Exit) $($r.Out -match 'ci\\.matrix_invalid')\"\n$m = Get-Content -Raw scripts/ci-matrix.json | ConvertFrom-Json; $m.node = @(20)\n$m | ConvertTo-Json -Depth 8 | Set-Content -Encoding utf8NoBOM \"$t/scripts/ci-matrix.json\"\n$r = Run scripts/check-ci.mjs --root $t; $l4 = \"node: $($r.Exit) $($r.Out -match 'ci\\.matrix_invalid')\"\n$got04 = \"$l1`n$l2`n$l3`n$l4\"\n$exp04 = \"clean: 0`nstale: 1 True`nblocking: 1 True`nnode: 1 True\"\nCheck 'A2-04' ($got04 -eq $exp04) $got04\n\n# A3-01\n$f = NewTmp; $log = Join-Path $f 'log.txt'\nSet-Content -Encoding utf8NoBOM \"$f/check-a.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'a\\n')\"\nSet-Content -Encoding utf8NoBOM \"$f/check-b.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'b\\n'); process.exit(7)\"\nSet-Content -Encoding utf8NoBOM \"$f/check-c.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'c\\n')\"\nSet-Content -Encoding utf8NoBOM \"$f/final.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'final\\n')\"\n$env:CW_LOG = $log; $env:CLIWORKER_TEST_CHECK_DIR = $f; $env:CLIWORKER_TEST_FINAL_SCRIPT = \"$f/final.mjs\"\n$r = Run scripts/check-fast.mjs\n$logBody = (Get-Content $log) -join ','\nCheck 'A3-01' (($r.Exit -eq 7) -and ($r.Out -match 'check-b\\.mjs') -and ($logBody -eq 'a,b')) \"exit=$($r.Exit) log=$logBody out=$($r.Out)\"\n\n# A3-02\n$pwshOut = & pwsh -NoProfile -File scripts/check-fast.ps1 2>&1 | Out-String\n$pwshExit = $LASTEXITCODE\nCheck 'A3-02' (($pwshOut -match 'check-b\\.mjs') -and ($pwshExit -eq 7)) \"exit=$pwshExit out=$pwshOut\"\n\n# A3-03\nRemove-Item $log\nSet-Content -Encoding utf8NoBOM \"$f/check-b.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'b\\n')\"\nSet-Content -Encoding utf8NoBOM \"$f/check-fast.mjs\" \"import fs from 'node:fs'; fs.appendFileSync(process.env.CW_LOG, 'SELF\\n')\"\n$r = Run scripts/check-fast.mjs\n$logBody = (Get-Content $log) -join ','\nCheck 'A3-03' (($r.Exit -eq 0) -and ($logBody -eq 'a,b,c,final')) \"exit=$($r.Exit) log=$logBody out=$($r.Out)\"\n\n# A3-04\nRemove-Item Env:CW_LOG, Env:CLIWORKER_TEST_CHECK_DIR, Env:CLIWORKER_TEST_FINAL_SCRIPT\nCheck 'A3-04' ((-not $env:CW_LOG) -and (-not $env:CLIWORKER_TEST_CHECK_DIR) -and (-not $env:CLIWORKER_TEST_FINAL_SCRIPT)) \"still set\"\n\n# A3-05\n$n1 = (Get-Content scripts/check-fast.ps1 | Where-Object { $_.Trim() -and -not $_.Trim().StartsWith('#') }).Count -le 3\n$n2 = (Select-String -Path scripts/check-fast.ps1 -SimpleMatch '$LASTEXITCODE').Count -ge 1\n$n3 = (Select-String -Path scripts/check-fast.ps1 -SimpleMatch 'check-fast.mjs').Count -ge 1\nCheck 'A3-05' ($n1 -and $n2 -and $n3) \"n1=$n1 n2=$n2 n3=$n3\"\n\n# A3-06\n$fast1 = & pwsh -NoProfile -File scripts/check-fast.ps1 2>&1 | Out-String\n$e1 = $LASTEXITCODE\n$fast2 = & npm run check 2>&1 | Out-String\n$e2 = $LASTEXITCODE\n$need = @('==> check-ci.mjs','==> check-defects.mjs','==> check-test-discovery.mjs','==> check-traceability.mjs','==> npm test','check-fast: ok')\n$missing = @($need | Where-Object { $fast1 -notmatch [regex]::Escape($_) })\n$hasSelf = $fast1 -match '==> check-fast\\.mjs'\nCheck 'A3-06' (($e1 -eq 0) -and ($e2 -eq 0) -and (-not $missing) -and (-not $hasSelf)) \"e1=$e1 e2=$e2 missing=$($missing -join ',') self=$hasSelf tail=$($fast1.Substring([Math]::Max(0,$fast1.Length-400)))\"\n\n# A4-01\n$r = Run scripts/check-traceability.mjs\n$last = ($r.Out -split \"`n\" | Where-Object { $_.Trim() } | Select-Object -Last 1).Trim()\nCheck 'A4-01' (($r.Exit -eq 0) -and ($last -eq 'check-traceability: ok (covered=5 planned=69)')) \"exit=$($r.Exit) last=$last\"\n\n# A4-02\n$r = Run scripts/check-traceability.mjs --task-graph .collab/blueprint/cliworker-v2/task-graph.json\nCheck 'A4-02' (($r.Exit -eq 0) -and (-not ($r.Out -match 'graph\\.mismatch'))) \"exit=$($r.Exit) mismatch=$($r.Out -match 'graph\\.mismatch') out=$($r.Out)\"\n\n# A4-03\n$a403 = node -p \"const a=require('./contracts/spec/ac-index.json').acs; const g=i=>a.find(x=>x.ac===i); [a.length,a[0].ac,a[73].ac,g('AC-001').baseline,g('AC-027').baseline,g('AC-033').baseline,g('AC-038').baseline,g('AC-069').baseline,g('AC-074').owner,g('AC-026').milestone,g('AC-055').milestone,g('AC-072').milestone,g('AC-008').levels,g('AC-038').levels].join('|')\"\nCheck 'A4-03' ($a403.Trim() -eq '74|AC-001|AC-074|darwin,linux,win32|win32|linux|real-smoke|linux|T-001|M2|M4|M1|contract,integration|smoke') $a403\n\n# A4-04\n$a404 = node -p \"const x=require('./contracts/spec/ac-index.json'); [x.schema, Object.keys(x).join(','), Object.keys(x.acs[0]).join(','), new Set(x.acs.map(a=>a.ac)).size].join('|')\"\nCheck 'A4-04' ($a404.Trim() -eq 'cliworker.ac-index/v1|schema,acs|ac,owner,milestone,levels,baseline|74') $a404\n\n# A4-05\n$b = 'test/fixtures/traceability'\n$lines = @()\nforeach ($c in @(@('ok',0,$null), @('duplicate',1,'shard\\.duplicate'), @('not-owner',1,'shard\\.not_owner'), @('missing-file',1,'shard\\.missing_file'), @('missing-title',1,'shard\\.missing_title'), @('baseline-in-shard',1,'shard\\.baseline_forbidden'))) {\n  $r = Run scripts/check-traceability.mjs --root \"$b/$($c[0])\" --index \"$b/ac-index.json\"\n  $lines += \"$($c[0]) exit=$($r.Exit) ok=$(($r.Exit -eq $c[1]) -and ($null -eq $c[2] -or $r.Out -match $c[2]))\"\n}\n$exp05 = \"ok exit=0 ok=True`nduplicate exit=1 ok=True`nnot-owner exit=1 ok=True`nmissing-file exit=1 ok=True`nmissing-title exit=1 ok=True`nbaseline-in-shard exit=1 ok=True\"\nCheck 'A4-05' (($lines -join \"`n\") -eq $exp05) ($lines -join ' || ')\n\n# A4-06\n$r = Run scripts/check-traceability.mjs --root \"$b/duplicate\" --index \"$b/ac-index.json\" --json\n$parsed = $r.Out | ConvertFrom-Json\n$a406 = \"$($parsed.ok)|$(($parsed.errors | ForEach-Object { $_.id } | Sort-Object -Unique) -join ',')\"\nCheck 'A4-06' ($a406 -eq 'False|shard.duplicate,shard.not_owner