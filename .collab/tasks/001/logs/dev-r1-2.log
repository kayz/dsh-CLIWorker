se { Write-Output \"FAIL $name :: $detail\"; $script:fails.Add(\"$name :: $detail\") }\n}\nfunction Run { $out = & node @args 2>&1; [pscustomobject]@{ Exit = $LASTEXITCODE; Out = ($out | Out-String) } }\nfunction NewTmp { $d = Join-Path ([IO.Path]::GetTempPath()) ('cw-acc-' + [guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $d | Out-Null; $d }\n\n# V-01\n$allowed = @('^package\\.json$','^package-lock\\.json$','^scripts/run-tests\\.mjs$','^scripts/reporters/','^scripts/check-test-discovery\\.mjs$','^scripts/check-fast\\.mjs$','^scripts/check-fast\\.ps1$','^scripts/check-traceability\\.mjs$','^scripts/check-ci\\.mjs$','^scripts/gen-ci\\.mjs$','^scripts/ci-matrix\\.json$','^scripts/milestone-gate\\.mjs$','^scripts/check-defects\\.mjs$','^contracts/spec/ac-index\\.json$','^\\.github/workflows/','^test/select\\.test\\.mjs$','^test/unit/select\\.test\\.mjs$','^test/unit/runner-selftest\\.test\\.mjs$','^test/unit/traceability\\.test\\.mjs$','^test/unit/milestone-gate\\.test\\.mjs$','^test/helpers/platform-gate\\.mjs$','^test/fixtures/discovery-selftest/','^test/fixtures/traceability/','^test/fixtures/milestone-gate/','^test/characterization/defects/a3-runner\\.test\\.mjs$','^test/traceability/T-001\\.json$')\n$v01 = git status --porcelain --untracked-files=all | ForEach-Object { $_.Substring(3) -replace ' -> .*','' } | Where-Object { $_ -notmatch '^\\.collab/tasks/001/' } | Where-Object { $p = $_; -not ($allowed | Where-Object { $p -match $_ }) }\nCheck 'V-01' (-not $v01) (($v01 | Out-String).Trim())\n\n# V-02\n$v02a = node -p \"const p=require('./package.json'); ['dependencies','devDependencies','optionalDependencies','peerDependencies'].some(k=>k in p)\"\n$v02b = node -p \"JSON.stringify(Object.keys(require('./package-lock.json').packages))\"\nCheck 'V-02' (($v02a.Trim() -eq 'false') -and ($v02b.Trim() -eq '[\"\"]')) \"a=$v02a b=$v02b\"\n\n# V-03\n$v03 = node -p \"JSON.stringify(require('./package.json').scripts)\"\n$exp03 = '{\"test\":\"node scripts/run-tests.mjs\",\"check\":\"node scripts/check-fast.mjs\",\"perf\":\"node scripts/run-tests.mjs --perf\",\"snapshot:update\":\"node scripts/run-tests.mjs --update-snapshots\"}'\nCheck 'V-03' ($v03.Trim() -eq $exp03) $v03\n\n# V-04\n$v04 = git status --porcelain --untracked-files=all | ForEach-Object { $_.Substring(3) } | Where-Object { $_ -match '\\.(mjs|json|ps1|yml|md)$' -and $_ -notmatch '^\\.collab/' -and (Test-Path $_ -PathType Leaf) } | Where-Object { $b = [IO.File]::ReadAllBytes($_); ($b.Length -ge 3 -and $b[0] -eq 0xEF -and $b[1] -eq 0xBB -and $b[2] -eq 0xBF) -or ([Text.Encoding]::UTF8.GetString($b) -match \"`r\") }\nCheck 'V-04' (-not $v04) (($v04 | Out-String).Trim())\n\n# V-05\n$p1 = Test-Path test/select.test.mjs\n$p2 = Test-Path test/unit/select.test.mjs\nnode --test test/unit/select.test.mjs *>$null\nCheck 'V-05' ((-not $p1) -and $p2 -and ($LASTEXITCODE -eq 0)) \"exists=$p1 unit=$p2 exit=$LASTEXITCODE\"\n\n# A1-01\n$o = NewTmp\nnpm test *>$null\n$npmExit = $LASTEXITCODE\n$r = Run scripts/run-tests.mjs --out-dir $o\nCheck 'A1-01' (($npmExit -eq 0) -and ($r.Exit -eq 0) -and ($r.Out -match 'run-tests: full')) \"npm=$npmExit exit=$($r.Exit) match=$($r.Out -match 'run-tests: full')\"\n\n# A1-02\n$a102 = node -p \"const m=require(process.argv[1]); [m.mode, m.filter, m.files.length>0, m.files.includes('test/unit/select.test.mjs'), m.files.includes('test/characterization/defects/a3-runner.test.mjs'), m.files.some(f=>/^test\\/(fixtures|helpers|perf)\\//.test(f)), Object.keys(m).sort().join(',')].join('|')\" \"$o/files-executed.json\"\n$skip = Test-Path \"$o/skips.jsonl\"\nCheck 'A1-02' (($a102.Trim() -eq 'full||true|true|true|false|files,filter,mode,node,platform') -and $skip) \"line=$a102 skip=$skip\"\n\n# A1-03\n$r = Run scripts/run-tests.mjs --ac AC-074 --out-dir $o\n$a103 = node -p \"const m=require(process.argv[1]); [m.mode, m.filter, m.files.join(',')].join('|')\" \"$o/files-executed.json\"\nCheck 'A1-03' (($r.Exit -eq 0) -and ($a103.Trim() -eq 'filtered|