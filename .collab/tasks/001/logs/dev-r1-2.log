{"type":"tool_call","subtype":"completed","call_id":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-16\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_1","tool_call":{"readToolCall":{"args":{"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/check-defects.mjs"},"result":{"success":{"content":"#!/usr/bin/env node\n// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nimport { mergeShards, extractTitles } from './check-traceability.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\n\nconst MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\nconst EXPECTED_IDS = [\n  'a1-quota',\n  'a2-pack',\n  'a3-runner',\n  'a4-paths',\n  'a4-null-config',\n  'a5-dup-call',\n  'a5-forecast-x3',\n  'a5-unused',\n  'a5-ignored-fields',\n  'a5-shell',\n  'a5-nocache',\n]\n\nconst LEDGER = ['test', 'characterization', 'defects.json']\nconst DEFECTS_DIR = ['test', 'characterization', 'defects']\n\nexport function milestoneRank(value) {\n  const index = MILESTONES.indexOf(value)\n  return index < 0 ? Number.NaN : index + 1\n}\n\nexport function hasFixedSection(source) {\n  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\n}\n\nexport function checkDefects({ root, index, milestone }) {\n  const errors = []\n  const ledgerFile = path.join(root, ...LEDGER)\n\n  if (!fs.existsSync(ledgerFile)) {\n    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\n    return { errors, absent: true }\n  }\n\n  let ledger = null\n  try {\n    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\n  } catch {\n    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\n    return { errors, absent: false }\n  }\n\n  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n  if (!list) {\n    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\n    return { errors, absent: false }\n  }\n\n  const knownAcs = new Set()\n  for (const entry of index?.acs ?? []) {\n    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\n  }\n\n  const seen = new Set()\n  const valid = []\n  for (const item of list) {\n    if (!item || typeof item !== 'object' || Array.isArray(item)) {\n      errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\n      continue\n    }\n    const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\n    const problems = []\n    if (typeof id !== 'string' || id === '') problems.push('id')\n    if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\n    if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\n    if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\n\n    if (problems.length > 0) {\n      errors.push({\n        id: 'defects.schema',\n        detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\n      })\n      continue\n    }\n    if (seen.has(id)) {\n      errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\n      continue\n    }\n    seen.add(id)\n    valid.push({ id, ownerTask, ownerMilestone, ac })\n  }\n\n  if (milestone === 'M5') {\n    const actual = [...seen].sort()\n    const expected = [...EXPECTED_IDS].sort()\n    if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n      errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n    }\n  }\n\n  let required = []\n  if (milestone) {\n    const limit = milestoneRank(milestone)\n    required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\n  } else {\n    const merged = mergeShards({ root, index })\n    required = valid.filter((item) => merged.acs[item.ac] === 'covered')\n  }\n\n  for (const item of required) {\n    const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\n    let source = null\n    try {\n      source = fs.readFileSync(file, 'utf8')\n    } catch {\n      source = null\n    }\n    if (source === null || !hasFixedSection(source)) {\n      errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\n    }\n  }\n\n  return { errors, absent: false }\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n  let indexPath = null\n  let milestone = null\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else if (flag === '--index') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--index requires a file\\n')\n        process.exitCode = 2\n        return\n      }\n      indexPath = path.resolve(value)\n      i += 1\n    } else if (flag === '--milestone') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n        process.exitCode = 2\n        return\n      }\n      milestone = value\n      i += 1\n    } else {\n      process.stderr.write(\n        `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>]\\n`\n      )\n      process.exitCode = 2\n      return\n    }\n  }\n\n  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n  let index = { acs: [] }\n  try {\n    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n  } catch {\n    index = { acs: [] }\n  }\n\n  const { errors, absent } = checkDefects({ root, index, milestone })\n\n  if (absent && !milestone) {\n    process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\n    process.exitCode = 0\n    return\n  }\n\n  if (errors.length === 0) {\n    process.stdout.write('check-defects: ok\\n')\n    process.exitCode = 0\n    return\n  }\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n  process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\n  process.exitCode = 1\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","isEmpty":false,"exceededLimit":false,"totalLines":203,"fileSize":6304,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/check-defects.mjs","readRange":{"startLine":1,"endLine":203},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-16\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_1","startedAtMs":"1794061264706","completedAtMs":"1794061265027"},"model_call_id":"55d2d473-447d-4acc-93b1-e83c9432ad95-3-ufzg","session_id":"4cef3f0d-03ba-4417-bf0e-ce33fbb35a9e","timestamp_ms":1794061272473}
{"type":"tool_call","subtype":"completed","call_id":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-17\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_2","tool_call":{"readToolCall":{"args":{"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/milestone-gate.mjs"},"result":{"success":{"content":"#!/usr/bin/env node\n// Milestone gate: every AC owned by a task up to the requested milestone must be covered,\n// its defects fixed, and its files must actually run in a full test run.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { spawnSync } from 'node:child_process'\nimport { fileURLToPath } from 'node:url'\n\nimport { mergeShards } from './check-traceability.mjs'\nimport { checkDefects, milestoneRank } from './check-defects.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\nconst RUN_TESTS = path.join(HERE, 'run-tests.mjs')\n\nfunction collectCoveredFiles(root) {\n  const map = new Map()\n  const dir = path.join(root, 'test', 'traceability')\n  let names = []\n  try {\n    names = fs.readdirSync(dir).filter((name) => name.endsWith('.json'))\n  } catch {\n    return map\n  }\n  for (const name of names) {\n    let shard = null\n    try {\n      shard = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8'))\n    } catch {\n      continue\n    }\n    for (const entry of Array.isArray(shard?.entries) ? shard.entries : []) {\n      if (!entry || entry.status !== 'covered' || typeof entry.ac !== 'string') continue\n      const files = Array.isArray(entry.files) ? entry.files.filter((file) => typeof file === 'string') : []\n      map.set(entry.ac, files)\n    }\n  }\n  return map\n}\n\nexport function runGate({ root, index, milestone }) {\n  const errors = []\n  const limit = milestoneRank(milestone)\n  const entries = Array.isArray(index?.acs) ? index.acs : []\n\n  const merged = mergeShards({ root, index })\n  for (const error of merged.errors) {\n    const where = error.ac ?? error.file ?? '-'\n    errors.push({ id: 'gate.trace_error', detail: `${where} ${error.detail ?? error.id}`.trim() })\n  }\n\n  for (const entry of entries) {\n    if (!entry || typeof entry !== 'object') continue\n    if (!(milestoneRank(entry.milestone) <= limit)) continue\n    if (merged.acs[entry.ac] !== 'covered') {\n      errors.push({ id: 'gate.ac_not_covered', detail: `${entry.ac} is ${merged.acs[entry.ac] ?? 'planned'}` })\n    }\n  }\n\n  errors.push(...checkDefects({ root, index, milestone }).errors)\n\n  if (errors.length > 0) return errors\n\n  const coveredFiles = collectCoveredFiles(root)\n  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-gate-'))\n  try {\n    const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\n      cwd: root,\n      encoding: 'utf8',\n      maxBuffer: 64 * 1024 * 1024,\n    })\n    if (result.status !== 0) {\n      const tail = (result.stderr || result.stdout || '').trim().split('\\n').slice(-3).join(' | ')\n      errors.push({ id: 'gate.run_failed', detail: `full run exited ${result.status}${tail ? `: ${tail}` : ''}` })\n      return errors\n    }\n\n    let manifest = null\n    try {\n      manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\n    } catch {\n      manifest = null\n    }\n    if (!manifest || manifest.mode !== 'full') {\n      errors.push({ id: 'gate.manifest_not_full', detail: `mode is ${manifest?.mode ?? 'missing'}` })\n    }\n\n    const executed = new Set(Array.isArray(manifest?.files) ? manifest.files : [])\n    for (const entry of entries) {\n      if (!entry || typeof entry !== 'object') continue\n      if (!(milestoneRank(entry.milestone) <= limit)) continue\n      if (merged.acs[entry.ac] !== 'covered') continue\n      for (const file of coveredFiles.get(entry.ac) ?? []) {\n        if (!executed.has(file)) {\n          errors.push({ id: 'gate.file_not_executed', detail: `${file} (${entry.ac})` })\n        }\n      }\n    }\n  } finally {\n    fs.rmSync(outDir, { recursive: true, force: true })\n  }\n\n  return errors\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n  let indexPath = null\n  let milestone = null\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else if (flag === '--index') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--index requires a file\\n')\n        process.exitCode = 2\n        return\n      }\n      indexPath = path.resolve(value)\n      i += 1\n    } else if (flag === '--milestone') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n        process.exitCode = 2\n        return\n      }\n      milestone = value\n      i += 1\n    } else {\n      process.stderr.write(\n        `unknown argument: ${flag}\\nusage: node scripts/milestone-gate.mjs --milestone Mx [--root <dir>] [--index <file>]\\n`\n      )\n      process.exitCode = 2\n      return\n    }\n  }\n\n  if (!milestone) {\n    process.stderr.write('usage: node scripts/milestone-gate.mjs --milestone Mx [--root <dir>] [--index <file>]\\n')\n    process.exitCode = 2\n    return\n  }\n\n  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n  const errors = []\n  let index = null\n  try {\n    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n  } catch {\n    errors.push({ id: 'gate.trace_error', detail: `cannot read index: ${indexFile}` })\n    index = { acs: [] }\n  }\n\n  if (errors.length === 0) errors.push(...runGate({ root, index, milestone }))\n\n  if (errors.length === 0) {\n    process.stdout.write(`milestone-gate ${milestone}: PASS\\n`)\n    process.exitCode = 0\n    return\n  }\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n  process.stdout.write(`milestone-gate ${milestone}: BLOCKED (${errors.length} errors)\\n`)\n  process.exitCode = 1\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","isEmpty":false,"exceededLimit":false,"totalLines":183,"fileSize":6095,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/milestone-gate.mjs","readRange":{"startLine":1,"endLine":183},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-17\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_2","startedAtMs":"1794061264709","completedAtMs":"1794061265034"},"model_call_id":"55d2d473-447d-4acc-93b1-e83c9432ad95-3-ufzg","session_id":"4cef3f0d-03ba-4417-bf0e-ce33fbb35a9e","timestamp_ms":1794061272474}
{"type":"tool_call","subtype":"completed","call_id":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-18\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_3","tool_call":{"readToolCall":{"args":{"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/gen-ci.mjs"},"result":{"success":{"content":"#!/usr/bin/env node\n// Generates .github/workflows/ci.yml from scripts/ci-matrix.json. There is no YAML dependency:\n// renderCi is a pure, deterministic string builder so check-ci can compare byte for byte.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\nconst HEADER = '# generated by scripts/gen-ci.mjs from scripts/ci-matrix.json - do not edit'\nconst WORKFLOW_PATH = path.join('.github', 'workflows', 'ci.yml')\n\nexport function renderCi(matrix) {\n  const resultsDir = matrix.results_dir\n  const lines = []\n\n  lines.push(HEADER)\n  lines.push('name: ci')\n  lines.push('on: [push, pull_request]')\n  lines.push('permissions:')\n  lines.push('  contents: read')\n  lines.push('jobs:')\n  lines.push('  check:')\n  lines.push('    strategy:')\n  lines.push('      fail-fast: false')\n  lines.push('      matrix:')\n  lines.push('        include:')\n  for (const os of matrix.os) {\n    for (const node of matrix.node) {\n      lines.push(`          - name: ${os.name}`)\n      lines.push(`            runs_on: ${os.runs_on}`)\n      lines.push(`            node: ${node}`)\n    }\n  }\n  lines.push('    runs-on: ${{ matrix.runs_on }}')\n  lines.push('    env:')\n  lines.push(`      CLIWORKER_RESULTS_DIR: \\${{ github.workspace }}/${resultsDir}`)\n  lines.push('    steps:')\n  lines.push('      - uses: actions/checkout@v4')\n  lines.push('      - uses: actions/setup-node@v4')\n  lines.push('        with:')\n  lines.push('          node-version: ${{ matrix.node }}')\n  lines.push('      - run: npm ci')\n  lines.push(`      - run: ${matrix.check_command}`)\n  lines.push('      - uses: actions/upload-artifact@v4')\n  lines.push('        if: always()')\n  lines.push('        with:')\n  lines.push('          name: test-results-${{ matrix.name }}-node${{ matrix.node }}')\n  lines.push('          path: |')\n  for (const artifact of matrix.artifacts) {\n    lines.push(`            ${resultsDir}/${artifact}`)\n  }\n  lines.push('          if-no-files-found: warn')\n  lines.push('  perf:')\n  lines.push(`    runs-on: ${matrix.perf.runs_on}`)\n  lines.push('    continue-on-error: true')\n  lines.push('    steps:')\n  lines.push('      - uses: actions/checkout@v4')\n  lines.push('      - uses: actions/setup-node@v4')\n  lines.push('        with:')\n  lines.push(`          node-version: ${matrix.perf.node}`)\n  lines.push('      - run: npm ci')\n  lines.push(`      - run: ${matrix.perf.command}`)\n\n  return `${lines.join('\\n')}\\n`\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n  let toStdout = false\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--stdout') {\n      toStdout = true\n    } else if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else {\n      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/gen-ci.mjs [--root <dir>] [--stdout]\\n`)\n      process.exitCode = 2\n      return\n    }\n  }\n\n  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  let matrix\n  try {\n    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  } catch {\n    process.stderr.write(`gen-ci: cannot read ${matrixFile}\\n`)\n    process.exitCode = 2\n    return\n  }\n\n  const text = renderCi(matrix)\n  if (toStdout) {\n    process.stdout.write(text)\n    return\n  }\n\n  const target = path.join(root, WORKFLOW_PATH)\n  fs.mkdirSync(path.dirname(target), { recursive: true })\n  fs.writeFileSync(target, text)\n  process.stdout.write(`gen-ci: wrote ${WORKFLOW_PATH.split(path.sep).join('/')}\\n`)\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","isEmpty":false,"exceededLimit":false,"totalLines":119,"fileSize":3992,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/gen-ci.mjs","readRange":{"startLine":1,"endLine":119},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-18\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_3","startedAtMs":"1794061264712","completedAtMs":"1794061265034"},"model_call_id":"55d2d473-447d-4acc-93b1-e83c9432ad95-3-ufzg","session_id":"4cef3f0d-03ba-4417-bf0e-ce33fbb35a9e","timestamp_ms":1794061272492}
{"type":"tool_call","subtype":"completed","call_id":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-19\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_4","tool_call":{"readToolCall":{"args":{"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/check-ci.mjs"},"result":{"success":{"content":"#!/usr/bin/env node\n// Verifies that .github/workflows/ci.yml is the current output of gen-ci.mjs for ci-matrix.json.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nimport { renderCi } from './gen-ci.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\n\nconst EXPECTED_OS = ['macos', 'ubuntu', 'windows']\nconst EXPECTED_NODE = [20, 22]\nconst EXPECTED_ARTIFACTS = ['files-executed.json', 'skips.jsonl']\nconst CHECK_COMMAND = 'npm run check'\n\nfunction sortedCopy(value) {\n  return Array.isArray(value) ? [...value].sort() : null\n}\n\nfunction sameArray(actual, expected) {\n  if (!Array.isArray(actual) || actual.length !== expected.length) return false\n  return actual.every((item, i) => item === expected[i])\n}\n\nfunction validateMatrix(matrix) {\n  const problems = []\n  if (!matrix || typeof matrix !== 'object' || Array.isArray(matrix)) {\n    problems.push('matrix must be a JSON object')\n    return problems\n  }\n\n  const names = sortedCopy((Array.isArray(matrix.os) ? matrix.os : []).map((item) => item && item.name))\n  if (!names || !sameArray(names, EXPECTED_OS)) {\n    problems.push(`os names must be ${EXPECTED_OS.join('|')}`)\n  }\n  if (!sameArray(matrix.node, EXPECTED_NODE)) {\n    problems.push(`node must be ${EXPECTED_NODE.join(',')}`)\n  }\n  if (matrix.check_command !== CHECK_COMMAND) {\n    problems.push(`check_command must be \"${CHECK_COMMAND}\"`)\n  }\n  if (!sameArray(matrix.artifacts, EXPECTED_ARTIFACTS)) {\n    problems.push(`artifacts must be ${EXPECTED_ARTIFACTS.join(',')}`)\n  }\n  if (!matrix.perf || matrix.perf.blocking !== false) {\n    problems.push('perf.blocking must be false')\n  }\n  return problems\n}\n\nexport function checkCi(root = REPO_ROOT) {\n  const errors = []\n  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  const workflowFile = path.join(root, '.github', 'workflows', 'ci.yml')\n\n  let matrix = null\n  try {\n    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  } catch {\n    errors.push({ id: 'ci.matrix_invalid', detail: `cannot read ${matrixFile}` })\n    return errors\n  }\n\n  const problems = validateMatrix(matrix)\n  if (problems.length > 0) {\n    for (const problem of problems) errors.push({ id: 'ci.matrix_invalid', detail: problem })\n    return errors\n  }\n\n  let actual = null\n  try {\n    actual = fs.readFileSync(workflowFile, 'utf8')\n  } catch {\n    errors.push({ id: 'ci.missing', detail: '.github/workflows/ci.yml is missing' })\n    return errors\n  }\n\n  const expected = renderCi(matrix)\n  if (actual !== expected) {\n    errors.push({ id: 'ci.stale', detail: '.github/workflows/ci.yml is not the current generated output' })\n  }\n\n  if (!expected.includes('continue-on-error: true')) {\n    errors.push({ id: 'ci.perf_blocking', detail: 'perf job is missing continue-on-error: true' })\n  }\n  if (expected.includes('needs: perf')) {\n    errors.push({ id: 'ci.perf_blocking', detail: 'a job depends on perf' })\n  }\n\n  return errors\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else {\n      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/check-ci.mjs [--root <dir>]\\n`)\n      process.exitCode = 2\n      return\n    }\n  }\n\n  const errors = checkCi(root)\n  if (errors.length === 0) {\n    process.stdout.write('check-ci: ok\\n')\n    process.exitCode = 0\n    return\n  }\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n  process.stdout.write(`check-ci: FAILED (${errors.length} errors)\\n`)\n  process.exitCode = 1\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","isEmpty":false,"exceededLimit":false,"totalLines":131,"fileSize":4095,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/scripts/check-ci.mjs","readRange":{"startLine":1,"endLine":131},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f084f9a4-bc03-412c-8190-13ca76ae60b2-19\nfc_262f03f0-c1c4-98be-b988-b59ea2997a15_4","startedAtMs":"1794061264716","completedAtMs":"1794061265040"},"model_call_id":"55d2d473-447d-4acc-93b1-e83c9432ad95-3-ufzg","session_id":"4cef3f0d-03ba-4417-bf0e-ce33fbb35a9e","timestamp_ms":1794061272493}
