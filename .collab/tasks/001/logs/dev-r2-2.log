ORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\n        },\n      })\n      assert.equal(result.status, 7, output(result))\n      assert.match(output(result), /check-b\\.mjs/)\n    } finally {\n      fs.rmSync(dir, { recursive: true, force: true })\n    }\n\n    const lines = fs\n      .readFileSync(CHECK_FAST_PS1, 'utf8')\n      .split('\\n')\n      .filter((line) => line.trim() !== '' && !line.trim().startsWith('#'))\n    assert.ok(lines.length <= 3, `check-fast.ps1 must stay a thin wrapper, got ${lines.length} lines`)\n    assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /\\$LASTEXITCODE/)\n    assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /check-fast\\.mjs/)\n  }\n)\n","isEmpty":false,"exceededLimit":false,"totalLines":345,"fileSize":12790,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/001/test/unit/runner-selftest.test.mjs","readRange":{"startLine":280,"endLine":345},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-c998b0c8-4e37-430b-86e0-89bf061fa8b0-16\nfc_69d37b5d-a0d6-9255-a32c-65ff07b17d91_0","startedAtMs":"1794063154109","completedAtMs":"1794063154295"},"model_call_id":"6fc9a06f-027f-4350-8068-4e4b93690923-6-vmdv","session_id":"b9745ee2-26ca-4ae4-ac97-d04342039f74","timestamp_ms":1794063161850}
