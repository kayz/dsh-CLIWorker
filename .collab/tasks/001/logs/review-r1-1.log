\n36:   for (const entry of entries) {\r\n37:     const full = path.join(dir, entry.name)\r\n38:     if (entry.isDirectory()) walkFiles(full, onFile)\r\n39:     else if (entry.isFile()) onFile(full)\r\n40:   }\r\n41: }\r\n42: \r\n43: export function enumerateTestFiles(root) {\r\n44:   const base = path.resolve(root)\r\n45:   const found = []\r\n46:   for (const name of TEST_DIRS) {\r\n47:     const start = path.join(base, 'test', name)\r\n48:     let stat\r\n49:     try {\r\n50:       stat = fs.statSync(start)\r\n51:     } catch {\r\n52:       continue\r\n53:     }\r\n54:     if (!stat.isDirectory()) continue\r\n55:     walkFiles(start, (file) => {\r\n56:       if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n57:     })\r\n58:   }\r\n59:   return [...new Set(found)].sort()\r\n60: }\r\n61: \r\n62: export function enumeratePerfFiles(root) {\r\n63:   const base = path.resolve(root)\r\n64:   const start = path.join(base, 'test', 'perf')\r\n65:   try {\r\n66:     if (!fs.statSync(start).isDirectory()) return []\r\n67:   } catch {\r\n68:     return []\r\n69:   }\r\n70:   const found = []\r\n71:   walkFiles(start, (file) => {\r\n72:     if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n73:   })\r\n74:   return [...new Set(found)].sort()\r\n75: }\r\n76: \r\n77: export function findOrphans(root) {\r\n78:   const base = path.resolve(root)\r\n79:   const testDir = path.join(base, 'test')\r\n80:   let entries\r\n81:   try {\r\n82:     entries = fs.readdirSync(testDir, { withFileTypes: true })\r\n83:   } catch {\r\n84:     return []\r\n85:   }\r\n86: \r\n87:   const all = []\r\n88:   for (const entry of entries) {\r\n89:     if (entry.isDirectory()) {\r\n90:       if (EXCLUDED_TOP.has(entry.name)) continue\r\n91:       walkFiles(path.join(testDir, entry.name), (file) => {\r\n92:         if (file.endsWith('.test.mjs')) all.push(file)\r\n93:       })\r\n94:     } else if (entry.isFile() && entry.name.endsWith('.test.mjs')) {\r\n95:       all.push(path.join(testDir, entry.name))\r\n96:     }\r\n97:   }\r\n98: \r\n99:   const enumerated = new Set(enumerateTestFiles(base))\r\n100:   return [...new Set(all.map((file) => toPosix(path.relative(base, file))))]\r\n101:     .filter((file) => !enumerated.has(file))\r\n102:     .sort()\r\n103: }\r\n104: \r\n105: export function verifyFullRun({ enumerated, manifest }) {\r\n106:   const errors = []\r\n107:   const files = Array.isArray(manifest?.files) ? manifest.files : []\r\n108:   if (!manifest || manifest.mode !== 'full') {\r\n109:     errors.push({ id: 'discovery.mode_not_full', path: manifest?.mode ?? 'missing' })\r\n110:   }\r\n111: \r\n112:   const reported = new Set(files)\r\n113:   for (const file of enumerated) {\r\n114:     if (!reported.has(file)) errors.push({ id: 'discovery.missing', path: file })\r\n115:   }\r\n116: \r\n117:   const expected = new Set(enumerated)\r\n118:   for (const file of files) {\r\n119:     if (!expected.has(file)) errors.push({ id: 'discovery.unexpected', path: file })\r\n120:   }\r\n121: \r\n122:   if (enumerated.length === 0) errors.push({ id: 'discovery.no_files', path: '' })\r\n123: \r\n124:   return { ok: errors.length === 0, errors }\r\n125: }\r\n126: \r\n127: function normalizePath(value) {\r\n128:   const resolved = path.resolve(value).replace(/[\\\\/]+$/, '')\r\n129:   return process.platform === 'win32' ? resolved.toLowerCase() : resolved\r\n130: }\r\n131: \r\n132: function defaultOutDir(root) {\r\n133:   const key = process.platform === 'win32' ? root.toLowerCase() : root\r\n134:   const hash = crypto.createHash('sha256').update(key).digest('hex').slice(0, 12)\r\n135:   return path.join(os.tmpdir(), 'cliworker-test-results', hash)\r\n136: }\r\n137: \r\n138: function usageError(message) {\r\n139:   process.stderr.write(`${message}\\n${USAGE}\\n`)\r\n140:   process.exitCode = 2\r\n141: }\r\n142: \r\n143: function parseArgs(argv) {\r\n144:   const options = { acs: [], root: REPO_ROOT, outDir: null, perf: false, updateSnapshots: false }\r\n145:   for (let i = 0; i < argv.length; i += 1) {\r\n146:     const flag = argv[i]\r\n147:     if (flag === '--ac') {\r\n148:       const value = argv[i + 1]\r\n149:       if (typeof value !== 'string' || !AC_PATTERN.test(value)) {\r\n150:         return { error: `--ac requires a value matching ^AC-\\\\d{3}$ (got ${JSON.stringify(value ?? null)})` }\r\n151:       }\r\n152:       options.acs.push(value)\r\n153:       i += 1\r\n154:     } else if (flag === '--root') {\r\n155:       const value = argv[i + 1]\r\n156:       if (typeof value !== 'string' || value === '') return { error: '--root requires a directory' }\r\n157:       options.root = path.resolve(value)\r\n158:       i += 1\r\n159:     } else if (flag === '--out-dir') {\r\n160:       const value = argv[i + 1]\r\n161:       if (typeof value !== 'string' || value === '') return { error: '--out-dir requires a directory' }\r\n162:       options.outDir = path.resolve(value)\r\n163:       i += 1\r\n164:     } else if (flag === '--perf') {\r\n165:       options.perf = true\r\n166:     } else if (flag === '--update-snapshots') {\r\n167:       options.updateSnapshots = true\r\n168:     } else {\r\n169:       return { error: `unknown argument: ${flag}` }\r\n170:     }\r\n171:   }\r\n172:   options.acs = [...new Set(options.acs)]\r\n173:   return { options }\r\n174: }\r\n175: \r\n176: function runNode(args, spawnOptions) {\r\n177:   return new Promise((resolve) => {\r\n178:     // A nested `node --test` refuses to run its files when it inherits NODE_TEST_CONTEXT from\r\n179:     // the parent test process. Nested runs are legitimate here (self-tests and the milestone\r\n180:     // gate spawn run-tests), so the child must look like a top-level run.\r\n181:     const env = { ...(spawnOptions.env ?? process.env) }\r\n182:     delete env.NODE_TEST_CONTEXT\r\n183:     const child = spawn(process.execPath, args, { ...spawnOptions, env })\r\n184:     child.on('error', () => resolve({ code: null, signal: null }))\r\n185:     child.on('close', (code, signal) => resolve({ code, signal }))\r\n186:   })\r\n187: }\r\n188: \r\n189: function readManifest(file) {\r\n190:   try {\r\n191:     return JSON.parse(fs.readFileSync(file, 'utf8'))\r\n192:   } catch {\r\n193:     return null\r\n194:   }\r\n195: }\r\n196: \r\n197: async function main() {\r\n198:   const parsed = parseArgs(process.argv.slice(2))\r\n199:   if (parsed.error) {\r\n200:     usageError(parsed.error)\r\n201:     return\r\n202:   }\r\n203:   const options = parsed.options\r\n204:   const root = options.root\r\n205: \r\n206:   if (options.perf) {\r\n207:     const files = enumeratePerfFiles(root)\r\n208:     if (files.length === 0) {\r\n209:       process.stdout.write('run-tests: no perf tests\\n')\r\n210:       return\r\n211:     }\r\n212:     const result = await runNode(['--test', ...files], { cwd: root, stdio: 'inherit' })\r\n213:     process.exitCode = result.code === null ? 1 : result.code\r\n214:     return\r\n215:   }\r\n216: \r\n217:   const filtered = options.acs.length > 0\r\n218:   const outDir = options.outDir ?? (process.env.CLIWORKER_RESULTS_DIR\r\n219:     ? path.resolve(process.env.CLIWORKER_RESULTS_DIR)\r\n220:     : defaultOutDir(root))\r\n221: \r\n222:   if (\r\n223:     process.env.CLIWORKER_RUN_ACTIVE &&\r\n224:     process.env.CLIWORKER_RESULTS_DIR &&\r\n225:     normalizePath(outDir) === normalizePath(process.env.CLIWORKER_RESULTS_DIR)\r\n226:   ) {\r\n227:     process.stderr.write(\r\n228:       'run-tests: refusing to run nested inside the parent run (a nested run would overwrite the parent artifacts)\\n'\r\n229:     )\r\n230:     process.exitCode = 2\r\n231:     return\r\n232:   }\r\n233: \r\n234:   const enumerated = enumerateTestFiles(root)\r\n235:   let files = enumerated\r\n236: \r\n237:   if (filtered) {\r\n238:     const needles = options.acs.map((ac) => `[${ac}]`)\r\n239:     files = enumerated.filter((file) => {\r\n240:       let source = ''\r\n241:       try {\r\n242:         source = fs.readFileSync(path.join(root, file), 'utf8')\r\n243:       } catch {\r\n244:         return false\r\n245:       }\r\n246:       return needles.some((needle) => source.includes(needle))\r\n247:     })\r\n248:     if (files.length === 0) {\r\n249:       for (const ac of options.acs) process.stdout.write(`FAIL run.no_match ${ac}\\n`)\r\n250:       process.exitCode = 1\r\n251:       return\r\n252:     }\r\n253:   } else {\r\n254:     const orphans = findOrphans(root)\r\n255:     if (orphans.length > 0) {\r\n256:       for (const file of orphans) process.stdout.write(`FAIL discovery.orphan ${file}\\n`)\r\n257:       process.exitCode = 1\r\n258:       return\r\n259:     }\r\n260:   }\r\n261: \r\n262:   if (files.length === 0) {\r\n263:     process.stdout.write('FAIL discovery.no_files\\n')\r\n264:     process.exitCode = 1\r\n265:     return\r\n266:   }\r\n267: \r\n268:   const joined = files.join(' ')\r\n269:   if (joined.length > MAX_ARG_CHARS) {\r\n270:     usageError(`run-tests: file list is too long for one command line (${joined.length} characters)`)\r\n271:     return\r\n272:   }\r\n273: \r\n274:   fs.mkdirSync(outDir, { recursive: true })\r\n275:   const manifestPath = path.join(outDir, MANIFEST_NAME)\r\n276:   const skipsPath = path.join(outDir, SKIPS_NAME)\r\n277:   try {\r\n278:     fs.rmSync(manifestPath, { force: true })\r\n279:   } catch {\r\n280:     /* ignore */\r\n281:   }\r\n282:   fs.writeFileSync(skipsPath, '')\r\n283: \r\n284:   const mode = filtered ? 'filtered' : 'full'\r\n285:   const env = {\r\n286:     ...process.env,\r\n287:     CLIWORKER_RUN_MODE: mode,\r\n288:     CLIWORKER_RUN_FILTER: filtered ? options.acs.join(',') : '',\r\n289:     CLIWORKER_ROOT: root,\r\n290:     CLIWORKER_RESULTS_DIR: outDir,\r\n291:     CLIWORKER_RUN_ACTIVE: '1',\r\n292:   }\r\n293:   if (options.updateSnapshots) env.CLIWORKER_UPDATE_SNAPSHOT = '1'\r\n294: \r\n295:   const args = [\r\n296:     '--test',\r\n297:     '--test-reporter=spec',\r\n298:     '--test-reporter-destination=stdout',\r\n299:     `--test-reporter=${REPORTER}`,\r\n300:     `--test-reporter-destination=${manifestPath}`,\r\n301:     ...files,\r\n302:   ]\r\n303: \r\n304:   const result = await runNode(args, { cwd: root, stdio: 'inherit', env })\r\n305:   let exitCode = result.code === null ? 1 : result.code\r\n306: \r\n307:   if (!filtered) {\r\n308:     const manifest = readManifest(manifestPath)\r\n309:     const verification = verifyFullRun({ enumerated: files, manifest })\r\n310:     if (!verification.ok) {\r\n311:       for (const error of verification.errors) {\r\n312:         process.stdout.write(`FAIL ${error.id} ${error.path}\\n`)\r\n313:       }\r\n314:       if (exitCode === 0) exitCode = 1\r\n315:     }\r\n316:   }\r\n317: \r\n318:   process.stdout.write(`run-tests: ${mode} ${files.length} files, manifest ${manifestPath}\\n`)\r\n319:   process.exitCode = exitCode\r\n320: }\r\n321: \r\n322: const invokedDirectly =\r\n323:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n324: \r\n325: if (invokedDirectly) {\r\n326:   main().catch((error) => {\r\n327:     process.stderr.write(`run-tests: ${error && error.stack ? error.stack : String(error)}\\n`)\r\n328:     process.exitCode = 1\r\n329:   })\r\n330: }\r\nscripts/reporters/files.mjs\r\n1: // node:test reporter that writes files-executed.json (schema: mode, filter, files, platform, node).\r\n2: import path from 'node:path'\r\n3: import { fileURLToPath } from 'node:url'\r\n4: \r\n5: function toFilePath(value) {\r\n6:   if (typeof value !== 'string' || value === '') return null\r\n7:   if (value.startsWith('file:')) {\r\n8:     try {\r\n9:       return fileURLToPath(value)\r\n10:     } catch {\r\n11:       return null\r\n12:     }\r\n13:   }\r\n14:   return value\r\n15: }\r\n16: \r\n17: function relativize(root, file) {\r\n18:   const absolute = path.isAbsolute(file) ? file : path.resolve(root, file)\r\n19:   return path.relative(root, absolute).split(path.sep).join('/')\r\n20: }\r\n21: \r\n22: export default async function* filesReporter(source) {\r\n23:   const root = process.env.CLIWORKER_ROOT ? path.resolve(process.env.CLIWORKER_ROOT) : process.cwd()\r\n24:   const mode = process.env.CLIWORKER_RUN_MODE === 'full' ? 'full' : 'filtered'\r\n25:   const rawFilter = process.env.CLIWORKER_RUN_FILTER\r\n26:   const filter = rawFilter !== undefined ? rawFilter : mode === 'full' ? '' : null\r\n27: \r\n28:   const files = new Set()\r\n29:   for await (const event of source) {\r\n30:     const file = toFilePath(event?.data?.file)\r\n31:     // A test registered by a helper (test/helpers/platform-gate.mjs) is reported against the\r\n32:     // helper module, because node:test attributes every test to the file that called test().\r\n33:     // The manifest describes test files, and every enumerated file ends in .test.mjs, so\r\n34:     // anything else is attribution noise rather than an executed test file.\r\n35:     if (file && file.endsWith('.test.mjs')) files.add(relativize(root, file))\r\n36:   }\r\n37: \r\n38:   const payload = {\r\n39:     mode,\r\n40:     filter,\r\n41:     files: [...files].sort(),\r\n42:     platform: process.platform,\r\n43:     node: process.version,\r\n44:   }\r\n45:   yield `${JSON.stringify(payload, null, 2)}\\n`\r\n46: }\r\nscripts/check-test-discovery.mjs\r\n1: #!/usr/bin/env node\r\n2: // Self-test for the test discovery rules: proves the runner notices drift, that a filtered\r\n3: // manifest cannot stand in for a full one, and that decoys and orphans are handled correctly.\r\n4: import fs from 'node:fs'\r\n5: import os from 'node:os'\r\n6: import path from 'node:path'\r\n7: import { spawnSync } from 'node:child_process'\r\n8: import { fileURLToPath } from 'node:url'\r\n9: \r\n10: import { enumerateTestFiles, findOrphans, verifyFullRun } from './run-tests.mjs'\r\n11: \r\n12: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n13: const REPO_ROOT = path.resolve(HERE, '..')\r\n14: const RUN_TESTS = path.join(HERE, 'run-tests.mjs')\r\n15: const FIXTURES = path.join(REPO_ROOT, 'test', 'fixtures', 'discovery-selftest')\r\n16: const EXCLUDED_PREFIXES = ['test/fixtures/', 'test/helpers/', 'test/perf/']\r\n17: \r\n18: function printErrors(errors) {\r\n19:   for (const error of errors) {\r\n20:     process.stdout.write(`FAIL ${error.id} ${error.path ?? ''}`.trimEnd() + '\\n')\r\n21:   }\r\n22: }\r\n23: \r\n24: function checkRoot(root, manifestPath) {\r\n25:   const errors = findOrphans(root).map((file) => ({ id: 'discovery.orphan', path: file }))\r\n26:   if (manifestPath) {\r\n27:     let manifest = null\r\n28:     try {\r\n29:       manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\r\n30:     } catch {\r\n31:       manifest = null\r\n32:     }\r\n33:     const verification = verifyFullRun({ enumerated: enumerateTestFiles(root), manifest })\r\n34:     errors.push(...verification.errors)\r\n35:   }\r\n36:   printErrors(errors)\r\n37:   if (errors.length > 0) {\r\n38:     process.exitCode = 1\r\n39:     return\r\n40:   }\r\n41:   process.stdout.write('check-test-discovery: ok\\n')\r\n42: }\r\n43: \r\n44: function runRunner(root) {\r\n45:   const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\r\n46:   const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\r\n47:     encoding: 'utf8',\r\n48:   })\r\n49:   const manifestPath = path.join(outDir, 'files-executed.json')\r\n50:   let manifest = null\r\n51:   try {\r\n52:     manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\r\n53:   } catch {\r\n54:     manifest = null\r\n55:   }\r\n56:   return { result, manifest, outDir, manifestPath }\r\n57: }\r\n58: \r\n59: function runFiltered(root, ac) {\r\n60:   const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\r\n61:   const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--ac', ac, '--out-dir', outDir], {\r\n62:     encoding: 'utf8',\r\n63:   })\r\n64:   let manifest = null\r\n65:   try {\r\n66:     manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\r\n67:   } catch {\r\n68:     manifest = null\r\n69:   }\r\n70:   return { result, manifest, outDir }\r\n71: }\r\n72: \r\n73: function selftest() {\r\n74:   const problems = []\r\n75:   const record = (message) => {\r\n76:     problems.push(message)\r\n77:     process.stdout.write(`FAIL ${message}\\n`)\r\n78:   }\r\n79: \r\n80:   // 1. Live repository.\r\n81:   for (const file of findOrphans(REPO_ROOT)) record(`discovery.orphan ${file}`)\r\n82:   for (const file of enumerateTestFiles(REPO_ROOT)) {\r\n83:     if (EXCLUDED_PREFIXES.some((prefix) => file.startsWith(prefix))) {\r\n84:       record(`discovery.unexpected ${file}`)\r\n85:     }\r\n86:   }\r\n87: \r\n88:   // 2. Full run inside the ok fixture.\r\n89:   const okRoot = path.join(FIXTURES, 'ok')\r\n90:   const full = runRunner(okRoot)\r\n91:   const expected = ['test/flows/c.test.mjs', 'test/integration/b.test.mjs', 'test/unit/a.test.mjs']\r\n92:   if (full.result.status !== 0) {\r\n93:     record(`discovery.selftest full run exited ${full.result.status} ${(full.result.stderr || '').trim()}`)\r\n94:   }\r\n95:   if (!full.manifest || full.manifest.mode !== 'full') {\r\n96:     record('discovery.mode_not_full ok fixture manifest is not a full run')\r\n97:   } else if (JSON.stringify(full.manifest.files) !== JSON.stringify(expected)) {\r\n98:     record(`discovery.selftest ok fixture files ${JSON.stringify(full.manifest.files)}`)\r\n99:   }\r\n100:   fs.rmSync(full.outDir, { recursive: true, force: true })\r\n101: \r\n102:   // 3. Drift manifests.\r\n103:   const driftRoot = path.join(FIXTURES, 'drift')\r\n104:   const driftCases = [\r\n105:     ['manifest-ok.json', null],\r\n106:     ['manifest-missing.json', 'discovery.missing'],\r\n107:     ['manifest-extra.json', 'discovery.unexpected'],\r\n108:     ['manife