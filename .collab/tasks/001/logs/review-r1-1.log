{"type":"user","uuid":"01a1b698-6650-767f-9e1b-db7980adfb60","session_id":"01a1b694-bf86-79ef-9b9d-323d8d10c8a2","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-88bf05e924a6aedb","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Milestone gate: every AC owned by a task up to the requested milestone must be covered,\n   3→// its defects fixed, and its files must actually run in a full test run.\n   4→import fs from 'node:fs'\n   5→import os from 'node:os'\n   6→import path from 'node:path'\n   7→import { spawnSync } from 'node:child_process'\n   8→import { fileURLToPath } from 'node:url'\n   9→\n  10→import { mergeShards } from './check-traceability.mjs'\n  11→import { checkDefects, milestoneRank } from './check-defects.mjs'\n  12→\n  13→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  14→const REPO_ROOT = path.resolve(HERE, '..')\n  15→const RUN_TESTS = path.join(HERE, 'run-tests.mjs')\n  16→\n  17→function collectCoveredFiles(root) {\n  18→  const map = new Map()\n  19→  const dir = path.join(root, 'test', 'traceability')\n  20→  let names = []\n  21→  try {\n  22→    names = fs.readdirSync(dir).filter((name) => name.endsWith('.json'))\n  23→  } catch {\n  24→    return map\n  25→  }\n  26→  for (const name of names) {\n  27→    let shard = null\n  28→    try {\n  29→      shard = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8'))\n  30→    } catch {\n  31→      continue\n  32→    }\n  33→    for (const entry of Array.isArray(shard?.entries) ? shard.entries : []) {\n  34→      if (!entry || entry.status !== 'covered' || typeof entry.ac !== 'string') continue\n  35→      const files = Array.isArray(entry.files) ? entry.files.filter((file) => typeof file === 'string') : []\n  36→      map.set(entry.ac, files)\n  37→    }\n  38→  }\n  39→  return map\n  40→}\n  41→\n  42→export function runGate({ root, index, milestone }) {\n  43→  const errors = []\n  44→  const limit = milestoneRank(milestone)\n  45→  const entries = Array.isArray(index?.acs) ? index.acs : []\n  46→\n  47→  const merged = mergeShards({ root, index })\n  48→  for (const error of merged.errors) {\n  49→    const where = error.ac ?? error.file ?? '-'\n  50→    errors.push({ id: 'gate.trace_error', detail: `${where} ${error.detail ?? error.id}`.trim() })\n  51→  }\n  52→\n  53→  for (const entry of entries) {\n  54→    if (!entry || typeof entry !== 'object') continue\n  55→    if (!(milestoneRank(entry.milestone) <= limit)) continue\n  56→    if (merged.acs[entry.ac] !== 'covered') {\n  57→      errors.push({ id: 'gate.ac_not_covered', detail: `${entry.ac} is ${merged.acs[entry.ac] ?? 'planned'}` })\n  58→    }\n  59→  }\n  60→\n  61→  errors.push(...checkDefects({ root, index, milestone }).errors)\n  62→\n  63→  if (errors.length > 0) return errors\n  64→\n  65→  const coveredFiles = collectCoveredFiles(root)\n  66→  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-gate-'))\n  67→  try {\n  68→    const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\n  69→      cwd: root,\n  70→      encoding: 'utf8',\n  71→      maxBuffer: 64 * 1024 * 1024,\n  72→    })\n  73→    if (result.status !== 0) {\n  74→      const tail = (result.stderr || result.stdout || '').trim().split('\\n').slice(-3).join(' | ')\n  75→      errors.push({ id: 'gate.run_failed', detail: `full run exited ${result.status}${tail ? `: ${tail}` : ''}` })\n  76→      return errors\n  77→    }\n  78→\n  79→    let manifest = null\n  80→    try {\n  81→      manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\n  82→    } catch {\n  83→      manifest = null\n  84→    }\n  85→    if (!manifest || manifest.mode !== 'full') {\n  86→      errors.push({ id: 'gate.manifest_not_full', detail: `mode is ${manifest?.mode ?? 'missing'}` })\n  87→    }\n  88→\n  89→    const executed = new Set(Array.isArray(manifest?.files) ? manifest.files : [])\n  90→    for (const entry of entries) {\n  91→      if (!entry || typeof entry !== 'object') continue\n  92→      if (!(milestoneRank(entry.milestone) <= limit)) continue\n  93→      if (merged.acs[entry.ac] !== 'covered') continue\n  94→      for (const file of coveredFiles.get(entry.ac) ?? []) {\n  95→        if (!executed.has(file)) {\n  96→          errors.push({ id: 'gate.file_not_executed', detail: `${file} (${entry.ac})` })\n  97→        }\n  98→      }\n  99→    }\n 100→  } finally {\n 101→    fs.rmSync(outDir, { recursive: true, force: true })\n 102→  }\n 103→\n 104→  return errors\n 105→}\n 106→\n 107→function main() {\n 108→  const args = process.argv.slice(2)\n 109→  let root = REPO_ROOT\n 110→  let indexPath = null\n 111→  let milestone = null\n 112→\n 113→  for (let i = 0; i < args.length; i += 1) {\n 114→    const flag = args[i]\n 115→    if (flag === '--root') {\n 116→      const value = args[i + 1]\n 117→      if (typeof value !== 'string' || value === '') {\n 118→        process.stderr.write('--root requires a directory\\n')\n 119→        process.exitCode = 2\n 120→        return\n 121→      }\n 122→      root = path.resolve(value)\n 123→      i += 1\n 124→    } else if (flag === '--index') {\n 125→      const value = args[i + 1]\n 126→      if (typeof value !== 'string' || value === '') {\n 127→        process.stderr.write('--index requires a file\\n')\n 128→        process.exitCode = 2\n 129→        return\n 130→      }\n 131→      indexPath = path.resolve(value)\n 132→      i += 1\n 133→    } else if (flag === '--milestone') {\n 134→      const value = args[i + 1]\n 135→      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n 136→        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n 137→        process.exitCode = 2\n 138→        return\n 139→      }\n 140→      milestone = value\n 141→      i += 1\n 142→    } else {\n 143→      process.stderr.write(\n 144→        `unknown argument: ${flag}\\nusage: node scripts/milestone-gate.mjs --milestone Mx [--root <dir>] [--index <file>]\\n`\n 145→      )\n 146→      process.exitCode = 2\n 147→      return\n 148→    }\n 149→  }\n 150→\n 151→  if (!milestone) {\n 152→    process.stderr.write('usage: node scripts/milestone-gate.mjs --milestone Mx [--root <dir>] [--index <file>]\\n')\n 153→    process.exitCode = 2\n 154→    return\n 155→  }\n 156→\n 157→  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n 158→  const errors = []\n 159→  let index = null\n 160→  try {\n 161→    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n 162→  } catch {\n 163→    errors.push({ id: 'gate.trace_error', detail: `cannot read index: ${indexFile}` })\n 164→    index = { acs: [] }\n 165→  }\n 166→\n 167→  if (errors.length === 0) errors.push(...runGate({ root, index, milestone }))\n 168→\n 169→  if (errors.length === 0) {\n 170→    process.stdout.write(`milestone-gate ${milestone}: PASS\\n`)\n 171→    process.exitCode = 0\n 172→    return\n 173→  }\n 174→  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n 175→  process.stdout.write(`milestone-gate ${milestone}: BLOCKED (${errors.length} errors)\\n`)\n 176→  process.exitCode = 1\n 177→}\n 178→\n 179→const invokedDirectly =\n 180→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 181→\n 182→if (invokedDirectly) main()\n 183→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b694c37777a89e7b949da7c8c488","_messageId":"01a1b6984fc479478b8c5d0fff8b3f94","_meta":{"codebuddy.ai/conversationRequestId":"01a1b694c37777a89e7b949da7c8c488","codebuddy.ai/modelRequestId":"01a1b6984fc479478b8c5d0fff8b3f94","codebuddy.ai/llmMessageId":"01a1b6984fc479478b8c5d0fff8b3f94","traceparent":"00-f2afc752a8a37e0cd10f85162fee58ac-07ea269c5c5feea8-01","baggage":"codebuddy.session_id=01a1b694-bf86-79ef-9b9d-323d8d10c8a2,codebuddy.conversation_request_id=01a1b694c37777a8