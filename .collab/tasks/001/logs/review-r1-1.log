{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Users\\\\kayz\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\Microsoft.PowerShell_8wekyb3d8bbwe\\\\pwsh.exe\" -NoProfile -Command '$paths=@('\"'scripts/check-fast.mjs','scripts/check-fast.ps1','scripts/check-ci.mjs','scripts/gen-ci.mjs','.github/workflows/ci.yml','package.json','package-lock.json'); foreach(\"'$p in $paths){ $p; $n=0; Get-Content -LiteralPath $p -Encoding utf8 | ForEach-Object { $n++; '\"'{0}: {1}' -f \"'$n,$_ } }'","aggregated_output":"scripts/check-fast.mjs\r\n1: #!/usr/bin/env node\r\n2: // Runs every scripts/check-*.mjs in code point order (never itself) and then the full test run.\r\n3: import fs from 'node:fs'\r\n4: import path from 'node:path'\r\n5: import { spawnSync } from 'node:child_process'\r\n6: import { fileURLToPath } from 'node:url'\r\n7: \r\n8: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n9: const STEP_PATTERN = /^check-.*\\.mjs$/\r\n10: const SELF = 'check-fast.mjs'\r\n11: \r\n12: function out(text) {\r\n13:   fs.writeSync(1, text)\r\n14: }\r\n15: \r\n16: function err(text) {\r\n17:   fs.writeSync(2, text)\r\n18: }\r\n19: \r\n20: function byCodePoint(a, b) {\r\n21:   if (a < b) return -1\r\n22:   if (a > b) return 1\r\n23:   return 0\r\n24: }\r\n25: \r\n26: function stepFailed(label, result) {\r\n27:   const code = result.status === null ? 1 : result.status\r\n28:   err(`check-fast: FAILED step ${label} (exit ${code})\\n`)\r\n29:   process.exitCode = code\r\n30: }\r\n31: \r\n32: function main() {\r\n33:   const injected = Boolean(process.env.CLIWORKER_TEST_CHECK_DIR || process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n34:   const dir = process.env.CLIWORKER_TEST_CHECK_DIR\r\n35:     ? path.resolve(process.env.CLIWORKER_TEST_CHECK_DIR)\r\n36:     : HERE\r\n37:   const finalScript = process.env.CLIWORKER_TEST_FINAL_SCRIPT\r\n38:     ? path.resolve(process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n39:     : path.join(dir, 'run-tests.mjs')\r\n40:   const cwd = path.dirname(dir)\r\n41: \r\n42:   if (injected) err('check-fast: test injection active\\n')\r\n43: \r\n44:   let names = []\r\n45:   try {\r\n46:     names = fs.readdirSync(dir)\r\n47:   } catch {\r\n48:     names = []\r\n49:   }\r\n50: \r\n51:   const steps = names\r\n52:     .filter((name) => STEP_PATTERN.test(name) && name !== SELF)\r\n53:     .filter((name) => {\r\n54:       try {\r\n55:         return fs.statSync(path.join(dir, name)).isFile()\r\n56:       } catch {\r\n57:         return false\r\n58:       }\r\n59:     })\r\n60:     .sort(byCodePoint)\r\n61: \r\n62:   for (const name of steps) {\r\n63:     out(`==> ${name}\\n`)\r\n64:     const result = spawnSync(process.execPath, [path.join(dir, name)], { cwd, stdio: 'inherit' })\r\n65:     if (result.status !== 0) {\r\n66:       stepFailed(name, result)\r\n67:       return\r\n68:     }\r\n69:   }\r\n70: \r\n71:   out('==> npm test\\n')\r\n72:   const result = spawnSync(process.execPath, [finalScript], { cwd, stdio: 'inherit' })\r\n73:   if (result.status !== 0) {\r\n74:     stepFailed('npm test', result)\r\n75:     return\r\n76:   }\r\n77: \r\n78:   out('check-fast: ok\\n')\r\n79:   process.exitCode = 0\r\n80: }\r\n81: \r\n82: main()\r\nscripts/check-fast.ps1\r\n1: & node (Join-Path $PSScriptRoot 'check-fast.mjs') @args\r\n2: exit $LASTEXITCODE\r\nscripts/check-ci.mjs\r\n1: #!/usr/bin/env node\r\n2: // Verifies that .github/workflows/ci.yml is the current output of gen-ci.mjs for ci-matrix.json.\r\n3: import fs from 'node:fs'\r\n4: import path from 'node:path'\r\n5: import { fileURLToPath } from 'node:url'\r\n6: \r\n7: import { renderCi } from './gen-ci.mjs'\r\n8: \r\n9: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n10: const REPO_ROOT = path.resolve(HERE, '..')\r\n11: \r\n12: const EXPECTED_OS = ['macos', 'ubuntu', 'windows']\r\n13: const EXPECTED_NODE = [20, 22]\r\n14: const EXPECTED_ARTIFACTS = ['files-executed.json', 'skips.jsonl']\r\n15: const CHECK_COMMAND = 'npm run check'\r\n16: \r\n17: function sortedCopy(value) {\r\n18:   return Array.isArray(value) ? [...value].sort() : null\r\n19: }\r\n20: \r\n21: function sameArray(actual, expected) {\r\n22:   if (!Array.isArray(actual) || actual.length !== expected.length) return false\r\n23:   return actual.every((item, i) => item === expected[i])\r\n24: }\r\n25: \r\n26: function validateMatrix(matrix) {\r\n27:   const problems = []\r\n28:   if (!matrix || typeof matrix !== 'object' || Array.isArray(matrix)) {\r\n29:     problems.push('matrix must be a JSON object')\r\n30:     return problems\r\n31:   }\r\n32: \r\n33:   const names = sortedCopy((Array.isArray(matrix.os) ? matrix.os : []).map((item) => item && item.name))\r\n34:   if (!names || !sameArray(names, EXPECTED_OS)) {\r\n35:     problems.push(`os names must be ${EXPECTED_OS.join('|')}`)\r\n36:   }\r\n37:   if (!sameArray(matrix.node, EXPECTED_NODE)) {\r\n38:     problems.push(`node must be ${EXPECTED_NODE.join(',')}`)\r\n39:   }\r\n40:   if (matrix.check_command !== CHECK_COMMAND) {\r\n41:     problems.push(`check_command must be \"${CHECK_COMMAND}\"`)\r\n42:   }\r\n43:   if (!sameArray(matrix.artifacts, EXPECTED_ARTIFACTS)) {\r\n44:     problems.push(`artifacts must be ${EXPECTED_ARTIFACTS.join(',')}`)\r\n45:   }\r\n46:   if (!matrix.perf || matrix.perf.blocking !== false) {\r\n47:     problems.push('perf.blocking must be false')\r\n48:   }\r\n49:   return problems\r\n50: }\r\n51: \r\n52: export function checkCi(root = REPO_ROOT) {\r\n53:   const errors = []\r\n54:   const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\r\n55:   const workflowFile = path.join(root, '.github', 'workflows', 'ci.yml')\r\n56: \r\n57:   let matrix = null\r\n58:   try {\r\n59:     matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\r\n60:   } catch {\r\n61:     errors.push({ id: 'ci.matrix_invalid', detail: `cannot read ${matrixFile}` })\r\n62:     return errors\r\n63:   }\r\n64: \r\n65:   const problems = validateMatrix(matrix)\r\n66:   if (problems.length > 0) {\r\n67:     for (const problem of problems) errors.push({ id: 'ci.matrix_invalid', detail: problem })\r\n68:     return errors\r\n69:   }\r\n70: \r\n71:   let actual = null\r\n72:   try {\r\n73:     actual = fs.readFileSync(workflowFile, 'utf8')\r\n74:   } catch {\r\n75:     errors.push({ id: 'ci.missing', detail: '.github/workflows/ci.yml is missing' })\r\n76:     return errors\r\n77:   }\r\n78: \r\n79:   const expected = renderCi(matrix)\r\n80:   if (actual !== expected) {\r\n81:     errors.push({ id: 'ci.stale', detail: '.github/workflows/ci.yml is not the current generated output' })\r\n82:   }\r\n83: \r\n84:   if (!expected.includes('continue-on-error: true')) {\r\n85:     errors.push({ id: 'ci.perf_blocking', detail: 'perf job is missing continue-on-error: true' })\r\n86:   }\r\n87:   if (expected.includes('needs: perf')) {\r\n88:     errors.push({ id: 'ci.perf_blocking', detail: 'a job depends on perf' })\r\n89:   }\r\n90: \r\n91:   return errors\r\n92: }\r\n93: \r\n94: function main() {\r\n95:   const args = process.argv.slice(2)\r\n96:   let root = REPO_ROOT\r\n97: \r\n98:   for (let i = 0; i < args.length; i += 1) {\r\n99:     const flag = args[i]\r\n100:     if (flag === '--root') {\r\n101:       const value = args[i + 1]\r\n102:       if (typeof value !== 'string' || value === '') {\r\n103:         process.stderr.write('--root requires a directory\\n')\r\n104:         process.exitCode = 2\r\n105:         return\r\n106:       }\r\n107:       root = path.resolve(value)\r\n108:       i += 1\r\n109:     } else {\r\n110:       process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/check-ci.mjs [--root <dir>]\\n`)\r\n111:       process.exitCode = 2\r\n112:       return\r\n113:     }\r\n114:   }\r\n115: \r\n116:   const errors = checkCi(root)\r\n117:   if (errors.length === 0) {\r\n118:     process.stdout.write('check-ci: ok\\n')\r\n119:     process.exitCode = 0\r\n120:     return\r\n121:   }\r\n122:   for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\r\n123:   process.stdout.write(`check-ci: FAILED (${errors.length} errors)\\n`)\r\n124:   process.exitCode = 1\r\n125: }\r\n126: \r\n127: const invokedDirectly =\r\n128:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n129: \r\n130: if (invokedDirectly) main()\r\nscripts/gen-ci.mjs\r\n1: #!/usr/bin/env node\r\n2: // Generates .github/workflows/ci.yml from scripts/ci-matrix.json. There is no YAML dependency:\r\n3: // renderCi is a pure, deterministic string builder so check-ci can compare byte for byte.\r\n4: import fs from 'node:fs'\r\n5: import path from 'node:path'\r\n6: import { fileURLToPath } from 'node:url'\r\n7: \r\n8: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n9: const REPO_ROOT = path.resolve(HERE, '..')\r\n10: const HEADER = '# generated by scripts/gen-ci.mjs from scripts/ci-matrix.json - do not edit'\r\n11: const WORKFLOW_PATH = path.join('.github', 'workflows', 'ci.yml')\r\n12: \r\n13: export function renderCi(matrix) {\r\n14:   const resultsDir = matrix.results_dir\r\n15:   const lines = []\r\n16: \r\n17:   lines.push(HEADER)\r\n18:   lines.push('name: ci')\r\n19:   lines.push('on: [push, pull_request]')\r\n20:   lines.push('permissions:')\r\n21:   lines.push('  contents: read')\r\n22:   lines.push('jobs:')\r\n23:   lines.push('  check:')\r\n24:   lines.push('    strategy:')\r\n25:   lines.push('      fail-fast: false')\r\n26:   lines.push('      matrix:')\r\n27:   lines.push('        include:')\r\n28:   for (const os of matrix.os) {\r\n29:     for (const node of matrix.node) {\r\n30:       lines.push(`          - name: ${os.name}`)\r\n31:       lines.push(`            runs_on: ${os.runs_on}`)\r\n32:       lines.push(`            node: ${node}`)\r\n33:     }\r\n34:   }\r\n35:   lines.push('    runs-on: ${{ matrix.runs_on }}')\r\n36:   lines.push('    env:')\r\n37:   lines.push(`      CLIWORKER_RESULTS_DIR: \\${{ github.workspace }}/${resultsDir}`)\r\n38:   lines.push('    steps:')\r\n39:   lines.push('      - uses: actions/checkout@v4')\r\n40:   lines.push('      - uses: actions/setup-node@v4')\r\n41:   lines.push('        with:')\r\n42:   lines.push('          node-version: ${{ matrix.node }}')\r\n43:   lines.push('      - run: npm ci')\r\n44:   lines.push(`      - run: ${matrix.check_command}`)\r\n45:   lines.push('      - uses: actions/upload-artifact@v4')\r\n46:   lines.push('        if: always()')\r\n47:   lines.push('        with:')\r\n48:   lines.push('          name: test-results-${{ matrix.name }}-node${{ matrix.node }}')\r\n49:   lines.push('          path: |')\r\n50:   for (const artifact of matrix.artifacts) {\r\n51:     lines.push(`            ${resultsDir}/${artifact}`)\r\n52:   }\r\n53:   lines.push('          if-no-files-found: warn')\r\n54:   lines.push('  perf:')\r\n55:   lines.push(`    runs-on: ${matrix.perf.runs_on}`)\r\n56:   lines.push('    continue-on-error: true')\r\n57:   lines.push('    steps:')\r\n58:   lines.push('      - uses: actions/checkout@v4')\r\n59:   lines.push('      - uses: actions/setup-node@v4')\r\n60:   lines.push('        with:')\r\n61:   lines.push(`          node-version: ${matrix.perf.node}`)\r\n62:   lines.push('      - run: npm ci')\r\n63:   lines.push(`      - run: ${matrix.perf.command}`)\r\n64: \r\n65:   return `${lines.join('\\n')}\\n`\r\n66: }\r\n67: \r\n68: function main() {\r\n69:   const args = process.argv.slice(2)\r\n70:   let root = REPO_ROOT\r\n71:   let toStdout = false\r\n72: \r\n73:   for (let i = 0; i < args.length; i += 1) {\r\n74:     const flag = args[i]\r\n75:     if (flag === '--stdout') {\r\n76:       toStdout = true\r\n77:     } else if (flag === '--root') {\r\n78:       const value = args[i + 1]\r\n79:       if (typeof value !== 'string' || value === '') {\r\n80:         process.stderr.write('--root requires a directory\\n')\r\n81:         process.exitCode = 2\r\n82:         return\r\n83:       }\r\n84:       root = path.resolve(value)\r\n85:       i += 1\r\n86:     } else {\r\n87:       process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/gen-ci.mjs [--root <dir>] [--stdout]\\n`)\r\n88:       process.exitCode = 2\r\n89:       return\r\n90:     }\r\n91:   }\r\n92: \r\n93:   const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\r\n94:   let matrix\r\n95:   try {\r\n96:     matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\r\n97:   } catch {\r\n98:     process.stderr.write(`gen-ci: cannot read ${matrixFile}\\n`)\r\n99:     process.exitCode = 2\r\n100:     return\r\n101:   }\r\n102: \r\n103:   const text = renderCi(matrix)\r\n104:   if (toStdout) {\r\n105:     process.stdout.write(text)\r\n106:     return\r\n107:   }\r\n108: \r\n109:   const target = path.join(root, WORKFLOW_PATH)\r\n110:   fs.mkdirSync(path.dirname(target), { recursive: true })\r\n111:   fs.writeFileSync(target, text)\r\n112:   process.stdout.write(`gen-ci: wrote ${WORKFLOW_PATH.split(path.sep).join('/')}\\n`)\r\n113: }\r\n114: \r\n115: const invokedDirectly =\r\n116:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n117: \r\n118: if (invokedDirectly) main()\r\n.github/workflows/ci.yml\r\n1: # generated by scripts/gen-ci.mjs from scripts/ci-matrix.json - do not edit\r\n2: name: ci\r\n3: on: [push, pull_request]\r\n4: permissions:\r\n5:   contents: read\r\n6: jobs:\r\n7:   check:\r\n8:     strategy:\r\n9:       fail-fast: false\r\n10:       matrix:\r\n11:         include:\r\n12:           - name: ubuntu\r\n13:             runs_on: ubuntu-latest\r\n14:             node: 20\r\n15:           - name: ubuntu\r\n16:             runs_on: ubuntu-latest\r\n17:             node: 22\r\n18:           - name: windows\r\n19:             runs_on: windows-latest\r\n20:             node: 20\r\n21:           - name: windows\r\n22:             runs_on: windows-latest\r\n23:             node: 22\r\n24:           - name: macos\r\n25:             runs_on: macos-latest\r\n26:             node: 20\r\n27:           - name: macos\r\n28:             runs_on: macos-latest\r\n29:             node: 22\r\n30:     runs-on: ${{ matrix.runs_on }}\r\n31:     env:\r\n32:       CLIWORKER_RESULTS_DIR: ${{ github.workspace }}/test-results\r\n33:     steps:\r\n34:       - uses: actions/checkout@v4\r\n35:       - uses: actions/setup-node@v4\r\n36:         with:\r\n37:           node-version: ${{ matrix.node }}\r\n38:       - run: npm ci\r\n39:       - run: npm run check\r\n40:       - uses: actions/upload-artifact@v4\r\n41:         if: always()\r\n42:         with:\r\n43:           name: test-results-${{ matrix.name }}-node${{ matrix.node }}\r\n44:           path: |\r\n45:             test-results/files-executed.json\r\n46:             test-results/skips.jsonl\r\n47:           if-no-files-found: warn\r\n48:   perf:\r\n49:     runs-on: ubuntu-latest\r\n50:     continue-on-error: true\r\n51:     steps:\r\n52:       - uses: actions/checkout@v4\r\n53:       - uses: actions/setup-node@v4\r\n54:         with:\r\n55:           node-version: 22\r\n56:       - run: npm ci\r\n57:       - run: npm run perf\r\npackage.json\r\n1: {\r\n2:   \"name\": \"dsh-cliworker\",\r\n3:   \"version\": \"0.1.0\",\r\n4:   \"description\": \"DSH plugin: independent CLI/model layer for AgentLine (providers, models, availability, cost, selection).\",\r\n5:   \"type\": \"module\",\r\n6:   \"main\": \"lib/index.js\",\r\n7:   \"exports\": {\r\n8:     \".\": \"./lib/index.js\",\r\n9:     \"./package.json\": \"./package.json\"\r\n10:   },\r\n11:   \"scripts\": {\r\n12:     \"test\": \"node scripts/run-tests.mjs\",\r\n13:     \"check\": \"node scripts/check-fast.mjs\",\r\n14:     \"perf\": \"node scripts/run-tests.mjs --perf\",\r\n15:     \"snapshot:update\": \"node scripts/run-tests.mjs --update-snapshots\"\r\n16:   },\r\n17:   \"dsh\": {\r\n18:     \"bundle\": {\r\n19:       \"patch\": \"./cordis.patch.yml\"\r\n20:     }\r\n21:   },\r\n22:   \"files\": [\r\n23:     \"lib\",\r\n24:     \"cordis.patch.yml\",\r\n25:     \"dsh.plugin.json\",\r\n26:     \"README.md\"\r\n27:   ],\r\n28:   \"engines\": {\r\n29:     \"node\": \">=20\"\r\n30:   },\r\n31:   \"license\": \"MIT\"\r\n32: }\r\npackage-lock.json\r\n1: {\r\n2:   \"name\": \"dsh-cliworker\",\r\n3:   \"version\": \"0.1.0\",\r\n4:   \"lockfileVersion\": 3,\r\n5:   \"requires\": true,\r\n6:   \"packages\": {\r\n7:     \"\": {\r\n8:       \"name\": \"dsh-cliworker\",\r\n9:       \"version\": \"0.1.0\",\r\n10:       \"license\": \"MIT\",\r\n11:       \"engines\": {\r\n12:         \"node\": \">=20\"\r\n13:       }\r\n14:     }\r\n15:   }\r\n16: }\r\n","exit_code":0,"status":"completed"}}
