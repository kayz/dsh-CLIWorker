.stdout ?? ''}${result.stderr ?? ''}`\r\n33: }\r\n34: \r\n35: function freshCiRoot() {\r\n36:   const dir = tmp('cliworker-ci-')\r\n37:   fs.mkdirSync(path.join(dir, 'scripts'), { recursive: true })\r\n38:   fs.mkdirSync(path.join(dir, '.github', 'workflows'), { recursive: true })\r\n39:   fs.copyFileSync(path.join(SCRIPTS, 'ci-matrix.json'), path.join(dir, 'scripts', 'ci-matrix.json'))\r\n40:   fs.copyFileSync(\r\n41:     path.join(ROOT, '.github', 'workflows', 'ci.yml'),\r\n42:     path.join(dir, '.github', 'workflows', 'ci.yml')\r\n43:   )\r\n44:   return dir\r\n45: }\r\n46: \r\n47: function writeMatrix(dir, matrix) {\r\n48:   fs.writeFileSync(path.join(dir, 'scripts', 'ci-matrix.json'), `${JSON.stringify(matrix, null, 2)}\\n`)\r\n49: }\r\n50: \r\n51: function readMatrix(dir) {\r\n52:   return JSON.parse(fs.readFileSync(path.join(dir, 'scripts', 'ci-matrix.json'), 'utf8'))\r\n53: }\r\n54: \r\n55: function writeStep(dir, name, body) {\r\n56:   fs.writeFileSync(path.join(dir, name), `import fs from 'node:fs'\\n${body}\\n`)\r\n57: }\r\n58: \r\n59: const APPEND = (value) => `fs.appendFileSync(process.env.CW_LOG, '${value}\\\\n')`\r\n60: \r\n61: test('[AC-001] enumeration covers the seven roots and excludes fixtures, helpers and perf', () => {\r\n62:   const files = enumerateTestFiles(ROOT)\r\n63:   assert.ok(files.includes(SELF), `expected ${SELF} in ${files.join(',')}`)\r\n64:   assert.ok(files.includes('test/unit/select.test.mjs'))\r\n65:   assert.ok(files.includes('test/characterization/defects/a3-runner.test.mjs'))\r\n66:   for (const file of files) {\r\n67:     assert.ok(!/^test\\/(fixtures|helpers|perf)\\//.test(file), `excluded path leaked: ${file}`)\r\n68:   }\r\n69:   assert.deepEqual(findOrphans(ROOT), [])\r\n70: })\r\n71: \r\n72: test('[AC-001] verifyFullRun reports every kind of drift and rejects a filtered manifest', () => {\r\n73:   const enumerated = ['test/unit/a.test.mjs']\r\n74:   assert.deepEqual(verifyFullRun({ enumerated, manifest: { mode: 'full', files: [...enumerated] } }).errors, [])\r\n75: \r\n76:   const missing = verifyFullRun({\r\n77:     enumerated: ['test/unit/a.test.mjs', 'test/unit/b.test.mjs'],\r\n78:     manifest: { mode: 'full', files: ['test/unit/a.test.mjs'] },\r\n79:   })\r\n80:   assert.ok(missing.errors.some((error) => error.id === 'discovery.missing' && error.path === 'test/unit/b.test.mjs'))\r\n81: \r\n82:   const unexpected = verifyFullRun({\r\n83:     enumerated,\r\n84:     manifest: { mode: 'full', files: ['test/unit/a.test.mjs', 'test/fixtures/x.test.mjs'] },\r\n85:   })\r\n86:   assert.ok(unexpected.errors.some((error) => error.id === 'discovery.unexpected'))\r\n87: \r\n88:   const filtered = verifyFullRun({ enumerated, manifest: { mode: 'filtered', files: [...enumerated] } })\r\n89:   assert.deepEqual(filtered.errors.map((error) => error.id), ['discovery.mode_not_full'])\r\n90: \r\n91:   const empty = verifyFullRun({ enumerated: [], manifest: { mode: 'full', files: [] } })\r\n92:   assert.ok(empty.errors.some((error) => error.id === 'discovery.no_files'))\r\n93: })\r\n94: \r\n95: test('[AC-001] a full run on the ok fixture produces an exactly matching manifest', () => {\r\n96:   const out = tmp('cliworker-full-')\r\n97:   try {\r\n98:     const result = run([RUN_TESTS, '--root', OK_FIXTURE, '--out-dir', out])\r\n99:     assert.equal(result.status, 0, output(result))\r\n100:     assert.match(result.stdout, /run-tests: full/)\r\n101:     const manifest = JSON.parse(fs.readFileSync(path.join(out, 'files-executed.json'), 'utf8'))\r\n102:     assert.equal(manifest.mode, 'full')\r\n103:     assert.equal(manifest.filter, '')\r\n104:     assert.deepEqual(manifest.files, [\r\n105:       'test/flows/c.test.mjs',\r\n106:       'test/integration/b.test.mjs',\r\n107:       'test/unit/a.test.mjs',\r\n108:     ])\r\n109:     assert.ok(fs.existsSync(path.join(out, 'skips.jsonl')))\r\n110:   } finally {\r\n111:     fs.rmSync(out, { recursive: true, force: true })\r\n112:   }\r\n113: })\r\n114: \r\n115: test('[AC-001] a filtered run writes a filtered manifest and skips the comparison', () => {\r\n116:   const out = tmp('cliworker-filtered-')\r\n117:   try {\r\n118:     const result = run([RUN_TESTS, '--root', OK_FIXTURE, '--ac', 'AC-001', '--out-dir', out])\r\n119:     assert.equal(result.status, 0, output(result))\r\n120:     const manifest = JSON.parse(fs.readFileSync(path.join(out, 'files-executed.json'), 'utf8'))\r\n121:     assert.equal(manifest.mode, 'filtered')\r\n122:     assert.equal(manifest.filter, 'AC-001')\r\n123:     assert.deepEqual(manifest.files, ['test/unit/a.test.mjs'])\r\n124:   } finally {\r\n125:     fs.rmSync(out, { recursive: true, force: true })\r\n126:   }\r\n127: })\r\n128: \r\n129: test('[AC-001] the discovery self-test passes end to end', () => {\r\n130:   const result = run([CHECK_DISCOVERY])\r\n131:   assert.equal(result.status, 0, output(result))\r\n132:   assert.match(result.stdout, /check-test-discovery: ok/)\r\n133: })\r\n134: \r\n135: test('[AC-001] platformTest writes a cliworker.skip/v1 record when the requirement is unmet', () => {\r\n136:   const dir = tmp('cliworker-skip-')\r\n137:   try {\r\n138:     const probe = path.join(dir, 'probe.test.mjs')\r\n139:     const gateUrl = pathToFileURL(path.join(ROOT, 'test', 'helpers', 'platform-gate.mjs')).href\r\n140:     fs.writeFileSync(\r\n141:       probe,\r\n142:       [\r\n143:         `import { platformTest } from ${JSON.stringify(gateUrl)}`,\r\n144:         \"platformTest('[probe] records a skip', { ac: 'AC-001', requires: 'not-a-platform', file: import.meta.url, reason: 'probe skip' }, () => {\",\r\n145:         \"  throw new Error('the body must not run')\",\r\n146:         '})',\r\n147:         '',\r\n148:       ].join('\\n')\r\n149:     )\r\n150: \r\n151:     const result = run([probe], { env: { ...process.env, CLIWORKER_RESULTS_DIR: dir } })\r\n152:     assert.equal(result.status, 0, output(result))\r\n153: \r\n154:     const lines = fs.readFileSync(path.join(dir, 'skips.jsonl'), 'utf8').trim().split('\\n')\r\n155:     assert.equal(lines.length, 1)\r\n156:     const record = JSON.parse(lines[0])\r\n157:     assert.equal(record.schema, 'cliworker.skip/v1')\r\n158:     assert.equal(record.test, '[probe] records a skip')\r\n159:     assert.match(record.file, /probe\\.test\\.mjs$/)\r\n160:     assert.equal(record.ac, 'AC-001')\r\n161:     assert.equal(record.requires, 'not-a-platform')\r\n162:     assert.equal(record.platform, process.platform)\r\n163:     assert.equal(record.node, process.version)\r\n164:     assert.equal(record.reason, 'probe skip')\r\n165:     assert.ok(!Number.isNaN(Date.parse(record.at)))\r\n166:     assert.deepEqual(Object.keys(record).sort(), [\r\n167:       'ac',\r\n168:       'at',\r\n169:       'file',\r\n170:       'node',\r\n171:       'platform',\r\n172:       'reason',\r\n173:       'requires',\r\n174:       'schema',\r\n175:       'test',\r\n176:     ])\r\n177:   } finally {\r\n178:     fs.rmSync(dir, { recursive: true, force: true })\r\n179:   }\r\n180: })\r\n181: \r\n182: test('[AC-002] check-ci accepts the committed workflow', () => {\r\n183:   const result = run([CHECK_CI])\r\n184:   assert.equal(result.status, 0, output(result))\r\n185:   assert.match(result.stdout, /check-ci: ok/)\r\n186: })\r\n187: \r\n188: test('[AC-002] check-ci rejects a stale, malformed or unblocked matrix', () => {\r\n189:   const stale = freshCiRoot()\r\n190:   try {\r\n191:     fs.appendFileSync(path.join(stale, '.github', 'workflows', 'ci.yml'), '# x\\n')\r\n192:     const result = run([CHECK_CI, '--root', stale])\r\n193:     assert.equal(result.status, 1)\r\n194:     assert.match(output(result), /ci\\.stale/)\r\n195:   } finally {\r\n196:     fs.rmSync(stale, { recursive: true, force: true })\r\n197:   }\r\n198: \r\n199:   const oneChar = freshCiRoot()\r\n200:   try {\r\n201:     const file = path.join(oneChar, '.github', 'workflows', 'ci.yml')\r\n202:     const text = fs.readFileSync(file, 'utf8')\r\n203:     fs.writeFileSync(file, text.replace('name: ci', 'name: CJ'))\r\n204:     const result = run([CHECK_CI, '--root', oneChar])\r\n205:     assert.equal(result.status, 1)\r\n206:     assert.match(output(result), /ci\\.stale/)\r\n207:   } finally {\r\n208:     fs.rmSync(oneChar, { recursive: true, force: true })\r\n209:   }\r\n210: \r\n211:   const missing = freshCiRoot()\r\n212:   try {\r\n213:     fs.rmSync(path.join(missing, '.github', 'workflows', 'ci.yml'))\r\n214:     const result = run([CHECK_CI, '--root', missing])\r\n215:     assert.equal(result.status, 1)\r\n216:     assert.match(output(result), /ci\\.missing/)\r\n217:   } finally {\r\n218:     fs.rmSync(missing, { recursive: true, force: true })\r\n219:   }\r\n220: \r\n221:   const blocking = freshCiRoot()\r\n222:   try {\r\n223:     const matrix = readMatrix(blocking)\r\n224:     matrix.perf.blocking = true\r\n225:     writeMatrix(blocking, matrix)\r\n226:     const result = run([CHECK_CI, '--root', blocking])\r\n227:     assert.equal(result.status, 1)\r\n228:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n229:   } finally {\r\n230:     fs.rmSync(blocking, { recursive: true, force: true })\r\n231:   }\r\n232: \r\n233:   const oneNode = freshCiRoot()\r\n234:   try {\r\n235:     const matrix = readMatrix(oneNode)\r\n236:     matrix.node = [20]\r\n237:     writeMatrix(oneNode, matrix)\r\n238:     const result = run([CHECK_CI, '--root', oneNode])\r\n239:     assert.equal(result.status, 1)\r\n240:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n241:   } finally {\r\n242:     fs.rmSync(oneNode, { recursive: true, force: true })\r\n243:   }\r\n244: \r\n245:   const noWindows = freshCiRoot()\r\n246:   try {\r\n247:     const matrix = readMatrix(noWindows)\r\n248:     matrix.os = matrix.os.filter((item) => item.name !== 'windows')\r\n249:     writeMatrix(noWindows, matrix)\r\n250:     const result = run([CHECK_CI, '--root', noWindows])\r\n251:     assert.equal(result.status, 1)\r\n252:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n253:   } finally {\r\n254:     fs.rmSync(noWindows, { recursive: true, force: true })\r\n255:   }\r\n256: })\r\n257: \r\n258: test('[AC-003] check-fast stops at the first failure and propagates its exit code', () => {\r\n259:   const dir = tmp('cliworker-fast-fail-')\r\n260:   const log = path.join(dir, 'log.txt')\r\n261:   try {\r\n262:     writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n263:     writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\r\n264:     writeStep(dir, 'check-c.mjs', APPEND('c'))\r\n265:     writeStep(dir, 'final.mjs', APPEND('final'))\r\n266: \r\n267:     const result = run([CHECK_FAST], {\r\n268:       env: {\r\n269:         ...process.env,\r\n270:         CW_LOG: log,\r\n271:         CLIWORKER_TEST_CHECK_DIR: dir,\r\n272:         CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n273:       },\r\n274:     })\r\n275:     assert.equal(result.status, 7, output(result))\r\n276:     assert.match(output(result), /check-b\\.mjs/)\r\n277:     assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb')\r\n278:   } finally {\r\n279:     fs.rmSync(dir, { recursive: true, force: true })\r\n280:   }\r\n281: })\r\n282: \r\n283: test('[AC-003] check-fast runs the steps in code point order and skips its own file', () => {\r\n284:   const dir = tmp('cliworker-fast-ok-')\r\n285:   const log = path.join(dir, 'log.txt')\r\n286:   try {\r\n287:     writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n288:     writeStep(dir, 'check-b.mjs', APPEND('b'))\r\n289:     writeStep(dir, 'check-c.mjs', APPEND('c'))\r\n290:     writeStep(dir, 'check-fast.mjs', APPEND('SELF'))\r\n291:     writeStep(dir, 'final.mjs', APPEND('final'))\r\n292: \r\n293:     const result = run([CHECK_FAST], {\r\n294:       env: {\r\n295:         ...process.env,\r\n296:         CW_LOG: log,\r\n297:         CLIWORKER_TEST_CHECK_DIR: dir,\r\n298:         CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n299:       },\r\n300:     })\r\n301:     assert.equal(result.status, 0, output(result))\r\n302:     assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb\\nc\\nfinal')\r\n303:     assert.match(result.stdout, /==> npm test/)\r\n304:     assert.ok(!result.stdout.includes('==> check-fast.mjs'))\r\n305:   } finally {\r\n306:     fs.rmSync(dir, { recursive: true, force: true })\r\n307:   }\r\n308: })\r\n309: \r\n310: platformTest(\r\n311:   '[AC-003] the pwsh wrapper forwards the same exit code with a single node call',\r\n312:   { ac: 'AC-003', requires: 'pwsh', file: import.meta.url },\r\n313:   () => {\r\n314:     const dir = tmp('cliworker-fast-pwsh-')\r\n315:     const log = path.join(dir, 'log.txt')\r\n316:     try {\r\n317:       writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n318:       writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\r\n319:       writeStep(dir, 'final.mjs', APPEND('final'))\r\n320: \r\n321:       const result = spawnSync('pwsh', ['-NoProfile', '-File', CHECK_FAST_PS1], {\r\n322:         encoding: 'utf8',\r\n323:         env: {\r\n324:           ...process.env,\r\n325:           CW_LOG: log,\r\n326:           CLIWORKER_TEST_CHECK_DIR: dir,\r\n327:           CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n328:         },\r\n329:       })\r\n330:       assert.equal(result.status, 7, output(result))\r\n331:       assert.match(output(result), /check-b\\.mjs/)\r\n332:     } finally {\r\n333:       fs.rmSync(dir, { recursive: true, force: true })\r\n334:     }\r\n335: \r\n336:     const lines = fs\r\n337:       .readFileSync(CHECK_FAST_PS1, 'utf8')\r\n338:       .split('\\n')\r\n339:       .filter((line) => line.trim() !== '' && !line.trim().startsWith('#'))\r\n340:     assert.ok(lines.length <= 3, `check-fast.ps1 must stay a thin wrapper, got ${lines.length} lines`)\r\n341:     assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /\\$LASTEXITCODE/)\r\n342:     assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /check-fast\\.mjs/)\r\n343:   }\r\n344: )\r\ntest/unit/traceability.test.mjs\r\n1: import test from 'node:test'\r\n2: import assert from 'node:assert/strict'\r\n3: import fs from 'node:fs'\r\n4: import os from 'node:os'\r\n5: import path from 'node:path'\r\n6: import { spawnSync } from 'node:child_process'\r\n7: import { fileURLToPath } from 'node:url'\r\n8: \r\n9: import { extractTitles, mergeShards, validateIndex } from '../../scripts/check-traceability.mjs'\r\n10: \r\n11: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n12: const ROOT = path.resolve(HERE, '..', '..')\r\n13: const CHECK = path.join(ROOT, 'scripts', 'check-traceability.mjs')\r\n14: const INDEX_FILE = path.join(ROOT, 'contracts', 'spec', 'ac-index.json')\r\n15: const FIXTURES = path.join(ROOT, 'test', 'fixtures', 'traceability')\r\n16: const FIXTURE_INDEX = path.join(FIXTURES, 'ac-index.json')\r\n17: \r\n18: function readIndex() {\r\n19:   return JSON.parse(fs.readFileSync(INDEX_FILE, 'utf8'))\r\n20: }\r\n21: \r\n22: function entryOf(index, ac) {\r\n23:   return index.acs.find((item) => item.ac === ac)\r\n24: }\r\n25: \r\n26: function ids(errors) {\r\n27:   return errors.map((error) => error.id)\r\n28: }\r\n29: \r\n30: function runJson(root, extra = []) {\r\n31:   const result = spawnSync(\r\n32:     process.execPath,\r\n33:     [CHECK, '--root', root, '--index', FIXTURE_INDEX, '--json', ...extra],\r\n34:     { encoding: 'utf8' }\r\n35:   )\r\n36:   assert.ok(result.stdout, `expected JSON on stdout, got ${result.stdout}${result.stderr}`)\r\n37:   return { status: result.status, payload: JSON.parse(result.stdout) }\r\n38: }\r\n39: \r\n40: test('[AC-004] the committed AC index validates cleanly', () => {\r\n41:   const index = readIndex()\r\n42:   assert.equal(index.acs.length, 74)\r\n43:   assert.deepEqual(validateIndex(index), [])\r\n44: })\r\n45: \r\n46: test('[AC-004] index.count rejects missing, duplicated and reordered entries', () => {\r\n47:   const missing = readIndex()\r\n48:   missing.acs.pop()\r\n49:   assert.ok(ids(validateIndex(missing)).includes('index.count'))\r\n50: \r\n51:   const duplicated = readIndex()\r\n52:   duplicated.acs[73] = { ...duplicated.acs[0] }\r\n53:   assert.ok(ids(validateIndex(duplicated)).includes('index.count'))\r\n54: \r\n55:   const reordered = readIndex()\r\n56:   const first = reordered.acs[0]\r\n57:   reordered.acs[0] = reordered.acs[1]\r\n58:   reordered.acs[1] = first\r\n59:   assert.ok(ids(validateIndex(reordered)).includes('index.count'))\r\n60: })\r\n61: \r\n62: test('[AC-004] index.owner and index.milestone reject unknown values', () => {\r\n63:   const owner = readIndex()\r\n64:   entryOf(owner, 'AC-001').owner = 'T-1'\r\n65:   assert.ok(ids(validateIndex(owner)).includes('index.owner'))\r\n66: \r\n67:   const milestone = readIndex()\r\n68:   entryOf(milestone, 'AC-001').milestone = 'M6'\r\n69:   assert.ok(ids(validateIndex(milestone)).includes('index.milestone'))\r\n70: })\r\n71: \r\n72: test('[AC-004] index.levels and index.baseline reject empty, unknown and duplicate values', () => {\r\n73:   const emptyLevels = readIndex()\r\n74:   entryOf(emptyLevels, 'AC-001').levels = []\r\n75:   assert.ok(ids(validateIndex(emptyLevels)).includes('index.levels'))\r\n76: \r\n77:   const duplicateLevels = readIndex()\r\n78:   entryOf(duplicateLevels, 'AC-001').levels = ['unit', 'unit']\r\n79:   assert.ok(ids(validateIndex(duplicateLevels)).includes('index.levels'))\r\n80: \r\n81:   const unknownLevel = readIndex()\r\n82:   entryOf(unknownLevel, 'AC-001').levels = ['nope']\r\n83:   assert.ok(ids(validateIndex(unknownLevel)).includes('index.levels'))\r\n84: \r\n85:   const emptyBaseline = readIndex()\r\n86:   entryOf(emptyBaseline, 'AC-001').baseline = []\r\n87:   assert.ok(ids(validateIndex(emptyBaseline)).includes('index.baseline'))\r\n88: \r\n89:   const duplicateBaseline = readIndex()\r\n90:   entryOf(duplicateBaseline, 'AC-001').baseline = ['linux', 'linux']\r\n91:   assert.ok(ids(validateIndex(duplicateBaseline)).includes('index.baseline'))\r\n92: \r\n93:   const unknownBaseline = readIndex()\r\n94:   entryOf(unknownBaseline, 'AC-001').baseline = ['beos']\r\n95:   assert.ok(ids(validateIndex(unknownBaseline)).includes('index.baseline'))\r\n96: })\r\n97: \r\n98: test('[AC-004] index.baseline_incompatible rejects code levels on real-smoke and smoke on win32', () => {\r\n99:   const codeOnRealSmoke = readIndex()\r\n100:   entryOf(codeOnRealSmoke, 'AC-001').baseline = ['real-smoke']\r\n101:   assert.ok(ids(validateIndex(codeOnRealSmoke)).includes('index.baseline_incompatible'))\r\n102: \r\n103:   const smokeOnWin32 = readIndex()\r\n104:   entryOf(smokeOnWin32, 'AC-038').baseline = ['win32']\r\n105:   assert.ok(ids(validateIndex(smokeOnWin32)).includes('index.baseline_incompatible'))\r\n106: })\r\n107: \r\n108: test('[AC-004] index.schema rejects a wrong schema and entries with missing or extra keys', () => {\r\n109:   const wrongSchema = readIndex()\r\n110:   wrongSchema.schema = 'cliworker.ac-index/v2'\r\n111:   assert.ok(ids(validateIndex(wrongSchema)).includes('index.schema'))\r\n112: \r\n113:   const missingKey = readIndex()\r\n114:   delete entryOf(missingKey, 'AC-001').baseline\r\n115:   assert.ok(ids(validateIndex(missingKey)).includes('index.schema'))\r\n116: \r\n117:   const extraKey = readIndex()\r\n118:   entryOf(extraKey, 'AC-001').note = 'extra'\r\n119:   assert.ok(ids(validateIndex(extraKey)).includes('index.schema'))\r\n120: })\r\n121: \r\n122: test('[AC-004] shard fixtures cover pass, duplicate, not-owner, missing-file, missing-title and baseline', () => {\r\n123:   const cases = [\r\n124:     ['ok', 0, null],\r\n125:     ['duplicate', 1, 'shard.duplicate'],\r\n126:     ['not-owner', 1, 'shard.not_owner'],\r\n127:     ['missing-file', 1, 'shard.missing_file'],\r\n128:     ['missing-title', 1, 'shard.missing_title'],\r\n129:     ['baseline-in-shard', 1, 'shard.baseline_forbidden'],\r\n130:   ]\r\n131: \r\n132:   for (const [name, status, expectedId] of cases) {\r\n133:     const { status: actual, payload } = runJson(path.join(FIXTURES, name))\r\n134:     assert.equal(actual, status, `${name}: ${JSON.stringify(payload)}`)\r\n135:     assert.equal(payload.ok, status === 0, name)\r\n136:     if (expectedId) {\r\n137:       assert.ok(\r\n138:         payload.errors.some((error) => error.id === expectedId),\r\n139:         `${name} should report ${expectedId}, got ${JSON.stringify(payload.errors)}`\r\n140:       )\r\n141:     }\r\n142:   }\r\n143: \r\n144:   const { payload: duplicate } = runJson(path.join(FIXTURES, 'duplicate'))\r\n145:   assert.deepEqual([...new Set(duplicate.errors.map((error) => error.id))].sort(), [\r\n146:     'shard.duplicate',\r\n147:     'shard.not_owner',\r\n148:   ])\r\n149: })\r\n150: \r\n151: test('[AC-004] mergeShards treats ACs without a shard as planned', () => {\r\n152:   const index = readIndex()\r\n153:   const merged = mergeShards({ root: ROOT, index })\r\n154:   assert.deepEqual(merged.errors, [])\r\n155:   assert.equal(merged.acs['AC-001'], 'covered')\r\n156:   assert.equal(merged.acs['AC-004'], 'covered')\r\n157:   assert.equal(merged.acs['AC-074'], 'covered')\r\n158:   assert.equal(merged.acs['AC-005'], 'planned')\r\n159: })\r\n160: \r\n161: test('[AC-004] extractTitles ignores skipped titles and still reads platformTest titles', () => {\r\n162:   const source = [\r\n163:     \"test('[AC-004] plain', () => {})\",\r\n164:     \"test.skip('[AC-004] skipped', () => {})\",\r\n165:     \"test.todo('[AC-004] todo')\",\r\n166:     \"describe('[AC-004] group', () => {})\",\r\n167:     \"platformTest('[AC-004] gated', { requires: 'linux' }, () => {})\",\r\n168:     \"myTest('[AC-004] not a test call')\",\r\n169:   ].join('\\n')\r\n170: \r\n171:   const titles = extractTitles(source)\r\n172:   assert.deepEqual(titles.map((item) => item.kind), ['plain', 'skip', 'todo', 'plain', 'plain'])\r\n173:   assert.ok(titles.every((item) => item.title.includes('[AC-004]')))\r\n174: })\r\n175: \r\n176: test('[AC-004] the task graph cross-check flags a wrong owner and accepts the real graph', () => {\r\n177:   const index = readIndex()\r\n178:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-graph-'))\r\n179:   try {\r\n180:     const build = (overrideOwner) => {\r\n181:       const tasks = new Map()\r\n182:       for (const item of index.acs) {\r\n183:         const owner = item.ac === 'AC-001' && overrideOwner ? overrideOwner : item.owner\r\n184:         if (!tasks.has(owner)) tasks.set(owner, { id: owner, milestone: item.milestone, acceptance: [] })\r\n185:         tasks.get(owner).acceptance.push(item.ac)\r\n186:       }\r\n187:       return {\r\n188:         schema: 'agentline.taskgraph/v1',\r\n189:         acceptance: index.acs.map((item) => ({ id: item.ac, levels: item.levels })),\r\n190:         tasks: [...tasks.values()],\r\n191:       }\r\n192:     }\r\n193: \r\n194:     const wrongOwner = path.join(dir, 'wrong-owner.json')\r\n195:     fs.writeFileSync(wrongOwner, JSON.stringify(build('T-999')))\r\n196:     const flagged = runJson(ROOT, ['--task-graph', wrongOwner])\r\n197:     assert.equal(flagged.status, 1)\r\n198:     assert.ok(flagged.payload.errors.some((error) => error.id === 'graph.mismatch'))\r\n199: \r\n200:     const consistent = path.join(dir, 'consistent.json')\r\n201:     fs.writeFileSync(consistent, JSON.stringify(build(null)))\r\n202:     const clean = runJson(ROOT, ['--task-graph', consistent])\r\n203:     assert.equal(clean.status, 0, JSON.stringify(clean.payload.errors))\r\n204:     assert.ok(!clean.payload.errors.some((error) => error.id === 'graph.mismatch'))\r\n205:   } finally {\r\n206:     fs.rmSync(dir, { recursive: true, force: true })\r\n207:   }\r\n208: })\r\ntest/unit/milestone-gate.test.mjs\r\n1: import test from 'node:test'\r\n2: import assert from 'node:assert/strict'\r\n3: import path from 'node:path'\r\n4: import { spawnSync } from 'node:child_process'\r\n5: import { fileURLToPath } from 'node:url'\r\n6: \r\n7: import { extractTitles } from '../../scripts/check-traceability.mjs'\r\n8: \r\n9: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n10: const ROOT = path.resolve(HERE, '..', '..')\r\n11: const GATE = path.join(ROOT, 'scripts', 'milestone-gate.mjs')\r\n12: const DEFECTS = path.join(ROOT, 'scripts', 'check-defects.mjs')\r\n13: const FIXTURES = path.join(ROOT, 'test', 'fixtures', 'milestone-gate')\r\n14: const M2_PLANNED = path.join(FIXTURES, 'm2-planned')\r\n15: const M4_NOCACHE = path.join(FIXTURES, 'm4-nocache')\r\n16: \r\n17: function runGate(milestone, root) {\r\n18:   return spawnSync(process.execPath, [GATE, '--milestone', milestone, '--root', root], { encoding: 'utf8' })\r\n19: }\r\n20: \r\n21: function runDefects(args) {\r\n22:   return spawnSync(process.execPath, [DEFECTS, ...args], { encoding: 'utf8' })\r\n23: }\r\n24: \r\n25: function output(result) {\r\n26:   return `${result.stdout ?? ''}${result.stderr ?? ''}`\r\n27: }\r\n28: \r\n29: test('[AC-074] m2-planned: M1 passes while M2 is blocked by a planned AC and a missing fix', () => {\r\n30:   const m1 = runGate('M1', M2_PLANNED)\r\n31:   assert.equal(m1.status, 0, output(m1))\r\n32:   assert.match(m1.stdout, /milestone-gate M1: PASS/)\r\n33: \r\n34:   const m2 = runGate('M2', M2_PLANNED)\r\n35:   assert.equal(m2.status, 1, output(m2))\r\n36:   assert.match(m2.stdout, /milestone-gate M2: BLOCKED/)\r\n37:   assert.match(m2.stdout, /gate\\.ac_not_covered[^\\n]*AC-026/)\r\n38:   assert.match(m2.stdout, /defects\\.missing_fixed[^\\n]*a5-shell/)\r\n39:   assert.ok(!/gate\\.ac_not_covered[^\\n]*AC-001/.test(m2.stdout))\r\n40: })\r\n41: \r\n42: test('[AC-074] m4-nocache: M3 passes while M4 is blocked only by the missing fix', () => {\r\n43:   const m3 = runGate('M3', M4_NOCACHE)\r\n44:   assert.equal(m3.status, 0, output(m3))\r\n45:   assert.match(m3.stdout, /milestone-gate M3: PASS/)\r\n46: \r\n47:   const m4 = runGate('M4', M4_NOCACHE)\r\n48:   assert.equal(m4.status, 1, output(m4))\r\n49:   assert.match(m4.stdout, /milestone-gate M4: BLOCKED/)\r\n50:   assert.match(m4.stdout, /defects\\.missing_fixed[^\\n]*a5-nocache/)\r\n51:   assert.ok(!/gate\\.ac_not_covered/.test(m4.stdout))\r\n52: })\r\n53: \r\n54: test('[AC-074] check-defects default mode only demands a fix for covered ACs', () => {\r\n55:   const planned = runDefects(['--root', M2_PLANNED])\r\n56:   assert.equal(planned.status, 0, output(planned))\r\n57:   assert.match(planned.stdout, /check-defects: ok/)\r\n58: \r\n59:   const covered = runDefects(['--root', M4_NOCACHE])\r\n60:   assert.equal(covered.status, 1, output(covered))\r\n61:   assert.match(covered.stdout, /defects\\.missing_fixed[^\\n]*a5-nocache/)\r\n62: })\r\n63: \r\n64: test('[AC-074] check-defects --milestone demands a fix for every defect up to that milestone', () => {\r\n65:   const m1 = runDefects(['--milestone', 'M1', '--root', M2_PLANNED])\r\n66:   assert.equal(m1.status, 0, output(m1))\r\n67:   assert.ok(!/defects\\.set_mismatch/.test(m1.stdout))\r\n68:   assert.ok(!/defects\\.missing_fixed/.test(m1.stdout))\r\n69: \r\n70:   const m2 = runDefects(['--milestone', 'M2', '--root', M2_PLANNED])\r\n71:   assert.equal(m2.status, 1, output(m2))\r\n72:   assert.ok(!/defects\\.set_mismatch/.test(m2.stdout))\r\n73:   assert.match(m2.stdout, /defects\\.missing_fixed/)\r\n74: \r\n75:   const m5 = runDefects(['--milestone', 'M5', '--root', M2_PLANNED])\r\n76:   assert.equal(m5.status, 1, output(m5))\r\n77:   assert.match(m5.stdout, /defects\\.set_mismatch/)\r\n78: \r\n79:   const invalid = runDefects(['--milestone', 'M9', '--root', M2_PLANNED])\r\n80:   assert.equal(invalid.status, 2, output(invalid))\r\n81: })\r\n82: \r\n83: test('[AC-074] the milestone gate refuses to run without a valid milestone', () => {\r\n84:   const missing = spawnSync(process.execPath, [GATE, '--root', M2_PLANNED], { encoding: 'utf8' })\r\n85:   assert.equal(missing.status, 2, output(missing))\r\n86: \r\n87:   const invalid = spawnSync(process.execPath, [GATE, '--milestone', 'M9', '--root', M2_PLANNED], {\r\n88:     encoding: 'utf8',\r\n89:   })\r\n90:   assert.equal(invalid.status, 2, output(invalid))\r\n91: })\r\n92: \r\n93: test('[AC-074] extractTitles only counts plain titles for [fixed] and [repro]', () => {\r\n94:   const source = [\r\n95:     \"test('[repro] broken today', () => {})\",\r\n96:     \"test('[fixed] repaired', () => {})\",\r\n97:     \"test.skip('[fixed] not a fix', () => {})\",\r\n98:     \"test.todo('[fixed] still todo')\",\r\n99:   ].join('\\n')\r\n100: \r\n101:   const titles = extractTitles(source)\r\n102:   const plain = titles.filter((item) => item.kind === 'plain').map((item) => item.title)\r\n103:   assert.ok(plain.some((title) => title.startsWith('[fixed]')))\r\n104:   assert.ok(plain.some((title) => title.startsWith('[repro]')))\r\n105:   assert.equal(plain.filter((title) => title.startsWith('[fixed]')).length, 1)\r\n106: })\r\n","exit_code":0,"status":"completed"}}
