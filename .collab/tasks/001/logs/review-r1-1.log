n11: }\r\n12: \r\n13: function which(binary) {\r\n14:   const dirs = (process.env.PATH || '').split(path.delimiter)\r\n15:   const candidates = new Set([binary.toLowerCase()])\r\n16:   for (const ext of pathExtensions()) candidates.add(`${binary}${ext}`.toLowerCase())\r\n17: \r\n18:   for (const dir of dirs) {\r\n19:     if (!dir) continue\r\n20:     for (const name of candidates) {\r\n21:       const candidate = path.join(dir, name)\r\n22:       if (fs.existsSync(candidate)) return candidate\r\n23:     }\r\n24:     // Windows app execution aliases (for example the PowerShell store alias) are reparse\r\n25:     // points that reject stat with EACCES, so existsSync cannot see them; the directory\r\n26:     // listing still can. This keeps the probe child-process free.\r\n27:     let entries\r\n28:     try {\r\n29:       entries = fs.readdirSync(dir)\r\n30:     } catch {\r\n31:       continue\r\n32:     }\r\n33:     for (const entry of entries) {\r\n34:       if (candidates.has(entry.toLowerCase())) return path.join(dir, entry)\r\n35:     }\r\n36:   }\r\n37:   return null\r\n38: }\r\n39: \r\n40: export function satisfies(requires, opts = {}) {\r\n41:   const platform = opts.platform ?? process.platform\r\n42:   switch (requires) {\r\n43:     case 'win32':\r\n44:     case 'darwin':\r\n45:     case 'linux':\r\n46:       return platform === requires\r\n47:     case 'pwsh':\r\n48:       return which('pwsh') !== null\r\n49:     case 'secret-tool':\r\n50:       return which('secret-tool') !== null\r\n51:     case 'security':\r\n52:       return which('security') !== null\r\n53:     case 'wsl': {\r\n54:       if (platform === 'win32') {\r\n55:         const systemRoot = process.env.SystemRoot || process.env.windir || 'C:\\\\Windows'\r\n56:         return fs.existsSync(path.join(systemRoot, 'System32', 'wsl.exe'))\r\n57:       }\r\n58:       return platform === 'linux' && Boolean(process.env.WSL_DISTRO_NAME)\r\n59:     }\r\n60:     default:\r\n61:       return false\r\n62:   