els must be a non-empty array of strings')\r\n79:     } else {\r\n80:       const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\r\n81:       const duplicates = entry.levels.filter((level, i) => entry.levels.indexOf(level) !== i)\r\n82:       if (unknown.length > 0) push('index.levels', entry.ac, `unknown level(s): ${unknown.join(',')}`)\r\n83:       if (duplicates.length > 0) push('index.levels', entry.ac, `duplicate level(s): ${duplicates.join(',')}`)\r\n84:     }\r\n85: \r\n86:     if (!isStringArray(entry.baseline) || entry.baseline.length === 0) {\r\n87:       push('index.baseline', entry.ac, 'baseline must be a non-empty array of strings')\r\n88:     } else {\r\n89:       const unknown = entry.baseline.filter((base) => !BASELINES.includes(base))\r\n90:       const duplicates = entry.baseline.filter((base, i) => entry.baseline.indexOf(base) !== i)\r\n91:       if (unknown.length > 0) push('index.baseline', entry.ac, `unknown baseline(s): ${unknown.join(',')}`)\r\n92:       if (duplicates.length > 0) push('index.baseline', entry.ac, `duplicate baseline(s): ${duplicates.join(',')}`)\r\n93:     }\r\n94: \r\n95:     if (isStringArray(entry.levels) && isStringArray(entry.baseline)) {\r\n96:       const hasCodeLevel = entry.levels.some((level) => NON_SMOKE_LEVELS.includes(level))\r\n97:       const hasSmoke = entry.levels.includes('smoke')\r\n98:       const hasRealSmoke = entry.baseline.includes('real-smoke')\r\n99:       const hasNativeOnly = entry.baseline.includes('win32') || entry.baseline.includes('darwin')\r\n100:       if (hasCodeLevel && hasRealSmoke) {\r\n101:         push('index.baseline_incompatible', entry.ac, 'real-smoke baseline cannot back code levels')\r\n102:       }\r\n103:       if (hasSmoke && hasNativeOnly) {\r\n104:         push('index.baseline_incompatible', entry.ac, 'smoke levels only allow linux or real-smoke baselines')\r\n105:       }\r\n106:     }\r\n107:   }\r\n108: \r\n109:   const expected = expectedAcs()\r\n110:   const got = index.acs.map((entry) => (entry && typeof entry === 'object' ? entry.ac : undefined))\r\n111:   const inOrder = got.length === expected.length && got.every((ac, i) => ac === expected[i])\r\n112:   if (!inOrder) {\r\n113:     const seen = new Set()\r\n114:     const duplicates = new Set()\r\n115:     for (const ac of got) {\r\n116:       if (seen.has(ac)) duplicates.add(ac)\r\n117:       seen.add(ac)\r\n118:     }\r\n119:     const parts = [`expected exactly ${expected[0]}..${expected[expected.length - 1]} in order`]\r\n120:     parts.push(`got ${got.length} entries`)\r\n121:     if (duplicates.size > 0) parts.push(`duplicates: ${[...duplicates].join(',')}`)\r\n122:     push('index.count', undefined, parts.join(', '))\r\n123:   }\r\n124: \r\n125:   return errors\r\n126: }\r\n127: \r\n128: export function mergeShards({ root, index }) {\r\n129:   const errors = []\r\n130:   const shardDir = path.join(root, 'test', 'traceability')\r\n131:   const owners = new Map()\r\n132:   const indexAcs = []\r\n133:   for (const entry of index?.acs ?? []) {\r\n134:     if (!entry || typeof entry !== 'object') continue\r\n135:     owners.set(entry.ac, entry.owner)\r\n136:     indexAcs.push(entry.ac)\r\n137:   }\r\n138: \r\n139:   let names = []\r\n140:   try {\r\n141:     names = fs.readdirSync(shardDir).filter((name) => name.endsWith('.json')).sort()\r\n142:   } catch {\r\n143:     names = []\r\n144:   }\r\n145: \r\n146:   const declared = new Map()\r\n147: \r\n148:   for (const name of names) {\r\n149:     const rel = `test/traceability/${name}`\r\n150:     let shard\r\n151:     try {\r\n152:       shard = JSON.parse(fs.readFileSync(path.join(shardDir, name), 'utf8'))\r\n153:     } catch {\r\n154:       errors.push({ id: 'shard.schema', file: rel, detail: 'shard is not valid JSON' })\r\n155:       continue\r\n156:     }\r\n157:     if (!shard || typeof shard !== 'object' || Array.isArray(shard)) {\r\n158:       errors.push({ id: 'shard.schema', file: rel, detail: 'shard must be a JSON object' })\r\n159:       continue\r\n160:     }\r\n161: \r\n162:     const task = name.replace(/\\.json$/, '')\r\n163:     if (typeof shard.task !== 'string' || shard.task !== task) {\r\n164:       errors.push({ id: 'shard.schema', file: rel, detail: `task must be \"${task}\"` })\r\n165:     }\r\n166:     if (Object.prototype.hasOwnProperty.call(shard, 'baseline')) {\r\n167:       errors.push({ id: 'shard.baseline_forbidden', file: rel, detail: 'shard must not declare baseline' })\r\n168:     }\r\n169:     if (!Array.isArray(shard.entries)) {\r\n170:       errors.push({ id: 'shard.schema', file: rel, detail: 'entries must be an array' })\r\n171:       continue\r\n172:     }\r\n173: \r\n174:     for (const entry of shard.entries) {\r\n175:       if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\r\n176:         errors.push({ id: 'shard.schema', file: rel, detail: 'every entry must be a JSON object' })\r\n177:         continue\r\n178:       }\r\n179:       if (Object.prototype.hasOwnProperty.call(entry, 'baseline')) {\r\n180:         errors.push({\r\n181:           id: 'shard.baseline_forbidden',\r\n182:           ac: typeof entry.ac === 'string' ? entry.ac : undefined,\r\n183:           file: rel,\r\n184:           detail: 'entry must not declare baseline',\r\n185:         })\r\n186:       }\r\n187: \r\n188:       const ac = entry.ac\r\n189:       const status = entry.status\r\n190:       const files = entry.files\r\n191:       if (\r\n192:         typeof ac !== 'string' ||\r\n193:         ac === '' ||\r\n194:         (status !== 'covered' && status !== 'planned') ||\r\n195:         !Array.isArray(files)\r\n196:       ) {\r\n197:         errors.push({\r\n198:           id: 'shard.schema',\r\n199:           ac: typeof ac === 'string' ? ac : undefined,\r\n200:           file: rel,\r\n201:           detail: 'entry needs ac, status (covered|planned) and files',\r\n202:         })\r\n203:         continue\r\n204:       }\r\n205: \r\n206:       if (!owners.has(ac)) {\r\n207:         errors.push({ id: 'shard.unknown_ac', ac, file: rel, detail: 'AC is not declared in the index' })\r\n208:         continue\r\n209:       }\r\n210: \r\n211:       if (declared.has(ac)) {\r\n212:         const previous = declared.get(ac)\r\n213:         errors.push({\r\n214:           id: 'shard.duplicate',\r\n215:           ac,\r\n216:           file: rel,\r\n217:           detail: previous.shard === rel ? 'duplicate within shard' : `already declared in ${previous.shard}`,\r\n218:         })\r\n219:       } else {\r\n220:         declared.set(ac, { status, shard: rel })\r\n221:       }\r\n222: \r\n223:       if (shard.task !== owners.get(ac)) {\r\n224:         errors.push({\r\n225:           id: 'shard.not_owner',\r\n226:           ac,\r\n227:           file: rel,\r\n228:           detail: `owner is ${owners.get(ac)}`,\r\n229:         })\r\n230:       }\r\n231: \r\n232:       if (status !== 'covered') continue\r\n233: \r\n234:       let broken = false\r\n235:       if (files.length === 0) {\r\n236:         errors.push({ id: 'shard.missing_file', ac, file: rel, detail: 'covered entry needs at least one file' })\r\n237:         broken = true\r\n238:       }\r\n239:       for (const file of files) {\r\n240:         const unsafe =\r\n241:           typeof file !== 'string' ||\r\n242:           file === '' ||\r\n243:           path.isAbsolute(file) ||\r\n244:           file.split('/').includes('..') ||\r\n245:           file.split('\\\\').includes('..')\r\n246:         if (unsafe) {\r\n247:           errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `unsafe or empty path: ${String(file)}` })\r\n248:           broken = true\r\n249:           continue\r\n250:         }\r\n251:         if (!fs.existsSync(path.join(root, file))) {\r\n252:           errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `missing file: ${file}` })\r\n253:           broken = true\r\n254:         }\r\n255:       }\r\n256:       if (broken) continue\r\n257: \r\n258:       let tagged = false\r\n259:       for (const file of files) {\r\n260:         let source = ''\r\n261:         try {\r\n262:           source = fs.readFileSync(path.join(root, file), 'utf8')\r\n263:         } catch {\r\n264:           continue\r\n265:         }\r\n266:         if (extractTitles(source).some((item) => item.kind === 'plain' && item.title.includes(`[${ac}]`))) {\r\n267:           tagged = true\r\n268:           break\r\n269:         }\r\n270:       }\r\n271:       if (!tagged) {\r\n272:         errors.push({\r\n273:           id: 'shard.missing_title',\r\n274:           ac,\r\n275:           file: rel,\r\n276:           detail: `no plain test title contains [${ac}]`,\r\n277:         })\r\n278:       }\r\n279:     }\r\n280:   }\r\n281: \r\n282:   const acs = {}\r\n283:   for (const ac of indexAcs) {\r\n284:     const entry = declared.get(ac)\r\n285:     acs[ac] = entry ? entry.status : 'planned'\r\n286:   }\r\n287: \r\n288:   return { errors, acs }\r\n289: }\r\n290: \r\n291: function checkTaskGraph(taskGraphPath, index) {\r\n292:   const errors = []\r\n293:   let graph\r\n294:   try {\r\n295:     graph = JSON.parse(fs.readFileSync(taskGraphPath, 'utf8'))\r\n296:   } catch {\r\n297:     errors.push({ id: 'graph.mismatch', detail: `cannot read task graph: ${taskGraphPath}` })\r\n298:     return errors\r\n299:   }\r\n300: \r\n301:   const owners = new Map()\r\n302:   const milestones = new Map()\r\n303:   for (const task of Array.isArray(graph.tasks) ? graph.tasks : []) {\r\n304:     for (const ac of Array.isArray(task.acceptance) ? task.acceptance : []) {\r\n305:       owners.set(ac, task.id)\r\n306:       milestones.set(ac, task.milestone)\r\n307:     }\r\n308:   }\r\n309:   const levels = new Map()\r\n310:   for (const item of Array.isArray(graph.acceptance) ? graph.acceptance : []) {\r\n311:     if (item && typeof item.id === 'string') levels.set(item.id, item.levels)\r\n312:   }\r\n313: \r\n314:   const sameSet = (a, b) => {\r\n315:     if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false\r\n316:     const left = [...a].sort()\r\n317:     const right = [...b].sort()\r\n318:     return left.every((value, i) => value === right[i])\r\n319:   }\r\n320: \r\n321:   for (const entry of index?.acs ?? []) {\r\n322:     if (!entry || typeof entry !== 'object') continue\r\n323:     if (owners.get(entry.ac) !== entry.owner) {\r\n324:       errors.push({\r\n325:         id: 'graph.mismatch',\r\n326:         ac: entry.ac,\r\n327:         detail: `owner ${entry.owner} != task graph ${owners.get(entry.ac) ?? 'none'}`,\r\n328:       })\r\n329:     }\r\n330:     if (milestones.get(entry.ac) !== entry.milestone) {\r\n331:       errors.push({\r\n332:         id: 'graph.mismatch',\r\n333:         ac: entry.ac,\r\n334:         detail: `milestone ${entry.milestone} != task graph ${milestones.get(entry.ac) ?? 'none'}`,\r\n335:       })\r\n336:     }\r\n337:     if (levels.has(entry.ac) && !sameSet(levels.get(entry.ac), entry.levels)) {\r\n338:       errors.push({\r\n339:         id: 'graph.mismatch',\r\n340:         ac: entry.ac,\r\n341:         detail: `levels ${JSON.stringify(entry.levels)} != task graph ${JSON.stringify(levels.get(entry.ac))}`,\r\n342:       })\r\n343:     }\r\n344:   }\r\n345: \r\n346:   return errors\r\n347: }\r\n348: \r\n349: function fail(message) {\r\n350:   console.error(message)\r\n351:   process.exitCode = 2\r\n352: }\r\n353: \r\n354: function takeValue(args, index, flag) {\r\n355:   const value = args[index + 1]\r\n356:   if (typeof value !== 'string' || value === '') {\r\n357:     fail(`${flag} requires a value`)\r\n358:     return null\r\n359:   }\r\n360:   return value\r\n361: }\r\n362: \r\n363: function main() {\r\n364:   const args = process.argv.slice(2)\r\n365:   let root = REPO_ROOT\r\n366:   let indexPath = null\r\n367:   let taskGraphPath = null\r\n368:   let json = false\r\n369: \r\n370:   for (let i = 0; i < args.length; i += 1) {\r\n371:     const flag = args[i]\r\n372:     if (flag === '--root') {\r\n373:       const value = takeValue(args, i, flag)\r\n374:       if (value === null) return\r\n375:       root = path.resolve(value)\r\n376:       i += 1\r\n377:     } else if (flag === '--index') {\r\n378:       const value = takeValue(args, i, flag)\r\n379:       if (value === null) return\r\n380:       indexPath = path.resolve(value)\r\n381:       i += 1\r\n382:     } else if (flag === '--task-graph') {\r\n383:       const value = takeValue(args, i, flag)\r\n384:       if (value === null) return\r\n385:       taskGraphPath = path.resolve(value)\r\n386:       i += 1\r\n387:     } else if (flag === '--json') {\r\n388:       json = true\r\n389:     } else {\r\n390:       fail(`unknown argument: ${flag}\\nusage: node scripts/check-traceability.mjs [--root <dir>] [--index <file>] [--task-graph <file>] [--json]`)\r\n391:       return\r\n392:     }\r\n393:   }\r\n394: \r\n395:   const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\r\n396:   const errors = []\r\n397: \r\n398:   let index = null\r\n399:   try {\r\n400:     index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\r\n401:   } catch {\r\n402:     errors.push({ id: 'index.schema', detail: `cannot read index: ${indexFile}` })\r\n403:   }\r\n404: \r\n405:   let acs = {}\r\n406:   if (index) {\r\n407:     errors.push(...validateIndex(index))\r\n408:     const merged = mergeShards({ root, index })\r\n409:     errors.push(...merged.errors)\r\n410:     acs = merged.acs\r\n411:   }\r\n412:   if (taskGraphPath && index) errors.push(...checkTaskGraph(taskGraphPath, index))\r\n413: \r\n414:   const entries = Object.keys(acs)\r\n415:     .sort()\r\n416:     .map((ac) => ({ ac, status: acs[ac] }))\r\n417:   const covered = entries.filter((item) => item.status === 'covered').length\r\n418:   const planned = entries.filter((item) => item.status === 'planned').length\r\n419: \r\n420:   if (json) {\r\n421:     const payload = {\r\n422:       ok: errors.length === 0,\r\n423:       errors: errors.map((error) => {\r\n424:         const out = { id: error.id }\r\n425:         if (error.ac !== undefined) out.ac = error.ac\r\n426:         if (error.file !== undefined) out.file = error.file\r\n427:         out.detail = error.detail ?? ''\r\n428:         return out\r\n429:       }),\r\n430:       covered,\r\n431:       planned,\r\n432:       acs: entries,\r\n433:     }\r\n434:     process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`)\r\n435:   } else {\r\n436:     for (const error of errors) {\r\n437:       const where = error.ac ?? error.file ?? '-'\r\n438:       process.stdout.write(`FAIL ${error.id} ${where} ${error.detail ?? ''}`.trimEnd() + '\\n')\r\n439:     }\r\n440:     if (errors.length > 0) {\r\n441:       process.stdout.write(`check-traceability: FAILED (${errors.length} errors)\\n`)\r\n442:     } else {\r\n443:       process.stdout.write(`check-traceability: ok (covered=${covered} planned=${planned})\\n`)\r\n444:     }\r\n445:   }\r\n446: \r\n447:   process.exitCode = errors.length > 0 ? 1 : 0\r\n448: }\r\n449: \r\n450: const invokedDirectly =\r\n451:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n452: \r\n453: if (invokedDirectly) main()\r\nscripts/check-defects.mjs\r\n1: #!/usr/bin/env node\r\n2: // Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\r\n3: import fs from 'node:fs'\r\n4: import path from 'node:path'\r\n5: import { fileURLToPath } from 'node:url'\r\n6: \r\n7: import { mergeShards, extractTitles } from './check-traceability.mjs'\r\n8: \r\n9: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n10: const REPO_ROOT = path.resolve(HERE, '..')\r\n11: \r\n12: const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\r\n13: const EXPECTED_IDS = [\r\n14:   'a1-quota',\r\n15:   'a2-pack',\r\n16:   'a3-runner',\r\n17:   'a4-paths',\r\n18:   'a4-null-config',\r\n19:   'a5-dup-call',\r\n20:   'a5-forecast-x3',\r\n21:   'a5-unused',\r\n22:   'a5-ignored-fields',\r\n23:   'a5-shell',\r\n24:   'a5-nocache',\r\n25: ]\r\n26: \r\n27: const LEDGER = ['test', 'characterization', 'defects.json']\r\n28: const DEFECTS_DIR = ['test', 'characterization', 'defects']\r\n29: \r\n30: export function milestoneRank(value) {\r\n31:   const index = MILESTONES.indexOf(value)\r\n32:   return index < 0 ? Number.NaN : index + 1\r\n33: }\r\n34: \r\n35: export function hasFixedSection(source) {\r\n36:   return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\r\n37: }\r\n38: \r\n39: export function checkDefects({ root, index, milestone }) {\r\n40:   const errors = []\r\n41:   const ledgerFile = path.join(root, ...LEDGER)\r\n42: \r\n43:   if (!fs.existsSync(ledgerFile)) {\r\n44:     if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\r\n45:     return { errors, absent: true }\r\n46:   }\r\n47: \r\n48:   let ledger = null\r\n49:   try {\r\n50:     ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\r\n51:   } catch {\r\n52:     errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\r\n53:     return { errors, absent: false }\r\n54:   }\r\n55: \r\n56:   const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\r\n57:   if (!list) {\r\n58:     errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\r\n59:     return { errors, absent: false }\r\n60:   }\r\n61: \r\n62:   const knownAcs = new Set()\r\n63:   for (const entry of index?.acs ?? []) {\r\n64:     if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\r\n65:   }\r\n66: \r\n67:   const seen = new Set()\r\n68:   const valid = []\r\n69:   for (const item of list) {\r\n70:     if (!item || typeof item !== 'object' || Array.isArray(item)) {\r\n71:       errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\r\n72:       continue\r\n73:     }\r\n74:     const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\r\n75:     const problems = []\r\n76:     if (typeof id !== 'string' || id === '') problems.push('id')\r\n77:     if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\r\n78:     if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\r\n79:     if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\r\n80: \r\n81:     if (problems.length > 0) {\r\n82:       errors.push({\r\n83:         id: 'defects.schema',\r\n84:         detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\r\n85:       })\r\n86:       continue\r\n87:     }\r\n88:     if (seen.has(id)) {\r\n89:       errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\r\n90:       continue\r\n91:     }\r\n92:     seen.add(id)\r\n93:     valid.push({ id, ownerTask, ownerMilestone, ac })\r\n94:   }\r\n95: \r\n96:   if (milestone === 'M5') {\r\n97:     const actual = [...seen].sort()\r\n98:     const expected = [...EXPECTED_IDS].sort()\r\n99:     if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\r\n100:       errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\r\n101:     }\r\n102:   }\r\n103: \r\n104:   let required = []\r\n105:   if (milestone) {\r\n106:     const limit = milestoneRank(milestone)\r\n107:     required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\r\n108:   } else {\r\n109:     const merged = mergeShards({ root, index })\r\n110:     required = valid.filter((item) => merged.acs[item.ac] === 'covered')\r\n111:   }\r\n112: \r\n113:   for (const item of required) {\r\n114:     const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\r\n115:     let source = null\r\n116:     try {\r\n117:       source =