{"type":"user","uuid":"01a1b698-6653-78d2-a752-8ca37a514ebf","session_id":"01a1b694-bf86-79ef-9b9d-323d8d10c8a2","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-a7117ba7104205f1","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { fileURLToPath } from 'node:url'\n   6→\n   7→import { mergeShards, extractTitles } from './check-traceability.mjs'\n   8→\n   9→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  10→const REPO_ROOT = path.resolve(HERE, '..')\n  11→\n  12→const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\n  13→const EXPECTED_IDS = [\n  14→  'a1-quota',\n  15→  'a2-pack',\n  16→  'a3-runner',\n  17→  'a4-paths',\n  18→  'a4-null-config',\n  19→  'a5-dup-call',\n  20→  'a5-forecast-x3',\n  21→  'a5-unused',\n  22→  'a5-ignored-fields',\n  23→  'a5-shell',\n  24→  'a5-nocache',\n  25→]\n  26→\n  27→const LEDGER = ['test', 'characterization', 'defects.json']\n  28→const DEFECTS_DIR = ['test', 'characterization', 'defects']\n  29→\n  30→export function milestoneRank(value) {\n  31→  const index = MILESTONES.indexOf(value)\n  32→  return index < 0 ? Number.NaN : index + 1\n  33→}\n  34→\n  35→export function hasFixedSection(source) {\n  36→  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\n  37→}\n  38→\n  39→export function checkDefects({ root, index, milestone }) {\n  40→  const errors = []\n  41→  const ledgerFile = path.join(root, ...LEDGER)\n  42→\n  43→  if (!fs.existsSync(ledgerFile)) {\n  44→    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\n  45→    return { errors, absent: true }\n  46→  }\n  47→\n  48→  let ledger = null\n  49→  try {\n  50→    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\n  51→  } catch {\n  52→    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\n  53→    return { errors, absent: false }\n  54→  }\n  55→\n  56→  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n  57→  if (!list) {\n  58→    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\n  59→    return { errors, absent: false }\n  60→  }\n  61→\n  62→  const knownAcs = new Set()\n  63→  for (const entry of index?.acs ?? []) {\n  64→    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\n  65→  }\n  66→\n  67→  const seen = new Set()\n  68→  const valid = []\n  69→  for (const item of list) {\n  70→    if (!item || typeof item !== 'object' || Array.isArray(item)) {\n  71→      errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\n  72→      continue\n  73→    }\n  74→    const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\n  75→    const problems = []\n  76→    if (typeof id !== 'string' || id === '') problems.push('id')\n  77→    if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\n  78→    if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\n  79→    if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\n  80→\n  81→    if (problems.length > 0) {\n  82→      errors.push({\n  83→        id: 'defects.schema',\n  84→        detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\n  85→      })\n  86→      continue\n  87→    }\n  88→    if (seen.has(id)) {\n  89→      errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\n  90→      continue\n  91→    }\n  92→    seen.add(id)\n  93→    valid.push({ id, ownerTask, ownerMilestone, ac })\n  94→  }\n  95→\n  96→  if (milestone === 'M5') {\n  97→    const actual = [...seen].sort()\n  98→    const expected = [...EXPECTED_IDS].sort()\n  99→    if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n 100→      errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n 101→    }\n 102→  }\n 103→\n 104→  let required = []\n 105→  if (milestone) {\n 106→    const limit = milestoneRank(milestone)\n 107→    required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\n 108→  } else {\n 109→    const merged = mergeShards({ root, index })\n 110→    required = valid.filter((item) => merged.acs[item.ac] === 'covered')\n 111→  }\n 112→\n 113→  for (const item of required) {\n 114→    const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\n 115→    let source = null\n 116→    try {\n 117→      source = fs.readFileSync(file, 'utf8')\n 118→    } catch {\n 119→      source = null\n 120→    }\n 121→    if (source === null || !hasFixedSection(source)) {\n 122→      errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\n 123→    }\n 124→  }\n 125→\n 126→  return { errors, absent: false }\n 127→}\n 128→\n 129→function main() {\n 130→  const args = process.argv.slice(2)\n 131→  let root = REPO_ROOT\n 132→  let indexPath = null\n 133→  let milestone = null\n 134→\n 135→  for (let i = 0; i < args.length; i += 1) {\n 136→    const flag = args[i]\n 137→    if (flag === '--root') {\n 138→      const value = args[i + 1]\n 139→      if (typeof value !== 'string' || value === '') {\n 140→        process.stderr.write('--root requires a directory\\n')\n 141→        process.exitCode = 2\n 142→        return\n 143→      }\n 144→      root = path.resolve(value)\n 145→      i += 1\n 146→    } else if (flag === '--index') {\n 147→      const value = args[i + 1]\n 148→      if (typeof value !== 'string' || value === '') {\n 149→        process.stderr.write('--index requires a file\\n')\n 150→        process.exitCode = 2\n 151→        return\n 152→      }\n 153→      indexPath = path.resolve(value)\n 154→      i += 1\n 155→    } else if (flag === '--milestone') {\n 156→      const value = args[i + 1]\n 157→      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n 158→        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n 159→        process.exitCode = 2\n 160→        return\n 161→      }\n 162→      milestone = value\n 163→      i += 1\n 164→    } else {\n 165→      process.stderr.write(\n 166→        `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>]\\n`\n 167→      )\n 168→      process.exitCode = 2\n 169→      return\n 170→    }\n 171→  }\n 172→\n 173→  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n 174→  let index = { acs: [] }\n 175→  try {\n 176→    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n 177→  } catch {\n 178→    index = { acs: [] }\n 179→  }\n 180→\n 181→  const { errors, absent } = checkDefects({ root, index, milestone })\n 182→\n 183→  if (absent && !milestone) {\n 184→    process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\n 185→    process.exitCode = 0\n 186→    return\n 187→  }\n 188→\n 189→  if (errors.length === 0) {\n 190→    process.stdout.write('check-defects: ok\\n')\n 191→    process.exitCode = 0\n 192→    return\n 193→  }\n 194→  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n 195→  process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\n 196→  process.exitCode = 1\n 197→}\n 198→\n 199→const invokedDirectly =\n 200→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 201→\n 202→if (invokedDirectly) main()\n 203→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b694c37777a89e7b949da7c8c488","_messageId":"01a1b6984fc479478b8c5d0fff8b3f94","_meta":{"codebuddy.ai/conversationRequestId":"01a1b694c37777a89e7b949d