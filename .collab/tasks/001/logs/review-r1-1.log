r = path.join(root, 'test', 'traceability')\r\n20:   let names = []\r\n21:   try {\r\n22:     names = fs.readdirSync(dir).filter((name) => name.endsWith('.json'))\r\n23:   } catch {\r\n24:     return map\r\n25:   }\r\n26:   for (const name of names) {\r\n27:     let shard = null\r\n28:     try {\r\n29:       shard = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8'))\r\n30:     } catch {\r\n31:       continue\r\n32:     }\r\n33:     for (const entry of Array.isArray(shard?.entries) ? shard.entries : []) {\r\n34:       if (!entry || entry.status !== 'covered' || typeof entry.ac !== 'string') continue\r\n35:       const files = Array.isArray(entry.files) ? entry.files.filter((file) => typeof file === 'string') : []\r\n36:       map.set(entry.ac, files)\r\n37:     }\r\n38:   }\r\n39:   return map\r\n40: }\r\n41: \r\n42: export function runGate({ root, index, milestone }) {\r\n43:   const errors = []\r\n44:   const limit = milestoneRank(milestone)\r\n45:   const entries = Array.isArray(index?.acs) ? index.acs : []\r\n46: \r\n47:   const merged = mergeShards({ root, index })\r\n48:   for (const error of merged.errors) {\r\n49:     const where = error.ac ?? error.file ?? '-'\r\n50:     errors.push({ id: 'gate.trace_error', detail: `${where} ${error.detail ?? error.id}`.trim() })\r\n51:   }\r\n52: \r\n53:   for (const entry of entries) {\r\n54:     if (!entry || typeof entry !== 'object') continue\r\n55:     if (!(milestoneRank(entry.milestone) <= limit)) continue\r\n56:     if (merged.acs[entry.ac] !== 'covered') {\r\n57:       errors.push({ id: 'gate.ac_not_covered', detail: `${entry.ac} is ${merged.acs[entry.ac] ?? 'planned'}` })\r\n58:     }\r\n59:   }\r\n60: \r\n61:   errors.push(...checkDefects({ root, index, milestone }).errors)\r\n62: \r\n63:   if (errors.length > 0) return errors\r\n64: \r\n65:   const coveredFiles = collectCoveredFiles(root)\r\n66:   const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-gate-'))\r\n67:   try {\r\n68:     const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\r\n69:       cwd: root,\r\n70:       encoding: 'utf8',\r\n71:       maxBuffer: 64 * 1024 * 1024,\r\n72:     })\r\n73:     if (result.status !== 0) {\r\n74:       const tail = (result.stderr || result.stdout || '').trim().split('\\n').slice(-3).join(' | ')\r\n75:       errors.push({ id: 'gate.run_failed', detail: `full run exited ${result.status}${tail ? `: ${tail}` : ''}` })\r\n76:       return errors\r\n77:     }\r\n78: \r\n79:     let manifest = null\r\n80:     try {\r\n81:       manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\r\n82:     } catch {\r\n83:       manifest = null\r\n84:     }\r\n85:     if (!manifest || manifest.mode !== 'full') {\r\n86:       errors.push({ id: 'gate.manifest_not_full', detail: `mode is ${manifest?.mode ?? 'missing'}` })\r\n87:     }\r\n88: \r\n89:     const executed = new Set(Array.isArray(manifest?.files) ? manifest.files : [])\r\n90:     for (const entry of entries) {\r\n91:       if (!entry || typeof entry !== 'object') continue\r\n92:       if (!(milestoneRank(entry.milestone) <= limit)) continue\r\n93:       if (merged.acs[entry.ac] !== 'covered') continue\r\n94:       for (const file of coveredFiles.get(entry.ac) ?? []) {\r\n95:         if (!executed.has(file)) {\r\n96:           errors.push({ id: 'gate.file_not_executed', detail: `${file} (${entry.ac})` })\r\n97:         }\r\n98:       }\r\n99:     }\r\n100:   } finally {\r\n101:     fs.rmSync(outDir, { recursive: true, force: true })\r\n102:   }\r\n103: \r\n104:   return errors\r\n105: }\r\n106: \r\n107: function main() {\r\n108:   const args = process.argv.slice(2)\r\n109:   let root = REPO_ROOT\r\n110:   let indexPath = null\r\n111:   let milestone = null\r\n112: \r\n113:   for (let i = 0; i < args.length; i += 1) {\r\n114:     const flag = args[i]\r\n115:     if (flag === '--root') {\r\n116:       const value = args[i + 1]\r\n117:       if (typeof 