p).join('/')\r\n78: }\r\n79: \r\n80: export function recordSkip({ test: name, file, ac, requires, reason }) {\r\n81:   const dir = process.env.CLIWORKER_RESULTS_DIR\r\n82:   if (!dir) return false\r\n83:   const record = {\r\n84:     schema: 'cliworker.skip/v1',\r\n85:     test: name,\r\n86:     file: relativeFile(file),\r\n87:     ac: ac ?? null,\r\n88:     requires,\r\n89:     platform: process.platform,\r\n90:     node: process.version,\r\n91:     reason,\r\n92:     at: new Date().toISOString(),\r\n93:   }\r\n94:   fs.mkdirSync(dir, { recursive: true })\r\n95:   fs.appendFileSync(path.join(dir, 'skips.jsonl'), `${JSON.stringify(record)}\\n`)\r\n96:   return true\r\n97: }\r\n98: \r\n99: function callerFilename(file) {\r\n100:   if (typeof file !== 'string' || file === '') return null\r\n101:   if (file.startsWith('file:')) {\r\n102:     try {\r\n103:       return fileURLToPath(file)\r\n104:     } catch {\r\n105:       return null\r\n106:     }\r\n107:   }\r\n108:   return path.resolve(file)\r\n109: }\r\n110: \r\n111: export function platformTest(name, options, fn) {\r\n112:   const { ac = null, requires, file, reason } = options ?? {}\r\n113:   const body = (t) => {\r\n114:     if (satisfies(requires)) return fn(t)\r\n115:     const why = reason ?? `requires ${requires} not satisfied on ${process.platform}`\r\n116:     recordSkip({ test: name, file, ac, requires, reason: why })\r\n117:     t.skip(why)\r\n118:   }\r\n119:   // node:test records the file that called test(). Calling it from this helper would\r\n120:   // put the helper into files-executed.json and fail the full-run comparison. The call\r\n121:   // is compiled under the caller's filename so the event stays on that test file.\r\n122:   const filename = callerFilename(file)\r\n123:   if (filename) {\r\n124:     const register = vm.compileFunction('test(name, body)', ['test', 'name', 'body'], { filename })\r\n125:     register(test, name, body)\r\n126:     return\r\n127:   }\r\n128:   test(name, body)\r