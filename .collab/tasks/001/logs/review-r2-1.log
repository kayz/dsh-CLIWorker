{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\Users\\\\kayz\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\Microsoft.PowerShell_8wekyb3d8bbwe\\\\pwsh.exe\" -Command '$paths=@('\"'scripts/run-tests.mjs','scripts/reporters/files.mjs','test/helpers/platform-gate.mjs'); foreach(\"'$p in $paths) { $p; $n=0; Get-Content -LiteralPath $p -Encoding utf8 | ForEach-Object { $n++; '\"'{0}: {1}' -f \"'$n,$_ } }; Get-Content -LiteralPath '\"'C:/git/dsh-CLIWorker/.git/worktrees/001/HEAD','C:/git/dsh-CLIWorker/.git/refs/heads/task/001' -Encoding utf8\"","aggregated_output":"scripts/run-tests.mjs\r\n1: #!/usr/bin/env node\r\n2: // Test runner: enumerates test files, runs them with node:test, and verifies that the\r\n3: // files the reporter saw match the files we enumerated (full runs only).\r\n4: import fs from 'node:fs'\r\n5: import os from 'node:os'\r\n6: import path from 'node:path'\r\n7: import crypto from 'node:crypto'\r\n8: import { spawn } from 'node:child_process'\r\n9: import { fileURLToPath, pathToFileURL } from 'node:url'\r\n10: \r\n11: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n12: const REPO_ROOT = path.resolve(HERE, '..')\r\n13: const REPORTER = pathToFileURL(path.join(HERE, 'reporters', 'files.mjs')).href\r\n14: const MANIFEST_NAME = 'files-executed.json'\r\n15: const SKIPS_NAME = 'skips.jsonl'\r\n16: const AC_PATTERN = /^AC-\\d{3}$/\r\n17: const MAX_ARG_CHARS = 24000\r\n18: \r\n19: const TEST_DIRS = ['unit', 'integration', 'contract', 'e2e', 'smoke', 'characterization', 'flows']\r\n20: const EXCLUDED_TOP = new Set(['fixtures', 'helpers', 'perf'])\r\n21: \r\n22: const USAGE =\r\n23:   'usage: node scripts/run-tests.mjs [--ac AC-nnn]... [--root <dir>] [--out-dir <dir>] [--perf] [--update-snapshots]'\r\n24: \r\n25: function toPosix(value) {\r\n26:   return value.split(path.sep).join('/')\r\n27: }\r\n28: \r\n29: function walkFiles(dir, onFile) {\r\n30:   let entries\r\n31:   try {\r\n32:     entries = fs.readdirSync(dir, { withFileTypes: true })\r\n33:   } catch {\r\n34:     return\r\n35:   }\r\n36:   for (const entry of entries) {\r\n37:     const full = path.join(dir, entry.name)\r\n38:     if (entry.isDirectory()) walkFiles(full, onFile)\r\n39:     else if (entry.isFile()) onFile(full)\r\n40:   }\r\n41: }\r\n42: \r\n43: export function enumerateTestFiles(root) {\r\n44:   const base = path.resolve(root)\r\n45:   const found = []\r\n46:   for (const name of TEST_DIRS) {\r\n47:     const start = path.join(base, 'test', name)\r\n48:     let stat\r\n49:     try {\r\n50:       stat = fs.statSync(start)\r\n51:     } catch {\r\n52:       continue\r\n53:     }\r\n54:     if (!stat.isDirectory()) continue\r\n55:     walkFiles(start, (file) => {\r\n56:       if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n57:     })\r\n58:   }\r\n59:   return [...new Set(found)].sort()\r\n60: }\r\n61: \r\n62: export function enumeratePerfFiles(root) {\r\n63:   const base = path.resolve(root)\r\n64:   const start = path.join(base, 'test', 'perf')\r\n65:   try {\r\n66:     if (!fs.statSync(start).isDirectory()) return []\r\n67:   } catch {\r\n68:     return []\r\n69:   }\r\n70:   const found = []\r\n71:   walkFiles(start, (file) => {\r\n72:     if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n73:   })\r\n74:   return [...new Set(found)].sort()\r\n75: }\r\n76: \r\n77: export function findOrphans(root) {\r\n78:   const base = path.resolve(root)\r\n79:   const testDir = path.join(base, 'test')\r\n80:   let entries\r\n81:   try {\r\n82:     entries = fs.readdirSync(testDir, { withFileTypes: true })\r\n83:   } catch {\r\n84:     return []\r\n85:   }\r\n86: \r\n87:   const all = []\r\n88:   for (const entry of entries) {\r\n89:     if (entry.isDirectory()) {\r\n90:       if (EXCLUDED_TOP.has(entry.name)) continue\r\n91:       walkFiles(path.join(testDir, entry.name), (file) => {\r\n92:         if (file.endsWith('.test.mjs')) all.