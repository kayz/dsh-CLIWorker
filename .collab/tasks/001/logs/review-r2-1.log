('[AC-001] a filtered run writes a filtered manifest and skips the comparison', () => {\r\n116:   const out = tmp('cliworker-filtered-')\r\n117:   try {\r\n118:     const result = run([RUN_TESTS, '--root', OK_FIXTURE, '--ac', 'AC-001', '--out-dir', out])\r\n119:     assert.equal(result.status, 0, output(result))\r\n120:     const manifest = JSON.parse(fs.readFileSync(path.join(out, 'files-executed.json'), 'utf8'))\r\n121:     assert.equal(manifest.mode, 'filtered')\r\n122:     assert.equal(manifest.filter, 'AC-001')\r\n123:     assert.deepEqual(manifest.files, ['test/unit/a.test.mjs'])\r\n124:   } finally {\r\n125:     fs.rmSync(out, { recursive: true, force: true })\r\n126:   }\r\n127: })\r\n128: \r\n129: test('[AC-001] a failed run drops the previous manifest and truncates skips', () => {\r\n130:   const out = tmp('cliworker-stale-')\r\n131:   const manifestPath = path.join(out, 'files-executed.json')\r\n132:   const skipsPath = path.join(out, 'skips.jsonl')\r\n133:   const orphanRoot = path.join(ROOT, 'test', 'fixtures', 'discovery-selftest', 'orphan')\r\n134:   try {\r\n135:     const ok = run([RUN_TESTS, '--root', OK_FIXTURE, '--out-dir', out])\r\n136:     assert.equal(ok.status, 0, output(ok))\r\n137:     assert.equal(JSON.parse(fs.readFileSync(manifestPath, 'utf8')).mode, 'full')\r\n138: \r\n139:     const missed = run([RUN_TESTS, '--root', OK_FIXTURE, '--ac', 'AC-999', '--out-dir', out])\r\n140:     assert.equal(missed.status, 1, output(missed))\r\n141:     assert.match(output(missed), /run\\.no_match/)\r\n142:     assert.equal(fs.existsSync(manifestPath), false)\r\n143:     assert.equal(fs.readFileSync(skipsPath, 'utf8'), '')\r\n144: \r\n145:     fs.writeFileSync(manifestPath, '{\"mode\":\"full\",\"files\":[\"stale\"]}\\n')\r\n146:     fs.writeFileSync(skipsPath, '{\"stale\":true}\\n')\r\n147:     const orphan = run([RUN_TESTS, '--root', orphanRoot, '--out-dir', out])\r\n148:     assert.equal(orphan.status, 1, output(orphan))\r\n149:     assert.match(output