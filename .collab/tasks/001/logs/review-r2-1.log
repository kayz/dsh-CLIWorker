n(process.execPath, args, { ...spawnOptions, env })\r\n184:     child.on('error', () => resolve({ code: null, signal: null }))\r\n185:     child.on('close', (code, signal) => resolve({ code, signal }))\r\n186:   })\r\n187: }\r\n188: \r\n189: function readManifest(file) {\r\n190:   try {\r\n191:     return JSON.parse(fs.readFileSync(file, 'utf8'))\r\n192:   } catch {\r\n193:     return null\r\n194:   }\r\n195: }\r\n196: \r\n197: async function main() {\r\n198:   const parsed = parseArgs(process.argv.slice(2))\r\n199:   if (parsed.error) {\r\n200:     usageError(parsed.error)\r\n201:     return\r\n202:   }\r\n203:   const options = parsed.options\r\n204:   const root = options.root\r\n205: \r\n206:   if (options.perf) {\r\n207:     const files = enumeratePerfFiles(root)\r\n208:     if (files.length === 0) {\r\n209:       process.stdout.write('run-tests: no perf tests\\n')\r\n210:       return\r\n211:     }\r\n212:     const result = await runNode(['--test', ...files], { cwd: root, stdio: 'inherit' })\r\n213:     process.exitCode = result.code === null ? 1 : result.code\r\n214:     return\r\n215:   }\r\n216: \r\n217:   const filtered = options.acs.length > 0\r\n218:   const outDir = options.outDir ?? (process.env.CLIWORKER_RESULTS_DIR\r\n219:     ? path.resolve(process.env.CLIWORKER_RESULTS_DIR)\r\n220:     : defaultOutDir(root))\r\n221: \r\n222:   if (\r\n223:     process.env.CLIWORKER_RUN_ACTIVE &&\r\n224:     process.env.CLIWORKER_RESULTS_DIR &&\r\n225:     normalizePath(outDir) === normalizePath(process.env.CLIWORKER_RESULTS_DIR)\r\n226:   ) {\r\n227:     process.stderr.write(\r\n228:       'run-tests: refusing to run nested inside the parent run (a nested run would overwrite the parent artifacts)\\n'\r\n229:     )\r\n230:     process.exitCode = 2\r\n231:     return\r\n232:   }\r\n233: \r\n234:   fs.mkdirSync(outDir, { recursive: true })\r\n235:   const manifestPath = path.join(outDir, MANIFEST_NAME)\r\n236:   const skipsPath = path.join(outDir, SKIPS_NAME)\r\n237: