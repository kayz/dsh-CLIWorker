e.test.mjs')\r\n192:     const gateUrl = pathToFileURL(path.join(ROOT, 'test', 'helpers', 'platform-gate.mjs')).href\r\n193:     fs.writeFileSync(\r\n194:       probe,\r\n195:       [\r\n196:         `import { platformTest } from ${JSON.stringify(gateUrl)}`,\r\n197:         \"platformTest('[probe] records a skip', { ac: 'AC-001', requires: 'not-a-platform', file: import.meta.url, reason: 'probe skip' }, () => {\",\r\n198:         \"  throw new Error('the body must not run')\",\r\n199:         '})',\r\n200:         '',\r\n201:       ].join('\\n')\r\n202:     )\r\n203: \r\n204:     const result = run([probe], { env: { ...process.env, CLIWORKER_RESULTS_DIR: dir } })\r\n205:     assert.equal(result.status, 0, output(result))\r\n206: \r\n207:     const lines = fs.readFileSync(path.join(dir, 'skips.jsonl'), 'utf8').trim().split('\\n')\r\n208:     assert.equal(lines.length, 1)\r\n209:     const record = JSON.parse(lines[0])\r\n210:     assert.equal(record.schema, 'cliworker.skip/v1')\r\n211:     assert.equal(record.test, '[probe] records a skip')\r\n212:     assert.match(record.file, /probe\\.test\\.mjs$/)\r\n213:     assert.equal(record.ac, 'AC-001')\r\n214:     assert.equal(record.requires, 'not-a-platform')\r\n215:     assert.equal(record.platform, process.platform)\r\n216:     assert.equal(record.node, process.version)\r\n217:     assert.equal(record.reason, 'probe skip')\r\n218:     assert.ok(!Number.isNaN(Date.parse(record.at)))\r\n219:     assert.deepEqual(Object.keys(record).sort(), [\r\n220:       'ac',\r\n221:       'at',\r\n222:       'file',\r\n223:       'node',\r\n224:       'platform',\r\n225:       'reason',\r\n226:       'requires',\r\n227:       'schema',\r\n228:       'test',\r\n229:     ])\r\n230:   } finally {\r\n231:     fs.rmSync(dir, { recursive: true, force: true })\r\n232:   }\r\n233: })\r\n234: \r\n235: test('[AC-002] check-ci accepts the committed workflow', () => {\r\n236:   const result = run([CHECK_CI])\r\n237:   assert.equal(result.status, 0