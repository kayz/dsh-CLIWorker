href\r\n193:     fs.writeFileSync(\r\n194:       probe,\r\n195:       [\r\n196:         `import { platformTest } from ${JSON.stringify(gateUrl)}`,\r\n197:         \"platformTest('[probe] records a skip', { ac: 'AC-001', requires: 'not-a-platform', file: import.meta.url, reason: 'probe skip' }, () => {\",\r\n198:         \"  throw new Error('the body must not run')\",\r\n199:         '})',\r\n200:         '',\r\n201:       ].join('\\n')\r\n202:     )\r\n203: \r\n204:     const result = run([probe], { env: { ...process.env, CLIWORKER_RESULTS_DIR: dir } })\r\n205:     assert.equal(result.status, 0, output(result))\r\n206: \r\n207:     const lines = fs.readFileSync(path.join(dir, 'skips.jsonl'), 'utf8').trim().split('\\n')\r\n208:     assert.equal(lines.length, 1)\r\n209:     const record = JSON.parse(lines[0])\r\n210:     assert.equal(record.schema, 'cliworker.skip/v1')\r\n211:     assert.equal(record.test, '[probe] records a skip')\r\n212:     assert.match(record.file, /probe\\.test\\.mjs$/)\r\n213:     assert.equal(record.ac, 'AC-001')\r\n214:     assert.equal(record.requires, 'not-a-platform')\r\n215:     assert.equal(record.platform, process.platform)\r\n216:     assert.equal(record.node, process.version)\r\n217:     assert.equal(record.reason, 'probe skip')\r\n218:     assert.ok(!Number.isNaN(Date.parse(record.at)))\r\n219:     assert.deepEqual(Object.keys(record).sort(), [\r\n220:       'ac',\r\n221:       'at',\r\n222:       'file',\r\n223:       'node',\r\n224:       'platform',\r\n225:       'reason',\r\n226:       'requires',\r\n227:       'schema',\r\n228:       'test',\r\n229:     ])\r\n230:   } finally {\r\n231:     fs.rmSync(dir, { recursive: true, force: true })\r\n232:   }\r\n233: })\r\n234: \r\n235: test('[AC-002] check-ci accepts the committed workflow', () => {\r\n236:   const result = run([CHECK_CI])\r\n237:   assert.equal(result.status, 0, output(result))\r\n238:   assert.match(result.stdout, /check-ci: ok/)\r\n239: })\r\n240: \r\n241: test('[AC-002] check-ci rejects a stale, malformed or unblocked matrix', () => {\r\n242:   const stale = freshCiRoot()\r\n243:   try {\r\n244:     fs.appendFileSync(path.join(stale, '.github', 'workflows', 'ci.yml'), '# x\\n')\r\n245:     const result = run([CHECK_CI, '--root', stale])\r\n246:     assert.equal(result.status, 1)\r\n247:     assert.match(output(result), /ci\\.stale/)\r\n248:   } finally {\r\n249:     fs.rmSync(stale, { recursive: true, force: true })\r\n250:   }\r\n251: \r\n252:   const oneChar = freshCiRoot()\r\n253:   try {\r\n254:     const file = path.join(oneChar, '.github', 'workflows', 'ci.yml')\r\n255:     const text = fs.readFileSync(file, 'utf8')\r\n256:     fs.writeFileSync(file, text.replace('name: ci', 'name: CJ'))\r\n257:     const result = run([CHECK_CI, '--root', oneChar])\r\n258:     assert.equal(result.status, 1)\r\n259:     assert.match(output(result), /ci\\.stale/)\r\n260:   } finally {\r\n261:     fs.rmSync(oneChar, { recursive: true, force: true })\r\n262:   }\r\n263: \r\n264:   const missing = freshCiRoot()\r\n265:   try {\r\n266:     fs.rmSync(path.join(missing, '.github', 'workflows', 'ci.yml'))\r\n267:     const result = run([CHECK_CI, '--root', missing])\r\n268:     assert.equal(result.status, 1)\r\n269:     assert.match(output(result), /ci\\.missing/)\r\n270:   } finally {\r\n271:     fs.rmSync(missing, { recursive: true, force: true })\r\n272:   }\r\n273: \r\n274:   const blocking = freshCiRoot()\r\n275:   try {\r\n276:     const matrix = readMatrix(blocking)\r\n277:     matrix.perf.blocking = true\r\n278:     writeMatrix(blocking, matrix)\r\n279:     const result = run([CHECK_CI, '--root', blocking])\r\n280:     assert.equal(result.status, 1)\r\n281:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n282:   } finally {\r\n283:     fs.rmSync(blocking, { recursive: true, force: true })\r\n284:   }\r\n285: \r\n286:   const oneNode = freshCiRoot()\r\n287:   try {\r\n288:     const matrix = readMatrix(oneNode)\r\n289:     matrix.node = [20]\r\n290:     writeMatrix(oneNode, matrix)\r\n291:     const result = run([CHECK_CI, '--root', oneNode])\r\n292:     assert.equal(result.status, 1)\r\n293:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n294:   } finally {\r\n295:     fs.rmSync(oneNode, { recursive: true, force: true })\r\n296:   }\r\n297: \r\n298:   const noWindows = freshCiRoot()\r\n299:   try {\r\n300:     const matrix = readMatrix(noWindows)\r\n301:     matrix.os = matrix.os.filter((item) => item.name !== 'windows')\r\n302:     writeMatrix(noWindows, matrix)\r\n303:     const result = run([CHECK_CI, '--root', noWindows])\r\n304:     assert.equal(result.status, 1)\r\n305:     assert.match(output(result), /ci\\.matrix_invalid/)\r\n306:   } finally {\r\n307:     fs.rmSync(noWindows, { recursive: true, force: true })\r\n308:   }\r\n309: })\r\n310: \r\n311: test('[AC-003] check-fast stops at the first failure and propagates its exit code', () => {\r\n312:   const dir = tmp('cliworker-fast-fail-')\r\n313:   const log = path.join(dir, 'log.txt')\r\n314:   try {\r\n315:     writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n316:     writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\r\n317:     writeStep(dir, 'check-c.mjs', APPEND('c'))\r\n318:     writeStep(dir, 'final.mjs', APPEND('final'))\r\n319: \r\n320:     const result = run([CHECK_FAST], {\r\n321:       env: {\r\n322:         ...process.env,\r\n323:         CW_LOG: log,\r\n324:         CLIWORKER_TEST_CHECK_DIR: dir,\r\n325:         CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n326:       },\r\n327:     })\r\n328:     assert.equal(result.status, 7, output(result))\r\n329:     assert.match(output(result), /check-b\\.mjs/)\r\n330:     assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb')\r\n331:   } finally {\r\n332:     fs.rmSync(dir, { recursive: true, force: true })\r\n333:   }\r\n334: })\r\n335: \r\n336: test('[AC-003] check-fast runs the steps in code point order and skips its own file', () => {\r\n337:   const dir = tmp('cliworker-fast-ok-')\r\n338:   const log = path.join(dir, 'log.txt')\r\n339:   try {\r\n340:     writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n341:     writeStep(dir, 'check-b.mjs', APPEND('b'))\r\n342:     writeStep(dir, 'check-c.mjs', APPEND('c'))\r\n343:     writeStep(dir, 'check-fast.mjs', APPEND('SELF'))\r\n344:     writeStep(dir, 'final.mjs', APPEND('final'))\r\n345: \r\n346:     const result = run([CHECK_FAST], {\r\n347:       env: {\r\n348:         ...process.env,\r\n349:         CW_LOG: log,\r\n350:         CLIWORKER_TEST_CHECK_DIR: dir,\r\n351:         CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n352:       },\r\n353:     })\r\n354:     assert.equal(result.status, 0, output(result))\r\n355:     assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb\\nc\\nfinal')\r\n356:     assert.match(result.stdout, /==> npm test/)\r\n357:     assert.ok(!result.stdout.includes('==> check-fast.mjs'))\r\n358:   } finally {\r\n359:     fs.rmSync(dir, { recursive: true, force: true })\r\n360:   }\r\n361: })\r\n362: \r\n363: platformTest(\r\n364:   '[AC-003] the pwsh wrapper forwards the same exit code with a single node call',\r\n365:   { ac: 'AC-003', requires: 'pwsh', file: import.meta.url },\r\n366:   () => {\r\n367:     const dir = tmp('cliworker-fast-pwsh-')\r\n368:     const log = path.join(dir, 'log.txt')\r\n369:     try {\r\n370:       writeStep(dir, 'check-a.mjs', APPEND('a'))\r\n371:       writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\r\n372:       writeStep(dir, 'final.mjs', APPEND('final'))\r\n373: \r\n374:       const result = spawnSync('pwsh', ['-NoProfile', '-File', CHECK_FAST_PS1], {\r\n375:         encoding: 'utf8',\r\n376:         env: {\r\n377:           ...process.env,\r\n378:           CW_LOG: log,\r\n379:           CLIWORKER_TEST_CHECK_DIR: dir,\r\n380:           CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\r\n381:         },\r\n382:       })\r\n383:       assert.equal(result.status, 7, output(result))\r\n384:       assert.match(output(result), /check-b\\.mjs/)\r\n385:     } finally {\r\n386:       fs.rmSync(dir, { recursive: true, force: true })\r\n387:     }\r\n388: \r\n389:     const lines = fs\r\n390:       .readFileSync(CHECK_FAST_PS1, 'utf8')\r\n391:       .split('\\n')\r\n392:       .filter((line) => line.trim() !== '' && !line.trim().startsWith('#'))\r\n393:     assert.ok(lines.length <= 3, `check-fast.ps1 must stay a thin wrapper, got ${lines.length} lines`)\r\n394:     assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /\\$LASTEXITCODE/)\r\n395:     assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /check-fast\\.mjs/)\r\n396:   }\r\n397: )\r\ntest/unit/traceability.test.mjs\r\n1: import test from 'node:test'\r\n2: import assert from 'node:assert/strict'\r\n3: import fs from 'node:fs'\r\n4: import os from 'node:os'\r\n5: import path from 'node:path'\r\n6: import { spawnSync } from 'node:child_process'\r\n7: import { fileURLToPath } from 'node:url'\r\n8: \r\n9: import { extractTitles, mergeShards, validateIndex } from '../../scripts/check-traceability.mjs'\r\n10: \r\n11: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n12: const ROOT = path.resolve(HERE, '..', '..')\r\n13: const CHECK = path.join(ROOT, 'scripts', 'check-traceability.mjs')\r\n14: const INDEX_FILE = path.join(ROOT, 'contracts', 'spec', 'ac-index.json')\r\n15: const FIXTURES = path.join(ROOT, 'test', 'fixtures', 'traceability')\r\n16: const FIXTURE_INDEX = path.join(FIXTURES, 'ac-index.json')\r\n17: \r\n18: function readIndex() {\r\n19:   return JSON.parse(fs.readFileSync(INDEX_FILE, 'utf8'))\r\n20: }\r\n21: \r\n22: function entryOf(index, ac) {\r\n23:   return index.acs.find((item) => item.ac === ac)\r\n24: }\r\n25: \r\n26: function ids(errors) {\r\n27:   return errors.map((error) => error.id)\r\n28: }\r\n29: \r\n30: function runJson(root, extra = []) {\r\n31:   const result = spawnSync(\r\n32:     process.execPath,\r\n33:     [CHECK, '--root', root, '--index', FIXTURE_INDEX, '--json', ...extra],\r\n34:     { encoding: 'utf8' }\r\n35:   )\r\n36:   assert.ok(result.stdout, `expected JSON on stdout, got ${result.stdout}${result.stderr}`)\r\n37:   return { status: result.status, payload: JSON.parse(result.stdout) }\r\n38: }\r\n39: \r\n40: test('[AC-004] the committed AC index validates cleanly', () => {\r\n41:   const index = readIndex()\r\n42:   assert.equal(index.acs.length, 74)\r\n43:   assert.deepEqual(validateIndex(index), [])\r\n44: })\r\n45: \r\n46: test('[AC-004] index.count rejects missing, duplicated and reordered entries', () => {\r\n47:   const missing = readIndex()\r\n48:   missing.acs.pop()\r\n49:   assert.ok(ids(validateIndex(missing)).includes('index.count'))\r\n50: \r\n51:   const duplicated = readIndex()\r\n52:   duplicated.acs[73] = { ...duplicated.acs[0] }\r\n53:   assert.ok(ids(validateIndex(duplicated)).includes('index.count'))\r\n54: \r\n55:   const reordered = readIndex()\r\n56:   const first = reordered.acs[0]\r\n57:   reordered.acs[0] = reordered.acs[1]\r\n58:   reordered.acs[1] = first\r\n59:   assert.ok(ids(validateIndex(reordered)).includes('index.count'))\r\n60: })\r\n61: \r\n62: test('[AC-004] index.owner and index.milestone reject unknown values', () => {\r\n63:   const owner = readIndex()\r\n64:   entryOf(owner, 'AC-001').owner = 'T-1'\r\n65:   assert.ok(ids(validateIndex(owner)).includes('index.owner'))\r\n66: \r\n67:   const milestone = readIndex()\r\n68:   entryOf(milestone, 'AC-001').milestone = 'M6'\r\n69:   assert.ok(ids(validateIndex(milestone)).includes('index.milestone'))\r\n70: })\r\n71: \r\n72: test('[AC-004] index.levels and index.baseline reject empty, unknown and duplicate values', () => {\r\n73:   const emptyLevels = readIndex()\r\n74:   entryOf(emptyLevels, 'AC-001').levels = []\r\n75:   assert.ok(ids(validateIndex(emptyLevels)).includes('index.levels'))\r\n76: \r\n77:   const duplicateLevels = readIndex()\r\n78:   entryOf(duplicateLevels, 'AC-001').levels = ['unit', 'unit']\r\n79:   assert.ok(ids(validateIndex(duplicateLevels)).includes('index.levels'))\r\n80: \r\n81:   const unknownLevel = readIndex()\r\n82:   entryOf(unknownLevel, 'AC-001').levels = ['nope']\r\n83:   assert.ok(ids(validateIndex(unknownLevel)).includes('index.levels'))\r\n84: \r\n85:   const emptyBaseline = readIndex()\r\n86:   entryOf(emptyBaseline, 'AC-001').baseline = []\r\n87:   assert.ok(ids(validateIndex(emptyBaseline)).includes('index.baseline'))\r\n88: \r\n89:   const duplicateBaseline = readIndex()\r\n90:   entryOf(duplicateBaseline, 'AC-001').baseline = ['linux', 'linux']\r\n91:   assert.ok(ids(validateIndex(duplicateBaseline)).includes('index.baseline'))\r\n92: \r\n93:   const unknownBaseline = readIndex()\r\n94:   entryOf(unknownBaseline, 'AC-001').baseline = ['beos']\r\n95:   assert.ok(ids(validateIndex(unknownBaseline)).includes('index.baseline'))\r\n96: })\r\n97: \r\n98: test('[AC-004] index.baseline_incompatible rejects code levels on real-smoke and smoke on win32', () => {\r\n99:   const codeOnRealSmoke = readIndex()\r\n100:   entryOf(codeOnRealSmoke, 'AC-001').baseline = ['real-smoke']\r\n101:   assert.ok(ids(validateIndex(codeOnRealSmoke)).includes('index.baseline_incompatible'))\r\n102: \r\n103:   const smokeOnWin32 = readIndex()\r\n104:   entryOf(smokeOnWin32, 'AC-038').baseline = ['win32']\r\n105:   assert.ok(ids(validateIndex(smokeOnWin32)).includes('index.baseline_incompatible'))\r\n106: })\r\n107: \r\n108: test('[AC-004] index.schema rejects a wrong schema and entries with missing or extra keys', () => {\r\n109:   const wrongSchema = readIndex()\r\n110:   wrongSchema.schema = 'cliworker.ac-index/v2'\r\n111:   assert.ok(ids(validateIndex(wrongSchema)).includes('index.schema'))\r\n112: \r\n113:   const missingKey = readIndex()\r\n114:   delete entryOf(missingKey, 'AC-001').baseline\r\n115:   assert.ok(ids(validateIndex(missingKey)).includes('index.schema'))\r\n116: \r\n117:   const extraKey = readIndex()\r\n118:   entryOf(extraKey, 'AC-001').note = 'extra'\r\n119:   assert.ok(ids(validateIndex(extraKey)).includes('index.schema'))\r\n120: })\r\n121: \r\n122: test('[AC-004] shard fixtures cover pass, duplicate, not-owner, missing-file, missing-title and baseline', () => {\r\n123:   const cases = [\r\n124:     ['ok', 0, null],\r\n125:     ['duplicate', 1, 'shard.duplicate'],\r\n126:     ['not-owner', 1, 'shard.not_owner'],\r\n127:     ['missing-file', 1, 'shard.missing_file'],\r\n128:     ['missing-title', 1, 'shard.missing_title'],\r\n129:     ['baseline-in-shard', 1, 'shard.baseline_forbidden'],\r\n130:   ]\r\n131: \r\n132:   for (const [name, status, expectedId] of cases) {\r\n133:     const { status: actual, payload } = runJson(path.join(FIXTURES, name))\r\n134:     assert.equal(actual, status, `${name}: ${JSON.stringify(payload)}`)\r\n135:     assert.equal(payload.ok, status === 0, name)\r\n136:     if (expectedId) {\r\n137:       assert.ok(\r\n138:         payload.errors.some((error) => error.id === expectedId),\r\n139:         `${name} should report ${expectedId}, got ${JSON.stringify(payload.errors)}`\r\n140:       )\r\n141:     }\r\n142:   }\r\n143: \r\n144:   const { payload: duplicate } = runJson(path.join(FIXTURES, 'duplicate'))\r\n145:   assert.deepEqual([...new Set(duplicate.errors.map((error) => error.id))].sort(), [\r\n146:     'shard.duplicate',\r\n147:     'shard.not_owner',\r\n148:   ])\r\n149: })\r\n150: \r\n151: test('[AC-004] mergeShards treats ACs without a shard as planned', () => {\r\n152:   const index = readIndex()\r\n153:   const merged = mergeShards({ root: ROOT, index })\r\n154:   assert.deepEqual(merged.errors, [])\r\n155:   assert.equal(merged.acs['AC-001'], 'covered')\r\n156:   assert.equal(merged.acs['AC-004'], 'covered')\r\n157:   assert.equal(merged.acs['AC-074'], 'covered')\r\n158:   assert.equal(merged.acs['AC-005'], 'planned')\r\n159: })\r\n160: \r\n161: test('[AC-004] extractTitles ignores skipped titles and still reads platformTest titles', () => {\r\n162:   const source = [\r\n163:     \"test('[AC-004] plain', () => {})\",\r\n164:     \"test.skip('[AC-004] skipped', () => {})\",\r\n165:     \"test.todo('[AC-004] todo')\",\r\n166:     \"describe('[AC-004] group', () => {})\",\r\n167:     \"platformTest('[AC-004] gated', { requires: 'linux' }, () => {})\",\r\n168:     \"myTest('[AC-004] not a test call')\",\r\n169:   ].join('\\n')\r\n170: \r\n171:   const titles = extractTitles(source)\r\n172:   assert.deepEqual(titles.map((item) => item.kind), ['plain', 'skip', 'todo', 'plain', 'plain'])\r\n173:   assert.ok(titles.every((item) => item.title.includes('[AC-004]')))\r\n174: })\r\n175: \r\n176: test('[AC-004] the task graph cross-check flags a wrong owner and accepts the real graph', () => {\r\n177:   const index = readIndex()\r\n178:   const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-graph-'))\r\n179:   try {\r\n180:     const build = (overrideOwner) => {\r\n181:       const tasks = new Map()\r\n182:       for (const item of index.acs) {\r\n183:         const owner = item.ac === 'AC-001' && overrideOwner ? overrideOwner : item.owner\r\n184:         if (!tasks.has(owner)) tasks.set(owner, { id: owner, milestone: item.milestone, acceptance: [] })\r\n185:         tasks.get(owner).acceptance.push(item.ac)\r\n186:       }\r\n187:       return {\r\n188:         schema: 'agentline.taskgraph/v1',\r\n189:         acceptance: index.acs.map((item) => ({ id: item.ac, levels: item.levels })),\r\n190:         tasks: [...tasks.values()],\r\n191:       }\r\n192:     }\r\n193: \r\n194:     const wrongOwner = path.join(dir, 'wrong-owner.json')\r\n195:     fs.writeFileSync(wrongOwner, JSON.stringify(build('T-999')))\r\n196:     const flagged = runJson(ROOT, ['--task-graph', wrongOwner])\r\n197:     assert.equal(flagged.status, 1)\r\n198:     assert.ok(flagged.payload.errors.some((error) => error.id === 'graph.mismatch'))\r\n199: \r\n200:     const consistent = path.join(dir, 'consistent.json')\r\n201:     fs.writeFileSync(consistent, JSON.stringify(build(null)))\r\n202:     const clean = runJson(ROOT, ['--task-graph', consistent])\r\n203:     assert.equal(clean.status, 0, JSON.stringify(clean.payload.errors))\r\n204:     assert.ok(!clean.payload.errors.some((error) => error.id === 'graph.mismatch'))\r\n205:   } finally {\r\n206:     fs.rmSync(dir, { recursive: true, force: true })\r\n207:   }\r\n208: })\r\ntest/unit/milestone-gate.test.mjs\r\n1: import test from 'node:test'\r\n2: import assert from 'node:assert/strict'\r\n3: import path from 'node:path'\r\n4: import { spawnSync } from 'node:child_process'\r\n5: import { fileURLToPath } from 'node:url'\r\n6: \r\n7: import { extractTitles } from '../../scripts/check-traceability.mjs'\r\n8: \r\n9: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n10: const ROOT = path.resolve(HERE, '..', '..')\r\n11: const GATE = path.join(ROOT, 'scripts', 'milestone-gate.mjs')\r\n12: const DEFECTS = path.join(ROOT, 'scripts', 'check-defects.mjs')\r\n13: const FIXTURES = path.join(ROOT, 'test', 'fixtures', 'milestone-gate')\r\n14: const M2_PLANNED = path.join(FIXTURES, 'm2-planned')\r\n15: const M4_NOCACHE = path.join(FIXTURES, 'm4-nocache')\r\n16: \r\n17: function runGate(milestone, root) {\r\n18:   return spawnSync(process.execPath, [GATE, '--milestone', milestone, '--root', root], { encoding: 'utf8' })\r\n19: }\r\n20: \r\n21: function runDefects(args) {\r\n22:   return spawnSync(process.execPath, [DEFECTS, ...args], { encoding: 'utf8' })\r\n23: }\r\n24: \r\n25: function output(result) {\r\n26:   return `${result.stdout ?? ''}${result.stderr ?? ''}`\r\n27: }\r\n28: \r\n29: test('[AC-074] m2-planned: M1 passes while M2 is blocked by a planned AC and a missing fix', () => {\r\n30:   const m1 = runGate('M1', M2_PLANNED)\r\n31:   assert.equal(m1.status, 0, output(m1))\r\n32:   assert.match(m1.stdout, /milestone-gate M1: PASS/)\r\n33: \r\n34:   const m2 = runGate('M2', M2_PLANNED)\r\n35:   assert.equal(m2.status, 1, output(m2))\r\n36:   assert.match(m2.stdout, /milestone-gate M2: BLOCKED/)\r\n37:   assert.match(m2.stdout, /gate\\.ac_not_covered[^\\n]*AC-026/)\r\n38:   assert.match(m2.stdout, /defects\\.missing_fixed[^\\n]*a5-shell/)\r\n39:   assert.ok(!/gate\\.ac_not_covered[^\\n]*AC-001/.test(m2.stdout))\r\n40: })\r\n41: \r\n42: test('[AC-074] m4-nocache: M3 passes while M4 is blocked only by the missing fix', () => {\r\n43:   const m3 = runGate('M3', M4_NOCACHE)\r\n44:   assert.equal(m3.status, 0, output(m3))\r\n45:   assert.match(m3.stdout, /milestone-gate M3: PASS/)\r\n46: \r\n47:   const m4 = runGate('M4', M4_NOCACHE)\r\n48:   assert.equal(m4.status, 1, output(m4))\r\n49:   assert.match(m4.stdout, /milestone-gate M4: BLOCKED/)\r\n50:   assert.match(m4.stdout, /defects\\.missing_fixed[^\\n]*a5-nocache/)\r\n51:   assert.ok(!/gate\\.ac_not_covered/.test(m4.stdout))\r\n52: })\r\n53: \r\n54: test('[AC-074] check-defects default mode only demands a fix for covered ACs', () => {\r\n55:   const planned = runDefects(['--root', M2_PLANNED])\r\n56:   assert.equal(planned.status, 0, output(planned))\r\n57:   assert.match(planned.stdout, /check-defects: ok/)\r\n58: \r\n59:   const covered = runDefects(['--root', M4_NOCACHE])\r\n60:   assert.equal(covered.status, 1, output(covered))\r\n61:   assert.match(covered.stdout, /defects\\.missing_fixed[^\\n]*a5-nocache/)\r\n62: })\r\n63: \r\n64: test('[AC-074] check-defects --milestone demands a fix for every defect up to that milestone', () => {\r\n65:   const m1 = runDefects(['--milestone', 'M1', '--root', M2_PLANNED])\r\n66:   assert.equal(m1.status, 0, output(m1))\r\n67:   assert.ok(!/defects\\.set_mismatch/.test(m1.stdout))\r\n68:   assert.ok(!/defects\\.missing_fixed/.test(m1.stdout))\r\n69: \r\n70:   const m2 = runDefects(['--milestone', 'M2', '--root', M2_PLANNED])\r\n71:   assert.equal(m2.status, 1, output(m2))\r\n72:   assert.ok(!/defects\\.set_mismatch/.test(m2.stdout))\r\n73:   assert.match(m2.stdout, /defects\\.missing_fixed/)\r\n74: \r\n75:   const m5 = runDefects(['--milestone', 'M5', '--root', M2_PLANNED])\r\n76:   assert.equal(m5.status, 1, output(m5))\r\n77:   assert.match(m5.stdout, /defects\\.set_mismatch/)\r\n78: \r\n79:   const invalid = runDefects(['--milestone', 'M9', '--root', M2_PLANNED])\r\n80:   assert.equal(invalid.status, 2, output(invalid))\r\n81: })\r\n82: \r\n83: test('[AC-074] the milestone gate refuses to run without a valid milestone', () => {\r\n84:   const missing = spawnSync(process.execPath, [GATE, '--root', M2_PLANNED], { encoding: 'utf8' })\r\n85:   assert.equal(missing.status, 2, output(missing))\r\n86: \r\n87:   const invalid = spawnSync(process.execPath, [GATE, '--milestone', 'M9', '--root', M2_PLANNED], {\r\n88:     encoding: 'utf8',\r\n89:   })\r\n90:   assert.equal(invalid.status, 2, output(invalid))\r\n91: })\r\n92: \r\n93: test('[AC-074] extractTitles only counts plain titles for [fixed] and [repro]', () => {\r\n94:   const source = [\r\n95:     \"test('[repro] broken today', () => {})\",\r\n96:     \"test('[fixed] repaired', () => {})\",\r\n97:     \"test.skip('[fixed] not a fix', () => {})\",\r\n98:     \"test.todo('[fixed] still todo')\",\r\n99:   ].join('\\n')\r\n100: \r\n101:   const titles = extractTitles(source)\r\n102:   const plain = titles.filter((item) => item.kind === 'plain').map((item) => item.title)\r\n103:   assert.ok(plain.some((title) => title.startsWith('[fixed]')))\r\n104:   assert.ok(plain.some((title) => title.startsWith('[repro]')))\r\n105:   assert.equal(plain.filter((title) => title.startsWith('[fixed]')).length, 1)\r\n106: })\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\Users\\\\kayz\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\Microsoft.PowerShell_8wekyb3d8bbwe\\\\pwsh.exe\" -Command '$paths=@('\"'scripts/check-traceability.mjs','scripts/check-defects.mjs','scripts/milestone-gate.mjs'); foreach(\"'$p in $paths) { $p; $n=0; Get-Content -LiteralPath $p -Encoding utf8 | ForEach-Object { $n++; '\"'{0}: {1}' -f \"'$n,$_ } }'","aggregated_output":"scripts/check-traceability.mjs\r\n1: #!/usr/bin/env node\r\n2: // Traceability: validates contracts/spec/ac-index.json and merges test/traceability/*.json.\r\n3: // Exported helpers are reused by milestone-gate.mjs and check-defects.mjs.\r\n4: import fs from 'node:fs'\r\n5: import path from 'node:path'\r\n6: import { fileURLToPath } from 'node:url'\r\n7: \r\n8: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n9: const REPO_ROOT = path.resolve(HERE, '..')\r\n10: \r\n11: const SCHEMA = 'cliworker.ac-index/v1'\r\n12: const INDEX_KEYS = ['ac', 'owner', 'milestone', 'levels', 'baseline']\r\n13: const LEVELS = ['unit', 'integration', 'contract', 'e2e', 'smoke']\r\n14: const BASELINES = ['linux', 'win32', 'darwin', 'real-smoke']\r\n15: const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\r\n16: const NON_SMOKE_LEVELS = ['unit', 'contract', 'integration', 'e2e']\r\n17: \r\n18: const TITLE_RE = /(?<![\\w.])(test|it|describe|platformTest)(\\.(skip|todo|only))?\\s*\\(\\s*(['\"`])((?:\\\\.|(?!\\4).)*)\\4/g\r\n19: \r\n20: export function extractTitles(source) {\r\n21:   const titles = []\r\n22:   const text = String(source ?? '')\r\n23:   for (const match of text.matchAll(TITLE_RE)) {\r\n24:     titles.push({ kind: match[3] ? match[3] : 'plain', title: match[5] })\r\n25:   }\r\n26:   return titles\r\n27: }\r\n28: \r\n29: function expectedAcs() {\r\n30:   const list = []\r\n31:   for (let i = 1; i <= 74; i += 1) list.push(`AC-${String(i).padStart(3, '0')}`)\r\n32:   return list\r\n33: }\r\n34: \r\n35: function isStringArray(value) {\r\n36:   return Array.isArray(value) && value.every((item) => typeof item === 'string')\r\n37: }\r\n38: \r\n39: export function validateIndex(index) {\r\n40:   const errors = []\r\n41:   const push = (id, ac, detail) => errors.push({ id, ac, detail })\r\n42: \r\n43:   if (!index || typeof index !== 'object' || Array.isArray(index)) {\r\n44:     push('index.schema', undefined, 'index must be a JSON object')\r\n45:     return errors\r\n46:   }\r\n47:   if (index.schema !== SCHEMA) push('index.schema', undefined, `schema must be ${SCHEMA}`)\r\n48: \r\n49:   if (!Array.isArray(index.acs)) {\r\n50:     push('index.schema', undefined, 'acs must be an array')\r\n51:     return errors\r\n52:   }\r\n53: \r\n54:   for (const entry of index.acs) {\r\n55:     if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\r\n56:       push('index.schema', undefined, 'every entry must be a JSON object')\r\n57:       continue\r\n58:     }\r\n59:     const keys = Object.keys(entry)\r\n60:     const missing = INDEX_KEYS.filter((key) => !keys.includes(key))\r\n61:     const extra = keys.filter((key) => !INDEX_KEYS.includes(key))\r\n62:     if (missing.length > 0 || extra.length > 0) {\r\n63:       push(\r\n64:         'index.schema',\r\n65:         typeof entry.ac === 'string' ? entry.ac : undefined,\r\n66:         `entry keys must be exactly ${INDEX_KEYS.join(',')} (missing=${missing.join('|') || '-'} extra=${extra.join('|') || '-'})`\r\n67:       )\r\n68:     }\r\n69: \r\n70:     if (typeof entry.owner !== 'string' || !/^T-\\d{3}$/.test(entry.owner)) {\r\n71:       push('index.owner', entry.ac, 'owner must match ^T-\\\\d{3}$')\r\n72:     }\r\n73:     if (!MILESTONES.includes(entry.milestone)) {\r\n74:       push('index.milestone', entry.ac, `milestone must be one of ${MILESTONES.join(',')}`)\r\n75:     }\r\n76: \r\n77:     if (!isStringArray(entry.levels) || entry.levels.length === 0) {\r\n78:       push('index.levels', entry.ac, 'levels must be a non-empty array of strings')\r\n79:     } else {\r\n80:       const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\r\n81:       const duplicates = entry.levels.filter((level, i) => entry.levels.indexOf(level) !== i)\r\n82:       if (unknown.length > 0) push('index.levels', entry.ac, `unknown level(s): ${unknown.join(',')}`)\r\n83:       if (duplicates.length > 0) push('index.levels', entry.ac, `duplicate level(s): ${duplicates.join(',')}`)\r\n84:     }\r\n85: \r\n86:     if (!isStringArray(entry.baseline) || entry.baseline.length === 0) {\r\n87:       push('index.baseline', entry.ac, 'baseline must be a non-empty array of strings')\r\n88:     } else {\r\n89:       const unknown = entry.baseline.filter((base) => !BASELINES.includes(base))\r\n90:       const duplicates = entry.baseline.filter((base, i) => entry.baseline.indexOf(base) !== i)\r\n91:       if (unknown.length > 0) push('index.baseline', entry.ac, `unknown baseline(s): ${unknown.join(',')}`)\r\n92:       if (duplicates.length > 0) push('index.baseline', entry.ac, `duplicate baseline(s): ${duplicates.join(',')}`)\r\n93:     }\r\n94: \r\n95:     if (isStringArray(entry.levels) && isStringArray(entry.baseline)) {\r\n96:       const hasCodeLevel = entry.levels.some((level) => NON_SMOKE_LEVELS.includes(level))\r\n97:       const hasSmoke = entry.levels.includes('smoke')\r\n98:       const hasRealSmoke = entry.baseline.includes('real-smoke')\r\n99:       const hasNativeOnly = entry.baseline.includes('win32') || entry.baseline.includes('darwin')\r\n100:       if (hasCodeLevel && hasRealSmoke) {\r\n101:         push('index.baseline_incompatible', entry.ac, 'real-smoke baseline cannot back code levels')\r\n102:       }\r\n103:       if (hasSmoke && hasNativeOnly) {\r\n104:         push('index.baseline_incompatible', entry.ac, 'smoke levels only allow linux or real-smoke baselines')\r\n105:       }\r\n106:     }\r\n107:   }\r\n108: \r\n109:   const expected = expectedAcs()\r\n110:   const got = index.acs.map((entry) => (entry && typeof entry === 'object' ? entry.ac : undefined))\r\n111:   const inOrder = got.length === expected.length && got.every((ac, i) => ac === expected[i])\r\n112:   if (!inOrder) {\r\n113:     const seen = new Set()\r\n114:     const duplicates = new Set()\r\n115:     for (const ac of got) {\r\n116:       if (seen.has(ac)) duplicates.add(ac)\r\n117:       seen.add(ac)\r\n118:     }\r\n119:     const parts = [`expected exactly ${expected[0]}..${expected[expected.length - 1]} in order`]\r\n120:     parts.push(`got ${got.length} entries`)\r\n121:     if (duplicates.size > 0) parts.push(`duplicates: ${[...duplicates].join(',')}`)\r\n122:     push('index.count', undefined, parts.join(', '))\r\n123:   }\r\n124: \r\n125:   return errors\r\n126: }\r\n127: \r\n128: export function mergeShards({ root, index }) {\r\n129:   const errors = []\r\n130:   const shardDir = path.join(root, 'test', 'traceability')\r\n131:   const owners = new Map()\r\n132:   const indexAcs = []\r\n133:   for (const entry of index?.acs ?? []) {\r\n134:     if (!entry || typeof entry !== 'object') continue\r\n135:     owners.set(entry.ac, entry.owner)\r\n136:     indexAcs.push(entry.ac)\r\n137:   }\r\n138: \r\n139:   let names = []\r\n140:   try {\r\n141:     names = fs.readdirSync(shardDir).filter((name) => name.endsWith('.json')).sort()\r\n142:   } catch {\r\n143:     names = []\r\n144:   }\r\n145: \r\n146:   const declared = new Map()\r\n147: \r\n148:   for (const name of names) {\r\n149:     const rel = `test/traceability/${name}`\r\n150:     let shard\r\n151:     try {\r\n152:       shard = JSON.parse(fs.readFileSync(path.join(shardDir, name), 'utf8'))\r\n153:     } catch {\r\n154:       errors.push({ id: 'shard.schema', file: rel, detail: 'shard is not valid JSON' })\r\n155:       continue\r\n156:     }\r\n157:     if (!shard || typeof shard !== 'object' || Array.isArray(shard)) {\r\n158:       errors.push({ id: 'shard.schema', file: rel, detail: 'shard must be a JSON object' })\r\n159:       continue\r\n160:     }\r\n161: \r\n162:     const task = name.replace(/\\.json$/, '')\r\n163:     if (typeof shard.task !== 'string' || shard.task !== task) {\r\n164:       errors.push({ id: 'shard.schema', file: rel, detail: `task must be \"${task}\"` })\r\n165:     }\r\n166:     if (Object.prototype.hasOwnProperty.call(shard, 'baseline')) {\r\n167:       errors.push({ id: 'shard.baseline_forbidden', file: rel, detail: 'shard must not declare baseline' })\r\n168:     }\r\n169:     if (!Array.isArray(shard.entries)) {\r\n170:       errors.push({ id: 'shard.schema', file: rel, detail: 'entries must be an array' })\r\n171:       continue\r\n172:     }\r\n173: \r\n174:     for (const entry of shard.entries) {\r\n175:       if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\r\n176:         errors.push({ id: 'shard.schema', file: rel, detail: 'every entry must be a JSON object' })\r\n177:         continue\r\n178:       }\r\n179:       if (Object.prototype.hasOwnProperty.call(entry, 'baseline')) {\r\n180:         errors.push({\r\n181:           id: 'shard.baseline_forbidden',\r\n182:           ac: typeof entry.ac === 'string' ? entry.ac : undefined,\r\n183:           file: rel,\r\n184:           detail: 'entry must not declare baseline',\r\n185:         })\r\n186:       }\r\n187: \r\n188:       const ac = entry.ac\r\n189:       const status = entry.status\r\n190:       const files = entry.files\r\n191:       if (\r\n192:         typeof ac !== 'string' ||\r\n193:         ac === '' ||\r\n194:         (status !== 'covered' && status !== 'planned') ||\r\n195:         !Array.isArray(files)\r\n196:       ) {\r\n197:         errors.push({\r\n198:           id: 'shard.schema',\r\n199:           ac: typeof ac === 'string' ? ac : undefined,\r\n200:           file: rel,\r\n201:           detail: 'entry needs ac, status (covered|planned) and files',\r\n202:         })\r\n203:         continue\r\n204:       }\r\n205: \r\n206:       if (!owners.has(ac)) {\r\n207:         errors.push({ id: 'shard.unknown_ac', ac, file: rel, detail: 'AC is not declared in the index' })\r\n208:         continue\r\n209:       }\r\n210: \r\n211:       if (declared.has(ac)) {\r\n212:         const previous = declared.get(ac)\r\n213:         errors.push({\r\n214:           id: 'shard.duplicate',\r\n215:           ac,\r\n216:           file: rel,\r\n217:           detail: previous.shard === rel ? 'duplicate within shard' : `already declared in ${previous.shard}`,\r\n218:         })\r\n219:       } else {\r\n220:         declared.set(ac, { status, shard: rel })\r\n221:       }\r\n222: \r\n223:       if (shard.task !== owners.get(ac)) {\r\n224:         errors.push({\r\n225:           id: 'shard.not_owner',\r\n226:           ac,\r\n227:           file: rel,\r\n228:           detail: `owner is ${owners.get(ac)}`,\r\n229:         })\r\n230:       }\r\n231: \r\n232:       if (status !== 'covered') continue\r\n233: \r\n234:       let broken = false\r\n235:       if (files.length === 0) {\r\n236:         errors.push({ id: 'shard.missing_file', ac, file: rel, detail: 'covered entry needs at least one file' })\r\n237:         broken = true\r\n238:       }\r\n239:       for (const file of files) {\r\n240:         const unsafe =\r\n241:           typeof file !== 'string' ||\r\n242:           file === '' ||\r\n243:           path.isAbsolute(file) ||\r\n244:           file.split('/').includes('..') ||\r\n245:           file.split('\\\\').includes('..')\r\n246:         if (unsafe) {\r\n247:           errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `unsafe or empty path: ${String(file)}` })\r\n248:           broken = true\r\n249:           continue\r\n250:         }\r\n251:         if (!fs.existsSync(path.join(root, file))) {\r\n252:           errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `missing file: ${file}` })\r\n253:           broken = true\r\n254:         }\r\n255:       }\r\n256:       if (broken) continue\r\n257: \r\n258:       let tagged = false\r\n259:       for (const file of files) {\r\n260:         let source = ''\r\n261:         try {\r\n262:           source = fs.readFileSync(path.join(root, file), 'utf8')\r\n263:         } catch {\r\n264:           continue\r\n265:         }\r\n266:         if (extractTitles(source).some((item) => item.kind === 'plain' && item.title.includes(`[${ac}]`))) {\r\n267:           tagged = true\r\n268:           break\r\n269:         }\r\n270:       }\r\n271:       if (!tagged) {\r\n272:         errors.push({\r\n273:           id: 'shard.missing_title',\r\n274:           ac,\r\n275:           file: rel,\r\n276:           detail: `no plain test title contains [${ac}]`,\r\n277:         })\r\n278:       }\r\n279:     }\r\n280:   }\r\n281: \r\n282:   const acs = {}\r\n283:   for (const ac of indexAcs) {\r\n284:     const entry = declared.get(ac)\r\n285:     acs[ac] = entry ? entry.status : 'planned'\r\n286:   }\r\n287: \r\n288:   return { errors, acs }\r\n289: }\r\n290: \r\n291: function checkTaskGraph(taskGraphPath, index) {\r\n292:   const errors = []\r\n293:   let graph\r\n294:   try {\r\n295:     graph = JSON.parse(fs.readFileSync(taskGraphPath, 'utf8'))\r\n296:   } catch {\r\n297:     errors.push({ id: 'graph.mismatch', detail: `cannot read task graph: ${taskGraphPath}` })\r\n298:     return errors\r\n299:   }\r\n300: \r\n301:   const owners = new Map()\r\n302:   const milestones = new Map()\r\n303:   for (const task of Array.isArray(graph.tasks) ? graph.tasks : []) {\r\n304:     for (const ac of Array.isArray(task.acceptance) ? task.acceptance : []) {\r\n305:       owners.set(ac, task.id)\r\n306:       milestones.set(ac, task.milestone)\r\n307:     }\r\n308:   }\r\n309:   const levels = new Map()\r\n310:   for (const item of Array.isArray(graph.acceptance) ? graph.acceptance : []) {\r\n311:     if (item && typeof item.id === 'string') levels.set(item.id, item.levels)\r\n312:   }\r\n313: \r\n314:   const sameSet = (a, b) => {\r\n315:     if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false\r\n316:     const left = [...a].sort()\r\n317:     const right = [...b].sort()\r\n318:     return left.every((value, i) => value === right[i])\r\n319:   }\r\n320: \r\n321:   for (const entry of index?.acs ?? []) {\r\n322:     if (!entry || typeof entry !== 'object') continue\r\n323:     if (owners.get(entry.ac) !== entry.owner) {\r\n324:       errors.push({\r\n325:         id: 'graph.mismatch',\r\n326:         ac: entry.ac,\r\n327:         detail: `owner ${entry.owner} != task graph ${owners.get(entry.ac) ?? 'none'}`,\r\n328:       })\r\n329:     }\r\n330:     if (milestones.get(entry.ac) !== entry.milestone) {\r\n331:       errors.push({\r\n332:         id: 'graph.mismatch',\r\n333:         ac: entry.ac,\r\n334:         detail: `milestone ${entry.milestone} != task graph ${milestones.get(entry.ac) ?? 'none'}`,\r\n335:       })\r\n336:     }\r\n337:     if (levels.has(entry.ac) && !sameSet(levels.get(entry.ac), entry.levels)) {\r\n338:       errors.push({\r\n339:         id: 'graph.mismatch',\r\n340:         ac: entry.ac,\r\n341:         detail: `levels ${JSON.stringify(entry.levels)} != task graph ${JSON.stringify(levels.get(entry.ac))}`,\r\n342:       })\r\n343:     }\r\n344:   }\r\n345: \r\n346:   return errors\r\n347: }\r\n348: \r\n349: function fail(message) {\r\n350:   console.error(message)\r\n351:   process.exitCode = 2\r\n352: }\r\n353: \r\n354: function takeValue(args, index, flag) {\r\n355:   const value = args[index + 1]\r\n356:   if (typeof value !== 'string' || value === '') {\r\n357:     fail(`${flag} requires a value`)\r\n358:     return null\r\n359:   }\r\n360:   return value\r\n361: }\r\n362: \r\n363: function main() {\r\n364:   const args = process.argv.slice(2)\r\n365:   let root = REPO_ROOT\r\n366:   let indexPath = null\r\n367:   let taskGraphPath = null\r\n368:   let json = false\r\n369: \r\n370:   for (let i = 0; i < args.length; i += 1) {\r\n371:     const flag = args[i]\r\n372:     if (flag === '--root') {\r\n373:       const value = takeValue(args, i, flag)\r\n374:       if (value === null) return\r\n375:       root = path.resolve(value)\r\n376:       i += 1\r\n377:     } else if (flag === '--index') {\r\n378:       const value = takeValue(args, i, flag)\r\n379:       if (value === null) return\r\n380:       indexPath = path.resolve(value)\r\n381:       i += 1\r\n382:     } else if (flag === '--task-graph') {\r\n383:       const value = takeValue(args, i, flag)\r\n384:       if (value === null) return\r\n385:       taskGraphPath = path.resolve(value)\r\n386:       i += 1\r\n387:     } else if (flag === '--json') {\r\n388:       json = true\r\n389:     } else {\r\n390:       fail(`unknown argument: ${flag}\\nusage: node scripts/check-traceability.mjs [--root <dir>] [--index <file>] [--task-graph <file>] [--json]`)\r\n391:       return\r\n392:     }\r\n393:   }\r\n394: \r\n395:   const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\r\n396:   const errors = []\r\n397: \r\n398:   let index = null\r\n399:   try {\r\n400:     index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\r\n401:   } catch {\r\n402:     errors.push({ id: 'index.schema', detail: `cannot read index: ${indexFile}` })\r\n403:   }\r\n404: \r\n405:   let acs = {}\r\n406:   if (index) {\r\n407:     errors.push(...validateIndex(index))\r\n408:     const merged = mergeShards({ root, index })\r\n409:     errors.push(...merged.errors)\r\n410:     acs = merged.acs\r\n411:   }\r\n412:   if (taskGraphPath && index) errors.push(...checkTaskGraph(taskGraphPath, index))\r\n413: \r\n414:   const entries = Object.keys(acs)\r\n415:     .sort()\r\n416:     .map((ac) => ({ ac, status: acs[ac] }))\r\n417:   const covered = entries.filter((item) => item.status === 'covered').length\r\n418:   const planned = entries.filter((item) => item.status === 'planned').length\r\n419: \r\n420:   if (json) {\r\n421:     const payload = {\r\n422:       ok: errors.length === 0,\r\n423:       errors: errors.map((error) => {\r\n424:         const out = { id: error.id }\r\n425:         if (error.ac !== undefined) out.ac = error.ac\r\n426:         if (error.file !== undefined) out.file = error.file\r\n427:         out.detail = error.detail ?? ''\r\n428:         return out\r\n429:       }),\r\n430:       covered,\r\n431:       planned,\r\n432:       acs: entries,\r\n433:     }\r\n434:     process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`)\r\n435:   } else {\r\n436:     for (const error of errors) {\r\n437:       const where = error.ac ?? error.file ?? '-'\r\n438:       process.stdout.write(`FAIL ${error.id} ${where} ${error.detail ?? ''}`.trimEnd() + '\\n')\r\n439:     }\r\n440:     if (errors.length > 0) {\r\n441:       process.stdout.write(`check-traceability: FAILED (${errors.length} errors)\\n`)\r\n442:     } else {\r\n443:       process.stdout.write(`check-traceability: ok (covered=${covered} planned=${planned})\\n`)\r\n444:     }\r\n445:   }\r\n446: \r\n447:   process.exitCode = errors.length > 0 ? 1 : 0\r\n448: }\r\n449: \r\n450: const invokedDirectly =\r\n451:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n452: \r\n453: if (invokedDirectly) main()\r\nscripts/check-defects.mjs\r\n1: #!/usr/bin/env node\r\n2: // Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\r\n3: import fs from 'node:fs'\r\n4: import path from 'node:path'\r\n5: import { fileURLToPath } from 'node:url'\r\n6: \r\n7: import { mergeShards, extractTitles } from './check-traceability.mjs'\r\n8: \r\n9: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n10: const REPO_ROOT = path.resolve(HERE, '..')\r\n11: \r\n12: const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\r\n13: const EXPECTED_IDS = [\r\n14:   'a1-quota',\r\n15:   'a2-pack',\r\n16:   'a3-runner',\r\n17:   'a4-paths',\r\n18:   'a4-null-config',\r\n19:   'a5-dup-call',\r\n20:   'a5-forecast-x3',\r\n21:   'a5-unused',\r\n22:   'a5-ignored-fields',\r\n23:   'a5-shell',\r\n24:   'a5-nocache',\r\n25: ]\r\n26: \r\n27: const LEDGER = ['test', 'characterization', 'defects.json']\r\n28: const DEFECTS_DIR = ['test', 'characterization', 'defects']\r\n29: \r\n30: export function milestoneRank(value) {\r\n31:   const index = MILESTONES.indexOf(value)\r\n32:   return index < 0 ? Number.NaN : index + 1\r\n33: }\r\n34: \r\n35: export function hasFixedSection(source) {\r\n36:   return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\r\n37: }\r\n38: \r\n39: export function checkDefects({ root, index, milestone }) {\r\n40:   const errors = []\r\n41:   const ledgerFile = path.join(root, ...LEDGER)\r\n42: \r\n43:   if (!fs.existsSync(ledgerFile)) {\r\n44:     if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\r\n45:     return { errors, absent: true }\r\n46:   }\r\n47: \r\n48:   let ledger = null\r\n49:   try {\r\n50:     ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\r\n51:   } catch {\r\n52:     errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\r\n53:     return { errors, absent: false }\r\n54:   }\r\n55: \r\n56:   const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\r\n57:   if (!list) {\r\n58:     errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\r\n59:     return { errors, absent: false }\r\n60:   }\r\n61: \r\n62:   const knownAcs = new Set()\r\n63:   for (const entry of index?.acs ?? []) {\r\n64:     if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\r\n65:   }\r\n66: \r\n67:   const seen = new Set()\r\n68:   const valid = []\r\n69:   for (const item of list) {\r\n70:     if (!item || typeof item !== 'object' || Array.isArray(item)) {\r\n71:       errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\r\n72:       continue\r\n73:     }\r\n74:     const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\r\n75:     const problems = []\r\n76:     if (typeof id !== 'string' || id === '') problems.push('id')\r\n77:     if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\r\n78:     if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\r\n79:     if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\r\n80: \r\n81:     if (problems.length > 0) {\r\n82:       errors.push({\r\n83:         id: 'defects.schema',\r\n84:         detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\r\n85:       })\r\n86:       continue\r\n87:     }\r\n88:     if (seen.has(id)) {\r\n89:       errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\r\n90:       continue\r\n91:     }\r\n92:     seen.add(id)\r\n93:     valid.push({ id, ownerTask, ownerMilestone, ac })\r\n94:   }\r\n95: \r\n96:   if (milestone === 'M5') {\r\n97:     const actual = [...seen].sort()\r\n98:     const expected = [...EXPECTED_IDS].sort()\r\n99:     if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\r\n100:       errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\r\n101:     }\r\n102:   }\r\n103: \r\n104:   let required = []\r\n105:   if (milestone) {\r\n106:     const limit = milestoneRank(milestone)\r\n107:     required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\r\n108:   } else {\r\n109:     const merged = mergeShards({ root, index })\r\n110:     required = valid.filter((item) => merged.acs[item.ac] === 'covered')\r\n111:   }\r\n112: \r\n113:   for (const item of required) {\r\n114:     const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\r\n115:     let source = null\r\n116:     try {\r\n117:       source = fs.readFileSync(file, 'utf8')\r\n118:     } catch {\r\n119:       source = null\r\n120:     }\r\n121:     if (source === null || !hasFixedSection(source)) {\r\n122:       errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\r\n123:     }\r\n124:   }\r\n125: \r\n126:   return { errors, absent: false }\r\n127: }\r\n128: \r\n129: function main() {\r\n130:   const args = process.argv.slice(2)\r\n131:   let root = REPO_ROOT\r\n132:   let indexPath = null\r\n133:   let milestone = null\r\n134: \r\n135:   for (let i = 0; i < args.length; i += 1) {\r\n136:     const flag = args[i]\r\n137:     if (flag === '--root') {\r\n138:       const value = args[i + 1]\r\n139:       if (typeof value !== 'string' || value === '') {\r\n140:         process.stderr.write('--root requires a directory\\n')\r\n141:         process.exitCode = 2\r\n142:         return\r\n143:       }\r\n144:       root = path.resolve(value)\r\n145:       i += 1\r\n146:     } else if (flag === '--index') {\r\n147:       const value = args[i + 1]\r\n148:       if (typeof value !== 'string' || value === '') {\r\n149:         process.stderr.write('--index requires a file\\n')\r\n150:         process.exitCode = 2\r\n151:         return\r\n152:       }\r\n153:       indexPath = path.resolve(value)\r\n154:       i += 1\r\n155:     } else if (flag === '--milestone') {\r\n156:       const value = args[i + 1]\r\n157:       if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\r\n158:         process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\r\n159:         process.exitCode = 2\r\n160:         return\r\n161:       }\r\n162:       milestone = value\r\n163:       i += 1\r\n164:     } else {\r\n165:       process.stderr.write(\r\n166:         `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>]\\n`\r\n167:       )\r\n168:       process.exitCode = 2\r\n169:       return\r\n170:     }\r\n171:   }\r\n172: \r\n173:   const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\r\n174:   let index = { acs: [] }\r\n175:   try {\r\n176:     index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\r\n177:   } catch {\r\n178:     index = { acs: [] }\r\n179:   }\r\n180: \r\n181:   const { errors, absent } = checkDefects({ root, index, milestone })\r\n182: \r\n183:   if (absent && !milestone) {\r\n184:     process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\r\n185:     process.exitCode = 0\r\n186:     return\r\n187:   }\r\n188: \r\n189:   if (errors.length === 0) {\r\n190:     process.stdout.write('check-defects: ok\\n')\r\n191:     process.exitCode = 0\r\n192:     return\r\n193:   }\r\n194:   for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\r\n195:   process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\r\n196:   process.exitCode = 1\r\n197: }\r\n198: \r\n199: const invokedDirectly =\r\n200:   process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n201: \r\n202: if (invokedDirectly) main()\r\nscripts/milestone-gate.mjs\r\n1: #!/usr/bin/env node\r\n2: // Milestone gate: every AC owned by a task up to the requested milestone must be covered,\r\n3: // its defects fixed, and its files must actually run in a full test run.\r\n4: import fs from 'node:fs'\r\n5: import os from 'node:os'\r\n6: import path from 'node:path'\r\n7: import { spawnSync } from 'node:child_process'\r\n8: import { fileURLToPath } from 'node:url'\r\n9: \r\n10: import { mergeShards } from './check-traceability.mjs'\r\n11: import { checkDefects, milestoneRank } from './check-defects.mjs'\r\n12: \r\n13: const HERE = path.dirname(fileURLToPath(import.meta.url))\r\n14: const REPO_ROOT = path.resolve(HERE, '..')\r\n15: const RUN_TESTS = path.join(HERE, 'run-tests.mjs')\r\n16: \r\n17: function collectCoveredFiles(root) {\r\n18:   const map = new Map()\r\n19:   const dir = path.join(root, 'test', 'traceability')\r\n20:   let names = []\r\n21:   try {\r\n22:     names = fs.readdirSync(dir).filter((name) => name.endsWith('.json'))\r\n23:   } catch {\r\n24:     return map\r\n25:   }\r\n26:   for (const name of names) {\r\n27:     let shard = null\r\n28:     try {\r\n29:       shard = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8'))\r\n30:     } catch {\r\n31:       continue\r\n32:     }\r\n33:     for (const entry of Array.isArray(shard?.entries) ? shard.entries : []) {\r\n34:       if (!entry || entry.status !== 'covered' || typeof entry.ac !== 'string') continue\r\n35:       const files = Array.isArray(entry.files) ? entry.files.filter((file) => typeof file === 'string') : []\r\n36:       map.set(entry.ac, files)\r\n37:     }\r\n38:   }\r\n39:   return map\r\n40: }\r\n41: \r\n42: export function runGate({ root, index, milestone }) {\r\n43:   const errors = []\r\n44:   const limit = milestoneRank(milestone)\r\n45:   const entries = Array.isArray(index?.acs) ? index.acs : []\r\n46: \r\n47:   const merged = mergeShards({ root, index })\r\n48:   for (const error of merged.errors) {\r\n49:     const where = error.ac ?? error.file ?? '-'\r\n50:     errors.push({ id: 'gate.trace_error', detail: `${where} ${error.detail ?? error.id}`.trim() })\r\n51:   }\r\n52: \r\n53:   for (const entry of entries) {\r\n54:     if (!entry || typeof entry !== 'object') continue\r\n55:     if (!(milestoneRank(entry.milestone) <= limit)) continue\r\n56:     if (merged.acs[entry.ac] !== 'covered') {\r\n57:       errors.push({ id: 'gate.ac_not_covered', detail: `${entry.ac} is ${merged.acs[entry.ac] ?? 'planned'}` })\r\n58:     }\r\n59:   }\r\n60: \r\n61:   errors.push(...checkDefects({ root, index, milestone }).errors)\r\n62: \r\n63:   if (errors.length > 0) return errors\r\n64: \r\n65:   const coveredFiles = collectCoveredFiles(root)\r\n66:   const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-gate-'))\r\n67:   try {\r\n68:     const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\r\n69:       cwd: root,\r\n70:       encoding: 'utf8',\r\n71:       maxBuffer: 64 * 1024 * 1024,\r\n72:     })\r\n73:     if (result.status !== 0) {\r\n74:       const tail = (result.stderr || result.stdout || '').trim().split('\\n').slice(-3).join(' | ')\r\n75:       errors.push({ id: 'gate.run_failed', detail: `full run exited ${result.status}${tail ? `: ${tail}` : ''}` })\r\n76:       return errors\r\n77:     }\r\n78: \r\n79:     let manifest = null\r\n80:     try {\r\n81:       manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\r\n82:     } catch {\r\n83:       manifest = null\r\n84:     }\r\n85:     if (!manifest || manifest.mode !== 'full') {\r\n86:       errors.push({ id: 'gate.manifest_not_full', detail: `mode is ${manifest?.mode ?? 'missing'}` })\r\n87:     }\r\n88: \r\n89:     const executed = new Set(Array.isArray(manifest?.files) ? manifest.files : [])\r\n90:     for (const entry of entries) {\r\n91:       if (!entry || typeof entry !== 'object') continue\r\n92:       if (!(milestoneRank(entry.milestone) <= limit)) continue\r\n93:       if (merged.acs[entry.ac] !== 'covered') continue\r\n94:       for (const file of coveredFiles.get(entry.ac) ?? []) {\r\n95:         if (!executed.has(file)) {\r\n96:           errors.push({ id: 'gate.file_not_executed', detail: `${file} (${entry.ac})` })\r\n97:         }\r\n98:       }\r\n99:     }\r\n100:   } finally {\r\n101:     fs.rmSync(outDir, { recursive: true, force: true })\r\n102:   }\r\n103: \r\n104:   return errors\r\n105: }\r\n106: \r\n107: function main() {\r\n108:   const args = process.argv.slice(2)\r\n109:   let root = REPO_ROOT\r\n110:   let indexPath = null\r\n111:   let milestone = null\r\n112: \r\n113:   for (let i = 0; i < args.length; i += 1) {\r\n114:     const flag = args[i]\r\n115:     if (flag === '--root') {\r\n116:       const value = args[i + 1]\r\n117:   