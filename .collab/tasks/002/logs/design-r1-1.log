{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wonh52yUbJ5mPzgrR9iVm2","type":"tool_result","content":"=== lib/config.mjs\n     1\timport fs from 'node:fs'\r\n     2\timport os from 'node:os'\r\n     3\timport path from 'node:path'\r\n     4\t\r\n     5\texport const SCHEMA = 'cliworker.config/v1'\r\n     6\t\r\n     7\texport function defaultHome() {\r\n     8\t  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\r\n     9\t}\r\n    10\t\r\n    11\texport function loadConfig({ file } = {}) {\r\n    12\t  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\r\n    13\t  let raw\r\n    14\t  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\r\n    15\t    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\r\n    16\t    error.code = 'E_CONFIG'\r\n    17\t    throw error\r\n    18\t  }\r\n    19\t  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\r\n    20\t  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\r\n    21\t  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\r\n    22\t  return { ...raw, _file: root, _home: defaultHome() }\r\n    23\t}\r\n    24\t\r\n    25\texport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\r\n    26\t\r\n    27\texport function readUsage(file) {\r\n    28\t  try {\r\n    29\t    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\r\n    30\t  } catch { return [] }\r\n    31\t}\r\n    32\t\r\n    33\texport function appendUsage(file, row) {\r\n    34\t  ensureDir(path.dirname(file))\r\n    35\t  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\r\n    36\t}\r\n=== lib/forecast.mjs\n     1\texport const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\r\n     2\t\r\n     3\texport function normalizePrices(m = {}) {\r\n     4\t  const p = m.prices || {}\r\n     5\t  return {\r\n     6\t    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\r\n     7\t    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\r\n     8\t  }\r\n     9\t}\r\n    10\t\r\n    11\texport function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\r\n    12\t  const p = { ...DEFAULT_PRICES, ...prices }\r\n    13\t  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\r\n    14\t}\r\n    15\t\r\n    16\t/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\r\n    17\texport function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\r\n    18\t  const rows = records.filter((r) => !model || r.model === model)\r\n    19\t  const samples = rows.map((r) => ({\r\n    20\t    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\r\n    21\t    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\r\n    22\t  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\r\n    23\t  if (!samples.length) {\r\n    24\t    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\r\n    25\t  }\r\n    26\t  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\r\n    27\t  const use = recent.length ? recent : samples.slice(-10)\r\n    28\t  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\r\n    29\t  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\r\n    30\t  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\r\n    31\t  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\r\n    32\t  let tasksLeft = null\r\n    33\t  let etaHours = null\r\n    34\t  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\r\n    35\t    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\r\n    36\t    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\r\n    37\t  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\r\n    38\t    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\r\n    39\t  }\r\n    40\t  const confidence = use.length >= 5 ? 'medium' : 'low'\r\n    41\t  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\r\n    42\t  return {\r\n    43\t    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\r\n    44\t    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\r\n    45\t    confidence, risk,\r\n    46\t  }\r\n    47\t}\r\n    48\t\r\n    49\tfunction round(n) { return Math.round(n * 1e6) / 1e6 }\r\n=== lib/select.mjs\n     1\timport { normalizePrices, forecast } from './forecast.mjs'\r\n     2\t\r\n     3\texport const SCHEMA = 'cliworker.selection/v1'\r\n     4\texport const LEVELS = ['Top', 'High', 'Middle', 'Quick']\r\n     5\texport const USAGES = ['Heavy', 'Normal', 'Light']\r\n     6\t\r\n     7\tfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\r\n     8\tfunction normLevel(v) {\r\n     9\t  const s = String(v || '').trim().toLowerCase()\r\n    10\t  return LEVELS.find((x) => x.toLowerCase() === s) || null\r\n    11\t}\r\n    12\tfunction normUsage(v) {\r\n    13\t  const s = String(v || '').trim().toLowerCase()\r\n    14\t  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\r\n    15\t}\r\n    16\t\r\n    17\tfunction vendorOf(provider) {\r\n    18\t  const p = String(provider || '').toLowerCase()\r\n    19\t  if (p.includes('claude')) return 'anthropic'\r\n    20\t  if (p.includes('codex') || p.includes('openai')) return 'openai'\r\n    21\t  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\r\n    22\t  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\r\n    23\t  if (p.includes('gemini') || p.includes('google')) return 'google'\r\n    24\t  return p\r\n    25\t}\r\n    26\t\r\n    27\tfunction levelOf(m) {\r\n    28\t  if (m.level && LEVELS.includes(m.level)) return m.level\r\n    29\t  if (m.tier === 'top') return 'Top'\r\n    30\t  if (m.tier === 'advanced') return 'High'\r\n    31\t  if (m.tier === 'standard') return 'Middle'\r\n    32\t  return 'Quick'\r\n    33\t}\r\n    34\t\r\n    35\tfunction cliCall(config, model, request) {\r\n    36\t  const p = config.providers?.[model.provider] || {}\r\n    37\t  const id = model.id\r\n    38\t  const cwd = request.cwd || '<workspace>'\r\n    39\t  if (model.provider === 'claude') {\r\n    40\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\r\n    41\t  }\r\n    42\t  if (model.provider === 'codex') {\r\n    43\t    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\r\n    44\t  }\r\n    45\t  if (model.provider === 'codebuddy') {\r\n    46\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\r\n    47\t  }\r\n    48\t  if (model.provider === 'cursor-wsl') {\r\n    49\t    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\r\n    50\t  }\r\n    51\t  if (model.provider === 'gemini') {\r\n    52\t    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\r\n    53\t  }\r\n    54\t  return { command: p.cli || null, args: [], input: 'stdin', cwd }\r\n    55\t}\r\n    56\t\r\n    57\texport function listModels(config, { status = {}, includeDeprecated = false } = {}) {\r\n    58\t  return Object.entries(config.models).map(([key, m]) => {\r\n    59\t    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\r\n    60\t    const callable = st.state === 'callable' && !m.deprecated\r\n    61\t    return {\r\n    62\t      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\r\n    63\t      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\r\n    64\t      identity: m.identity === 'verified' ? 'verified' : 'unverified',\r\n    65\t      identity_group: m.identity_group || null,\r\n    66\t      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\r\n    67\t      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\r\n    68\t      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\r\n    69\t      prices: normalizePrices(m), source: 'config',\r\n    70\t      provider_detail: st.detail || null,\r\n    71\t    }\r\n    72\t  }).filter((m) => includeDeprecated || !m.deprecated)\r\n    73\t}\r\n    74\t\r\n    75\texport function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\r\n    76\t  const level = normLevel(request.level || request.tier)\r\n    77\t  const usageKind = normUsage(request.usage)\r\n    78\t  const models = listModels(config, { status, includeDeprecated: true })\r\n    79\t  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\r\n    80\t  const requireVerified = request.require_verified !== false\r\n    81\t  const requireReadonly = request.require_readonly === true\r\n    82\t  const exclude = new Set(request.exclude || [])\r\n    83\t  const allowed = request.candidates ? new Set(request.candidates) : null\r\n    84\t  const rejected = []\r\n    85\t  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\r\n    86\t\r\n    87\t  const candidates = models.filter((m) => {\r\n    88\t    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\r\n    89\t    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\r\n    90\t    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\r\n    91\t    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\r\n    92\t    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\r\n    93\t    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\r\n    94\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\r\n    95\t    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\r\n    96\t      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\r\n    97\t    }\r\n    98\t    return true\r\n    99\t  })\r\n   100\t\r\n   101\t  const rank = (m) => {\r\n   102\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\r\n   103\t    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\r\n   104\t    const unknown = f.risk === 'unknown' ? 1 : 0\r\n   105\t    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\r\n   106\t    if (usageKind === 'Light') return [price, unknown, m.key]\r\n   107\t    return [unknown, price, m.key]\r\n   108\t  }\r\n   109\t  candidates.sort((a, b) => {\r\n   110\t    const ra = rank(a), rb = rank(b)\r\n   111\t    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\r\n   112\t    return 0\r\n   113\t  })\r\n   114\t\r\n   115\t  const picked = candidates.slice(0, count).map((m) => {\r\n   116\t    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\r\n   117\t    const call = cliCall(config, m, request)\r\n   118\t    return {\r\n   119\t      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\r\n   120\t      adapter: config.providers[m.provider]?.adapter || null,\r\n   121\t      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\r\n   122\t      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\r\n   123\t      forecast: f, cli: call, call,\r\n   124\t    }\r\n   125\t  })\r\n   126\t  return {\r\n   127\t    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\r\n   128\t    models: picked, calls: picked.map((x) => x.call), rejected,\r\n   129\t    reason: picked.length ? null : 'no_eligible_model',\r\n   130\t    truncated: picked.length < count,\r\n   131\t  }\r\n   132\t}\r\n=== lib/cli.mjs\n     1\timport fs from 'node:fs'\r\n     2\timport path from 'node:path'\r\n     3\timport { loadConfig, defaultHome, readUsage, appendUsage } from './config.mjs'\r\n     4\timport { providerStatus } from './availability.mjs'\r\n     5\timport { listModels, selectModels, SCHEMA as SELECT_SCHEMA } from './select.mjs'\r\n     6\timport { forecast, estimateCost } from './forecast.mjs'\r\n     7\t\r\n     8\tfunction out(x) { process.stdout.write(JSON.stringify(x, null, 2) + '\\n') }\r\n     9\tfunction fail(message, code = 1) { process.stderr.write(`ERROR: ${message}\\n`); process.exit(code) }\r\n    10\tfunction arg(name, fallback) { const i = process.argv.indexOf(name); return i >= 0 ? process.argv[i + 1] : fallback }\r\n    11\tfunction flag(name) { return process.argv.includes(name) }\r\n    12\tfunction usageFile(config) { return path.join(config._home || defaultHome(), 'usage.jsonl') }\r\n    13\t\r\n    14\tfunction load() {\r\n    15\t  try { return loadConfig({ file: arg('--config') }) } catch (e) { fail(e.message) }\r\n    16\t}\r\n    17\t\r\n    18\tfunction main() {\r\n    19\t  const cmd = process.argv[2]\r\n    20\t  const sub = process.argv[3]\r\n    21\t  const config = load()\r\n    22\t  if (cmd === 'providers') {\r\n    23\t    const status = providerStatus(config)\r\n    24\t    out({ schema: 'cliworker.providers/v1', providers: Object.entries(config.providers).map(([id, p]) => ({ id, cli: p.cli, readonly: !!p.readonly, ...status[id] })) })\r\n    25\t    return\r\n    26\t  }\r\n    27\t  if (cmd === 'models' && (!sub || sub === 'list')) {\r\n    28\t    const status = providerStatus(config)\r\n    29\t    out({ schema: 'cliworker.models/v1', models: listModels(config, { status, includeDeprecated: flag('--all') }) })\r\n    30\t    return\r\n    31\t  }\r\n    32\t  if (cmd === 'models' && sub === 'select') {\r\n    33\t    let req = {}\r\n    34\t    const raw = arg('--request')\r\n    35\t    if (raw) { try { req = JSON.parse(raw) } catch (e) { fail(`bad --request JSON: ${e.message}`) } }\r\n    36\t    const status = providerStatus(config)\r\n    37\t    out(selectModels(config, req, { status, usage: readUsage(usageFile(config)) }))\r\n    38\t    return\r\n    39\t  }\r\n    40\t  if (cmd === 'models' && sub === 'forecast') {\r\n    41\t    const key = arg('--model', null)\r\n    42\t    const usage = readUsage(usageFile(config))\r\n    43\t    out({ schema: 'cliworker.forecast/v1', forecast: forecast({ records: usage, model: key, prices: key ? config.models[key]?.prices : undefined, quota: key ? config.quotas?.[config.models[key]?.provider] : null }) })\r\n    44\t    return\r\n    45\t  }\r\n    46\t  if (cmd === 'usage' && sub === 'record') {\r\n    47\t    let row\r\n    48\t    const raw = arg('--json')\r\n    49\t    try { row = JSON.parse(raw) } catch (e) { fail(`bad --json: ${e.message}`) }\r\n    50\t    if (!row.model) fail('usage record requires model')\r\n    51\t    const m = config.models[row.model]\r\n    52\t    if (m) row.cost_usd = row.cost_usd ?? estimateCost({ input_tokens: row.input_tokens, output_tokens: row.output_tokens, prices: m.prices })\r\n    53\t    row.at = row.at || new Date().toISOString()\r\n    54\t    appendUsage(usageFile(config), row)\r\n    55\t    out({ schema: 'cliworker.usage/v1', ok: true, recorded: row })\r\n    56\t    return\r\n    57\t  }\r\n    58\t  if (cmd === 'usage' && sub === 'summary') {\r\n    59\t    out({ schema: 'cliworker.usage/v1', records: readUsage(usageFile(config)) })\r\n    60\t    return\r\n    61\t  }\r\n    62\t  fail('usage: cliworker providers | models list|select|forecast | usage record|summary')\r\n    63\t}\r\n    64\t\r\n    65\tmain()\r\n=== lib/availability.mjs\n     1\timport { spawnSync } from 'node:child_process'\r\n     2\t\r\n     3\tfunction run(command, args, timeout = 20_000) {\r\n     4\t  try {\r\n     5\t    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\r\n     6\t    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\r\n     7\t  } catch (e) {\r\n     8\t    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\r\n     9\t  }\r\n    10\t}\r\n    11\t\r\n    12\texport function checkProvider(provider, { probe = true } = {}) {\r\n    13\t  const cli = provider.cli\r\n    14\t  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\r\n    15\t  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\r\n    16\t  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\r\n    17\t  const v = run(cli, versionArgs)\r\n    18\t  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\r\n    19\t  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\r\n    20\t  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\r\n    21\t  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\r\n    22\t  const auth = run(cli, [...prefix, ...provider.auth_args])\r\n    23\t  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\r\n    24\t  const ok = auth.ok && (\r\n    25\t    !provider.auth_ok ||\r\n    26\t    text.includes(String(provider.auth_ok).toLowerCase()) ||\r\n    27\t    /\"loggedin\"\\s*:\\s*true/.test(text) ||\r\n    28\t    /\\blogged in\\b/.test(text)\r\n    29\t  )\r\n    30\t  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\r\n    31\t}\r\n    32\t\r\n    33\texport function providerStatus(config, opts = {}) {\r\n    34\t  const out = {}\r\n    35\t  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\r\n    36\t  return out\r\n    37\t}\r\n=== lib/index.js\n     1\t/**\r\n     2\t * dsh-cliworker — DSH host plugin.\r\n     3\t *\r\n     4\t * AgentLine and other clients only need the model source pointer:\r\n     5\t *   modelSource = { kind: \"cliworker\", command: \"node\",\r\n     6\t *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\r\n     7\t *\r\n     8\t * The plugin exposes the same selection contract over DSH routes for UI use.\r\n     9\t */\r\n    10\timport path from 'node:path'\r\n    11\timport os from 'node:os'\r\n    12\timport { fileURLToPath } from 'node:url'\r\n    13\timport { loadConfig } from '../lib/config.mjs'\r\n    14\timport { providerStatus } from '../lib/availability.mjs'\r\n    15\timport { listModels, selectModels } from '../lib/select.mjs'\r\n    16\timport { forecast } from '../lib/forecast.mjs'\r\n    17\t\r\n    18\tconst __dirname = path.dirname(fileURLToPath(import.meta.url))\r\n    19\tconst DEFAULTS = {\r\n    20\t  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\r\n    21\t  readonly: false,\r\n    22\t}\r\n    23\t\r\n    24\tfunction send(res, body, code = 200) {\r\n    25\t  res.statusCode = code\r\n    26\t  res.setHeader('content-type', 'application/json; charset=utf-8')\r\n    27\t  res.setHeader('cache-control', 'no-store')\r\n    28\t  res.end(JSON.stringify(body))\r\n    29\t}\r\n    30\t\r\n    31\tfunction readBody(req) {\r\n    32\t  return new Promise((resolve, reject) => {\r\n    33\t    let raw = ''\r\n    34\t    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\r\n    35\t    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\r\n    36\t    req.on('error', reject)\r\n    37\t  })\r\n    38\t}\r\n    39\t\r\n    40\texport const name = 'cliworker'\r\n    41\t\r\n    42\texport function apply(ctx, config = {}) {\r\n    43\t  const settings = { ...DEFAULTS, ...(config || {}) }\r\n    44\t  const getConfig = () => loadConfig({ file: settings.configPath })\r\n    45\t\r\n    46\t  try {\r\n    47\t    ctx.inject(['webServer'], (httpCtx) => {\r\n    48\t      const route = (p, name, handler) => httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\r\n    49\t\r\n    50\t      route('/cliworker/providers', 'cliworker: providers', async (_req, res) => {\r\n    51\t        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n    52\t      })\r\n    53\t      route('/cliworker/models', 'cliworker: models', async (_req, res) => {\r\n    54\t        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n    55\t      })\r\n    56\t      route('/cliworker/select', 'cliworker: select', async (req, res) => {\r\n    57\t        try {\r\n    58\t          const c = getConfig()\r\n    59\t          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\r\n    60\t          const request = body.request || body\r\n    61\t          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c) }) })\r\n    62\t        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\r\n    63\t      })\r\n    64\t      route('/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\r\n    65\t        try {\r\n    66\t          const c = getConfig()\r\n    67\t          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\r\n    68\t          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null }) })\r\n    69\t        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n    70\t      })\r\n    71\t    })\r\n    72\t  } catch (e) {\r\n    73\t    console.error('[cliworker] webServer inject failed:', e.message)\r\n    74\t  }\r\n    75\t}\r\n    76\t\r\n#!/usr/bin/env node\r\nimport '../lib/cli.mjs'\r\n{\r\n  \"providers\": {\r\n    \"claude\": {\r\n      \"cli\": \"claude\",\r\n      \"adapter\": \"claude\",\r\n      \"version_args\": [\r\n        \"--version\"\r\n      ],\r\n      \"auth_args\": [\r\n        \"auth\",\r\n        \"status\"\r\n      ],\r\n      \"auth_ok\": \"logged in\",\r\n      \"readonly\": true\r\n    },\r\n    \"codex\": {\r\n      \"cli\": \"codex\",\r\n      \"adapter\": \"codex\",\r\n      \"version_args\": [\r\n        \"--version\"\r\n      ],\r\n      \"auth_args\": [\r\n        \"login\",\r\n        \"status\"\r\n      ],\r\n      \"auth_ok\": \"logged in\",\r\n      \"readonly\": true\r\n    },\r\n    \"codebuddy\": {\r\n      \"cli\": \"codebuddy\",\r\n      \"adapter\": \"codebuddy\",\r\n      \"version_args\": [\r\n        \"--version\"\r\n      ],\r\n      \"auth_args\": [],\r\n      \"readonly\": true\r\n    },\r\n    \"cursor-wsl\": {\r\n      \"cli\": \"wsl.exe\",\r\n      \"args_prefix\": [\r\nconfig/cliworker.local.json\r\nusage.jsonl\r\nnode_modules/\r\n.collab/worktrees/","is_error":false}]},"parent_tool_use_id":null,"session_id":"a801065c-035f-4615-8a07-3c6b48aa56fc","uuid":"cbe07108-d3c8-41f3-860a-b00cea6004a0","timestamp":"2026-11-07T16:37:09.735Z","tool_use_result":{"stdout":"=== lib/config.mjs\n     1\timport fs from 'node:fs'\r\n     2\timport os from 'node:os'\r\n     3\timport path from 'node:path'\r\n     4\t\r\n     5\texport const SCHEMA = 'cliworker.config/v1'\r\n     6\t\r\n     7\texport function defaultHome() {\r\n     8\t  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\r\n     9\t}\r\n    10\t\r\n    11\texport function loadConfig({ file } = {}) {\r\n    12\t  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\r\n    13\t  let raw\r\n    14\t  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\r\n    15\t    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\r\n    16\t    error.code = 'E_CONFIG'\r\n    17\t    throw error\r\n    18\t  }\r\n    19\t  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\r\n    20\t  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\r\n    21\t  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\r\n    22\t  return { ...raw, _file: root, _home: defaultHome() }\r\n    23\t}\r\n    24\t\r\n    25\texport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\r\n    26\t\r\n    27\texport function readUsage(file) {\r\n    28\t  try {\r\n    29\t    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\r\n    30\t  } catch { return [] }\r\n    31\t}\r\n    32\t\r\n    33\texport function appendUsage(file, row) {\r\n    34\t  ensureDir(path.dirname(file))\r\n    35\t  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\r\n    36\t}\r\n=== lib/forecast.mjs\n     1\texport const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\r\n     2\t\r\n     3\texport function normalizePrices(m = {}) {\r\n     4\t  const p = m.prices || {}\r\n     5\t  return {\r\n     6\t    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\r\n     7\t    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\r\n     8\t  }\r\n     9\t}\r\n    10\t\r\n    11\texport function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\r\n    12\t  const p = { ...DEFAULT_PRICES, ...prices }\r\n    13\t  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\r\n    14\t}\r\n    15\t\r\n    16\t/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\r\n    17\texport function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\r\n    18\t  const rows = records.filter((r) => !model || r.model === model)\r\n    19\t  const samples = rows.map((r) => ({\r\n    20\t    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\r\n    21\t    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\r\n    22\t  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\r\n    23\t  if (!samples.length) {\r\n    24\t    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\r\n    25\t  }\r\n    26\t  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\r\n    27\t  const use = recent.length ? recent : samples.slice(-10)\r\n    28\t  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\r\n    29\t  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\r\n    30\t  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\r\n    31\t  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\r\n    32\t  let tasksLeft = null\r\n    33\t  let etaHours = null\r\n    34\t  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\r\n    35\t    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\r\n    36\t    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\r\n    37\t  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\r\n    38\t    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\r\n    39\t  }\r\n    40\t  const confidence = use.length >= 5 ? 'medium' : 'low'\r\n    41\t  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\r\n    42\t  return {\r\n    43\t    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\r\n    44\t    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\r\n    45\t    confidence, risk,\r\n    46\t  }\r\n    47\t}\r\n    48\t\r\n    49\tfunction round(n) { return Math.round(n * 1e6) / 1e6 }\r\n=== lib/select.mjs\n     1\timport { normalizePrices, forecast } from './forecast.mjs'\r\n     2\t\r\n     3\texport const SCHEMA = 'cliworker.selection/v1'\r\n     4\texport const LEVELS = ['Top', 'High', 'Middle', 'Quick']\r\n     5\texport const USAGES = ['Heavy', 'Normal', 'Light']\r\n     6\t\r\n     7\tfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\r\n     8\tfunction normLevel(v) {\r\n     9\t  const s = String(v || '').trim().toLowerCase()\r\n    10\t  return LEVELS.find((x) => x.toLowerCase() === s) || null\r\n    11\t}\r\n    12\tfunction normUsage(v) {\r\n    13\t  const s = String(v || '').trim().toLowerCase()\r\n    14\t  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\r\n    15\t}\r\n    16\t\r\n    17\tfunction vendorOf(provider) {\r\n    18\t  const p = String(provider || '').toLowerCase()\r\n    19\t  if (p.includes('claude')) return 'anthropic'\r\n    20\t  if (p.includes('codex') || p.includes('openai')) return 'openai'\r\n    21\t  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\r\n    22\t  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\r\n    23\t  if (p.includes('gemini') || p.includes('google')) return 'google'\r\n    24\t  return p\r\n    25\t}\r\n    26\t\r\n    27\tfunction levelOf(m) {\r\n    28\t  if (m.level && LEVELS.includes(m.level)) return m.level\r\n    29\t  if (m.tier === 'top') return 'Top'\r\n    30\t  if (m.tier === 'advanced') return 'High'\r\n    31\t  if (m.tier === 'standard') return 'Middle'\r\n    32\t  return 'Quick'\r\n    33\t}\r\n    34\t\r\n    35\tfunction cliCall(config, model, request) {\r\n    36\t  const p = config.providers?.[model.provider] || {}\r\n    37\t  const id = model.id\r\n    38\t  const cwd = request.cwd || '<workspace>'\r\n    39\t  if (model.provider === 'claude') {\r\n    40\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\r\n    41\t  }\r\n    42\t  if (model.provider === 'codex') {\r\n    43\t    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\r\n    44\t  }\r\n    45\t  if (model.provider === 'codebuddy') {\r\n    46\t    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\r\n    47\t  }\r\n    48\t  if (model.provider === 'cursor-wsl') {\r\n    49\t    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\r\n    50\t  }\r\n    51\t  if (model.provider === 'gemini') {\r\n    52\t    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\r\n    53\t  }\r\n    54\t  return { command: p.cli || null, args: [], input: 'stdin', cwd }\r\n    55\t}\r\n    56\t\r\n    57\texport function listModels(config, { status = {}, includeDeprecated = false } = {}) {\r\n    58\t  return Object.entries(config.models).map(([key, m]) => {\r\n    59\t    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\r\n    60\t    const callable = st.state === 'callable' && !m.deprecated\r\n    61\t    return {\r\n    62\t      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\r\n    63\t      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\r\n    64\t      identity: m.identity === 'verified' ? 'verified' : 'unverified',\r\n    65\t      identity_group: m.identity_group || null,\r\n    66\t      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\r\n    67\t      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\r\n    68\t      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\r\n    69\t      prices: normalizePrices(m), source: 'config',\r\n    70\t      provider_detail: st.detail || null,\r\n    71\t    }\r\n    72\t  }).filter((m) => includeDeprecated || !m.deprecated)\r\n    73\t}\r\n    74\t\r\n    75\texport function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\r\n    76\t  const level = normLevel(request.level || request.tier)\r\n    77\t  const usageKind = normUsage(request.usage)\r\n    78\t  const models = listModels(config, { status, includeDeprecated: true })\r\n    79\t  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\r\n    80\t  const requireVerified = request.require_verified !== false\r\n    81\t  const requireReadonly = request.require_readonly === true\r\n    82\t  const exclude = new Set(request.exclude || [])\r\n    83\t  const allowed = request.candidates ? new Set(request.candidates) : null\r\n    84\t  const rejected = []\r\n    85\t  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\r\n    86\t\r\n    87\t  const candidates = models.filter((m) => {\r\n    88\t    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\r\n    89\t    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\r\n    90\t    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\r\n    91\t    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\r\n    92\t    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\r\n    93\t    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\r\n    94\t    const f = forecast({ records: u