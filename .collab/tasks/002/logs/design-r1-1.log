6c365-cebe-40cd-a1e0-f078a460a920","timestamp":"2026-11-07T16:36:31.477Z","tool_use_result":{"stdout":"#!/usr/bin/env node\r\n// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nimport { mergeShards, extractTitles } from './check-traceability.mjs'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst REPO_ROOT = path.resolve(HERE, '..')\r\n\r\nconst MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\r\nconst EXPECTED_IDS = [\r\n  'a1-quota',\r\n  'a2-pack',\r\n  'a3-runner',\r\n  'a4-paths',\r\n  'a4-null-config',\r\n  'a5-dup-call',\r\n  'a5-forecast-x3',\r\n  'a5-unused',\r\n  'a5-ignored-fields',\r\n  'a5-shell',\r\n  'a5-nocache',\r\n]\r\n\r\nconst LEDGER = ['test', 'characterization', 'defects.json']\r\nconst DEFECTS_DIR = ['test', 'characterization', 'defects']\r\n\r\nexport function milestoneRank(value) {\r\n  const index = MILESTONES.indexOf(value)\r\n  return index < 0 ? Number.NaN : index + 1\r\n}\r\n\r\nexport function hasFixedSection(source) {\r\n  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\r\n}\r\n\r\nexport function checkDefects({ root, index, milestone }) {\r\n  const errors = []\r\n  const ledgerFile = path.join(root, ...LEDGER)\r\n\r\n  if (!fs.existsSync(ledgerFile)) {\r\n    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\r\n    return { errors, absent: true }\r\n  }\r\n\r\n  let ledger = null\r\n  try {\r\n    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\r\n  } catch {\r\n    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\r\n    return { errors, absent: false }\r\n  }\r\n\r\n  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\r\n  if (!list) {\r\n    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\r\n    return { errors, absent: false }\r\n  }\r\n\r\n  const knownAcs = new Set()\r\n  for (const entry of index?.acs ?? []) {\r\n    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\r\n  }\r\n\r\n  const seen = new Set()\r\n  const valid = []\r\n  for (const item of list) {\r\n    if (!item || typeof item !== 'object' || Array.isArray(item)) {\r\n      errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\r\n      continue\r\n    }\r\n    const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\r\n    const problems = []\r\n    if (typeof id !== 'string' || id === '') problems.push('id')\r\n    if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\r\n    if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\r\n    if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\r\n\r\n    if (problems.length > 0) {\r\n      errors.push({\r\n        id: 'defects.schema',\r\n        detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\r\n      })\r\n      continue\r\n    }\r\n    if (seen.has(id)) {\r\n      errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\r\n      continue\r\n    }\r\n    seen.add(id)\r\n    valid.push({ id, ownerTask, ownerMilestone, ac })\r\n  }\r\n\r\n  if (milestone === 'M5') {\r\n    const actual = [...seen].sort()\r\n    const expected = [...EXPECTED_IDS].sort()\r\n    if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\r\n      errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\r\n    }\r\n  }\r\n\r\n  let required = []\r\n  if (milestone) {\r\n    const limit = milestoneRank(milestone)\r\n    required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\r\n  } else {\r\n    const merged = mergeShards({ root, index })\r\n    required = valid.filter((item) => merged.acs[item.ac] === 'covered')\r\n  }\r\n\r\n  for (const item of required) {\r\n    const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\r\n    let source = null\r\n    try {\r\n      source = fs.readFileSync(file, 'utf8')\r\n    } catch {\r\n      source = null\r\n    }\r\n    if (source === null || !hasFixedSection(source)) {\r\n      errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\r\n    }\r\n  }\r\n\r\n  return { errors, absent: false }\r\n}\r\n\r\nfunction main() {\r\n  const args = process.argv.slice(2)\r\n  let root = REPO_ROOT\r\n  let indexPath = null\r\n  let milestone = null\r\n\r\n  for (let i = 0; i < args.length; i += 1) {\r\n    const flag = args[i]\r\n    if (flag === '--root') {\r\n      const value = args[i + 1]\r\n      if (typeof value !== 'string' || value === '') {\r\n        process.stderr.write('--root requires a directory\\n')\r\n        process.exitCode = 2\r\n        return\r\n      }\r\n      root = path.resolve(value)\r\n      i += 1\r\n    } else if (flag === '--index') {\r\n      const value = args[i + 1]\r\n      if (typeof value !== 'string' || value === '') {\r\n        process.stderr.write('--index requires a file\\n')\r\n        process.exitCode = 2\r\n        return\r\n      }\r\n      indexPath = path.resolve(value)\r\n      i += 1\r\n    } else if (flag === '--milestone') {\r\n      const value = args[i + 1]\r\n      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\r\n        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\r\n        process.exitCode = 2\r\n        return\r\n      }\r\n      milestone = value\r\n      i += 1\r\n    } else {\r\n      process.stderr.write(\r\n        `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>]\\n`\r\n      )\r\n      process.exitCode = 2\r\n      return\r\n    }\r\n  }\r\n\r\n  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\r\n  let index = { acs: [] }\r\n  try {\r\n    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\r\n  } catch {\r\n    index = { acs: [] }\r\n  }\r\n\r\n  const { errors, absent } = checkDefects({ root, index, milestone })\r\n\r\n  if (absent && !milestone) {\r\n    process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\r\n    process.exitCode = 0\r\n    return\r\n  }\r\n\r\n  if (errors.length === 0) {\r\n    process.stdout.write('check-defects: ok\\n')\r\n    process.exitCode = 0\r\n    return\r\n  }\r\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\r\n  process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\r\n  process.exitCode = 1\r\n}\r\n\r\nconst invokedDirectly =\r\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n\r\nif (invokedDirectly) main()\r\n#!/usr/bin/env node\r\n// Runs every scripts/check-*.mjs in code point order (never itself) and then the full test run.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport { spawnSync } from 'node:child_process'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst STEP_PATTERN = /^check-.*\\.mjs$/\r\nconst SELF = 'check-fast.mjs'\r\n\r\nfunction out(text) {\r\n  fs.writeSync(1, text)\r\n}\r\n\r\nfunction err(text) {\r\n  fs.writeSync(2, text)\r\n}\r\n\r\nfunction byCodePoint(a, b) {\r\n  if (a < b) return -1\r\n  if (a > b) return 1\r\n  return 0\r\n}\r\n\r\nfunction stepFailed(label, result) {\r\n  const code = result.status === null ? 1 : result.status\r\n  err(`check-fast: FAILED step ${label} (exit ${code})\\n`)\r\n  process.exitCode = code\r\n}\r\n\r\nfunction main() {\r\n  const injected = Boolean(process.env.CLIWORKER_TEST_CHECK_DIR || process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n  const dir = process.env.CLIWORKER_TEST_CHECK_DIR\r\n    ? path.resolve(process.env.CLIWORKER_TEST_CHECK_DIR)\r\n    : HERE\r\n  const finalScript = process.env.CLIWORKER_TEST_FINAL_SCRIPT\r\n    ? path.resolve(process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n    : path.join(dir, 'run-tests.mjs')\r\n  const cwd = path.dirname(dir)\r\n\r\n  if (injected) err('check-fast: test injection active\\n')\r\n\r\n  let names = []\r\n  try {\r\n    names = fs.readdirSync(dir)\r\n  } catch {\r\n    names = []\r\n  }\r\n\r\n  const steps = names\r\n    .filter((name) => STEP_PATTERN.test(name) && name !== SELF)\r\n    .filter((name) => {\r\n      try {\r\n        return fs.statSync(path.join(dir, name)).isFile()\r\n      } catch {\r\n        return false\r\n      }\r\n    })\r\n    .sort(byCodePoint)\r\n\r\n  for (const name of steps) {\r\n    out(`==> ${name}\\n`)\r\n    const result = spawnSync(process.execPath, [path.join(dir, name)], { cwd, stdio: 'inherit' })\r\n    if (result.status !== 0) {\r\n      stepFailed(name, result)\r\n      return\r\n    }\r\n  }\r\n\r\n  out('==> npm test\\n')\r\n  const result = spawnSync(process.execPath, [finalScript], { cwd, stdio: 'inherit' })\r\n  if (result.status !== 0) {\r\n    stepFailed('npm test', result)\r\n    return\r\n  }\r\n\r\n  out('check-fast: ok\\n')\r\n  process.exitCode = 0\r\n}\r\n\r\nmain()\r\nimport test from 'node:test'\r\nimport assert from 'node:assert/strict'\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nimport { enumerateTestFiles, findOrphans } from '../../../scripts/run-tests.mjs'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst ROOT = path.resolve(HERE, '..', '..', '..')\r\nconst DISCOVERY_ROOTS = /^test\\/(unit|integration|contract|e2e|smoke|characterization|flows)\\//\r\n\r\n// 0.1 shipped without package.json scripts and kept its only test file flat in test/.\r\n// The 0.1 copy itself is owned by another task, so the shape is inlined here on purpose.\r\nconst V01 = {\r\n  scripts: null,\r\n  testFiles: ['test/select.test.mjs'],\r\n}\r\n\r\ntest('[repro] 0.1 has no test script and a test file outside the discovery roots', () => {\r\n  assert.equal(V01.scripts, null)\r\n  assert.deepEqual(V01.testFiles, ['test/select.test.mjs'])\r\n  assert.ok(V01.testFiles.every((file) => !DISCOVERY_ROOTS.test(file)))\r\n})\r\n\r\ntest('[fixed] package.json exposes test, check, perf and snapshot:update', () => {\r\n  const pkg = JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8'))\r\n  assert.ok(pkg.scripts, 'package.json must have scripts')\r\n  assert.deepEqual(Object.keys(pkg.scripts).sort(), ['check', 'perf', 'snapshot:update', 'test'])\r\n  assert.equal(pkg.scripts.test, 'node scripts/run-tests.mjs')\r\n  assert.equal(pkg.scripts.check, 'node scripts/check-fast.mjs')\r\n  assert.equal(pkg.scripts.perf, 'node scripts/run-tests.mjs --perf')\r\n  assert.equal(pkg.scripts['snapshot:update'], 'node scripts/run-tests.mjs --update-snapshots')\r\n})\r\n\r\ntest('[fixed] the migrated select test is discovered and no test file is orphaned', () => {\r\n  const files = enumerateTestFiles(ROOT)\r\n  assert.ok(files.includes('test/unit/select.test.mjs'), `discovered: ${files.join(',')}`)\r\n  assert.deepEqual(findOrphans(ROOT), [])\r\n  assert.equal(fs.existsSync(path.join(ROOT, 'test', 'select.test.mjs')), false)\r\n})\r\n{\r\n  \"task\": \"T-001\",\r\n  \"milestone\": \"M1\",\r\n  \"entries\": [\r\n    { \"ac\": \"AC-001\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-002\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-003\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-004\", \"status\": \"covered\", \"files\": [\"test/unit/traceability.test.mjs\"] },\r\n    { \"ac\": \"AC-074\", \"status\": \"covered\", \"files\": [\"test/unit/milestone-gate.test.mjs\"] }\r\n  ]\r\n}\r\n{\r\n  \"schema\": \"cliworker.ac-index/v1\",\r\n  \"acs\": [\r\n    { \"ac\": \"AC-001\", \"owner\": \"T-001\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-002\", \"owner\": \"T-001\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-003\", \"owner\": \"T-001\", \"milestone\": \"M1\", \"levels\": [\"integration\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-004\", \"owner\": \"T-001\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-005\", \"owner\": \"T-002\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-006\", \"owner\": \"T-003\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-007\", \"owner\": \"T-003\", \"milestone\": \"M1\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-008\", \"owner\": \"T-003\", \"milestone\": \"M1\", \"levels\": [\"contract\", \"integration\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-009\", \"owner\": \"T-004\", \"milestone\": \"M1\", \"levels\": [\"contract\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-010\", \"owner\": \"T-004\", \"milestone\": \"M1\", \"levels\": [\"contract\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-011\", \"owner\": \"T-004\", \"milestone\": \"M1\", \"levels\": [\"contract\", \"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\r\n    { \"ac\": \"AC-012\", \"owner\": \"T-005","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017wuJsnREDgLtYuXPt3QjhB","per