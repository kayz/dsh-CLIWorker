electModels, SCHEMA as SELECT_SCHEMA } from '../fixtures/characterization/v0.1/lib/select.mjs'\nimport { SCHEMA as CONFIG_SCHEMA } from '../fixtures/characterization/v0.1/lib/config.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst STATUS = { claude: { state: 'callable' } }\n\nfunction config(models, extra = {}) {\n  return { providers: { claude: { cli: 'claude', readonly: true } }, models, ...extra }\n}\nfunction model(key, overrides = {}) {\n  return { provider: 'claude', id: key, level: 'Quick', identity: 'verified', ...overrides }\n}\n```\n\nThen tests.\n\nTest 1:\n```js\ntest('[AC-005] stable: deprecated models are never candidates', () => {\n  const cfg = config({ live: model('live'), retired: model('retired', { deprecated: true, deprecated_reason: 'retired in 0.1' }) })\n  const visible = listModels(cfg, { status: STATUS })\n  assert.deepEqual(visible.map(m => m.key), ['live'])\n  const all = listModels(cfg, { status: STATUS, includeDeprecated: true })\n  const retired = all.find(m => m.key === 'retired')\n  assert.ok(retired)\n  assert.equal(retired.availability, 'deprecated')\n  const result = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n  assert.deepEqual(result.rejected.find(r => r.key==='retired'), { key:'retired', reason:'availability:deprecated' })\n  assert.ok(!result.models.some(m => m.key === 'retired'))\n  assert.deepEqual(result.models.map(m=>m.key), ['live'])\n})\n```\nCareful: deepEqual on the rejected object — it's `{ key, reason }` exactly. Good.\n\nTest 2:\n```js\ntest('[AC-005] stable: unverified identity is rejected unless require_verified is false', () => {\n  const cfg = config({ unverified: model('unverified', { identity: 'unverified' }) })\n  const strictResult = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n  assert.equal(strictResult.ok, false)\n  assert.deepEqual(strictResult.rejected, [{ key: 'unverified', reason: 'identity_unverified' }])\n  const relaxed = selectModels(cfg, { level