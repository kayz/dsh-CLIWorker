es:true})){const p=d+'/'+e.name;e.isDirectory()?w(p):have.push(p.slice(dir.length))}})(dir.slice(0,-1));have.sort();let bad=JSON.stringify(want)!==JSON.stringify(have)?1:0;if(bad)console.log('SET',want,have);for(const p of want){const g=norm(cp.execFileSync('git',['cat-file','blob','f75bb76:'+p]));const f=norm(fs.readFileSync(dir+p));if(g!==f){bad++;console.log('DIFF',p)}}console.log(bad?'FAIL':'ok '+want.length);process.exit(bad?1:0)\"\n  73→```\n  74→- 退出码 0，stdout 恰为 `ok 7`。\n  75→\n  76→### B-2 frozen-files.json 的形状与允许集合\n  77→```\n  78→node -e \"const j=require('./test/characterization/frozen-files.json');const p=j.files.map(f=>f.path);const allowed=x=>x.startsWith('test/fixtures/characterization/v0.1/')||x==='test/characterization/stable.test.mjs'||x.startsWith('contracts/spec/')||x.startsWith('contracts/golden/');const ok=Object.keys(j).sort().join()==='files,source_commit'&&j.source_commit==='f75bb76'&&p.every(allowed)&&!p.some(x=>/^(lib|bin|config|scripts)\\//i.test(x))&&p.includes('test/characterization/stable.test.mjs')&&p.filter(x=>x.startsWith('test/fixtures/characterization/v0.1/')).length===7&&new Set(p).size===p.length&&j.files.every(f=>Object.keys(f).sort().join()==='path,sha256'&&/^[0-9a-f]{64}$/.test(f.sha256));console.log(ok?'ok '+p.length:'FAIL');process.exit(ok?0:1)\"\n  79→```\n  80→- 退出码 0，stdout 匹配 `^ok \\d+$`。\n  81→\n  82→### B-3 篡改一个登记文件的字节 → 检查失败（在临时副本上做，不动仓库）\n  83→```\n  84→$t = Join-Path ([IO.Path]::GetTempPath()) ('cw-frozen-' + [guid]::NewGuid().ToString('N'))\n  85→New-Item -ItemType Directory -Path $t | Out-Null\n  86→Copy-Item -Recurse test, contracts -Destination $t\n  87→Add-Content -Path (Join-Path $t 'test/fixtures/characterization/v0.1/lib/select.mjs') -Value '// tamper' -Encoding utf8NoBOM\n  88→node scripts/check-frozen-files.mjs --root $t\n  89→\"exit=$LASTEXITCODE\"\n  90→Remove-Item -Recurse -Force $t\n  91→```\n  92→- `exit=1`；stdout 含 `FAIL frozen.hash_mismatch test/fixtures/characterization/v0.1/lib/select.mjs` 和 `ch