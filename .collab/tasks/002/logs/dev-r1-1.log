{"type":"assistant","uuid":"01a1b6e5-ee4a-795c-9a8c-e176e3f976a3","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"id":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","content":[{"type":"tool_use","id":"call_03_Be7QLc82nuDpkHdj2STP9111","name":"Read","input":{"file_path":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\002\\scripts\\check-traceability.mjs"}}],"model":"deepseek-v4.1-flash","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":55403,"output_tokens":251,"cache_creation_input_tokens":0,"cache_read_input_tokens":50688,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","codebuddy.ai/llmMessageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:44.491Z"}
{"type":"user","uuid":"01a1b6e5-ee4d-7a0e-8a32-bc73907b6473","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_HzI8iQAw3GNrfsuxuBLW5926","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import path from 'node:path'\n   3→import { loadConfig, defaultHome, readUsage, appendUsage } from './config.mjs'\n   4→import { providerStatus } from './availability.mjs'\n   5→import { listModels, selectModels, SCHEMA as SELECT_SCHEMA } from './select.mjs'\n   6→import { forecast, estimateCost } from './forecast.mjs'\n   7→\n   8→function out(x) { process.stdout.write(JSON.stringify(x, null, 2) + '\\n') }\n   9→function fail(message, code = 1) { process.stderr.write(`ERROR: ${message}\\n`); process.exit(code) }\n  10→function arg(name, fallback) { const i = process.argv.indexOf(name); return i >= 0 ? process.argv[i + 1] : fallback }\n  11→function flag(name) { return process.argv.includes(name) }\n  12→function usageFile(config) { return path.join(config._home || defaultHome(), 'usage.jsonl') }\n  13→\n  14→function load() {\n  15→  try { return loadConfig({ file: arg('--config') }) } catch (e) { fail(e.message) }\n  16→}\n  17→\n  18→function main() {\n  19→  const cmd = process.argv[2]\n  20→  const sub = process.argv[3]\n  21→  const config = load()\n  22→  if (cmd === 'providers') {\n  23→    const status = providerStatus(config)\n  24→    out({ schema: 'cliworker.providers/v1', providers: Object.entries(config.providers).map(([id, p]) => ({ id, cli: p.cli, readonly: !!p.readonly, ...status[id] })) })\n  25→    return\n  26→  }\n  27→  if (cmd === 'models' && (!sub || sub === 'list')) {\n  28→    const status = providerStatus(config)\n  29→    out({ schema: 'cliworker.models/v1', models: listModels(config, { status, includeDeprecated: flag('--all') }) })\n  30→    return\n  31→  }\n  32→  if (cmd === 'models' && sub === 'select') {\n  33→    let req = {}\n  34→    const raw = arg('--request')\n  35→    if (raw) { try { req = JSON.parse(raw) } catch (e) { fail(`bad --request JSON: ${e.message}`) } }\n  36→    const status = providerStatus(config)\n  37→    out(selectModels(config, req, { status, usage: readUsage(usageFile(config)) }))\n  38→    return\n  39→  }\n  40→  if (cmd === 'models' && sub === 'forecast') {\n  41→    const key = arg('--model', null)\n  42→    const usage = readUsage(usageFile(config))\n  43→    out({ schema: 'cliworker.forecast/v1', forecast: forecast({ records: usage, model: key, prices: key ? config.models[key]?.prices : undefined, quota: key ? config.quotas?.[config.models[key]?.provider] : null }) })\n  44→    return\n  45→  }\n  46→  if (cmd === 'usage' && sub === 'record') {\n  47→    let row\n  48→    const raw = arg('--json')\n  49→    try { row = JSON.parse(raw) } catch (e) { fail(`bad --json: ${e.message}`) }\n  50→    if (!row.model) fail('usage record requires model')\n  51→    const m = config.models[row.model]\n  52→    if (m) row.cost_usd = row.cost_usd ?? estimateCost({ input_tokens: row.input_tokens, output_tokens: row.output_tokens, prices: m.prices })\n  53→    row.at = row.at || new Date().toISOString()\n  54→    appendUsage(usageFile(config), row)\n  55→    out({ schema: 'cliworker.usage/v1', ok: true, recorded: row })\n  56→    return\n  57→  }\n  58→  if (cmd === 'usage' && sub === 'summary') {\n  59→    out({ schema: 'cliworker.usage/v1', records: readUsage(usageFile(config)) })\n  60→    return\n  61→  }\n  62→  fail('usage: cliworker providers | models list|select|forecast | usage record|summary')\n  63→}\n  64→\n  65→main()\n  66→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","codebuddy.ai/llmMessageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:44.494Z"}
{"type":"user","uuid":"01a1b6e5-ee51-7591-ab3c-e0eefbade7b4","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_W3AeZ7HFevKG6Jcuy8PP6210","content":[{"type":"text","text":"   1→/**\n   2→ * dsh-cliworker — DSH host plugin.\n   3→ *\n   4→ * AgentLine and other clients only need the model source pointer:\n   5→ *   modelSource = { kind: \"cliworker\", command: \"node\",\n   6→ *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n   7→ *\n   8→ * The plugin exposes the same selection contract over DSH routes for UI use.\n   9→ */\n  10→import path from 'node:path'\n  11→import os from 'node:os'\n  12→import { fileURLToPath } from 'node:url'\n  13→import { loadConfig } from '../lib/config.mjs'\n  14→import { providerStatus } from '../lib/availability.mjs'\n  15→import { listModels, selectModels } from '../lib/select.mjs'\n  16→import { forecast } from '../lib/forecast.mjs'\n  17→\n  18→const __dirname = path.dirname(fileURLToPath(import.meta.url))\n  19→const DEFAULTS = {\n  20→  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\n  21→  readonly: false,\n  22→}\n  23→\n  24→function send(res, body, code = 200) {\n  25→  res.statusCode = code\n  26→  res.setHeader('content-type', 'application/json; charset=utf-8')\n  27→  res.setHeader('cache-control', 'no-store')\n  28→  res.end(JSON.stringify(body))\n  29→}\n  30→\n  31→function readBody(req) {\n  32→  return new Promise((resolve, reject) => {\n  33→    let raw = ''\n  34→    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n  35→    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n  36→    req.on('error', reject)\n  37→  })\n  38→}\n  39→\n  40→export const name = 'cliworker'\n  41→\n  42→export function apply(ctx, config = {}) {\n  43→  const settings = { ...DEFAULTS, ...(config || {}) }\n  44→  const getConfig = () => loadConfig({ file: settings.configPath })\n  45→\n  46→  try {\n  47→    ctx.inject(['webServer'], (httpCtx) => {\n  48→      const route = (p, name, handler) => httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\n  49→\n  50→      route('/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n  51→        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  52→      })\n  53→      route('/cliworker/models', 'cliworker: models', async (_req, res) => {\n  54→        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  55→      })\n  56→      route('/cliworker/select', 'cliworker: select', async (req, res) => {\n  57→        try {\n  58→          const c = getConfig()\n  59→          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n  60→          const request = body.request || body\n  61→          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c) }) })\n  62→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n  63→      })\n  64→      route('/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n  65→        try {\n  66→          const c = getConfig()\n  67→          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n  68→          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null }) })\n  69→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  70→      })\n  71→    })\n  72→  } catch (e) {\n  73→    console.error('[cliworker] webServer inject failed:', e.message)\n  74→  }\n  75→}\n  76→\n  77→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","codebuddy.ai/llmMessageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:44.497Z"}
{"type":"user","uuid":"01a1b6e5-ee54-793d-abf1-caf4569bc7ed","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_Dw3sAqDhGFTlXRe6JUez6903","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Runs every scripts/check-*.mjs in code point order (never itself) and then the full test run.\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { spawnSync } from 'node:child_process'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const STEP_PATTERN = /^check-.*\\.mjs$/\n  10→const SELF = 'check-fast.mjs'\n  11→\n  12→function out(text) {\n  13→  fs.writeSync(1, text)\n  14→}\n  15→\n  16→function err(text) {\n  17→  fs.writeSync(2, text)\n  18→}\n  19→\n  20→function byCodePoint(a, b) {\n  21→  if (a < b) return -1\n  22→  if (a > b) return 1\n  23→  return 0\n  24→}\n  25→\n  26→function stepFailed(label, result) {\n  27→  const code = result.status === null ? 1 : result.status\n  28→  err(`check-fast: FAILED step ${label} (exit ${code})\\n`)\n  29→  process.exitCode = code\n  30→}\n  31→\n  32→function main() {\n  33→  const injected = Boolean(process.env.CLIWORKER_TEST_CHECK_DIR || process.env.CLIWORKER_TEST_FINAL_SCRIPT)\n  34→  const dir = process.env.CLIWORKER_TEST_CHECK_DIR\n  35→    ? path.resolve(process.env.CLIWORKER_TEST_CHECK_DIR)\n  36→    : HERE\n  37→  const finalScript = process.env.CLIWORKER_TEST_FINAL_SCRIPT\n  38→    ? path.resolve(process.env.CLIWORKER_TEST_FINAL_SCRIPT)\n  39→    : path.join(dir, 'run-tests.mjs')\n  40→  const cwd = path.dirname(dir)\n  41→\n  42→  if (injected) err('check-fast: test injection active\\n')\n  43→\n  44→  let names = []\n  45→  try {\n  46→    names = fs.readdirSync(dir)\n  47→  } catch {\n  48→    names = []\n  49→  }\n  50→\n  51→  const steps = names\n  52→    .filter((name) => STEP_PATTERN.test(name) && name !== SELF)\n  53→    .filter((name) => {\n  54→      try {\n  55→        return fs.statSync(path.join(dir, name)).isFile()\n  56→      } catch {\n  57→        return false\n  58→      }\n  59→    })\n  60→    .sort(byCodePoint)\n  61→\n  62→  for (const name of steps) {\n  63→    out(`==> ${name}\\n`)\n  64→    const result = spawnSync(process.execPath, [path.join(dir, name)], { cwd, stdio: 'inherit' })\n  65→    if (result.status !== 0) {\n  66→      stepFailed(name, result)\n  67→      return\n  68→    }\n  69→  }\n  70→\n  71→  out('==> npm test\\n')\n  72→  const result = spawnSync(process.execPath, [finalScript], { cwd, stdio: 'inherit' })\n  73→  if (result.status !== 0) {\n  74→    stepFailed('npm test', result)\n  75→    return\n  76→  }\n  77→\n  78→  out('check-fast: ok\\n')\n  79→  process.exitCode = 0\n  80→}\n  81→\n  82→main()\n  83→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","codebuddy.ai/llmMessageId":"01a1b6e5e2e17e0e9b9eedad0a6e6ee5","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:44.501Z"}
{"type":"user","uuid":"01a1b6e5-ee5a-783e-86b5-e964fc5f0ecb","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_Be7QLc82nuDpkHdj2STP9111","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Traceability: validates contracts/spec/ac-index.json and merges test/traceability/*.json.\n   3→// Exported helpers are reused by milestone-gate.mjs and check-defects.mjs.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const REPO_ROOT = path.resolve(HERE, '..')\n  10→\n  11→const SCHEMA = 'cliworker.ac-index/v1'\n  12→const INDEX_KEYS = ['ac', 'owner', 'milestone', 'levels', 'baseline']\n  13→const LEVELS = ['unit', 'integration', 'contract', 'e2e', 'smoke']\n  14→const BASELINES = ['linux', 'win32', 'darwin', 'real-smoke']\n  15→const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\n  16→const NON_SMOKE_LEVELS = ['unit', 'contract', 'integration', 'e2e']\n  17→\n  18→const TITLE_RE = /(?<![\\w.])(test|it|describe|platformTest)(\\.(skip|todo|only))?\\s*\\(\\s*(['\"`])((?:\\\\.|(?!\\4).)*)\\4/g\n  19→\n  20→export function extractTitles(source) {\n  21→  const titles = []\n  22→  const text = String(source ?? '')\n  23→  for (const match of text.matchAll(TITLE_RE)) {\n  24→    titles.push({ kind: match[3] ? match[3] : 'plain', title: match[5] })\n  25→  }\n  26→  return titles\n  27→}\n  28→\n  29→function expectedAcs() {\n  30→  const list = []\n  31→  for (let i = 1; i <= 74; i += 1) list.push(`AC-${String(i).padStart(3, '0')}`)\n  32→  return list\n  33→}\n  34→\n  35→function isStringArray(value) {\n  36→  return Array.isArray(value) && value.every((item) => typeof item === 'string')\n  37→}\n  38→\n  39→export function validateIndex(index) {\n  40→  const errors = []\n  41→  const push = (id, ac, detail) => errors.push({ id, ac, detail })\n  42→\n  43→  if (!index || typeof index !== 'object' || Array.isArray(index)) {\n  44→    push('index.schema', undefined, 'index must be a JSON object')\n  45→    return errors\n  46→  }\n  47→  if (index.schema !== SCHEMA) push('index.schema', undefined, `schema must be ${SCHEMA}`)\n  48→\n  49→  if (!Array.isArray(index.acs)) {\n  50→    push('index.schema', undefined, 'acs must be an array')\n  51→    return errors\n  52→  }\n  53→\n  54→  for (const entry of index.acs) {\n  55→    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n  56→      push('index.schema', undefined, 'every entry must be a JSON object')\n  57→      continue\n  58→    }\n  59→    const keys = Object.keys(entry)\n  60→    const missing = INDEX_KEYS.filter((key) => !keys.includes(key))\n  61→    const extra = keys.filter((key) => !INDEX_KEYS.includes(key))\n  62→    if (missing.length > 0 || extra.length > 0) {\n  63→      push(\n  64→        'index.schema',\n  65→        typeof entry.ac === 'string' ? entry.ac : undefined,\n  66→        `entry keys must be exactly ${INDEX_KEYS.join(',')} (missing=${missing.join('|') || '-'} extra=${extra.join('|') || '-'})`\n  67→      )\n  68→    }\n  69→\n  70→    if (typeof entry.owner !== 'string' || !/^T-\\d{3}$/.test(entry.owner)) {\n  71→      push('index.owner', entry.ac, 'owner must match ^T-\\\\d{3}$')\n  72→    }\n  73→    if (!MILESTONES.includes(entry.milestone)) {\n  74→      push('index.milestone', entry.ac, `milestone must be one of ${MILESTONES.join(',')}`)\n  75→    }\n  76→\n  77→    if (!isStringArray(entry.levels) || entry.levels.length === 0) {\n  78→      push('index.levels', entry.ac, 'levels must be a non-empty array of strings')\n  79→    } else {\n  80→      const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\n  81→      const duplicates = entry.levels.filter((level, i) => entry.levels.indexOf(level) !== i)\n  82→      if (unknown.length > 0) push('index.levels', entry.ac, `unknown level(s): ${unknown.join(',')}`)\n  83→      if (duplicates.length > 0) push('index.levels', entry.ac, `duplicate level(s): ${duplicates.join(',')}`)\n  84→    }\n  85→\n  86→    if (!isStringArray(entry.baseline) || entry.baseline.length === 0) {\n  87→      push('index.baseline', entry.ac, 'baseline must be a non-empty array of strings')\n  88→    } else {\n  89→      const unknown = entry.baseline.filter((base) => !BASELINES.includes(base))\n  90→      const duplicates = entry.baseline.filter((base, i) => entry.baseline.indexOf(base) !== i)\n  91→      if (unknown.length > 0) push('index.baseline', entry.ac, `unknown baseline(s): ${unknown.join(',')}`)\n  92→      if (duplicates.length > 0) push('index.baseline', entry.ac, `duplicate baseline(s): ${duplicates.join(',')}`)\n  93→    }\n  94→\n  95→    if (isStringArray(entry.levels) && isStringArray(entry.baseline)) {\n  96→      const hasCodeLevel = entry.levels.some((level) => NON_SMOKE_LEVELS.includes(level))\n  97→      const hasSmoke = entry.levels.includes('smoke')\n  98→      const hasRealSmoke = entry.baseline.includes('real-smoke')\n  99→      const hasNativeOnly = entry.baseline.includes('win32') || entry.baseline.includes('darwin')\n 100→      if (hasCodeLevel && hasRealSmoke) {\n 101→        push('index.baseline_incompatible', entry.ac, 'real-smoke baseline cannot back code levels')\n 102→      }\n 103→      if (hasSmoke && hasNativeOnly) {\n 104→        push('index.baseline_incompatible', entry.ac, 'smoke levels only allow linux or real-smoke baselines')\n 105→      }\n 106→    }\n 107→  }\n 108→\n 109→  const expected = expectedAcs()\n 110→  const got = index.acs.map((entry) => (entry && typeof entry === 'object' ? entry.ac : undefined))\n 111→  const inOrder = got.length === expected.length && got.every((ac, i) => ac === expected[i])\n 112→  if (!inOrder) {\n 113→    const seen = new Set()\n 114→    const duplicates = new Set()\n 115→    for (const ac of got) {\n 116→      if (seen.has(ac)) duplicates.add(ac)\n 117→      seen.add(ac)\n 118→    }\n 119→    const parts = [`expected exactly ${expected[0]}..${expected[expected.length - 1]} in order`]\n 120→    parts.push(`got ${got.length} entries`)\n 121→    if (duplicates.size > 0) parts.push(`duplicates: ${[...duplicates].join(',')}`)\n 122→    push('index.count', undefined, parts.join(', '))\n 123→  }\n 124→\n 125→  return errors\n 126→}\n 127→\n 128→export function mergeShards({ root, index }) {\n 129→  const errors = []\n 130→  const shardDir = path.join(root, 'test', 'traceability')\n 131→  const owners = new Map()\n 132→  const indexAcs = []\n 133→  for (const entry of index?.acs ?? []) {\n 134→    if (!entry || typeof entry !== 'object') continue\n 135→    owners.set(entry.ac, entry.owner)\n 136→    indexAcs.push(entry.ac)\n 137→  }\n 138→\n 139→  let names = []\n 140→  try {\n 141→    names = fs.readdirSync(shardDir).filter((name) => name.endsWith('.json')).sort()\n 142→  } catch {\n 143→    names = []\n 144→  }\n 145→\n 146→  const declared = new Map()\n 147→\n 148→  for (const name of names) {\n 149→    const rel = `test/traceability/${name}`\n 150→    let shard\n 151→    try {\n 152→      shard = JSON.parse(fs.readFileSync(path.join(shardDir, name), 'utf8'))\n 153→    } catch {\n 154→      errors.push({ id: 'shard.schema', file: rel, detail: 'shard is not valid JSON' })\n 155→      continue\n 156→    }\n 157→    if (!shard || typeof shard !== 'object' || Array.isArray(shard)) {\n 158→      errors.push({ id: 'shard.schema', file: rel, detail: 'shard must be a JSON object' })\n 159→      continue\n 160→    }\n 161→\n 162→    const task = name.replace(/\\.json$/, '')\n 163→    if (typeof shard.task !== 'string' || shard.task !== task) {\n 164→      errors.push({ id: 'shard.schema', file: rel, detail: `task must be \"${task}\"` })\n 165→    }\n 166→    if (Object.prototype.hasOwnProperty.call(shard, 'baseline')) {\n 167→      errors.push({ id: 'shard.baseline_forbidden', file: rel, detail: 'shard must not declare baseline' })\n 168→    }\n 169→    if (!Array.isArray(shard.entries)) {\n 170→      errors.push({ id: 'shard.schema', file: rel, detail: 'entries must be an array' })\n 171→      continue\n 172→    }\n 173→\n 174→    for (const entry of shard.entries) {\n 175→      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n 176→        errors.push({ id: 'shard.schema', file: rel, detail: 'every entry must be a JSON object' })\n 177→        continue\n 178→      }\n 179→      if (Object.prototype.hasOwnProperty.call(entry, 'baseline')) {\n 180→        errors.push({\n 181→          id: 'shard.baseline_forbidden',\n 182→          ac: typeof entry.ac === 'string' ? entry.ac : undefined,\n 183→          file: rel,\n 184→          detail: 'entry must not declare baseline',\n 185→        })\n 186→      }\n 187→\n 188→      const ac = entry.ac\n 189→      const status = entry.status\n 190→      const files = entry.files\n 191→      if (\n 192→        typeof ac !== 'string' ||\n 193→        ac === '' ||\n 194→        (status !== 'covered' && status !== 'planned') ||\n 195→        !Array.isArray(files)\n 196→      ) {\n 197→        errors.push({\n 198→          id: 'shard.schema',\n 199→          ac: typeof ac === 'string' ? ac : undefined,\n 200→          file: rel,\n 201→          detail: 'entry needs ac, status (covered|planned) and files',\n 202→        })\n 203→        continue\n 204→      }\n 205→\n 206→      if (!owners.has(ac)) {\n 207→        errors.push({ id: 'shard.unknown_ac', ac, file: rel, detail: 'AC is not declared in the index' })\n 208→        continue\n 209→      }\n 210→\n 211→      if (declared.has(ac)) {\n 212→        const previous = declared.get(ac)\n 213→        errors.push({\n 214→          id: 'shard.duplicate',\n 215→          ac,\n 216→          file: rel,\n 217→          detail: previous.shard === rel ? 'duplicate within shard' : `already declared in ${previous.shard}`,\n 218→        })\n 219→      } else {\n 220→        declared.set(ac, { status, shard: rel })\n 221→      }\n 222→\n 223→      if (shard.task !== owners.get(ac)) {\n 224→        errors.push({\n 225→          id: 'shard.not_owner',\n 226→          ac,\n 227→          file: rel,\n 228→          detail: `owner is ${owners.get(ac)}`,\n 229→        })\n 230→      }\n 231→\n 232→      if (status !== 'covered') continue\n 233→\n 234→      let broken = false\n 235→      if (files.length === 0) {\n 236→        errors.push({ id: 'shard.missing_file', ac, file: rel, detail: 'covered entry needs at least one file' })\n 237→        broken = true\n 238→      }\n 239→      for (const file of files) {\n 240→        const unsafe =\n 241→          typeof file !== 'string' ||\n 242→          file === '' ||\n 243→          path.isAbsolute(file) ||\n 244→          file.split('/').includes('..') ||\n 245→          file.split('\\\\').includes('..')\n 246→        if (unsafe) {\n 247→          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `unsafe or empty path: ${String(file)}` })\n 248→          broken = true\n 249→          continue\n 250→        }\n 251→        if (!fs.existsSync(path.join(root, file))) {\n 252→          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `missing file: ${file}` })\n 253→          broken = true\n 254→        }\n 255→      }\n 256→      if (broken) continue\n 257→\n 258→      let tagged = false\n 259→      for (const file of files) {\n 260→        let source = ''\n 261→        try {\n 262→          source = fs.readFileSync(path.join(root, file), 'utf8')\n 263→        } catch {\n 264→          continue\n 265→        }\n 266→        if (extractTitles(source).some((item) => item.kind === 'plain' && item.title.includes(`[${ac}]`))) {\n 267→          tagged = true\n 268→          break\n 269→        }\n 270→      }\n 271→      if (!tagged) {\n 272→        errors.push({\n 273→          id: 'shard.missing_title',\n 274→          ac,\n 275→          file: rel,\n 276→          detail: `no plain test title contains [${ac}]`,\n 277→        })\n 278→      }\n 279→    }\n 280→  }\n 281→\n 282→  const acs = {}\n 283→  for (const ac of indexAcs) {\n 284→    const entry = declared.get(ac)\n 285→    acs[ac] = entry ? entry.status : 'planned'\n 286→  }\n 287→\n 288→  return { errors, acs }\n 289→}\n 290→\n 291→function checkTaskGraph(taskGraphPath, index) {\n 292→  const errors = []\n 293→  let graph\n 294→  try {\n 295→    graph = JSON.parse(fs.readFileSync(taskGraphPath, 'utf8'))\n 296→  } catch {\n 297→    errors.push({ id: 'graph.mismatch', detail: `cannot read task graph: ${taskGraphPath}` })\n 298→    return errors\n 299→  }\n 300→\n 301→  const owners = new Map()\n 302→  const milestones = new Map()\n 303→  for (const task of Array.isArray(graph.tasks) ? graph.tasks : []) {\n 304→    for (const ac of Array.isArray(task.acceptance) ? task.acceptance : []) {\n 305→      owners.set(ac, task.id)\n 306→      milestones.set(ac, task.milestone)\n 307→    }\n 308→  }\n 309→  const levels = new Map()\n 310→  for (const item of Array.isArray(graph.acceptance) ? graph.acceptance : []) {\n 311→    if (item && typeof item.id === 'string') levels.set(item.id, item.levels)\n 312→  }\n 313→\n 314→  const sameSet = (a, b) => {\n 315→    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false\n 316→    const left = [...a].sort()\n 317→    const right = [...b].sort()\n 318→    return left.every((value, i) => value === right[i])\n 319→  }\n 320→\n 321→  for (const entry of index?.acs ?? []) {\n 322→    if (!entry || typeof entry !== 'object') continue\n 323→    if (owners.get(entry.ac) !== entry.owner) {\n 324→      errors.push({\n 325→        id: 'graph.mismatch',\n 326→        ac: entry.ac,\n 327→        detail: `owner ${entry.owner} != task graph ${owners.get(entry.ac) ?? 'none'}`,\n 328→      })\n 329→    }\n 330→    if (milestones.get(entry.ac) !== entry.milestone) {\n 331→      errors.push({\n 332→        id: 'graph.mismatch',\n 333→        ac: entry.ac,\n 334→        detail: `milestone ${entry.milestone} != task graph ${milestones.get(entry.ac) ?? 'none'}`,\n 335→      })\n 336→    }\n 337→    if (levels.has(entry.ac) && !sameSet(levels.get(entry.ac), entry.levels)) {\n 338→      errors.push({\n 339→        id: 'graph.mismatch',\n 340→        ac: entry.ac,\n 341→        detail: `levels ${JSON.stringify(entry.levels)} != task graph ${JSON.stringify(levels.get(entry.ac))}`,\n 342→      })\n 343→    }\n 344→  }\n 345→\n 346→  return errors\n 347→}\n 348→\n 349→function fail(message) {\n 350→  console.error(message)\n 351→  process.exitCode = 2\n 352→}\n 353→\n 354→function takeValue(args, index, flag) {\n 355→  const value = args[index + 1]\n 356→  if (typeof value !== 'string' || value === '') {\n 357→    fail(`${flag} requires a value`)\n 358→    return null\n 359→  }\n 360→  return value\n 361→}\n 362→\n 363→function main() {\n 364→  const args = process.argv.slice(2)\n 365→  let root = REPO_ROOT\n 366→  let indexPath = null\n 367→  let taskGraphPath = null\n 368→  let json = false\n 369→\n 370→  for (let i = 0; i < args.length; i += 1) {\n 371→    const flag = args[i]\n 372→    if (flag === '--root') {\n 373→      const value = takeValue(args, i, flag)\n 374→      if (value === null) return\n 375→      root = path.resolve(value)\n 376→      i += 1\n 377→    } else if (flag === '--index') {\n 378→      const value = takeValue(args, i, flag)\n 379→      if (value === null) return\n 380→      indexPath = path.resolve(value)\n 381→      i += 1\n 382→    } else if (flag === '--task-graph') {\n 383→      const value = takeValue(args, i, flag)\n 384→      if (value === null) return\n 385→      taskGraphPath = path.resolve(value)\n 386→      i += 1\n 387→    } else if (flag === '--json') {\n 388→      json = true\n 389→    } else {\n 390→      fail(`unknown argument: ${flag}\\nusage: node scripts/check-traceability.mjs [--root <dir>] [--index <file>] [--task-graph <file>] [--json]`)\n 391→      return\n 392→    }\n 393→  }\n 394→\n 395→  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n 396→  const errors = []\n 397→\n 398→  let index = null\n 399→  try {\n 400→    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n 401→  } catch {\n 402→    errors.push({ id: 'index.schema', detail: `cannot read index: ${indexFile}` })\n 403→  }\n 404→\n 405→  let acs = {}\n 406→  if (index) {\n 407→    errors.push(...validateIndex(index))\n 408→    const merged = mergeShards({ root, index })\n 409→    errors.push(...merged.errors)\n 410→    acs = merged.acs\n 411→  }\n 412→  if (taskGraphPath && index) errors.push(...checkTaskGraph(taskGraphPath, index))\n 413→\n 414→  const entries = Object.keys(acs)\n 415→    .sort()\n 416→    .map((ac) => ({ ac, status: acs[ac] }))\n 417→  const covered = entries.filter((item) => item.status === 'covered').length\n 418→  const planned = entries.filter((item) => item.status === 'planned').length\n 419→\n 420→  if (json) {\n 421→    const payload = {\n 422→      ok: errors.length === 0,\n 423→      errors: errors.map((error) => {\n 424→        const out = { id: error.id }\n 425→        if (error.ac !== undefined) out.ac = error.ac\n 426→        if (error.file !== undefined) out.file = error.file\n 427→        out.detail = error.detail ?? ''\n 428→        return out\n 429→      }),\n 430→      covered,\n 431→      planned,\n 432→      acs: entries,\n 433→    }\n 434→    process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`)\n 435→  } else {\n 436→    for (const error of errors) {\n 437→      const where = error.ac ?? error.file ?? '-'\n 438→      process.stdout.write(`FAIL ${error.id} ${where} ${error.detail ?? ''}`.trimEnd() + '\\n')\n 439→    }\n 440→    if (errors.length > 0) {\n 441→      process.stdout.write(`check-traceability: FAILED (${errors.length} errors)\\n`)\n 442→    } else {\n 443→      process.stdout.write(`check-traceability: ok (covered=${covered} planned=${planned})\\n`)\n 444→    }\n 445→  }\n 446→\n 447→  process.ex