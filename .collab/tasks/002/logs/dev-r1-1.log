{"type":"user","uuid":"01a1b6e5-e305-76ec-8aca-abd89d20c3d4","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_gElxIwmG1cYSmU9mwJ3o2346","content":[{"type":"text","text":"   1→import { normalizePrices, forecast } from './forecast.mjs'\n   2→\n   3→export const SCHEMA = 'cliworker.selection/v1'\n   4→export const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n   5→export const USAGES = ['Heavy', 'Normal', 'Light']\n   6→\n   7→function isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n   8→function normLevel(v) {\n   9→  const s = String(v || '').trim().toLowerCase()\n  10→  return LEVELS.find((x) => x.toLowerCase() === s) || null\n  11→}\n  12→function normUsage(v) {\n  13→  const s = String(v || '').trim().toLowerCase()\n  14→  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n  15→}\n  16→\n  17→function vendorOf(provider) {\n  18→  const p = String(provider || '').toLowerCase()\n  19→  if (p.includes('claude')) return 'anthropic'\n  20→  if (p.includes('codex') || p.includes('openai')) return 'openai'\n  21→  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n  22→  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n  23→  if (p.includes('gemini') || p.includes('google')) return 'google'\n  24→  return p\n  25→}\n  26→\n  27→function levelOf(m) {\n  28→  if (m.level && LEVELS.includes(m.level)) return m.level\n  29→  if (m.tier === 'top') return 'Top'\n  30→  if (m.tier === 'advanced') return 'High'\n  31→  if (m.tier === 'standard') return 'Middle'\n  32→  return 'Quick'\n  33→}\n  34→\n  35→function cliCall(config, model, request) {\n  36→  const p = config.providers?.[model.provider] || {}\n  37→  const id = model.id\n  38→  const cwd = request.cwd || '<workspace>'\n  39→  if (model.provider === 'claude') {\n  40→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  41→  }\n  42→  if (model.provider === 'codex') {\n  43→    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n  44→  }\n  45→  if (model.provider === 'codebuddy') {\n  46→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  47→  }\n  48→  if (model.provider === 'cursor-wsl') {\n  49→    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n  50→  }\n  51→  if (model.provider === 'gemini') {\n  52→    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n  53→  }\n  54→  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n  55→}\n  56→\n  57→export function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n  58→  return Object.entries(config.models).map(([key, m]) => {\n  59→    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n  60→    const callable = st.state === 'callable' && !m.deprecated\n  61→    return {\n  62→      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n  63→      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n  64→      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n  65→      identity_group: m.identity_group || null,\n  66→      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n  67→      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n  68→      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n  69→      prices: normalizePrices(m), source: 'config',\n  70→      provider_detail: st.detail || null,\n  71→    }\n  72→  }).filter((m) => includeDeprecated || !m.deprecated)\n  73→}\n  74→\n  75→export function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n  76→  const level = normLevel(request.level || request.tier)\n  77→  const usageKind = normUsage(request.usage)\n  78→  const models = listModels(config, { status, includeDeprecated: true })\n  79→  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n  80→  const requireVerified = request.require_verified !== false\n  81→  const requireReadonly = request.require_readonly === true\n  82→  const exclude = new Set(request.exclude || [])\n  83→  const allowed = request.candidates ? new Set(request.candidates) : null\n  84→  const rejected = []\n  85→  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n  86→\n  87→  const candidates = models.filter((m) => {\n  88→    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n  89→    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n  90→    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n  91→    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n  92→    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n  93→    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n  94→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n  95→    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n  96→      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n  97→    }\n  98→    return true\n  99→  })\n 100→\n 101→  const rank = (m) => {\n 102→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 103→    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n 104→    const unknown = f.risk === 'unknown' ? 1 : 0\n 105→    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n 106→    if (usageKind === 'Light') return [price, unknown, m.key]\n 107→    return [unknown, price, m.key]\n 108→  }\n 109→  candidates.sort((a, b) => {\n 110→    const ra = rank(a), rb = rank(b)\n 111→    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n 112→    return 0\n 113→  })\n 114→\n 115→  const picked = candidates.slice(0, count).map((m) => {\n 116→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 117→    const call = cliCall(config, m, request)\n 118→    return {\n 119→      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n 120→      adapter: config.providers[m.provider]?.adapter || null,\n 121→      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n 122→      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n 123→      forecast: f, cli: call, call,\n 124→    }\n 125→  })\n 126→  return {\n 127→    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n 128→    models: picked, calls: picked.map((x) => x.call), rejected,\n 129→    reason: picked.length ? null : 'no_eligible_model',\n 130→    truncated: picked.length < count,\n 131→  }\n 132→}\n 133→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5db8d7356b342a8bb17aca43d","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5db8d7356b342a8bb17aca43d","codebuddy.ai/llmMessageId":"01a1b6e5db8d7356b342a8bb17aca43d","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:41.606Z"}
{"type":"user","uuid":"01a1b6e5-e309-76ff-8932-1f471117d6ce","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_6rQ09KQWiULO3lyF5jnJ9377","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import os from 'node:os'\n   3→import path from 'node:path'\n   4→\n   5→export const SCHEMA = 'cliworker.config/v1'\n   6→\n   7→export function defaultHome() {\n   8→  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   9→}\n  10→\n  11→export function loadConfig({ file } = {}) {\n  12→  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome() }\n  23→}\n  24→\n  25→export function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file) {\n  28→  try {\n  29→    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row) {\n  34→  ensureDir(path.dirname(file))\n  35→  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5db8d7356b342a8bb17aca43d","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5db8d7356b342a8bb17aca43d","codebuddy.ai/llmMessageId":"01a1b6e5db8d7356b342a8bb17aca43d","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:41.610Z"}
{"type":"user","uuid":"01a1b6e5-e30d-781d-9b04-a633b80e6cf6","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_1wzDdEwTH5M9IRyUcCaW4925","content":[{"type":"text","text":"   1→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   2→\n   3→export function normalizePrices(m = {}) {\n   4→  const p = m.prices || {}\n   5→  return {\n   6→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n   7→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n   8→  }\n   9→}\n  10→\n  11→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  12→  const p = { ...DEFAULT_PRICES, ...prices }\n  13→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  14→}\n  15→\n  16→/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n  17→export function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\n  18→  const rows = records.filter((r) => !model || r.model === model)\n  19→  const samples = rows.map((r) => ({\n  20→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  21→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  22→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  23→  if (!samples.length) {\n  24→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  25→  }\n  26→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  27→  const use = recent.length ? recent : samples.slice(-10)\n  28→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  29→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  30→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  31→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  32→  let tasksLeft = null\n  33→  let etaHours = null\n  34→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  35→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  36→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  37→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  38→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  39→  }\n  40→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  41→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  42→  return {\n  43→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  44→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  45→    confidence, risk,\n  46→  }\n  47→}\n  48→\n  49→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  50→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5db8d7356b342a8bb17aca43d","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5db8d7356b342a8bb17aca43d","codebuddy.ai/llmMessageId":"01a1b6e5db8d7356b342a8bb17aca43d","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:41.614Z"}
{"type":"user","uuid":"01a1b6e5-e311-7537-adf4-5b9d2959b4fd","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_h5ovIHPbRBhom2SsEbMQ7623","content":[{"type":"text","text":"   1→import { spawnSync } from 'node:child_process'\n   2→\n   3→function run(command, args, timeout = 20_000) {\n   4→  try {\n   5→    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n   6→    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n   7→  } catch (e) {\n   8→    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n   9→  }\n  10→}\n  11→\n  12→export function checkProvider(provider, { probe = true } = {}) {\n  13→  const cli = provider.cli\n  14→  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n  15→  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n  16→  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n  17→  const v = run(cli, versionArgs)\n  18→  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n  19→  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n  20→  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n  21→  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n  22→  const auth = run(cli, [...prefix, ...provider.auth_args])\n  23→  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n  24→  const ok = auth.ok && (\n  25→    !provider.auth_ok ||\n  26→    text.includes(String(provider.auth_ok).toLowerCase()) ||\n  27→    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n  28→    /\\blogged in\\b/.test(text)\n  29→  )\n  30→  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n  31→}\n  32→\n  33→export function providerStatus(config, opts = {}) {\n  34→  const out = {}\n  35→  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n  36→  return out\n  37→}\n  38→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6e5ba867444bd771672006700a3","_messageId":"01a1b6e5db8d7356b342a8bb17aca43d","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6e5ba867444bd771672006700a3","codebuddy.ai/modelRequestId":"01a1b6e5db8d7356b342a8bb17aca43d","codebuddy.ai/llmMessageId":"01a1b6e5db8d7356b342a8bb17aca43d","traceparent":"00-4a75c094774db18b4fa9b0e599d0db42-f8dbe608f8e504b0-01","baggage":"codebuddy.session_id=01a1b6e5-b62d-77fa-b8d6-e09057b99f7b,codebuddy.conversation_request_id=01a1b6e5ba867444bd771672006700a3"},"__timestamp":"2026-11-07T16:44:41.618Z"}
