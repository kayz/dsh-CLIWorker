nt CLI/model layer for AgentLine (providers, models, availability, cost, selection).\",\n  \"type\": \"module\",\n  \"main\": \"lib/index.js\",\n  \"exports\": {\n    \".\": \"./lib/index.js\",\n    \"./package.json\": \"./package.json\"\n  },\n  \"scripts\": {\n    \"test\": \"node scripts/run-tests.mjs\",\n    \"check\": \"node scripts/check-fast.mjs\",\n    \"perf\": \"node scripts/run-tests.mjs --perf\",\n    \"snapshot:update\": \"node scripts/run-tests.mjs --update-snapshots\"\n  },\n  \"dsh\": {\n    \"bundle\": {\n      \"patch\": \"./cordis.patch.yml\"\n    }\n  },\n  \"files\": [\n    \"lib\",\n    \"cordis.patch.yml\",\n    \"dsh.plugin.json\",\n    \"README.md\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6ed676071dd96d1dddec21a8d4b","_messageId":"01a1b6ed7b307a1b9fb73f8057b7ae5e","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6ed676071dd96d1dddec21a8d4b","codebuddy.ai/modelRequestId":"01a1b6ed7b307a1b9fb73f8057b7ae5e","codebuddy.ai/llmMessageId":"01a1b6ed7b307a1b9fb73f8057b7ae5e","traceparent":"00-d8eabdeed6a792af6860e0cc046eb175-76376bad59b4e1b9-01","baggage":"codebuddy.session_id=01a1b6ed-6347-7996-b80f-9c3d13c8d87d,codebuddy.conversation_request_id=01a1b6ed676071dd96d1dddec21a8d4b"},"__timestamp":"2026-11-07T16:53:02.286Z"}
