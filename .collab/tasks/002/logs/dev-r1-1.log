{"type":"assistant","uuid":"01a1b6e9-7bf5-7083-b4b3-46135580e34b","session_id":"01a1b6e5-b62d-77fa-b8d6-e09057b99f7b","message":{"id":"01a1b6e94d1373679b40951a2a83f1e8","content":[{"type":"tool_use","id":"call_01_UIxv50Wt36fGtKe9DsOF5585","name":"Write","input":{"content":"import fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\n\nexport const SCHEMA = 'cliworker.config/v1'\n\nexport function defaultHome() {\n  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n}\n\nexport function loadConfig({ file } = {}) {\n  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n  let raw\n  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) {\n    const error = new Error('CLIWorker config must be a JSON object')\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  if (raw.schema && raw.schema !== SCHEMA) {\n    const error = new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  if (!raw.providers || typeof raw.providers !== 'object') {\n    const error = new Error('providers is required')\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  if (!raw.models || typeof raw.models !== 'object') {\n    const error = new Error('models is required')\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  return { ...raw, _file: root, _home: defaultHome() }\n}\n\nexport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n\nexport function readUsage(file) {\n  try {\n    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  } catch { return [] }\n}\n\nexport function appendUsage(file, row) {\n  ensureDir(path.dirname(file))\n  fs.appe