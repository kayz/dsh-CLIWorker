{"type":"user","uuid":"01a1b703-086c-7669-9576-93eb3246f43f","session_id":"01a1b702-b3c6-73aa-9ff7-de3344d3e8cc","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_cesSJeeyNqxpczIqs0cz2344","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import crypto from 'node:crypto'\n   4→import fs from 'node:fs'\n   5→import os from 'node:os'\n   6→import path from 'node:path'\n   7→\n   8→import { checkFrozenFiles } from '../../scripts/check-frozen-files.mjs'\n   9→import { checkRepros, reproSha256 } from '../../scripts/check-defects.mjs'\n  10→\n  11→const COPY = 'test/fixtures/characterization/v0.1/'\n  12→const STABLE = 'test/characterization/stable.test.mjs'\n  13→const SELECT = `${COPY}lib/select.mjs`\n  14→\n  15→function digest(text) {\n  16→  return crypto.createHash('sha256').update(text, 'utf8').digest('hex')\n  17→}\n  18→\n  19→function entry(rel, text) {\n  20→  return { path: rel, sha256: digest(text) }\n  21→}\n  22→\n  23→function tempRoot() {\n  24→  return fs.mkdtempSync(path.join(os.tmpdir(), 'cw-frozen-unit-'))\n  25→}\n  26→\n  27→function write(root, rel, text) {\n  28→  const file = path.join(root, ...rel.split('/'))\n  29→  fs.mkdirSync(path.dirname(file), { recursive: true })\n  30→  fs.writeFileSync(file, text)\n  31→  return file\n  32→}\n  33→\n  34→function copyFiles() {\n  35→  return {\n  36→    [SELECT]: \"export const level = 'Quick'\\n\",\n  37→    [`${COPY}config/cliworker.example.json`]: '{\"providers\":{}}\\n',\n  38→    [STABLE]: \"test('[AC-005] stable: placeholder', () => {})\\n\",\n  39→  }\n  40→}\n  41→\n  42→function manifestRoot(files, registered) {\n  43→  const root = tempRoot()\n  44→  for (const [rel, text] of Object.entries(files)) write(root, rel, text)\n  45→  const manifest = { source_commit: 'f75bb76', files: registered }\n  46→  write(root, 'test/characterization/frozen-files.json', JSON.stringify(manifest, null, 2) + '\\n')\n  47→  return root\n  48→}\n  49→\n  50→function registeredFrom(files, extras = []) {\n  51→  return [...Object.keys(files).map((rel) => entry(rel, files[rel])), ...extras]\n  52→}\n  53→\n  54→function clean(root) {\n  55→  fs.rmSync(root, { recursive: true, force: true })\n  56→}\n  57→\n  58→const ZERO = '0'.repeat(64)\n  59→\n  60→const MINI_REPRO = [\n  61→  \"import test from 'node:test'\",\n  62→  \"import assert from 'node:assert/strict'\",\n  63→  \"import path from 'node:path'\",\n  64→  \"import { pathToFileURL } from 'node:url'\",\n  65→  '',\n  66→  \"test('[repro] mini defect is present', async () => {\",\n  67→  \"  const mod = await import(pathToFileURL(path.join(process.env.CLIWORKER_V01_ROOT, 'lib', 'select.mjs')).href)\",\n  68→  \"  assert.equal(mod.BROKEN, true)\",\n  69→  '})',\n  70→  '',\n  71→].join('\\n')\n  72→\n  73→const ALWAYS_REPRO = [\n  74→  \"import test from 'node:test'\",\n  75→  \"import assert from 'node:assert/strict'\",\n  76→  '',\n  77→  \"test('[repro] the repro is a tautology', () => {\",\n  78→  '  assert.ok(true)',\n  79→  '})',\n  80→  '',\n  81→].join('\\n')\n  82→\n  83→function ledgerFor(repro) {\n  84→  return {\n  85→    id: 'mini',\n  86→    owner_task: 'T-001',\n  87→    owner_milestone: 'M1',\n  88→    ac: 'AC-001',\n  89→    repro_sha256: reproSha256(repro),\n  90→  }\n  91→}\n  92→\n  93→function defectRoot({ repro, copy = \"export const BROKEN = true\\n\", overlay = \"export const BROKEN = false\\n\", canary = true, edits = undefined }) {\n  94→  const root = tempRoot()\n  95→  write(root, SELECT, copy)\n  96→  write(root, 'test/characterization/defects/mini.test.mjs', repro)\n  97→  if (canary) {\n  98→    const data = { defect: 'mini' }\n  99→    if (edits !== undefined) data.repro_edits = edits\n 100→    write(root, 'test/characterization/canary/mini/canary.json', JSON.stringify(data, null, 2) + '\\n')\n 101→    if (overlay !== null) write(root, 'test/characterization/canary/mini/overlay/lib/select.mjs', overlay)\n 102→  }\n 103→  return root\n 104→}\n 105→\n 106→function ids(errors) {\n 107→  return errors.map((error) => error.id)\n 108→}\n 109→\n 110→test('[AC-005] frozen: untouched fixture root passes', () => {\n 111→  const files = copyFiles()\n 112→  const root = manifestRoot(files, registeredFrom(files))\n 113→  try {\n 114→    const { errors, count } = checkFrozenFiles({ root })\n 115→    assert.deepEqual(errors, [])\n 116→    assert.equal(count, 3)\n 117→  } finally {\n 118→    clean(root)\n 119→  }\n 120→})\n 121→\n 122→test('[AC-005] frozen: changing one registered byte fails with frozen.hash_mismatch', () => {\n 123→  const files = copyFiles()\n 124→  const root = manifestRoot(files, registeredFrom(files))\n 125→  try {\n 126→    write(root, SELECT, \"export const level = 'High'\\n\")\n 127→    const { errors } = checkFrozenFiles({ root })\n 128→    assert.deepEqual(ids(errors), ['frozen.hash_mismatch'])\n 129→    assert.equal(errors[0].detail, SELECT)\n 130→  } finally {\n 131→    clean(root)\n 132→  }\n 133→})\n 134→\n 135→test('[AC-005] frozen: CRLF checkout of a registered file still passes', () => {\n 136→  const files = copyFiles()\n 137→  const root = manifestRoot(files, registeredFrom(files))\n 138→  try {\n 139→    write(root, SELECT, files[SELECT].replace(/\\n/g, '\\r\\n'))\n 140→    write(root, STABLE, files[STABLE].replace(/\\n/g, '\\r\\n'))\n 141→    const { errors } = checkFrozenFiles({ root })\n 142→    assert.deepEqual(errors, [])\n 143→  } finally {\n 144→    clean(root)\n 145→  }\n 146→})\n 147→\n 148→test('[AC-005] frozen: lib/, bin/ and config/ paths are rejected as frozen.forbidden_path', () => {\n 149→  const files = copyFiles()\n 150→  const root = manifestRoot(files, registeredFrom(files, [\n 151→    { path: 'lib/select.mjs', sha256: ZERO },\n 152→    { path: 'bin/cliworker.mjs', sha256: ZERO },\n 153→    { path: 'config/cliworker.example.json', sha256: ZERO },\n 154→  ]))\n 155→  try {\n 156→    const { errors } = checkFrozenFiles({ root })\n 157→    assert.deepEqual(ids(errors), ['frozen.forbidden_path', 'frozen.forbidden_path', 'frozen.forbidden_path'])\n 158→    assert.deepEqual(errors.map((error) => error.detail), [\n 159→      'lib/select.mjs',\n 160→      'bin/cliworker.mjs',\n 161→      'config/cliworker.example.json',\n 162→    ])\n 163→  } finally {\n 164→    clean(root)\n 165→  }\n 166→})\n 167→\n 168→test('[AC-005] frozen: scripts/ and other unlisted paths fail with frozen.outside_allowed', () => {\n 169→  const files = copyFiles()\n 170→  const root = manifestRoot(files, registeredFrom(files, [\n 171→    { path: 'scripts/run-tests.mjs', sha256: ZERO },\n 172→    { path: 'package.json', sha256: ZERO },\n 173→  ]))\n 174→  try {\n 175→    const { errors } = checkFrozenFiles({ root })\n 176→    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed'])\n 177→    assert.deepEqual(errors.map((error) => error.detail), ['scripts/run-tests.mjs', 'package.json'])\n 178→  } finally {\n 179→    clean(root)\n 180→  }\n 181→})\n 182→\n 183→test('[AC-005] frozen: contracts/spec and contracts/golden paths are allowed', () => {\n 184→  const files = copyFiles()\n 185→  files['contracts/spec/surfaces.json'] = '{}\\n'\n 186→  files['contracts/golden/select.json'] = '{}\\n'\n 187→  const root = manifestRoot(files, registeredFrom(files))\n 188→  try {\n 189→    const { errors, count } = checkFrozenFiles({ root })\n 190→    assert.deepEqual(errors, [])\n 191→    assert.equal(count, 5)\n 192→  } finally {\n 193→    clean(root)\n 194→  }\n 195→})\n 196→\n 197→test('[AC-005] frozen: unregistered file in the v0.1 copy fails with frozen.unregistered', () => {\n 198→  const files = copyFiles()\n 199→  const root = manifestRoot(files, registeredFrom(files))\n 200→  try {\n 201→    write(root, `${COPY}README.md`, 'x\\n')\n 202→    const { errors } = checkFrozenFiles({ root })\n 203→    assert.deepEqual(ids(errors), ['frozen.unregistered'])\n 204→    assert.equal(errors[0].detail, `${COPY}README.md`)\n 205→  } finally {\n 206→    clean(root)\n 207→  }\n 208→})\n 209→\n 210→test('[AC-005] frozen: missing registered file fails with frozen.file_missing', () => {\n 211→  const files = copyFiles()\n 212→  const root = manifestRoot(files, registeredFrom(files, [\n 213→    { path: `${COPY}lib/forecast.mjs`, sha256: ZERO },\n 214→  ]))\n 215→  try {\n 216→    const { errors } = checkFrozenFiles({ root })\n 217→    assert.deepEqual(ids(errors), ['frozen.file_missing'])\n 218→    assert.equal(errors[0].detail, `${COPY}lib/forecast.mjs`)\n 219→  } finally {\n 220→    clean(root)\n 221→  }\n 222→})\n 223→\n 224→test('[AC-005] frozen: path traversal and absolute paths are rejected', () => {\n 225→  const files = copyFiles()\n 226→  const root = manifestRoot(files, registeredFrom(files, [\n 227→    { path: '../outside.json', sha256: ZERO },\n 228→    { path: 'C:/tmp/outside.json', sha256: ZERO },\n 229→    { path: 'lib\\\\select.mjs', sha256: ZERO },\n 230→  ]))\n 231→  try {\n 232→    const { errors } = checkFrozenFiles({ root })\n 233→    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed', 'frozen.outside_allowed'])\n 234→  } finally {\n 235→    clean(root)\n 236→  }\n 237→})\n 238→\n 239→test('[AC-005] defects: well-formed fixture ledger passes', () => {\n 240→  const root = defectRoot({ repro: MINI_REPRO })\n 241→  try {\n 242→    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n 243→    assert.deepEqual(errors, [])\n 244→  } finally {\n 245→    clean(root)\n 246→  }\n 247→})\n 248→\n 249→test('[AC-005] defects: repro edited after registration fails with defects.repro_changed', () => {\n 250→  const root = defectRoot({ repro: MINI_REPRO })\n 251→  try {\n 252→    const edited = MINI_REPRO.replace('assert.equal(mod.BROKEN, true)', 'assert.equal(mod.BROKEN, true, \"edited\")')\n 253→    write(root, 'test/characterization/defects/mini.test.mjs', edited)\n 254→    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n 255→    assert.deepEqual(ids(errors), ['defects.repro_changed'])\n 256→  } finally {\n 257→    clean(root)\n 258→  }\n 259→})\n 260→\n 261→test('[AC-005] defects: canary that still passes fails with defects.canary_survived', () => {\n 262→  const root = defectRoot({ repro: ALWAYS_REPRO })\n 263→  try {\n 264→    const { errors } = checkRepros({ root, defects: [ledgerFor(ALWAYS_REPRO)] })\n 265→    assert.deepEqual(ids(errors), ['defects.canary_survived'])\n 266→  } finally {\n 267→    clean(root)\n 268→  }\n 269→})\n 270→\n 271→test('[AC-005] defects: missing canary fails with defects.canary_missing', () => {\n 272→  const root = defectRoot({ repro: MINI_REPRO, canary: false })\n 273→  try {\n 274→    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n 275→    assert.deepEqual(ids(errors), ['defects.canary_missing'])\n 276→  } finally {\n 277→    clean(root)\n 278→  }\n 279→})\n 280→\n 281→test('[AC-005] defects: repro failing on the unmodified copy fails with defects.repro_baseline_failed', () => {\n 282→  const root = defectRoot({ repro: MINI_REPRO, copy: 'export const BROKEN = false\\n' })\n 283→  try {\n 284→    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n 285→    assert.deepEqual(ids(errors), ['defects.repro_baseline_failed'])\n 286→  } finally {\n 287→    clean(root)\n 288→  }\n 289→})\n 290→\n 291→test('[AC-005] defects: a repro that cannot even load is not counted as a canary hit', () => {\n 292→  const root = defectRoot({\n 293→    repro: MINI_REPRO,\n 294→    overlay: null,\n 295→    edits: [{ find: 'assert.equal(mod.BROKEN, true)', replace: 'assert.equal(mod.BROKEN,' }],\n 296→  })\n 297→  try {\n 298→    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n 299→    assert.ok(errors.length > 0)\n 300→    assert.ok(\n 301→      ['defects.canary_survived', 'defects.canary_error'].includes(errors[0].id),\n 302→      `unexpected ${errors[0].id}`\n 303→ 