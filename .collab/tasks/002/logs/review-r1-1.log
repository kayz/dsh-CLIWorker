{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LGW7RzMrRgnZokwNy4wR3W","type":"tool_result","content":"1\t// Retained-surface tests for the frozen 0.1 copy. Everything under test is imported from\n2\t// test/fixtures/characterization/v0.1/, never from lib/ or bin/, so the assertions keep\n3\t// describing 0.1 even while the live tree moves on.\n4\timport test from 'node:test'\n5\timport assert from 'node:assert/strict'\n6\timport fs from 'node:fs'\n7\timport path from 'node:path'\n8\timport { fileURLToPath } from 'node:url'\n9\t\n10\timport { listModels, selectModels, SCHEMA as SELECTION_SCHEMA } from '../fixtures/characterization/v0.1/lib/select.mjs'\n11\timport { SCHEMA as CONFIG_SCHEMA } from '../fixtures/characterization/v0.1/lib/config.mjs'\n12\t\n13\tconst HERE = path.dirname(fileURLToPath(import.meta.url))\n14\tconst STATUS = { claude: { state: 'callable' } }\n15\t\n16\tfunction config(models) {\n17\t  return {\n18\t    providers: { claude: { cli: 'claude', readonly: true } },\n19\t    models,\n20\t  }\n21\t}\n22\t\n23\tfunction claudeModel(id, overrides = {}) {\n24\t  return { provider: 'claude', id, level: 'Quick', identity: 'verified', ...overrides }\n25\t}\n26\t\n27\ttest('[AC-005] stable: deprecated models are never candidates', () => {\n28\t  const cfg = config({\n29\t    live: claudeModel('live'),\n30\t    retired: claudeModel('retired', { deprecated: true, deprecated_reason: 'retired before 0.1' }),\n31\t  })\n32\t\n33\t  const visible = listModels(cfg, { status: STATUS })\n34\t  assert.deepEqual(visible.map((m) => m.key), ['live'])\n35\t\n36\t  const withDeprecated = listModels(cfg, { status: STATUS, includeDeprecated: true })\n37\t  const retired = withDeprecated.find((m) => m.key === 'retired')\n38\t  assert.ok(retired, 'includeDeprecated must surface the deprecated model')\n39\t  assert.equal(retired.availability, 'deprecated')\n40\t\n41\t  const result = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n42\t  assert.deepEqual(result.rejected, [{ key: 'retired', reason: 'availability:deprecated' }])\n43\t  assert.deepEqual(result.models.map((m) => m.key), ['live'])\n44\t})\n45\t\n46\ttest('[AC-005] stable: unverified identity is rejected unless require_verified is false', () => {\n47\t  const cfg = config({ unverified: claudeModel('unverified', { identity: 'unverified' }) })\n48\t\n49\t  const rejected = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n50\t  assert.equal(rejected.ok, false)\n51\t  assert.deepEqual(rejected.rejected, [{ key: 'unverified', reason: 'identity_unverified' }])\n52\t\n53\t  const allowed = selectModels(cfg, { level: 'Quick', require_verified: false }, { status: STATUS })\n54\t  assert.equal(allowed.ok, true)\n55\t  assert.deepEqual(allowed.models.map((m) => m.key), ['unverified'])\n56\t})\n57\t\n58\ttest('[AC-005] stable: level filter rejects other levels', () => {\n59\t  const cfg = config({ quick: claudeModel('quick'), top: claudeModel('top', { level: 'Top' }) })\n60\t\n61\t  const result = selectModels(cfg, { level: 'top' }, { status: STATUS })\n62\t  assert.equal(result.level, 'Top')\n63\t  assert.deepEqual(result.rejected, [{ key: 'quick', reason: 'level:Quick' }])\n64\t  assert.deepEqual(result.models.map((m) => m.key), ['top'])\n65\t\n66\t  const missing = selectModels(cfg, {}, { status: STATUS })\n67\t  assert.equal(missing.ok, false)\n68\t  assert.equal(missing.reason, 'E_LEVEL_REQUIRED')\n69\t})\n70\t\n71\ttest('[AC-005] stable: exclude wins and reports excluded', () => {\n72\t  const cfg = config({ quick: claudeModel('quick'), top: claudeModel('top', { level: 'Top' }) })\n73\t\n74\t  const result = selectModels(cfg, { level: 'Quick', exclude: ['top'] }, { status: STATUS })\n75\t  assert.deepEqual(result.rejected, [{ key: 'top', reason: 'excluded' }])\n76\t  assert.deepEqual(result.models.map((m) => m.key), ['quick'])\n77\t})\n78\t\n79\ttest('[AC-005] stable: the four schema names', () => {\n80\t  const cfg = config({ quick: claudeModel('quick') })\n81\t\n82\t  assert.equal(CONFIG_SCHEMA, 'cliworker.config/v1')\n83\t  assert.equal(SELECTION_SCHEMA, 'cliworker.selection/v1')\n84\t\n85\t  const [entry] = listModels(cfg, { status: STATUS })\n86\t  assert.equal(entry.schema, 'cliworker.model/v1')\n87\t\n88\t  const result = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n89\t  assert.equal(result.models[0].schema, 'cliworker.handle/v1')\n90\t})\n91\t\n92\ttest('[AC-005] stable: imports only the v0.1 copy', () => {\n93\t  const source = fs.readFileSync(path.join(HERE, 'stable.test.mjs'), 'utf8')\n94\t  const specifiers = [...source.matchAll(/(?:from\\s*|import\\s*\\(\\s*)['\"]([^'\"]+)['\"]/g)].map((match) => match[1])\n95\t  const relative = specifiers.filter((spec) => spec.startsWith('.'))\n96\t\n97\t  assert.ok(relative.length >= 2, `expected at least two relative imports, saw ${relative.length}`)\n98\t  for (const spec of relative) {\n99\t    assert.ok(spec.includes('fixtures/characterization/v0.1/'), `import must point at the copy: ${spec}`)\n100\t  }\n101\t})\n102\t"}]},"parent_tool_use_id":null,"session_id":"1bfc3824-4f07-451d-8f74-61b35b0110d8","uuid":"c6b3aa8f-a4bc-48c8-b944-d3ead6d4b1e1","timestamp":"2026-11-07T17:14:26.518Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\002\\test\\characterization\\stable.test.mjs","content":"// Retained-surface tests for the frozen 0.1 copy. Everything under test is imported from\n// test/fixtures/characterization/v0.1/, never from lib/ or bin/, so the assertions keep\n// describing 0.1 even while the live tree moves on.\nimport test from 'node:test'\nimport assert from 'node:assert/strict'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nimport { listModels, selectModels, SCHEMA as SELECTION_SCHEMA } from '../fixtures/characterization/v0.1/lib/select.mjs'\nimport { SCHEMA as CONFIG_SCHEMA } from '../fixtures/characterization/v0.1/lib/config.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst STATUS = { claude: { state: 'callable' } }\n\nfunction config(models) {\n  return {\n    providers: { claude: { cli: 'claude', readonly: true } },\n    models,\n  }\n}\n\nfunction claudeModel(id, overrides = {}) {\n  return { provider: 'claude', id, level: 'Quick', identity: 'verified', ...overrides }\n}\n\ntest('[AC-005] stable: deprecated models are never candidates', () => {\n  const cfg = config({\n    live: claudeModel('live'),\n    retired: claudeModel('retired', { deprecated: true, deprecated_reason: 'retired before 0.1' }),\n  })\n\n  const visible = listModels(cfg, { status: STATUS })\n  assert.deepEqual(visible.map((m) => m.key), ['live'])\n\n  const withDeprecated = listModels(cfg, { status: STATUS, includeDeprecated: true })\n  const retired = withDeprecated.find((m) => m.key === 'retired')\n  assert.ok(retired, 'includeDeprecated must surface the deprecated model')\n  assert.equal(retired.availability, 'deprecated')\n\n  const result = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n  assert.deepEqual(result.rejected, [{ key: 'retired', reason: 'availability:deprecated' }])\n  assert.deepEqual(result.models.map((m) => m.key), ['live'])\n})\n\ntest('[AC-005] stable: unverified identity is rejected unless require_verified is false', () => {\n  const cfg = config({ unverified: claudeModel('unverified', { identity: 'unverified' }) })\n\n  const rejected = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n  assert.equal(rejected.ok, false)\n  assert.deepEqual(rejected.rejected, [{ key: 'unverified', reason: 'identity_unverified' }])\n\n  const allowed = selectModels(cfg, { level: 'Quick', require_verified: false }, { status: STATUS })\n  assert.equal(allowed.ok, true)\n  assert.deepEqual(allowed.models.map((m) => m.key), ['unverified'])\n})\n\ntest('[AC-005] stable: level filter rejects other levels', () => {\n  const cfg = config({ quick: claudeModel('quick'), top: claudeModel('top', { level: 'Top' }) })\n\n  const result = selectModels(cfg, { level: 'top' }, { status: STATUS })\n  assert.equal(result.level, 'Top')\n  assert.deepEqual(result.rejected, [{ key: 'quick', reason: 'level:Quick' }])\n  assert.deepEqual(result.models.map((m) => m.key), ['top'])\n\n  const missing = selectModels(cfg, {}, { status: STATUS })\n  assert.equal(missing.ok, false)\n  assert.equal(missing.reason, 'E_LEVEL_REQUIRED')\n})\n\ntest('[AC-005] stable: exclude wins and reports excluded', () => {\n  const cfg = config({ quick: claudeModel('quick'), top: claudeModel('top', { level: 'Top' }) })\n\n  const result = selectModels(cfg, { level: 'Quick', exclude: ['top'] }, { status: STATUS })\n  assert.deepEqual(result.rejected, [{ key: 'top', reason: 'excluded' }])\n  assert.deepEqual(result.models.map((m) => m.key), ['quick'])\n})\n\ntest('[AC-005] stable: the four schema names', () => {\n  const cfg = config({ quick: claudeModel('quick') })\n\n  assert.equal(CONFIG_SCHEMA, 'cliworker.config/v1')\n  assert.equal(SELECTION_SCHEMA, 'cliworker.selection/v1')\n\n  const [entry] = listModels(cfg, { status: STATUS })\n  assert.equal(entry.schema, 'cliworker.model/v1')\n\n  const result = selectModels(cfg, { level: 'Quick' }, { status: STATUS })\n  assert.equal(result.models[0].schema, 'cliworker.handle/v1')\n})\n\ntest('[AC-005] stable: imports only the v0.1 copy', () => {\n  const source = fs.readFileSync(path.join(HERE, 'stable.test.mjs'), 'utf8')\n  const specifiers = [...source.matchAll(/(?:from\\s*|import\\s*\\(\\s*)['\"]([^'\"]+)['\"]/g)].map((match) => match[1])\n  const relative = specifiers.filter((spec) => spec.startsWith('.'))\n\n  assert.ok(relative.length >= 2, `expected at least two relative imports, saw ${relative.length}`)\n  for (const spec of relative) {\n    assert.ok(spec.includes('fixtures/characterization/v0.1/'), `import must point at the copy: ${spec}`)\n  }\n})\n","numLines":102,"startLine":1,"totalLines":102}},"tool_result_meta":[{"id":"toolu_01LGW7RzMrRgnZokwNy4wR3W","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
