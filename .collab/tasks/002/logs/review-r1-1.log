{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TmWeZqmCtK3nz38seXnZ2j","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Frozen-file check: the registered characterization/golden files must keep their exact bytes.\n3\t// Hashing normalizes CRLF to LF so an autocrlf checkout and a Linux CI checkout agree.\n4\timport crypto from 'node:crypto'\n5\timport fs from 'node:fs'\n6\timport path from 'node:path'\n7\timport { fileURLToPath } from 'node:url'\n8\t\n9\tconst HERE = path.dirname(fileURLToPath(import.meta.url))\n10\tconst REPO_ROOT = path.resolve(HERE, '..')\n11\t\n12\tconst MANIFEST = ['test', 'characterization', 'frozen-files.json']\n13\tconst COPY_DIR = 'test/fixtures/characterization/v0.1/'\n14\tconst STABLE = 'test/characterization/stable.test.mjs'\n15\tconst SOURCE_COMMIT = 'f75bb76'\n16\tconst FORBIDDEN_PREFIXES = ['lib/', 'bin/', 'config/']\n17\tconst ALLOWED_PREFIXES = [COPY_DIR, 'contracts/spec/', 'contracts/golden/']\n18\t\n19\tconst USAGE = 'usage: node scripts/check-frozen-files.mjs [--root <dir>]'\n20\t\n21\t/** Bytes as text with every CRLF folded to LF, so the digest is line-ending agnostic. */\n22\texport function normalizeContent(buffer) {\n23\t  return buffer.toString('latin1').replace(/\\r\\n/g, '\\n')\n24\t}\n25\t\n26\texport function contentHash(buffer) {\n27\t  return crypto.createHash('sha256').update(normalizeContent(buffer), 'latin1').digest('hex')\n28\t}\n29\t\n30\tfunction isAllowed(rel) {\n31\t  if (rel === STABLE) return true\n32\t  return ALLOWED_PREFIXES.some((prefix) => rel.startsWith(prefix) && rel.length > prefix.length)\n33\t}\n34\t\n35\t/** Reject anything that is not a plain repository-relative posix path inside the allowed set. */\n36\texport function classifyPath(rel) {\n37\t  if (rel.includes('\\\\')) return { id: 'frozen.outside_allowed', detail: rel }\n38\t  if (/^[A-Za-z]:/.test(rel)) return { id: 'frozen.outside_allowed', detail: rel }\n39\t  if (path.posix.isAbsolute(rel)) return { id: 'frozen.outside_allowed', detail: rel }\n40\t  if (rel.split('/').includes('..')) return { id: 'frozen.outside_allowed', detail: rel }\n41\t\n42\t  const normalized = path.posix.normalize(rel)\n43\t  if (normalized === '.' || normalized === '' || normalized.startsWith('../')) {\n44\t    return { id: 'frozen.outside_allowed', detail: rel }\n45\t  }\n46\t\n47\t  const lowered = normalized.toLowerCase()\n48\t  for (const prefix of FORBIDDEN_PREFIXES) {\n49\t    if (lowered === prefix.slice(0, -1) || lowered.startsWith(prefix)) {\n50\t      return { id: 'frozen.forbidden_path', detail: normalized }\n51\t    }\n52\t  }\n53\t  if (!isAllowed(normalized)) return { id: 'frozen.outside_allowed', detail: normalized }\n54\t  return { path: normalized }\n55\t}\n56\t\n57\tfunction walkFiles(dir, prefix, found) {\n58\t  let entries\n59\t  try {\n60\t    entries = fs.readdirSync(dir, { withFileTypes: true })\n61\t  } catch {\n62\t    return\n63\t  }\n64\t  for (const entry of entries) {\n65\t    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`\n66\t    if (entry.isDirectory()) walkFiles(path.join(dir, entry.name), rel, found)\n67\t    else if (entry.isFile()) found.push(rel)\n68\t  }\n69\t}\n70\t\n71\texport function checkFrozenFiles({ root }) {\n72\t  const errors = []\n73\t  const base = path.resolve(root)\n74\t  const manifestFile = path.join(base, ...MANIFEST)\n75\t\n76\t  let manifest = null\n77\t  try {\n78\t    manifest = JSON.parse(fs.readFileSync(manifestFile, 'utf8'))\n79\t  } catch {\n80\t    errors.push({ id: 'frozen.manifest_missing', detail: 'test/characterization/frozen-files.json' })\n81\t    return { errors, count: 0 }\n82\t  }\n83\t\n84\t  if (!manifest || typeof manifest !== 'object' || Array.isArray(manifest)) {\n85\t    errors.push({ id: 'frozen.manifest_schema', detail: 'manifest must be a JSON object' })\n86\t    return { errors, count: 0 }\n87\t  }\n88\t  if (manifest.source_commit !== SOURCE_COMMIT) {\n89\t    errors.push({ id: 'frozen.manifest_schema', detail: `source_commit must be ${SOURCE_COMMIT}` })\n90\t  }\n91\t  if (!Array.isArray(manifest.files)) {\n92\t    errors.push({ id: 'frozen.manifest_schema', detail: 'files must be an array' })\n93\t    return { errors, count: 0 }\n94\t  }\n95\t\n96\t  const seen = new Set()\n97\t  const registered = new Set()\n98\t  let count = 0\n99\t\n100\t  for (const entry of manifest.files) {\n101\t    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n102\t      errors.push({ id: 'frozen.manifest_schema', detail: 'every registered file must be an object' })\n103\t      continue\n104\t    }\n105\t    const rel = entry.path\n106\t    if (typeof rel !== 'string' || rel === '') {\n107\t      errors.push({ id: 'frozen.manifest_schema', detail: 'registered file needs a non-empty path' })\n108\t      continue\n109\t    }\n110\t    if (typeof entry.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(entry.sha256)) {\n111\t      errors.push({ id: 'frozen.manifest_schema', detail: `${rel} has an invalid sha256` })\n112\t      continue\n113\t    }\n114\t    if (seen.has(rel)) {\n115\t      errors.push({ id: 'frozen.manifest_schema', detail: `duplicate path ${rel}` })\n116\t      continue\n117\t    }\n118\t    seen.add(rel)\n119\t\n120\t    const verdict = classifyPath(rel)\n121\t    if (verdict.id) {\n122\t      errors.push({ id: verdict.id, detail: verdict.detail })\n123\t      continue\n124\t    }\n125\t    registered.add(verdict.path)\n126\t    count += 1\n127\t\n128\t    let buffer = null\n129\t    try {\n130\t      buffer = fs.readFileSync(path.join(base, ...verdict.path.split('/')))\n131\t    } catch {\n132\t      buffer = null\n133\t    }\n134\t    if (buffer === null) {\n135\t      errors.push({ id: 'frozen.file_missing', detail: verdict.path })\n136\t      continue\n137\t    }\n138\t    if (contentHash(buffer) !== entry.sha256) {\n139\t      errors.push({ id: 'frozen.hash_mismatch', detail: verdict.path })\n140\t    }\n141\t  }\n142\t\n143\t  const copyFiles = []\n144\t  walkFiles(path.join(base, ...COPY_DIR.split('/').filter(Boolean)), '', copyFiles)\n145\t  for (const rel of copyFiles.sort()) {\n146\t    if (!registered.has(`${COPY_DIR}${rel}`)) {\n147\t      errors.push({ id: 'frozen.unregistered', detail: `${COPY_DIR}${rel}` })\n148\t    }\n149\t  }\n150\t  if (!registered.has(STABLE)) {\n151\t    errors.push({ id: 'frozen.unregistered', detail: STABLE })\n152\t  }\n153\t\n154\t  return { errors, count }\n155\t}\n156\t\n157\tfunction main() {\n158\t  const args = process.argv.slice(2)\n159\t  let root = REPO_ROOT\n160\t\n161\t  for (let i = 0; i < args.length; i += 1) {\n162\t    const flag = args[i]\n163\t    if (flag === '--root') {\n164\t      const value = args[i + 1]\n165\t      if (typeof value !== 'string' || value === '') {\n166\t        process.stderr.write(`--root requires a directory\\n${USAGE}\\n`)\n167\t        process.exitCode = 2\n168\t        return\n169\t      }\n170\t      root = path.resolve(value)\n171\t      i += 1\n172\t    } else {\n173\t      process.stderr.write(`unknown argument: ${flag}\\n${USAGE}\\n`)\n174\t      process.exitCode = 2\n175\t      return\n176\t    }\n177\t  }\n178\t\n179\t  const { errors, count } = checkFrozenFiles({ root })\n180\t  if (errors.length === 0) {\n181\t    process.stdout.write(`check-frozen-files: ok (${count} files)\\n`)\n182\t    process.exitCode = 0\n183\t    return\n184\t  }\n185\t  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n186\t  process.stdout.write(`check-frozen-files: FAILED (${errors.length} errors)\\n`)\n187\t  process.exitCode = 1\n188\t}\n189\t\n190\tconst invokedDirectly =\n191\t  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n192\t\n193\tif (invokedDirectly) main()\n194\t"}]},"parent_tool_use_id":null,"session_id":"1bfc3824-4f07-451d-8f74-61b35b0110d8","uuid":"57d1c7b2-10f1-4ea2-bff8-4a84e0c25ef6","timestamp":"2026-11-07T17:14:17.736Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\002\\scripts\\check-frozen-files.mjs","content":"#!/usr/bin/env node\n// Frozen-file check: the registered characterization/golden files must keep their exact bytes.\n// Hashing normalizes CRLF to LF so an autocrlf checkout and a Linux CI checkout agree.\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\n\nconst MANIFEST = ['test', 'characterization', 'frozen-files.json']\nconst COPY_DIR = 'test/fixtures/characterization/v0.1/'\nconst STABLE = 'test/characterization/stable.test.mjs'\nconst SOURCE_COMMIT = 'f75bb76'\nconst FORBIDDEN_PREFIXES = ['lib/', 'bin/', 'config/']\nconst ALLOWED_PREFIXES = [COPY_DIR, 'contracts/spec/', 'contracts/golden/']\n\nconst USAGE = 'usage: node scripts/check-frozen-files.mjs [--root <dir>]'\n\n/** Bytes as text with every CRLF folded to LF, so the digest is line-ending agnostic. */\nexport function normalizeContent(buffer) {\n  return buffer.toString('latin1').replace(/\\r\\n/g, '\\n')\n}\n\nexport function contentHash(buffer) {\n  return crypto.createHash('sha256').update(normalizeContent(buffer), 'latin1').digest('hex')\n}\n\nfunction isAllowed(rel) {\n  if (rel === STABLE) return true\n  return ALLOWED_PREFIXES.some((prefix) => rel.startsWith(prefix) && rel.length > prefix.length)\n}\n\n/** Reject anything that is not a plain repository-relative posix path inside the allowed set. */\nexport function classifyPath(rel) {\n  if (rel.includes('\\\\')) return { id: 'frozen.outside_allowed', detail: rel }\n  if (/^[A-Za-z]:/.test(rel)) return { id: 'frozen.outside_allowed', detail: rel }\n  if (path.posix.isAbsolute(rel)) return { id: 'frozen.outside_allowed', detail: rel }\n  if (rel.split('/').includes('..')) return { id: 'frozen.outside_allowed', detail: rel }\n\n  const normalized = path.posix.normalize(rel)\n  if (normalized === '.' || normalized === '' || normalized.startsWith('../')) {\n    return { id: 'frozen.outside_allowed', detail: rel }\n  }\n\n  const lowered = normalized.toLowerCase()\n  for (const prefix of FORBIDDEN_PREFIXES) {\n    if (lowered === prefix.slice(0, -1) || lowered.startsWith(prefix)) {\n      return { id: 'frozen.forbidden_path', detail: normalized }\n    }\n  }\n  if (!isAllowed(normalized)) return { id: 'frozen.outside_allowed', detail: normalized }\n  return { path: normalized }\n}\n\nfunction walkFiles(dir, prefix, found) {\n  let entries\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true })\n  } catch {\n    return\n  }\n  for (const entry of entries) {\n    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`\n    if (entry.isDirectory()) walkFiles(path.join(dir, entry.name), rel, found)\n    else if (entry.isFile()) found.push(rel)\n  }\n}\n\nexport function checkFrozenFiles({ root }) {\n  const errors = []\n  const base = path.resolve(root)\n  const manifestFile = path.join(base, ...MANIFEST)\n\n  let manifest = null\n  try {\n    manifest = JSON.parse(fs.readFileSync(manifestFile, 'utf8'))\n  } catch {\n    errors.push({ id: 'frozen.manifest_missing', detail: 'test/characterization/frozen-files.json' })\n    return { errors, count: 0 }\n  }\n\n  if (!manifest || typeof manifest !== 'object' || Array.isArray(manifest)) {\n    errors.push({ id: 'frozen.manifest_schema', detail: 'manifest must be a JSON object' })\n    return { errors, count: 0 }\n  }\n  if (manifest.source_commit !== SOURCE_COMMIT) {\n    errors.push({ id: 'frozen.manifest_schema', detail: `source_commit must be ${SOURCE_COMMIT}` })\n  }\n  if (!Array.isArray(manifest.files)) {\n    errors.push({ id: 'frozen.manifest_schema', detail: 'files must be an array' })\n    return { errors, count: 0 }\n  }\n\n  const seen = new Set()\n  const registered = new Set()\n  let count = 0\n\n  for (const entry of manifest.files) {\n    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n      errors.push({ id: 'frozen.manifest_schema', detail: 'every registered file must be an object' })\n      continue\n    }\n    const rel = entry.path\n    if (typeof rel !== 'string' || rel === '') {\n      errors.push({ id: 'frozen.manifest_schema', detail: 'registered file needs a non-empty path' })\n      continue\n    }\n    if (typeof entry.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(entry.sha256)) {\n      errors.push({ id: 'frozen.manifest_schema', detail: `${rel} has an invalid sha256` })\n      continue\n    }\n    if (seen.has(rel)) {\n      errors.push({ id: 'frozen.manifest_schema', detail: `duplicate path ${rel}` })\n      continue\n    }\n    seen.add(rel)\n\n    const verdict = classifyPath(rel)\n    if (verdict.id) {\n      errors.push({ id: verdict.id, detail: verdict.detail })\n      continue\n    }\n    registered.add(verdict.path)\n    count += 1\n\n    let buffer = null\n    try {\n      buffer = fs.readFileSync(path.join(base, ...verdict.path.split('/')))\n    } catch {\n      buffer = null\n    }\n    if (buffer === null) {\n      errors.push({ id: 'frozen.file_missing', detail: verdict.path })\n      continue\n    }\n    if (contentHash(buffer) !== entry.sha256) {\n      errors.push({ id: 'frozen.hash_mismatch', detail: verdict.path })\n    }\n  }\n\n  const copyFiles = []\n  walkFiles(path.join(base, ...COPY_DIR.split('/').filter(Boolean)), '', copyFiles)\n  for (const rel of copyFiles.sort()) {\n    if (!registered.has(`${COPY_DIR}${rel}`)) {\n      errors.push({ id: 'frozen.unregistered', detail: `${COPY_DIR}${rel}` })\n    }\n  }\n  if (!registered.has(STABLE)) {\n    errors.push({ id: 'frozen.unregistered', detail: STABLE })\n  }\n\n  return { errors, count }\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write(`--root requires a directory\\n${USAGE}\\n`)\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      i += 1\n    } else {\n      process.stderr.write(`unknown argument: ${flag}\\n${USAGE}\\n`)\n      process.exitCode = 2\n      return\n    }\n  }\n\n  const { errors, count } = checkFrozenFiles({ root })\n  if (errors.length === 0) {\n    process.stdout.write(`check-frozen-files: ok (${count} files)\\n`)\n    process.exitCode = 0\n    return\n  }\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n  process.stdout.write(`check-frozen-files: FAILED (${errors.length} errors)\\n`)\n  process.exitCode = 1\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","numLines":194,"startLine":1,"totalLines":194}},"tool_result_meta":[{"id":"toolu_01TmWeZqmCtK3nz38seXnZ2j","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Yp3hogKzMLdnuDGuFWVCV","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\n3\timport crypto from 'node:crypto'\n4\timport fs from 'node:fs'\n5\timport os from 'node:os'\n6\timport path from 'node:path'\n7\timport { spawnSync } from 'node:child_process'\n8\timport { fileURLToPath, pathToFileURL } from 'node:url'\n9\t\n10\timport { mergeShards, extractTitles } from './check-traceability.mjs'\n11\t\n12\tconst HERE = path.dirname(fileURLToPath(import.meta.url))\n13\tconst REPO_ROOT = path.resolve(HERE, '..')\n14\t\n15\tconst MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\n16\tconst EXPECTED_IDS = [\n17\t  'a1-quota',\n18\t  'a2-pack',\n19\t  'a3-runner',\n20\t  'a4-paths',\n21\t  'a4-null-config',\n22\t  'a5-dup-call',\n23\t  'a5-forecast-x3',\n24\t  'a5-unused',\n25\t  'a5-ignored-fields',\n26\t  'a5-shell',\n27\t  'a5-nocache',\n28\t]\n29\t\n30\tconst LEDGER = ['test', 'characterization', 'defects.json']\n31\tconst DEFECTS_DIR = ['test', 'characterization', 'defects']\n32\tconst CANARY_DIR = ['test', 'characterization', 'canary']\n33\tconst COPY_DIR = ['test', 'fixtures', 'characterization', 'v0.1']\n34\t\n35\tconst RUN_TIMEOUT_MS = 60_000\n36\tconst REPRO_OPEN_RE = /^test\\(['\"`]\\[repro\\]/\n37\tconst TAP_REPRO_OK_RE = /^\\s*ok \\d+ - \\[repro\\]/m\n38\tconst TAP_REPRO_NOT_OK_RE = /^\\s*not ok \\d+ - \\[repro\\]/m\n39\tconst RELATIVE_IMPORT_RE = /(\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\bimport\\s+)(['\"])(\\.[^'\"]*)\\2/g\n40\t\n41\texport function milestoneRank(value) {\n42\t  const index = MILESTONES.indexOf(value)\n43\t  return index < 0 ? Number.NaN : index + 1\n44\t}\n45\t\n46\texport function hasFixedSection(source) {\n47\t  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\n48\t}\n49\t\n50\texport function checkDefects({ root, index, milestone }) {\n51\t  const errors = []\n52\t  const ledgerFile = path.join(root, ...LEDGER)\n53\t\n54\t  if (!fs.existsSync(ledgerFile)) {\n55\t    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\n56\t    return { errors, absent: true }\n57\t  }\n58\t\n59\t  let ledger = null\n60\t  try {\n61\t    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\n62\t  } catch {\n63\t    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\n64\t    return { errors, absent: false }\n65\t  }\n66\t\n67\t  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n68\t  if (!list) {\n69\t    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\n70\t    return { errors, absent: false }\n71\t  }\n72\t\n73\t  const knownAcs = new Set()\n74\t  for (const entry of index?.acs ?? []) {\n75\t    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\n76\t  }\n77\t\n78\t  const seen = new Set()\n79\t  const valid = []\n80\t  for (const item of list) {\n81\t    if (!item || typeof item !== 'object' || Array.isArray(item)) {\n82\t      errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\n83\t      continue\n84\t    }\n85\t    const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\n86\t    const problems = []\n87\t    if (typeof id !== 'string' || id === '') problems.push('id')\n88\t    if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\n89\t    if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\n90\t    if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\n91\t\n92\t    if (problems.length > 0) {\n93\t      errors.push({\n94\t        id: 'defects.schema',\n95\t        detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\n96\t      })\n97\t      continue\n98\t    }\n99\t    if (seen.has(id)) {\n100\t      errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\n101\t      continue\n102\t    }\n103\t    seen.add(id)\n104\t    valid.push({ id, ownerTask, ownerMilestone, ac })\n105\t  }\n106\t\n107\t  if (milestone === 'M5') {\n108\t    const actual = [...seen].sort()\n109\t    const expected = [...EXPECTED_IDS].sort()\n110\t    if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n111\t      errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n112\t    }\n113\t  }\n114\t\n115\t  let required = []\n116\t  if (milestone) {\n117\t    const limit = milestoneRank(milestone)\n118\t    required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\n119\t  } else {\n120\t    const merged = mergeShards({ root, index })\n121\t    required = valid.filter((item) => merged.acs[item.ac] === 'covered')\n122\t  }\n123\t\n124\t  for (const item of required) {\n125\t    const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\n126\t    let source = null\n127\t    try {\n128\t      source = fs.readFileSync(file, 'utf8')\n129\t    } catch {\n130\t      source = null\n131\t    }\n132\t    if (source === null || !hasFixedSection(source)) {\n133\t      errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\n134\t    }\n135\t  }\n136\t\n137\t  return { errors, absent: false }\n138\t}\n139\t\n140\tfunction toPosix(value) {\n141\t  return value.split(path.sep).join('/')\n142\t}\n143\t\n144\t/** Blocks are delimited by a column-0 `test('[repro] ...', ... => {` line and the next column-0 `})`. */\n145\texport function extractReproSection(source) {\n146\t  const text = String(source ?? '').replace(/\\r\\n/g, '\\n')\n147\t  const lines = text.split('\\n')\n148\t  const blocks = []\n149\t  const errors = []\n150\t\n151\t  for (let i = 0; i < lines.length; i += 1) {\n152\t    if (!REPRO_OPEN_RE.test(lines[i])) continue\n153\t    if (!/\\{\\s*$/.test(lines[i])) {\n154\t      errors.push(`repro block at line ${i + 1} does not end with {`)\n155\t      continue\n156\t    }\n157\t    let end = -1\n158\t    for (let j = i + 1; j < lines.length; j += 1) {\n159\t      if (lines[j] === '})') {\n160\t        end = j\n161\t        break\n162\t      }\n163\t    }\n164\t    if (end < 0) {\n165\t      errors.push(`repro block at line ${i + 1} has no closing })`)\n166\t      continue\n167\t    }\n168\t    blocks.push(lines.slice(i, end + 1).join('\\n'))\n169\t    i = end\n170\t  }\n171\t\n172\t  return { blocks, errors }\n173\t}\n174\t\n175\texport function reproSha256(source) {\n176\t  const { blocks, errors } = extractReproSection(source)\n177\t  if (errors.length > 0 || blocks.length === 0) return null\n178\t  return crypto.createHash('sha256').update(blocks.join('\\n'), 'utf8').digest('hex')\n179\t}\n180\t\n181\tfunction reproError(id, defectId, message) {\n182\t  return { id, detail: `${defectId} ${message}` }\n183\t}\n184\t\n185\tfunction walkRelative(dir, prefix, found) {\n186\t  let entries\n187\t  try {\n188\t    entries = fs.readdirSync(dir, { withFileTypes: true })\n189\t  } catch {\n190\t    return\n191\t  }\n192\t  for (const entry of entries) {\n193\t    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`\n194\t    if (entry.isDirectory()) walkRelative(path.join(dir, entry.name), rel, found)\n195\t    else if (entry.isFile()) found.push(rel)\n196\t  }\n197\t}\n198\t\n199\tfunction copyTree(source, target) {\n200\t  fs.mkdirSync(target, { recursive: true })\n201\t  for (const entry of fs.readdirSync(source, { withFileTypes: true })) {\n202\t    const from = path.join(source, entry.name)\n203\t    const to = path.join(target, entry.name)\n204\t    if (entry.isDirectory()) copyTree(from, to)\n205\t    else if (entry.isFile()) fs.copyFileSync(from, to)\n206\t  }\n207\t}\n208\t\n209\t/** Overlay paths are relative to the v0.1 copy root and must stay inside it. */\n210\tfunction safeOverlayPath(rel) {\n211\t  if (rel.includes('\\\\')) return null\n212\t  if (/^[A-Za-z]:/.test(rel) || path.posix.isAbsolute(rel)) return null\n213\t  if (rel.split('/').includes('..')) return null\n214\t  const normalized = path.posix.normalize(rel)\n215\t  if (normalized === '.' || normalized === '' || normalized.startsWith('../')) return null\n216\t  return normalized\n217\t}\n218\t\n219\tfunction readCanary({ root, id }) {\n220\t  const dir = path.join(root, ...CANARY_DIR, id)\n221\t  let data = null\n222\t  try {\n223\t    data = JSON.parse(fs.readFileSync(path.join(dir, 'canary.json'), 'utf8'))\n224\t  } catch {\n225\t    data = null\n226\t  }\n227\t  if (!data || typeof data !== 'object' || Array.isArray(data)) {\n228\t    return { error: 'defects.canary_missing', detail: 'canary.json is missing or not a JSON object' }\n229\t  }\n230\t  if (data.defect !== id) {\n231\t    return { error: 'defects.canary_missing', detail: `canary.json declares defect ${String(data.defect)}, expected ${id}` }\n232\t  }\n233\t\n234\t  const overlayDir = path.join(dir, 'overlay')\n235\t  const overlayFiles = []\n236\t  walkRelative(overlayDir, '', overlayFiles)\n237\t  const overlays = []\n238\t  for (const rel of overlayFiles.sort()) {\n239\t    const safe = safeOverlayPath(rel)\n240\t    if (safe === null) {\n241\t      return { error: 'defects.canary_error', detail: `overlay path escapes the copy: ${rel}` }\n242\t    }\n243\t    overlays.push({ rel: safe, file: path.join(overlayDir, ...safe.split('/')) })\n244\t  }\n245\t\n246\t  const edits = []\n247\t  if (data.repro_edits !== undefined) {\n248\t    if (!Array.isArray(data.repro_edits)) {\n249\t      return { error: 'defects.canary_error', detail: 'repro_edits must be an array' }\n250\t    }\n251\t    for (const edit of data.repro_edits) {\n252\t      if (\n253\t        !edit ||\n254\t        typeof edit !== 'object' ||\n255\t        typeof edit.find !== 'string' ||\n256\t        edit.find === '' ||\n257\t        typeof edit.replace !== 'string'\n258\t      ) {\n259\t        return { error: 'defects.canary_error', detail: 'repro_edits entries need find and replace strings' }\n260\t      }\n261\t      edits.push({ find: edit.find, replace: edit.replace })\n262\t    }\n263\t  }\n264\t\n265\t  if (overlays.length === 0 && edits.length === 0) {\n266\t    return { error: 'defects.canary_missing', detail: 'canary has neither overlay files nor repro_edits' }\n267\t  }\n268\t\n269\t  return { overlays, edits }\n270\t}\n271\t\n272\tfunction runRepro({ root, reproFile, source, overlays, edits, nodePath }) {\n273\t  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-canary-'))\n274\t  try {\n275\t    const copyRoot = path.join(tmp, 'v0.1')\n276\t    copyTree(path.join(root, ...COPY_DIR), copyRoot)\n277\t    fs.writeFileSync(path.join(copyRoot, 'package.json'), '{\"type\":\"module\"}\\n')\n278\t\n279\t    for (const overlay of overlays) {\n280\t      const target = path.join(copyRoot, ...overlay.rel.split('/'))\n281\t      fs.mkdirSync(path.dirname(target), { recursive: true })\n282\t      fs.copyFileSync(overlay.file, target)\n283\t    }\n284\t\n285\t    let text = source\n286\t    for (const edit of edits) text = text.split(edit.find).join(edit.replace)\n287\t\n288\t    const baseDir = path.dirname(reproFile)\n289\t    text = text.replace(\n290\t      RELATIVE_IMPORT_RE,\n291\t      (match, lead, quote, spec) => `${lead}${quote}${pathToFileURL(path.resolve(baseDir, spec)).href}${quote}`\n292\t    )\n293\t\n294\t    const reproCopy = path.join(tmp, 'repro.test.mjs')\n295\t    fs.writeFileSync(reproCopy, text)\n296\t\n297\t    const env = { ...process.env, CLIWORKER_V01_ROOT: copyRoot }\n298\t    delete env.NODE_TEST_CONTEXT\n299\t\n300\t    const result = spawnSync(\n301\t      nodePath,\n302\t      ['--test', '--test-reporter=tap', '--test-name-pattern=\\\\[repro\\\\]', reproCopy],\n303\t      { cwd: tmp, env, encoding: 'utf8', timeout: RUN_TIMEOUT_MS, maxBuffer: 16 * 1024 * 1024 }\n304\t    )\n305\t\n306\t    return {\n307\t      status: result.status,\n308\t      output: `${result.stdout ?? ''}${result.stderr ?? ''}`,\n309\t      error: result.error ?? null,\n310\t    }\n311\t  } finally {\n312\t    fs.rmSync(tmp, { recursive: true, force: true })\n313\t  }\n314\t}\n315\t\n316\texport function checkRepros({ root, defects, nodePath = process.execPath }) {\n317\t  const errors = []\n318\t  const list = Array.isArray(defects) ? defects : []\n319\t  const base = path.resolve(root)\n320\t\n321\t  for (const defect of list) {\n322\t    const id = defect && typeof defect.id === 'string' ? defect.id : '-'\n323\t    const registeredSha = defect && typeof defect.repro_sha256 === 'string' ? defect.repro_sha256 : ''\n324\t\n325\t    if (!/^[0-9a-f]{64}$/.test(registeredSha)) {\n326\t      errors.push(reproError('defects.repro_sha_missing', id, 'repro_sha256 is missing or not 64 lowercase hex characters'))\n327\t      continue\n328\t    }\n329\t\n330\t    const reproFile = path.join(base, ...DEFECTS_DIR, `${id}.test.mjs`)\n331\t    let source = null\n332\t    try {\n333\t      source = fs.readFileSync(reproFile, 'utf8')\n334\t    } catch {\n335\t      source = null\n336\t    }\n337\t    if (source === null) {\n338\t      errors.push(reproError('defects.repro_missing', id, `missing ${toPosix(path.relative(base, reproFile))}`))\n339\t      continue\n340\t    }\n341\t\n342\t    const section = extractReproSection(source)\n343\t    if (section.errors.length > 0) {\n344\t      errors.push(reproError('defects.repro_format', id, section.errors.join('; ')))\n345\t      continue\n346\t    }\n347\t    if (section.blocks.length === 0) {\n348\t      errors.push(reproError('defects.repro_missing', id, 'no [repro] block'))\n349\t      continue\n350\t    }\n351\t\n352\t    const actualSha = crypto.createHash('sha256').update(section.blocks.join('\\n'), 'utf8').digest('hex')\n353\t    if (actualSha !== registeredSha) {\n354\t      errors.push(reproError('defects.repro_changed', id, `sha256 ${actualSha} does not match the registered value`))\n355\t      continue\n356\t    }\n357\t\n358\t    const canary = readCanary({ root: base, id })\n359\t    if (canary.error) {\n360\t      errors.push(reproError(canary.error, id, canary.detail))\n361\t      continue\n362\t    }\n363\t\n364\t    let editProblem = null\n365\t    for (const edit of canary.edits) {\n366\t      const occurrences = source.split(edit.find).length - 1\n367\t      if (occurrences !== 1) {\n368\t        editProblem = `repro_edits find \"${edit.find}\" occurs ${occurrences} times instead of once`\n369\t        break\n370\t      }\n371\t    }\n372\t    if (editProblem !== null) {\n373\t      errors.push(reproError('defects.canary_error', id, editProblem))\n374\t      continue\n375\t    }\n376\t\n377\t    const baseline = runRepro({\n378\t      root: base,\n379\t      reproFile,\n380\t      source,\n381\t      overlays: [],\n382\t      edits: [],\n383\t      nodePath,\n384\t    })\n385\t    const baselineOk =\n386\t      baseline.status === 0 && TAP_REPRO_OK_RE.test(baseline.output) && !TAP_REPRO_NOT_OK_RE.test(baseline.output)\n387\t    if (!baselineOk) {\n388\t      const reason = baseline.error ? String(baseline.error.message ?? baseline.error) : `exit ${baseline.status}`\n389\t      errors.push(reproError('defects.repro_baseline_failed', id, `the repro does not pass on the v0.1 copy (${reason})`))\n390\t      continue\n391\t    }\n392\t\n393\t    const canaryRun = runRepro({\n394\t      root: base,\n395\t      reproFile,\n396\t      source,\n397\t      overlays: canary.overlays,\n398\t      edits: canary.edits,\n399\t      nodePath,\n400\t    })\n401\t    if (!TAP_REPRO_NOT_OK_RE.test(canaryRun.output)) {\n402\t      const reason = canaryRun.error ? String(canaryRun.error.message ?? canaryRun.error) : `exit ${canaryRun.status}`\n403\t      errors.push(reproError('defects.canary_survived', id, `the repro still passes on the fixed variant (${reason})`))\n404\t    }\n405\t  }\n406\t\n407\t  return { errors }\n408\t}\n409\t\n410\tfunction readLedger(root) {\n411\t  try {\n412\t    return JSON.parse(fs.readFileSync(path.join(root, ...LEDGER), 'utf8'))\n413\t  } catch {\n414\t    return null\n415\t  }\n416\t}\n417\t\n418\tfunction main() {\n419\t  const args = process.argv.slice(2)\n420\t  let root = REPO_ROOT\n421\t  let indexPath = null\n422\t  let milestone = null\n423\t  let strict = false\n424\t  let rootGiven = false\n425\t\n426\t  for (let i = 0; i < args.length; i += 1) {\n427\t    const flag = args[i]\n428\t    if (flag === '--root') {\n429\t      const value = args[i + 1]\n430\t      if (typeof value !== 'string' || value === '') {\n431\t        process.stderr.write('--root requires a directory\\n')\n432\t        process.exitCode = 2\n433\t        return\n434\t      }\n435\t      root = path.resolve(value)\n436\t      rootGiven = true\n437\t      i += 1\n438\t    } else if (flag === '--index') {\n439\t      const value = args[i + 1]\n440\t      if (typeof value !== 'string' || value === '') {\n441\t        process.stderr.write('--index requires a file\\n')\n442\t        process.exitCode = 2\n443\t        return\n444\t      }\n445\t      indexPath = path.resolve(value)\n446\t      i += 1\n447\t    } else if (flag === '--milestone') {\n448\t      const value = args[i + 1]\n449\t      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n450\t        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n451\t        process.exitCode = 2\n452\t        return\n453\t      }\n454\t      milestone = value\n455\t      i += 1\n456\t    } else if (flag === '--strict') {\n457\t      strict = true\n458\t    } else {\n459\t      process.stderr.write(\n460\t        `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>] [--strict]\\n`\n461\t      )\n462\t      process.exitCode = 2\n463\t      return\n464\t    }\n465\t  }\n466\t\n467\t  // Checking the real repo (no --root) is always strict. Fixture roots stay lenient unless asked.\n468\t  const strictMode = strict || !rootGiven\n469\t\n470\t  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n471\t  let index = { acs: [] }\n472\t  try {\n473\t    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n474\t  } catch {\n475\t    index = { acs: [] }\n476\t  }\n477\t\n478\t  const checked = checkDefects({ root, index, milestone })\n479\t  const absent = checked.absent\n480\t  const errors = [...checked.errors]\n481\t\n482\t  if (strictMode && !absent) {\n483\t    const ledger = readLedger(root)\n484\t    const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n485\t    if (list) {\n486\t      if (!errors.some((error) => error.id === 'defects.set_mismatch')) {\n487\t        const actual = list.map((item) => (item && typeof item.id === 'string' ? item.id : '')).sort()\n488\t        const expected = [...EXPECTED_IDS].sort()\n489\t        if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n490\t          errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n491\t        }\n492\t      }\n493\t      errors.push(...checkRepros({ root, defects: list, nodePath: process.execPath }).errors)\n494\t    }\n495\t  }\n496\t\n497\t  if (absent && !milestone) {\n498\t    process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\n499\t    process.exitCode = 0\n500\t    return\n501\t  }\n502\t\n503\t  if (errors.length === 0) {\n504\t    process.stdout.write('check-defects: ok\\n')\n505\t    process.exitCode = 0\n506\t    return\n507\t  }\n508\t  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n509\t  process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\n510\t  process.exitCode = 1\n511\t}\n512\t\n513\tconst invokedDirectly =\n514\t  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n515\t\n516\tif (invokedDirectly) main()\n517\t"}]},"parent_tool_use_id":null,"session_id":"1bfc3824-4f07-451d-8f74-61b35b0110d8","uuid":"78318d4d-7e4a-4a67-8748-42683f79b24e","timestamp":"2026-11-07T17:14:17.740Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\002\\scripts\\check-defects.mjs","content":"#!/usr/bin/env node\n// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { spawnSync } from 'node:child_process'\nimport { fileURLToPath, pathToFileURL } from 'node:url'\n\nimport { mergeShards, extractTitles } from './check-traceability.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\n\nconst MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\nconst EXPECTED_IDS = [\n  'a1-quota',\n  'a2-pack',\n  'a3-runner',\n  'a4-paths',\n  'a4-null-config',\n  'a5-dup-call',\n  'a5-forecast-x3',\n  'a5-unused',\n  'a5-ignored-fields',\n  'a5-shell',\n  'a5-nocache',\n]\n\nconst LEDGER = ['test', 'characterization', 'defects.json']\nconst DEFECTS_DIR = ['test', 'characterization', 'defects']\nconst CANARY_DIR = ['test', 'characterization', 'canary']\nconst COPY_DIR = ['test', 'fixtures', 'characterization', 'v0.1']\n\nconst RUN_TIMEOUT_MS = 60_000\nconst REPRO_OPEN_RE = /^test\\(['\"`]\\[repro\\]/\nconst TAP_REPRO_OK_RE = /^\\s*ok \\d+ - \\[repro\\]/m\nconst TAP_REPRO_NOT_OK_RE = /^\\s*not ok \\d+ - \\[repro\\]/m\nconst RELATIVE_IMPORT_RE = /(\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\bimport\\s+)(['\"])(\\.[^'\"]*)\\2/g\n\nexport function milestoneRank(value) {\n  const index = MILESTONES.indexOf(value)\n  return index < 0 ? Number.NaN : index + 1\n}\n\nexport function hasFixedSection(source) {\n  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\n}\n\nexport function checkDefects({ root, index, milestone }) {\n  const errors = []\n  const ledgerFile = path.join(root, ...LEDGER)\n\n  if (!fs.existsSync(ledgerFile)) {\n    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\n    return { errors, absent: true }\n  }\n\n  let ledger = null\n  try {\n    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\n  } catch {\n    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\n    return { errors, absent: false }\n  }\n\n  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n  if (!list) {\n    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\n    return { errors, absent: false }\n  }\n\n  const knownAcs = new Set()\n  for (const entry of index?.acs ?? []) {\n    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\n  }\n\n  const seen = new Set()\n  const valid = []\n  for (const item of list) {\n    if (!item || typeof item !== 'object' || Array.isArray(item)) {\n      errors.push({ id: 'defects.schema', detail: 'every defect must be an object' })\n      continue\n    }\n    const { id, owner_task: ownerTask, owner_milestone: ownerMilestone, ac } = item\n    const problems = []\n    if (typeof id !== 'string' || id === '') problems.push('id')\n    if (typeof ownerTask !== 'string' || !/^T-\\d{3}$/.test(ownerTask)) problems.push('owner_task')\n    if (!MILESTONES.includes(ownerMilestone)) problems.push('owner_milestone')\n    if (typeof ac !== 'string' || !knownAcs.has(ac)) problems.push('ac')\n\n    if (problems.length > 0) {\n      errors.push({\n        id: 'defects.schema',\n        detail: `${typeof id === 'string' && id !== '' ? id : '-'} has missing or invalid ${problems.join(',')}`,\n      })\n      continue\n    }\n    if (seen.has(id)) {\n      errors.push({ id: 'defects.schema', detail: `duplicate defect id ${id}` })\n      continue\n    }\n    seen.add(id)\n    valid.push({ id, ownerTask, ownerMilestone, ac })\n  }\n\n  if (milestone === 'M5') {\n    const actual = [...seen].sort()\n    const expected = [...EXPECTED_IDS].sort()\n    if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n      errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n    }\n  }\n\n  let required = []\n  if (milestone) {\n    const limit = milestoneRank(milestone)\n    required = valid.filter((item) => milestoneRank(item.ownerMilestone) <= limit)\n  } else {\n    const merged = mergeShards({ root, index })\n    required = valid.filter((item) => merged.acs[item.ac] === 'covered')\n  }\n\n  for (const item of required) {\n    const file = path.join(root, ...DEFECTS_DIR, `${item.id}.test.mjs`)\n    let source = null\n    try {\n      source = fs.readFileSync(file, 'utf8')\n    } catch {\n      source = null\n    }\n    if (source === null || !hasFixedSection(source)) {\n      errors.push({ id: 'defects.missing_fixed', detail: `${item.id} has no [fixed] section` })\n    }\n  }\n\n  return { errors, absent: false }\n}\n\nfunction toPosix(value) {\n  return value.split(path.sep).join('/')\n}\n\n/** Blocks are delimited by a column-0 `test('[repro] ...', ... => {` line and the next column-0 `})`. */\nexport function extractReproSection(source) {\n  const text = String(source ?? '').replace(/\\r\\n/g, '\\n')\n  const lines = text.split('\\n')\n  const blocks = []\n  const errors = []\n\n  for (let i = 0; i < lines.length; i += 1) {\n    if (!REPRO_OPEN_RE.test(lines[i])) continue\n    if (!/\\{\\s*$/.test(lines[i])) {\n      errors.push(`repro block at line ${i + 1} does not end with {`)\n      continue\n    }\n    let end = -1\n    for (let j = i + 1; j < lines.length; j += 1) {\n      if (lines[j] === '})') {\n        end = j\n        break\n      }\n    }\n    if (end < 0) {\n      errors.push(`repro block at line ${i + 1} has no closing })`)\n      continue\n    }\n    blocks.push(lines.slice(i, end + 1).join('\\n'))\n    i = end\n  }\n\n  return { blocks, errors }\n}\n\nexport function reproSha256(source) {\n  const { blocks, errors } = extractReproSection(source)\n  if (errors.length > 0 || blocks.length === 0) return null\n  return crypto.createHash('sha256').update(blocks.join('\\n'), 'utf8').digest('hex')\n}\n\nfunction reproError(id, defectId, message) {\n  return { id, detail: `${defectId} ${message}` }\n}\n\nfunction walkRelative(dir, prefix, found) {\n  let entries\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true })\n  } catch {\n    return\n  }\n  for (const entry of entries) {\n    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`\n    if (entry.isDirectory()) walkRelative(path.join(dir, entry.name), rel, found)\n    else if (entry.isFile()) found.push(rel)\n  }\n}\n\nfunction copyTree(source, target) {\n  fs.mkdirSync(target, { recursive: true })\n  for (const entry of fs.readdirSync(source, { withFileTypes: true })) {\n    const from = path.join(source, entry.name)\n    const to = path.join(target, entry.name)\n    if (entry.isDirectory()) copyTree(from, to)\n    else if (entry.isFile()) fs.copyFileSync(from, to)\n  }\n}\n\n/** Overlay paths are relative to the v0.1 copy root and must stay inside it. */\nfunction safeOverlayPath(rel) {\n  if (rel.includes('\\\\')) return null\n  if (/^[A-Za-z]:/.test(rel) || path.posix.isAbsolute(rel)) return null\n  if (rel.split('/').includes('..')) return null\n  const normalized = path.posix.normalize(rel)\n  if (normalized === '.' || normalized === '' || normalized.startsWith('../')) return null\n  return normalized\n}\n\nfunction readCanary({ root, id }) {\n  const dir = path.join(root, ...CANARY_DIR, id)\n  let data = null\n  try {\n    data = JSON.parse(fs.readFileSync(path.join(dir, 'canary.json'), 'utf8'))\n  } catch {\n    data = null\n  }\n  if (!data || typeof data !== 'object' || Array.isArray(data)) {\n    return { error: 'defects.canary_missing', detail: 'canary.json is missing or not a JSON object' }\n  }\n  if (data.defect !== id) {\n    return { error: 'defects.canary_missing', detail: `canary.json declares defect ${String(data.defect)}, expected ${id}` }\n  }\n\n  const overlayDir = path.join(dir, 'overlay')\n  const overlayFiles = []\n  walkRelative(overlayDir, '', overlayFiles)\n  const overlays = []\n  for (const rel of overlayFiles.sort()) {\n    const safe = safeOverlayPath(rel)\n    if (safe === null) {\n      return { error: 'defects.canary_error', detail: `overlay path escapes the copy: ${rel}` }\n    }\n    overlays.push({ rel: safe, file: path.join(overlayDir, ...safe.split('/')) })\n  }\n\n  const edits = []\n  if (data.repro_edits !== undefined) {\n    if (!Array.isArray(data.repro_edits)) {\n      return { error: 'defects.canary_error', detail: 'repro_edits must be an array' }\n    }\n    for (const edit of data.repro_edits) {\n      if (\n        !edit ||\n        typeof edit !== 'object' ||\n        typeof edit.find !== 'string' ||\n        edit.find === '' ||\n        typeof edit.replace !== 'string'\n      ) {\n        return { error: 'defects.canary_error', detail: 'repro_edits entries need find and replace strings' }\n      }\n      edits.push({ find: edit.find, replace: edit.replace })\n    }\n  }\n\n  if (overlays.length === 0 && edits.length === 0) {\n    return { error: 'defects.canary_missing', detail: 'canary has neither overlay files nor repro_edits' }\n  }\n\n  return { overlays, edits }\n}\n\nfunction runRepro({ root, reproFile, source, overlays, edits, nodePath }) {\n  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-canary-'))\n  try {\n    const copyRoot = path.join(tmp, 'v0.1')\n    copyTree(path.join(root, ...COPY_DIR), copyRoot)\n    fs.writeFileSync(path.join(copyRoot, 'package.json'), '{\"type\":\"module\"}\\n')\n\n    for (const overlay of overlays) {\n      const target = path.join(copyRoot, ...overlay.rel.split('/'))\n      fs.mkdirSync(path.dirname(target), { recursive: true })\n      fs.copyFileSync(overlay.file, target)\n    }\n\n    let text = source\n    for (const edit of edits) text = text.split(edit.find).join(edit.replace)\n\n    const baseDir = path.dirname(reproFile)\n    text = text.replace(\n      RELATIVE_IMPORT_RE,\n      (match, lead, quote, spec) => `${lead}${quote}${pathToFileURL(path.resolve(baseDir, spec)).href}${quote}`\n    )\n\n    const reproCopy = path.join(tmp, 'repro.test.mjs')\n    fs.writeFileSync(reproCopy, text)\n\n    const env = { ...process.env, CLIWORKER_V01_ROOT: copyRoot }\n    delete env.NODE_TEST_CONTEXT\n\n    const result = spawnSync(\n      nodePath,\n      ['--test', '--test-reporter=tap', '--test-name-pattern=\\\\[repro\\\\]', reproCopy],\n      { cwd: tmp, env, encoding: 'utf8', timeout: RUN_TIMEOUT_MS, maxBuffer: 16 * 1024 * 1024 }\n    )\n\n    return {\n      status: result.status,\n      output: `${result.stdout ?? ''}${result.stderr ?? ''}`,\n      error: result.error ?? null,\n    }\n  } finally {\n    fs.rmSync(tmp, { recursive: true, force: true })\n  }\n}\n\nexport function checkRepros({ root, defects, nodePath = process.execPath }) {\n  const errors = []\n  const list = Array.isArray(defects) ? defects : []\n  const base = path.resolve(root)\n\n  for (const defect of list) {\n    const id = defect && typeof defect.id === 'string' ? defect.id : '-'\n    const registeredSha = defect && typeof defect.repro_sha256 === 'string' ? defect.repro_sha256 : ''\n\n    if (!/^[0-9a-f]{64}$/.test(registeredSha)) {\n      errors.push(reproError('defects.repro_sha_missing', id, 'repro_sha256 is missing or not 64 lowercase hex characters'))\n      continue\n    }\n\n    const reproFile = path.join(base, ...DEFECTS_DIR, `${id}.test.mjs`)\n    let source = null\n    try {\n      source = fs.readFileSync(reproFile, 'utf8')\n    } catch {\n      source = null\n    }\n    if (source === null) {\n      errors.push(reproError('defects.repro_missing', id, `missing ${toPosix(path.relative(base, reproFile))}`))\n      continue\n    }\n\n    const section = extractReproSection(source)\n    if (section.errors.length > 0) {\n      errors.push(reproError('defects.repro_format', id, section.errors.join('; ')))\n      continue\n    }\n    if (section.blocks.length === 0) {\n      errors.push(reproError('defects.repro_missing', id, 'no [repro] block'))\n      continue\n    }\n\n    const actualSha = crypto.createHash('sha256').update(section.blocks.join('\\n'), 'utf8').digest('hex')\n    if (actualSha !== registeredSha) {\n      errors.push(reproError('defects.repro_changed', id, `sha256 ${actualSha} does not match the registered value`))\n      continue\n    }\n\n    const canary = readCanary({ root: base, id })\n    if (canary.error) {\n      errors.push(reproError(canary.error, id, canary.detail))\n      continue\n    }\n\n    let editProblem = null\n    for (const edit of canary.edits) {\n      const occurrences = source.split(edit.find).length - 1\n      if (occurrences !== 1) {\n        editProblem = `repro_edits find \"${edit.find}\" occurs ${occurrences} times instead of once`\n        break\n      }\n    }\n    if (editProblem !== null) {\n      errors.push(reproError('defects.canary_error', id, editProblem))\n      continue\n    }\n\n    const baseline = runRepro({\n      root: base,\n      reproFile,\n      source,\n      overlays: [],\n      edits: [],\n      nodePath,\n    })\n    const baselineOk =\n      baseline.status === 0 && TAP_REPRO_OK_RE.test(baseline.output) && !TAP_REPRO_NOT_OK_RE.test(baseline.output)\n    if (!baselineOk) {\n      const reason = baseline.error ? String(baseline.error.message ?? baseline.error) : `exit ${baseline.status}`\n      errors.push(reproError('defects.repro_baseline_failed', id, `the repro does not pass on the v0.1 copy (${reason})`))\n      continue\n    }\n\n    const canaryRun = runRepro({\n      root: base,\n      reproFile,\n      source,\n      overlays: canary.overlays,\n      edits: canary.edits,\n      nodePath,\n    })\n    if (!TAP_REPRO_NOT_OK_RE.test(canaryRun.output)) {\n      const reason = canaryRun.error ? String(canaryRun.error.message ?? canaryRun.error) : `exit ${canaryRun.status}`\n      errors.push(reproError('defects.canary_survived', id, `the repro still passes on the fixed variant (${reason})`))\n    }\n  }\n\n  return { errors }\n}\n\nfunction readLedger(root) {\n  try {\n    return JSON.parse(fs.readFileSync(path.join(root, ...LEDGER), 'utf8'))\n  } catch {\n    return null\n  }\n}\n\nfunction main() {\n  const args = process.argv.slice(2)\n  let root = REPO_ROOT\n  let indexPath = null\n  let milestone = null\n  let strict = false\n  let rootGiven = false\n\n  for (let i = 0; i < args.length; i += 1) {\n    const flag = args[i]\n    if (flag === '--root') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--root requires a directory\\n')\n        process.exitCode = 2\n        return\n      }\n      root = path.resolve(value)\n      rootGiven = true\n      i += 1\n    } else if (flag === '--index') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || value === '') {\n        process.stderr.write('--index requires a file\\n')\n        process.exitCode = 2\n        return\n      }\n      indexPath = path.resolve(value)\n      i += 1\n    } else if (flag === '--milestone') {\n      const value = args[i + 1]\n      if (typeof value !== 'string' || !/^M[1-5]$/.test(value)) {\n        process.stderr.write('--milestone requires one of M1, M2, M3, M4, M5\\n')\n        process.exitCode = 2\n        return\n      }\n      milestone = value\n      i += 1\n    } else if (flag === '--strict') {\n      strict = true\n    } else {\n      process.stderr.write(\n        `unknown argument: ${flag}\\nusage: node scripts/check-defects.mjs [--milestone Mx] [--root <dir>] [--index <file>] [--strict]\\n`\n      )\n      process.exitCode = 2\n      return\n    }\n  }\n\n  // Checking the real repo (no --root) is always strict. Fixture roots stay lenient unless asked.\n  const strictMode = strict || !rootGiven\n\n  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n  let index = { acs: [] }\n  try {\n    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n  } catch {\n    index = { acs: [] }\n  }\n\n  const checked = checkDefects({ root, index, milestone })\n  const absent = checked.absent\n  const errors = [...checked.errors]\n\n  if (strictMode && !absent) {\n    const ledger = readLedger(root)\n    const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\n    if (list) {\n      if (!errors.some((error) => error.id === 'defects.set_mismatch')) {\n        const actual = list.map((item) => (item && typeof item.id === 'string' ? item.id : '')).sort()\n        const expected = [...EXPECTED_IDS].sort()\n        if (actual.length !== expected.length || actual.some((id, i) => id !== expected[i])) {\n          errors.push({ id: 'defects.set_mismatch', detail: `ledger ids ${actual.join(',')} != ${expected.join(',')}` })\n        }\n      }\n      errors.push(...checkRepros({ root, defects: list, nodePath: process.execPath }).errors)\n    }\n  }\n\n  if (absent && !milestone) {\n    process.stdout.write('check-defects: defects.json absent, nothing to check\\n')\n    process.exitCode = 0\n    return\n  }\n\n  if (errors.length === 0) {\n    process.stdout.write('check-defects: ok\\n')\n    process.exitCode = 0\n    return\n  }\n  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n  process.stdout.write(`check-defects: FAILED (${errors.length} errors)\\n`)\n  process.exitCode = 1\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()\n","numLines":517,"startLine":1,"totalLines":517}},"tool_result_meta":[{"id":"toolu_019Yp3hogKzMLdnuDGuFWVCV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
