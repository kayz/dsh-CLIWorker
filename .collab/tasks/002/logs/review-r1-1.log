{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017pmxVpjnDC6ZS1PUzN3UFG","type":"tool_result","content":"1\timport test from 'node:test'\n2\timport assert from 'node:assert/strict'\n3\timport crypto from 'node:crypto'\n4\timport fs from 'node:fs'\n5\timport os from 'node:os'\n6\timport path from 'node:path'\n7\t\n8\timport { checkFrozenFiles } from '../../scripts/check-frozen-files.mjs'\n9\timport { checkRepros, reproSha256 } from '../../scripts/check-defects.mjs'\n10\t\n11\tconst COPY = 'test/fixtures/characterization/v0.1/'\n12\tconst STABLE = 'test/characterization/stable.test.mjs'\n13\tconst SELECT = `${COPY}lib/select.mjs`\n14\t\n15\tfunction digest(text) {\n16\t  return crypto.createHash('sha256').update(text, 'utf8').digest('hex')\n17\t}\n18\t\n19\tfunction entry(rel, text) {\n20\t  return { path: rel, sha256: digest(text) }\n21\t}\n22\t\n23\tfunction tempRoot() {\n24\t  return fs.mkdtempSync(path.join(os.tmpdir(), 'cw-frozen-unit-'))\n25\t}\n26\t\n27\tfunction write(root, rel, text) {\n28\t  const file = path.join(root, ...rel.split('/'))\n29\t  fs.mkdirSync(path.dirname(file), { recursive: true })\n30\t  fs.writeFileSync(file, text)\n31\t  return file\n32\t}\n33\t\n34\tfunction copyFiles() {\n35\t  return {\n36\t    [SELECT]: \"export const level = 'Quick'\\n\",\n37\t    [`${COPY}config/cliworker.example.json`]: '{\"providers\":{}}\\n',\n38\t    [STABLE]: \"test('[AC-005] stable: placeholder', () => {})\\n\",\n39\t  }\n40\t}\n41\t\n42\tfunction manifestRoot(files, registered) {\n43\t  const root = tempRoot()\n44\t  for (const [rel, text] of Object.entries(files)) write(root, rel, text)\n45\t  const manifest = { source_commit: 'f75bb76', files: registered }\n46\t  write(root, 'test/characterization/frozen-files.json', JSON.stringify(manifest, null, 2) + '\\n')\n47\t  return root\n48\t}\n49\t\n50\tfunction registeredFrom(files, extras = []) {\n51\t  return [...Object.keys(files).map((rel) => entry(rel, files[rel])), ...extras]\n52\t}\n53\t\n54\tfunction clean(root) {\n55\t  fs.rmSync(root, { recursive: true, force: true })\n56\t}\n57\t\n58\tconst ZERO = '0'.repeat(64)\n59\t\n60\tconst MINI_REPRO = [\n61\t  \"import test from 'node:test'\",\n62\t  \"import assert from 'node:assert/strict'\",\n63\t  \"import path from 'node:path'\",\n64\t  \"import { pathToFileURL } from 'node:url'\",\n65\t  '',\n66\t  \"test('[repro] mini defect is present', async () => {\",\n67\t  \"  const mod = await import(pathToFileURL(path.join(process.env.CLIWORKER_V01_ROOT, 'lib', 'select.mjs')).href)\",\n68\t  \"  assert.equal(mod.BROKEN, true)\",\n69\t  '})',\n70\t  '',\n71\t].join('\\n')\n72\t\n73\tconst ALWAYS_REPRO = [\n74\t  \"import test from 'node:test'\",\n75\t  \"import assert from 'node:assert/strict'\",\n76\t  '',\n77\t  \"test('[repro] the repro is a tautology', () => {\",\n78\t  '  assert.ok(true)',\n79\t  '})',\n80\t  '',\n81\t].join('\\n')\n82\t\n83\tfunction ledgerFor(repro) {\n84\t  return {\n85\t    id: 'mini',\n86\t    owner_task: 'T-001',\n87\t    owner_milestone: 'M1',\n88\t    ac: 'AC-001',\n89\t    repro_sha256: reproSha256(repro),\n90\t  }\n91\t}\n92\t\n93\tfunction defectRoot({ repro, copy = \"export const BROKEN = true\\n\", overlay = \"export const BROKEN = false\\n\", canary = true, edits = undefined }) {\n94\t  const root = tempRoot()\n95\t  write(root, SELECT, copy)\n96\t  write(root, 'test/characterization/defects/mini.test.mjs', repro)\n97\t  if (canary) {\n98\t    const data = { defect: 'mini' }\n99\t    if (edits !== undefined) data.repro_edits = edits\n100\t    write(root, 'test/characterization/canary/mini/canary.json', JSON.stringify(data, null, 2) + '\\n')\n101\t    if (overlay !== null) write(root, 'test/characterization/canary/mini/overlay/lib/select.mjs', overlay)\n102\t  }\n103\t  return root\n104\t}\n105\t\n106\tfunction ids(errors) {\n107\t  return errors.map((error) => error.id)\n108\t}\n109\t\n110\ttest('[AC-005] frozen: untouched fixture root passes', () => {\n111\t  const files = copyFiles()\n112\t  const root = manifestRoot(files, registeredFrom(files))\n113\t  try {\n114\t    const { errors, count } = checkFrozenFiles({ root })\n115\t    assert.deepEqual(errors, [])\n116\t    assert.equal(count, 3)\n117\t  } finally {\n118\t    clean(root)\n119\t  }\n120\t})\n121\t\n122\ttest('[AC-005] frozen: changing one registered byte fails with frozen.hash_mismatch', () => {\n123\t  const files = copyFiles()\n124\t  const root = manifestRoot(files, registeredFrom(files))\n125\t  try {\n126\t    write(root, SELECT, \"export const level = 'High'\\n\")\n127\t    const { errors } = checkFrozenFiles({ root })\n128\t    assert.deepEqual(ids(errors), ['frozen.hash_mismatch'])\n129\t    assert.equal(errors[0].detail, SELECT)\n130\t  } finally {\n131\t    clean(root)\n132\t  }\n133\t})\n134\t\n135\ttest('[AC-005] frozen: CRLF checkout of a registered file still passes', () => {\n136\t  const files = copyFiles()\n137\t  const root = manifestRoot(files, registeredFrom(files))\n138\t  try {\n139\t    write(root, SELECT, files[SELECT].replace(/\\n/g, '\\r\\n'))\n140\t    write(root, STABLE, files[STABLE].replace(/\\n/g, '\\r\\n'))\n141\t    const { errors } = checkFrozenFiles({ root })\n142\t    assert.deepEqual(errors, [])\n143\t  } finally {\n144\t    clean(root)\n145\t  }\n146\t})\n147\t\n148\ttest('[AC-005] frozen: lib/, bin/ and config/ paths are rejected as frozen.forbidden_path', () => {\n149\t  const files = copyFiles()\n150\t  const root = manifestRoot(files, registeredFrom(files, [\n151\t    { path: 'lib/select.mjs', sha256: ZERO },\n152\t    { path: 'bin/cliworker.mjs', sha256: ZERO },\n153\t    { path: 'config/cliworker.example.json', sha256: ZERO },\n154\t  ]))\n155\t  try {\n156\t    const { errors } = checkFrozenFiles({ root })\n157\t    assert.deepEqual(ids(errors), ['frozen.forbidden_path', 'frozen.forbidden_path', 'frozen.forbidden_path'])\n158\t    assert.deepEqual(errors.map((error) => error.detail), [\n159\t      'lib/select.mjs',\n160\t      'bin/cliworker.mjs',\n161\t      'config/cliworker.example.json',\n162\t    ])\n163\t  } finally {\n164\t    clean(root)\n165\t  }\n166\t})\n167\t\n168\ttest('[AC-005] frozen: scripts/ and other unlisted paths fail with frozen.outside_allowed', () => {\n169\t  const files = copyFiles()\n170\t  const root = manifestRoot(files, registeredFrom(files, [\n171\t    { path: 'scripts/run-tests.mjs', sha256: ZERO },\n172\t    { path: 'package.json', sha256: ZERO },\n173\t  ]))\n174\t  try {\n175\t    const { errors } = checkFrozenFiles({ root })\n176\t    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed'])\n177\t    assert.deepEqual(errors.map((error) => error.detail), ['scripts/run-tests.mjs', 'package.json'])\n178\t  } finally {\n179\t    clean(root)\n180\t  }\n181\t})\n182\t\n183\ttest('[AC-005] frozen: contracts/spec and contracts/golden paths are allowed', () => {\n184\t  const files = copyFiles()\n185\t  files['contracts/spec/surfaces.json'] = '{}\\n'\n186\t  files['contracts/golden/select.json'] = '{}\\n'\n187\t  const root = manifestRoot(files, registeredFrom(files))\n188\t  try {\n189\t    const { errors, count } = checkFrozenFiles({ root })\n190\t    assert.deepEqual(errors, [])\n191\t    assert.equal(count, 5)\n192\t  } finally {\n193\t    clean(root)\n194\t  }\n195\t})\n196\t\n197\ttest('[AC-005] frozen: unregistered file in the v0.1 copy fails with frozen.unregistered', () => {\n198\t  const files = copyFiles()\n199\t  const root = manifestRoot(files, registeredFrom(files))\n200\t  try {\n201\t    write(root, `${COPY}README.md`, 'x\\n')\n202\t    const { errors } = checkFrozenFiles({ root })\n203\t    assert.deepEqual(ids(errors), ['frozen.unregistered'])\n204\t    assert.equal(errors[0].detail, `${COPY}README.md`)\n205\t  } finally {\n206\t    clean(root)\n207\t  }\n208\t})\n209\t\n210\ttest('[AC-005] frozen: missing registered file fails with frozen.file_missing', () => {\n211\t  const files = copyFiles()\n212\t  const root = manifestRoot(files, registeredFrom(files, [\n213\t    { path: `${COPY}lib/forecast.mjs`, sha256: ZERO },\n214\t  ]))\n215\t  try {\n216\t    const { errors } = checkFrozenFiles({ root })\n217\t    assert.deepEqual(ids(errors), ['frozen.file_missing'])\n218\t    assert.equal(errors[0].detail, `${COPY}lib/forecast.mjs`)\n219\t  } finally {\n220\t    clean(root)\n221\t  }\n222\t})\n223\t\n224\ttest('[AC-005] frozen: path traversal and absolute paths are rejected', () => {\n225\t  const files = copyFiles()\n226\t  const root = manifestRoot(files, registeredFrom(files, [\n227\t    { path: '../outside.json', sha256: ZERO },\n228\t    { path: 'C:/tmp/outside.json', sha256: ZERO },\n229\t    { path: 'lib\\\\select.mjs', sha256: ZERO },\n230\t  ]))\n231\t  try {\n232\t    const { errors } = checkFrozenFiles({ root })\n233\t    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed', 'frozen.outside_allowed'])\n234\t  } finally {\n235\t    clean(root)\n236\t  }\n237\t})\n238\t\n239\ttest('[AC-005] defects: well-formed fixture ledger passes', () => {\n240\t  const root = defectRoot({ repro: MINI_REPRO })\n241\t  try {\n242\t    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n243\t    assert.deepEqual(errors, [])\n244\t  } finally {\n245\t    clean(root)\n246\t  }\n247\t})\n248\t\n249\ttest('[AC-005] defects: repro edited after registration fails with defects.repro_changed', () => {\n250\t  const root = defectRoot({ repro: MINI_REPRO })\n251\t  try {\n252\t    const edited = MINI_REPRO.replace('assert.equal(mod.BROKEN, true)', 'assert.equal(mod.BROKEN, true, \"edited\")')\n253\t    write(root, 'test/characterization/defects/mini.test.mjs', edited)\n254\t    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n255\t    assert.deepEqual(ids(errors), ['defects.repro_changed'])\n256\t  } finally {\n257\t    clean(root)\n258\t  }\n259\t})\n260\t\n261\ttest('[AC-005] defects: canary that still passes fails with defects.canary_survived', () => {\n262\t  const root = defectRoot({ repro: ALWAYS_REPRO })\n263\t  try {\n264\t    const { errors } = checkRepros({ root, defects: [ledgerFor(ALWAYS_REPRO)] })\n265\t    assert.deepEqual(ids(errors), ['defects.canary_survived'])\n266\t  } finally {\n267\t    clean(root)\n268\t  }\n269\t})\n270\t\n271\ttest('[AC-005] defects: missing canary fails with defects.canary_missing', () => {\n272\t  const root = defectRoot({ repro: MINI_REPRO, canary: false })\n273\t  try {\n274\t    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n275\t    assert.deepEqual(ids(errors), ['defects.canary_missing'])\n276\t  } finally {\n277\t    clean(root)\n278\t  }\n279\t})\n280\t\n281\ttest('[AC-005] defects: repro failing on the unmodified copy fails with defects.repro_baseline_failed', () => {\n282\t  const root = defectRoot({ repro: MINI_REPRO, copy: 'export const BROKEN = false\\n' })\n283\t  try {\n284\t    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n285\t    assert.deepEqual(ids(errors), ['defects.repro_baseline_failed'])\n286\t  } finally {\n287\t    clean(root)\n288\t  }\n289\t})\n290\t\n291\ttest('[AC-005] defects: a repro that cannot even load is not counted as a canary hit', () => {\n292\t  const root = defectRoot({\n293\t    repro: MINI_REPRO,\n294\t    overlay: null,\n295\t    edits: [{ find: 'assert.equal(mod.BROKEN, true)', replace: 'assert.equal(mod.BROKEN,' }],\n296\t  })\n297\t  try {\n298\t    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n299\t    assert.ok(errors.length > 0)\n300\t    assert.ok(\n301\t      ['defects.canary_survived', 'defects.canary_error'].includes(errors[0].id),\n302\t      `unexpected ${errors[0].id}`\n303\t    )\n304\t  } finally {\n305\t    clean(root)\n306\t  }\n307\t})\n308\t"}]},"parent_tool_use_id":null,"session_id":"1bfc3824-4f07-451d-8f74-61b35b0110d8","uuid":"88e98406-456b-49a0-9982-0c273f6469c1","timestamp":"2026-11-07T17:14:26.948Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\002\\test\\unit\\frozen-files.test.mjs","content":"import test from 'node:test'\nimport assert from 'node:assert/strict'\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\n\nimport { checkFrozenFiles } from '../../scripts/check-frozen-files.mjs'\nimport { checkRepros, reproSha256 } from '../../scripts/check-defects.mjs'\n\nconst COPY = 'test/fixtures/characterization/v0.1/'\nconst STABLE = 'test/characterization/stable.test.mjs'\nconst SELECT = `${COPY}lib/select.mjs`\n\nfunction digest(text) {\n  return crypto.createHash('sha256').update(text, 'utf8').digest('hex')\n}\n\nfunction entry(rel, text) {\n  return { path: rel, sha256: digest(text) }\n}\n\nfunction tempRoot() {\n  return fs.mkdtempSync(path.join(os.tmpdir(), 'cw-frozen-unit-'))\n}\n\nfunction write(root, rel, text) {\n  const file = path.join(root, ...rel.split('/'))\n  fs.mkdirSync(path.dirname(file), { recursive: true })\n  fs.writeFileSync(file, text)\n  return file\n}\n\nfunction copyFiles() {\n  return {\n    [SELECT]: \"export const level = 'Quick'\\n\",\n    [`${COPY}config/cliworker.example.json`]: '{\"providers\":{}}\\n',\n    [STABLE]: \"test('[AC-005] stable: placeholder', () => {})\\n\",\n  }\n}\n\nfunction manifestRoot(files, registered) {\n  const root = tempRoot()\n  for (const [rel, text] of Object.entries(files)) write(root, rel, text)\n  const manifest = { source_commit: 'f75bb76', files: registered }\n  write(root, 'test/characterization/frozen-files.json', JSON.stringify(manifest, null, 2) + '\\n')\n  return root\n}\n\nfunction registeredFrom(files, extras = []) {\n  return [...Object.keys(files).map((rel) => entry(rel, files[rel])), ...extras]\n}\n\nfunction clean(root) {\n  fs.rmSync(root, { recursive: true, force: true })\n}\n\nconst ZERO = '0'.repeat(64)\n\nconst MINI_REPRO = [\n  \"import test from 'node:test'\",\n  \"import assert from 'node:assert/strict'\",\n  \"import path from 'node:path'\",\n  \"import { pathToFileURL } from 'node:url'\",\n  '',\n  \"test('[repro] mini defect is present', async () => {\",\n  \"  const mod = await import(pathToFileURL(path.join(process.env.CLIWORKER_V01_ROOT, 'lib', 'select.mjs')).href)\",\n  \"  assert.equal(mod.BROKEN, true)\",\n  '})',\n  '',\n].join('\\n')\n\nconst ALWAYS_REPRO = [\n  \"import test from 'node:test'\",\n  \"import assert from 'node:assert/strict'\",\n  '',\n  \"test('[repro] the repro is a tautology', () => {\",\n  '  assert.ok(true)',\n  '})',\n  '',\n].join('\\n')\n\nfunction ledgerFor(repro) {\n  return {\n    id: 'mini',\n    owner_task: 'T-001',\n    owner_milestone: 'M1',\n    ac: 'AC-001',\n    repro_sha256: reproSha256(repro),\n  }\n}\n\nfunction defectRoot({ repro, copy = \"export const BROKEN = true\\n\", overlay = \"export const BROKEN = false\\n\", canary = true, edits = undefined }) {\n  const root = tempRoot()\n  write(root, SELECT, copy)\n  write(root, 'test/characterization/defects/mini.test.mjs', repro)\n  if (canary) {\n    const data = { defect: 'mini' }\n    if (edits !== undefined) data.repro_edits = edits\n    write(root, 'test/characterization/canary/mini/canary.json', JSON.stringify(data, null, 2) + '\\n')\n    if (overlay !== null) write(root, 'test/characterization/canary/mini/overlay/lib/select.mjs', overlay)\n  }\n  return root\n}\n\nfunction ids(errors) {\n  return errors.map((error) => error.id)\n}\n\ntest('[AC-005] frozen: untouched fixture root passes', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files))\n  try {\n    const { errors, count } = checkFrozenFiles({ root })\n    assert.deepEqual(errors, [])\n    assert.equal(count, 3)\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: changing one registered byte fails with frozen.hash_mismatch', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files))\n  try {\n    write(root, SELECT, \"export const level = 'High'\\n\")\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.hash_mismatch'])\n    assert.equal(errors[0].detail, SELECT)\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: CRLF checkout of a registered file still passes', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files))\n  try {\n    write(root, SELECT, files[SELECT].replace(/\\n/g, '\\r\\n'))\n    write(root, STABLE, files[STABLE].replace(/\\n/g, '\\r\\n'))\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(errors, [])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: lib/, bin/ and config/ paths are rejected as frozen.forbidden_path', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files, [\n    { path: 'lib/select.mjs', sha256: ZERO },\n    { path: 'bin/cliworker.mjs', sha256: ZERO },\n    { path: 'config/cliworker.example.json', sha256: ZERO },\n  ]))\n  try {\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.forbidden_path', 'frozen.forbidden_path', 'frozen.forbidden_path'])\n    assert.deepEqual(errors.map((error) => error.detail), [\n      'lib/select.mjs',\n      'bin/cliworker.mjs',\n      'config/cliworker.example.json',\n    ])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: scripts/ and other unlisted paths fail with frozen.outside_allowed', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files, [\n    { path: 'scripts/run-tests.mjs', sha256: ZERO },\n    { path: 'package.json', sha256: ZERO },\n  ]))\n  try {\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed'])\n    assert.deepEqual(errors.map((error) => error.detail), ['scripts/run-tests.mjs', 'package.json'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: contracts/spec and contracts/golden paths are allowed', () => {\n  const files = copyFiles()\n  files['contracts/spec/surfaces.json'] = '{}\\n'\n  files['contracts/golden/select.json'] = '{}\\n'\n  const root = manifestRoot(files, registeredFrom(files))\n  try {\n    const { errors, count } = checkFrozenFiles({ root })\n    assert.deepEqual(errors, [])\n    assert.equal(count, 5)\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: unregistered file in the v0.1 copy fails with frozen.unregistered', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files))\n  try {\n    write(root, `${COPY}README.md`, 'x\\n')\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.unregistered'])\n    assert.equal(errors[0].detail, `${COPY}README.md`)\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: missing registered file fails with frozen.file_missing', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files, [\n    { path: `${COPY}lib/forecast.mjs`, sha256: ZERO },\n  ]))\n  try {\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.file_missing'])\n    assert.equal(errors[0].detail, `${COPY}lib/forecast.mjs`)\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] frozen: path traversal and absolute paths are rejected', () => {\n  const files = copyFiles()\n  const root = manifestRoot(files, registeredFrom(files, [\n    { path: '../outside.json', sha256: ZERO },\n    { path: 'C:/tmp/outside.json', sha256: ZERO },\n    { path: 'lib\\\\select.mjs', sha256: ZERO },\n  ]))\n  try {\n    const { errors } = checkFrozenFiles({ root })\n    assert.deepEqual(ids(errors), ['frozen.outside_allowed', 'frozen.outside_allowed', 'frozen.outside_allowed'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: well-formed fixture ledger passes', () => {\n  const root = defectRoot({ repro: MINI_REPRO })\n  try {\n    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n    assert.deepEqual(errors, [])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: repro edited after registration fails with defects.repro_changed', () => {\n  const root = defectRoot({ repro: MINI_REPRO })\n  try {\n    const edited = MINI_REPRO.replace('assert.equal(mod.BROKEN, true)', 'assert.equal(mod.BROKEN, true, \"edited\")')\n    write(root, 'test/characterization/defects/mini.test.mjs', edited)\n    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n    assert.deepEqual(ids(errors), ['defects.repro_changed'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: canary that still passes fails with defects.canary_survived', () => {\n  const root = defectRoot({ repro: ALWAYS_REPRO })\n  try {\n    const { errors } = checkRepros({ root, defects: [ledgerFor(ALWAYS_REPRO)] })\n    assert.deepEqual(ids(errors), ['defects.canary_survived'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: missing canary fails with defects.canary_missing', () => {\n  const root = defectRoot({ repro: MINI_REPRO, canary: false })\n  try {\n    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n    assert.deepEqual(ids(errors), ['defects.canary_missing'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: repro failing on the unmodified copy fails with defects.repro_baseline_failed', () => {\n  const root = defectRoot({ repro: MINI_REPRO, copy: 'export const BROKEN = false\\n' })\n  try {\n    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n    assert.deepEqual(ids(errors), ['defects.repro_baseline_failed'])\n  } finally {\n    clean(root)\n  }\n})\n\ntest('[AC-005] defects: a repro that cannot even load is not counted as a canary hit', () => {\n  const root = defectRoot({\n    repro: MINI_REPRO,\n    overlay: null,\n    edits: [{ find: 'assert.equal(mod.BROKEN, true)', replace: 'assert.equal(mod.BROKEN,' }],\n  })\n  try {\n    const { errors } = checkRepros({ root, defects: [ledgerFor(MINI_REPRO)] })\n    assert.ok(errors.length > 0)\n    assert.ok(\n      ['defects.canary_survived', 'defects.canary_error'].includes(errors[0].id),\n      `unexpected ${errors[0].id}`\n    )\n  } finally {\n    clean(root)\n  }\n})\n","numLines":308,"startLine":1,"totalLines":308}},"tool_result_meta":[{"id":"toolu_017pmxVpjnDC6ZS1PUzN3UFG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
