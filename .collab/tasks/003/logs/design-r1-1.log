{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012TVx17aJwAA69cqG6tZdww","type":"tool_result","content":"#!/usr/bin/env node\r\nimport '../lib/cli.mjs'\r\nimport { spawnSync } from 'node:child_process'\r\n\r\nfunction run(command, args, timeout = 20_000) {\r\n  try {\r\n    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\r\n    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\r\n  } catch (e) {\r\n    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\r\n  }\r\n}\r\n\r\nexport function checkProvider(provider, { probe = true } = {}) {\r\n  const cli = provider.cli\r\n  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\r\n  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\r\n  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\r\n  const v = run(cli, versionArgs)\r\n  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\r\n  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\r\n  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\r\n  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\r\n  const auth = run(cli, [...prefix, ...provider.auth_args])\r\n  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\r\n  const ok = auth.ok && (\r\n    !provider.auth_ok ||\r\n    text.includes(String(provider.auth_ok).toLowerCase()) ||\r\n    /\"loggedin\"\\s*:\\s*true/.test(text) ||\r\n    /\\blogged in\\b/.test(text)\r\n  )\r\n  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\r\n}\r\n\r\nexport function providerStatus(config, opts = {}) {\r\n  const out = {}\r\n  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\r\n  return out\r\n}\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\n\r\nexport const SCHEMA = 'cliworker.config/v1'\r\n\r\nexport function defaultHome() {\r\n  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\r\n}\r\n\r\nexport function loadConfig({ file } = {}) {\r\n  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\r\n  let raw\r\n  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\r\n    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\r\n    error.code = 'E_CONFIG'\r\n    throw error\r\n  }\r\n  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\r\n  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\r\n  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\r\n  return { ...raw, _file: root, _home: defaultHome() }\r\n}\r\n\r\nexport function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\r\n\r\nexport function readUsage(file) {\r\n  try {\r\n    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\r\n  } catch { return [] }\r\n}\r\n\r\nexport function appendUsage(file, row) {\r\n  ensureDir(path.dirname(file))\r\n  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\r\n}\r\nexport const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\r\n\r\nexport function normalizePrices(m = {}) {\r\n  const p = m.prices || {}\r\n  return {\r\n    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\r\n    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\r\n  }\r\n}\r\n\r\nexport function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\r\n  const p = { ...DEFAULT_PRICES, ...prices }\r\n  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\r\n}\r\n\r\n/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\r\nexport function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\r\n  const rows = records.filter((r) => !model || r.model === model)\r\n  const samples = rows.map((r) => ({\r\n    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\r\n    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\r\n  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\r\n  if (!samples.length) {\r\n    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\r\n  }\r\n  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\r\n  const use = recent.length ? recent : samples.slice(-10)\r\n  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\r\n  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\r\n  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\r\n  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\r\n  let tasksLeft = null\r\n  let etaHours = null\r\n  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\r\n    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\r\n    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\r\n  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\r\n    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\r\n  }\r\n  const confidence = use.length >= 5 ? 'medium' : 'low'\r\n  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\r\n  return {\r\n    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\r\n    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\r\n    confidence, risk,\r\n  }\r\n}\r\n\r\nfunction round(n) { return Math.round(n * 1e6) / 1e6 }\r\nimport { normalizePrices, forecast } from './forecast.mjs'\r\n\r\nexport const SCHEMA = 'cliworker.selection/v1'\r\nexport const LEVELS = ['Top', 'High', 'Middle', 'Quick']\r\nexport const USAGES = ['Heavy', 'Normal', 'Light']\r\n\r\nfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\r\nfunction normLevel(v) {\r\n  const s = String(v || '').trim().toLowerCase()\r\n  return LEVELS.find((x) => x.toLowerCase() === s) || null\r\n}\r\nfunction normUsage(v) {\r\n  const s = String(v || '').trim().toLowerCase()\r\n  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\r\n}\r\n\r\nfunction vendorOf(provider) {\r\n  const p = String(provider || '').toLowerCase()\r\n  if (p.includes('claude')) return 'anthropic'\r\n  if (p.includes('codex') || p.includes('openai')) return 'openai'\r\n  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\r\n  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\r\n  if (p.includes('gemini') || p.includes('google')) return 'google'\r\n  return p\r\n}\r\n\r\nfunction levelOf(m) {\r\n  if (m.level && LEVELS.includes(m.level)) return m.level\r\n  if (m.tier === 'top') return 'Top'\r\n  if (m.tier === 'advanced') return 'High'\r\n  if (m.tier === 'standard') return 'Middle'\r\n  return 'Quick'\r\n}\r\n\r\nfunction cliCall(config, model, request) {\r\n  const p = config.providers?.[model.provider] || {}\r\n