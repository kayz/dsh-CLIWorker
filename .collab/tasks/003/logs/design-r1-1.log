ra.join('|') || '-'})`\n      )\n    }\n\n    if (typeof entry.owner !== 'string' || !/^T-\\d{3}$/.test(entry.owner)) {\n      push('index.owner', entry.ac, 'owner must match ^T-\\\\d{3}$')\n    }\n    if (!MILESTONES.includes(entry.milestone)) {\n      push('index.milestone', entry.ac, `milestone must be one of ${MILESTONES.join(',')}`)\n    }\n\n    if (!isStringArray(entry.levels) || entry.levels.length === 0) {\n      push('index.levels', entry.ac, 'levels must be a non-empty array of strings')\n    } else {\n      const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\n7f655f7 chore(002): mark merged after human permission\ne9b135f merge: task/002 (human permission: 允许合并，之后task合并不需要显式提示，直接处理)\n36ffd42 chore(002): pr_open state\n001\n002\n003\n004\n005\n006\n007\n008\n009\n010\n011\n012\n013\n014\n015\n016\n017\n018\n019\n020\n021\n022\n023\n031\n032\n033\n{\n  \"id\": \"003\",\n  \"history\": [\n    {\n      \"at\": \"2026-11-07T17:25:45.633Z\",\n      \"to\": \"draft\",\n      \"by\": \"init\"\n    }\n  ],\n  \"status\": \"draft\",\n  \"updated_at\": \"2026-11-07T17:25:45.633Z\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01N1qaHC5AxpAhtwPeWJCBbg","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
