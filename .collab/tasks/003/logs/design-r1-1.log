{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CWSYEL666gyk1wqWYomPcz","type":"tool_result","content":"#!/usr/bin/env node\r\n// Test runner: enumerates test files, runs them with node:test, and verifies that the\r\n// files the reporter saw match the files we enumerated (full runs only).\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport crypto from 'node:crypto'\r\nimport { spawn } from 'node:child_process'\r\nimport { fileURLToPath, pathToFileURL } from 'node:url'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst REPO_ROOT = path.resolve(HERE, '..')\r\nconst REPORTER = pathToFileURL(path.join(HERE, 'reporters', 'files.mjs')).href\r\nconst MANIFEST_NAME = 'files-executed.json'\r\nconst SKIPS_NAME = 'skips.jsonl'\r\nconst AC_PATTERN = /^AC-\\d{3}$/\r\nconst MAX_ARG_CHARS = 24000\r\n\r\nconst TEST_DIRS = ['unit', 'integration', 'contract', 'e2e', 'smoke', 'characterization', 'flows']\r\nconst EXCLUDED_TOP = new Set(['fixtures', 'helpers', 'perf'])\r\n\r\nconst USAGE =\r\n  'usage: node scripts/run-tests.mjs [--ac AC-nnn]... [--root <dir>] [--out-dir <dir>] [--perf] [--update-snapshots]'\r\n\r\nfunction toPosix(value) {\r\n  return value.split(path.sep).join('/')\r\n}\r\n\r\nfunction walkFiles(dir, onFile) {\r\n  let entries\r\n  try {\r\n    entries = fs.readdirSync(dir, { withFileTypes: true })\r\n  } catch {\r\n    return\r\n  }\r\n  for (const entry of entries) {\r\n    const full = path.join(dir, entry.name)\r\n    if (entry.isDirectory()) walkFiles(full, onFile)\r\n    else if (entry.isFile()) onFile(full)\r\n  }\r\n}\r\n\r\nexport function enumerateTestFiles(root) {\r\n  const base = path.resolve(root)\r\n  const found = []\r\n  for (const name of TEST_DIRS) {\r\n    const start = path.join(base, 'test', name)\r\n    let stat\r\n    try {\r\n      stat = fs.statSync(start)\r\n    } catch {\r\n      continue\r\n    }\r\n    if (!stat.isDirectory()) continue\r\n    walkFiles(start, (file) => {\r\n      if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n    })\r\n  }\r\n  return [...new Set(found)].sort()\r\n}\r\n\r\nexport function enumeratePerfFiles(root) {\r\n  const base = path.resolve(root)\r\n  const start = path.join(base, 'test', 'perf')\r\n  try {\r\n    if (!fs.statSync(start).isDirectory()) return []\r\n  } catch {\r\n    return []\r\n  }\r\n  const found = []\r\n  walkFiles(start, (file) => {\r\n    if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n  })\r\n  return [...new Set(found)].sort()\r\n}\r\n\r\nexport function findOrphans(root) {\r\n  const base = path.resolve(root)\r\n  const testDir = path.join(base, 'test')\r\n  let entries\r\n  try {\r\n    entries = fs.readdirSync(testDir, { withFileTypes: true })\r\n  } catch {\r\n    return []\r\n  }\r\n\r\n  const all = []\r\n  for (const entry of entries) {\r\n    if (entry.isDirectory()) {\r\n      if (EXCLUDED_TOP.has(entry.name)) continue\r\n      walkFiles(path.join(testDir, entry.name), (file) => {\r\n        if (file.endsWith('.test.mjs')) all.push(file)\r\n      })\r\n    } else if (entry.isFile() && entry.name.endsWith('.test.mjs')) {\r\n      all.push(path.join(testDir, entry.name))\r\n    }\r\n  }\r\n\r\n  const enumerated = new Set(enumerateTestFiles(base))\r\n  return [...new Set(all.map((file) => toPosix(path.relative(base, file))))]\r\n    .filter((file) => !enumerated.has(file))\r\n    .sort()\r\n}\r\n\r\nexport function verifyFullRun({ enumerated, manifest }) {\r\n  const errors = []\r\n  const files = Array.isArray(manifest?.files) ? manifest.files : []\r\n  if (!manifest || manifest.mode !== 'full') {\r\n    errors.push({ id: 'discovery.mode_not_full', path: manifest?.mode ?? 'missing' })\r\n  }\r\n\r\n  const reported = new Set(files)\r\n  for (const file of enumerated) {\r\n    if (!reported.has(file)) errors.push({ id: 'discovery.missing', path: file })\r\n  }\r\n\r\n  const expected = new Set(enumerated)\r\n  for (const file of files) {\r\n    if (!expected.has(file)) errors.push({ id: 'discovery.unexpected', path: file })\r\n  }\r\n\r\n  if (enumerated.length === 0) errors.push({ id: 'discovery.no_files', path: '' })\r\n\r\n  return { ok: errors.length === 0, errors }\r\n}\r\n\r\nfunction normalizePath(value) {\r\n  const resolved = path.resolve(value).replace(/[\\\\/]+$/, '')\r\n  return process.platform === 'win32' ? resolved.toLowerCase() : resolved\r\n}\r\n\r\nfunction defaultOutDir(root) {\r\n  const key = process.platform === 'win32' ? root.toLowerCase() : root\r\n  const hash = crypto.createHash('sha256').update(key).digest('hex').slice(0, 12)\r\n  return path.join(os.tmpdir(), 'cliworker-test-results', hash)\r\n}\r\n\r\nfunction usageError(message) {\r\n  process.stderr.write(`${message}\\n${USAGE}\\n`)\r\n  process.exitCode = 2\r\n}\r\n\r\nfunction parseArgs(argv) {\r\n  const options = { acs: [], root: REPO_ROOT, outDir: null, perf: false, updateSnapshots: false }\r\n  for (let i = 0; i < argv.length; i += 1) {\r\n    const flag = argv[i]\r\n    if (flag === '--ac') {\r\n      const value = argv[i + 1]\r\n      if (typeof value !== 'string' || !AC_PATTERN.test(value)) {\r\n        return { error: `--ac requires a value matching ^AC-\\\\d{3}$ (got ${JSON.stringify(value ?? null)})` }\r\n{\r\n  \"task\": \"T-001\",\r\n  \"milestone\": \"M1\",\r\n  \"entries\": [\r\n    { \"ac\": \"AC-001\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-002\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-003\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-004\", \"status\": \"covered\", \"files\": [\"test/unit/traceability.test.mjs\"] },\r\n    { \"ac\": \"AC-074\", \"status\": \"covered\", \"files\": [\"test/unit/milestone-gate.test.mjs\"] }\r\n  ]\r\n}\r\n{\r\n  \"task\": \"T-002\",\r\n  \"milestone\": \"M1\",\r\n  \"entries\": [\r\n    {\r\n      \"ac\": \"AC-005\",\r\n      \"status\": \"covered\",\r\n      \"files\": [\"test/characterization/stable.test.mjs\", \"test/unit/frozen-files.test.mjs\"]\r\n    }\r\n  ]\r\n}\r\n[{\"ac\":\"AC-006\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-007\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-008\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"contract\",\"integration\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-072\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]}]\n[\n {\n  \"id\": \"AC-006\",\n  \"text\": \"在子进程中 import lib/cli.mjs 与 lib/index.js：stdout 和 stderr 都是 0 字节，退出码 0。main(argv, ctx) 返回 {exitCode}，输出写入 ctx.stdout。lib 下没有任何 process.exit。\",\n  \"levels\": [\n   \"unit\"\n  ]\n },\n {\n  \"id\": \"AC-007\",\n  \"text\": \"check-seams 断言：lib 下只有 lib/exec.mjs 导入 node:child_process；只有 lib/context.mjs、lib/store.mjs、lib/fsx.mjs 导入 node:fs；不带参数的 Date.now、new Date、全局 setTimeout、setInterval、setImmediate 与 node:timers 只出现在 lib/context.mjs。test/fixtures/seams 下每类违规样例都被报出。\",\n  \"levels\": [\n   \"unit\"\n  ]\n },\n {\n  \"id\": \"AC-008\",\n  \"text\": \"宿主 stub 通过 contracts/host/dsh-host.v1.json 的契约测试。createPlugin 返回已注册路径列表。stub 的 register 抛错时：report.errors 非空，getRegistration().status 为 failed；strict:true 时 apply 抛出；任何情况下都不能只把错误写进 console 就当通过。\",\n  \"levels\": [\n   \"contract\",\n   \"integration\"\n  ]\n },\n {\n  \"id\": \"AC-072\",\n  \"text\": \"时钟：contracts/context/context.v1.json 描述 ctx 接口面，test/helpers/ctx.mjs 与 createContext 都符合它。伪时钟：advance(1000) 前后两次 now() 恰差 1000；setNow 可前后设置；经 clock.setTimeout 注册的回调按到期时间、相同时按注册顺序在 advance 中触发，未到期的不触发，pending() 计数正确；clock.sleep 只在 advance 后完成。真实 createContext 在设置 CLIWORKER_TEST_CLOCK_FILE 时 now() 返回文件中的值，且每次调用都重新读取；此时 main() 输出的 warnings 含 W_TEST_CLOCK；未设置时不出现该警告。\",\n  \"levels\": [\n   \"unit\"\n  ]\n }\n]\n// Platform gating helpers shared by tests. Skip records use cliworker.skip/v1.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport test from 'node:test'\r\nimport vm from 'node:vm'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nfunction pathExtensions() {\r\n  if (process.platform !== 'win32') return ['']\r\n  const raw = process.env.PATHEXT || '.COM;.EXE;.BAT;.CMD'\r\n  return raw.split(';').filter((item) => item.length > 0)\r\n}\r\n\r\nfunction which(binary) {\r\n  const dirs = (process.env.PATH || '').split(path.delimiter)\r\n  const candidates = new Set([binary.toLowerCase()])\r\n  for (const ext of pathExtensions()) candidates.add(`${binary}${ext}`.toLowerCase())\r\n\r\n  for (const dir of dirs) {\r\n    if (!dir) continue\r\n    for (const name of candidates) {\r\n      const candidate = path.join(dir, name)\r\n      if (fs.existsSync(candidate)) return candidate\r\n    }\r\n    // Windows app execution aliases (for example the PowerShell store alias) are reparse\r\n    // points that reject stat with EACCES, so existsSync cannot see them; the directory\r\n    // listing still can. This keeps the probe child-process free.\r\n    let entries\r\n    try {\r\n      entries = fs.readdirSync(dir)\r\nimport test from 'node:test'\r\nimport assert from 'node:assert/strict'\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport { selectModels, listModels } from '../../lib/select.mjs'\r\nimport { forecast, estimateCost } from '../../lib/forecast.mjs'\r\n\r\nfunction config() {\r\n  return {\r\n    providers: {\r\n      claude: { cli: 'claude', adapter: 'claude', readonly: true },\r\n      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\r\n      codex: { cli: 'codex', adapter: 'codex', readonly: true },\r\n    },\r\n    models: {\r\n      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\r\n      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\r\n      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\r\n      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\r\n    },\r\n    quotas: {},\r\n  }\r\n}\r\n\r\ntest('deprecated and unverified models never enter candidates', () => {\r\n  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\r\n  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\r\n  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\r\n  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\r\n  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\r\n})\r\n\r\ntest('read-only requirement rejects providers without it', () => {\r\n  const c = config()\r\n  c.models.b.readonly = false\r\n  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\r\n  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\r\n  assert.deepEqual(r.models.map((m) => m.key), ['a'])\r\n  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\r\n#!/usr/bin/env node\r\n// Runs every scripts/check-*.mjs in code point order (never itself) and then the full test run.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport { spawnSync } from 'node:child_process'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst STEP_PATTERN = /^check-.*\\.mjs$/\r\nconst SELF = 'check-fast.mjs'\r\n\r\nfunction out(text) {\r\n  fs.writeSync(1, text)\r\n}\r\n\r\nfunction err(text) {\r\n  fs.writeSync(2, text)\r\n}\r\n\r\nfunction byCodePoint(a, b) {\r\n  if (a < b) return -1\r\n  if (a > b) return 1\r\n  return 0\r\n}\r\n\r\nfunction stepFailed(label, result) {\r\n  const code = result.status === null ? 1 : result.status\r\n  err(`check-fast: FAILED step ${label} (exit ${code})\\n`)\r\n  process.exitCode = code\r\n}\r\n\r\nfunction main() {\r\n  const injected = Boolean(process.env.CLIWORKER_TEST_CHECK_DIR || process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n  const dir = process.env.CLIWORKER_TEST_CHECK_DIR\r\n    ? path.resolve(process.env.CLIWORKER_TEST_CHECK_DIR)\r\n    : HERE\r\n  const finalScript = process.env.CLIWORKER_TEST_FINAL_SCRIPT\r\n    ? path.resolve(process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n    : path.join(dir, 'run-tests.mjs')\r\n  const cwd = path.dirname(dir)\r\n\r\n  if (injected) err('check-fast: test injection active\\n')\r\n\r\n  let names = []\r\n  try {\r\n    names = fs.readdirSync(dir)\r\n  } catch {\r\n    names = []\r\n  }\r\n\r\n  const steps = names\r\n    .filter((name) => STEP_PATTERN.test(name) && name !== SELF)\r\n    .filter((name) => {\r\n      try {\r\n        return fs.statSync(path.join(dir, name)).isFile()\r\n      } catch {\r\n        return false\r\n      }\r\n    })\r\n    .sort(byCodePoint)","is_error":false}]},"parent_tool_use_id":null,"session_id":"968a671c-e7bc-4832-861d-29a316e848a4","uuid":"f7d60031-88f2-4b1b-9162-1d5ddcbafb31","timestamp":"2026-11-07T17:26:05.062Z","tool_use_result":{"stdout":"#!/usr/bin/env node\r\n// Test runner: enumerates test files, runs them with node:test, and verifies that the\r\n// files the reporter saw match the files we enumerated (full runs only).\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport crypto from 'node:crypto'\r\nimport { spawn } from 'node:child_process'\r\nimport { fileURLToPath, pathToFileURL } from 'node:url'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst REPO_ROOT = path.resolve(HERE, '..')\r\nconst REPORTER = pathToFileURL(path.join(HERE, 'reporters', 'files.mjs')).href\r\nconst MANIFEST_NAME = 'files-executed.json'\r\nconst SKIPS_NAME = 'skips.jsonl'\r\nconst AC_PATTERN = /^AC-\\d{3}$/\r\nconst MAX_ARG_CHARS = 24000\r\n\r\nconst TEST_DIRS = ['unit', 'integration', 'contract', 'e2e', 'smoke', 'characterization', 'flows']\r\nconst EXCLUDED_TOP = new Set(['fixtures', 'helpers', 'perf'])\r\n\r\nconst USAGE =\r\n  'usage: node scripts/run-tests.mjs [--ac AC-nnn]... [--root <dir>] [--out-dir <dir>] [--perf] [--update-snapshots]'\r\n\r\nfunction toPosix(value) {\r\n  return value.split(path.sep).join('/')\r\n}\r\n\r\nfunction walkFiles(dir, onFile) {\r\n  let entries\r\n  try {\r\n    entries = fs.readdirSync(dir, { withFileTypes: true })\r\n  } catch {\r\n    return\r\n  }\r\n  for (const entry of entries) {\r\n    const full = path.join(dir, entry.name)\r\n    if (entry.isDirectory()) walkFiles(full, onFile)\r\n    else if (entry.isFile()) onFile(full)\r\n  }\r\n}\r\n\r\nexport function enumerateTestFiles(root) {\r\n  const base = path.resolve(root)\r\n  const found = []\r\n  for (const name of TEST_DIRS) {\r\n    const start = path.join(base, 'test', name)\r\n    let stat\r\n    try {\r\n      stat = fs.statSync(start)\r\n    } catch {\r\n      continue\r\n    }\r\n    if (!stat.isDirectory()) continue\r\n    walkFiles(start, (file) => {\r\n      if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n    })\r\n  }\r\n  return [...new Set(found)].sort()\r\n}\r\n\r\nexport function enumeratePerfFiles(root) {\r\n  const base = path.resolve(root)\r\n  const start = path.join(base, 'test', 'perf')\r\n  try {\r\n    if (!fs.statSync(start).isDirectory()) return []\r\n  } catch {\r\n    return []\r\n  }\r\n  const found = []\r\n  walkFiles(start, (file) => {\r\n    if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\r\n  })\r\n  return [...new Set(found)].sort()\r\n}\r\n\r\nexport function findOrphans(root) {\r\n  const base = path.resolve(root)\r\n  const testDir = path.join(base, 'test')\r\n  let entries\r\n  try {\r\n    entries = fs.readdirSync(testDir, { withFileTypes: true })\r\n  } catch {\r\n    return []\r\n  }\r\n\r\n  const all = []\r\n  for (const entry of entries) {\r\n    if (entry.isDirectory()) {\r\n      if (EXCLUDED_TOP.has(entry.name)) continue\r\n      walkFiles(path.join(testDir, entry.name), (file) => {\r\n        if (file.endsWith('.test.mjs')) all.push(file)\r\n      })\r\n    } else if (entry.isFile() && entry.name.endsWith('.test.mjs')) {\r\n      all.push(path.join(testDir, entry.name))\r\n    }\r\n  }\r\n\r\n  const enumerated = new Set(enumerateTestFiles(base))\r\n  return [...new Set(all.map((file) => toPosix(path.relative(base, file))))]\r\n    .filter((file) => !enumerated.has(file))\r\n    .sort()\r\n}\r\n\r\nexport function verifyFullRun({ enumerated, manifest }) {\r\n  const errors = []\r\n  const files = Array.isArray(manifest?.files) ? manifest.files : []\r\n  if (!manifest || manifest.mode !== 'full') {\r\n    errors.push({ id: 'discovery.mode_not_full', path: manifest?.mode ?? 'missing' })\r\n  }\r\n\r\n  const reported = new Set(files)\r\n  for (const file of enumerated) {\r\n    if (!reported.has(file)) errors.push({ id: 'discovery.missing', path: file })\r\n  }\r\n\r\n  const expected = new Set(enumerated)\r\n  for (const file of files) {\r\n    if (!expected.has(file)) errors.push({ id: 'discovery.unexpected', path: file })\r\n  }\r\n\r\n  if (enumerated.length === 0) errors.push({ id: 'discovery.no_files', path: '' })\r\n\r\n  return { ok: errors.length === 0, errors }\r\n}\r\n\r\nfunction normalizePath(value) {\r\n  const resolved = path.resolve(value).replace(/[\\\\/]+$/, '')\r\n  return process.platform === 'win32' ? resolved.toLowerCase() : resolved\r\n}\r\n\r\nfunction defaultOutDir(root) {\r\n  const key = process.platform === 'win32' ? root.toLowerCase() : root\r\n  const hash = crypto.createHash('sha256').update(key).digest('hex').slice(0, 12)\r\n  return path.join(os.tmpdir(), 'cliworker-test-results', hash)\r\n}\r\n\r\nfunction usageError(message) {\r\n  process.stderr.write(`${message}\\n${USAGE}\\n`)\r\n  process.exitCode = 2\r\n}\r\n\r\nfunction parseArgs(argv) {\r\n  const options = { acs: [], root: REPO_ROOT, outDir: null, perf: false, updateSnapshots: false }\r\n  for (let i = 0; i < argv.length; i += 1) {\r\n    const flag = argv[i]\r\n    if (flag === '--ac') {\r\n      const value = argv[i + 1]\r\n      if (typeof value !== 'string' || !AC_PATTERN.test(value)) {\r\n        return { error: `--ac requires a value matching ^AC-\\\\d{3}$ (got ${JSON.stringify(value ?? null)})` }\r\n{\r\n  \"task\": \"T-001\",\r\n  \"milestone\": \"M1\",\r\n  \"entries\": [\r\n    { \"ac\": \"AC-001\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-002\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-003\", \"status\": \"covered\", \"files\": [\"test/unit/runner-selftest.test.mjs\"] },\r\n    { \"ac\": \"AC-004\", \"status\": \"covered\", \"files\": [\"test/unit/traceability.test.mjs\"] },\r\n    { \"ac\": \"AC-074\", \"status\": \"covered\", \"files\": [\"test/unit/milestone-gate.test.mjs\"] }\r\n  ]\r\n}\r\n{\r\n  \"task\": \"T-002\",\r\n  \"milestone\": \"M1\",\r\n  \"entries\": [\r\n    {\r\n      \"ac\": \"AC-005\",\r\n      \"status\": \"covered\",\r\n      \"files\": [\"test/characterization/stable.test.mjs\", \"test/unit/frozen-files.test.mjs\"]\r\n    }\r\n  ]\r\n}\r\n[{\"ac\":\"AC-006\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-007\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-008\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"contract\",\"integration\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]},{\"ac\":\"AC-072\",\"owner\":\"T-003\",\"milestone\":\"M1\",\"levels\":[\"unit\"],\"baseline\":[\"darwin\",\"linux\",\"win32\"]}]\n[\n {\n  \"id\": \"AC-006\",\n  \"text\": \"在子进程中 import lib/cli.mjs 与 lib/index.js：stdout 和 stderr 都是 0 字节，退出码 0。main(argv, ctx) 返回 {exitCode}，输出写入 ctx.stdout。lib 下没有任何 process.exit。\",\n  \"levels\": [\n   \"unit\"\n  ]\n },\n {\n  \"id\": \"AC-007\",\n  \"text\": \"check-seams 断言：lib 下只有 lib/exec.mjs 导入 node:child_process；只有 lib/context.mjs、lib/store.mjs、lib/fsx.mjs 导入 node:fs；不带参数的 Date.now、new Date、全局 setTimeout、setInterval、setImmediate 与 node:timers 只出现在 lib/context.mjs。test/fixtures/seams 下每类违规样例都被报出。\",\n  \"levels\": [\n   \"unit\"\n  ]\n },\n {\n  \"id\": \"AC-008\",\n  \"text\": \"宿主 stub 通过 contracts/host/dsh-host.v1.json 的契约测试。createPlugin 返回已注册路径列表。stub 的 register 抛错时：report.errors 非空，getRegistration().status 为 failed；strict:true 时 apply 抛出；任何情况下都不能只把错误写进 console 就当通过。\",\n  \"levels\": [\n   \"contract\",\n   \"integration\"\n  ]\n },\n {\n  \"id\": \"AC-072\",\n  \"text\": \"时钟：contracts/context/context.v1.json 描述 ctx 接口面，test/helpers/ctx.mjs 与 createContext 都符合它。伪时钟：advance(1000) 前后两次 now() 恰差 1000；setNow 可前后设置；经 clock.setTimeout 注册的回调按到期时间、相同时按注册顺序在 advance 中触发，未到期的不触发，pending() 计数正确；clock.sleep 只在 advance 后完成。真实 createContext 在设置 CLIWORKER_TEST_CLOCK_FILE 时 now() 返回文件中的值，且每次调用都重新读取；此时 main() 输出的 warnings 含 W_TEST_CLOCK；未设置时不出现该警告。\",\n  \"levels\": [\n   \"unit\"\n  ]\n }\n]\n// Platform gating helpers shared by tests. Skip records use cliworker.skip/v1.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport test from 'node:test'\r\nimport vm from 'node:vm'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nfunction pathExtensions() {\r\n  if (process.platform !== 'win32') return ['']\r\n  const raw = process.env.PATHEXT || '.COM;.EXE;.BAT;.CMD'\r\n  return raw.split(';').filter((item) => item.length > 0)\r\n}\r\n\r\nfunction which(binary) {\r\n  const dirs = (process.env.PATH || '').split(path.delimiter)\r\n  const candidates = new Set([binary.toLowerCase()])\r\n  for (const ext of pathExtensions()) candidates.add(`${binary}${ext}`.toLowerCase())\r\n\r\n  for (const dir of dirs) {\r\n    if (!dir) continue\r\n    for (const name of candidates) {\r\n      const candidate = path.join(dir, name)\r\n      if (fs.existsSync(candidate)) return candidate\r\n    }\r\n    // Windows app execution aliases (for example the PowerShell store alias) are reparse\r\n    // points that reject stat with EACCES, so existsSync cannot see them; the directory\r\n    // listing still can. This keeps the probe child-process free.\r\n    let entries\r\n    try {\r\n      entries = fs.readdirSync(dir)\r\nimport test from 'node:test'\r\nimport assert from 'node:assert/strict'\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport { selectModels, listModels } from '../../lib/select.mjs'\r\nimport { forecast, estimateCost } from '../../lib/forecast.mjs'\r\n\r\nfunction config() {\r\n  return {\r\n    providers: {\r\n      claude: { cli: 'claude', adapter: 'claude', readonly: true },\r\n      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\r\n      codex: { cli: 'codex', adapter: 'codex', readonly: true },\r\n    },\r\n    models: {\r\n      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\r\n      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\r\n      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\r\n      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\r\n    },\r\n    quotas: {},\r\n  }\r\n}\r\n\r\ntest('deprecated and unverified models never enter candidates', () => {\r\n  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\r\n  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\r\n  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\r\n  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\r\n  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\r\n})\r\n\r\ntest('read-only requirement rejects providers without it', () => {\r\n  const c = config()\r\n  c.models.b.readonly = false\r\n  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\r\n  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\r\n  assert.deepEqual(r.models.map((m) => m.key), ['a'])\r\n  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\r\n#!/usr/bin/env node\r\n// Runs every scripts/check-*.mjs in code point order (never itself) and then the full test run.\r\nimport fs from 'node:fs'\r\nimport path from 'node:path'\r\nimport { spawnSync } from 'node:child_process'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst STEP_PATTERN = /^check-.*\\.mjs$/\r\nconst SELF = 'check-fast.mjs'\r\n\r\nfunction out(text) {\r\n  fs.writeSync(1, text)\r\n}\r\n\r\nfunction err(text) {\r\n  fs.writeSync(2, text)\r\n}\r\n\r\nfunction byCodePoint(a, b) {\r\n  if (a < b) return -1\r\n  if (a > b) return 1\r\n  return 0\r\n}\r\n\r\nfunction stepFailed(label, result) {\r\n  const code = result.status === null ? 1 : result.status\r\n  err(`check-fast: FAILED step ${label} (exit ${code})\\n`)\r\n  process.exitCode = code\r\n}\r\n\r\nfunction main() {\r\n  const injected = Boolean(process.env.CLIWORKER_TEST_CHECK_DIR || process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n  const dir = process.env.CLIWORKER_TEST_CHECK_DIR\r\n    ? path.resolve(process.env.CLIWORKER_TEST_CHECK_DIR)\r\n    : HERE\r\n  const finalScript = process.env.CLIWORKER_TEST_FINAL_SCRIPT\r\n    ? path.resolve(process.env.CLIWORKER_TEST_FINAL_SCRIPT)\r\n    : path.join(dir, 'run-tests.mjs')\r\n  const cwd = path.dirname(dir)\r\n\r\n  if (injected) err('check-fast: test injection active\\n')\r\n\r\n  let names = []\r\n  try {\r\n    names = fs.readdirSync(dir)\r\n  } catch {\r\n    names = []\r\n  }\r\n\r\n  const steps = names\r\n    .filter((name) => STEP_PATTERN.test(name) && name !== SELF)\r\n    .filter((name) => {\r\n      try {\r\n        return fs.statSync(path.join(dir, name)).isFile()\r\n      } catch {\r\n        return false\r\n      }\r\n    })\r\n    .sort(byCodePoint)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CWSYEL666gyk1wqWYomPcz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
