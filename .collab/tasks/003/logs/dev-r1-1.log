trict: false, ...(settings || {}) }\n  const configPath = s.configPath || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json')\n  const getConfig = () => loadConfig({ file: configPath, ctx })\n  const fail = (p, message) => {\n    errors.push({ path: p, message })\n    ctx.stderr.write(`[cliworker] route registration failed: ${p === null ? '(inject)' : p}: ${message}\\n`)\n  }\n  const route = (httpCtx, p, name, handler) => {\n    try {\n      httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\n      registered.push(p)\n    } catch (e) { fail(p, String(e.message || e)) }\n  }\n  try {\n    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\n    hostCtx.inject(['webServer'], (httpCtx) => { ...route calls... })\n  } catch (e) { ... }\n```\n\nCareful: if inject throws, and it's an Error from inside the callback (register failure) — the callback wraps each route in try/catch so it shouldn't throw, except hostCtx.inject itself. But if failInject throws, we catch and push {path:null,...}.\n\nBut careful: if the callback throws for another reason (not route registration), we'd add null error. Acceptable.\n\nDesign says \"hostCtx.inject 本身抛错，或不是函数：errors 放一条 { path: null, message }\".\n\nNow strict: \n\n```js\nexport function apply(hostCtx, settings = {}, deps = {}) {\n  const r = createPlugin(hostCtx, settings, deps)\n  if (settings?.strict === true && r.errors.length > 0) {\n    const lines = r.errors.map(e => `${e.path === null ? '(inject)' : e.path}: ${e.message}`).join('; ')\n    const err = new Error(`cliworker: route registration failed: ${lines}`)\n    err.registration = getRegistration()\n    throw err\n  }\n}\n```\n\nDesign: \"消息以 cliworker: route registration failed 开头并列出每个 path: message\".\n\nHandlers: from old code but replacing injection points.\n\nThe providers handler: `send(res, { ok: true, providers: providerStatus(c, { ctx }) })`.\n\nNow, `settings.readonly` — old code had readonly default but never used except DEFAULTS. Design says settings take readonly (default false). We can keep it in settings but unused? It's not used in old code either. Keep the resolution but no behavior.\n\nNow, importing lib/index.js must have zero output. Note that `createContext()` at import time is not called — only in createPlugin. Good.\n\nNow contracts.\n\nNow `scripts/check-seams.mjs`.\n\nRequirements:\n- usage: `node scripts/check-seams.mjs [--root <dir>] [--json]`\n- output default: each violation `FAIL <rule> <file>:<line>`, then `check-seams: FAILED (n violations)` or `check-seams: ok (files=n)`.\n- --json: single JSON {ok, files, violations:[{rule,file,line}]}.\n- exit 0/1/2 (2 = argument error, stderr contains 'usage:').\n- export scanRoot({root}) → {files, violations}; only run when invoked directly.\n\nScan `<root>/lib/**` for .mjs/.js/.cjs.\n\nRules with regex on code with comments/strings stripped (for non-import rules), comments stripped only for import rules.\n\nImplementation:\n\nStrip comments: a simple tokenizer handling:\n- line comments `//`\n- block comments `/* */`\n- strings `'...'`, `\"...\"`, template literals with `${}`... For stripping non-import rules we need to remove string contents and template literal text but keep code inside `${}`? Design says \"先去掉注释、字符串字面量和模板字面量的文本部分再匹配，且保留换行以保证行号准确\". Simpler: remove string/template contents entirely (including `${}` expressions) but preserve newlines. That's acceptable — the clean fixture has strings mentioning Date.now and we must not report. For `${}` expressions it's a slight under-detection, fine.\n\nBut be careful about regex literals — e.g., `/Date.now/`. Not present. Skip.\n\nLet me write a scanner producing:\n- `codeNoComments` (comments removed, strings kept) — for import rules\n- `codeNoStrings` (comments + string/template text removed) — for other rules\n\nImplementation approach: single pass state machine over chars; maintain two output buffers.\n\nStates: normal, lineComment, blockComment, single, double, template.\n\nFor codeNoComments: in comments, replace chars with '' except newlines retained; strings kept as-is (need to handle escapes so that quotes inside strings don't confuse). For codeNoStrings: in strings, replace with '' except newlines.\n\nFor template literals: also need to handle `${` nesting... To keep it simple but correct for fixtures: in template, treat until matching backtick, ignoring `${}`. If a `${` contains a backtick it breaks, but our files won't.\n\nCareful: regex literals like `/[.]/` in a fixture? In lib? e.g. lib/select.mjs has `/\\d+\\.\\d+\\.\\d+/` in availability.mjs — `/.../` regex containing `//`? availability has `/\"loggedin\"\\s*:\\s*true/` and `/\\blogged in\\b/`. Our comment stripper may misinterpret `/` but only `//` starts line comment. A regex like `/\\//` would break; not present. But we must be careful with e.g. `'node:fs'` string then `//`? no.\n\nHmm, one risk: in `lib/availability.mjs` there is `.slice(0, 200)`. Fine.\n\nAnother risk: division vs regex is not an issue since we only look for `//` and `/*`.\n\nBut there IS a risk: `http://` inside a string in lib/index.js: `new URL(req.url || '/', 'http://local')` — that's inside a string, and our string handling protects it as long as we process strings before comments in left-to-right order. Since we scan left to right and enter string state when we see a quote, `//` inside the string is skipped. Good, as long as we check quote before slash.\n\nNow rules:\n\nImport-based:\n```\nseams.child_process: /\\bfrom\\s*['\"](?:node:)?child_process['\"]|import\\s*\\(\\s*['\"](?:node:)?child_process['\"]|require\\s*\\(\\s*['\"](?:node:)?child_process['\"]|^\\s*import\\s*['\"](?:node:)?child_process['\"]/m\n```\nSimpler: for each import specifier found. Better: extract specifiers from codeNoComments using a regex, then classify by specifier. That handles `import ... from 'x'`, `import 'x'`, `import('x')`, `require('x')`, `export ... from 'x'`.\n\nSpecifier regex: /(?:from|require\\s*\\(|import\\s*\\(|^\\s*import)\\s*['\"]([^'\"]+)['\"]/gm — hmm careful with `import x from 'y'`.\n\nLet me use: \n```\nconst SPEC_RE = /(?:\\bfrom|\\bimport\\s*\\(|\\brequire\\s*\\()\\s*(['\"])([^'\"]+)\\1|(?:^|[\\s;])import\\s*(['\"])([^'\"]+)\\3/g\n```\nThen line number from match index.\n\nAlternatively simpler and robust: find all quoted strings in codeNoComments, and check the specifier value. But a string 'node:fs' used elsewhere (not import) would then be flagged wrongly. Design says clean fixture has strings with `node:fs` — \"注释和字符串里写满 Date.now()、setTimeout(、node:fs、process.exit\" — for the clean case, a string containing 'node:fs' must NOT be reported. So I must associate specifiers with import syntax, not any string.\n\nSo the specifier regex must require import/require/from. But `from 'node:fs'` in the clean fixture? \"字符串里写满 node:fs\" — probably `const s = 'node:fs'`, not `from 'node:fs'`. I'll write the fixture myself, so I'll avoid `from 'x'` inside a string.\n\nCareful case: `const s = \"import fs from 'node:fs'\"` — that's a string; with codeNoComments the string content is preserved, so a naive regex would match `from 'node:fs'` inside it. To avoid, use the string-stripped version for specifier detection but then we lose the specifier text... Alternative: use codeNoStrings and extract specifiers there — specifier text is inside a string, so it'd be removed!\n\nBetter approach: build a proper token-based import detection. Let me instead extract import/require statements from codeNoStrings but with specifier values replaced by placeholders? Complicated.\n\nCleaner: scan codeNoComments with a regex that anchors on statement-ish boundaries, and additionally drop matches that are inside strings. I can compute string ranges from the scanner and exclude matches whose start index falls inside a string/comment range. That's precise.\n\nSo the scanner should record ranges: stringRanges (in original index space), commentRanges.\n\nThen import regex over the original source, filter matches whose index is inside a string or comment range.\n\nSince codeNoComments = original with comments blanked (same length? if I replace comment chars with spaces, indices are preserved!). Yes — replace with spaces (preserving newlines) keeps index alignment. \n\nSo plan: build `blanked` (comments replaced by spaces, strings intact, length preserved) and `bare` (comments and string contents replaced by spaces, length preserved). Then:\n- import matching on `blanked`, filtered by \"index not inside string range\".\n- other rules on `bare`, plus filter out matches inside comments (already blanked) — no need.\n\nActually if I match on `bare` directly, strings and comments are spaces, so matches only occur in code. \n\nFor import rules, I need the specifier. Match on `bare` won't give specifier. So match on original with the string-range filter. Since `blanked` preserves indices, matching on `blanked` and using the same indices to test ranges works.\n\nLet me just build:\n- `range` arrays: [{start, end}] for strings (including template) and comments.\n\nThen a function `insideRanges(i)`.\n\nImport specifier extraction on original source:\n```\nconst IMPORT_RE = /(\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\brequire\\s*\\(\\s*|(?:^|[;\\s])import\\s*)(['\"])([^'\"\\n]+)\\2/g\n```\nHmm group 1 plus quote. Let's do:\n```\nconst SPEC_RE = /(?:^|[\\s;(){}=])(?:import|from|require)\\s*\\(?\\s*(['\"])([^'\"\\n]+)\\1/g\n```\nThat's loose: matches `import`/`from`/`require` keywords followed by optional `(` then quote. Then filter out matches inside string ranges. But `from` as a property name like `x.from('y')` would match... unlikely.\n\nHmm, simpler robust approach: handle explicit forms with separate regexes:\n1. `/\\bfrom\\s*(['\"])([^'\"\\n]+)\\1/g` — catches `import ... from 'x'` and `export ... from 'x'`.\n2. `/\\bimport\\s*\\(\\s*(['\"])([^'\"\\n]+)\\1\\s*\\)/g` — dynamic import.\n3. `/\\brequire\\s*\\(\\s*(['\"])([^'\"\\n]+)\\1\\s*\\)/g` — require.\n4. `/^\\s*import\\s*(['\"])([^'\"\\n]+)\\1/gm` — bare import.\n\nThen filter matches not inside string/comment ranges. For form 4, `^\\s*import` at line start — a string can't contain a line start unless multiline, and template could. The range filter handles it.\n\nThat's fine.\n\nThen map specifier → rule:\n- child_process: 'node:child_process', 'child_process'\n- fs: 'node:fs', 'fs', 'node:fs/promises', 'fs/promises'\n- node_timers: 'node:timers', 'timers', 'node:timers/promises', 'timers/promises'\n\nOther rules on `bare`:\n- date_now: /Date\\.now/g\n- new_date: `new Date()` or bare `new Date` — \"不带参数的 new Date() 或 new Date；new Date(x) 不算\". Hmm \"new Date\" without parens is unusual. Rule: /new\\s+Date\\s*(\\(\\s*\\))?/ and if it's `new Date(` followed by something → not a violation. Let me implement with regex: /new\\s+Date\\b(\\s*\\()?/g then check: if paren present, check next non-space char is ')'. If paren absent → violation.\n\nActually \"new Date\" (no parens) — e.g. `const d = new Date` — that would be a violation. Implement:\n```\nconst RE = /\\bnew\\s+Date\\b/g\nfor each match: look ahead at rest = bare.slice(idx+len). If /^\\s*\\(/ test → find matching close paren with only whitespace inside → violation if empty; else not. Else violation.\n```\n- set_timeout: bare identifier setTimeout or globalThis/global/window.setTimeout; `obj.setTimeout` doesn't count.\n  Regex: /(?<![\\w$.])setTimeout\\s*\\(/ — but `globalThis.setTimeout(` should count, and `obj.setTimeout(` shouldn't. So: /(?<![\\w$])(?:globalThis|global|window)\\s*\\.\\s*setTimeout\\b|\\bsetTimeout\\s*\\(/... need to exclude `obj.setTimeout(`.\n  Use: match /([A-Za-z_$][\\w$]*\\s*\\.\\s*)*setTimeout\\b/g on bare and check prefix: if there's a member expression prefix, only allowed if the object is globalThis/global/window.\n  Simpler: two regexes:\n  - A: /(?:^|[^\\w$.])((?:globalThis|global|window)\\.setTimeout)\\b/  \n  - B: /(?:^|[^\\w$.])(setTimeout)\\b/  → but B would also match `globalThis.setTimeout` because `.` before setTimeout... no, B requires preceding char not in [\\w$.], and 'globalThis.setTimeout' has '.' before setTimeout → excluded. And `obj.setTimeout` excluded. And bare `setTimeout(` at line start or after '(' matched. \n\n  Do we require a following '('? Design says \"裸标识符 setTimeout，或 globalThis/global/window.setTimeout；obj.setTimeout 不算\". Rule name set_timeout = \"裸标识符 setTimeout\". I'll match the identifier itself regardless of call; that's fine (fixtures call it).\n\n  Careful: does B match the property definition in our own files? e.g., `clock.setTimeout` — excluded by `.`. Our lib/context.mjs has `setTimeout(fn, ms)` as object method shorthand in the returned object literal: `{ now, nowIso, setTimeout, clearTimeout, sleep }` — that's a bare identifier `setTimeout` after `, ` → would be flagged, but context.mjs is allowed. Real clock uses `setTimeout(...)` calls in context.mjs — allowed. Fine.\n\n  But `lib/commands/_util.mjs` etc must avoid. They will.\n\n- set_interval: same with setInterval.\n- set_immediate: same with setImmediate.\n- wall_clock: /performance\\.now|\\bprocess\\.hrtime\\b|\\bhrtime\\.bigint\\b/.\n- process_exit: /process\\.exit\\b/ — allowed list empty.\n\nDesign says `seams.process_exit` 无 allowed files. Note the check-seams script itself contains 'process.exit'? No, it's in scripts/, not scanned.\n\nBut wait: the script writes text `process.exit` in regex source. It's in scripts/, not lib. Fine.\n\nHmm, but one problem: my check-seams.mjs will contain the literal string 'process.exit' etc. — V-006-6 only scans lib. Fine.\n\nNow the fixtures. Each fixture needs `<case>/lib/...`. Files:\n- clean/lib/clean.mjs: uses ctx.clock.setTimeout, ctx.clock.now(), new Date(0), new Date(x), obj.setTimeout(), clearTimeout(h); comments and strings containing Date.now(), setTimeout(, node:fs, process.exit → 0 violations.\n\nCareful: in clean fixture, string containing 'node:fs' is fine but must not be preceded by `from`. Also `process.exit` in string fine.\n\nAlso must avoid `obj.setTimeout` being flagged — my regex excludes any `.setTimeout`. Good. And `clearTimeout(h)` — no rule for clearTimeout. Good.\n\n- allowed/lib/exec.mjs imports child_process; allowed/lib/context.mjs imports fs and node:timers and uses all time primitives; allowed/lib/store.mjs and allowed/lib/fsx.mjs import fs. 0 violations.\n\nCareful: context.mjs in allowed fixture importing 'node:timers' → allowed. And using `Date.now()`, `new Date()`, `setTimeout(`, `setInterval(`, `setImmediate(`. Allowed for lib/context.mjs only.\n\n- child-process/lib/exec.mjs (legal, imports child_process) + lib/bad.mjs imports node:child_process → only bad.mjs flagged.\n- fs/lib/context.mjs, store.mjs, fsx.mjs legal + bad.mjs imports node:fs/promises.\n- date-now/lib/bad.mjs calls Date.now() → only seams.date_now.\n- new-date: new Date()\n- set-timeout, set-interval, set-immediate\n- node-timers: bad.mjs imports node:timers/promises\n- wall-clock: performance.now()\n- process-exit: process.exit(1)\n\nNote V-007-3 requires for each case: violations.every(v => v.rule === rule && v.file === 'lib/bad.mjs' && v.line >= 1). So bad.mjs must produce only that rule. Careful in date-now case: `const t = Date.now()` → only date_now. Yes.\n\nFor process-exit: `process.exit(1)` → only process_exit. Good.\n\nFor node-timers: `import { setTimeout as delay } from 'node:timers/promises'` → that gives node_timers via import. But also `setTimeout` alias? The import specifier regex catches 'node:timers/promises'. Does any other rule trigger? No. But careful: the word `setTimeout` appears in `import { setTimeout as delay }` — that's an import clause, my setTimeout regex would match bare identifier `setTimeout` (preceded by space, followed by space). That would produce an extra seams.set_timeout violation → violates \"only this rule\". So in the fixture use `import timers from 'node:timers/promises'` (default import) to avoid the identifier. Good idea. Same for node-timers allowed fixture—allowed anyway.\n\nHmm, but also for `child-process` fixture: `import cp from 'node:child_process'`. Fine.\n\nFor `fs` fixture bad.mjs: `import fsp from 'node:fs/promises'`. Fine.\n\nAnd in expected output for `--root test/fixtures/seams/date-now`: exactly 2 lines with 1 violation. So the fixture must have exactly one violation.\n\nBut careful: V-007-3 also checks `j.files >= 1`.\n\nAlso note check-seams scans `<root>/lib/**` with extensions .mjs/.js/.cjs; fixtures' files are .mjs.\n\nNow, the `clean` fixture: 0 violations but must include comments/strings with violations. `j.files >= 1`.\n\nNow the test files. Six test files + traceability shard.\n\nTest counts:\n- AC-006: `✔ [AC-006]` lines at least 3 → import-safe test with ≥3 tests.\n- AC-007: at least 3.\n- AC-008: at least 5 across two files.\n- AC-072: at least 6 across clock.test.mjs and context.test.mjs.\n\nAlso `run-tests --ac` filters files by source containing `[AC-006]` etc. Both test files must contain the marker.\n\nV-008-1: \"run-tests: filtered 2 files\" — both host-stub.test.mjs and registration.test.mjs must contain '[AC-008]'.\n\nV-072-1: covers both clock.test.mjs and context.test.mjs → both contain '[AC-072]'.\n\nNow note: `test/unit/seams.test.mjs` etc. all must have `[AC-xxx]` markers.\n\nLet me also double check the `run-tests --ac AC-007` needs `✔ [AC-007]` lines at least 3 — node test spec reporter prints `✔ [AC-007] ...`.\n\nAlso V-R-1: `ℹ pass` > 70. Currently 70. We'll add plenty.\n\nAlso check-test-discovery: new test dirs are discovered automatically; findOrphans must be empty (all .test.mjs under test/unit, test/contract, test/integration).\n\nNote: fixtures under test/fixtures are excluded from orphan check (EXCLUDED_TOP has 'fixtures'). Our seam fixtures are .mjs not .test.mjs anyway.\n\nNow V-R-5 requires all changed files within write_scope. The impl.md goes to .collab/tasks/003/impl.md — excluded by `!f.startsWith('.collab/')`. Good.\n\nCareful: git diff --name-only 7f655f7 will include .collab/tasks/003/design.md (from commit 265c4c8 stage(design)) — but filtered out.\n\nNow let me check: does acceptance expect `lib/store.mjs`, `lib/fsx.mjs`? They're in check-seams allowlist only, and don't exist. Fine.\n\nNow let's check `dsh.plugin.json`, `cordis.patch.yml` — might reference apply signature. Not in write_scope; leave.\n\nLet me now check .github/workflows/ci.yml to see if it runs check-seams (not needed).\n\nNow implement. Order:\n1. lib/exec.mjs, lib/context.mjs\n2. config.mjs, availability.mjs, forecast.mjs\n3. commands, cli.mjs, bin\n4. index.js\n5. contracts\n6. helpers\n7. check-seams + fixtures\n8. tests + traceability\n\nLet me write lib/context.mjs carefully.\n\n```js\nimport fsDefault from 'node:fs'\nimport { run } from './exec.mjs'\n\nexport const TEST_CLOCK_ENV = 'CLIWORKER_TEST_CLOCK_FILE'\n\nexport function createRealClock({ env, fs } = {}) {\n  const readEnv = env || {}\n  const io = fs || fsDefault\n  return {\n    now() {\n      const file = readEnv[TEST_CLOCK_ENV]\n      if (typeof file !== 'string' || file === '') return Date.now()\n      const raw = String(io.readFileSync(file, 'utf8')).trim()\n      const value = /^-?\\d+(\\.\\d+)?$/.test(raw) ? Number(raw) : Date.parse(raw)\n      if (!Number.isFinite(value)) throw new Error(`invalid ${TEST_CLOCK_ENV} content`)\n      return value\n    },\n    nowIso() { return new Date(this.now()).toISOString() },\n    setTimeout(fn, ms) { return setTimeout(fn, ms) },\n    clearTimeout(handle) { clearTimeout(handle) },\n    sleep(ms) { return new Promise((resolve) => { setTimeout(resolve, ms) }) },\n  }\n}\n```\nCareful: `this.now()` inside nowIso — if called as `ctx.clock.nowIso()` it's fine, but if destructured it breaks. The probe calls `real.clock.nowIso()` — fine. But `ctx.now = () => clock.now()`. Safer: closure over the object:\n```js\nconst clock = { now(){...}, nowIso(){ return new Date(clock.now()).toISOString() }, ... }\nreturn clock\n```\n\nThe error message must contain CLIWORKER_TEST_CLOCK_FILE and not contain other env content. `invalid CLIWORKER_TEST_CLOCK_FILE content` works. Maybe include the path? No — \"不含环境变量里的其它内容\". Keep generic.\n\nHmm, but also readFileSync failure (ENOENT) — propagate? The probe doesn't test that. Leave as is (throws with fs error message, includes path... acceptable).\n\nWait: V-072-5 env has CLIWORKER_TEST_CLOCK_FILE '/cw/clock.txt' but no command reads clock. OK.\n\nBut careful: `createContext` with env containing the var, and `main` outputs warnings — no clock read. Good.\n\n`/^-?\\d+(\\.\\d+)?$/` — design says \"纯数字（可带小数）\". Negative? \"纯数字\" — I'll allow optional sign and decimals. Actually simpler: /^[0-9]+(\\.[0-9]+)?$/. '1000' → 1000. Use Number.isFinite check after.\n\n`systemNow()`: `createRealClock({ env: process.env, fs: fsDefault }).now()`.\n\nCareful: creating a new real clock each call is fine.\n\n`createContext(overrides = {})`:\n```js\nexport function createContext(overrides = {}) {\n  const o = overrides || {}\n  const env = 'env' in o ? o.env : process.env\n  const fs = 'fs' in o ? o.fs : fsDefault\n  const exec = 'exec' in o ? o.exec : run\n  const clock = 'clock' in o ? o.clock : createRealClock({ env, fs })\n  const ctx = {\n    exec,\n    fs,\n    fetch: 'fetch' in o ? o.fetch : (...a) => globalThis.fetch(...a),\n    env,\n    platform: 'platform' in o ? o.platform : process.platform,\n    stdout: 'stdout' in o ? o.stdout : process.stdout,\n    stderr: 'stderr' in o ? o.stderr : process.stderr,\n    random: 'random' in o ? o.random : () => Math.random(),\n    clock,\n    now: 'now' in o ? o.now : () => clock.now(),\n  }\n  return ctx\n}\n```\nMembers exactly 10 in that order (object key order doesn't matter for the probe which sorts).\n\nNote: `'env' in o` — if o.env === undefined explicitly, we'd use undefined. Use `o.env !== undefined ? o.env : process.env`? Design: \"每个成员先取 overrides 里的同名值，没有再取默认\". I'll use `!== undefined` checks to be safer? If someone passes env: undefined, `in` gives true → env undefined → crash. Use undefined check. But then explicit undefined falls back. That's friendlier. I'll use a helper.\n\nHmm, `createContext({ env: {} })` → env {} (truthy). Good.\n\nNow lib/exec.mjs:\n```js\nimport { spawnSync } from 'node:child_process'\n\nexport function run(command, args = [], { timeout = 20000 } = {}) {\n  try {\n    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n  } catch (e) {\n    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n  }\n}\n```\nCareful: acceptance V-007-6 checks child_process appears only in lib/exec.mjs. Also check-seams allowlist 'lib/exec.mjs' exact.\n\nWait — V-R-1 says check-seams runs from check-fast, and check-fast runs all scripts/check-*.mjs. check-seams without args scans REPO/lib. Good.\n\nNow config.mjs:\n```js\nimport os from 'node:os'\nimport path from 'node:path'\n\nexport const SCHEMA = 'cliworker.config/v1'\n\nexport function defaultHome(env = process.env) {\n  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n}\n```\nHmm old defaultHome() called with no args used process.env. Design: `defaultHome(env)`. Should I keep a default param? It's fine to default to process.env for robustness (select.test doesn't use it). But V-006-4: usageFile(config, ctx) uses config._home. OK.\n\nWait: careful — old `usageFile(config)` = `path.join(config._home || defaultHome(), 'usage.jsonl')`. New uses defaultHome(ctx.env).\n\nloadConfig({ file, ctx } = {}):\n```js\nexport function loadConfig({ file, ctx } = {}) {\n  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\n  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\n  ...\n}\n```\nDesign says \"`ctx` 缺失抛 `TypeError`\". OK.\n\nHmm — but old code accessed process.env directly. Now ctx.env. Note `defaultHome(ctx.env)`.\n\nError message: `cannot read CLIWorker config ${root}: ${e.message}` with code E_CONFIG.\n\nensureDir(dir, ctx), readUsage(file, ctx), appendUsage(file, row, ctx).\n\nforecast.mjs: `import { systemNow } from './context.mjs'` and default `now = systemNow()`.\n\nCareful circular import: context.mjs imports exec.mjs; forecast imports context; select imports forecast. No cycle back to context from context. Fine.\n\nBut: importing lib/forecast.mjs triggers importing lib/context.mjs → which imports node:fs. That's fine. Import-safe: importing lib/cli.mjs → commands → config → forecast → context → node:fs. No side effects. Good.\n\nNow cli.mjs. Let me write ROUTES as an array of {cmd, sub, run} or a resolver function. Design: \"路由表是文件顶部的静态 ROUTES，从 lib/commands/** 静态导入\".\n\nI'll do:\n\n```js\nconst ROUTES = [\n  { cmd: 'providers', sub: null, module: providersList },\n  { cmd: 'models', sub: null, module: modelsList },\n  { cmd: 'models', sub: 'list', module: modelsList },\n  { cmd: 'models', sub: 'select', module: modelsSelect },\n  { cmd: 'models', sub: 'forecast', module: modelsForecast },\n  { cmd: 'usage', sub: 'record', module: usageRecord },\n  { cmd: 'usage', sub: 'summary', module: usageSummary },\n]\nfunction resolveRoute(argv) {\n  const cmd = argv[0]\n  const sub = argv[1]\n  if (cmd === 'providers') return providersList\n  ...\n}\n```\nDesign explicitly enumerates semantics: providers → providers/list \"不看子命令\" (so `providers foo` still routes). models with missing sub or 'list'. usage record/summary only.\n\nI'll implement resolveRoute with the ROUTES table:\n```js\nfunction resolveRoute(argv) {\n  const cmd = argv[0]\n  const sub = argv[1]\n  if (cmd === 'providers') return find('providers', null)\n  if (cmd === 'models') return find('models', !sub || sub === 'list'