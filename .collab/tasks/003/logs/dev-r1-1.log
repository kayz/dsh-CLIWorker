areful #2: check-seams scans lib/**/*.js including lib/index.js. index.js will import from './config.mjs' etc. Fine.\n\nNow, V-007-2 requires files N >= 15 and no FAIL. Our lib/index.js uses `path` — allowed.\n\nLet me now also double-check the `seams.set_timeout` rule won't flag `ctx.clock.setTimeout` (excluded, `.`) and `clearTimeout` (different name).\n\nBut hmm: in `lib/context.mjs` I write `setTimeout(fn, ms) { return setTimeout(fn, ms) }`. The bare `setTimeout` after `{ ` → flagged, allowed file. Good.\n\nNow writing helper: fakeClock in test/helpers/clock.mjs. This is a test helper — check-seams only scans lib. So fake clock can use Date.parse etc. freely.\n\nBut V-007-6's text probe only scans lib. OK.\n\nNow let's be careful about `test/helpers/ctx.mjs` createFakeContext's `now` option: \"now 是伪时钟起点毫秒数\". So createFakeClock({ start: now }).\n\ncreateFakeContext({ files, env, platform, exec, now } = {}):\n```js\nexport function createFakeContext({ files, env, platform, exec, now } = {}) {\n  const clock = createFakeClock(now === undefined ? {} : { start: now })\n  const fs = fakeFs(files || {})\n  let seed = 12345\n  const random = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648 }\n  return {\n    exec: fakeExec(exec),\n    fs,\n    fetch: fakeFetch(),\n    env: env || {},\n    platform: platform || 'linux',\n    stdout: fakeStream(),\n    stderr: fakeStream(),\n    random,\n    clock,\n    now: () => clock.now(),\n  }\n}\n```\nMembers exactly 10. Keys order fine.\n\n`fakeFs(files)`: needs all 9 methods. Implement with a Map of resolved path → string content (or Buffer for binary?). readFileSync returns string when encoding given else Buffer.\n\nImplementation:\n```js\nexport function fakeFs(files = {}) {\n  const store = new Map()\n  const accessed = []\n  const normalize = (p) => path.resolve(String(p))\n  for (const [k, v] of Object.entries(files)) store.set(normalize(k), String(v))\n  const record = (method, p) => accessed.push({ method, path: normalize(p) })\n  const enoent = (p) => { const e = new Error(`ENOENT: no such file or directory, open '${p}'`); e.code = 'ENOENT'; return e }\n  const dirs = new Set()\n  ...\n}\n```\nDo we need to track dirs? mkdirSync creates dirs; writeFileSync should probably succeed regardless (V-072-7 writes /a/b.txt without mkdir). I'll not enforce dir existence.\n\nstatSync: return {isDirectory: () => true, isFile: () => true, size}. Keep simple: if a file exists → isFile true; else if any path starts with p + sep → directory; else ENOENT.\n\nreaddirSync: return names of immediate children; throw ENOENT if none.\n\nrenameSync: move key.\n\nrmSync: delete.\n\nexistsSync: store.has or dir known.\n\nSince only the acceptance probes and our own tests use it, keep it reasonable.\n\nNow `fakeStream()`: `{ write(chunk){ parts.push(String(chunk)) }, text(){ return parts.join('') } }`.\n\n`fakeExec(handler)`:\n```js\nexport function fakeExec(handler) {\n  const calls = []\n  const fn = (command, args = [], opts = {}) => {\n    const envNames = opts && opts.env ? Object.keys(opts.env) : []\n    calls.push({ command, args, envNames, timeout: opts ? opts.timeout : undefined })\n    if (typeof handler !== 'function') return { ok: false, code: null, stdout: '', stderr: '', error: 'fakeExec: no handler' }\n    return handler(command, args, opts)\n  }\n  fn.calls = calls\n  Object.defineProperty(fn, 'count', { get: () => calls.length })\n  return fn\n}\n```\nCareful: V-072-7 checks `ctx.exec.count !== 2`. A plain property would be fine too, but if we set `fn.count = 0` it won't update. Use getter, or increment fn.count. Getter works.\n\nHmm, but `ctx.exec.calls[0].args.join()` — args recorded as passed. Good.\n\n`fakeFetch()`:\n```js\nexport function fakeFetch() {\n  const calls = []\n  const fn = (...args) => { calls.push({ url: args[0], init: args[1] }); return Promise.reject(new Error('fakeFetch: no network')) }\n  fn.calls = calls\n  return fn\n}\n```\n\n`fakeClock` export = createFakeClock.\n\nNow the host stub.\n\n```js\nexport function createHostStub({ failPaths = [], failInject = false, failMessage = 'stub register failed' } = {}) {\n  const registered = []\n  const effects = []\n  const injectCalls = []\n  const handlers = new Map()\n  const httpCtx = {\n    effect(fn, name) { effects.push(name); return fn() },\n    webServer: {\n      register(reg) {\n        if (!reg || typeof reg !== 'object') throw new TypeError('registration must be an object')\n        if (reg.kind !== 'exact') throw new TypeError('kind must be exact')\n        if (typeof reg.path !== 'string' || !reg.path.startsWith('/')) throw new TypeError('path must start with /')\n        if (typeof reg.handler !== 'function') throw new TypeError('handler must be a function')\n        if (failPaths.includes('*') || failPaths.includes(reg.path)) throw new Error(`${failMessage}: ${reg.path}`)\n        registered.push({ kind: reg.kind, path: reg.path })\n        handlers.set(reg.path, reg.handler)\n      },\n    },\n  }\n  const ctx = {\n    inject(services, cb) {\n      injectCalls.push(services)\n      if (failInject) throw new Error('stub inject failed')\n      return cb(httpCtx)\n    },\n  }\n  function handlerFor(p) { const h = handlers.get(p); if (!h) throw new Error(`no handler registered for ${p}`); return h }\n  async function request(p, { method = 'GET', url = p, headers = {}, remoteAddress = '127.0.0.1', host = 'localhost', origin, body } = {}) {\n    const handler = handlerFor(p)\n    const reqHeaders = { ...headers, host }\n    if (origin !== undefined) reqHeaders.origin = origin\n    const listeners = new Map()\n    const req = {\n      method, url, headers: reqHeaders,\n      socket: { remoteAddress },\n      on(event, fn) { const list = listeners.get(event) || []; list.push(fn); listeners.set(event, list); return req },\n      destroy() {},\n    }\n    const out = { statusCode: 200, headers: {} }\n    const res = {\n      get statusCode() { return out.statusCode },\n      set statusCode(v) { out.statusCode = v },\n      setHeader(k, v) { out.headers[String(k).toLowerCase()] = v },\n      end(chunk) { out.body = chunk === undefined ? '' : String(chunk); resolveDone() },\n    }\n    ...\n  }\n```\nNeed a promise for end; and drive listeners after handler is invoked (async). Implementation:\n\n```js\n    let resolveDone\n    const done = new Promise((r) => { resolveDone = r })\n    ...\n    const payload = body === undefined ? '' : (typeof body === 'string' ? body : JSON.stringify(body))\n    // emit after handler attaches listeners\n    const result = handler(req, res)\n    // dispatch data/end asynchronously so readBody's listeners are registered\n    setImmediate? \n```\nHmm, using setTimeout here is in test helpers (allowed). But simpler: after calling handler, use `queueMicrotask`/`Promise.resolve().then()` to emit synchronously after the current stack. readBody attaches `req.on('data')` inside a Promise executor which runs synchronously when readBody is called. readBody is called synchronously in the handler (before any await) in index.js: `const body = ... await readBody(req)`. Actually `readBody(req)` is called within the async function right away. Since handler is async and we call it, it runs synchronously until the first await. `await readBody(req)` → readBody called synchronously → listeners registered. So after `handler(req,res)` returns (a promise), listeners are registered. Then we can emit.\n\nBut if the handler awaits something before readBody... In our index.js, readBody is the first thing. Safe. Still, emit via `await Promise.resolve()` then dispatch — safer.\n\nLet me do:\n```js\nconst done = new Promise(...)\nhandler(req, res)\nawait Promise.resolve()\nfor (const fn of listeners.get('data') || []) fn(Buffer.from(payload))\nfor (const fn of listeners.get('end') || []) fn()\nawait done\nreturn { statusCode: out.statusCode, headers: out.headers, body: out.body }\n```\nBut `handler(req,res)