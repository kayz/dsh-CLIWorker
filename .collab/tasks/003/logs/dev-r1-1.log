t')\n  35→    if (raw) { try { req = JSON.parse(raw) } catch (e) { fail(`bad --request JSON: ${e.message}`) } }\n  36→    const status = providerStatus(config)\n  37→    out(selectModels(config, req, { status, usage: readUsage(usageFile(config)) }))\n  38→    return\n  39→  }\n  40→  if (cmd === 'models' && sub === 'forecast') {\n  41→    const key = arg('--model', null)\n  42→    const usage = readUsage(usageFile(config))\n  43→    out({ schema: 'cliworker.forecast/v1', forecast: forecast({ records: usage, model: key, prices: key ? config.models[key]?.prices : undefined, quota: key ? config.quotas?.[config.models[key]?.provider] : null }) })\n  44→    return\n  45→  }\n  46→  if (cmd === 'usage' && sub === 'record') {\n  47→    let row\n  48→    const raw = arg('--json')\n  49→    try { row = JSON.parse(raw) } catch (e) { fail(`bad --json: ${e.message}`) }\n  50→    if (!row.model) fail('usage record requires model')\n  51→    const m = config.models[row.model]\n  52→    if (m) row.cost_usd = row.cost_usd ?? estimateCost({ input_tokens: row.input_tokens, output_tokens: row.output_tokens, prices: m.prices })\n  53→    row.at = row.at || new Date().toISOString()\n  54→    appendUsage(usageFile(config), row)\n  55→    out({ schema: 'cliworker.usage/v1', ok: true, recorded: row })\n  56→    return\n  57→  }\n  58→  if (cmd === 'usage' && sub === 'summary') {\n  59→    out({ schema: 'cliworker.usage/v1', records: readUsage(usageFile(config)) })\n  60→    return\n  61→  }\n  62→  fail('usage: cliworker providers | models list|select|forecast | usage record|summary')\n  63→}\n  64→\n  65→main()\n  66→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715458172adb53d67cfd38ceeee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715458172adb53d67cfd38ceeee","codebuddy.ai/llmMessageId":"01a1b715458172adb53d67cfd38ceeee","tracepar