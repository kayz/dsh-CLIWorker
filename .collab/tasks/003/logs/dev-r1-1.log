{"type":"user","uuid":"01a1b715-4e24-79b9-960f-3f637bb8d78c","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_T7X9Jm1AA7QodhIjsxkj4797","content":[{"type":"text","text":"   1→import { spawnSync } from 'node:child_process'\n   2→\n   3→function run(command, args, timeout = 20_000) {\n   4→  try {\n   5→    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n   6→    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n   7→  } catch (e) {\n   8→    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n   9→  }\n  10→}\n  11→\n  12→export function checkProvider(provider, { probe = true } = {}) {\n  13→  const cli = provider.cli\n  14→  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n  15→  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n  16→  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n  17→  const v = run(cli, versionArgs)\n  18→  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n  19→  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n  20→  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n  21→  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n  22→  const auth = run(cli, [...prefix, ...provider.auth_args])\n  23→  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n  24→  const ok = auth.ok && (\n  25→    !provider.auth_ok ||\n  26→    text.includes(String(provider.auth_ok).toLowerCase()) ||\n  27→    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n  28→    /\\blogged in\\b/.test(text)\n  29→  )\n  30→  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n  31→}\n  32→\n  33→export function providerStatus(config, opts = {}) {\n  34→  const out = {}\n  35→  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n  36→  return out\n  37→}\n  38→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715458172adb53d67cfd38ceeee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715458172adb53d67cfd38ceeee","codebuddy.ai/llmMessageId":"01a1b715458172adb53d67cfd38ceeee","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:29.221Z"}
{"type":"user","uuid":"01a1b715-4e2b-78f0-bc80-99a3176ad216","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_mHGqjXhkBC0pVIKxBYO76534","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import os from 'node:os'\n   3→import path from 'node:path'\n   4→\n   5→export const SCHEMA = 'cliworker.config/v1'\n   6→\n   7→export function defaultHome() {\n   8→  return process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   9→}\n  10→\n  11→export function loadConfig({ file } = {}) {\n  12→  const root = path.resolve(file || process.env.CLIWORKER_CONFIG || path.join(defaultHome(), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome() }\n  23→}\n  24→\n  25→export function ensureDir(dir) { fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file) {\n  28→  try {\n  29→    return fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row) {\n  34→  ensureDir(path.dirname(file))\n  35→  fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715458172adb53d67cfd38ceeee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715458172adb53d67cfd38ceeee","codebuddy.ai/llmMessageId":"01a1b715458172adb53d67cfd38ceeee","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:29.227Z"}
{"type":"user","uuid":"01a1b715-4e31-7f0e-a33a-4eaff3055f59","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_aavYLunbrdG3vCKFBt0t5595","content":[{"type":"text","text":"   1→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   2→\n   3→export function normalizePrices(m = {}) {\n   4→  const p = m.prices || {}\n   5→  return {\n   6→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n   7→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n   8→  }\n   9→}\n  10→\n  11→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  12→  const p = { ...DEFAULT_PRICES, ...prices }\n  13→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  14→}\n  15→\n  16→/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n  17→export function forecast({ records = [], model, prices, quota = null, now = Date.now() } = {}) {\n  18→  const rows = records.filter((r) => !model || r.model === model)\n  19→  const samples = rows.map((r) => ({\n  20→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  21→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  22→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  23→  if (!samples.length) {\n  24→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  25→  }\n  26→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  27→  const use = recent.length ? recent : samples.slice(-10)\n  28→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  29→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  30→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  31→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  32→  let tasksLeft = null\n  33→  let etaHours = null\n  34→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  35→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  36→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  37→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  38→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  39→  }\n  40→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  41→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  42→  return {\n  43→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  44→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  45→    confidence, risk,\n  46→  }\n  47→}\n  48→\n  49→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  50→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715458172adb53d67cfd38ceeee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715458172adb53d67cfd38ceeee","codebuddy.ai/llmMessageId":"01a1b715458172adb53d67cfd38ceeee","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:29.234Z"}
{"type":"user","uuid":"01a1b715-4e37-76c9-834f-4a2e65d14d8e","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_04_IsU8dTE5UWV5FSaCwwoE0488","content":[{"type":"text","text":"   1→/**\n   2→ * dsh-cliworker — DSH host plugin.\n   3→ *\n   4→ * AgentLine and other clients only need the model source pointer:\n   5→ *   modelSource = { kind: \"cliworker\", command: \"node\",\n   6→ *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n   7→ *\n   8→ * The plugin exposes the same selection contract over DSH routes for UI use.\n   9→ */\n  10→import path from 'node:path'\n  11→import os from 'node:os'\n  12→import { fileURLToPath } from 'node:url'\n  13→import { loadConfig } from '../lib/config.mjs'\n  14→import { providerStatus } from '../lib/availability.mjs'\n  15→import { listModels, selectModels } from '../lib/select.mjs'\n  16→import { forecast } from '../lib/forecast.mjs'\n  17→\n  18→const __dirname = path.dirname(fileURLToPath(import.meta.url))\n  19→const DEFAULTS = {\n  20→  configPath: process.env.CLIWORKER_CONFIG || path.join(process.env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker'), 'config.json'),\n  21→  readonly: false,\n  22→}\n  23→\n  24→function send(res, body, code = 200) {\n  25→  res.statusCode = code\n  26→  res.setHeader('content-type', 'application/json; charset=utf-8')\n  27→  res.setHeader('cache-control', 'no-store')\n  28→  res.end(JSON.stringify(body))\n  29→}\n  30→\n  31→function readBody(req) {\n  32→  return new Promise((resolve, reject) => {\n  33→    let raw = ''\n  34→    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n  35→    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n  36→    req.on('error', reject)\n  37→  })\n  38→}\n  39→\n  40→export const name = 'cliworker'\n  41→\n  42→export function apply(ctx, config = {}) {\n  43→  const settings = { ...DEFAULTS, ...(config || {}) }\n  44→  const getConfig = () => loadConfig({ file: settings.configPath })\n  45→\n  46→  try {\n  47→    ctx.inject(['webServer'], (httpCtx) => {\n  48→      const route = (p, name, handler) => httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: p, handler }), name)\n  49→\n  50→      route('/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n  51→        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  52→      })\n  53→      route('/cliworker/models', 'cliworker: models', async (_req, res) => {\n  54→        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  55→      })\n  56→      route('/cliworker/select', 'cliworker: select', async (req, res) => {\n  57→        try {\n  58→          const c = getConfig()\n  59→          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n  60→          const request = body.request || body\n  61→          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c) }) })\n  62→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n  63→      })\n  64→      route('/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n  65→        try {\n  66→          const c = getConfig()\n  67→          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n  68→          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null }) })\n  69→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  70→      })\n  71→    })\n  72→  } catch (e) {\n  73→    console.error('[cliworker] webServer inject failed:', e.message)\n  74→  }\n  75→}\n  76→\n  77→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715458172adb53d67cfd38ceeee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715458172adb53d67cfd38ceeee","codebuddy.ai/llmMessageId":"01a1b715458172adb53d67cfd38ceeee","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:29.240Z"}
