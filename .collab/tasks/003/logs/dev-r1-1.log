 force: true })\n 308→  }\n 309→})\n 310→\n 311→test('[AC-003] check-fast stops at the first failure and propagates its exit code', () => {\n 312→  const dir = tmp('cliworker-fast-fail-')\n 313→  const log = path.join(dir, 'log.txt')\n 314→  try {\n 315→    writeStep(dir, 'check-a.mjs', APPEND('a'))\n 316→    writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\n 317→    writeStep(dir, 'check-c.mjs', APPEND('c'))\n 318→    writeStep(dir, 'final.mjs', APPEND('final'))\n 319→\n 320→    const result = run([CHECK_FAST], {\n 321→      env: {\n 322→        ...process.env,\n 323→        CW_LOG: log,\n 324→        CLIWORKER_TEST_CHECK_DIR: dir,\n 325→        CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\n 326→      },\n 327→    })\n 328→    assert.equal(result.status, 7, output(result))\n 329→    assert.match(output(result), /check-b\\.mjs/)\n 330→    assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb')\n 331→  } finally {\n 332→    fs.rmSync(dir, { recursive: true, force: true })\n 333→  }\n 334→})\n 335→\n 336→test('[AC-003] check-fast runs the steps in code point order and skips its own file', () => {\n 337→  const dir = tmp('cliworker-fast-ok-')\n 338→  const log = path.join(dir, 'log.txt')\n 339→  try {\n 340→    writeStep(dir, 'check-a.mjs', APPEND('a'))\n 341→    writeStep(dir, 'check-b.mjs', APPEND('b'))\n 342→    writeStep(dir, 'check-c.mjs', APPEND('c'))\n 343→    writeStep(dir, 'check-fast.mjs', APPEND('SELF'))\n 344→    writeStep(dir, 'final.mjs', APPEND('final'))\n 345→\n 346→    const result = run([CHECK_FAST], {\n 347→      env: {\n 348→        ...process.env,\n 349→        CW_LOG: log,\n 350→        CLIWORKER_TEST_CHECK_DIR: dir,\n 351→        CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\n 352→      },\n 353→    })\n 354→    assert.equal(result.status, 0, output(result))\n 355→    assert.equal(fs.readFileSync(log, 'utf8').trim(), 'a\\nb\\nc\\nfinal')\n 356→    assert.match(result.stdout, /==> npm test/)\n 357→    assert.ok(!result.stdout.includes('==> check-fast.mjs'))\n 358→  } finally {\n 359→    fs.rmSync(dir, { recursive: true, force: true })\n 360→  }\n 361→})\n 362→\n 363→platformTest(\n 364→  '[AC-003] the pwsh wrapper forwards the same exit code with a single node call',\n 365→  { ac: 'AC-003', requires: 'pwsh', file: import.meta.url },\n 366→  () => {\n 367→    const dir = tmp('cliworker-fast-pwsh-')\n 368→    const log = path.join(dir, 'log.txt')\n 369→    try {\n 370→      writeStep(dir, 'check-a.mjs', APPEND('a'))\n 371→      writeStep(dir, 'check-b.mjs', `${APPEND('b')}\\nprocess.exit(7)`)\n 372→      writeStep(dir, 'final.mjs', APPEND('final'))\n 373→\n 374→      const result = spawnSync('pwsh', ['-NoProfile', '-File', CHECK_FAST_PS1], {\n 375→        encoding: 'utf8',\n 376→        env: {\n 377→          ...process.env,\n 378→          CW_LOG: log,\n 379→          CLIWORKER_TEST_CHECK_DIR: dir,\n 380→          CLIWORKER_TEST_FINAL_SCRIPT: path.join(dir, 'final.mjs'),\n 381→        },\n 382→      })\n 383→      assert.equal(result.status, 7, output(result))\n 384→      assert.match(output(result), /check-b\\.mjs/)\n 385→    } finally {\n 386→      fs.rmSync(dir, { recursive: true, force: true })\n 387→    }\n 388→\n 389→    const lines = fs\n 390→      .readFileSync(CHECK_FAST_PS1, 'utf8')\n 391→      .split('\\n')\n 392→      .filter((line) => line.trim() !== '' && !line.trim().startsWith('#'))\n 393→    assert.ok(lines.length <= 3, `check-fast.ps1 must stay a thin wrapper, got ${lines.length} lines`)\n 394→    assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /\\$LASTEXITCODE/)\n 395→    assert.match(fs.readFileSync(CHECK_FAST_PS1, 'utf8'), /check-fast\\.mjs/)\n 396→  }\n 397→)\n 398→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715694b7335a9e6534289ed30ee","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b