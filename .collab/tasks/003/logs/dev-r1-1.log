{"type":"user","uuid":"01a1b715-5449-7178-a909-b8abe268edc0","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_ET_QqsZaN5M9yF1s5h6beNw0191","content":[{"type":"text","text":"   1→import { normalizePrices, forecast } from './forecast.mjs'\n   2→\n   3→export const SCHEMA = 'cliworker.selection/v1'\n   4→export const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n   5→export const USAGES = ['Heavy', 'Normal', 'Light']\n   6→\n   7→function isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n   8→function normLevel(v) {\n   9→  const s = String(v || '').trim().toLowerCase()\n  10→  return LEVELS.find((x) => x.toLowerCase() === s) || null\n  11→}\n  12→function normUsage(v) {\n  13→  const s = String(v || '').trim().toLowerCase()\n  14→  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n  15→}\n  16→\n  17→function vendorOf(provider) {\n  18→  const p = String(provider || '').toLowerCase()\n  19→  if (p.includes('claude')) return 'anthropic'\n  20→  if (p.includes('codex') || p.includes('openai')) return 'openai'\n  21→  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n  22→  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n  23→  if (p.includes('gemini') || p.includes('google')) return 'google'\n  24→  return p\n  25→}\n  26→\n  27→function levelOf(m) {\n  28→  if (m.level && LEVELS.includes(m.level)) return m.level\n  29→  if (m.tier === 'top') return 'Top'\n  30→  if (m.tier === 'advanced') return 'High'\n  31→  if (m.tier === 'standard') return 'Middle'\n  32→  return 'Quick'\n  33→}\n  34→\n  35→function cliCall(config, model, request) {\n  36→  const p = config.providers?.[model.provider] || {}\n  37→  const id = model.id\n  38→  const cwd = request.cwd || '<workspace>'\n  39→  if (model.provider === 'claude') {\n  40→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  41→  }\n  42→  if (model.provider === 'codex') {\n  43→    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n  44→  }\n  45→  if (model.provider === 'codebuddy') {\n  46→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  47→  }\n  48→  if (model.provider === 'cursor-wsl') {\n  49→    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n  50→  }\n  51→  if (model.provider === 'gemini') {\n  52→    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n  53→  }\n  54→  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n  55→}\n  56→\n  57→export function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n  58→  return Object.entries(config.models).map(([key, m]) => {\n  59→    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n  60→    const callable = st.state === 'callable' && !m.deprecated\n  61→    return {\n  62→      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n  63→      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n  64→      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n  65→      identity_group: m.identity_group || null,\n  66→      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n  67→      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n  68→      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n  69→      prices: normalizePrices(m), source: 'config',\n  70→      provider_detail: st.detail || null,\n  71→    }\n  72→  }).filter((m) => includeDeprecated || !m.deprecated)\n  73→}\n  74→\n  75→export function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n  76→  const level = normLevel(request.level || request.tier)\n  77→  const usageKind = normUsage(request.usage)\n  78→  const models = listModels(config, { status, includeDeprecated: true })\n  79→  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n  80→  const requireVerified = request.require_verified !== false\n  81→  const requireReadonly = request.require_readonly === true\n  82→  const exclude = new Set(request.exclude || [])\n  83→  const allowed = request.candidates ? new Set(request.candidates) : null\n  84→  const rejected = []\n  85→  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n  86→\n  87→  const candidates = models.filter((m) => {\n  88→    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n  89→    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n  90→    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n  91→    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n  92→    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n  93→    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n  94→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n  95→    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n  96→      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n  97→    }\n  98→    return true\n  99→  })\n 100→\n 101→  const rank = (m) => {\n 102→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 103→    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n 104→    const unknown = f.risk === 'unknown' ? 1 : 0\n 105→    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n 106→    if (usageKind === 'Light') return [price, unknown, m.key]\n 107→    return [unknown, price, m.key]\n 108→  }\n 109→  candidates.sort((a, b) => {\n 110→    const ra = rank(a), rb = rank(b)\n 111→    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n 112→    return 0\n 113→  })\n 114→\n 115→  const picked = candidates.slice(0, count).map((m) => {\n 116→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 117→    const call = cliCall(config, m, request)\n 118→    return {\n 119→      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n 120→      adapter: config.providers[m.provider]?.adapter || null,\n 121→      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n 122→      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n 123→      forecast: f, cli: call, call,\n 124→    }\n 125→  })\n 126→  return {\n 127→    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n 128→    models: picked, calls: picked.map((x) => x.call), rejected,\n 129→    reason: picked.length ? null : 'no_eligible_model',\n 130→    truncated: picked.length < count,\n 131→  }\n 132→}\n 133→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b7154dda78d7a7ceb87b22702965","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b7154dda78d7a7ceb87b22702965","codebuddy.ai/llmMessageId":"01a1b7154dda78d7a7ceb87b22702965","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:30.795Z"}
{"type":"user","uuid":"01a1b715-5450-774d-a2f4-5177fec052af","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_ET_hzLYY1L26n2ozHEZobm58011","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Test runner: enumerates test files, runs them with node:test, and verifies that the\n   3→// files the reporter saw match the files we enumerated (full runs only).\n   4→import fs from 'node:fs'\n   5→import os from 'node:os'\n   6→import path from 'node:path'\n   7→import crypto from 'node:crypto'\n   8→import { spawn } from 'node:child_process'\n   9→import { fileURLToPath, pathToFileURL } from 'node:url'\n  10→\n  11→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  12→const REPO_ROOT = path.resolve(HERE, '..')\n  13→const REPORTER = pathToFileURL(path.join(HERE, 'reporters', 'files.mjs')).href\n  14→const MANIFEST_NAME = 'files-executed.json'\n  15→const SKIPS_NAME = 'skips.jsonl'\n  16→const AC_PATTERN = /^AC-\\d{3}$/\n  17→const MAX_ARG_CHARS = 24000\n  18→\n  19→const TEST_DIRS = ['unit', 'integration', 'contract', 'e2e', 'smoke', 'characterization', 'flows']\n  20→const EXCLUDED_TOP = new Set(['fixtures', 'helpers', 'perf'])\n  21→\n  22→const USAGE =\n  23→  'usage: node scripts/run-tests.mjs [--ac AC-nnn]... [--root <dir>] [--out-dir <dir>] [--perf] [--update-snapshots]'\n  24→\n  25→function toPosix(value) {\n  26→  return value.split(path.sep).join('/')\n  27→}\n  28→\n  29→function walkFiles(dir, onFile) {\n  30→  let entries\n  31→  try {\n  32→    entries = fs.readdirSync(dir, { withFileTypes: true })\n  33→  } catch {\n  34→    return\n  35→  }\n  36→  for (const entry of entries) {\n  37→    const full = path.join(dir, entry.name)\n  38→    if (entry.isDirectory()) walkFiles(full, onFile)\n  39→    else if (entry.isFile()) onFile(full)\n  40→  }\n  41→}\n  42→\n  43→export function enumerateTestFiles(root) {\n  44→  const base = path.resolve(root)\n  45→  const found = []\n  46→  for (const name of TEST_DIRS) {\n  47→    const start = path.join(base, 'test', name)\n  48→    let stat\n  49→    try {\n  50→      stat = fs.statSync(start)\n  51→    } catch {\n  52→      continue\n  53→    }\n  54→    if (!stat.isDirectory()) continue\n  55→    walkFiles(start, (file) => {\n  56→      if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n  57→    })\n  58→  }\n  59→  return [...new Set(found)].sort()\n  60→}\n  61→\n  62→export function enumeratePerfFiles(root) {\n  63→  const base = path.resolve(root)\n  64→  const start = path.join(base, 'test', 'perf')\n  65→  try {\n  66→    if (!fs.statSync(start).isDirectory()) return []\n  67→  } catch {\n  68→    return []\n  69→  }\n  70→  const found = []\n  71→  walkFiles(start, (file) => {\n  72→    if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n  73→  })\n  74→  return [...new Set(found)].sort()\n  75→}\n  76→\n  77→export function findOrphans(root) {\n  78→  const base = path.resolve(root)\n  79→  const testDir = path.join(base, 'test')\n  80→  let entries\n  81→  try {\n  82→    entries = fs.readdirSync(testDir, { withFileTypes: true })\n  83→  } catch {\n  84→    return []\n  85→  }\n  86→\n  87→  const all = []\n  88→  for (const entry of entries) {\n  89→    if (entry.isDirectory()) {\n  90→      if (EXCLUDED_TOP.has(entry.name)) continue\n  91→      walkFiles(path.join(testDir, entry.name), (file) => {\n  92→        if (file.endsWith('.test.mjs')) all.push(file)\n  93→      })\n  94→    } else if (entry.isFile() && entry.name.endsWith('.test.mjs')) {\n  95→      all.push(path.join(testDir, entry.name))\n  96→    }\n  97→  }\n  98→\n  99→  const enumerated = new Set(enumerateTestFiles(base))\n 100→  return [...new Set(all.map((file) => toPosix(path.relative(base, file))))]\n 101→    .filter((file) => !enumerated.has(file))\n 102→    .sort()\n 103→}\n 104→\n 105→export function verifyFullRun({ enumerated, manifest }) {\n 106→  const errors = []\n 107→  const files = Array.isArray(manifest?.files) ? manifest.files : []\n 108→  if (!manifest || manifest.mode !== 'full') {\n 109→    errors.push({ id: 'discovery.mode_not_full', path: manifest?.mode ?? 'missing' })\n 110→  }\n 111→\n 112→  const reported = new Set(files)\n 113→  for (const file of enumerated) {\n 114→    if (!reported.has(file)) errors.push({ id: 'discovery.missing', path: file })\n 115→  }\n 116→\n 117→  const expected = new Set(enumerated)\n 118→  for (const file of files) {\n 119→    if (!expected.has(file)) errors.push({ id: 'discovery.unexpected', path: file })\n 120→  }\n 121→\n 122→  if (enumerated.length === 0) errors.push({ id: 'discovery.no_files', path: '' })\n 123→\n 124→  return { ok: errors.length === 0, errors }\n 125→}\n 126→\n 127→function normalizePath(value) {\n 128→  const resolved = path.resolve(value).replace(/[\\\\/]+$/, '')\n 129→  return process.platform === 'win32' ? resolved.toLowerCase() : resolved\n 130→}\n 131→\n 132→function defaultOutDir(root) {\n 133→  const key = process.platform === 'win32' ? root.toLowerCase() : root\n 134→  const hash = crypto.createHash('sha256').update(key).digest('hex').slice(0, 12)\n 135→  return path.join(os.tmpdir(), 'cliworker-test-results', hash)\n 136→}\n 137→\n 138→function usageError(message) {\n 139→  process.stderr.write(`${message}\\n${USAGE}\\n`)\n 140→  process.exitCode = 2\n 141→}\n 142→\n 143→function parseArgs(argv) {\n 144→  const options = { acs: [], root: REPO_ROOT, outDir: null, perf: false, updateSnapshots: false }\n 145→  for (let i = 0; i < argv.length; i += 1) {\n 146→    const flag = argv[i]\n 147→    if (flag === '--ac') {\n 148→      const value = argv[i + 1]\n 149→      if (typeof value !== 'string' || !AC_PATTERN.test(value)) {\n 150→        return { error: `--ac requires a value matching ^AC-\\\\d{3}$ (got ${JSON.stringify(value ?? null)})` }\n 151→      }\n 152→      options.acs.push(value)\n 153→      i += 1\n 154→    } else if (flag === '--root') {\n 155→      const value = argv[i + 1]\n 156→      if (typeof value !== 'string' || value === '') return { error: '--root requires a directory' }\n 157→      options.root = path.resolve(value)\n 158→      i += 1\n 159→    } else if (flag === '--out-dir') {\n 160→      const value = argv[i + 1]\n 161→      if (typeof value !== 'string' || value === '') return { error: '--out-dir requires a directory' }\n 162→      options.outDir = path.resolve(value)\n 163→      i += 1\n 164→    } else if (flag === '--perf') {\n 165→      options.perf = true\n 166→    } else if (flag === '--update-snapshots') {\n 167→      options.updateSnapshots = true\n 168→    } else {\n 169→      return { error: `unknown argument: ${flag}` }\n 170→    }\n 171→  }\n 172→  options.acs = [...new Set(options.acs)]\n 173→  return { options }\n 174→}\n 175→\n 176→function runNode(args, spawnOptions) {\n 177→  return new Promise((resolve) => {\n 178→    // A nested `node --test` refuses to run its files when it inherits NODE_TEST_CONTEXT from\n 179→    // the parent test process. Nested runs are legitimate here (self-tests and the milestone\n 180→    // gate spawn run-tests), so the child must look like a top-level run.\n 181→    const env = { ...(spawnOptions.env ?? process.env) }\n 182→    delete env.NODE_TEST_CONTEXT\n 183→    const child = spawn(process.execPath, args, { ...spawnOptions, env })\n 184→    child.on('error', () => resolve({ code: null, signal: null }))\n 185→    child.on('close', (code, signal) => resolve({ code, signal }))\n 186→  })\n 187→}\n 188→\n 189→function readManifest(file) {\n 190→  try {\n 191→    return JSON.parse(fs.readFileSync(file, 'utf8'))\n 192→  } catch {\n 193→    return null\n 194→  }\n 195→}\n 196→\n 197→async function main() {\n 198→  const parsed = parseArgs(process.argv.slice(2))\n 199→  if (parsed.error) {\n 200→    usageError(parsed.error)\n 201→    return\n 202→  }\n 203→  const options = parsed.options\n 204→  const root = options.root\n 205→\n 206→  if (options.perf) {\n 207→    const files = enumeratePerfFiles(root)\n 208→    if (files.length === 0) {\n 209→      process.stdout.write('run-tests: no perf tests\\n')\n 210→      return\n 211→    }\n 212→    const result = await runNode(['--test', ...files], { cwd: root, stdio: 'inherit' })\n 213→    process.exitCode = result.code === null ? 1 : result.code\n 214→    return\n 215→  }\n 216→\n 217→  const filtered = options.acs.length > 0\n 218→  const outDir = options.outDir ?? (process.env.CLIWORKER_RESULTS_DIR\n 219→    ? path.resolve(process.env.CLIWORKER_RESULTS_DIR)\n 220→    : defaultOutDir(root))\n 221→\n 222→  if (\n 223→    process.env.CLIWORKER_RUN_ACTIVE &&\n 224→    process.env.CLIWORKER_RESULTS_DIR &&\n 225→    normalizePath(outDir) === normalizePath(process.env.CLIWORKER_RESULTS_DIR)\n 226→  ) {\n 227→    process.stderr.write(\n 228→      'run-tests: refusing to run nested inside the parent run (a nested run would overwrite the parent artifacts)\\n'\n 229→    )\n 230→    process.exitCode = 2\n 231→    return\n 232→  }\n 233→\n 234→  fs.mkdirSync(outDir, { recursive: true })\n 235→  const manifestPath = path.join(outDir, MANIFEST_NAME)\n 236→  const skipsPath = path.join(outDir, SKIPS_NAME)\n 237→  fs.rmSync(manifestPath, { force: true })\n 238→  fs.writeFileSync(skipsPath, '')\n 239→\n 240→  const enumerated = enumerateTestFiles(root)\n 241→  let files = enumerated\n 242→\n 243→  if (filtered) {\n 244→    const needles = options.acs.map((ac) => `[${ac}]`)\n 245→    files = enumerated.filter((file) => {\n 246→      let source = ''\n 247→      try {\n 248→        source = fs.readFileSync(path.join(root, file), 'utf8')\n 249→      } catch {\n 250→        return false\n 251→      }\n 252→      return needles.some((needle) => source.includes(needle))\n 253→    })\n 254→    if (files.length === 0) {\n 255→      for (const ac of options.acs) process.stdout.write(`FAIL run.no_match ${ac}\\n`)\n 256→      process.exitCode = 1\n 257→      return\n 258→    }\n 259→  } else {\n 260→    const orphans = findOrphans(root)\n 261→    if (orphans.length > 0) {\n 262→      for (const file of orphans) process.stdout.write(`FAIL discovery.orphan ${file}\\n`)\n 263→      process.exitCode = 1\n 264→      return\n 265→    }\n 266→  }\n 267→\n 268→  if (files.length === 0) {\n 269→    process.stdout.write('FAIL discovery.no_files\\n')\n 270→    process.exitCode = 1\n 271→    return\n 272→  }\n 273→\n 274→  const joined = files.join(' ')\n 275→  if (joined.length > MAX_ARG_CHARS) {\n 276→    usageError(`run-tests: file list is too long for one command line (${joined.length} characters)`)\n 277→    return\n 278→  }\n 279→\n 280→  const mode = filtered ? 'filtered' : 'full'\n 281→  const env = {\n 282→    ...process.env,\n 283→    CLIWORKER_RUN_MODE: mode,\n 284→    CLIWORKER_RUN_FILTER: filtered ? options.acs.join(',') : '',\n 285→    CLIWORKER_ROOT: root,\n 286→    CLIWORKER_RESULTS_DIR: outDir,\n 287→    CLIWORKER_RUN_ACTIVE: '1',\n 288→  }\n 289→  if (options.updateSnapshots) env.CLIWORKER_UPDATE_SNAPSHOT = '1'\n 290→\n 291→  const args = [\n 292→    '--test',\n 293→    '--test-reporter=spec',\n 294→    '--test-reporter-destination=stdout',\n 295→    `--test-reporter=${REPORTER}`,\n 296→    `--test-reporter-destination=${manifestPath}`,\n 297→    ...files,\n 298→  ]\n 299→\n 300→  const result = await runNode(args, { cwd: root, stdio: 'inherit', env })\n 301→  let exitCode = result.code === null ? 1 : result.code\n 302→\n 303→  if (!filtered) {\n 304→    const manifest = readManifest(manifestPath)\n 305→    const verification = verifyFullRun({ enumerated: files, manifest })\n 306→    if (!verification.ok) {\n 307→      for (const error of verification.errors) {\n 308→        process.stdout.write(`FAIL ${error.id} ${error.path}\\n`)\n 309→      }\n 310→      if (exitCode === 0) exitCode = 1\n 311→    }\n 312→  }\n 313→\n 314→  process.stdout.write(`run-tests: ${mode} ${files.length} files, manifest ${manifestPath}\\n`)\n 315→  process.exitCode = exitCode\n 316→}\n 317→\n 318→const invokedDirectly =\n 319→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 320→\n 321→if (invokedDirectly) {\n 322→  main().catch((error) => {\n 323→    process.stderr.write(`run-tests: ${error && error.stack ? error.stack : String(error)}\\n`)\n 324→    process.exitCode = 1\n 325→  })\n 326→}\n 327→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b7154dda78d7a7ceb87b22702965","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b7154dda78d7a7ceb87b22702965","codebuddy.ai/llmMessageId":"01a1b7154dda78d7a7ceb87b22702965","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:30.801Z"}
{"type":"user","uuid":"01a1b715-5459-7b78-84f1-2edb7dae1523","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_ET_SELTOmzP3OzwyKzNPEVm8872","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Traceability: validates contracts/spec/ac-index.json and merges test/traceability/*.json.\n   3→// Exported helpers are reused by milestone-gate.mjs and check-defects.mjs.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const REPO_ROOT = path.resolve(HERE, '..')\n  10→\n  11→const SCHEMA = 'cliworker.ac-index/v1'\n  12→const INDEX_KEYS = ['ac', 'owner', 'milestone', 'levels', 'baseline']\n  13→const LEVELS = ['unit', 'integration', 'contract', 'e2e', 'smoke']\n  14→const BASELINES = ['linux', 'win32', 'darwin', 'real-smoke']\n  15→const MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\n  16→const NON_SMOKE_LEVELS = ['unit', 'contract', 'integration', 'e2e']\n  17→\n  18→const TITLE_RE = /(?<![\\w.])(test|it|describe|platformTest)(\\.(skip|todo|only))?\\s*\\(\\s*(['\"`])((?:\\\\.|(?!\\4).)*)\\4/g\n  19→\n  20→export function extractTitles(source) {\n  21→  const titles = []\n  22→  const text = String(source ?? '')\n  23→  for (const match of text.matchAll(TITLE_RE)) {\n  24→    titles.push({ kind: match[3] ? match[3] : 'plain', title: match[5] })\n  25→  }\n  26→  return titles\n  27→}\n  28→\n  29→function expectedAcs() {\n  30→  const list = []\n  31→  for (let i = 1; i <= 74; i += 1) list.push(`AC-${String(i).padStart(3, '0')}`)\n  32→  return list\n  33→}\n  34→\n  35→function isStringArray(value) {\n  36→  return Array.isArray(value) && value.every((item) => typeof item === 'string')\n  37→}\n  38→\n  39→export function validateIndex(index) {\n  40→  const errors = []\n  41→  const push = (id, ac, detail) => errors.push({ id, ac, detail })\n  42→\n  43→  if (!index || typeof index !== 'object' || Array.isArray(index)) {\n  44→    push('index.schema', undefined, 'index must be a JSON object')\n  45→    return errors\n  46→  }\n  47→  if (index.schema !== SCHEMA) push('index.schema', undefined, `schema must be ${SCHEMA}`)\n  48→\n  49→  if (!Array.isArray(index.acs)) {\n  50→    push('index.schema', undefined, 'acs must be an array')\n  51→    return errors\n  52→  }\n  53→\n  54→  for (const entry of index.acs) {\n  55→    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n  56→      push('index.schema', undefined, 'every entry must be a JSON object')\n  57→      continue\n  58→    }\n  59→    const keys = Object.keys(entry)\n  60→    const missing = INDEX_KEYS.filter((key) => !keys.includes(key))\n  61→    const extra = keys.filter((key) => !INDEX_KEYS.includes(key))\n  62→    if (missing.length > 0 || extra.length > 0) {\n  63→      push(\n  64→        'index.schema',\n  65→        typeof entry.ac === 'string' ? entry.ac : undefined,\n  66→        `entry keys must be exactly ${INDEX_KEYS.join(',')} (missing=${missing.join('|') || '-'} extra=${extra.join('|') || '-'})`\n  67→      )\n  68→    }\n  69→\n  70→    if (typeof entry.owner !== 'string' || !/^T-\\d{3}$/.test(entry.owner)) {\n  71→      push('index.owner', entry.ac, 'owner must match ^T-\\\\d{3}$')\n  72→    }\n  73→    if (!MILESTONES.includes(entry.milestone)) {\n  74→      push('index.milestone', entry.ac, `milestone must be one of ${MILESTONES.join(',')}`)\n  75→    }\n  76→\n  77→    if (!isStringArray(entry.levels) || entry.levels.length === 0) {\n  78→      push('index.levels', entry.ac, 'levels must be a non-empty array of strings')\n  79→    } else {\n  80→      const unknown = entry.levels.filter((level) => !LEVELS.includes(level))\n  81→      const duplicates = entry.levels.filter((level, i) => entry.levels.indexOf(level) !== i)\n  82→      if (unknown.length > 0) push('index.levels', entry.ac, `unknown level(s): ${unknown.join(',')}`)\n  83→      if (duplicates.length > 0) push('index.levels', entry.ac, `duplicate level(s): ${duplicates.join(',')}`)\n  84→    }\n  85→\n  86→    if (!isStringArray(entry.baseline) || entry.baseline.length === 0) {\n  87→      push('index.baseline', entry.ac, 'baseline must be a non-empty array of strings')\n  88→    } else {\n  89→      const unknown = entry.baseline.filter((base) => !BASELINES.includes(base))\n  90→      const duplicates = entry.baseline.filter((base, i) => entry.baseline.indexOf(base) !== i)\n  91→      if (unknown.length > 0) push('index.baseline', entry.ac, `unknown baseline(s): ${unknown.join(',')}`)\n  92→      if (duplicates.length > 0) push('index.baseline', entry.ac, `duplicate baseline(s): ${duplicates.join(',')}`)\n  93→    }\n  94→\n  95→    if (isStringArray(entry.levels) && isStringArray(entry.baseline)) {\n  96→      const hasCodeLevel = entry.levels.some((level) => NON_SMOKE_LEVELS.includes(level))\n  97→      const hasSmoke = entry.levels.includes('smoke')\n  98→      const hasRealSmoke = entry.baseline.includes('real-smoke')\n  99→      const hasNativeOnly = entry.baseline.includes('win32') || entry.baseline.includes('darwin')\n 100→      if (hasCodeLevel && hasRealSmoke) {\n 101→        push('index.baseline_incompatible', entry.ac, 'real-smoke baseline cannot back code levels')\n 102→      }\n 103→      if (hasSmoke && hasNativeOnly) {\n 104→        push('index.baseline_incompatible', entry.ac, 'smoke levels only allow linux or real-smoke baselines')\n 105→      }\n 106→    }\n 107→  }\n 108→\n 109→  const expected = expectedAcs()\n 110→  const got = index.acs.map((entry) => (entry && typeof entry === 'object' ? entry.ac : undefined))\n 111→  const inOrder = got.length === expected.length && got.every((ac, i) => ac === expected[i])\n 112→  if (!inOrder) {\n 113→    const seen = new Set()\n 114→    const duplicates = new Set()\n 115→    for (const ac of got) {\n 116→      if (seen.has(ac)) duplicates.add(ac)\n 117→      seen.add(ac)\n 118→    }\n 119→    const parts = [`expected exactly ${expected[0]}..${expected[expected.length - 1]} in order`]\n 120→    parts.push(`got ${got.length} entries`)\n 121→    if (duplicates.size > 0) parts.push(`duplicates: ${[...duplicates].join(',')}`)\n 122→    push('index.count', undefined, parts.join(', '))\n 123→  }\n 124→\n 125→  return errors\n 126→}\n 127→\n 128→export function mergeShards({ root, index }) {\n 129→  const errors = []\n 130→  const shardDir = path.join(root, 'test', 'traceability')\n 131→  const owners = new Map()\n 132→  const indexAcs = []\n 133→  for (const entry of index?.acs ?? []) {\n 134→    if (!entry || typeof entry !== 'object') continue\n 135→    owners.set(entry.ac, entry.owner)\n 136→    indexAcs.push(entry.ac)\n 137→  }\n 138→\n 139→  let names = []\n 140→  try {\n 141→    names = fs.readdirSync(shardDir).filter((name) => name.endsWith('.json')).sort()\n 142→  } catch {\n 143→    names = []\n 144→  }\n 145→\n 146→  const declared = new Map()\n 147→\n 148→  for (const name of names) {\n 149→    const rel = `test/traceability/${name}`\n 150→    let shard\n 151→    try {\n 152→      shard = JSON.parse(fs.readFileSync(path.join(shardDir, name), 'utf8'))\n 153→    } catch {\n 154→      errors.push({ id: 'shard.schema', file: rel, detail: 'shard is not valid JSON' })\n 155→      continue\n 156→    }\n 157→    if (!shard || typeof shard !== 'object' || Array.isArray(shard)) {\n 158→      errors.push({ id: 'shard.schema', file: rel, detail: 'shard must be a JSON object' })\n 159→      continue\n 160→    }\n 161→\n 162→    const task = name.replace(/\\.json$/, '')\n 163→    if (typeof shard.task !== 'string' || shard.task !== task) {\n 164→      errors.push({ id: 'shard.schema', file: rel, detail: `task must be \"${task}\"` })\n 165→    }\n 166→    if (Object.prototype.hasOwnProperty.call(shard, 'baseline')) {\n 167→      errors.push({ id: 'shard.baseline_forbidden', file: rel, detail: 'shard must not declare baseline' })\n 168→    }\n 169→    if (!Array.isArray(shard.entries)) {\n 170→      errors.push({ id: 'shard.schema', file: rel, detail: 'entries must be an array' })\n 171→      continue\n 172→    }\n 173→\n 174→    for (const entry of shard.entries) {\n 175→      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {\n 176→        errors.push({ id: 'shard.schema', file: rel, detail: 'every entry must be a JSON object' })\n 177→        continue\n 178→      }\n 179→      if (Object.prototype.hasOwnProperty.call(entry, 'baseline')) {\n 180→        errors.push({\n 181→          id: 'shard.baseline_forbidden',\n 182→          ac: typeof entry.ac === 'string' ? entry.ac : undefined,\n 183→          file: rel,\n 184→          detail: 'entry must not declare baseline',\n 185→        })\n 186→      }\n 187→\n 188→      const ac = entry.ac\n 189→      const status = entry.status\n 190→      const files = entry.files\n 191→      if (\n 192→        typeof ac !== 'string' ||\n 193→        ac === '' ||\n 194→        (status !== 'covered' && status !== 'planned') ||\n 195→        !Array.isArray(files)\n 196→      ) {\n 197→        errors.push({\n 198→          id: 'shard.schema',\n 199→          ac: typeof ac === 'string' ? ac : undefined,\n 200→          file: rel,\n 201→          detail: 'entry needs ac, status (covered|planned) and files',\n 202→        })\n 203→        continue\n 204→      }\n 205→\n 206→      if (!owners.has(ac)) {\n 207→        errors.push({ id: 'shard.unknown_ac', ac, file: rel, detail: 'AC is not declared in the index' })\n 208→        continue\n 209→      }\n 210→\n 211→      if (declared.has(ac)) {\n 212→        const previous = declared.get(ac)\n 213→        errors.push({\n 214→          id: 'shard.duplicate',\n 215→          ac,\n 216→          file: rel,\n 217→          detail: previous.shard === rel ? 'duplicate within shard' : `already declared in ${previous.shard}`,\n 218→        })\n 219→      } else {\n 220→        declared.set(ac, { status, shard: rel })\n 221→      }\n 222→\n 223→      if (shard.task !== owners.get(ac)) {\n 224→        errors.push({\n 225→          id: 'shard.not_owner',\n 226→          ac,\n 227→          file: rel,\n 228→          detail: `owner is ${owners.get(ac)}`,\n 229→        })\n 230→      }\n 231→\n 232→      if (status !== 'covered') continue\n 233→\n 234→      let broken = false\n 235→      if (files.length === 0) {\n 236→        errors.push({ id: 'shard.missing_file', ac, file: rel, detail: 'covered entry needs at least one file' })\n 237→        broken = true\n 238→      }\n 239→      for (const file of files) {\n 240→        const unsafe =\n 241→          typeof file !== 'string' ||\n 242→          file === '' ||\n 243→          path.isAbsolute(file) ||\n 244→          file.split('/').includes('..') ||\n 245→          file.split('\\\\').includes('..')\n 246→        if (unsafe) {\n 247→          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `unsafe or empty path: ${String(file)}` })\n 248→          broken = true\n 249→          continue\n 250→        }\n 251→        if (!fs.existsSync(path.join(root, file))) {\n 252→          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `missing file: ${file}` })\n 253→          broken = true\n 254→        }\n 255→      }\n 256→      if (broken) continue\n 257→\n 258→      let tagged = false\n 259→      for (const file of files) {\n 260→        let source = ''\n 261→        try {\n 262→          source = fs.readFileSync(path.join(root, file), 'utf8')\n 263→        } catch {\n 264→          continue\n 265→        }\n 266→        if (extractTitles(source).some((item) => item.kind === 'plain' && item.title.includes(`[${ac}]`))) {\n 267→          tagged = true\n 268→          break\n 269→        }\n 270→      }\n 271→      if (!tagged) {\n 272→        errors.push({\n 273→          id: 'shard.missing_title',\n 274→          ac,\n 275→          file: rel,\n 276→          detail: `no plain test title contains [${ac}]`,\n 277→        })\n 278→      }\n 279→    }\n 280→  }\n 281→\n 282→  const acs = {}\n 283→  for (const ac of indexAcs) {\n 284→    const entry = declared.get(ac)\n 285→    acs[ac] = entry ? entry.status : 'planned'\n 286→  }\n 287→\n 288→  return { errors, acs }\n 289→}\n 290→\n 291→function checkTaskGraph(taskGraphPath, index) {\n 292→  const errors = []\n 293→  let graph\n 294→  try {\n 295→    graph = JSON.parse(fs.readFileSync(taskGraphPath, 'utf8'))\n 296→  } catch {\n 297→    errors.push({ id: 'graph.mismatch', detail: `cannot read task graph: ${taskGraphPath}` })\n 298→    return errors\n 299→  }\n 300→\n 301→  const owners = new Map()\n 302→  const milestones = new Map()\n 303→  for (const task of Array.isArray(graph.tasks) ? graph.tasks : []) {\n 304→    for (const ac of Array.isArray(task.acceptance) ? task.acceptance : []) {\n 305→      owners.set(ac, task.id)\n 306→      milestones.set(ac, task.milestone)\n 307→    }\n 308→  }\n 309→  const levels = new Map()\n 310→  for (const item of Array.isArray(graph.acceptance) ? graph.acceptance : []) {\n 311→    if (item && typeof item.id === 'string') levels.set(item.id, item.levels)\n 312→  }\n 313→\n 314→  const sameSet = (a, b) => {\n 315→    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false\n 316→    const left = [...a].sort()\n 317→    const right = [...b].sort()\n 318→    return left.every((value, i) => value === right[i])\n 319→  }\n 320→\n 321→  for (const entry of index?.acs ?? []) {\n 322→    if (!entry || typeof entry !== 'object') continue\n 323→    if (owners.get(entry.ac) !== entry.owner) {\n 324→      errors.push({\n 325→        id: 'graph.mismatch',\n 326→        ac: entry.ac,\n 327→        detail: `owner ${entry.owner} != task graph ${owners.get(entry.ac) ?? 'none'}`,\n 328→      })\n 329→    }\n 330→    if (milestones.get(entry.ac) !== entry.milestone) {\n 331→      errors.push({\n 332→        id: 'graph.mismatch',\n 333→        ac: entry.ac,\n 334→        detail: `milestone ${entry.milestone} != task graph ${milestones.get(entry.ac) ?? 'none'}`,\n 335→      })\n 336→    }\n 337→    if (levels.has(entry.ac) && !sameSet(levels.get(entry.ac), entry.levels)) {\n 338→      errors.push({\n 339→        id: 'graph.mismatch',\n 340→        ac: entry.ac,\n 341→        detail: `levels ${JSON.stringify(entry.levels)} != task graph ${JSON.stringify(levels.get(entry.ac))}`,\n 342→      })\n 343→    }\n 344→  }\n 345→\n 346→  return errors\n 347→}\n 348→\n 349→function fail(message) {\n 350→  console.error(message)\n 351→  process.exitCode = 2\n 352→}\n 353→\n 354→function takeValue(args, index, flag) {\n 355→  const value = args[index + 1]\n 356→  if (typeof value !== 'string' || value === '') {\n 357→    fail(`${flag} requires a value`)\n 358→    return null\n 359→  }\n 360→  return value\n 361→}\n 362→\n 363→function main() {\n 364→  const args = process.argv.slice(2)\n 365→  let root = REPO_ROOT\n 366→  let indexPath = null\n 367→  let taskGraphPath = null\n 368→  let json = false\n 369→\n 370→  for (let i = 0; i < args.length; i += 1) {\n 371→    const flag = args[i]\n 372→    if (flag === '--root') {\n 373→      const value = takeValue(args, i, flag)\n 374→      if (value === null) return\n 375→      root = path.resolve(value)\n 376→      i += 1\n 377→    } else if (flag === '--index') {\n 378→      const value = takeValue(args, i, flag)\n 379→      if (value === null) return\n 380→      indexPath = path.resolve(value)\n 381→      i += 1\n 382→    } else if (flag === '--task-graph') {\n 383→      const value = takeValue(args, i, flag)\n 384→      if (value === null) return\n 385→      taskGraphPath = path.resolve(value)\n 386→      i += 1\n 387→    } else if (flag === '--json') {\n 388→      json = true\n 389→    } else {\n 390→      fail(`unknown argument: ${flag}\\nusage: node scripts/check-traceability.mjs [--root <dir>] [--index <file>] [--task-graph <file>] [--json]`)\n 391→      return\n 392→    }\n 393→  }\n 394→\n 395→  const indexFile = indexPath ?? path.join(root, 'contracts', 'spec', 'ac-index.json')\n 396→  const errors = []\n 397→\n 398→  let index = null\n 399→  try {\n 400→    index = JSON.parse(fs.readFileSync(indexFile, 'utf8'))\n 401→  } catch {\n 402→    errors.push({ id: 'index.schema', detail: `cannot read index: ${indexFile}` })\n 403→  }\n 404→\n 405→  let acs = {}\n 406→  if (index) {\n 407→    errors.push(...validateIndex(index))\n 408→    const merged = mergeShards({ root, index })\n 409→    errors.push(...merged.errors)\n 410→    acs = merged.acs\n 411→  }\n 412→  if (taskGraphPath && index) errors.push(...checkTaskGraph(taskGraphPath, index))\n 413→\n 414→  const entries = Object.keys(acs)\n 415→    .sort()\n 416→    .map((ac) => ({ ac, status: acs[ac] }))\n 417→  const covered = entries.filter((item) => item.status === 'covered').length\n 418→  const planned = entries.filter((item) => item.status === 'planned').length\n 419→\n 420→  if (json) {\n 421→    const payload = {\n 422→      ok: errors.length === 0,\n 423→      errors: errors.map((error) => {\n 424→        const out = { id: error.id }\n 425→        if (error.ac !== undefined) out.ac = error.ac\n 426→        if (error.file !== undefined) out.file = error.file\n 427→        out.detail = error.detail ?? ''\n 428→        return out\n 429→      }),\n 430→      covered,\n 431→      planned,\n 432→      acs: entries,\n 433→    }\n 434→    process.stdout.write(`${JSON.stringify(payload, null, 2)}\\n`)\n 435→  } else {\n 436→    for (const error of errors) {\n 437→      const where = error.ac ?? error.file ?? '-'\n 438→      process.stdout.write(`FAIL ${error.id} ${where} ${error.detail ?? ''}`.trimEnd() + '\\n')\n 439→    }\n 440→    if (errors.length > 0) {\n 441→      process.stdout.write(`check-traceability: FAILED (${errors.length} errors)\\n`)\n 442→    } else {\n 443→      process.stdout.write(`check-traceability: ok (covered=${covered} planned=${planned})\\n`)\n 444→    }\n 445→  }\n 446→\n 447→  process.exitCode = errors.length > 0 ? 1 : 0\n 448→}\n 449→\n 450→const invokedDirectly =\n 451→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 452→\n 453→if (invokedDirectly) main()\n 454→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b7154dda78d7a7ceb87b22702965","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b7154dda78d7a7ceb87b22702965","codebuddy.ai/llmMessageId":"01a1b7154dda78d7a7ceb87b22702965","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:30.810Z"}
