    },\n    writeFileSync(p, data) {\n      store.set(track('writeFileSync', p), String(data))\n    },\n    appendFileSync(p, data) {\n      const resolved = track('appendFileSync', p)\n      store.set(resolved, (store.get(resolved) || '') + String(data))\n    },\n    mkdirSync(p) {\n      track('mkdirSync', p)\n      return undefined\n    },\n    existsSync(p) {\n      const resolved = track('existsSync', p)\n      return store.has(resolved) || hasDir(resolved)\n    },\n    statSync(p) {\n      const resolved = track('statSync', p)\n      if (store.has(resolved)) return { isFile: () => true, isDirectory: () => false, size: store.get(resolved).length }\n      if (hasDir(resolved)) return { isFile: () => false, isDirectory: () => true, size: 0 }\n      throw miss(resolved)\n    },\n    readdirSync(p) {\n      const resolved = track('readdirSync', p)\n      const prefix = resolved.endsWith(path.sep) ? resolved : resolved + path.sep\n      const names = []\n      for (const key of store.keys()) {\n        if (!key.startsWith(prefix)) continue\n        const name = key.slice(prefix.length).split(path.sep)[0]\n        if (!names.includes(name)) names.push(name)\n      }\n      if (names.length === 0) throw miss(resolved)\n      return names\n    },\n    renameSync(from, to) {\n      const source = track('renameSync', from)\n      if (!store.has(source)) throw miss(source)\n      store.set(norm(to), store.get(source))\n      store.delete(source)\n    },\n    rmSync(p) {\n      store.delete(track('rmSync', p))\n    },\n  }\n\n  api.files = store\n  api.accessed = accessed\n  return api\n}\n\nexport function fakeFetch() {\n  const calls = []\n  const fn = (url, init) => {\n    calls.push({ url, init })\n    return Promise.reject(new Error('fakeFetch: no network'))\n  }\n  fn.calls = calls\n  return fn\n}\n\nexport const fakeClock = createFakeClock\n\nexport function createFakeContext({ files, env, platform, exec, now } = {}) {\n  const clock = createFakeClock(now === undefined ? {} : { start: now })\n  const fs = fakeFs(files || {})\n  let seed = 20261107\n  const random = () => {\n    seed = (seed * 1103515245 + 12345) % 2147483648\n    return seed / 2147483648\n  }\n\n  return {\n    exec: fakeExec(exec),\n    fs,\n    fetch: fakeFetch(),\n    env: env || {},\n    platform: platform || 'linux',\n    stdout: fakeStream(),\n    stderr: fakeStream(),\n    random,\n    clock,\n    now: () => clock.now(),\n  }\n}\n","file_path":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\003\\test\\helpers\\ctx.mjs"}}],"model":"deepseek-v4.1-flash","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":116861,"output_tokens":2496,"cache_creation_input_tokens":0,"cache_read_input_tokens":116224,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b71779167cb0a9ba824f5537f44a","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b71779167cb0a9ba824f5537f44a","codebuddy.ai/llmMessageId":"01a1b71779167cb0a9ba824f5537f44a","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:39:02.239Z"}
