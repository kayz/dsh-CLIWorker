{"type":"user","uuid":"01a1b715-7f61-7336-97b1-e159bc13f624","session_id":"01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_07QHkgcjcDYiyWl5Op6Z2189","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→import os from 'node:os'\n   5→import path from 'node:path'\n   6→import { selectModels, listModels } from '../../lib/select.mjs'\n   7→import { forecast, estimateCost } from '../../lib/forecast.mjs'\n   8→\n   9→function config() {\n  10→  return {\n  11→    providers: {\n  12→      claude: { cli: 'claude', adapter: 'claude', readonly: true },\n  13→      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\n  14→      codex: { cli: 'codex', adapter: 'codex', readonly: true },\n  15→    },\n  16→    models: {\n  17→      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\n  18→      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\n  19→      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\n  20→      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\n  21→    },\n  22→    quotas: {},\n  23→  }\n  24→}\n  25→\n  26→test('deprecated and unverified models never enter candidates', () => {\n  27→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  28→  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\n  29→  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\n  30→  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\n  31→  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\n  32→})\n  33→\n  34→test('read-only requirement rejects providers without it', () => {\n  35→  const c = config()\n  36→  c.models.b.readonly = false\n  37→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  38→  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\n  39→  assert.deepEqual(r.models.map((m) => m.key), ['a'])\n  40→  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\n  41→})\n  42→\n  43→test('forecast is unknown without samples and deterministic with fixed samples', () => {\n  44→  assert.equal(forecast({ records: [], model: 'a' }).status, 'unknown')\n  45→  const now = Date.parse('2026-11-07T00:00:00Z')\n  46→  const records = [\n  47→    { model: 'a', at: '2026-11-06T23:00:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n  48→    { model: 'a', at: '2026-11-06T23:30:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n  49→  ]\n  50→  const f = forecast({ records, model: 'a', now, quota: { remaining_usd: 100 } })\n  51→  assert.equal(f.status, 'known')\n  52→  assert.equal(f.burn_per_task, 10)\n  53→  assert.equal(f.tasks_left, 10)\n  54→  assert.equal(f.risk, 'ok')\n  55→  assert.equal(estimateCost({ input_tokens: 1_000_000, output_tokens: 0, prices: { input_per_mtok: 10, output_per_mtok: 20 } }), 10)\n  56→})\n  57→\n  58→test('models list hides deprecated by default, includes with flag', () => {\n  59→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  60→  const a = listModels(config(), { status })\n  61→  assert.ok(!a.some((m) => m.key === 'old'))\n  62→  const b = listModels(config(), { status, includeDeprecated: true })\n  63→  assert.ok(b.some((m) => m.key === 'old' && m.deprecated))\n  64→})\n  65→\n  66→\n  67→test('requests return CLI calls and honor level/usage/count', () => {\n  68→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  69→  const c = config()\n  70→  c.models.a.level = 'Top'; c.models.b.level = 'Top'; c.models.old.level = 'Top'; c.models.unverified.level = 'High'\n  71→  const r = selectModels(c, { level: 'Top', count: 2, usage: 'Heavy' }, { status })\n  72→  assert.equal(r.ok, true)\n  73→  assert.equal(r.level, 'Top')\n  74→  assert.equal(r.calls.length, 2)\n  75→  assert.ok(r.calls.every((x) => x.command && Array.isArray(x.args) && x.input === 'stdin'))\n  76→  assert.equal(r.calls[0].cwd, '<workspace>')\n  77→})\n  78→\n  79→test('missing level is rejected and no model is returned', () => {\n  80→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  81→  const r = selectModels(config(), { count: 2 }, { status })\n  82→  assert.equal(r.ok, false)\n  83→  assert.equal(r.reason, 'E_LEVEL_REQUIRED')\n  84→  assert.deepEqual(r.models, [])\n  85→})\n  86→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7152cb2753b9f50a0ddd8a56816","_messageId":"01a1b715743570678c708cb574e15c28","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7152cb2753b9f50a0ddd8a56816","codebuddy.ai/modelRequestId":"01a1b715743570678c708cb574e15c28","codebuddy.ai/llmMessageId":"01a1b715743570678c708cb574e15c28","traceparent":"00-ab582e66778689ad02f0c1bc3f32c494-923d627b0a0b3bd8-01","baggage":"codebuddy.session_id=01a1b715-27ed-7fbb-b7b5-ecb1f10e3c39,codebuddy.conversation_request_id=01a1b7152cb2753b9f50a0ddd8a56816"},"__timestamp":"2026-11-07T17:36:41.827Z"}
