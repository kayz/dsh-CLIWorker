ncludes('..')\n        if (unsafe) {\n          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `unsafe or empty path: ${String(file)}` })\n          broken = true\n          continue\n        }\n        if (!fs.existsSync(path.join(root, file))) {\n          errors.push({ id: 'shard.missing_file', ac, file: rel, detail: `missing file: ${file}` })\n          broken = true\n        }\n      }\n      if (broken) continue\n\n      let tagged = false\n      for (const file of files) {\n        let source = ''\n        try {\n          source = fs.readFileSync(path.join(root, file), 'utf8')\n        } catch {\n          continue\n        }\n        if (extractTitles(source).some((item) => item.kind === 'plain' && item.title.includes(`[${ac}]`))) {\n          tagged = true\n          break\n        }\n      }\n      if (!tagged) {\n        errors.push({\n          id: 'shard.missing_title',\n          ac,\n          file: rel,\n          detail: `no plain test title contains [${ac}]`,\n        })\n      }\n    }\n  }\n\n  const acs = {}\n  for (const ac of indexAcs) {\n    const entry = declared.get(ac)\n    acs[ac] = entry ? entry.status : 'planned'\n  }\n\n  return { errors, acs }\n}\n\n\nStderr: (empty)\nExit Code: 0\nSignal: (none)"}],"is_error":false,"_meta":{"rawResponse":{"exitCode":0,"signal":null,"interrupted":false,"sandboxDenied":false,"stderrBytesTruncated":0,"stdoutBytesTruncated":0,"tool_error_code":"0"},"renderer":{"type":"text","value":"      }\n\n      const ac = entry.ac\n      const status = entry.status\n      const files = entry.files\n      if (\n        typeof ac !== 'string' ||\n        ac === '' ||\n        (status !== 'covered' && status !== 'planned') ||\n        !Array.isArray(files)\n      ) {\n        errors.push({\n          id: 'shard.schema',\n          ac: typeof ac === 'string' ? ac : undefined,\n          file: rel,\n          detail: 'entry needs ac, status (covered|planned) and files',\n        })\n        continue\n   