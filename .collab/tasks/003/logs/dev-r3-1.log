== contracts/host/dsh-host.v1.json ===\n{\n  \"contract\": \"dsh-host\",\n  \"version\": 1,\n  \"host_ctx\": {\n    \"inject\": {\n      \"params\": [\"services\", \"callback\"],\n      \"callback_arg\": \"httpCtx\",\n      \"callback_timing\": \"synchronous when the services are present\"\n    }\n  },\n  \"http_ctx\": {\n    \"effect\": { \"params\": [\"fn\", \"name\"], \"returns\": \"result of fn\", \"on_error\": \"propagates\" },\n    \"webServer\": { \"register\": { \"params\": [\"registration\"], \"on_error\": \"throws\" } }\n  },\n  \"registration\": { \"kind\": [\"exact\"], \"path\": \"string starting with /\", \"handler\": \"function(req, res)\" },\n  \"request\": { \"required\": [\"socket.remoteAddress\", \"headers\"], \"optional\": [\"method\", \"url\"] },\n  \"response\": { \"required\": [\"statusCode\", \"setHeader\", \"end\"] },\n  \"stub_controllable_inputs\": [\"remoteAddress\", \"host\", \"origin\"],\n  \"plugin_exports\": {\n    \"createPlugin\": { \"returns\": [\"registered\", \"errors\"] },\n    \"getRegistration\": { \"returns\": [\"status\", \"registered\", \"errors\"], \"status\": [\"ok\", \"failed\"] },\n    \"apply\": { \"strict_throws_on_errors\": true }\n  }\n}"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b731d6e7736890817c92a33f6c9f","_messageId":"01a1b732204b7d50a2e2d6819b5387a6","_meta":{"codebuddy.ai/conversationRequestId":"01a1b731d6e7736890817c92a33f6c9f","codebuddy.ai/modelRequestId":"01a1b732204b7d50a2e2d6819b5387a6","codebuddy.ai/llmMessageId":"01a1b732204b7d50a2e2d6819b5387a6","traceparent":"00-66c31ac78cd0a2236b80cd0371071d2c-fe8ac930fb80ca34-01","baggage":"codebuddy.session_id=01a1b731-d2ed-771a-94b2-ef325b848c31,codebuddy.conversation_request_id=01a1b731d6e7736890817c92a33f6c9f"},"__timestamp":"2026-11-07T18:08:01.204Z"}
