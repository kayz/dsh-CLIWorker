{"type":"user","uuid":"01a1b721-d6a4-7d47-8874-a8adaa26f68b","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_bkH6huEZB3vgdmBNtFf30851","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import { run } from './exec.mjs'\n   3→\n   4→export const TEST_CLOCK_ENV = 'CLIWORKER_TEST_CLOCK_FILE'\n   5→\n   6→const NUMBER_RE = /^[0-9]+(\\.[0-9]+)?$/\n   7→\n   8→function resolve(value, fallback) {\n   9→  return value === undefined ? fallback : value\n  10→}\n  11→\n  12→export function createRealClock({ env, fs: fsApi } = {}) {\n  13→  const readEnv = env || {}\n  14→  const io = fsApi || fs\n  15→\n  16→  const clock = {\n  17→    now() {\n  18→      const file = readEnv[TEST_CLOCK_ENV]\n  19→      if (typeof file !== 'string' || file === '') return Date.now()\n  20→      const raw = String(io.readFileSync(file, 'utf8')).trim()\n  21→      const value = NUMBER_RE.test(raw) ? Number(raw) : Date.parse(raw)\n  22→      if (!Number.isFinite(value)) throw new Error(`invalid ${TEST_CLOCK_ENV} content`)\n  23→      return value\n  24→    },\n  25→    nowIso() {\n  26→      return new Date(clock.now()).toISOString()\n  27→    },\n  28→    setTimeout(fn, ms) {\n  29→      return setTimeout(fn, ms)\n  30→    },\n  31→    clearTimeout(handle) {\n  32→      clearTimeout(handle)\n  33→    },\n  34→    sleep(ms) {\n  35→      return new Promise((done) => { setTimeout(done, ms) })\n  36→    },\n  37→  }\n  38→\n  39→  return clock\n  40→}\n  41→\n  42→export function createContext(overrides = {}) {\n  43→  const o = overrides || {}\n  44→  const env = resolve(o.env, process.env)\n  45→  const fsApi = resolve(o.fs, fs)\n  46→  const exec = resolve(o.exec, run)\n  47→  const clock = resolve(o.clock, createRealClock({ env, fs: fsApi }))\n  48→\n  49→  return {\n  50→    exec,\n  51→    fs: fsApi,\n  52→    fetch: resolve(o.fetch, (...a) => globalThis.fetch(...a)),\n  53→    env,\n  54→    platform: resolve(o.platform, process.platform),\n  55→    stdout: resolve(o.stdout, process.stdout),\n  56→    stderr: resolve(o.stderr, process.stderr),\n  57→    random: resolve(o.random, () => Math.random()),\n  58→    clock,\n  59→    now: resolve(o.now, () => clock.now()),\n  60→  }\n  61→}\n  62→\n  63→export function systemNow() {\n  64→  return createRealClock({ env: process.env, fs }).now()\n  65→}\n  66→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b721cb9c701ab1ca895c32e5a058","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b721cb9c701ab1ca895c32e5a058","codebuddy.ai/llmMessageId":"01a1b721cb9c701ab1ca895c32e5a058","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:50:10.597Z"}
{"type":"user","uuid":"01a1b721-d6ac-71f5-a72f-1b97ee835efd","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_qULK8ZmE7r9dwiy9PFNj0273","content":[{"type":"text","text":"   1→import { spawnSync } from 'node:child_process'\n   2→\n   3→export function run(command, args = [], { timeout = 20_000 } = {}) {\n   4→  try {\n   5→    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n   6→    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n   7→  } catch (e) {\n   8→    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n   9→  }\n  10→}\n  11→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b721cb9c701ab1ca895c32e5a058","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b721cb9c701ab1ca895c32e5a058","codebuddy.ai/llmMessageId":"01a1b721cb9c701ab1ca895c32e5a058","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:50:10.605Z"}
{"type":"user","uuid":"01a1b721-d6b6-7ed7-be22-3c74a763a0ac","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_JtIfppKqM8aXfBX9IpLz9837","content":[{"type":"text","text":"   1→import { loadConfig } from './config.mjs'\n   2→import * as providersList from './commands/providers/list.mjs'\n   3→import * as modelsList from './commands/models/list.mjs'\n   4→import * as modelsSelect from './commands/models/select.mjs'\n   5→import * as modelsForecast from './commands/models/forecast.mjs'\n   6→import * as usageRecord from './commands/usage/record.mjs'\n   7→import * as usageSummary from './commands/usage/summary.mjs'\n   8→import { arg } from './commands/_util.mjs'\n   9→\n  10→const USAGE = 'usage: cliworker providers | models list|select|forecast | usage record|summary'\n  11→\n  12→const ROUTES = [\n  13→  { cmd: 'providers', sub: null, module: providersList },\n  14→  { cmd: 'models', sub: null, module: modelsList },\n  15→  { cmd: 'models', sub: 'select', module: modelsSelect },\n  16→  { cmd: 'models', sub: 'forecast', module: modelsForecast },\n  17→  { cmd: 'usage', sub: 'record', module: usageRecord },\n  18→  { cmd: 'usage', sub: 'summary', module: usageSummary },\n  19→]\n  20→\n  21→function resolveRoute(argv) {\n  22→  const cmd = argv[0]\n  23→  let sub = argv[1] === undefined ? null : argv[1]\n  24→  if (cmd === 'providers') sub = null\n  25→  else if (cmd === 'models') { if (sub === '' || sub === 'list') sub = null }\n  26→  else if (cmd !== 'usage') return null\n  27→  const match = ROUTES.find((route) => route.cmd === cmd && route.sub === sub)\n  28→  return match ? match.module : null\n  29→}\n  30→\n  31→function warnAboutTestClock(ctx, result) {\n  32→  const file = ctx.env ? ctx.env.CLIWORKER_TEST_CLOCK_FILE : undefined\n  33→  if (typeof file !== 'string' || file === '') return\n  34→  if (!result || typeof result !== 'object') return\n  35→  if (Array.isArray(result.warnings)) result.warnings.push({ code: 'W_TEST_CLOCK' })\n  36→  else result.warnings = [{ code: 'W_TEST_CLOCK' }]\n  37→}\n  38→\n  39→export async function main(argv, ctx) {\n  40→  const route = resolveRoute(argv)\n  41→  if (!route) {\n  42→    ctx.stderr.write(`ERROR: ${USAGE}\\n`)\n  43→    return { exitCode: 1 }\n  44→  }\n  45→  try {\n  46→    const config = loadConfig({ file: arg(argv, '--config'), ctx })\n  47→    const result = await route.run({ argv, ctx, config })\n  48→    warnAboutTestClock(ctx, result)\n  49→    ctx.stdout.write(JSON.stringify(result, null, 2) + '\\n')\n  50→    return { exitCode: 0 }\n  51→  } catch (e) {\n  52→    ctx.stderr.write(`ERROR: ${e.message}\\n`)\n  53→    return { exitCode: e.exitCode ?? 1 }\n  54→  }\n  55→}\n  56→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b721cb9c701ab1ca895c32e5a058","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b721cb9c701ab1ca895c32e5a058","codebuddy.ai/llmMessageId":"01a1b721cb9c701ab1ca895c32e5a058","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:50:10.616Z"}
