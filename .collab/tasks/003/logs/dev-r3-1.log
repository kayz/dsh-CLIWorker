{"type":"user","uuid":"01a1b732-31dc-78a1-a161-92ddeb23dfc7","session_id":"01a1b731-d2ed-771a-94b2-ef325b848c31","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_CW336eneL8XTK3UiJY7A0241","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Seam check: the injectable edges (process spawn, file system, wall clock, timers) may only be\n   3→// touched inside the modules that own them. Everything else must go through ctx.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   9→const REPO_ROOT = path.resolve(HERE, '..')\n  10→const USAGE = 'usage: node scripts/check-seams.mjs [--root <dir>] [--json]'\n  11→const SOURCE_EXT = /\\.(mjs|js|cjs)$/\n  12→\n  13→const ALLOWED = {\n  14→  'seams.child_process': ['lib/exec.mjs'],\n  15→  'seams.fs': ['lib/context.mjs', 'lib/store.mjs', 'lib/fsx.mjs'],\n  16→  'seams.date_now': ['lib/context.mjs'],\n  17→  'seams.new_date': ['lib/context.mjs'],\n  18→  'seams.set_timeout': ['lib/context.mjs'],\n  19→  'seams.set_interval': ['lib/context.mjs'],\n  20→  'seams.set_immediate': ['lib/context.mjs'],\n  21→  'seams.node_timers': ['lib/context.mjs'],\n  22→  'seams.wall_clock': ['lib/context.mjs'],\n  23→  'seams.process_exit': [],\n  24→}\n  25→\n  26→const SPECIFIER_RULES = new Map([\n  27→  ['node:child_process', 'seams.child_process'],\n  28→  ['child_process', 'seams.child_process'],\n  29→  ['node:fs', 'seams.fs'],\n  30→  ['fs', 'seams.fs'],\n  31→  ['node:fs/promises', 'seams.fs'],\n  32→  ['fs/promises', 'seams.fs'],\n  33→  ['node:timers', 'seams.node_timers'],\n  34→  ['timers', 'seams.node_timers'],\n  35→  ['node:timers/promises', 'seams.node_timers'],\n  36→  ['timers/promises', 'seams.node_timers'],\n  37→])\n  38→\n  39→const TIMER_RULE = new Map([\n  40→  ['setTimeout', 'seams.set_timeout'],\n  41→  ['setInterval', 'seams.set_interval'],\n  42→  ['setImmediate', 'seams.set_immediate'],\n  43→])\n  44→\n  45→function blankLineEnding(ch) {\n  46→  return ch === '\\n' || ch === '\\r'\n  47→}\n  48→\n  49→/**\n  50→ * Produces two same-length views of the source: `code` has comments blanked (string literals\n  51→ * intact), `bare` has comments and string/template contents blanked. Blanking keeps newlines so\n  52→ * line numbers stay exact.\n  53→ */\n  54→function maskSource(source) {\n  55→  const text = String(source ?? '')\n  56→  const size = text.length\n  57→  const code = text.split('')\n  58→  const bare = text.split('')\n  59→  const stringRanges = []\n  60→\n  61→  const blankAll = (index) => {\n  62→    code[index] = ' '\n  63→    if (!blankLineEnding(bare[index])) bare[index] = ' '\n  64→  }\n  65→\n  66→  let i = 0\n  67→  while (i < size) {\n  68→    const ch = text[i]\n  69→    const next = text[i + 1]\n  70→\n  71→    if (ch === '/' && next === '/') {\n  72→      while (i < size && text[i] !== '\\n') { blankAll(i); i += 1 }\n  73→      continue\n  74→    }\n  75→    if (ch === '/' && next === '*') {\n  76→      blankAll(i)\n  77→      blankAll(i + 1)\n  78→      i += 2\n  79→      while (i < size && !(text[i] === '*' && text[i + 1] === '/')) { blankAll(i); i += 1 }\n  80→      if (i < size) { blankAll(i); blankAll(i + 1); i += 2 }\n  81→      continue\n  82→    }\n  83→    if (ch === \"'\" || ch === '\"' || ch === '`') {\n  84→      const quote = ch\n  85→      const start = i\n  86→      i += 1\n  87→      while (i < size) {\n  88→        if (text[i] === '\\\\') {\n  89→          if (!blankLineEnding(bare[i])) bare[i] = ' '\n  90→          if (i + 1 < size && !blankLineEnding(bare[i + 1])) bare[i + 1] = ' '\n  91→          i += 2\n  92→          continue\n  93→        }\n  94→        if (text[i] === quote) { i += 1; break }\n  95→        if (text[i] === '\\n' && quote !== '`') { i += 1; break }\n  96→        if (!blankLineEnding(bare[i])) bare[i] = ' '\n  97→        i += 1\n  98→      }\n  99→      stringRanges.push([start, i])\n 100→      continue\n 101→    }\n 102→    i += 1\n 103→  }\n 104→\n 105→  return { code: code.join(''), bare: bare.join(''), stringRanges }\n 106→}\n 107→\n 108→function insideRanges(ranges, index) {\n 109→  for (const [start, end] of ranges) {\n 110→    if (index >= start && index < end) return true\n 111→  }\n 112→  return false\n 113→}\n 114→\n 115→function lineAt(source, index) {\n 116→  let line = 1\n 117→  for (let i = 0; i < index && i < source.length; i += 1) if (source[i] === '\\n') line += 1\n 118→  return line\n 119→}\n 120→\n 121→function collectImportSpecifiers(masked) {\n 122→  const found = []\n 123→  const patterns = [\n 124→    /\\bfrom\\s*(['\"])([^'\"\\n]+)\\1/g,\n 125→    /\\bimport\\s*\\(\\s*(['\"])([^'\"\\n]+)\\1/g,\n 126→    /\\brequire\\s*\\(\\s*(['\"])([^'\"\\n]+)\\1/g,\n 127→    /(?:^|[\\s;])import\\s*(['\"])([^'\"\\n]+)\\2/g,\n 128→  ]\n 129→  for (const pattern of patterns) {\n 130→    for (const match of masked.code.matchAll(pattern)) {\n 131→      if (insideRanges(masked.stringRanges, match.index)) continue\n 132→      found.push({ index: match.index, specifier: match[2] })\n 133→    }\n 134→  }\n 135→  return found\n 136→}\n 137→\n 138→function newDateHasNoArgument(bare, index, length) {\n 139→  let i = index + length\n 140→  while (i < bare.length && /\\s/.test(bare[i])) i += 1\n 141→  if (bare[i] !== '(') return true\n 142→  i += 1\n 143→  while (i < bare.length && /\\s/.test(bare[i])) i += 1\n 144→  return bare[i] === ')'\n 145→}\n 146→\n 147→function collectViolations(relPath, source) {\n 148→  const masked = maskSource(source)\n 149→  const allowed = (rule) => (ALLOWED[rule] || []).includes(relPath)\n 150→  const found = []\n 151→\n 152→  const push = (rule, index) => {\n 153→    if (allowed(rule)) return\n 154→    found.push({ rule, file: relPath, line: lineAt(source, index) })\n 155→  }\n 156→\n 157→  for (const item of collectImportSpecifiers(masked)) {\n 158→    const rule = SPECIFIER_RULES.get(item.specifier)\n 159→    if (rule) push(rule, item.index)\n 160→  }\n 161→\n 162→  for (const match of masked.bare.matchAll(/Date\\s*\\.\\s*now\\b/g)) push('seams.date_now', match.index)\n 163→\n 164→  for (const match of masked.bare.matchAll(/\\bnew\\s+Date\\b/g)) {\n 165→    if (newDateHasNoArgument(masked.bare, match.index, match[0].length)) push('seams.new_date', match.index)\n 166→  }\n 167→\n 168→  for (const match of masked.bare.matchAll(/(^|[^\\w$.])(setTimeout|setInterval|setImmediate)\\b/g)) {\n 169→    push(TIMER_RULE.get(match[2]), match.index + match[1].length)\n 170→  }\n 171→  for (const match of masked.bare.matchAll(/(^|[^\\w$.])(?:globalThis|global|window)\\s*\\.\\s*(setTimeout|setInterval|setImmediate)\\b/g)) {\n 172→    push(TIMER_RULE.get(match[2]), match.index + match[1].length)\n 173→  }\n 174→\n 175→  for (const match of masked.bare.matchAll(/performance\\s*\\.\\s*now\\b|\\bprocess\\s*\\.\\s*hrtime\\b|\\bhrtime\\s*\\.\\s*bigint\\b/g)) {\n 176→    push('seams.wall_clock', match.index)\n 177→  }\n 178→\n 179→  for (const match of masked.bare.matchAll(/\\bprocess\\s*\\.\\s*exit\\b/g)) push('seams.process_exit', match.index)\n 180→\n 181→  return found\n 182→}\n 183→\n 184→function walk(dir, prefix, found) {\n 185→  let entries\n 186→  try {\n 187→    entries = fs.readdirSync(dir, { withFileTypes: true })\n 188→  } catch {\n 189→    return\n 190→  }\n 191→  for (const entry of entries.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))) {\n 192→    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`\n 193→    const full = path.join(dir, entry.name)\n 194→    if (entry.isDirectory()) walk(full, rel, found)\n 195→    else if (entry.isFile() && SOURCE_EXT.test(entry.name)) found.push({ rel, full })\n 196→  }\n 197→}\n 198→\n 199→export function scanRoot({ root = REPO_ROOT } = {}) {\n 200→  const files = []\n 201→  walk(path.join(path.resolve(root), 'lib'), 'lib', files)\n 202→\n 203→  const violations = []\n 204→  for (const file of files) {\n 205→    let source = ''\n 206→    try {\n 207→      source = fs.readFileSync(file.full, 'utf8')\n 208→    } catch {\n 209→      continue\n 210→    }\n 211→    violations.push(...collectViolations(file.rel, source))\n 212→  }\n 213→\n 214→  violations.sort((a, b) => {\n 215→    if (a.file !== b.file) return a.file < b.file ? -1 : 1\n 216→    if (a.line !== b.line) return a.line - b.line\n 217→    if (a.rule !== b.rule) return a.rule < b.rule ? -1 : 1\n 218→    return 0\n 219→  })\n 220→\n 221→  return { files: files.length, violations }\n 222→}\n 223→\n 224→function main() {\n 225→  const args = process.argv.slice(2)\n 226→  let root = REPO_ROOT\n 227→  let json = false\n 228→\n 229→  for (let i = 0; i < args.length; i += 1) {\n 230→    const flag = args[i]\n 231→    if (flag === '--root') {\n 232→      const value = args[i + 1]\n 233→      if (typeof value !== 'string' || value === '') {\n 234→        process.stderr.write(`--root requires a directory\\n${USAGE}\\n`)\n 235→        process.exitCode = 2\n 236→        return\n 237→      }\n 238→      root = path.resolve(value)\n 239→      i += 1\n 240→    } else if (flag === '--json') {\n 241→      json = true\n 242→    } else {\n 243→      process.stderr.write(`unknown argument: ${flag}\\n${USAGE}\\n`)\n 244→      process.exitCode = 2\n 245→      return\n 246→    }\n 247→  }\n 248→\n 249→  const { files, violations } = scanRoot({ root })\n 250→\n 251→  if (json) {\n 252→    process.stdout.write(`${JSON.stringify({ ok: violations.length === 0, files, violations }, null, 2)}\\n`)\n 253→    process.exitCode = violations.length === 0 ? 0 : 1\n 254→    return\n 255→  }\n 256→\n 257→  for (const item of violations) process.stdout.write(`FAIL ${item.rule} ${item.file}:${item.line}\\n`)\n 258→  process.stdout.write(\n 259→    violations.length === 0\n 260→      ? `check-seams: ok (files=${files})\\n`\n 261→      : `check-seams: FAILED (${violations.length} violations)\\n`\n 262→  )\n 263→  process.exitCode 