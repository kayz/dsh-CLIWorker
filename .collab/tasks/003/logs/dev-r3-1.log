{"type":"assistant","uuid":"01a1b723-b1fb-7cda-9dd4-8ed2ed35f590","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"id":"01a1b72394ba7d0b9fa23abf97e6c1ad","content":[{"type":"tool_use","id":"call_03_2flmsNPdstzJDURkxglg3437","name":"Read","input":{"file_path":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\003\\lib\\forecast.mjs"}}],"model":"deepseek-v4.1-flash","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":99135,"output_tokens":964,"cache_creation_input_tokens":0,"cache_read_input_tokens":96256,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b72394ba7d0b9fa23abf97e6c1ad","codebuddy.ai/llmMessageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:52:12.283Z"}
{"type":"user","uuid":"01a1b723-b1fd-7de3-8183-ddeacacc3146","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_uQPaZlu6eicETBqo57Yn0645","content":[{"type":"text","text":"   1→/**\n   2→ * dsh-cliworker — DSH host plugin.\n   3→ *\n   4→ * AgentLine and other clients only need the model source pointer:\n   5→ *   modelSource = { kind: \"cliworker\", command: \"node\",\n   6→ *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n   7→ *\n   8→ * The plugin exposes the same selection contract over DSH routes for UI use.\n   9→ */\n  10→import path from 'node:path'\n  11→import { createContext } from './context.mjs'\n  12→import { loadConfig, defaultHome } from './config.mjs'\n  13→import { providerStatus } from './availability.mjs'\n  14→import { listModels, selectModels } from './select.mjs'\n  15→import { forecast } from './forecast.mjs'\n  16→\n  17→export const name = 'cliworker'\n  18→\n  19→let report = null\n  20→\n  21→function send(res, body, code = 200) {\n  22→  res.statusCode = code\n  23→  res.setHeader('content-type', 'application/json; charset=utf-8')\n  24→  res.setHeader('cache-control', 'no-store')\n  25→  res.end(JSON.stringify(body))\n  26→}\n  27→\n  28→function readBody(req) {\n  29→  return new Promise((resolve, reject) => {\n  30→    let raw = ''\n  31→    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n  32→    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n  33→    req.on('error', reject)\n  34→  })\n  35→}\n  36→\n  37→export function createPlugin(hostCtx, settings = {}, deps = {}) {\n  38→  const s = settings || {}\n  39→  const ctx = deps.ctx || createContext()\n  40→  const registered = []\n  41→  const errors = []\n  42→  report = { registered, errors }\n  43→\n  44→  const file = s.configPath || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json')\n  45→  const getConfig = () => loadConfig({ file, ctx })\n  46→\n  47→  const fail = (where, error) => {\n  48→    const message = String((error && error.message) || error)\n  49→    errors.push({ path: where, message })\n  50→    ctx.stderr.write(`[cliworker] route registration failed: ${where === null ? '(inject)' : where}: ${message}\\n`)\n  51→  }\n  52→\n  53→  const route = (httpCtx, routePath, label, handler) => {\n  54→    try {\n  55→      httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: routePath, handler }), label)\n  56→      registered.push(routePath)\n  57→    } catch (e) {\n  58→      fail(routePath, e)\n  59→    }\n  60→  }\n  61→\n  62→  try {\n  63→    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\n  64→    hostCtx.inject(['webServer'], (httpCtx) => {\n  65→      route(httpCtx, '/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n  66→        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c, { ctx }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  67→      })\n  68→      route(httpCtx, '/cliworker/models', 'cliworker: models', async (_req, res) => {\n  69→        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c, { ctx }), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  70→      })\n  71→      route(httpCtx, '/cliworker/select', 'cliworker: select', async (req, res) => {\n  72→        try {\n  73→          const c = getConfig()\n  74→          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n  75→          const request = body.request || body\n  76→          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c, { ctx }) }) })\n  77→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n  78→      })\n  79→      route(httpCtx, '/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n  80→        try {\n  81→          const c = getConfig()\n  82→          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n  83→          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null, now: ctx.now() }) })\n  84→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  85→      })\n  86→    })\n  87→  } catch (e) {\n  88→    fail(null, e)\n  89→  }\n  90→\n  91→  return { registered, errors }\n  92→}\n  93→\n  94→export function getRegistration() {\n  95→  if (!report) return { status: 'failed', registered: [], errors: [{ path: null, message: 'plugin not applied' }] }\n  96→  const errors = report.errors.map((item) => ({ path: item.path, message: item.message }))\n  97→  return { status: errors.length > 0 ? 'failed' : 'ok', registered: report.registered.slice(), errors }\n  98→}\n  99→\n 100→export function apply(hostCtx, settings = {}, deps = {}) {\n 101→  const s = settings || {}\n 102→  const result = createPlugin(hostCtx, s, deps)\n 103→  if (s.strict === true && result.errors.length > 0) {\n 104→    const detail = result.errors.map((item) => `${item.path === null ? '(inject)' : item.path}: ${item.message}`).join('; ')\n 105→    const error = new Error(`cliworker: route registration failed: ${detail}`)\n 106→    error.registration = getRegistration()\n 107→    throw error\n 108→  }\n 109→}\n 110→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b72394ba7d0b9fa23abf97e6c1ad","codebuddy.ai/llmMessageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:52:12.286Z"}
{"type":"user","uuid":"01a1b723-b202-7679-8b00-69ea2601f18f","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_valk9KDvtm6kbalk9u0c5485","content":[{"type":"text","text":"   1→import os from 'node:os'\n   2→import path from 'node:path'\n   3→\n   4→export const SCHEMA = 'cliworker.config/v1'\n   5→\n   6→export function defaultHome(env = process.env) {\n   7→  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   8→}\n   9→\n  10→export function loadConfig({ file, ctx } = {}) {\n  11→  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\n  12→  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(ctx.fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome(ctx.env) }\n  23→}\n  24→\n  25→export function ensureDir(dir, ctx) { ctx.fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file, ctx) {\n  28→  try {\n  29→    return ctx.fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row, ctx) {\n  34→  ensureDir(path.dirname(file), ctx)\n  35→  ctx.fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b72394ba7d0b9fa23abf97e6c1ad","codebuddy.ai/llmMessageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:52:12.291Z"}
{"type":"user","uuid":"01a1b723-b209-7086-9678-30f40f6cdf4d","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_NKQeBusBhfqhipoYirbw2112","content":[{"type":"text","text":"   1→export function checkProvider(provider, { probe = true, ctx } = {}) {\n   2→  const cli = provider.cli\n   3→  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n   4→  if (!ctx || typeof ctx.exec !== 'function') throw new TypeError('checkProvider requires ctx.exec')\n   5→  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n   6→  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n   7→  const v = ctx.exec(cli, versionArgs, { timeout: 20_000 })\n   8→  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n   9→  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n  10→  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n  11→  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n  12→  const auth = ctx.exec(cli, [...prefix, ...provider.auth_args], { timeout: 20_000 })\n  13→  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n  14→  const ok = auth.ok && (\n  15→    !provider.auth_ok ||\n  16→    text.includes(String(provider.auth_ok).toLowerCase()) ||\n  17→    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n  18→    /\\blogged in\\b/.test(text)\n  19→  )\n  20→  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n  21→}\n  22→\n  23→export function providerStatus(config, opts = {}) {\n  24→  const out = {}\n  25→  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n  26→  return out\n  27→}\n  28→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b72394ba7d0b9fa23abf97e6c1ad","codebuddy.ai/llmMessageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:52:12.298Z"}
{"type":"user","uuid":"01a1b723-b20d-70b4-abf6-85abff8d51d4","session_id":"01a1b721-a96a-7c0f-99aa-225c87e92133","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_2flmsNPdstzJDURkxglg3437","content":[{"type":"text","text":"   1→import { systemNow } from './context.mjs'\n   2→\n   3→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   4→\n   5→export function normalizePrices(m = {}) {\n   6→  const p = m.prices || {}\n   7→  return {\n   8→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n   9→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n  10→  }\n  11→}\n  12→\n  13→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  14→  const p = { ...DEFAULT_PRICES, ...prices }\n  15→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  16→}\n  17→\n  18→/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n  19→export function forecast({ records = [], model, prices, quota = null, now = systemNow() } = {}) {\n  20→  const rows = records.filter((r) => !model || r.model === model)\n  21→  const samples = rows.map((r) => ({\n  22→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  23→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  24→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  25→  if (!samples.length) {\n  26→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  27→  }\n  28→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  29→  const use = recent.length ? recent : samples.slice(-10)\n  30→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  31→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  32→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  33→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  34→  let tasksLeft = null\n  35→  let etaHours = null\n  36→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  37→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  38→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  39→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  40→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  41→  }\n  42→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  43→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  44→  return {\n  45→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  46→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  47→    confidence, risk,\n  48→  }\n  49→}\n  50→\n  51→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  52→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b721af537b7b9b47da5114dfc022","_messageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","_meta":{"codebuddy.ai/conversationRequestId":"01a1b721af537b7b9b47da5114dfc022","codebuddy.ai/modelRequestId":"01a1b72394ba7d0b9fa23abf97e6c1ad","codebuddy.ai/llmMessageId":"01a1b72394ba7d0b9fa23abf97e6c1ad","traceparent":"00-5861ca06df431b6d0a98591b78aa6f5a-6ae159fb31da44fb-01","baggage":"codebuddy.session_id=01a1b721-a96a-7c0f-99aa-225c87e92133,codebuddy.conversation_request_id=01a1b721af537b7b9b47da5114dfc022"},"__timestamp":"2026-11-07T17:52:12.302Z"}
