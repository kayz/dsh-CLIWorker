{"type":"user","uuid":"01a1b725-5c38-7319-90c3-16828cf1263f","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_qpESy8t1Rk1UpdsiMTRA1898","content":[{"type":"text","text":"   1→import { loadConfig } from './config.mjs'\n   2→import * as providersList from './commands/providers/list.mjs'\n   3→import * as modelsList from './commands/models/list.mjs'\n   4→import * as modelsSelect from './commands/models/select.mjs'\n   5→import * as modelsForecast from './commands/models/forecast.mjs'\n   6→import * as usageRecord from './commands/usage/record.mjs'\n   7→import * as usageSummary from './commands/usage/summary.mjs'\n   8→import { arg } from './commands/_util.mjs'\n   9→\n  10→const USAGE = 'usage: cliworker providers | models list|select|forecast | usage record|summary'\n  11→\n  12→const ROUTES = [\n  13→  { cmd: 'providers', sub: null, module: providersList },\n  14→  { cmd: 'models', sub: null, module: modelsList },\n  15→  { cmd: 'models', sub: 'select', module: modelsSelect },\n  16→  { cmd: 'models', sub: 'forecast', module: modelsForecast },\n  17→  { cmd: 'usage', sub: 'record', module: usageRecord },\n  18→  { cmd: 'usage', sub: 'summary', module: usageSummary },\n  19→]\n  20→\n  21→function resolveRoute(argv) {\n  22→  const cmd = argv[0]\n  23→  let sub = argv[1] === undefined ? null : argv[1]\n  24→  if (cmd === 'providers') sub = null\n  25→  else if (cmd === 'models') { if (sub === '' || sub === 'list') sub = null }\n  26→  else if (cmd !== 'usage') return null\n  27→  const match = ROUTES.find((route) => route.cmd === cmd && route.sub === sub)\n  28→  return match ? match.module : null\n  29→}\n  30→\n  31→function warnAboutTestClock(ctx, result) {\n  32→  const file = ctx.env ? ctx.env.CLIWORKER_TEST_CLOCK_FILE : undefined\n  33→  if (typeof file !== 'string' || file === '') return\n  34→  if (!result || typeof result !== 'object') return\n  35→  if (Array.isArray(result.warnings)) result.warnings.push({ code: 'W_TEST_CLOCK' })\n  36→  else result.warnings = [{ code: 'W_TEST_CLOCK' }]\n  37→}\n  38→\n  39→export async function main(argv, ctx) {\n  40→  const route = resolveRoute(argv)\n  41→  if (!route) {\n  42→    ctx.stderr.write(`ERROR: ${USAGE}\\n`)\n  43→    return { exitCode: 1 }\n  44→  }\n  45→  try {\n  46→    const config = loadConfig({ file: arg(argv, '--config'), ctx })\n  47→    const result = await route.run({ argv, ctx, config })\n  48→    warnAboutTestClock(ctx, result)\n  49→    ctx.stdout.write(JSON.stringify(result, null, 2) + '\\n')\n  50→    return { exitCode: 0 }\n  51→  } catch (e) {\n  52→    ctx.stderr.write(`ERROR: ${e.message}\\n`)\n  53→    return { exitCode: e.exitCode ?? 1 }\n  54→  }\n  55→}\n  56→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.401Z"}
{"type":"user","uuid":"01a1b725-5c3c-728f-89ef-30d3d0696654","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_Ga4wrz37t8k5FJxbH2EF7135","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import { run } from './exec.mjs'\n   3→\n   4→export const TEST_CLOCK_ENV = 'CLIWORKER_TEST_CLOCK_FILE'\n   5→\n   6→const NUMBER_RE = /^[0-9]+(\\.[0-9]+)?$/\n   7→\n   8→function resolve(value, fallback) {\n   9→  return value === undefined ? fallback : value\n  10→}\n  11→\n  12→export function createRealClock({ env, fs: fsApi } = {}) {\n  13→  const readEnv = env || {}\n  14→  const io = fsApi || fs\n  15→\n  16→  const clock = {\n  17→    now() {\n  18→      const file = readEnv[TEST_CLOCK_ENV]\n  19→      if (typeof file !== 'string' || file === '') return Date.now()\n  20→      const raw = String(io.readFileSync(file, 'utf8')).trim()\n  21→      const value = NUMBER_RE.test(raw) ? Number(raw) : Date.parse(raw)\n  22→      if (!Number.isFinite(value)) throw new Error(`invalid ${TEST_CLOCK_ENV} content`)\n  23→      return value\n  24→    },\n  25→    nowIso() {\n  26→      return new Date(clock.now()).toISOString()\n  27→    },\n  28→    setTimeout(fn, ms) {\n  29→      return setTimeout(fn, ms)\n  30→    },\n  31→    clearTimeout(handle) {\n  32→      clearTimeout(handle)\n  33→    },\n  34→    sleep(ms) {\n  35→      return new Promise((done) => { setTimeout(done, ms) })\n  36→    },\n  37→  }\n  38→\n  39→  return clock\n  40→}\n  41→\n  42→export function createContext(overrides = {}) {\n  43→  const o = overrides || {}\n  44→  const env = resolve(o.env, process.env)\n  45→  const fsApi = resolve(o.fs, fs)\n  46→  const exec = resolve(o.exec, run)\n  47→  const clock = resolve(o.clock, createRealClock({ env, fs: fsApi }))\n  48→\n  49→  return {\n  50→    exec,\n  51→    fs: fsApi,\n  52→    fetch: resolve(o.fetch, (...a) => globalThis.fetch(...a)),\n  53→    env,\n  54→    platform: resolve(o.platform, process.platform),\n  55→    stdout: resolve(o.stdout, process.stdout),\n  56→    stderr: resolve(o.stderr, process.stderr),\n  57→    random: resolve(o.random, () => Math.random()),\n  58→    clock,\n  59→    now: resolve(o.now, () => clock.now()),\n  60→  }\n  61→}\n  62→\n  63→export function systemNow() {\n  64→  return createRealClock({ env: process.env, fs }).now()\n  65→}\n  66→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.405Z"}
{"type":"user","uuid":"01a1b725-5c40-7d5d-a7e1-ce7fade99c97","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_7RO8cxjnbWVisgr1Wx9I0964","content":[{"type":"text","text":"   1→import { spawnSync } from 'node:child_process'\n   2→\n   3→export function run(command, args = [], { timeout = 20_000 } = {}) {\n   4→  try {\n   5→    const r = spawnSync(command, args, { encoding: 'utf8', timeout, windowsHide: true, shell: process.platform === 'win32' })\n   6→    return { ok: r.status === 0, code: r.status, stdout: r.stdout || '', stderr: r.stderr || '', error: r.error?.message || null }\n   7→  } catch (e) {\n   8→    return { ok: false, code: -1, stdout: '', stderr: '', error: e.message }\n   9→  }\n  10→}\n  11→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.409Z"}
{"type":"user","uuid":"01a1b725-5c44-7daf-a4d5-0a245ff7c57d","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_XpNDoZHgf8F3tbJaUW7C8122","content":[{"type":"text","text":"   1→export function checkProvider(provider, { probe = true, ctx } = {}) {\n   2→  const cli = provider.cli\n   3→  if (!probe) return { state: 'unverified', version: null, detail: 'probe disabled' }\n   4→  if (!ctx || typeof ctx.exec !== 'function') throw new TypeError('checkProvider requires ctx.exec')\n   5→  const prefix = Array.isArray(provider.args_prefix) ? provider.args_prefix : []\n   6→  const versionArgs = [...prefix, ...(provider.version_args || ['--version'])]\n   7→  const v = ctx.exec(cli, versionArgs, { timeout: 20_000 })\n   8→  if (v.error) return { state: 'unavailable', version: null, detail: v.error }\n   9→  if (!v.ok) return { state: 'unavailable', version: null, detail: (v.stderr || v.stdout || `exit ${v.code}`).trim().slice(0, 200) }\n  10→  const version = (v.stdout.match(/\\d+\\.\\d+\\.\\d+(?:[-+][\\w.]+)?/) || [''])[0] || null\n  11→  if (!provider.auth_args || !provider.auth_args.length) return { state: 'callable', version, detail: 'auth not configured' }\n  12→  const auth = ctx.exec(cli, [...prefix, ...provider.auth_args], { timeout: 20_000 })\n  13→  const text = (auth.stdout + '\\n' + auth.stderr).toLowerCase()\n  14→  const ok = auth.ok && (\n  15→    !provider.auth_ok ||\n  16→    text.includes(String(provider.auth_ok).toLowerCase()) ||\n  17→    /\"loggedin\"\\s*:\\s*true/.test(text) ||\n  18→    /\\blogged in\\b/.test(text)\n  19→  )\n  20→  return { state: ok ? 'callable' : 'blocked', version, detail: ok ? 'auth ok' : (auth.stderr || auth.stdout || 'auth failed').trim().slice(0, 200) }\n  21→}\n  22→\n  23→export function providerStatus(config, opts = {}) {\n  24→  const out = {}\n  25→  for (const [name, p] of Object.entries(config.providers)) out[name] = checkProvider(p, opts)\n  26→  return out\n  27→}\n  28→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.413Z"}
{"type":"user","uuid":"01a1b725-5c49-7ed4-9f82-8e98bf99f8b2","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_04_P6RrbjIZRk1ZowIelPHX5731","content":[{"type":"text","text":"   1→import os from 'node:os'\n   2→import path from 'node:path'\n   3→\n   4→export const SCHEMA = 'cliworker.config/v1'\n   5→\n   6→export function defaultHome(env = process.env) {\n   7→  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n   8→}\n   9→\n  10→export function loadConfig({ file, ctx } = {}) {\n  11→  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\n  12→  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\n  13→  let raw\n  14→  try { raw = JSON.parse(ctx.fs.readFileSync(root, 'utf8')) } catch (e) {\n  15→    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n  16→    error.code = 'E_CONFIG'\n  17→    throw error\n  18→  }\n  19→  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  20→  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  21→  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  22→  return { ...raw, _file: root, _home: defaultHome(ctx.env) }\n  23→}\n  24→\n  25→export function ensureDir(dir, ctx) { ctx.fs.mkdirSync(dir, { recursive: true }); return dir }\n  26→\n  27→export function readUsage(file, ctx) {\n  28→  try {\n  29→    return ctx.fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  30→  } catch { return [] }\n  31→}\n  32→\n  33→export function appendUsage(file, row, ctx) {\n  34→  ensureDir(path.dirname(file), ctx)\n  35→  ctx.fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n  36→}\n  37→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.418Z"}
{"type":"user","uuid":"01a1b725-5c4d-753b-89c4-bff2250296d0","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_05_YWDjPYWeV8F9RuDcUHBO7054","content":[{"type":"text","text":"   1→import { systemNow } from './context.mjs'\n   2→\n   3→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   4→\n   5→export function normalizePrices(m = {}) {\n   6→  const p = m.prices || {}\n   7→  return {\n   8→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n   9→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n  10→  }\n  11→}\n  12→\n  13→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  14→  const p = { ...DEFAULT_PRICES, ...prices }\n  15→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  16→}\n  17→\n  18→/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n  19→export function forecast({ records = [], model, prices, quota = null, now = systemNow() } = {}) {\n  20→  const rows = records.filter((r) => !model || r.model === model)\n  21→  const samples = rows.map((r) => ({\n  22→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  23→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  24→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  25→  if (!samples.length) {\n  26→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  27→  }\n  28→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  29→  const use = recent.length ? recent : samples.slice(-10)\n  30→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  31→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  32→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  33→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  34→  let tasksLeft = null\n  35→  let etaHours = null\n  36→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  37→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  38→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  39→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  40→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  41→  }\n  42→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  43→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  44→  return {\n  45→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  46→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  47→    confidence, risk,\n  48→  }\n  49→}\n  50→\n  51→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  52→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb83f9df0e9e772e13","codebuddy.ai/llmMessageId":"01a1b7254e3f78cb83f9df0e9e772e13","traceparent":"00-02c176743a6c7743ecfd77a83c1857d5-a1f15919992552b4-01","baggage":"codebuddy.session_id=01a1b725-399b-7f29-864e-1abeb0be2d5b,codebuddy.conversation_request_id=01a1b7253dcf72d697f8c66266dfc018"},"__timestamp":"2026-11-07T17:54:01.422Z"}
{"type":"user","uuid":"01a1b725-5c51-7d35-947b-d616ca061393","session_id":"01a1b725-399b-7f29-864e-1abeb0be2d5b","message":{"content":[{"type":"tool_result","tool_use_id":"call_06_omsTSjLA9QefoxNKh8w94758","content":[{"type":"text","text":"   1→/**\n   2→ * dsh-cliworker — DSH host plugin.\n   3→ *\n   4→ * AgentLine and other clients only need the model source pointer:\n   5→ *   modelSource = { kind: \"cliworker\", command: \"node\",\n   6→ *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\n   7→ *\n   8→ * The plugin exposes the same selection contract over DSH routes for UI use.\n   9→ */\n  10→import path from 'node:path'\n  11→import { createContext } from './context.mjs'\n  12→import { loadConfig, defaultHome } from './config.mjs'\n  13→import { providerStatus } from './availability.mjs'\n  14→import { listModels, selectModels } from './select.mjs'\n  15→import { forecast } from './forecast.mjs'\n  16→\n  17→export const name = 'cliworker'\n  18→\n  19→let report = null\n  20→\n  21→function send(res, body, code = 200) {\n  22→  res.statusCode = code\n  23→  res.setHeader('content-type', 'application/json; charset=utf-8')\n  24→  res.setHeader('cache-control', 'no-store')\n  25→  res.end(JSON.stringify(body))\n  26→}\n  27→\n  28→function readBody(req) {\n  29→  return new Promise((resolve, reject) => {\n  30→    let raw = ''\n  31→    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\n  32→    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\n  33→    req.on('error', reject)\n  34→  })\n  35→}\n  36→\n  37→export function createPlugin(hostCtx, settings = {}, deps = {}) {\n  38→  const s = settings || {}\n  39→  const ctx = deps.ctx || createContext()\n  40→  const registered = []\n  41→  const errors = []\n  42→  report = { registered, errors }\n  43→\n  44→  const file = s.configPath || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json')\n  45→  const getConfig = () => loadConfig({ file, ctx })\n  46→\n  47→  const fail = (where, error) => {\n  48→    const message = String((error && error.message) || error)\n  49→    errors.push({ path: where, message })\n  50→    ctx.stderr.write(`[cliworker] route registration failed: ${where === null ? '(inject)' : where}: ${message}\\n`)\n  51→  }\n  52→\n  53→  const route = (httpCtx, routePath, label, handler) => {\n  54→    try {\n  55→      httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: routePath, handler }), label)\n  56→      registered.push(routePath)\n  57→    } catch (e) {\n  58→      fail(routePath, e)\n  59→    }\n  60→  }\n  61→\n  62→  try {\n  63→    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\n  64→    hostCtx.inject(['webServer'], (httpCtx) => {\n  65→      route(httpCtx, '/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n  66→        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c, { ctx }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  67→      })\n  68→      route(httpCtx, '/cliworker/models', 'cliworker: models', async (_req, res) => {\n  69→        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c, { ctx }), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  70→      })\n  71→      route(httpCtx, '/cliworker/select', 'cliworker: select', async (req, res) => {\n  72→        try {\n  73→          const c = getConfig()\n  74→          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n  75→          const request = body.request || body\n  76→          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c, { ctx }) }) })\n  77→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n  78→      })\n  79→      route(httpCtx, '/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n  80→        try {\n  81→          const c = getConfig()\n  82→          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n  83→          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null, now: ctx.now() }) })\n  84→        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n  85→      })\n  86→    })\n  87→  } catch (e) {\n  88→    fail(null, e)\n  89→  }\n  90→\n  91→  return { registered, errors }\n  92→}\n  93→\n  94→export function getRegistration() {\n  95→  if (!report) return { status: 'failed', registered: [], errors: [{ path: null, message: 'plugin not applied' }] }\n  96→  const errors = report.errors.map((item) => ({ path: item.path, message: item.message }))\n  97→  return { status: errors.length > 0 ? 'failed' : 'ok', registered: report.registered.slice(), errors }\n  98→}\n  99→\n 100→export function apply(hostCtx, settings = {}, deps = {}) {\n 101→  const s = settings || {}\n 102→  const result = createPlugin(hostCtx, s, deps)\n 103→  if (s.strict === true && result.errors.length > 0) {\n 104→    const detail = result.errors.map((item) => `${item.path === null ? '(inject)' : item.path}: ${item.message}`).join('; ')\n 105→    const error = new Error(`cliworker: route registration failed: ${detail}`)\n 106→    error.registration = getRegistration()\n 107→    throw error\n 108→  }\n 109→}\n 110→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b7253dcf72d697f8c66266dfc018","_messageId":"01a1b7254e3f78cb83f9df0e9e772e13","_meta":{"codebuddy.ai/conversationRequestId":"01a1b7253dcf72d697f8c66266dfc018","codebuddy.ai/modelRequestId":"01a1b7254e3f78cb8