t [dir, rule] of Object.entries(want)) { const { status, j } = scan(dir); if (status !== 1 || j.ok !== false || j.violations.length === 0) throw new Error(dir + ' not reported'); if (!j.violations.every((v) => v.rule === rule && v.file === 'lib/bad.mjs' && v.line >= 1)) throw new Error(dir + ' wrong ' + JSON.stringify(j.violations)); } for (const dir of ['clean', 'allowed']) { const { status, j } = scan(dir); if (status !== 0 || j.ok !== true || j.violations.length !== 0 || j.files < 1) throw new Error(dir + ' not clean ' + JSON.stringify(j)); } console.log('PROBE-OK seams-fixtures')\"\n  92→```\n  93→\n  94→期望：stdout 为 `PROBE-OK seams-fixtures`，退出码 0。\n  95→\n  96→**V-007-4 默认输出格式与参数错误**\n  97→\n  98→```\n  99→node scripts/check-seams.mjs --root test/fixtures/seams/date-now\n 100→```\n 101→\n 102→期望：退出码 1；stdout 恰有两行：`FAIL seams.date_now lib/bad.mjs:<line>`（`<line>` 为正整数）和 `check-seams: FAILED (1 violations)`。\n 103→\n 104→```\n 105→node scripts/check-seams.mjs --bogus\n 106→```\n 107→\n 108→期望：退出码 2；stdout 为空；stderr 含 `usage:`。\n 109→\n 110→**V-007-5 允许清单按路径精确匹配**\n 111→\n 112→```\n 113→node --input-type=module -e \"import fs from 'node:fs'; import os from 'node:os'; import path from 'node:path'; import { spawnSync } from 'node:child_process'; const d = fs.mkdtempSync(path.join(os.tmpdir(), 'cw-seams-')); try { fs.mkdirSync(path.join(d, 'lib', 'commands'), { recursive: true }); fs.writeFileSync(path.join(d, 'lib', 'commands', 'exec.mjs'), 'import cp from ' + String.fromCharCode(39) + 'node:child_process' + String.fromCharCode(39) + String.fromCharCode(10)); const r = spawnSync(process.execPath, ['scripts/check-seams.mjs', '--root', d, '--json'], { encoding: 'utf8' }); const j = JSON.parse(r.stdout); if (r.status !== 1 || j.violations.length !== 1 || j.violations[0].rule !== 'seams.child_process' || j.violations[0].file !== 'lib/commands/exec.mjs') throw new Error(r.stdout) } finally { fs.rmSync(d, { recursive: true, force: true }) } console.log('PROBE-OK seams-all