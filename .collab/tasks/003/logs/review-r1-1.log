ile.rel, source))\n212\t  }\n213\t\n214\t  violations.sort((a, b) => {\n215\t    if (a.file !== b.file) return a.file < b.file ? -1 : 1\n216\t    if (a.line !== b.line) return a.line - b.line\n217\t    if (a.rule !== b.rule) return a.rule < b.rule ? -1 : 1\n218\t    return 0\n219\t  })\n220\t\n221\t  return { files: files.length, violations }\n222\t}\n223\t\n224\tfunction main() {\n225\t  const args = process.argv.slice(2)\n226\t  let root = REPO_ROOT\n227\t  let json = false\n228\t\n229\t  for (let i = 0; i < args.length; i += 1) {\n230\t    const flag = args[i]\n231\t    if (flag === '--root') {\n232\t      const value = args[i + 1]\n233\t      if (typeof value !== 'string' || value === '') {\n234\t        process.stderr.write(`--root requires a directory\\n${USAGE}\\n`)\n235\t        process.exitCode = 2\n236\t        return\n237\t      }\n238\t      root = path.resolve(value)\n239\t      i += 1\n240\t    } else if (flag === '--json') {\n241\t      json = true\n242\t    } else {\n243\t      process.stderr.write(`unknown argument: ${flag}\\n${USAGE}\\n`)\n244\t      process.exitCode = 2\n245\t      return\n246\t    }\n247\t  }\n248\t\n249\t  const { files, violations } = scanRoot({ root })\n250\t\n251\t  if (json) {\n252\t    process.stdout.write(`${JSON.stringify({ ok: violations.length === 0, files, violations }, null, 2)}\\n`)\n253\t    process.exitCode = violations.length === 0 ? 0 : 1\n254\t    return\n255\t  }\n256\t\n257\t  for (const item of violations) process.stdout.write(`FAIL ${item.rule} ${item.file}:${item.line}\\n`)\n258\t  process.stdout.write(\n259\t    violations.length === 0\n260\t      ? `check-seams: ok (files=${files})\\n`\n261\t      : `check-seams: FAILED (${violations.length} violations)\\n`\n262\t  )\n263\t  process.exitCode = violations.length === 0 ? 0 : 1\n264\t}\n265\t\n266\tconst invokedDirectly =\n267\t  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n268\t\n269\tif (i