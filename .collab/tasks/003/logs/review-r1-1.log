{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BXds8eGUE5iVExjhrrLN4N","type":"tool_result","content":"1\t# Task 003 验收标准\n2\t\n3\t规格见同目录 `design.md`。基准提交是 `7f655f7`：在该提交上 `node scripts/check-fast.mjs` 通过，`node scripts/check-traceability.mjs` 输出 `check-traceability: ok (covered=6 planned=68)`。\n4\t\n5\t## 约定\n6\t\n7\t- 所有命令在仓库根（任务 worktree 根）执行，Node 20+，bash 与 pwsh 7 下都能原样运行。\n8\t- `node --input-type=module -e \"…\"` 探针的 JS 只用单引号、不含 `$`、反引号、反斜杠和双引号，这样两种 shell 下引号行为一致。探针通过时 stdout 恰好是一行 `PROBE-OK <标签>`，退出码 0；失败时抛错或 `process.exit(1)`，stdout 没有 `PROBE-OK`。\n9\t- “run-tests 通过”指：退出码 0；stdout 含 `ℹ fail 0`；含至少一行以 `✔ [AC-xxx]` 开头的测试；不含 `FAIL run.no_match`、`FAIL discovery`。\n10\t- 每条命令独立判定，不依赖前一条的副作用。\n11\t\n12\t## AC-006 import-safe 入口\n13\t\n14\t**V-006-1 自带测试通过**\n15\t\n16\t```\n17\tnode scripts/run-tests.mjs --ac AC-006\n18\t```\n19\t\n20\t期望：run-tests 通过，且 `✔ [AC-006]` 行至少 3 条；末行为 `run-tests: filtered <n> files, manifest …`，其中 `n >= 1`。\n21\t\n22\t**V-006-2 子进程 import 无输出**\n23\t\n24\t```\n25\tnode --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { pathToFileURL } from 'node:url'; import path from 'node:path'; for (const f of ['lib/cli.mjs', 'lib/index.js']) { const u = pathToFileURL(path.resolve(f)).href; const r = spawnSync(process.execPath, ['--input-type=module', '-e', 'await import(process.argv[1])', u], { encoding: 'utf8' }); if (r.status !== 0 || r.stdout.length !== 0 || r.stderr.length !== 0) { console.error(f, r.status, r.stdout.length, r.stderr.length); process.exit(1) } } console.log('PROBE-OK import-safe')\"\n26\t```\n27\t\n28\t期望：stdout 为 `PROBE-OK import-safe`，退出码 0。（基准提交上 `lib/cli.mjs` 一导入就执行 `main` 并 `process.exit`，此探针会失败。）\n29\t\n30\t**V-006-3 `main(argv, ctx)` 返回 `{exitCode}`，输出进 `ctx.stdout`**\n31\t\n32\t```\n33\tnode --input-type=module -e \"import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: { p1: { cli: 'p1cli' } }, models: {} }); const ctx = createFakeContext({ files: { '/cw/config.json': cfg }, exec: () => ({ ok: true, code: 0, stdout: 'v 1.2.3', stderr: '', error: null }) }); const r = await main(['providers', '--config', '/cw/config.json'], ctx); const j = JSON.parse(ctx.stdout.text()); if (Object.keys(r).join() !== 'exitCode' || r.exitCode !== 0) throw new Error('result ' + JSON.stringify(r)); if (j.schema !== 'cliworker.providers/v1' || j.providers.length !== 1 || j.providers[0].id !== 'p1' || j.providers[0].state !== 'callable' || j.providers[0].version !== '1.2.3') throw new Error('stdout ' + ctx.stdout.text()); if (ctx.stderr.text() !== '' || ctx.exec.count < 1) throw new Error('stderr/exec'); console.log('PROBE-OK main-ctx')\"\n34\t```\n35\t\n36\t期望：stdout 为 `PROBE-OK main-ctx`，退出码 0。\n37\t\n38\t**V-006-4 迁入的命令行为不变（models list、usage record/summary、models forecast）**\n39\t\n40\t```\n41\tnode --input-type=module -e \"import path from 'node:path'; import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: { p1: { cli: 'p1cli', readonly: true } }, models: { m1: { provider: 'p1', id: 'm1', tier: 'top', identity: 'verified', vendor: 'v', prices: { input_per_mtok: 1000, output_per_mtok: 0 } } } }); const mk = () => createFakeContext({ files: { '/cw/config.json': cfg }, env: { CLIWORKER_HOME: '/cw/home' }, now: Date.parse('2020-01-01T00:00:00Z'), exec: () => ({ ok: true, code: 0, stdout: '1.2.3', stderr: '', error: null }) }); const c1 = mk(); const r1 = await main(['models', 'list', '--config', '/cw/config.json'], c1); const l = JSON.parse(c1.stdout.text()); if (r1.exitCode !== 0 || l.schema !== 'cliworker.models/v1' || l.models.length !== 1 || l.models[0].key !== 'm1' || l.models[0].callable !== true || l.models[0].level !== 'Top') throw new Error('list ' + c1.stdout.text()); const c2 = mk(); const r2 = await main(['usage', 'record', '--json', JSON.stringify({ model: 'm1', input_tokens: 1000, output_tokens: 0 }), '--config', '/cw/config.json'], c2); const rec = JSON.parse(c2.stdout.text()); if (r2.exitCode !== 0 || rec.schema !== 'cliworker.usage/v1' || rec.ok !== true || rec.recorded.at !== '2020-01-01T00:00:00.000Z' || rec.recorded.cost_usd !== 1) throw new Error('record ' + c2.stdout.text()); const lines = c2.fs.readFileSync(path.resolve('/cw/home/usage.jsonl'), 'utf8').split(String.fromCharCode(10)).filter(Boolean); if (lines.length !== 1 || JSON.parse(lines[0]).model !== 'm1') throw new Error('usage file'); const n = c2.stdout.text().length; const r3 = await main(['usage', 'summary', '--config', '/cw/config.json'], c2); const sum = JSON.parse(c2.stdout.text().slice(n)); if (r3.exitCode !== 0 || sum.schema !== 'cliworker.usage/v1' || sum.records.length !== 1) throw new Error('summary'); const n2 = c2.stdout.text().length; const r4 = await main(['models', 'forecast', '--model', 'm1', '--config', '/cw/config.json'], c2); const fc = JSON.parse(c2.stdout.text().slice(n2)); if (r4.exitCode !== 0 || fc.schema !== 'cliworker.forecast/v1' || fc.forecast.status !== 'known' || fc.forecast.burn_per_hour !== 60) throw new Error('forecast ' + JSON.stringify(fc)); console.log('PROBE-OK commands')\"\n42\t```\n43\t\n44\t期望：stdout 为 `PROBE-OK commands`，退出码 0。`burn_per_hour` 为 60 说明 forecast 用的是 `ctx.now()`（伪时钟等于样本时间），不是系统时间。\n45\t\n46\t**V-006-5 错误路径不退出进程，只写 stderr**\n47\t\n48\t```\n49\tnode --input-type=module -e \"import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const a = createFakeContext(); const ra = await main([], a); const b = createFakeContext(); const rb = await main(['providers', '--config', '/missing/config.json'], b); if (ra.exitCode !== 1 || a.stdout.text() !== '' || a.stderr.text().indexOf('ERROR: usage: cliworker') !== 0) throw new Error('usage ' + a.stderr.text()); if (rb.exitCode !== 1 || b.stdout.text() !== '' || b.stderr.text().indexOf('ERROR: cannot read CLIWorker config') !== 0) throw new Error('config ' + b.stderr.text()); console.log('PROBE-OK main-errors')\"\n50\t```\n51\t\n52\t期望：stdout 为 `PROBE-OK main-errors`，退出码 0。\n53\t\n54\t**V-006-6 lib 下没有 `process.exit` 字样（含注释）**\n55\t\n56\t```\n57\tnode --input-type=module -e \"import fs from 'node:fs'; import path from 'node:path'; const hits = []; const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) walk(p); else if (/[.](mjs|js|cjs)$/.test(p) && fs.readFileSync(p, 'utf8').includes('process.exit')) hits.push(p) } }; walk('lib'); if (hits.length) { console.error(hits); process.exit(1) } console.log('PROBE-OK no-process-exit')\"\n58\t```\n59\t\n60\t期望：stdout 为 `PROBE-OK no-process-exit`，退出码 0。\n61\t\n62\t**V-006-7 bin 入口是薄封装**\n63\t\n64\t```\n65\tnode bin/cliworker.mjs\n66\t```\n67\t\n68\t期望：退出码 1；stdout 为空；stderr 以 `ERROR: usage: cliworker providers | models list|select|forecast | usage record|summary` 开头。\n69\t\n70\t## AC-007 缝规则与 check-seams\n71\t\n72\t**V-007-1 自带测试通过**\n73\t\n74\t```\n75\tnode scripts/run-tests.mjs --ac AC-007\n76\t```\n77\t\n78\t期望：run-tests 通过，`✔ [AC-007]` 行至少 3 条。\n79\t\n80\t**V-007-2 真实 lib 通过**\n81\t\n82\t```\n83\tnode scripts/check-seams.mjs\n84\t```\n85\t\n86\t期望：退出码 0；stdout 最后一行匹配 `check-seams: ok (files=N)`，`N >= 15`（8 个原 lib 文件加 `_util.mjs` 与 6 个命令模块）；没有 `FAIL` 行。\n87\t\n88\t**V-007-3 每类违规夹具都被报出，合法夹具 0 违规**\n89\t\n90\t```\n91\tnode --input-type=module -e \"import { spawnSync } from 'node:child_process'; const want = { 'child-process': 'seams.child_process', 'fs': 'seams.fs', 'date-now': 'seams.date_now', 'new-date': 'seams.new_date', 'set-timeout': 'seams.set_timeout', 'set-interval': 'seams.set_interval', 'set-immediate': 'seams.set_immediate', 'node-timers': 'seams.node_timers', 'wall-clock': 'seams.wall_clock', 'process-exit': 'seams.process_exit' }; const scan = (dir) => { const r = spawnSync(process.execPath, ['scripts/check-seams.mjs', '--root', 'test/fixtures/seams/' + dir, '--json'], { encoding: 'utf8' }); return { status: r.status, j: JSON.parse(r.stdout) } }; for (const [dir, rule] of Object.entries(want)) { const { status, j } = scan(dir); if (status !== 1 || j.ok !== false || j.violations.length === 0) throw new Error(dir + ' not reported'); if (!j.violations.every((v) => v.rule === rule && v.file === 'lib/bad.mjs' && v.line >= 1)) throw new Error(dir + ' wrong ' + JSON.stringify(j.violations)); } for (const dir of ['clean', 'allowed']) { const { status, j } = scan(dir); if (status !== 0 || j.ok !== true || j.violations.length !== 0 || j.files < 1) throw new Error(dir + ' not clean ' + JSON.stringify(j)); } console.log('PROBE-OK seams-fixtures')\"\n92\t```\n93\t\n94\t期望：stdout 为 `PROBE-OK seams-fixtures`，退出码 0。\n95\t\n96\t**V-007-4 默认输出格式与参数错误**\n97\t\n98\t```\n99\tnode scripts/check-seams.mjs --root test/fixtures/seams/date-now\n100\t```\n101\t\n102\t期望：退出码 1；stdout 恰有两行：`FAIL seams.date_now lib/bad.mjs:<line>`（`<line>` 为正整数）和 `check-seams: FAILED (1 violations)`。\n103\t\n104\t```\n105\tnode scripts/check-seams.mjs --bogus\n106\t```\n107\t\n108\t期望：退出码 2；stdout 为空；stderr 含 `usage:`。\n109\t\n110\t**V-007-5 允许清单按路径精确匹配**\n111\t\n112\t```\n113\tnode --input-type=module -e \"import fs from 'node:fs'; import os from 'node:os'; import path from 'node:path'; import { spawnSync } from 'node:child_process'; const d = fs.mkdtempSync(path.join(os.tmpdir(), 'cw-seams-')); try { fs.mkdirSync(path.join(d, 'lib', 'commands'), { recursive: true }); fs.writeFileSync(path.join(d, 'lib', 'commands', 'exec.mjs'), 'import cp from ' + String.fromCharCode(39) + 'node:child_process' + String.fromCharCode(39) + String.fromCharCode(10)); const r = spawnSync(process.execPath, ['scripts/check-seams.mjs', '--root', d, '--json'], { encoding: 'utf8' }); const j = JSON.parse(r.stdout); if (r.status !== 1 || j.violations.length !== 1 || j.violations[0].rule !== 'seams.child_process' || j.violations[0].file !== 'lib/commands/exec.mjs') throw new Error(r.stdout) } finally