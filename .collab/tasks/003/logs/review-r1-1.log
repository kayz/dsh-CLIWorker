hrow new Error('defaults ' + a.body); if (jb.ra !== '10.0.0.5' || jb.host !== 'evil.test' || jb.origin !== 'http://evil.test') throw new Error('controls ' + b.body); const f = createHostStub({ failPaths: ['/boom'] }); f.ctx.inject(['webServer'], (h) => { try { h.webServer.register({ kind: 'exact', path: '/boom', handler: () => {} }); throw new Error('no throw') } catch (e) { if (e.message.indexOf('/boom') < 0) throw e } }); if (f.registered.length !== 0) throw new Error('failed path recorded'); let threw = false; try { createHostStub({ failInject: true }).ctx.inject(['webServer'], () => {}) } catch (e) { threw = true } if (!threw) throw new Error('failInject'); console.log('PROBE-OK host-stub')\"\n148\t```\n149\t\n150\t期望：stdout 为 `PROBE-OK host-stub`，退出码 0。\n151\t\n152\t**V-008-4 createPlugin / getRegistration / apply 的成功、失败与 strict**\n153\t\n154\t```\n155\tnode --input-type=module -e \"import { createPlugin, getRegistration, apply } from './lib/index.js'; import { createHostStub } from './test/helpers/host-stub.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const want = ['/cliworker/forecast', '/cliworker/models', '/cliworker/providers', '/cliworker/select']; const ok = createHostStub(); const c1 = createFakeContext(); const r1 = createPlugin(ok.ctx, {}, { ctx: c1 }); if (r1.errors.length !== 0 || r1.registered.slice().sort().join() !== want.join()) throw new Error('ok ' + JSON.stringify(r1)); if (ok.registered.map((x) => x.path).sort().join() !== want.join()) throw new Error('stub records'); const g1 = getRegistration(); if (g1.status !== 'ok' || g1.errors.length !== 0 || g1.registered.length !== 4) throw new Error('get ok'); const bad = createHostStub({ failPaths: ['/cliworker/models'], failMessage: 'boom' }); const c2 = createFakeContext(); const r2 = createPlugin(bad.ctx, {}, { ctx: c2 }); if (r2.errors.length !== 1 || r2.errors[0].path !== '/cliworker/models' || r2.errors[0].message.indexOf('boom') < 0) throw new Error('partial ' + JSON.str