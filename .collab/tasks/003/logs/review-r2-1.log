h); c.setTimeout(() => log.push('far'), 1000); if (c.pending() !== 4) throw new Error('pending1 ' + c.pending()); await c.advance(99); if (log.length !== 0 || c.pending() !== 4) throw new Error('fired early'); await c.advance(1); if (log.join() !== 'a1' || seen[0] !== 9100 || c.pending() !== 3) throw new Error('a1 ' + log.join()); await c.advance(100); if (log.join() !== 'a1,b2,b3' || c.pending() !== 1) throw new Error('b ' + log.join()); let slept = false; c.sleep(500).then(() => { slept = true }); if (c.pending() !== 2) throw new Error('sleep pending'); await c.advance(499); await Promise.resolve(); await Promise.resolve(); if (slept) throw new Error('slept early'); await c.advance(1); await Promise.resolve(); await Promise.resolve(); if (!slept || c.pending() !== 1) throw new Error('slept late'); c.setNow(20000); await c.advance(0); if (log.join() !== 'a1,b2,b3,far' || c.pending() !== 0) throw new Error('overdue ' + log.join()); let rej = false; try { await c.advance(-1) } catch (e) { rej = e instanceof RangeError } if (!rej) throw new Error('RangeError'); console.log('PROBE-OK fake-clock')\"\n182\t```\n183\t\n184\t期望：stdout 为 `PROBE-OK fake-clock`，退出码 0。\n185\t\n186\t**V-072-3 真实 createContext 读时钟文件，每次重读**\n187\t\n188\t```\n189\tnode --input-type=module -e \"import fs from 'node:fs'; import os from 'node:os'; import path from 'node:path'; import { createContext } from './lib/context.mjs'; const f = path.join(os.tmpdir(), 'cw-clock-' + process.pid + '.txt'); try { fs.writeFileSync(f, '1000'); const ctx = createContext({ env: { CLIWORKER_TEST_CLOCK_FILE: f } }); if (ctx.now() !== 1000 || ctx.clock.now() !== 1000) throw new Error('first'); fs.writeFileSync(f, '2500'); if (ctx.now() !== 2500 || ctx.clock.now() !== 2500) throw new Error('reread'); fs.writeFileSync(f, '2026-11-07T00:00:00.000Z'); if (ctx.clock.now() !== Date.parse('2026-11-07T00:00:00.000Z') || ctx.clock.nowIso() !== '2026-11-07T00:00:00.000Z') throw new Error('iso'); fs.writeFileSync(f, 'not a time'); let threw = false; try { ctx.now() } catch (e) { threw = e.message.indexOf('CLIWORKER_TEST_CLOCK_FILE') >= 0 } if (!threw) throw new Error('invalid content'); const real = createContext({ env: {} }); if (Math.abs(real.now() - Date.now()) > 5000) throw new Error('real now'); const empty = createContext({ env: { CLIWORKER_TEST_CLOCK_FILE: '' } }); if (Math.abs(empty.now() - Date.now()) > 5000) throw new Error('empty var'); for (const m of ['setNow', 'advance', 'pending']) if (m in real.clock) throw new Error('real clock exposes ' + m) } finally { fs.rmSync(f, { force: true }) } console.log('PROBE-OK test-clock-file')\"\n190\t```\n191\t\n192\t期望：stdout 为 `PROBE-OK test-clock-file`，退出码 0。\n193\t\n194\t**V-072-4 context.v1.json 描述 ctx 接口面，真实 ctx 与 fake ctx 都符合**\n195\t\n196\t```\n197\tnode --input-type=module -e \"import fs from 'node:fs'; import { createContext } from './lib/context.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const spec = JSON.parse(fs.readFileSync('contracts/context/context.v1.json', 'utf8')); if (spec.contract !== 'cliworker.context' || spec.version !== 1 || spec.test_clock_env !== 'CLIWORKER_TEST_CLOCK_FILE') throw new Error('header'); if (spec.fake_clock_extras.join() !== 'setNow,advance,pending' || spec.clock_methods.join() !== 'now,nowIso,setTimeout,clearTimeout,sleep' || spec.stream_methods.join() !== 'write') throw new Error('lists'); if (spec.fs_methods.length !== 9) throw new Error('fs_methods'); const check = (name, ctx, fake) => { if (Object.keys(ctx).sort().join() !== Object.keys(spec.members).sort().join()) throw new Error(name + ' keys ' + Object.keys(ctx)); for (const [k, t] of Object.entries(spec.members)) { const v = ctx[k]; const ok = t === 'stream' ? typeof v.write === 'function' : typeof v === t; if (!ok) throw new Error(name + ' member ' + k); } for (const m of spec.fs_methods) if (typeof ctx.fs[m] !== 'function') throw new Error(name + ' fs.' + m); for (const m of spec.clock_methods) if (typeof ctx.clock[m] !== 'function') throw new Error(name + ' clock.' + m); for (const m of spec.fake_clock_extras) if ((typeof ctx.clock[m] === 'function') !== fake) throw new Error(name + ' extra ' + m); if (Math.abs(ctx.now() - ctx.clock.now()) > 50) throw new Error(name + ' now alias'); }; check('real', createContext({ env: {} }), false); const fake = createFakeContext(); check('fake', fake, true); if (fake.now() !== fake.clock.now()) throw new Error('fake alias exact'); await fake.clock.advance(1000); if (fake.now() !== fake.clock.now()) throw new Error('fake alias after advance'); console.log('PROBE-OK context-contract')\"\n198\t```\n199\t\n200\t期望：stdout 为 `PROBE-OK context-contract`，退出码 0。\n201\t\n202\t**V-072-5 设置时钟文件时 `main()` 输出含 `W_TEST_CLOCK`，未设置时不含（进程内）**\n203\t\n204\t```\n205\tnode --input-type=module -e \"import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: {}, models: {} }); const run = async (env) => { const ctx = createFakeContext({ files: { '/cw/config.json': cfg }, env }); const r = await main(['usage', 'summary', '--config', '/cw/config.json'], ctx); return { r, j: JSON.parse(ctx.stdout.text()) } }; const on = await run({ CLIWORKER_HOME: '/cw/home', CLIWORKER_TEST_CLOCK_FILE: '/cw/clock.txt' }); if (on.r.exitCode !== 0 || !Array.isArray(on.j.warnings) || !on.j.warnings.some((w) => w.code === 'W_TEST_CLOCK')) throw new Error('on ' + JSON.stringify(on.j)); for (const env of [{ CLIWORKER_HOME: '/cw/home' }, { CLIWORKER_HOME: '/cw/home', CLIWORKER_TEST_CLOCK_FILE: '' }]) { const off = await run(env); if (off.r.exitCode !== 0 || JSON.stringify(off.j).indexOf('W_TEST_CLOCK') >= 0 || 'warnings' in off.j) throw new Error('off ' + JSON.stringify(off.j)); } console.log('PROBE-OK warn-inproc')\"\n206\t```\n207\t\n208\t期望：stdout 为 `PROBE-OK warn-inproc`，退出码 0。\n209\t\n210\t**V-072-6 端到端：bin 子进程在时钟文件环境下输出 `W_TEST_CLOCK`**\n211\t\n212\t```\n213\tnode --input-type=module -e \"import fs from 'node:fs'; import os from 'node:os'; import path from 'node:path'; import { spawnSync } from 'node:child_process'; const d = fs.mkdtempSync(path.join(os.tmpdir(), 'cw-bin-')); try { const cfg = path.join(d, 'config.json'); const clk = path.join(d, 'clock.txt'); fs.writeFileSync(cfg, JSON.stringify({ providers: {}, models: {} })); fs.writeFileSync(clk, '1000'); const run = (extra) => spawnSync(process.execPath, ['bin/cliworker.mjs', 'usage', 'summary', '--config', cfg], { encoding: 'utf8', env: { ...process.env, CLIWORKER_HOME: d, CLIWORKER_TEST_CLOCK_FILE: '', ...extra } }); const a = run({ CLIWORKER_TEST_CLOCK_FILE: clk }); const b = run({}); if (a.status !== 0 || a.stderr !== '') throw new Error('a ' + a.status + a.stderr); if (!JSON.parse(a.stdout).warnings.some((w) => w.code === 'W_TEST_CLOCK')) throw new Error('a warnings ' + a.stdout); if (b.status !== 0 || b.stderr !== '' || b.stdout.indexOf('W_TEST_CLOCK') >= 0) throw new Error('b ' + b.stdout + b.stderr); if (JSON.parse(b.stdout).schema !== 'cliworker.usage/v1') throw new Error('b schema') } finally { fs.rmSync(d, { recursive: true, force: true }) } console.log('PROBE-OK warn-bin')\"\n214\t```\n215\t\n216\t期望：stdout 为 `PROBE-OK warn-bin`，退出码 0。\n217\t\n218\t**V-072-7 助手不泄露环境值**\n219\t\n220\t```\n221\tnode --input-type=module -e \"import { createFakeContext } from './test/helpers/ctx.mjs'; const ctx = createFakeContext(); ctx.exec('tool', ['--flag'], { env: { SECRET_TOKEN: 'sentinel-8f3a' }, timeout: 5 }); ctx.exec('tool', [], {}); const dump = JSON.stringify(ctx.exec.calls); if (dump.indexOf('sentinel-8f3a') >= 0) throw new Error('value leaked'); if (ctx.exec.count !== 2 || ctx.exec.calls[0].command !== 'tool' || ctx.exec.calls[0].args.join() !== '--flag' || ctx.exec.calls[0].envNames.join() !== 'SECRET_TOKEN') throw new Error('record ' + dump); ctx.fs.writeFileSync('/a/b.txt', 'x'); if (ctx.fs.readFileSync('/a/b.txt', 'utf8') !== 'x' || ctx.fs.accessed.length < 2) throw new Error('fakeFs'); try { ctx.fs.readFileSync('/a/none.txt', 'utf8'); throw new Error('no enoent') } catch (e) { if (e.code !== 'ENOENT') throw e } console.log('PROBE-OK helpers')\"\n222\t```\n223\t\n224\t期望：stdout 为 `PROBE-OK helpers`，退出码 0。\n225\t\n226\t## 总体回归与范围\n227\t\n228\t**V-R-1 完整检查**\n229\t\n230\t```\n231\tpwsh -NoProfile -File scripts/check-fast.ps1\n232\t```\n233\t\n234\t期望：退出码 0；stdout 最后一行为 `check-fast: ok`；输出中 `ℹ fail 0`；`ℹ pass` 的数字大于 70（基准为 70）；`check-seams: ok` 出现（check-fast 会自动跑 `scripts/check-*.mjs`）。\n235\t\n236\t**V-R-2 追踪**\n237\t\n238\t```\n239\tnode scripts/check-traceability.mjs\n240\t```\n241\t\n242\t期望：退出码 0；stdout 为 `check-traceability: ok (covered=10 planned=64)`。\n243\t\n244\t```\n245\tnode --input-type=module -e \"import { spawnSync } from 'node:child_process'; const r = spawnSync(process.execPath, ['scripts/check-traceability.mjs', '--json'], { encoding: 'utf8' }); const j = JSON.parse(r.stdout); const st = (ac) => j.acs.find((x) => x.ac === ac).status; for (const ac of ['AC-006', 'AC-007', 'AC-008', 'AC-072']) if (st(ac) !== 'covered') throw new Error(ac + ' ' + st(ac)); if (r.status !== 0 || j.ok !== true) throw new Error('not ok'); console.log('PROBE-OK trace-T-003')\"\n246\t```\n247\t\n248\t期望：stdout 为 `PROBE-OK trace-T-003`，退出码 0。\n249\t\n250\t**V-R-3 测试发现**\n251\t\n252\t```\n253\tnode scripts/check-test-discovery.mjs\n254\t```\n255\t\n256\t期望：退出码 0；stdout 最后一行为 `check-test-discovery: ok`。新建的 `test/contract/`、`test/integration/` 下的测试文件会进入完整运行。\n257\t\n258\t**V-R-4 冻结文件与 0.1 副本未动**\n259\t\n260\t```\n261\tnode scripts/check-frozen-files.mjs\n262\t```\n263\t\n264\t期望：退出码 0。\n265\t\n266\t**V-R-5 改动范围不超出 write_scope（含 `lib/select.mjs` 未被改动）**\n267\t\n268\t```\n269\tnode --input-type=module -e \"import { spawnSync } from 'node:child_process'; const git = (a) => spawnSync('git', a, { encoding: 'utf8' }).stdout.split(String.fromCharCode(10)).filter(Boolean); const globs = ['lib/context.mjs', 'lib/exec.mjs', 'lib/cli.mjs', 'lib/commands/**', 'bin/cliworker.mjs', 'lib/index.js', 'lib/availability.mjs', 'lib/config.mjs', 'lib/forecast.mjs', 'contracts/host/**', 'contracts/context/**', 'test/helpers/ctx.mjs', 'test/helpers/clock.mjs', 'test/helpers/host-stub.mjs', 'scripts/check-seams.mjs', 'test/fixtures/seams/**', 'test/unit/seams.test.mjs', 'test/unit/import-safe.test.mjs', 'test/unit/clock.test.mjs', 'test/contract/host-stub.test.mjs', 'test/contract/context.test.mjs', 'test/integration/registration.test.mjs', 'test/traceability/T-003.json']; const re = globs.map((g) => new RegExp('^' + g.split('.').join('[.]').split('**').join('@@').split('*').join('[^/]*').split('@@').join('.*') + '$')); const files = [...new Set([...git(['diff', '--name-only', '7f655f7']), ...git(['ls-files', '--others', '--exclude-standard'])])].filter((f) => !f.startsWith('.collab/')); const bad = files.filter((f) => !re.some((r) => r.test(f))); if (bad.length) { console.error('outside write_scope:', bad); process.exit(1) } console.log('PROBE-OK scope ' + files.length)\"\n270\t```\n271\t\n272\t期望：stdout 为 `PROBE-OK scope <n>`，`n >= 30`（实现完成后）；退出码 0。`.collab/` 下的任务状态文件不计入。\n273\t\n274\t**V-R-6 仓库与输出里没有密钥**\n275\t\n276\t```\n277\tnode --input-type=module -e \"import fs from 'node:fs'; import path from 'node:path'; const bad = []; const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) { walk(p); continue } if (!/[.](mjs|js|json)$/.test(p)) continue; const s = fs.readFileSync(p, 'utf8'); if (/sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|BEGIN [A-Z ]*PRIVATE KEY/.test(s)) bad.push(p) } }; for (const d of ['lib', 'bin', 'contracts', 'scripts', 'test']) walk(d); if (bad.length) { console.error(bad); process.exit(1) } console.log('PROBE-OK no-secrets')\"\n278\t```\n279\t\n280\t期望：stdout 为 `PROBE-OK no-secrets`，退出码 0。\n281\t\n282\t## 判定\n283\t\n284\tAC-006、AC-007、AC-008、AC-072 各自的 `V-xxx-n` 全部通过，且 `V-R-1` 到 `V-R-6` 全部通过，任务才算验收通过。任何一条失败，按失败的那条命令和它的输出写进 review。\n285\t"}]},"parent_tool_use_id":null,"session_id":"7abcb0b1-abd4-4257-b653-a3ee4416c0e7","uuid":"baca77cb-97f6-4446-94da-ab5cbbb2e00e","timestamp":"2026-11-07T17:48:57.872Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\003\\.collab\\tasks\\003\\acceptance.md","content":"# Task 003 验收标准\n\n规格见同目录 `design.md`。基准提交是 `7f655f7`：在该提交上 `node scripts/check-fast.mjs` 通过，`node scripts/check-traceability.mjs` 输出 `check-traceability: ok (covered=6 planned=68)`。\n\n## 约定\n\n- 所有命令在仓库根（任务 worktree 根）执行，Node 20+，bash 与 pwsh 7 下都能原样运行。\n- `node --input-type=module -e \"…\"` 探针的 JS 只用单引号、不含 `$`、反引号、反斜杠和双引号，这样两种 shell 下引号行为一致。探针通过时 stdout 恰好是一行 `PROBE-OK <标签>`，退出码 0；失败时抛错或 `process.exit(1)`，stdout 没有 `PROBE-OK`。\n- “run-tests 通过”指：退出码 0；stdout 含 `ℹ fail 0`；含至少一行以 `✔ [AC-xxx]` 开头的测试；不含 `FAIL run.no_match`、`FAIL discovery`。\n- 每条命令独立判定，不依赖前一条的副作用。\n\n## AC-006 import-safe 入口\n\n**V-006-1 自带测试通过**\n\n```\nnode scripts/run-tests.mjs --ac AC-006\n```\n\n期望：run-tests 通过，且 `✔ [AC-006]` 行至少 3 条；末行为 `run-tests: filtered <n> files, manifest …`，其中 `n >= 1`。\n\n**V-006-2 子进程 import 无输出**\n\n```\nnode --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { pathToFileURL } from 'node:url'; import path from 'node:path'; for (const f of ['lib/cli.mjs', 'lib/index.js']) { const u = pathToFileURL(path.resolve(f)).href; const r = spawnSync(process.execPath, ['--input-type=module', '-e', 'await import(process.argv[1])', u], { encoding: 'utf8' }); if (r.status !== 0 || r.stdout.length !== 0 || r.stderr.length !== 0) { console.error(f, r.status, r.stdout.length, r.stderr.length); process.exit(1) } } console.log('PROBE-OK import-safe')\"\n```\n\n期望：stdout 为 `PROBE-OK import-safe`，退出码 0。（基准提交上 `lib/cli.mjs` 一导入就执行 `main` 并 `process.exit`，此探针会失败。）\n\n**V-006-3 `main(argv, ctx)` 返回 `{exitCode}`，输出进 `ctx.stdout`**\n\n```\nnode --input-type=module -e \"import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: { p1: { cli: 'p1cli' } }, models: {} }); const ctx = createFakeContext({ files: { '/cw/config.json': cfg }, exec: () => ({ ok: true, code: 0, stdout: 'v 1.2.3', stderr: '', error: null }) }); const r = await main(['providers', '--config', '/cw/config.json'], ctx); const j = JSON.parse(ctx.stdout.text()); if (Object.keys(r).join() !== 'exitCode' || r.exitCode !== 0) throw new Error('result ' + JSON.stringify(r)); if (j.schema !== 'cliworker.providers/v1' || j.providers.length !== 1 || j.providers[0].id !== 'p1' || j.providers[0].state !== 'callable' || j.providers[0].version !== '1.2.3') throw new Error('stdout ' + ctx.stdout.text()); if (ctx.stderr.text() !== '' || ctx.exec.count < 1) throw new Error('stderr/exec'); console.log('PROBE-OK main-ctx')\"\n```\n\n期望：stdout 为 `PROBE-OK main-ctx`，退出码 0。\n\n**V-006-4 迁入的命令行为不变（models list、usage record/summary、models forecast）**\n\n```\nnode --input-type=module -e \"import path from 'node:path'; import { main } from './lib/cli.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: { p1: { cli: 'p1cli', readonly: true } }, models: { m1: { provider: 'p1', id: 'm1', tier: 'top', identity: 'verified', vendor: 'v', prices: { input_per_mtok: 1000, output_per_mtok: 0 } } } }); const mk = () => createFakeContext({ files: { '/cw/config.json': cfg }, env: { CLIWORKER_HOME: '/cw/home' }, now: Date.parse('2020-01-01T00:00:00Z'), exec: () => ({ ok: true, code: 0, stdout: '1.2.3', stderr: '', error: null }) }); const c1 = mk(); const r1 = await main(['models', 'list', '--config', '/cw/config.json'], c1); const l = JSON.parse(c1.stdout.text()); if (r1.exitCode !== 0 || l.schema !== 'cliworker.models/v1' || l.models.length !== 1 || l.models[0].key !== 'm1' || l.models[0].callable !== true || l.models[0].level !== 'Top') throw new Error('list ' + c1.stdout.text()); const c2 = mk(); const r2 = await main(['usage', 'record', '--json', JSON.stringify({ model: 'm1', input_token