contract !== 'dsh-host' || h.version !== 1) throw new Error('header'); for (const k of ['host_ctx', 'http_ctx', 'registration', 'request', 'response', 'stub_controllable_inputs', 'plugin_exports']) if (!(k in h)) throw new Error('missing ' + k); if (h.stub_controllable_inputs.slice().sort().join() !== 'host,origin,remoteAddress') throw new Error('inputs'); if (h.registration.kind.join() !== 'exact') throw new Error('kind'); if (h.plugin_exports.getRegistration.status.join() !== 'ok,failed') throw new Error('status'); console.log('PROBE-OK host-contract')\"\n140\t```\n141\t\n142\t期望：stdout 为 `PROBE-OK host-contract`，退出码 0。\n143\t\n144\t**V-008-3 stub 符合契约：校验、失败注入、可控的三项输入**\n145\t\n146\t```\n147\tnode --input-type=module -e \"import { createHostStub } from './test/helpers/host-stub.mjs'; const s = createHostStub(); let seen = null; s.ctx.inject(['webServer'], (h) => { const reg = (p, name) => h.effect(() => h.webServer.register({ kind: 'exact', path: p, handler: (req, res) => { res.statusCode = 200; res.setHeader('content-type', 'application/json'); res.end(JSON.stringify({ ra: req.socket.remoteAddress, host: req.headers.host, origin: req.headers.origin })) } }), name); reg('/x', 'x'); for (const bad of [{ kind: 'prefix', path: '/y', handler: () => {} }, { kind: 'exact', path: 'y', handler: () => {} }, { kind: 'exact', path: '/y', handler: 1 }]) { try { h.webServer.register(bad); throw new Error('accepted ' + JSON.stringify(bad)) } catch (e) { if (!(e instanceof TypeError)) throw e } } seen = h }); if (s.injectCalls.length !== 1 || s.injectCalls[0].join() !== 'webServer' || s.effects.join() !== 'x' || s.registered.length !== 1 || s.registered[0].path !== '/x') throw new Error('records'); const a = await s.request('/x'); const b = await s.request('/x', { remoteAddress: '10.0.0.5', host: 'evil.test', origin: 'http://evil.test' }); const ja = JSON.parse(a.body); const jb = JSON.parse(b.body); if (a.statusCode !== 200 || ja.ra !== '127.0.0.1' || ja.host !== 'localhost') throw new Error('defaults ' + a.body); if (jb.ra !== '10.0.0.5' || jb.host !== 'evil.test' || jb.origin !== 'http://evil.test') throw new Error('controls ' + b.body); const f = createHostStub({ failPaths: ['/boom'] }); f.ctx.inject(['webServer'], (h) => { try { h.webServer.register({ kind: 'exact', path: '/boom', handler: () => {} }); throw new Error('no throw') } catch (e) { if (e.message.indexOf('/boom') < 0) throw e } }); if (f.registered.length !== 0) throw new Error('failed path recorded'); let threw = false; try { createHostStub({ failInject: true }).ctx.inject(['webServer'], () => {}) } catch (e) { threw = true } if (!threw) throw new Error('failInject'); console.log('PROBE-OK host-stub')\"\n148\t```\n149\t\n150\t期望：stdout 为 `PROBE-OK host-stub`，退出码 0。\n151\t\n152\t**V-008-4 createPlugin / getRegistration / apply 的成功、失败与 strict**\n153\t\n154\t```\n155\tnode --input-type=module -e \"import { createPlugin, getRegistration, apply } from './lib/index.js'; import { createHostStub } from './test/helpers/host-stub.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const want = ['/cliworker/forecast', '/cliworker/models', '/cliworker/providers', '/cliworker/select']; const ok = createHostStub(); const c1 = createFakeContext(); const r1 = createPlugin(ok.ctx, {}, { ctx: c1 }); if (r1.errors.length !== 0 || r1.registered.slice().sort().join() !== want.join()) throw new Error('ok ' + JSON.stringify(r1)); if (ok.registered.map((x) => x.path).sort().join() !== want.join()) throw new Error('stub records'); const g1 = getRegistration(); if (g1.status !== 'ok' || g1.errors.length !== 0 || g1.registered.length !== 4) throw new Error('get ok'); const bad = createHostStub({ failPaths: ['/cliworker/models'], failMessage: 'boom' }); const c2 = createFakeContext(); const r2 = createPlugin(bad.ctx, {}, { ctx: c2 }); if (r2.errors.length !== 1 || r2.errors[0].path !== '/cliworker/models' || r2.errors[0].message.indexOf('boom') < 0) throw new Error('partial ' + JSON.stringify(r2)); if (r2.registered.length !== 3 || r2.registered.includes('/cliworker/models')) throw new Error('partial registered'); const g2 = getRegistration(); if (g2.status !== 'failed' || g2.errors.length !== 1) throw new Error('get failed'); if (c2.stderr.text().indexOf('/cliworker/models') < 0) throw new Error('stderr hint'); const c3 = createFakeContext(); apply(createHostStub({ failPaths: ['*'] }).ctx, {}, { ctx: c3 }); if (getRegistration().status !== 'failed' || getRegistration().registered.length !== 0) throw new Error('non-strict'); let err = null; try { apply(createHostStub({ failPaths: ['/cliworker/select'] }).ctx, { strict: true }, { ctx: createFakeContext() }) } catch (e) { err = e } if (!err || err.message.indexOf('cliworker: route registration failed') !== 0 || err.registration.status !== 'failed' || getRegistration().status !== 'failed') throw new Error('strict'); const r4 = createPlugin(createHostStub({ failInject: true }).ctx, {}, { ctx: createFakeContext() }); if (r4.errors.length !== 1 || r4.errors[0].path !== null || r4.registered.length !== 0) throw new Error('inject ' + JSON.stringify(r4)); apply(createHostStub().ctx, { strict: true }, { ctx: createFakeContext() }); if (getRegistration().status !== 'ok') throw new Error('strict ok'); console.log('PROBE-OK registration')\"\n156\t```\n157\t\n158\t期望：stdout 为 `PROBE-OK registration`，退出码 0。\n159\t\n160\t**V-008-5 注册后的 handler 能往返（配置、探测、forecast 都走注入的 ctx）**\n161\t\n162\t```\n163\tnode --input-type=module -e \"import { createPlugin } from './lib/index.js'; import { createHostStub } from './test/helpers/host-stub.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const cfg = JSON.stringify({ providers: { p1: { cli: 'p1cli' } }, models: { m1: { provider: 'p1', id: 'm1', tier: 'top', identity: 'verified' } } }); const ctx = createFakeContext({ files: { '/cw/config.json': cfg }, exec: () => ({ ok: true, code: 0, stdout: '1.2.3', stderr: '', error: null }) }); const s = createHostStub()