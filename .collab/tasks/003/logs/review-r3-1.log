rom 'node:fs'; import path from 'node:path'; const cp = []; const fsu = []; const tm = []; const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name).split(path.sep).join('/'); if (e.isDirectory()) { walk(p); continue } if (!/[.](mjs|js|cjs)$/.test(p)) continue; const s = fs.readFileSync(p, 'utf8'); if (/(node:)?child_process/.test(s)) cp.push(p); if (/from 'node:fs|from 'fs'|require[(]'(node:)?fs/.test(s)) fsu.push(p); if (/Date[.]now|new Date[(][)]|node:timers/.test(s)) tm.push(p) } }; walk('lib'); const same = (a, b) => a.join() === b.join(); if (!same(cp, ['lib/exec.mjs'])) throw new Error('child_process ' + cp); if (!fsu.every((f) => ['lib/context.mjs', 'lib/store.mjs', 'lib/fsx.mjs'].includes(f)) || !fsu.includes('lib/context.mjs')) throw new Error('fs ' + fsu); if (!same(tm, ['lib/context.mjs'])) throw new Error('clock ' + tm); console.log('PROBE-OK seams-real-tree')\"\n```\n\n期望：stdout 为 `PROBE-OK seams-real-tree`，退出码 0。这个探针只做文本匹配，所以 `lib` 里的注释也不能写出 `child_process`、`Date.now`、`new Date()`、`node:timers` 这些字面量（`lib/exec.mjs` 与 `lib/context.mjs` 自身除外）。\n\n## AC-008 宿主 stub 与注册\n\n**V-008-1 自带测试通过**\n\n```\nnode scripts/run-tests.mjs --ac AC-008\n```\n\n期望：run-tests 通过，`✔ [AC-008]` 行至少 5 条，且分布在 `test/contract/host-stub.test.mjs` 与 `test/integration/registration.test.mjs` 两个文件（`run-tests: filtered 2 files` 或更多）。\n\n**V-008-2 契约文件顶层键**\n\n```\nnode --input-type=module -e \"import fs from 'node:fs'; const h = JSON.parse(fs.readFileSync('contracts/host/dsh-host.v1.json', 'utf8')); if (h.contract !== 'dsh-host' || h.version !== 1) throw new Error('header'); for (const k of ['host_ctx', 'http_ctx', 'registration', 'request', 'response', 'stub_controllable_inputs', 'plugin_exports']) if (!(k in h)) throw new Error('missing ' + k); if (h.stub_controllable_inputs.slice().sort().join() !== 'host,origin,remoteAddress') throw new Error('inputs'); if (h.registration.kind.join() !== 'exact') throw new Error('kind'); if (