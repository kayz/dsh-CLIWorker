; let threw = false; try { ctx.now() } catch (e) { threw = e.message.indexOf('CLIWORKER_TEST_CLOCK_FILE') >= 0 } if (!threw) throw new Error('invalid content'); const real = createContext({ env: {} }); if (Math.abs(real.now() - Date.now()) > 5000) throw new Error('real now'); const empty = createContext({ env: { CLIWORKER_TEST_CLOCK_FILE: '' } }); if (Math.abs(empty.now() - Date.now()) > 5000) throw new Error('empty var'); for (const m of ['setNow', 'advance', 'pending']) if (m in real.clock) throw new Error('real clock exposes ' + m) } finally { fs.rmSync(f, { force: true }) } console.log('PROBE-OK test-clock-file')\"\n190\t```\n191\t\n192\t期望：stdout 为 `PROBE-OK test-clock-file`，退出码 0。\n193\t\n194\t**V-072-4 context.v1.json 描述 ctx 接口面，真实 ctx 与 fake ctx 都符合**\n195\t\n196\t```\n197\tnode --input-type=module -e \"import fs from 'node:fs'; import { createContext } from './lib/context.mjs'; import { createFakeContext } from './test/helpers/ctx.mjs'; const spec = JSON.parse(fs.readFileSync('contracts/context/context.v1.json', 'utf8')); if (spec.contract !== 'cliworker.context' || spec.version !== 1 || spec.test_clock_env !== 'CLIWORKER_TEST_CLOCK_FILE') throw new Error('header'); if (spec.fake_clock_extras.join() !== 'setNow,advance,pending' || spec.clock_methods.join() !== 'now,nowIso,setTimeout,clearTimeout,sleep' || spec.stream_methods.join() !== 'write') throw new Error('lists'); if (spec.fs_methods.length !== 9) throw new Error('fs_methods'); const check = (name, ctx, fake) => { if (Object.keys(ctx).sort().join() !== Object.keys(spec.members).sort().join()) throw new Error(name + ' keys ' + Object.keys(ctx)); for (const [k, t] of Object.entries(spec.members)) { const v = ctx[k]; const ok = t === 'stream' ? typeof v.write === 'function' : typeof v === t; if (!ok) throw new Error(name + ' member ' + k); } for (const m of spec.fs_methods) if (typeof ctx.fs[m] !== 'function') throw new Error(name + ' fs.' + m); for (const m of spec.clock_methods) if (typeof ctx.clock[m]