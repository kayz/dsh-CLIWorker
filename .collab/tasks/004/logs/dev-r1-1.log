or of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\r\n  process.stdout.write(`check-ci: FAILED (${errors.length} errors)\\n`)\r\n  process.exitCode = 1\r\n}\r\n\r\nconst invokedDirectly =\r\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\r\n\r\nif (invokedDirectly) main()\r\n--- gen-ci tail ---\n    }\n  }\n\n  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  let matrix\n  try {\n    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  } catch {\n    process.stderr.write(`gen-ci: cannot read ${matrixFile}\\n`)\n    process.exitCode = 2\n    return\n  }\n\n  const text = renderCi(matrix)\n  if (toStdout) {\n    process.stdout.write(text)\n    return\n  }\n\n  const target = path.join(root, WORKFLOW_PATH)\n  fs.mkdirSync(path.dirname(target), { recursive: true })\n  fs.writeFileSync(target, text)\n  process.stdout.write(`gen-ci: wrote ${WORKFLOW_PATH.split(path.sep).join('/')}\\n`)\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n\nif (invokedDirectly) main()"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b6fa65227f21b04060fc2217ec5b","_messageId":"01a1b6fbf17071df958c51645284e836","_meta":{"codebuddy.ai/conversationRequestId":"01a1b6fa65227f21b04060fc2217ec5b","codebuddy.ai/modelRequestId":"01a1b6fbf17071df958c51645284e836","codebuddy.ai/llmMessageId":"01a1b6fbf17071df958c51645284e836","traceparent":"00-1c5a28e5ce22516729d605f778f3c33e-0f3e64f261d56ec0-01","baggage":"codebuddy.session_id=01a1b6fa-6086-7497-9211-6c5c62f23112,codebuddy.conversation_request_id=01a1b6fa65227f21b04060fc2217ec5b"},"__timestamp":"2026-11-07T17:08:56.805Z"}
