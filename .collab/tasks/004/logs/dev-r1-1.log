{"type":"assistant","uuid":"01a1b6f1-7e18-7e84-a9d6-b94c16864f85","session_id":"01a1b6ec-e364-796a-b544-183433e5f1dd","message":{"id":"01a1b6f16be77be7afc2644d57351153","content":[{"type":"tool_use","id":"call_00_0ScG5u5nWrzVMj7o5MFV2679","name":"Bash","input":{"command":"cd /c/git/dsh-CLIWorker/.collab/worktrees/004 && node --input-type=module -e \"\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { validate, checkSchema } from './lib/contract/validate.mjs';\nconst dir='contracts/schemas';\nconst load=(name)=>{const p=path.join(dir,name);return JSON.parse(fs.readFileSync(p,'utf8'));};\nconst names=fs.readdirSync(dir).filter(n=>n.endsWith('.schema.json'));\nconsole.log('schemas',names.length);\nfor(const n of names){const p=checkSchema(load(n)); if(p.length) console.log('UNSUPPORTED',n,p);}\nconst map={'request.v1':'request.v1','handle.v1':'handle.v1','handle-full.v1':'handle-full.v1','selection-ok.v1':'selection-ok.v1','selection-failed.v1':'selection-failed.v1','event.v1':'event.v1','forecast.v1':'forecast.v1','usage.v1':'usage.v1','pool':'pool','model.v1':'model.v1','inventory.v1':'inventory.v1','config.v2':'config.v2','session.v1':'session.v1','error-envelope':'error-envelope'};\nfor(const [ex,s] of Object.entries(map)){\n  const schema=load(s+'.schema.json');\n  const vdir=path.join('contracts/examples',ex,'valid');\n  for(const f of fs.readdirSync(vdir)){const doc=JSON.parse(fs.readFileSync(path.join(vdir,f),'utf8'));const r=validate(schema,doc,{loadSchema:load});if(!r.ok)console.log('VALID FAIL',ex,f,JSON.stringify(r.errors));}\n  const idir=path.join('contracts/examples',ex,'invalid');\n  for(const f of fs.readdirSync(idir)){const spec=JSON.parse(fs.readFileSync(path.join(idir,f),'utf8'));const r=validate(schema,spec.document,{loadSchema:load});if(r.ok||r.errors.length!==1||r.errors[0].path!==spec.expect.path||r.errors[0].keyword!==spec.expect.keyword)console.log('INVALID FAIL',ex,f,JSON.stringify(r.errors));}\n}\nconsole.log('done');\n\"","