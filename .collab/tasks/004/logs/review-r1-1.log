{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tm7yYNnURcxygFSzqzEppx","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Writes contracts/registry.snapshot.json from lib/contract/registry.mjs.\n3\t// Additions require a manual snapshot_version bump; removals, renames and value changes are refused.\n4\timport fs from 'node:fs'\n5\timport path from 'node:path'\n6\timport { fileURLToPath, pathToFileURL } from 'node:url'\n7\t\n8\timport { compareRegistry } from '../lib/contract/registry.mjs'\n9\t\n10\tconst HERE = path.dirname(fileURLToPath(import.meta.url))\n11\tconst REPO_ROOT = path.resolve(HERE, '..')\n12\tconst SNAPSHOT_REL = 'contracts/registry.snapshot.json'\n13\tconst USAGE = 'usage: node scripts/snapshot-update.mjs [--root <dir>]'\n14\t\n15\tfunction deepEqual(a, b) {\n16\t  if (a === b) return true\n17\t  if (typeof a !== typeof b) return false\n18\t  if (a === null || b === null) return false\n19\t  if (typeof a !== 'object') return false\n20\t  if (Array.isArray(a) !== Array.isArray(b)) return false\n21\t  if (Array.isArray(a)) {\n22\t    if (a.length !== b.length) return false\n23\t    for (let i = 0; i < a.length; i += 1) if (!deepEqual(a[i], b[i])) return false\n24\t    return true\n25\t  }\n26\t  const aKeys = Object.keys(a)\n27\t  const bKeys = Object.keys(b)\n28\t  if (aKeys.length !== bKeys.length) return false\n29\t  for (const key of aKeys) {\n30\t    if (!Object.prototype.hasOwnProperty.call(b, key)) return false\n31\t    if (!deepEqual(a[key], b[key])) return false\n32\t  }\n33\t  return true\n34\t}\n35\t\n36\tfunction writeSnapshot(file, registry) {\n37\t  fs.mkdirSync(path.dirname(file), { recursive: true })\n38\t  fs.writeFileSync(file, `${JSON.stringify(registry, null, 2)}\\n`, 'utf8')\n39\t}\n40\t\n41\tfunction readSnapshot(file) {\n42\t  try {\n43\t    return JSON.parse(fs.readFileSync(file, 'utf8'))\n44\t  } catch {\n45\t    return null\n46\t  }\n47\t}\n48\t\n49\tasync function main(argv) {\n50\t  let root = REPO_ROOT\n51\t  for (let i = 0; i < argv.length; i += 1) {\n52\t    const flag = argv[i]\n53\t    if (flag === '--root') {\n54\t      const value = argv[i + 1]\n55\t      if (typeof value !== 'string' || value === '') {\n56\t        process.stderr.write(`snapshot-update: --root requires a directory\\n${USAGE}\\n`)\n57\t        process.exitCode = 2\n58\t        return\n59\t      }\n60\t      root = path.resolve(value)\n61\t      i += 1\n62\t    } else {\n63\t      process.stderr.write(`snapshot-update: unknown argument: ${flag}\\n${USAGE}\\n`)\n64\t      process.exitCode = 2\n65\t      return\n66\t    }\n67\t  }\n68\t\n69\t  const registryFile = path.join(root, 'lib', 'contract', 'registry.mjs')\n70\t  let candidate\n71\t  try {\n72\t    const module = await import(pathToFileURL(registryFile).href)\n73\t    candidate = module.REGISTRY\n74\t  } catch (error) {\n75\t    process.stderr.write(`snapshot-update: cannot load ${registryFile}: ${error.message}\\n`)\n76\t    process.exitCode = 1\n77\t    return\n78\t  }\n79\t  if (!candidate || typeof candidate !== 'object') {\n80\t    process.stderr.write('snapshot-update: candidate module does not export REGISTRY\\n')\n81\t    process.exitCode = 1\n82\t    return\n83\t  }\n84\t\n85\t  const snapshotFile = path.join(root, SNAPSHOT_REL)\n86\t  const snapshot = readSnapshot(snapshotFile)\n87\t\n88\t  if (snapshot === null) {\n89\t    if (candidate.snapshot_version !== 1) {\n90\t      process.stdout.write(\n91\t        `FAIL snapshot.version_not_bumped have=${candidate.snapshot_version} need=1\\n`\n92\t      )\n93\t      process.exitCode = 1\n94\t      return\n95\t    }\n96\t    writeSnapshot(snapshotFile, candidate)\n97\t    process.stdout.write('snapshot-update: wrote snapshot_version 1\\n')\n98\t    process.exitCode = 0\n99\t    return\n100\t  }\n101\t\n102\t  if (deepEqual(snapshot, candidate)) {\n103\t    process.stdout.write(`snapshot-update: unchanged (snapshot_version ${snapshot.snapshot_version})\\n`)\n104\t   