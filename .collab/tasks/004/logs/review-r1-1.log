n12-light','n20-heavy','n2-invalid'].map(k=>qm[k]);const e1=[0.3,3,18,null];if(JSON.stringify(l1)!==JSON.stringify(e1)){throw new Error('quantiles: '+JSON.stringify(l1))};const l2=['tasks-0','tasks-2','tasks-3','tasks-6','frac-0.049','frac-0.05','frac-0.15','unknown-none'].map(k=>tm[k]);const e2=['exhausted/tasks','critical/tasks','low_reserve/tasks','ok/tasks','critical/fraction','low_reserve/fraction','ok/fraction','unknown/none'];if(JSON.stringify(l2)!==JSON.stringify(e2)){throw new Error('thresholds: '+JSON.stringify(l2))};console.log('AC-073 OK')\"`\n255\t- 期望: 分位数为 0.3、3、18、null。\n256\t- 期望: 阈值分类依次为 exhausted/tasks、critical/tasks、low_reserve/tasks、ok/tasks、critical/fraction、low_reserve/fraction、ok/fraction、unknown/none。\n257\t\n258\t## AC-073 G-5 三张关键金标的 expected 子集\n259\t\n260\t- 命令: `node -e \"const q=require('./contracts/golden/quota-shapes.json');const b=require('./contracts/golden/b44.json');const c=require('./contracts/golden/capacity.json');const get=(g,id)=>g.cases.find(x=>x.id===id).expected;const a=get(q,'q-credits-rate');const x=get(b,'b44-reading-then-1m');const y=get(c,'cap-k10-high');const ok=(a.remaining_mtok===0.001&&a.tasks_left===0&&a.tasks_left_basis==='tasks'&&a.risk==='exhausted'&&a.risk_basis==='tasks')&&(x['claude:claude-opus-5-5'].remaining_mtok===0.8&&x['claude:claude-sonnet-5-5'].remaining_mtok===4)&&(y.capacity_mtok===8&&y.k===10&&y.confidence==='high'&&y.source==='measured');if(!ok){throw new Error('expected subset mismatch')};console.log('AC-073 OK')\"`\n261\t- 期望: q-credits-rate 的 remaining_mtok 0.001、tasks_left 0、risk exhausted、risk_basis tasks。\n262\t- 期望: b44-reading-then-1m 中 opus 为 0.8、sonnet 为 4。\n263\t- 期望: cap-k10-high 的 capacity_mtok 8、k 10、confidence high、source measured。\n264\t\n265\t## AC-073 G-6 金标的 kind 与外壳\n266\t\n267\t- 命令: `node -e \"const ps=['quota-shapes.json','b44.json','capacity.json','forecast/thresholds.json','forecast/quantiles.json','forecast/confidence.json','forecast/burn-eta.json','policy/p1-order.json