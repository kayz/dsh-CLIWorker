alog={models:[{key:'k:zeta-model-9',id:'zeta-model-9',cli:'zetacli'}]}; const w={command:'node',bin:'bin/cliworker.mjs',state_dir:'/s',config:'/c'}; const hit=scanView({a:{b:{Model_Key:'x'}}},{forbidden,catalog,wrapper:w}); const val=scanView({a:[{m:'use zeta-model-9 now'}]},{forbidden,catalog,wrapper:w}); const clean=scanView({note:'cliworker config dsh-CLIWorker'},{forbidden,catalog,wrapper:w}); const same=(x,y)=>JSON.stringify(x)===JSON.stringify(y); if(!same(hit.hits.map(h=>[h.path,h.kind]),[['/a/b/Model_Key','forbidden_key']])){throw new Error('key hit mismatch: '+JSON.stringify(hit.hits))}; if(!same(val.hits.map(h=>[h.path,h.kind]),[['/a/0/m','forbidden_value']])){throw new Error('value hit mismatch: '+JSON.stringify(val.hits))}; if(!clean.ok||clean.hits.length!==0){throw new Error('clean sample produced hits')}; console.log('AC-011 OK')\"`\n126\t- 期望: 禁用键在 /a/b/Model_Key 以 forbidden_key 命中。\n127\t- 期望: 禁用值在 /a/0/m 以 forbidden_value 命中。\n128\t- 期望: 干净样例 0 命中。\n129\t\n130\t## AC-011 E-3 call 子树的模板比对\n131\t\n132\t- 命令: `node --input-type=module -e \"import {scanView} from './lib/contract/scan.mjs'; import fs from 'node:fs'; const forbidden=JSON.parse(fs.readFileSync('contracts/agentline-forbidden.json','utf8')); const catalog={models:[{key:'k:zeta-model-9',id:'zeta-model-9',cli:'zetacli'}]}; const w={command:'node',bin:'bin/cliworker.mjs',state_dir:'/s',config:'/c'}; const call=(over)=>({command:'node',args:['bin/cliworker.mjs','run','--lease','l_abc','--state-dir','/s','--config','/c'],cwd:'C:/work/zeta-model-9',input:'stdin',output:'cliworker.event/v1',timeout_ms:1000,...over}); const v=(c)=>({models:[{lease_id:'l_abc',call:c}],calls:[c]}); const ok=scanView(v(call({})),{forbidden,catalog,wrapper:w}); const bad=scanView(v(call({command:'zetacli'})),{forbidden,catalog,wrapper:w}); if(!ok.ok||ok.hits.length!==0){throw new Error('compliant call produced hits: '+JSON.stringify(ok.hits))}; if(bad.ok){throw new Error('tampered call passed')}; const kinds=[...new Set(bad.hits.map(h=>h.kind))]; if(kinds.length!==1||kinds[0]!=='call_mismatch'){throw new Error('unexpected kinds: '+kinds.join())}; console.log('AC-011 OK')\"`\n133\t- 期望: 合规 call 0 命中，cwd 含模型 id 不算命中。\n134\t- 期望: 改 command 只报 call_mismatch。\n135\t\n136\t## AC-073 A-4 测试入口\n137\t\n138\t- 命令: `$o = (node scripts/run-tests.mjs --ac AC-073 2>&1 | Out-String); $e = $LASTEXITCODE; if ($e -ne 0) { throw \"run-tests exited $e\" }; if ($o -notmatch 'run-tests: filtered') { throw 'missing run-tests: filtered' }; if ($o.Contains([string][char]0x2716)) { throw 'output contains the failure mark' }; Write-Output 'AC-073 OK'`\n139\t- 期望: 输出含 run-tests: filtered。\n140\t- 期望: 退出码 0。\n141\t- 期望: 输出里没有失败标记行。\n142\t\n143\t## AC-073 B-4 测试标题齐全\n144\t\n145\t- 命令: `$o = (node scripts/run-tests.mjs --ac AC-073 2>&1 | Out-String); if ($LASTEXITCODE -ne 0) { throw 'run-tests failed' }; $t = @('[AC-073] snapshot, spec, golden and forbidden files are tracked by git and not ignored','[AC-073] every spec and golden file validates against its schema','[AC-073] golden files hold the required case ids','[AC-073] manifest registers every spec and golden file with its normalized sha256','[AC-073] check-golden-frozen fails when a golden file is modified','[AC-073] check-golden-frozen fails when a golden file is added','[AC-073] check-golden-frozen fails when a golden file is deleted','[AC-073] check-write-scope reports an unregistered spec or golden file','[AC-073] check-write-scope reports changes outside the write scope','[AC-073] check-write-scope reads write_scope from markdown front matter','[AC-073] check-no-collab reports zero references in the repository','[AC-073] check-no-collab reports the violating fixture and passes the clean fixture','[AC-073] gen-contract-doc output equals the committed docs/contract.md','[AC-073] check-contract-doc fails on a stale document','[AC-073] snapshot contains every code, trigger, threshold, reason, mapping and semantic_change of interfaces section 5','[AC-073]