 += 1\n159\t    } else if (flag === '--out-dir') {\n160\t      const value = argv[i + 1]\n161\t      if (typeof value !== 'string' || value === '') return { error: '--out-dir requires a directory' }\n162\t      options.outDir = path.resolve(value)\n163\t      i += 1\n164\t    } else if (flag === '--perf') {\n165\t      options.perf = true\n166\t    } else if (flag === '--update-snapshots') {\n167\t      options.updateSnapshots = true\n168\t    } else {\n169\t      return { error: `unknown argument: ${flag}` }\n170\t    }\n171\t  }\n172\t  options.acs = [...new Set(options.acs)]\n173\t  return { options }\n174\t}\n175\t\n176\tfunction runNode(args, spawnOptions) {\n177\t  return new Promise((resolve) => {\n178\t    // A nested `node --test` refuses to run its files when it inherits NODE_TEST_CONTEXT from\n179\t    // the parent test process. Nested runs are legitimate here (self-tests and the milestone\n180\t    // gate spawn run-tests), so the child must look like a top-level run.\n181\t    const env = { ...(spawnOptions.env ?? process.env) }\n182\t    delete env.NODE_TEST_CONTEXT\n183\t    const child = spawn(process.execPath, args, { ...spawnOptions, env })\n184\t    child.on('error', () => resolve({ code: null, signal: null }))\n185\t    child.on('close', (code, signal) => resolve({ code, signal }))\n186\t  })\n187\t}\n188\t\n189\tfunction readManifest(file) {\n190\t  try {\n191\t    return JSON.parse(fs.readFileSync(file, 'utf8'))\n192\t  } catch {\n193\t    return null\n194\t  }\n195\t}\n196\t\n197\tasync function main() {\n198\t  const parsed = parseArgs(process.argv.slice(2))\n199\t  if (parsed.error) {\n200\t    usageError(parsed.error)\n201\t    return\n202\t  }\n203\t  const options = parsed.options\n204\t  const root = options.root\n205\t\n206\t  if (options.perf) {\n207\t    const files = enumeratePerfFiles(root)\n208\t    if (files.length === 0) {\n209\t      process.stdout.write('run-tests: no perf tests\\n')\n210\t      return\n211\t    }\n212\t    const result = await runNode(['--test', ...files], { cwd: root, stdio: 'inherit' })\n213\t    process.exitCode = result.code === null ? 1 : result.code\n214\t    return\n215\t  }\n216\t\n217\t  const filtered = options.acs.length > 0\n218\t  const outDir = options.outDir ?? (process.env.CLIWORKER_RESULTS_DIR\n219\t    ? path.resolve(process.env.CLIWORKER_RESULTS_DIR)\n220\t    : defaultOutDir(root))\n221\t\n222\t  if (\n223\t    process.env.CLIWORKER_RUN_ACTIVE &&\n224\t    process.env.CLIWORKER_RESULTS_DIR &&\n225\t    normalizePath(outDir) === normalizePath(process.env.CLIWORKER_RESULTS_DIR)\n226\t  ) {\n227\t    process.stderr.write(\n228\t      'run-tests: refusing to run nested inside the parent run (a nested run would overwrite the parent artifacts)\\n'\n229\t    )\n230\t    process.exitCode = 2\n231\t    return\n232\t  }\n233\t\n234\t  fs.mkdirSync(outDir, { recursive: true })\n235\t  const manifestPath = path.join(outDir, MANIFEST_NAME)\n236\t  const skipsPath = path.join(outDir, SKIPS_NAME)\n237\t  fs.rmSync(manifestPath, { force: true })\n238\t  fs.writeFileSync(skipsPath, '')\n239\t\n240\t  const enumerated = enumerateTestFiles(root)\n241\t  let files = enumerated\n242\t\n243\t  if (filtered) {\n244\t    const needles = options.acs.map((ac) => `[${ac}]`)\n245\t    files = enumerated.filter((file) => {\n246\t      let source = ''\n247\t      try {\n248\t        source = fs.readFileSync(path.join(root, file), 'utf8')\n249\t      } catch {\n250\t        return false\n251\t      }\n252\t      return needles.some((needle) => source.includes(needle))\n253\t    })\n254\t    if (files.length === 0) {\n255\t      for (const ac of options.acs) process.stdout.write(`FAIL run.no_match ${ac}\\n`)\n256\t      process.exitCode = 1\n257\t      return\n258\t    }\n259\t  } else {\n260\t    const orphans = findOrphans(root)\n261\t    if (orphans.length > 0) {\n262\t      for (const file of orphans) process.stdout.write(`FAIL discovery.orphan ${file}\\n`)\n263\t      process.exitCode = 1\n264\t      return\n265\t    }\n266\t  }\n267\t\n268\t  if (files.length === 0) {\n269\t    process.stdout.write('FAIL discovery.no_files\\n')\n270\t    process.exitCode = 1\n271\t    return\n272\t  }\n273\t\n274\t  const joined = files.join(' ')\n275\t  if (joined.length > MAX_ARG_CHARS) {\n276\t    usageError(`run-tests: file list is too long for one command line (${joined.length} characters)`)\n277\t    return\n278\t  }\n279\t\n280\t  const mode = filtered ? 'filtered' : 'full'\n281\t  const env = {\n282\t    ...process.env,\n283\t    CLIWORKER_RUN_MODE: mode,\n284\t    CLIWORKER_RUN_FILTER: filtered ? options.acs.join(',') : '',\n285\t    CLIWORKER_ROOT: root,\n286\t    CLIWORKER_RESULTS_DIR: outDir,\n287\t    CLIWORKER_RUN_ACTIVE: '1',\n288\t  }\n289\t  if (options.updateSnapshots) env.CLIWORKER_UPDATE_SNAPSHOT = '1'\n290\t\n291\t  const args = [\n292\t    '--test',\n293\t    '--test-reporter=spec',\n294\t    '--test-reporter-destination=stdout',\n295\t    `--test-reporter=${REPORTER}`,\n296\t    `--test-reporter-destination=${manifestPath}`,\n297\t    ...files,\n298\t  ]\n299\t\n300\t  const result = await runNode(args, { cwd: root, stdio: 'inherit', env })\n301\t  let exitCode = result.code === null ? 1 : result.code\n302\t\n303\t  if (!filtered) {\n304\t    const manifest = readManifest(manifestPath)\n305\t    const verification = verifyFullRun({ enumerated: files, manifest })\n306\t    if (!verification.ok) {\n307\t      for (const error of verification.errors) {\n308\t        process.stdout.write(`FAIL ${error.id} ${error.path}\\n`)\n309\t      }\n310\t      if (exitCode === 0) exitCode = 1\n311\t    }\n312\t  }\n313\t\n314\t  process.stdout.write(`run-tests: ${mode} ${files.length} files, manifest ${manifestPath}\\n`)\n315\t  process.exitCode = exitCode\n316\t}\n317\t\n318\tconst invokedDirectly =\n319\t  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n320\t\n321\tif (invokedDir