{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSanPsGUDorLLouQphHvtK","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Test runner: enumerates test files, runs them with node:test, and verifies that the\n3\t// files the reporter saw match the files we enumerated (full runs only).\n4\timport fs from 'node:fs'\n5\timport os from 'node:os'\n6\timport path from 'node:path'\n7\timport crypto from 'node:crypto'\n8\timport { spawn } from 'node:child_process'\n9\timport { fileURLToPath, pathToFileURL } from 'node:url'\n10\t\n11\tconst HERE = path.dirname(fileURLToPath(import.meta.url))\n12\tconst REPO_ROOT = path.resolve(HERE, '..')\n13\tconst REPORTER = pathToFileURL(path.join(HERE, 'reporters', 'files.mjs')).href\n14\tconst MANIFEST_NAME = 'files-executed.json'\n15\tconst SKIPS_NAME = 'skips.jsonl'\n16\tconst AC_PATTERN = /^AC-\\d{3}$/\n17\tconst MAX_ARG_CHARS = 24000\n18\t\n19\tconst TEST_DIRS = ['unit', 'integration', 'contract', 'e2e', 'smoke', 'characterization', 'flows']\n20\tconst EXCLUDED_TOP = new Set(['fixtures', 'helpers', 'perf'])\n21\t\n22\tconst USAGE =\n23\t  'usage: node scripts/run-tests.mjs [--ac AC-nnn]... [--root <dir>] [--out-dir <dir>] [--perf] [--update-snapshots]'\n24\t\n25\tfunction toPosix(value) {\n26\t  return value.split(path.sep).join('/')\n27\t}\n28\t\n29\tfunction walkFiles(dir, onFile) {\n30\t  let entries\n31\t  try {\n32\t    entries = fs.readdirSync(dir, { withFileTypes: true })\n33\t  } catch {\n34\t    return\n35\t  }\n36\t  for (const entry of entries) {\n37\t    const full = path.join(dir, entry.name)\n38\t    if (entry.isDirectory()) walkFiles(full, onFile)\n39\t    else if (entry.isFile()) onFile(full)\n40\t  }\n41\t}\n42\t\n43\texport function enumerateTestFiles(root) {\n44\t  const base = path.resolve(root)\n45\t  const found = []\n46\t  for (const name of TEST_DIRS) {\n47\t    const start = path.join(base, 'test', name)\n48\t    let stat\n49\t    try {\n50\t      stat = fs.statSync(start)\n51\t    } catch {\n52\t      continue\n53\t    }\n54\t    if (!stat.isDirectory()) continue\n55\t    walkFiles(start, (file) => {\n56\t      if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n57\t    })\n58\t  }\n59\t  return [...new Set(found)].sort()\n60\t}\n61\t\n62\texport function enumeratePerfFiles(root) {\n63\t  const base = path.resolve(root)\n64\t  const start = path.join(base, 'test', 'perf')\n65\t  try {\n66\t    if (!fs.statSync(start).isDirectory()) return []\n67\t  } catch {\n68\t    return []\n69\t  }\n70\t  const found = []\n71\t  walkFiles(start, (file) => {\n72\t    if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n73\t  })\n74\t  return [...new Set(found)].sort()\n75\t}\n76\t\n77\texport function findOrphans(root) {\n78\t  const base = path.resolve(root)\n79\t  const testDir = path.join(base, 'test')\n80\t  let entries\n81\t  try {\n82\t    entries = fs.readdirSync(testDir, { withFileTypes: true })\n83\t  } catch {\n84\t    return []\n85\t  }\n86\t\n87\t  const all = []\n88\t  for (const entry of entries) {\n89\t    if (entry.isDirectory()) {\n90\t      if (EXCLUDED_TOP.has(entry.name)) continue\n91\t      walkFiles(path.join(testDir, entry.name), (file) => {\n92\t        if (file.endsWith('.test.mjs')) all.push(file)\n93\t      })\n94\t    } else if (entry.isFile() && entry.name.endsWith('.test.mjs')) {\n95\t      all.push(path.join(testDir, entry.name))\n96\t    }\n97\t  }\n98\t\n99\t  const enumerated = new Set(enumerateTestFiles(base))\n100\t  return [...new Set(all.map((file) => toPosix(path.relative(base, file))))]\n101\t    .filter((file) => !enumerated.has(file))\n102\t    .sort()\n103\t}\n104\t\n105\texport function verifyFullRun({ enumerated, manifest }) {\n106\t  const errors = []\n107\t  const files = Array.isArray(manifest?.files) ? manifest.files : []\n108\t  if (!manifest || manifest.mode !== 'full') {\n109\t    errors.push({ id: 'discovery.mode_not_full', path: manifest?