{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WkeHsSnThiJSx6bSCWv2kx","type":"tool_result","content":"1\timport os from 'node:os'\n2\timport path from 'node:path'\n3\t\n4\texport const SCHEMA = 'cliworker.config/v1'\n5\t\n6\texport function defaultHome(env = process.env) {\n7\t  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n8\t}\n9\t\n10\texport function loadConfig({ file, ctx } = {}) {\n11\t  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\n12\t  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\n13\t  let raw\n14\t  try { raw = JSON.parse(ctx.fs.readFileSync(root, 'utf8')) } catch (e) {\n15\t    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n16\t    error.code = 'E_CONFIG'\n17\t    throw error\n18\t  }\n19\t  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n20\t  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n21\t  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n22\t  return { ...raw, _file: root, _home: defaultHome(ctx.env) }\n23\t}\n24\t\n25\texport function ensureDir(dir, ctx) { ctx.fs.mkdirSync(dir, { recursive: true }); return dir }\n26\t\n27\texport function readUsage(file, ctx) {\n28\t  try {\n29\t    return ctx.fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n30\t  } catch { return [] }\n31\t}\n32\t\n33\texport function appendUsage(file, row, ctx) {\n34\t  ensureDir(path.dirname(file), ctx)\n35\t  ctx.fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"0bfa0d66-79bf-49f7-9a23-e57889824977","uuid":"47aa0f0e-bbce-4ff5-ad88-6893c964ed9d","timestamp":"2026-11-07T18:22:01.153Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\005\\lib\\config.mjs","content":"import os from 'node:os'\nimport path from 'node:path'\n\nexport const SCHEMA = 'cliworker.config/v1'\n\nexport function defaultHome(env = process.env) {\n  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\n}\n\nexport function loadConfig({ file, ctx } = {}) {\n  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\n  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\n  let raw\n  try { raw = JSON.parse(ctx.fs.readFileSync(root, 'utf8')) } catch (e) {\n    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\n    error.code = 'E_CONFIG'\n    throw error\n  }\n  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\n  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\n  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\n  return { ...raw, _file: root, _home: defaultHome(ctx.env) }\n}\n\nexport function ensureDir(dir, ctx) { ctx.fs.mkdirSync(dir, { recursive: true }); return dir }\n\nexport function readUsage(file, ctx) {\n  try {\n    return ctx.fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\n  } catch { return [] }\n}\n\nexport function appendUsage(file, row, ctx) {\n  ensureDir(path.dirname(file), ctx)\n  ctx.fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\n}\n","numLines":37,"startLine":1,"totalLines":37}},"tool_result_meta":[{"id":"toolu_01WkeHsSnThiJSx6bSCWv2kx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
