e:path'\",\n  \"import { defaultHome } from '../config.mjs'\",\n  '',\n  'export function arg(argv, name, fallback) {',\n  '  const i = argv.indexOf(name)',\n  '  return i >= 0 ? argv[i + 1] : fallback',\n  '}',\n  '',\n  'export function flag(argv, name) {',\n  '  return argv.includes(name)',\n  '}',\n  '',\n  'export function usageFile(config, ctx) {',\n  \"  return path.join(config._home || defaultHome(ctx.env), 'usage.jsonl')\",\n  '}',\n])\nconsole.log('AC-013 OK')\n'@\n[System.IO.File]::WriteAllText($tmp, $code, (New-Object System.Text.UTF8Encoding $false))\n& node $tmp\n$e = $LASTEXITCODE\nRemove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue\nif ($e -ne 0) { exit $e }\n```\n\n- 期望: `bin/cliworker.mjs` 仍只调用 `lib/cli.mjs` 的 `main`，没有 `paths`、`init` 或 `loadConfig`。`lib/commands/_util.mjs` 的 `usageFile` 仍读 `config._home`。\n- 期望: 最后一行是 `AC-013 OK`。\n\n## AC-014 A-1 测试入口\n\n```powershell\n$o = (node scripts/run-tests.mjs --ac AC-014 2>&1 | Out-String); if ($LASTEXITCODE -ne 0) { throw \"run-tests exited $LASTEXITCODE\" }; if ($o -notmatch 'run-tests: filtered 2 files, manifest ') { throw 'file count' }; if ($o.Contains([string][char]0x2716)) { throw 'output contains the failure mark' }; Write-Output 'AC-014 OK'\n```","isEmpty":false,"exceededLimit":false,"totalLines":702,"fileSize":37503,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/005/.collab/tasks/005/acceptance.md","readRange":{"startLine":510,"endLine":579},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-72a815e6-ca2b-4de8-997b-7401539d3fd4-307\nfc_adea8df3-aa0c-92b2-b247-fbe68315ebca_2","startedAtMs":"1794078446764","completedAtMs":"1794078446920"},"model_call_id":"fe333896-d935-4c3c-a423-c9ca6f69698b-255-27e7","session_id":"55656fba-0f42-46d7-9d11-d4df87432f6e","timestamp_ms":1794078447076}
