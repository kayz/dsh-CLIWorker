ow: resolve(o.now, () => clock.now()),\n  }\n}\n\nexport function systemNow() {\n  return createRealClock({ env: process.env, fs }).now()\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":66,"fileSize":1835,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/005/lib/context.mjs","readRange":{"startLine":1,"endLine":66},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-9e56e5be-d3f6-4ea1-ab07-b690340c4ce3-58\nfc_4499c98e-1c41-9238-971b-32c1a8d53bbc_0","startedAtMs":"1794077368553","completedAtMs":"1794077368779"},"model_call_id":"fe333896-d935-4c3c-a423-c9ca6f69698b-19-jl4l","session_id":"55656fba-0f42-46d7-9d11-d4df87432f6e","timestamp_ms":1794077368945}
