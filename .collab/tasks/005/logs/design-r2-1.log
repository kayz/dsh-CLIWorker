{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WTHeHCSiBVefeHQBJZKorE","type":"tool_result","content":"588a697 stage(design): task 005\n=== lib/config.mjs\nimport os from 'node:os'\r\nimport path from 'node:path'\r\n\r\nexport const SCHEMA = 'cliworker.config/v1'\r\n\r\nexport function defaultHome(env = process.env) {\r\n  return env.CLIWORKER_HOME || path.join(os.homedir(), '.cliworker')\r\n}\r\n\r\nexport function loadConfig({ file, ctx } = {}) {\r\n  if (!ctx || !ctx.fs) throw new TypeError('loadConfig requires ctx.fs')\r\n  const root = path.resolve(file || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json'))\r\n  let raw\r\n  try { raw = JSON.parse(ctx.fs.readFileSync(root, 'utf8')) } catch (e) {\r\n    const error = new Error(`cannot read CLIWorker config ${root}: ${e.message}`)\r\n    error.code = 'E_CONFIG'\r\n    throw error\r\n  }\r\n  if (!raw || raw.schema && raw.schema !== SCHEMA) throw new Error(`unsupported CLIWorker config schema: ${raw.schema}`)\r\n  if (!raw.providers || typeof raw.providers !== 'object') throw new Error('providers is required')\r\n  if (!raw.models || typeof raw.models !== 'object') throw new Error('models is required')\r\n  return { ...raw, _file: root, _home: defaultHome(ctx.env) }\r\n}\r\n\r\nexport function ensureDir(dir, ctx) { ctx.fs.mkdirSync(dir, { recursive: true }); return dir }\r\n\r\nexport function readUsage(file, ctx) {\r\n  try {\r\n    return ctx.fs.readFileSync(file, 'utf8').split(/\\r?\\n/).filter(Boolean).map((l) => JSON.parse(l))\r\n  } catch { return [] }\r\n}\r\n\r\nexport function appendUsage(file, row, ctx) {\r\n  ensureDir(path.dirname(file), ctx)\r\n  ctx.fs.appendFileSync(file, JSON.stringify(row) + '\\n', 'utf8')\r\n}\r\n=== lib/index.js\n/**\r\n * dsh-cliworker — DSH host plugin.\r\n *\r\n * AgentLine and other clients only need the model source pointer:\r\n *   modelSource = { kind: \"cliworker\", command: \"node\",\r\n *                   args: [\".../dsh-CLIWorker/bin/cliworker.mjs\", \"--config\", \"...\"] }\r\n *\r\n * The plugin exposes the same selection contract over DSH routes for UI use.\r\n */\r\nimport path from 'node:path'\r\nimport { createContext } from './context.mjs'\r\nimport { loadConfig, defaultHome } from './config.mjs'\r\nimport { providerStatus } from './availability.mjs'\r\nimport { listModels, selectModels } from './select.mjs'\r\nimport { forecast } from './forecast.mjs'\r\n\r\nexport const name = 'cliworker'\r\n\r\nlet report = null\r\n\r\nfunction send(res, body, code = 200) {\r\n  res.statusCode = code\r\n  res.setHeader('content-type', 'application/json; charset=utf-8')\r\n  res.setHeader('cache-control', 'no-store')\r\n  res.end(JSON.stringify(body))\r\n}\r\n\r\nfunction readBody(req) {\r\n  return new Promise((resolve, reject) => {\r\n    let raw = ''\r\n    req.on('data', (d) => { raw += d.toString(); if (raw.length > 2_000_000) req.destroy() })\r\n    req.on('end', () => { try { resolve(raw ? JSON.parse(raw) : {}) } catch (e) { reject(e) } })\r\n    req.on('error', reject)\r\n  })\r\n}\r\n\r\nexport function createPlugin(hostCtx, settings = {}, deps = {}) {\r\n  const s = { readonly: false, ...(settings || {}) }\r\n  const ctx = deps.ctx || createContext()\r\n  const registered = []\r\n  const errors = []\r\n  report = { registered, errors }\r\n\r\n  const file = s.configPath || ctx.env.CLIWORKER_CONFIG || path.join(defaultHome(ctx.env), 'config.json')\r\n  const getConfig = () => loadConfig({ file, ctx })\r\n\r\n  const fail = (where, error) => {\r\n    const message = String((error && error.message) || error)\r\n    errors.push({ path: where, message })\r\n    ctx.stderr.write(`[cliworker] route registration failed: ${where === null ? '(inject)' : where}: ${message}\\n`)\r\n  }\r\n\r\n  const route = (httpCtx, routePath, label, handler) => {\r\n    try {\r\n      httpCtx.effect(() => httpCtx.webServer.register({ kind: 'exact', path: routePath, handler }), label)\r\n      registered.push(routePath)\r\n    } catch (e) {\r\n      fail(routePath, e)\r\n    }\r\n  }\r\n\r\n  try {\r\n    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\r\n    hostCtx.inject(['webServer'], (httpCtx) => {\r\n      route(httpCtx, '/cliworker/providers', 'cliworker: providers', async (_req, res) => {\r\n        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c, { ctx }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n      })\r\n      route(httpCtx, '/cliworker/models', 'cliworker: models', async (_req, res) => {\r\n        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c, { ctx }), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n      })\r\n      route(httpCtx, '/cliworker/select', 'cliworker: select', async (req, res) => {\r\n        try {\r\n          const c = getConfig()\r\n          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\r\n          const request = body.request || body\r\n          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c, { ctx }) }) })\r\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\r\n      })\r\n      route(httpCtx, '/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\r\n        try {\r\n          const c = getConfig()\r\n          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\r\n          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null, now: ctx.now() }) })\r\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\r\n      })\r\n    })\r\n  } catch (e) {\r\n    fail(null, e)\r\n  }\r\n\r\n  return { registered, errors }\r\n}\r\n\r\nexport function getRegistration() {\r\n  if (!report) return { status: 'failed', registered: [], errors: [{ path: null, message: 'plugin not applied' }] }\r\n  const errors = report.errors.map((item) => ({ path: item.path, message: item.message }))\r\n  return { status: errors.length > 0 ? 'failed' : 'ok', registered: report.registered.slice(), errors }\r\n}\r\n\r\nexport function apply(hostCtx, settings = {}, deps = {}) {\r\n  const s = settings || {}\r\n  const result = createPlugin(hostCtx, s, deps)\r\n  if (s.strict === true && result.errors.length > 0) {\r\n    const detail = result.errors.map((item) => `${item.path === null ? '(inject)' : item.path}: ${item.message}`).join('; ')\r\n    const error = new Error(`cliworker: route registration failed: ${detail}`)\r\n    error.registration = getRegistration()\r\n    throw error\r\n  }\r\n}\r\n=== lib/cli.mjs\nimport { loadConfig } from './config.mjs'\r\nimport * as providersList from './commands/providers/list.mjs'\r\nimport * as modelsList from './commands/models/list.mjs'\r\nimport * as modelsSelect from './commands/models/select.mjs'\r\nimport * as modelsForecast from './commands/models/forecast.mjs'\r\nimport * as usageRecord from './commands/usage/record.mjs'\r\nimport * as usageSummary from './commands/usage/summary.mjs'\r\nimport { arg } from './commands/_util.mjs'\r\n\r\nconst USAGE = 'usage: cliworker providers | models list|select|forecast | usage record|summary'\r\n\r\nconst ROUTES = [\r\n  { cmd: 'providers', sub: null, module: providersList },\r\n  { cmd: 'models', sub: null, module: modelsList },\r\n  { cmd: 'models', sub: 'select', module: modelsSelect },\r\n  { cmd: 'models', sub: 'forecast', module: modelsForecast },\r\n  { cmd: 'usage', sub: 'record', module: usageRecord },\r\n  { cmd: 'usage', sub: 'summary', module: usageSummary },\r\n]\r\n\r\nfunction resolveRoute(argv) {\r\n  const cmd = argv[0]\r\n  let sub = argv[1] === undefined ? null : argv[1]\r\n  if (cmd === 'providers') sub = null\r\n  else if (cmd === 'models') { if (sub === '' || sub === 'list') sub = null }\r\n  else if (cmd !== 'usage') return null\r\n  const match = ROUTES.find((route) => route.cmd === cmd && route.sub === sub)\r\n  return match ? match.module : null\r\n}\r\n\r\nfunction warnAboutTestClock(ctx, result) {\r\n  const file = ctx.env ? ctx.env.CLIWORKER_TEST_CLOCK_FILE : undefined\r\n  if (typeof file !== 'string' || file === '') return\r\n  if (!result || typeof result !== 'object') return\r\n  if (Array.isArray(result.warnings)) result.warnings.push({ code: 'W_TEST_CLOCK' })\r\n  else result.warnings = [{ code: 'W_TEST_CLOCK' }]\r\n}\r\n\r\nexport async function main(argv, ctx) {\r\n  const route = resolveRoute(argv)\r\n  if (!route) {\r\n    ctx.stderr.write(`ERROR: ${USAGE}\\n`)\r\n    return { exitCode: 1 }\r\n  }\r\n  try {\r\n    const config = loadConfig({ file: arg(argv, '--config'), ctx })\r\n    const result = await route.run({ argv, ctx, config })\r\n    warnAboutTestClock(ctx, result)\r\n    ctx.stdout.write(JSON.stringify(result, null, 2) + '\\n')\r\n    return { exitCode: 0 }\r\n  } catch (e) {\r\n    ctx.stderr.write(`ERROR: ${e.message}\\n`)\r\n    return { exitCode: e.exitCode ?? 1 }\r\n  }\r\n}\r\n=== lib/commands/_util.mjs\nimport path from 'node:path'\r\nimport { defaultHome } from '../config.mjs'\r\n\r\nexport function arg(argv, name, fallback) {\r\n  const i = argv.indexOf(name)\r\n  return i >= 0 ? argv[i + 1] : fallback\r\n}\r\n\r\nexport function flag(argv, name) {\r\n  return argv.includes(name)\r\n}\r\n\r\nexport function usageFile(config, ctx) {\r\n  return path.join(config._home || defaultHome(ctx.env), 'usage.jsonl')\r\n}\r\n=== bin/cliworker.mjs\n#!/usr/bin/env node\r\nimport { main } from '../lib/cli.mjs'\r\nimport { createContext } from '../lib/context.mjs'\r\n\r\nconst { exitCode } = await main(process.argv.slice(2), createContext())\r\nprocess.exitCode =