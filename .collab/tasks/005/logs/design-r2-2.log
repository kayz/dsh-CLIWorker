: '1',\n  }\n  if (options.updateSnapshots) env.CLIWORKER_UPDATE_SNAPSHOT = '1'\n\n  const args = [\n    '--test',\n    '--test-reporter=spec',\n    '--test-reporter-destination=stdout',\n    `--test-reporter=${REPORTER}`,\n    `--test-reporter-destination=${manifestPath}`,\n    ...files,\n  ]\n\n  const result = await runNode(args, { cwd: root, stdio: 'inherit', env })\n  let exitCode = result.code === null ? 1 : result.code\n\n  if (!filtered) {\n    const manifest = readManifest(manifestPath)\n    const verification = verifyFullRun({ enumerated: files, manifest })\n    if (!verification.ok) {\n      for (const error of verification.errors) {\n        process.stdout.write(`FAIL ${error.id} ${error.path}\\n`)\n      }\n      if (exitCode === 0) exitCode = 1\n    }\n  }\n\n  process.stdout.write(`run-tests: ${mode} ${files.length} files, manifest ${manifestPath}\\n`)\n  process.exitCode = exitCode\n}\n\nconst invokedDirectly =\n  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()","isEmpty":false,"exceededLimit":false,"totalLines":327,"fileSize":10528,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/005/scripts/run-tests.mjs","readRange":{"startLine":230,"endLine":319},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-8f90ab15-92d8-417b-96d1-69c2eb1e7535-49\nfc_660afaa9-b9f3-9a86-b827-522b454d750c_3","startedAtMs":"1794076247008","completedAtMs":"1794076247182"},"model_call_id":"1419d7b9-b2c5-497f-97fb-46031fc7648b-16-efya","session_id":"c184d3d4-8afd-4ca2-8bcf-45797c342546","timestamp_ms":1794076247386}
