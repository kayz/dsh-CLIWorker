on', 'defects']\r\nconst CANARY_DIR = ['test', 'characterization', 'canary']\r\nconst COPY_DIR = ['test', 'fixtures', 'characterization', 'v0.1']\r\n\r\nconst RUN_TIMEOUT_MS = 60_000\r\nconst REPRO_OPEN_RE = /^test\\(['\"`]\\[repro\\]/\r\nconst TAP_REPRO_OK_RE = /^\\s*ok \\d+ - \\[repro\\]/m\r\nconst TAP_REPRO_NOT_OK_RE = /^\\s*not ok \\d+ - \\[repro\\]/m\r\nconst RELATIVE_IMPORT_RE = /(\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\bimport\\s+)(['\"])(\\.[^'\"]*)\\2/g\r\n\r\nexport function milestoneRank(value) {\r\n  const index = MILESTONES.indexOf(value)\r\n  return index < 0 ? Number.NaN : index + 1\r\n}\r\n\r\nexport function hasFixedSection(source) {\r\n  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\r\n}\r\n\r\nexport function checkDefects({ root, index, milestone }) {\r\n  const errors = []\r\n  const ledgerFile = path.join(root, ...LEDGER)\r\n\r\n  if (!fs.existsSync(ledgerFile)) {\r\n    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\r\n    return { errors, absent: true }\r\n  }\r\n\r\n  let ledger = null\r\n  try {\r\n    ledger = JSON.parse(fs.readFileSync(ledgerFile, 'utf8'))\r\n  } catch {\r\n    errors.push({ id: 'defects.schema', detail: 'defect ledger is not valid JSON' })\r\n    return { errors, absent: false }\r\n  }\r\n\r\n  const list = ledger && Array.isArray(ledger.defects) ? ledger.defects : null\r\n  if (!list) {\r\n    errors.push({ id: 'defects.schema', detail: 'defects must be an array' })\r\n    return { errors, absent: false }\r\n  }\r\n\r\n  const knownAcs = new Set()\r\n  for (const entry of index?.acs ?? []) {\r\n    if (entry && typeof entry.ac === 'string') knownAcs.add(entry.ac)\r\n  }\r\n\r\n  const seen = new Set()\r\n  const valid = []\r\n  for (const item of list) {\r\nimport test from 'node:test'\nimport assert from 'node:assert/strict'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\n\nimport { createRealClock, TEST_CLOCK_ENV } from '../../lib/context.mjs'\nimport { main } from '../../lib/cli.mjs'\nimport { createFakeClock } from '../helpers/clock.mjs'\nimport { createFakeContext, fakeFs } from '../helpers/ctx.mjs'\n\ntest('[AC-072] advance moves the fake clock and setNow moves it either way', async () => {\n  const clock = createFakeClock({ start: 1000 })\n  assert.equal(clock.now(), 1000)\n  await clock.advance(1000)\n  assert.equal(clock.now(), 2000)\n\n  clock.setNow(5)\n  assert.equal(clock.now(), 5)\n  clock.setNow(9000)\n  assert.equal(clock.now(), 9000)\n  clock.setNow(Date.parse('2026-01-01T00:00:00Z'))\n  assert.equal(clock.nowIso(), '2026-01-01T00:00:00.000Z')\n})\n\ntest('[AC-072] timers fire in due order and pending tracks the queue', async () => {\n  const clock = createFakeClock({ start: 9000 })\n  const log = []\n  const seen = []\n\n  clock.setTimeout(() => log.push('b2'), 200)\n  clock.setTimeout(() => { log.push('a1'); seen.push(clock.now()) }, 100)\n  clock.setTimeout(() => log.push('b3'), 200)\n  const cancelled = clock.setTimeout(() => log.push('cancelled'), 150)\n  clock.clearTimeout(cancelled)\n  clock.setTimeout(() => log.push('far'), 1000)\n  assert.equal(clock.pending(), 4)\n\n  await clock.advance(99)\n  assert.deepEqual(log, [])\n  assert.equal(clock.pending(), 4)\n\n  await clock.advance(1)\n  assert.deepEqual(log, ['a1'])\n  assert.deepEqual(seen, [9100])\n  assert.equal(clock.pending(), 3)\n\n  await clock.advance(100)\n  assert.deepEqual(log, ['a1', 'b2', 'b3'])\n  assert.equal(clock.pending(), 1)\n\n  clock.clearTimeout({ id: 'unknown' })\n  assert.equal(clock.pending(), 1)\n})\n\ntest('[AC-072] sleep resolves only after advance reaches the deadline', async () => {\n  const clock = createFakeClock({ start: 0 })\n  let done = false\n  const sleeping = clock.sleep(500).then(() => { done = true })\n  assert.equal(clock.pending(), 1)\n  const requireVerified = request.require_verified !== false\n  const requireReadonly = request.require_readonly === true\n  const exclude = new Set(request.exclude || [])\n  const allowed = request.candidates ? new Set(request.candidates) : null\n  const rejected = []\n  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n\n  const candidates = models.filter((m) => {\n    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n    }\n    return true\n  })\n\n  const rank = (m) => {\n    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n    const unknown = f.risk === 'unknown' ? 1 : 0\n    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n    if (usageKind === 'Light') return [price, unknown, m.key]\n    return [unknown, price, m.key]\n  }\n  candidates.sort((a, b) => {\n    const ra = rank(a), rb = rank(b)\n    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n    return 0\n  })\n\n  const picked = candidates.slice(0, count).map((m) => {\n    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n    const call = cliCall(config, m, request)\n    return {\n      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n      adapter: config.providers[m.provider]?.adapter || null,\n      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n      forecast: f, cli: call, call,\n    }\n  })\n  return {\n    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n    models: picked, calls: picked.map((x) => x.call), rejected,\n    reason: picked.length ? null : 'no_eligible_model',\n    truncated: picked.length < count,\n  }\n}\n          { \"at\": \"2026-11-07T10:00:00Z\", \"fraction\": 0.375 }\n        ],\n        \"rows\": [\n          { \"at\": \"2026-11-07T07:30:00Z\", \"tokens\": 1000000 },\n          { \"at\": \"2026-11-07T08:30:00Z\", \"tokens\": 500000 },\n39:    : path.join(dir, 'run-tests.mjs')","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YCCSCTJx8SDfXNxVNEFHgU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
