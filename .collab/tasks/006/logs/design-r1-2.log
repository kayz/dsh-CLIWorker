{"type":"tool_call","subtype":"completed","call_id":"call-f7de5ef0-79f1-4e8a-a04c-d80261031d30-52\nfc_d002559e-4ba7-9963-9a0d-059be8aa127b_3","tool_call":{"readToolCall":{"args":{"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/006/test/helpers/clock.mjs","limit":80},"result":{"success":{"content":"const DEFAULT_START = Date.parse('2026-11-07T00:00:00Z')\n\n/**\n * Deterministic, advances only through advance(). Never touches real timers.\n */\nexport function createFakeClock({ start } = {}) {\n  let current = start === undefined ? DEFAULT_START : start\n  let seq = 0\n  const timers = new Map()\n\n  const clock = {\n    now() { return current },\n    nowIso() { return new Date(current).toISOString() },\n    setNow(t) { current = t },\n    setTimeout(fn, ms) {\n      const handle = { id: (seq += 1) }\n      timers.set(handle, { fn, due: current + Math.max(0, Number(ms) || 0), seq: handle.id })\n      return handle\n    },\n    clearTimeout(handle) { timers.delete(handle) },\n    pending() { return timers.size },\n    async advance(ms) {\n      if (typeof ms !== 'number' || !Number.isFinite(ms) || ms < 0) throw new RangeError(`advance requires a finite non-negative number, got ${String(ms)}`)\n      const target = current + ms\n      for (;;) {\n        let next = null\n        for (const [handle, timer] of timers) {\n          if (timer.due > target) continue\n          if (!next || timer.due < next.timer.due || (timer.due === next.timer.due && timer.seq < next.timer.seq)) next = { handle, timer }\n        }\n        if (!next) break\n        current = Math.max(current, next.timer.due)\n        timers.delete(next.handle)\n        next.timer.fn()\n        await Promise.resolve()\n      }\n      current = target\n    },\n    sleep(ms) {\n      return new Promise((resolve) => { clock.setTimeout(resolve, ms) })\n    },\n  }\n\n  return clock\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":46,"fileSize":1574,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/0