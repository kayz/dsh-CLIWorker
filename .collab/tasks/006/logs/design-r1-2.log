   continue\n    }\n    if (!stat.isDirectory()) continue\n    walkFiles(start, (file) => {\n      if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n    })\n  }\n  return [...new Set(found)].sort()\n}\n\nexport function enumeratePerfFiles(root) {\n  const base = path.resolve(root)\n  const start = path.join(base, 'test', 'perf')\n  try {\n    if (!fs.statSync(start).isDirectory()) return []\n  } catch {\n    return []\n  }\n  const found = []\n  walkFiles(start, (file) => {\n    if (file.endsWith('.test.mjs')) found.push(toPosix(path.relative(base, file)))\n  })\n  return [...new Set(found)].sort()\n}\n\nexport function findOrphans(root) {\n  const base = path.resolve(root)\n  const testDir = path.join(base, 'test')\n  let entries","isEmpty":false,"exceededLimit":false,"totalLines":327,"fileSize":10528,"path":"/mnt/c/git/dsh-CLIWorker/.collab/worktrees/006/scripts/run-tests.mjs","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-d7aecbb2-01f2-44ee-b5a1-e848dfd53d21-61\nfc_d55a9baa-ab3c-9dcf-9c58-0ea92e8bd5b1_1","startedAtMs":"1794076486675","completedAtMs":"1794076486826"},"model_call_id":"6eee2667-625b-41c4-b449-c94ee3fbbfde-16-0zpe","session_id":"8b0c7e00-33b7-4132-af53-4d244a6a9e2f","timestamp_ms":1794076487065}
