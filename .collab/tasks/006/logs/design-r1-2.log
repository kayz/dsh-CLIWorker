e(10006)) >= 0 || o.includes('fail 0') === false || o.includes('[AC-018]') === false) { console.error(last); process.exit(1); } console.log('AC-018 OK')\"\n```\n\n- 期望: stdout 最后一行是 `AC-018 OK`，退出码 0。\n- 期望: 选中 1 个文件，输出含 `[AC-018]`，含 `fail 0`，没有失败标记。\n\n## AC-018 A-13 assumed 不进入 risk，输出过 schema\n\n```\nnode --input-type=module -e \"import fs from 'node:fs'; import { buildForecast } from './lib/forecast.mjs'; import { validate } from './lib/contract/validate.mjs'; const schema = JSON.parse(fs.readFileSync('contracts/schemas/forecast.v1.schema.json', 'utf8')); const reasons = JSON.parse(fs.readFileSync('contracts/registry.snapshot.json', 'utf8')).forecast_reasons; function check(quota, expect) { const actual = buildForecast({ quota, samples: [], usage: 'Normal', now: 0 }); const result = validate(schema, actual); if (result.ok === false) { console.error(JSON.stringify(result.errors)); process.exit(1); } for (const key of Object.keys(expect)) { if (Object.is(actual[key], expect[key]) === false) { console.error(key + '=' + String(actual[key])); process.exit(1); } } if (actual.tasks_left === null && actual.risk_basis === 'tasks') process.exit(1); if (actual.tasks_left_basis === 'assumed') process.exit(1); if (actual.reason !== null && reasons.includes(actual.reason) === false) process.exit(1); } check({ remaining_pct: 50, remaining: 2000000, unit: 'tokens' }, { remaining_fraction: 0.5, remaining_mtok: 2, tasks_left: null, tasks_left_basis: 'none', tasks_left_assumed: 4, risk: 'ok', risk_basis: 'fraction', confidence: 'none', reason: 'no_samples' }); check({ remaining: 2000000, unit: 'tokens' }, { remaining_mtok: 2, remaining_fraction: null, tasks_left: null, tasks_left_assumed: 4, risk: 'unknown', risk_basis: 'none', confidence: 'none', reason: 'no_samples', status: 'known' }); check({ remaining: 1, unit: 'credits' }, { risk: 'unknown', risk_basis: 'none', reason: 'credits_conversion_missing', status: 'unknown', tasks_left_assumed: null }); check({}, { status: 'unknown'