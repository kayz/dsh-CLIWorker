of ['5','6','7','11','16']) {\n  const a = marks.find(m => m.n===want);\n  const b = marks.find(m => Number(m.n)===Number(want)+1);\n  if (!a) { console.log('MISSING', want); continue; }\n  const slice = t.slice(a.i, b ? b.i : a.i+4000);\n  console.log('\\n===== SECTION', want, 'len', slice.length, '=====\\n');\n  console.log(slice.slice(0, 6000));\n}\n\""}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Extract interfaces sections 5, 6, 7, 11, 16","closeStdin":true,"conversationId":"8b0c7e00-33b7-4132-af53-4d244a6a9e2f","adminCommandDenylist":[],"requestId":"6eee2667-625b-41c4-b449-c94ee3fbbfde","smartModeClassifierAllowed":false},"result":{"success":{"command":"node --input-type=module -e \"\nimport fs from 'node:fs';\nconst t = fs.readFileSync('.collab/blueprint/cliworker-v2/interfaces.md','utf8');\nconst marks = [...t.matchAll(/【(\\d+)/g)].map(m => ({n:m[1], i:m.index}));\nfor (const want of ['5','6','7','11','16']) {\n  const a = marks.find(m => m.n===want);\n  const b = marks.find(m => Number(m.n)===Number(want)+1);\n  if (!a) { console.log('MISSING', want); continue; }\n  const slice = t.slice(a.i, b ? b.i : a.i+4000);\n  console.log('\\n===== SECTION', want, 'len', slice.length, '=====\\n');\n  console.log(slice.slice(0, 6000));\n}\n\"","workingDirectory":"","exitCode":0,"signal":"","stdout":"\n===== SECTION 5 len 2430 =====\n\n【5 注册表（T-004 冻结，contracts/registry.snapshot.json，snapshot_version:1，自包含，运行时不读 .collab）】每个码为 {code, exit, http_status, retryable, trigger_id, trigger}，trigger_id 全表唯一。退出码：0 成功（含 truncated）；1 E_INTERNAL；2 E_REQUEST_INVALID, E_LEVEL_REQUIRED, E_LEVEL_UNKNOWN, E_SCHEMA_UNSUPPORTED, E_UNSAFE_ARG, E_UNKNOWN_COMMAND, E_VIEW_FORBIDDEN；3 E_CONFIG, E_CONFIG_EXAMPLE, E_CONFIG_EXISTS, E_CONFIG_SECRET_INLINE, E_SECRET_BACKEND；4 E_STATE_LOCKED, E_TIMEOUT（可重试）；5 E_NO_CANDIDATE, E_INSUFFICIENT_QUOTA（可重试）；6 E_LEASE_UNKNOWN, E_LEASE_EXPIRED（可重试，需重新申请）, E_LEASE_CONSUMED, E_LEASE_CONFIG_MISMATCH；7 E_PROVIDER_AUTH, E_PROVIDER_QUOTA, E_PROVIDER_FAILED；8 E_ADMIN_REQUIRED, E_LOOPBACK_ONLY, E_READONLY, E_CSRF（HTTP 403）；9 E_HEALTH_DEGRADED, E_SMOKE_DISABLED。403 类触发条件（互斥）：E_VIEW_FORBIDDEN=select_view_without_admin（select 路由请求 full 或 draft 视图而无有效会话；CLI 的 models select 带 view:full）；E_LOOPBACK_ONLY=bootstrap_non_loopback（api/session 或 ui 外壳的 loopback 三项校验任一失败）；E_ADMIN_REQUIRED=admin_route_no_session（管理读写路由无有效会话，含过期）；E_READONLY=write_route_readonly（会话有效、插件 readonly、写路由）；E_CSRF=write_route_csrf_invalid（会话有效、可写、csrf 缺失或不匹配）。写路由判定顺序：会话 > readonly > csrf > 请求体校验。警告码：W_FIELD_IGNORED, W_FIELD_DEPRECATED, W_CONFIG_V1, W_STALE_DATA, W_DRAFT_DEPRECATED, W_MODELS_MANUAL_REQUIRED, W_LEGACY_USAGE, W_TEST_CLOCK。v1 拒选原因：excluded, level_mismatch, level_unassigned, availability_unverified, availability_blocked, availability_unavailable, availability_stale, deprecated, identity_unverified, identity_mismatch, readonly_unavailable, adapter_unverified, quota_low, quota_unknown_policy, reserve_protected；not_allowed 只出现在管理视图。draft 拒选原因：excluded, not_in_workspace_order, level:<Level>, availability:<state>, identity_unverified, readonly_unavailable, E_FORECAST_EXHAUSTION，与 v1 的映射在 contracts/spec/migration-map.json。forecast reason：no_samples, capacity_unknown, ledger_capacity_unknown, credits_conversion_missing, usd_samples_missing, reading_stale, window_unknown。risk 取 ok/low_reserve/critical/exhausted/unknown；risk_basis 取 tasks/usd/fraction/none；tasks_left_basis 取 tasks/usd/none。阈值表：tasks 依据 <=0 exhausted、1..2 critical、3..5 low_reserve、>=6 ok；fraction 依据 <=0 exhausted、<0.05 critical、<0.15 low_reserve、其余 ok；优先级 tasks > usd > fraction > unknown。可用性取 unverified/callable/blocked/unavailable/deprecated；identity 取 verified/unverified/mismatch。semantic_change：forecast.tasks_left、forecast.risk、handle.cli_removed、draft_reason_mapping、config_v1_to_v2。\n\n===== SECTION 6 len 632 