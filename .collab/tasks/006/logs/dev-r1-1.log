{"type":"user","uuid":"01a1b76a-1e38-76d3-9db4-e5d9cdadbf97","session_id":"01a1b769-9e30-7c78-9a9c-20b26d74eef6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_awPLd8C1f0qLz28jZMde6672","content":[{"type":"text","text":"Stdout: {\r\n  \"defect\": \"a1-quota\"\r\n}\r\n---defects---\n{\n  \"id\": \"a1-quota\",\n  \"owner_task\": \"T-006\",\n  \"owner_milestone\": \"M1\",\n  \"ac\": \"AC-015\",\n  \"repro_sha256\": \"1dd92cf708089283f8e3790273c02ac77c63e0965c6c9d38489c2f236bbdf1ec\"\n}\n\nStderr: (empty)\nExit Code: 0\nSignal: (none)"}],"is_error":false,"_meta":{"rawResponse":{"exitCode":0,"signal":null,"interrupted":false,"sandboxDenied":false,"stderrBytesTruncated":0,"stdoutBytesTruncated":0,"tool_error_code":"0"},"renderer":{"type":"text","value":"{\r\n  \"defect\": \"a1-quota\"\r\n}\r\n---defects---\n{\n  \"id\": \"a1-quota\",\n  \"owner_task\": \"T-006\",\n  \"owner_milestone\": \"M1\",\n  \"ac\": \"AC-015\",\n  \"repro_sha256\": \"1dd92cf708089283f8e3790273c02ac77c63e0965c6c9d38489c2f236bbdf1ec\"\n}"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b769a1b5702aa92833dbee5b67a6","_messageId":"01a1b76a133b75cc94631791f55368ce","_meta":{"codebuddy.ai/conversationRequestId":"01a1b769a1b5702aa92833dbee5b67a6","codebuddy.ai/modelRequestId":"01a1b76a133b75cc94631791f55368ce","codebuddy.ai/llmMessageId":"01a1b76a133b75cc94631791f55368ce","traceparent":"00-ca409312e57460dad670bff2ccb3f3ff-0161882b422c291a-01","baggage":"codebuddy.session_id=01a1b769-9e30-7c78-9a9c-20b26d74eef6,codebuddy.conversation_request_id=01a1b769a1b5702aa92833dbee5b67a6"},"__timestamp":"2026-11-07T19:09:07.513Z"}
{"type":"user","uuid":"01a1b76a-1e43-76a8-ae30-756d73b4d36b","session_id":"01a1b769-9e30-7c78-9a9c-20b26d74eef6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_QnAeh9E6mbspLT5Gwjvd8766","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Two checks in one place: every spec and golden file is registered in the manifest, and every\n   3→// path changed against a base ref lives inside the task write scope.\n   4→import fs from 'node:fs'\n   5→import path from 'node:path'\n   6→import { spawnSync } from 'node:child_process'\n   7→import { fileURLToPath } from 'node:url'\n   8→\n   9→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  10→const REPO_ROOT = path.resolve(HERE, '..')\n  11→const MANIFEST_REL = 'contracts/golden/manifest.json'\n  12→const REGISTERED_DIRS = ['contracts/spec', 'contracts/golden']\n  13→const USAGE =\n  14→  'usage: node scripts/check-write-scope.mjs [--root <dir>] [--base <git-ref>] [--scope <glob>]... [--scope-from <markdown>]'\n  15→\n  16→function toPosix(value) {\n  17→  return value.split(path.sep).join('/')\n  18→}\n  19→\n  20→function byCodePoint(a, b) {\n  21→  if (a < b) return -1\n  22→  if (a > b) return 1\n  23→  return 0\n  24→}\n  25→\n  26→function walk(dir, base, out) {\n  27→  let entries\n  28→  try {\n  29→    entries = fs.readdirSync(dir, { withFileTypes: true })\n  30→  } catch {\n  31→    return\n  32→  }\n  33→  for (const entry of entries) {\n  34→    const full = path.join(dir, entry.name)\n  35→    if (entry.isDirectory()) walk(full, base, out)\n  36→    else if (entry.isFile()) out.push(toPosix(path.relative(base, full)))\n  37→  }\n  38→}\n  39→\n  40→function listRegisteredDirs(root) {\n  41→  const found = []\n  42→  for (const rel of REGISTERED_DIRS) walk(path.join(root, rel), root, found)\n  43→  return found.filter((rel) => rel !== MANIFEST_REL).sort(byCodePoint)\n  44→}\n  45→\n  46→function globToRegExp(glob) {\n  47→  let source = '^'\n  48→  for (let i = 0; i < glob.length; i += 1) {\n  49→    const char = glob[i]\n  50→    if (char === '*') {\n  51→      if (glob[i + 1] === '*') {\n  52→        source += '.*'\n  53→        i += 1\n  54→      } else {\n  55→        source += '[^/]*'\n  56→      }\n  57→    } else if ('\\\\^$.|?+()[]{}'.includes(char)) {\n  58→      source += `\\\\${char}`\n  59→    } else {\n  60→      source += char\n  61→    }\n  62→  }\n  63→  source += '$'\n  64→  return new RegExp(source)\n  65→}\n  66→\n  67→function parseFrontMatterScopes(file) {\n  68→  let text\n  69→  try {\n  70→    text = fs.readFileSync(file, 'utf8')\n  71→  } catch {\n  72→    return null\n  73→  }\n  74→  const lines = text.split(/\\r?\\n/)\n  75→  if (lines[0].trim() !== '---') return null\n  76→  let end = -1\n  77→  for (let i = 1; i < lines.length; i += 1) {\n  78→    if (lines[i].trim() === '---') {\n  79→      end = i\n  80→      break\n  81→    }\n  82→  }\n  83→  if (end === -1) return null\n  84→\n  85→  const scopes = []\n  86→  let inScope = false\n  87→  for (let i = 1; i < end; i += 1) {\n  88→    const line = lines[i]\n  89→    if (/^write_scope:\\s*$/.test(line)) {\n  90→      inScope = true\n  91→      continue\n  92→    }\n  93→    if (!inScope) continue\n  94→    const item = /^\\s*-\\s+(.+?)\\s*$/.exec(line)\n  95→    if (item) {\n  96→      scopes.push(item[1].replace(/^['\"]|['\"]$/g, ''))\n  97→      continue\n  98→    }\n  99→    if (line.trim() === '') continue\n 100→    inScope = false\n 101→  }\n 102→  return scopes.length > 0 ? scopes : null\n 103→}\n 104→\n 105→function gitLines(root, args) {\n 106→  const result = spawnSync('git', args, { cwd: root, encoding: 'utf8' })\n 107→  if (result.status !== 0) return null\n 108→  return String(result.stdout ?? '')\n 109→    .split(/\\r?\\n/)\n 110→    .map((line) => line.trim())\n 111→    .filter(Boolean)\n 112→}\n 113→\n 114→function main(argv) {\n 115→  let root = REPO_ROOT\n 116→  let base = null\n 117→  const scopes = []\n 118→  let scopeFrom = null\n 119→\n 120→  for (let i = 0; i < argv.length; i += 1) {\n 121→    const flag = argv[i]\n 122→    const value = argv[i + 1]\n 123→    if (flag === '--root') {\n 124→      if (typeof value !== 'string' || value === '') {\n 125→        process.stderr.write(`check-write-scope: --root requires a directory\\n${USAGE}\\n`)\n 126→        process.exitCode = 2\n 127→        return\n 128→      }\n 129→      root = path.resolve(value)\n 130→      i += 1\n 131→    } else if (flag === '--base') {\n 132→      if (typeof value !== 'string' || value === '') {\n 133→        process.stderr.write(`check-write-scope: --base requires a git ref\\n${USAGE}\\n`)\n 134→        process.exitCode = 2\n 135→        return\n 136→      }\n 137→      base = value\n 138→      i += 1\n 139→    } else if (flag === '--scope') {\n 140→      if (typeof value !== 'string' || value === '') {\n 141→        process.stderr.write(`check-write-scope: --scope requires a glob\\n${USAGE}\\n`)\n 142→        process.exitCode = 2\n 143→        return\n 144→      }\n 145→      scopes.push(value)\n 146→      i += 1\n 147→    } else if (flag === '--scope-from') {\n 148→      if (typeof value !== 'string' || value === '') {\n 149→        process.stderr.write(`check-write-scope: --scope-from requires a file\\n${USAGE}\\n`)\n 150→        process.exitCode = 2\n 151→        return\n 152→      }\n 153→      scopeFrom = path.resolve(value)\n 154→      i += 1\n 155→    } else {\n 156→      process.stderr.write(`check-write-scope: unknown argument: ${flag}\\n${USAGE}\\n`)\n 157→      process.exitCode = 2\n 158→      return\n 159→    }\n 160→  }\n 161→\n 162→  if (scopeFrom !== null) {\n 163→    const parsed = parseFrontMatterScopes(scopeFrom)\n 164→    if (parsed === null) {\n 165→      process.stderr.write(`check-write-scope: no write_scope globs in ${scopeFrom}\\n${USAGE}\\n`)\n 166→      process.exitCode = 2\n 167→      return\n 168→    }\n 169→    scopes.push(...parsed)\n 170→  }\n 171→\n 172→  if (scopes.length > 0 && base === null) {\n 173→    process.stderr.write(`check-write-scope: --scope and --scope-from require --base\\n${USAGE}\\n`)\n 174→    process.exitCode = 2\n 175→    return\n 176→  }\n 177→\n 178→  const errors = []\n 179→  const actual = listRegisteredDirs(root)\n 180→  let manifest = null\n 181→  try {\n 182→    manifest = JSON.parse(fs.readFileSync(path.join(root, MANIFEST_REL), 'utf8'))\n 183→  } catch {\n 184→    errors.push('FAIL write_scope.manifest_missing')\n 185→  }\n 186→\n 187→  if (manifest !== null) {\n 188→    const registered = new Set(\n 189→      (Array.isArray(manifest.files) ? manifest.files : []).map((entry) => entry.path)\n 190→    )\n 191→    for (const rel of actual) {\n 192→      if (!registered.has(rel)) errors.push(`FAIL write_scope.unregistered ${rel}`)\n 193→    }\n 194→  }\n 195→\n 196→  if (scopes.length > 0) {\n 197→    const changed = gitLines(root, ['diff', '--name-only', '--no-renames', base])\n 198→    const untracked = gitLines(root, ['ls-files', '--others', '--exclude-standard'])\n 199→    if (changed === null || untracked === null) {\n 200→      process.stderr.write(`check-write-scope: git commands failed under ${root}\\n`)\n 201→      process.exitCode = 2\n 202→      return\n 203→    }\n 204→    const globs = scopes.map(globToRegExp)\n 205→    const paths = [...new Set([...changed, ...untracked].map(toPosix))].sort(byCodePoint)\n 206→    for (const rel of paths) {\n 207→      if (!globs.some((glob) => glob.test(rel))) errors.push(`FAIL write_scope.outside ${rel}`)\n 208→    }\n 209→  }\n 210→\n 211→  if (errors.length > 0) {\n 212→    for (const line of errors) process.stdout.write(`${line}\\n`)\n 213→    process.stdout.write(`check-write-scope: FAILED (${errors.length} errors)\\n`)\n 214→    process.exitCode = 1\n 215→    return\n 216→  }\n 217→\n 218→  process.stdout.write('check-write-scope: ok\\n')\n 219→  process.exitCode = 0\n 220→}\n 221→\n 222→const invokedDirectly =\n 223→  process.argv[1] &&\n 224→  path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 225→\n 226→if (invokedDirectly) main(process.argv.slice(2))\n 227→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b769a1b5702aa92833dbee5b67a6","_messageId":"01a1b76a133b75cc94631791f55368ce","_meta":{"codebuddy.ai/conversationRequestId":"01a1b769a1b5702aa92833dbee5b67a6","codebuddy.ai/modelRequestId":"01a1b76a133b75cc94631791f55368ce","codebuddy.ai/llmMessageId":"01a1b76a133b75cc94631791f55368ce","traceparent":"00-ca409312e57460dad670bff2ccb3f3ff-0161882b422c291a-01","baggage":"codebuddy.session_id=01a1b769-9e30-7c78-9a9c-20b26d74eef6,codebuddy.conversation_request_id=01a1b769a1b5702aa92833dbee5b67a6"},"__timestamp":"2026-11-07T19:09:07.524Z"}
