{"type":"user","uuid":"01a1b769-d1b5-7e03-ba04-d3f8f9e9dfab","session_id":"01a1b769-9e30-7c78-9a9c-20b26d74eef6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_jcZMUpxJ8lCtbgglwwTe2258","content":[{"type":"text","text":"   1→{\n   2→  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n   3→  \"$id\": \"forecast.v1.schema.json\",\n   4→  \"title\": \"cliworker.forecast/v1\",\n   5→  \"type\": \"object\",\n   6→  \"required\": [\n   7→    \"schema\",\n   8→    \"status\",\n   9→    \"model\",\n  10→    \"remaining_mtok\",\n  11→    \"remaining_fraction\",\n  12→    \"pools\",\n  13→    \"tokens_per_task\",\n  14→    \"tasks_left\",\n  15→    \"tasks_left_basis\",\n  16→    \"tasks_left_assumed\",\n  17→    \"burn_mtok_per_hour\",\n  18→    \"eta_exhaust_at\",\n  19→    \"exhausts_before_reset\",\n  20→    \"risk\",\n  21→    \"risk_basis\",\n  22→    \"confidence\",\n  23→    \"reason\",\n  24→    \"burn_per_task\",\n  25→    \"samples\"\n  26→  ],\n  27→  \"properties\": {\n  28→    \"schema\": { \"const\": \"cliworker.forecast/v1\" },\n  29→    \"status\": { \"enum\": [\"known\", \"unknown\"] },\n  30→    \"model\": { \"type\": \"string\" },\n  31→    \"remaining_mtok\": { \"type\": [\"number\", \"null\"] },\n  32→    \"remaining_fraction\": { \"type\": [\"number\", \"null\"] },\n  33→    \"pools\": {\n  34→      \"type\": \"array\",\n  35→      \"items\": {\n  36→        \"type\": \"object\",\n  37→        \"required\": [\"pool_id\", \"remaining_mtok\", \"remaining_fraction\", \"reset_at\", \"reset_in_h\", \"reset_source\"],\n  38→        \"properties\": {\n  39→          \"pool_id\": { \"type\": \"string\" },\n  40→          \"remaining_mtok\": { \"type\": [\"number\", \"null\"] },\n  41→          \"remaining_fraction\": { \"type\": [\"number\", \"null\"] },\n  42→          \"reset_at\": { \"type\": [\"string\", \"null\"] },\n  43→          \"reset_in_h\": { \"type\": [\"number\", \"null\"] },\n  44→          \"reset_source\": { \"enum\": [\"cli\", \"config\", \"estimated\", \"unknown\"] }\n  45→        }\n  46→      }\n  47→    },\n  48→    \"tokens_per_task\": {\n  49→      \"type\": [\"object\", \"null\"],\n  50→      \"required\": [\"p25\", \"p50\", \"p90\", \"n\"],\n  51→      \"properties\": {\n  52→        \"p25\": { \"type\": [\"number\", \"null\"] },\n  53→        \"p50\": { \"type\": [\"number\", \"null\"] },\n  54→        \"p90\": { \"type\": [\"number\", \"null\"] },\n  55→        \"n\": { \"type\": \"integer\", \"minimum\": 0 }\n  56→      }\n  57→    },\n  58→    \"tasks_left\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0 },\n  59→    \"tasks_left_basis\": { \"enum\": [\"tasks\", \"usd\", \"none\"] },\n  60→    \"tasks_left_assumed\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0 },\n  61→    \"burn_mtok_per_hour\": { \"type\": [\"number\", \"null\"] },\n  62→    \"eta_exhaust_at\": { \"type\": [\"string\", \"null\"] },\n  63→    \"exhausts_before_reset\": { \"type\": [\"boolean\", \"null\"] },\n  64→    \"risk\": { \"enum\": [\"ok\", \"low_reserve\", \"critical\", \"exhausted\", \"unknown\"] },\n  65→    \"risk_basis\": { \"enum\": [\"tasks\", \"usd\", \"fraction\", \"none\"] },\n  66→    \"confidence\": { \"enum\": [\"none\", \"low\", \"medium\", \"high\"] },\n  67→    \"reason\": {\n  68→      \"enum\": [\n  69→        null,\n  70→        \"no_samples\",\n  71→        \"capacity_unknown\",\n  72→        \"ledger_capacity_unknown\",\n  73→        \"credits_conversion_missing\",\n  74→        \"usd_samples_missing\",\n  75→        \"reading_stale\",\n  76→        \"window_unknown\"\n  77→      ]\n  78→    },\n  79→    \"burn_per_task\": { \"type\": [\"number\", \"null\"] },\n  80→    \"samples\": { \"type\": \"integer\", \"minimum\": 0 }\n  81→  },\n  82→  \"additionalProperties\": true\n  83→}\n  84→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b769a1b5702aa92833dbee5b67a6","_messageId":"01a1b769c7377b9ba37b72ef7fda0229","_meta