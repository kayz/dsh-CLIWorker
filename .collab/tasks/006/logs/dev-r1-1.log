{"type":"user","uuid":"01a1b76b-54d6-767c-a4a7-40dc6d747cf7","session_id":"01a1b769-9e30-7c78-9a9c-20b26d74eef6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_rChQoifeLAf6gbcc3YzU3091","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Self-test for the test discovery rules: proves the runner notices drift, that a filtered\n   3→// manifest cannot stand in for a full one, and that decoys and orphans are handled correctly.\n   4→import fs from 'node:fs'\n   5→import os from 'node:os'\n   6→import path from 'node:path'\n   7→import { spawnSync } from 'node:child_process'\n   8→import { fileURLToPath } from 'node:url'\n   9→\n  10→import { enumerateTestFiles, findOrphans, verifyFullRun } from './run-tests.mjs'\n  11→\n  12→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  13→const REPO_ROOT = path.resolve(HERE, '..')\n  14→const RUN_TESTS = path.join(HERE, 'run-tests.mjs')\n  15→const FIXTURES = path.join(REPO_ROOT, 'test', 'fixtures', 'discovery-selftest')\n  16→const EXCLUDED_PREFIXES = ['test/fixtures/', 'test/helpers/', 'test/perf/']\n  17→\n  18→function printErrors(errors) {\n  19→  for (const error of errors) {\n  20→    process.stdout.write(`FAIL ${error.id} ${error.path ?? ''}`.trimEnd() + '\\n')\n  21→  }\n  22→}\n  23→\n  24→function checkRoot(root, manifestPath) {\n  25→  const errors = findOrphans(root).map((file) => ({ id: 'discovery.orphan', path: file }))\n  26→  if (manifestPath) {\n  27→    let manifest = null\n  28→    try {\n  29→      manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\n  30→    } catch {\n  31→      manifest = null\n  32→    }\n  33→    const verification = verifyFullRun({ enumerated: enumerateTestFiles(root), manifest })\n  34→    errors.push(...verification.errors)\n  35→  }\n  36→  printErrors(errors)\n  37→  if (errors.length > 0) {\n  38→    process.exitCode = 1\n  39→    return\n  40→  }\n  41→  process.stdout.write('check-test-discovery: ok\\n')\n  42→}\n  43→\n  44→function runRunner(root) {\n  45→  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\n  46→  const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\n  47→    encoding: 'utf8',\n  48→  })\n  49→  const manifestPath = path.join(outDir, 'files-executed.json')\n  50→  let manifest = null\n  51→  try {\n  52→    manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\n  53→  } catch {\n  54→    manifest = null\n  55→  }\n  56→  return { result, manifest, outDir, manifestPath }\n  57→}\n  58→\n  59→function runFiltered(root, ac) {\n  60→  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\n  61→  const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--ac', ac, '--out-dir', outDir], {\n  62→    encoding: 'utf8',\n  63→  })\n  64→  let manifest = null\n  65→  try {\n  66→    manifest = JSON.parse(fs.readFileSync(path.join(outDir, 'files-executed.json'), 'utf8'))\n  67→  } catch {\n  68→    manifest = null\n  69→  }\n  70→  return { result, manifest, outDir }\n  71→}\n  72→\n  73→function selftest() {\n  74→  const problems = []\n  75→  const record = (message) => {\n  76→    problems.push(message)\n  77→    process.stdout.write(`FAIL ${message}\\n`)\n  78→  }\n  79→\n  80→  // 1. Live repository.\n  81→  for (const file of findOrphans(REPO_ROOT)) record(`discovery.orphan ${file}`)\n  82→  for (const file of enumerateTestFiles(REPO_ROOT)) {\n  83→    if (EXCLUDED_PREFIXES.some((prefix) => file.startsWith(prefix))) {\n  84→      record(`discovery.unexpected ${file}`)\n  85→    }\n  86→  }\n  87→\n  88→  // 2. Full run inside the ok fixture.\n  89→  const okRoot = path.join(FIXTURES, 'ok')\n  90→  const full = runRunner(okRoot)\n  91→  const expected = ['test/flows/c.test.mjs', 'test/integration/b.test.mjs', 'test/unit/a.test.mjs']\n  92→  if (full.result.status !== 0) {\n  93→    record(`discovery.selftest full run exited ${full.result.status} ${(full.result.stderr || '').trim()}`)\n  94→  }\n  95→  if (!full.manifest || full.manifest.mode !== 'full') {\n  96→    record('discovery.mode_not_full ok fixture manifest is not a full run')\n  97→  } else if (JSON.stringify(full.manifest.files) !== JSON.stringify(expected)) {\n  98→    record(`discovery.selftest ok fixture files ${JSON.stringify(full.manifest.files)}`)\n  99→  }\n 100→  fs.rmSync(full.outDir, { recursive: true, force: true })\n 101→\n 102→  // 3. Drift manifests.\n 103→  const driftRoot = path.join(FIXTURES, 'drift')\n 104→  const driftCases = [\n 105→    ['manifest-ok.json', null],\n 106→    ['manifest-missing.json', 'discovery.missing'],\n 107→    ['manifest-extra.json', 'discovery.unexpected'],\n 108→    ['manifest-filtered.json', 'discovery.mode_not_full'],\n 109→  ]\n 110→  for (const [name, expectedId] of driftCases) {\n 111→    let manifest = null\n 112→    try {\n 113→      manifest = JSON.parse(fs.readFileSync(path.join(driftRoot, name), 'utf8'))\n 114→    } catch {\n 115→      record(`discovery.selftest ${name} is not valid JSON`)\n 116→      continue\n 117→    }\n 118→    const verification = verifyFullRun({ enumerated: enumerateTestFiles(driftRoot), manifest })\n 119→    if (expectedId === null) {\n 120→      if (!verification.ok) record(`discovery.selftest ${name} should pass but reported ${verification.errors.map((e) => e.id).join(',')}`)\n 121→    } else if (!verification.errors.some((error) => error.id === expectedId)) {\n 122→      record(`discovery.selftest ${name} did not report ${expectedId}`)\n 123→    }\n 124→  }\n 125→\n 126→  // 4. Orphans.\n 127→  const orphanRoot = path.join(FIXTURES, 'orphan')\n 128→  const orphans = findOrphans(orphanRoot)\n 129→  if (!orphans.includes('test/loose.test.mjs')) {\n 130→    record(`discovery.orphan fixture missed test/loose.test.mjs (got ${JSON.stringify(orphans)})`)\n 131→  }\n 132→\n 133→  // 5. Filtered run does not compare.\n 134→  const filtered = runFiltered(okRoot, 'AC-001')\n 135→  if (filtered.result.status !== 0) {\n 136→    record(`discovery.selftest filtered run exited ${filtered.result.status} ${(filtered.result.stderr || '').trim()}`)\n 137→  }\n 138→  if (!filtered.manifest || filtered.manifest.mode !== 'filtered') {\n 139→    record('discovery.mode_not_full filtered fixture manifest is not filtered')\n 140→  } else if (filtered.manifest.files.length !== 1 || filtered.manifest.files[0] !== 'test/unit/a.test.mjs') {\n 141→    record(`discovery.selftest filtered files ${JSON.stringify(filtered.manifest.files)}`)\n 142→  }\n 143→  fs.rmSync(filtered.outDir, { recursive: true, force: true })\n 144→\n 145→  if (problems.length > 0) {\n 146→    process.exitCode = 1\n 147→    return\n 148→  }\n 149→  process.stdout.write('check-test-discovery: ok\\n')\n 150→}\n 151→\n 152→function main() {\n 153→  const args = process.argv.slice(2)\n 154→  let root = null\n 155→  let manifestPath = null\n 156→\n 157→  for (let i = 0; i < args.length; i += 1) {\n 158→    const flag = args[i]\n 159→    if (flag === '--root') {\n 160→      const value = args[i + 1]\n 161→      if (typeof value !== 'string' || value === '') {\n 162→        process.stderr.write('--root requires a directory\\n')\n 163→        process.exitCode = 2\n 164→        return\n 165→      }\n 166→      root = path.resolve(value)\n 167→      i += 1\n 168→    } else if (flag === '--manifest') {\n 169→      const value = args[i + 1]\n 170→      if (typeof value !== 'string' || value === '') {\n 171→        process.stderr.write('--manifest requires a file\\n')\n 172→        process.exitCode = 2\n 173→        return\n 174→      }\n 175→      manifestPath = path.resolve(value)\n 176→      i += 1\n 177→    } else {\n 178→      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/check-test-discovery.mjs [--root <dir>] [--manifest <file>]\\n`)\n 179→      process.exitCode = 2\n 180→      return\n 181→    }\n 182→  }\n 183→\n 184→  if (root === null) {\n 185→    selftest()\n 186→    return\n 187→  }\n 188→  checkRoot(root, manifestPath)\n 189→}\n 190→\n 191→main()\n 192→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b769a1b5702aa92833dbee5b67a6","_messageId":"01a1b76a3d917b3bb2c3a7aec22cf5ff","_meta":{"codebuddy.ai/conversationRequestId":"01a1b769a1b5702aa92833dbee5b67a6","codebuddy.ai/modelRequestId":"01a1b76a3d917b3bb2c3a7aec22cf5ff","codebuddy.ai/llmMessageId":"01a1b76a3d917b3bb2c3a7aec22cf5ff","traceparent":"00-ca409312e57460dad670bff2ccb3f3ff-0161882b422c291a-01","baggage":"codebuddy.session_id=01a1b769-9e30-7c78-9a9c-20b26d74eef6,codebuddy.conversation_request_id=01a1b769a1b5702aa92833dbee5b67a6"},"__timestamp":"2026-11-07T19:10:27.031Z"}
