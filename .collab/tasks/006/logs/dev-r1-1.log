{"type":"user","uuid":"01a1b769-bdfe-71aa-8f62-18956adbc4a3","session_id":"01a1b769-9e30-7c78-9a9c-20b26d74eef6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_ET_iUQZ1ajqyiVOG9Me9AHG0624","content":[{"type":"text","text":"   1→import { systemNow } from './context.mjs'\n   2→\n   3→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   4→\n   5→export function normalizePrices(m = {}) {\n   6→  const p = m.prices || {}\n   7→  return {\n   8→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n   9→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n  10→  }\n  11→}\n  12→\n  13→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  14→  const p = { ...DEFAULT_PRICES, ...prices }\n  15→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  16→}\n  17→\n  18→/** Deterministic, intentionally simple forecast. Unknown is a first-class state. */\n  19→export function forecast({ records = [], model, prices, quota = null, now = systemNow() } = {}) {\n  20→  const rows = records.filter((r) => !model || r.model === model)\n  21→  const samples = rows.map((r) => ({\n  22→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  23→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  24→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  25→  if (!samples.length) {\n  26→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  27→  }\n  28→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  29→  const use = recent.length ? recent : samples.slice(-10)\n  30→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  31→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  32→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  33→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  34→  let tasksLeft = null\n  35→  let etaHours = null\n  36→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  37→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  38→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  39→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  40→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  41→  }\n  42→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  43→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  44→  return {\n  45→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  46→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  47→    confidence, risk,\n  48→  }\n  49→}\n  50→\n  51→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  52→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b769a1b5702aa92833dbee5b67a6","_messageId":"01a1b769b6d87218ae5aa79ee964b0b0","_meta":{"codebuddy.ai/conversationRequestId":"01a1b769a1b5702aa92833dbee5b67a6","codebuddy.ai/modelRequestId":"01a1b769b6d87218ae5aa79ee964b0b0","codebuddy.ai/llmMessageId":"01a1b769b6d87218ae5aa79ee964b0b0","traceparent":"00-ca409312e57460dad670bff2ccb3f3ff-0161882b422c291a-01","baggage":"codebuddy.session_id=01a1b769-9e30-7c78-9a9c-20b26d74eef6,codebuddy.conversation_request_id=01a1b769a1b5702aa92833dbee5b67a6"},"__timestamp":"2026-11-07T19:08:42.878Z"}
