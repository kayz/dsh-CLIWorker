{"type":"user","uuid":"01a1b775-47ea-7a76-a841-fd75d8ff7d37","session_id":"01a1b76f-c764-7902-805e-3362c00095cd","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-b6eaead568418252","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→\n   5→import {\n   6→  buildForecast,\n   7→  burnMtokPerHour,\n   8→  classifyRisk,\n   9→  confidenceFor,\n  10→  etaExhaust,\n  11→  quantileForUsage,\n  12→  round3,\n  13→} from '../../lib/forecast.mjs'\n  14→\n  15→function loadGolden(name) {\n  16→  return JSON.parse(fs.readFileSync(new URL(`../../contracts/golden/forecast/${name}`, import.meta.url), 'utf8'))\n  17→}\n  18→\n  19→const CALLS = {\n  20→  classify_risk: (input) => classifyRisk(input),\n  21→  quantile_for_usage: (input) => ({ value: quantileForUsage(input.samples, input.usage) }),\n  22→  confidence: (input) => ({ confidence: confidenceFor(input.n, input.cv) }),\n  23→  burn_mtok_per_hour: (input) => ({ value: burnMtokPerHour(input) }),\n  24→  eta_exhaust: (input) => etaExhaust({\n  25→    now: Date.parse(input.now),\n  26→    remaining_mtok: input.remaining_mtok,\n  27→    burn_mtok_per_hour: input.burn_mtok_per_hour,\n  28→    reset_at: input.reset_at,\n  29→  }),\n  30→  round3: (input) => ({ value: round3(input.value) }),\n  31→}\n  32→\n  33→const GOLDEN = [\n  34→  { file: 'thresholds.json', count: 21, label: 'thresholds' },\n  35→  { file: 'quantiles.json', count: 15, label: 'quantiles' },\n  36→  { file: 'confidence.json', count: 11, label: 'confidence' },\n  37→  { file: 'burn-eta.json', count: 14, label: 'burn-eta' },\n  38→]\n  39→\n  40→for (const golden of GOLDEN) {\n  41→  const data = loadGolden(golden.file)\n  42→  for (const item of data.cases) {\n  43→    test(`[AC-017] ${item.id}`, () => {\n  44→      assert.deepStrictEqual(CALLS[item.fn](item.input), item.expected, item.id)\n  45→    })\n  46→  }\n  47→  test(`[AC-017] ${golden.label} golden case count`, () => {\n  48→    assert.equal(data.cases.length, golden.count)\n  49→  })\n  50→}\n  51→\n  52→test('[AC-017] usage quantiles drive tasks left', () => {\n  53→  const samples = [\n  54→    { mtok: 0.1, cost_usd: null },\n  55→    { mtok: 0.2, cost_usd: null },\n  56→    { mtok: 0.3, cost_usd: null },\n  57→  ]\n  58→  const quota = { remaining: 3000000, unit: 'tokens' }\n  59→  const now = Date.parse('2026-11-07T10:00:00.000Z')\n  60→\n  61→  const heavy = buildForecast({ quota, samples, usage: 'Heavy', now })\n  62→  const normal = buildForecast({ quota, samples, usage: 'Normal', now })\n  63→  const light = buildForecast({ quota, samples, usage: 'Light', now })\n  64→\n  65→  assert.equal(heavy.tasks_left, 10)\n  66→  assert.equal(normal.tasks_left, 15)\n  67→  assert.equal(light.tasks_left, 30)\n  68→  assert.deepStrictEqual(normal.tokens_per_task, { p25: 0.1, p50: 0.2, p90: 0.3, n: 3 })\n  69→})\n  70→\n  71→test('[AC-017] confidence follows coefficient of variation', () => {\n  72→  const now = Date.parse('2026-11-07T10:00:00.000Z')\n  73→  const quota = { remaining: 20000000, unit: 'tokens' }\n  74→\n  75→  const spread = []\n  76→  for (let index = 0; index < 19; index += 1) spread.push({ mtok: 1, cost_usd: null })\n  77→  spread.push({ mtok: 100, cost_usd: null })\n  78→\n  79→  const flat = []\n  80→  for (let index = 0; index < 20; index += 1) flat.push({ mtok: 1, cost_usd: null })\n  81→\n  82→  assert.equal(buildForecast({ quota, samples: spread, usage: 'Normal', now }).confidence, 'medium')\n  83→  assert.equal(buildForecast({ quota, samples: flat, usage: 'Normal', now }).confidence, 'high')\n  84→})\n  85→\n  86→test('[AC-017] buildForecast ignores the wall clock', () => {\n  87→  const original = Date.now\n  88→  Date.now = () => { throw new Error('wall clock read') }\n  89→  try {\n  90→    const actual = buildForecast({ quota: { remaining_pct: 15 }, samples: [], usage: 'Normal', now: 0 })\n  91→    assert.equal(actual.remaining_fraction, 0.15)\n  92→    assert.equal(actual.risk, 'ok')\n  93→  } finally {\n  94→    Date.now = original\n  95→  }\n  96→})\n  97→\n  98→test('[AC-017] buildForecast rejects a non-finite now', () => {\n  99→  assert.throws(() => buildForecast({ now: Number.NaN }), TypeError)\n 100→})\n 101→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b775293b7644841220b6312342b9","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b775293b7644841220b6312342b9","codebuddy.ai/llmMessageId":"01a1b775293b7644841220b6312342b9","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:21:19.082Z"}
{"type":"user","uuid":"01a1b775-47ee-70b1-8bda-52ea6090214b","session_id":"01a1b76f-c764-7902-805e-3362c00095cd","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-921e499d321059e4","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→\n   5→import { buildForecast } from '../../lib/forecast.mjs'\n   6→import { validate } from '../../lib/contract/validate.mjs'\n   7→\n   8→const schema = JSON.parse(fs.readFileSync(new URL('../../contracts/schemas/forecast.v1.schema.json', import.meta.url), 'utf8'))\n   9→const registry = JSON.parse(fs.readFileSync(new URL('../../contracts/registry.snapshot.json', import.meta.url), 'utf8'))\n  10→const REASONS = registry.forecast_reasons\n  11→\n  12→function noSampleForecast(quota) {\n  13→  return buildForecast({ quota, samples: [], usage: 'Normal', now: 0 })\n  14→}\n  15→\n  16→test('[AC-018] assumed estimate never becomes the risk basis', () => {\n  17→  const actual = noSampleForecast({ remaining_pct: 50, remaining: 2000000, unit: 'tokens' })\n  18→\n  19→  assert.equal(validate(schema, actual).ok, true)\n  20→  assert.equal(actual.remaining_fraction, 0.5)\n  21→  assert.equal(actual.remaining_mtok, 2)\n  22→  assert.equal(actual.tasks_left, null)\n  23→  assert.equal(actual.tasks_left_basis, 'none')\n  24→  assert.equal(actual.tasks_left_assumed, 4)\n  25→  assert.equal(actual.confidence, 'none')\n  26→  assert.equal(actual.risk, 'ok')\n  27→  assert.equal(actual.risk_basis, 'fraction')\n  28→  assert.equal(actual.reason, 'no_samples')\n  29→})\n  30→\n  31→test('[AC-018] capacity without a fraction leaves the risk unknown', () => {\n  32→  const actual = noSampleForecast({ remaining: 2000000, unit: 'tokens' })\n  33→\n  34→  assert.equal(validate(schema, actual).ok, true)\n  35→  assert.equal(actual.remaining_mtok, 2)\n  36→  assert.equal(actual.remaining_fraction, null)\n  37→  assert.equal(actual.tasks_left, null)\n  38→  assert.equal(actual.tasks_left_assumed, 4)\n  39→  assert.equal(actual.risk, 'unknown')\n  40→  assert.equal(actual.risk_basis, 'none')\n  41→  assert.equal(actual.confidence, 'none')\n  42→  assert.equal(actual.reason, 'no_samples')\n  43→  assert.equal(actual.status, 'known')\n  44→})\n  45→\n  46→test('[AC-018] credits without a rate stay unknown with a registered reason', () => {\n  47→  const actual = noSampleForecast({ remaining: 1, unit: 'credits' })\n  48→\n  49→  assert.equal(validate(schema, actual).ok, true)\n  50→  assert.equal(actual.status, 'unknown')\n  51→  assert.equal(actual.risk, 'unknown')\n  52→  assert.equal(actual.risk_basis, 'none')\n  53→  assert.equal(actual.reason, 'credits_conversion_missing')\n  54→  assert.equal(actual.tasks_left_assumed, null)\n  55→  assert.equal(REASONS.includes(actual.reason), true)\n  56→})\n  57→\n  58→test('[AC-018] an empty quota is unknown with a registered reason', () => {\n  59→  const actual = noSampleForecast({})\n  60→\n  61→  assert.equal(validate(schema, actual).ok, true)\n  62→  assert.equal(actual.status, 'unknown')\n  63→  assert.equal(actual.risk, 'unknown')\n  64→  assert.equal(actual.risk_basis, 'none')\n  65→  assert.equal(actual.tasks_left_basis, 'none')\n  66→  assert.equal(actual.reason, 'capacity_unknown')\n  67→  assert.equal(REASONS.includes(actual.reason), true)\n  68→})\n  69→\n  70→test('[AC-018] no sample input claims a tasks-based risk', () => {\n  71→  const quotaShapes = [\n  72→    {},\n  73→    null,\n  74→    { remaining_pct: 50 },\n  75→    { remaining_pct: 12 },\n  76→    { remaining_pct: 0 },\n  77→    { remaining: 2000000, unit: 'tokens' },\n  78→    { remaining: 0, unit: 'tokens' },\n  79→    { remaining: 1, unit: 'credits' },\n  80→    { remaining: 0, unit: 'credits' },\n  81→    { remaining: 1, unit: 'credits', credits_per_mtok: 1000 },\n  82→    { remaining_usd: 3 },\n  83→    { remaining_usd: 0 },\n  84→  ]\n  85→\n  86→  for (const quota of quotaShapes) {\n  87→    const actual = noSampleForecast(quota)\n  88→    assert.equal(validate(schema, actual).ok, true, JSON.stringify(quota))\n  89→    assert.equal(actual.status === 'unknown' || actual.tasks_left === null, true, JSON.stringify(quota))\n  90→    assert.notEqual(actual.tasks_left_basis, 'assumed', JSON.stringify(quota))\n  91→    if (actual.tasks_left === null) assert.notEqual(actual.risk_basis, 'tasks', JSON.stringify(quota))\n  92→    if (actual.risk_basis !== 'fraction') {\n  93→      assert.equal(actual.risk === 'ok' || actual.risk === 'critical', false, JSON.stringify(quota))\n  94→    }\n  95→    if (actual.reason !== null) assert.equal(REASONS.includes(actual.reason), true, JSON.stringify(quota))\n  96→  }\n  97→})\n  98→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b775293b7644841220b6312342b9","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b775293b7644841220b6312342b9","codebuddy.ai/llmMessageId":"01a1b775293b7644841220b6312342b9","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:21:19.086Z"}
{"type":"user","uuid":"01a1b775-47f1-7f09-ad93-afc9c16cd43e","session_id":"01a1b76f-c764-7902-805e-3362c00095cd","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-8e66da5321274988","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→\n   4→import { evaluatePools, resolveResetAt } from '../../lib/pools.mjs'\n   5→import { createFakeContext } from '../helpers/ctx.mjs'\n   6→\n   7→const NOW = Date.parse('2026-11-07T10:00:00.000Z')\n   8→\n   9→test('[AC-019] resolveResetAt prefers cli over config', () => {\n  10→  const resolved = resolveResetAt({\n  11→    cli: '2026-11-07T12:00:00Z',\n  12→    config: '2026-11-08T00:00:00Z',\n  13→    now: NOW,\n  14→  })\n  15→  assert.deepStrictEqual(resolved, { reset_at: '2026-11-07T12:00:00.000Z', reset_source: 'cli' })\n  16→})\n  17→\n  18→test('[AC-019] resolveResetAt falls back to config', () => {\n  19→  const resolved = resolveResetAt({ config: '2026-11-07T12:00:00Z', now: NOW })\n  20→  assert.deepStrictEqual(resolved, { reset_at: '2026-11-07T12:00:00.000Z', reset_source: 'config' })\n  21→})\n  22→\n  23→test('[AC-019] resolveResetAt estimates a rolling window', () => {\n  24→  const resolved = resolveResetAt({\n  25→    window: { anchor: 'rolling', length_s: 3600 },\n  26→    rows: [\n  27→      { at: '2026-11-07T08:00:00.000Z' },\n  28→      { at: '2026-11-07T09:30:00.000Z' },\n  29→      { at: '2026-11-07T09:10:00.000Z' },\n  30→    ],\n  31→    now: NOW,\n  32→  })\n  33→  assert.deepStrictEqual(resolved, { reset_at: '2026-11-07T10:10:00.000Z', reset_source: 'estimated' })\n  34→})\n  35→\n  36→test('[AC-019] resolveResetAt is unknown without candidates', () => {\n  37→  assert.deepStrictEqual(resolveResetAt({ now: NOW }), { reset_at: null, reset_source: 'unknown' })\n  38→})\n  39→\n  40→function pool(source) {\n  41→  return {\n  42→    id: 'p',\n  43→    window: {\n  44→      start_at: '2026-11-07T07:00:00.000Z',\n  45→      reset_at: '2026-11-07T12:00:00.000Z',\n  46→      reset_source: source,\n  47→    },\n  48→    capacity_mtok: { m: 10 },\n  49→    reading: { value: 0.5, at: '2026-11-07T11:50:01.000Z' },\n  50→  }\n  51→}\n  52→\n  53→test('[AC-019] a cli reset clears usage and a config reset only asks for a recheck', async () => {\n  54→  const ctx = createFakeContext({ now: Date.parse('2026-11-07T11:59:59.000Z') })\n  55→\n  56→  const before = evaluatePools({ models: ['m'], pools: [pool('cli')], rows: [], now: ctx.clock.now(), reading_ttl_s: 600 })\n  57→  assert.equal(before.m.pools[0].used_fraction, 0.5)\n  58→  assert.equal(before.m.pools[0].recheck, false)\n  59→\n  60→  await ctx.clock.advance(2000)\n  61→\n  62→  const after = evaluatePools({ models: ['m'], pools: [pool('cli')], rows: [], now: ctx.clock.now(), reading_ttl_s: 600 })\n  63→  assert.equal(after.m.pools[0].used_fraction, 0)\n  64→  assert.equal(after.m.pools[0].recheck, false)\n  65→\n  66→  const kept = evaluatePools({ models: ['m'], pools: [pool('config')], rows: [], now: ctx.clock.now(), reading_ttl_s: 600 })\n  67→  assert.equal(kept.m.pools[0].used_fraction, 0.5)\n  68→  assert.equal(kept.m.pools[0].recheck, true)\n  69→})\n  70→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b775293b7644841220b6312342b9","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b775293b7644841220b6312342b9","codebuddy.ai/llmMessageId":"01a1b775293b7644841220b6312342b9","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:21:19.090Z"}
