ing) {\n  49→      const resolved = track('readFileSync', p)\n  50→      if (!store.has(resolved)) throw miss(resolved)\n  51→      const value = store.get(resolved)\n  52→      return encoding ? value : Buffer.from(value)\n  53→    },\n  54→    writeFileSync(p, data) {\n  55→      store.set(track('writeFileSync', p), String(data))\n  56→    },\n  57→    appendFileSync(p, data) {\n  58→      const resolved = track('appendFileSync', p)\n  59→      store.set(resolved, (store.get(resolved) || '') + String(data))\n  60→    },\n  61→    mkdirSync(p) {\n  62→      track('mkdirSync', p)\n  63→      return undefined\n  64→    },\n  65→    existsSync(p) {\n  66→      const resolved = track('existsSync', p)\n  67→      return store.has(resolved) || hasDir(resolved)\n  68→    },\n  69→    statSync(p) {\n  70→      const resolved = track('statSync', p)\n  71→      if (store.has(resolved)) return { isFile: () => true, isDirectory: () => false, size: store.get(resolved).length }\n  72→      if (hasDir(resolved)) return { isFile: () => false, isDirectory: () => true, size: 0 }\n  73→      throw miss(resolved)\n  74→    },\n  75→    readdirSync(p) {\n  76→      const resolved = track('readdirSync', p)\n  77→      const prefix = resolved.endsWith(path.sep) ? resolved : resolved + path.sep\n  78→      const names = []\n  79→      for (const key of store.keys()) {\n  80→        if (!key.startsWith(prefix)) continue\n  81→        const name = key.slice(prefix.length).split(path.sep)[0]\n  82→        if (!names.includes(name)) names.push(name)\n  83→      }\n  84→      if (names.length === 0) throw miss(resolved)\n  85→      return names\n  86→    },\n  87→    renameSync(from, to) {\n  88→      const source = track('renameSync', from)\n  89→      if (!store.has(source)) throw miss(source)\n  90→      store.set(norm(to), store.get(source))\n  91→      store.delete(source)\n  92→    },\n  93→    rmSync(p) {\n  94→      store.delete(track('rmSync', p))\n  95→    },\n  96→  }\n  97→\n  98→  api.files = store\n  99→  api.accessed = accessed\n 100→  return api\n 101→}\n 102→\n 103→export function fakeFetch() {\n 104→  const calls = []\n 105→  const fn = (url, init) => {\n 106→    calls.push({ url, init })\n 107→    return Promise.reject(new Error('fakeFetch: no network'))\n 108→  }\n 109→  fn.calls = calls\n 110→  return fn\n 111→}\n 112→\n 113→export const fakeClock = createFakeClock\n 114→\n 115→export function createFakeContext({ files, env, platform, exec, now } = {}) {\n 116→  const clock = createFakeClock(now === undefined ? {} : { start: now })\n 117→  const fs = fakeFs(files || {})\n 118→  let seed = 20261107\n 119→  const random = () => {\n 120→    seed = (seed * 1103515245 + 12345) % 2147483648\n 121→    return seed / 2147483648\n 122→  }\n 123→\n 124→  return {\n 125→    exec: fakeExec(exec),\n 126→    fs,\n 127→    fetch: fakeFetch(),\n 128→    env: env || {},\n 129→    platform: platform || 'linux',\n 130→    stdout: fakeStream(),\n 131→    stderr: fakeStream(),\n 132→    random,\n 133→    clock,\n 134→    now: () => clock.now(),\n 135→  }\n 136→}\n 137→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b776a00c7902b6365b31c084babd","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b776a00c7902b6365b31c084babd","codebuddy.ai/llmMessageId":"01a1b776a00c7902b6365b31c084babd","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:22:57.719Z"}
