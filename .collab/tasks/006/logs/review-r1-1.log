{"type":"user","uuid":"01a1b773-3303-786a-9e28-9048a6b3107a","session_id":"01a1b76f-c764-7902-805e-3362c00095cd","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-803c8eb286913356","content":[{"type":"text","text":"   1→{\n   2→  \"os\": [\n   3→    {\n   4→      \"name\": \"ubuntu\",\n   5→      \"runs_on\": \"ubuntu-latest\",\n   6→      \"baseline\": \"linux\"\n   7→    },\n   8→    {\n   9→      \"name\": \"windows\",\n  10→      \"runs_on\": \"windows-latest\",\n  11→      \"baseline\": \"win32\"\n  12→    },\n  13→    {\n  14→      \"name\": \"macos\",\n  15→      \"runs_on\": \"macos-latest\",\n  16→      \"baseline\": \"darwin\"\n  17→    }\n  18→  ],\n  19→  \"node\": [\n  20→    20,\n  21→    22\n  22→  ],\n  23→  \"check_command\": \"npm run check\",\n  24→  \"results_dir\": \"test-results\",\n  25→  \"artifacts\": [\n  26→    \"files-executed.json\",\n  27→    \"skips.jsonl\"\n  28→  ],\n  29→  \"perf\": {\n  30→    \"runs_on\": \"ubuntu-latest\",\n  31→    \"node\": 22,\n  32→    \"command\": \"npm run perf\",\n  33→    \"blocking\": false\n  34→  }\n  35→}\n  36→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b77155d07b54bed2f20b0947b5f3","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b77155d07b54bed2f20b0947b5f3","codebuddy.ai/llmMessageId":"01a1b77155d07b54bed2f20b0947b5f3","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:19:02.660Z"}
{"type":"user","uuid":"01a1b773-3309-7f8d-b73d-dae5268d781a","session_id":"01a1b76f-c764-7902-805e-3362c00095cd","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-ba71eb7e10149aaf","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Verifies that .github/workflows/ci.yml is the current output of gen-ci.mjs for ci-matrix.json.\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { fileURLToPath } from 'node:url'\n   6→\n   7→import { renderCi } from './gen-ci.mjs'\n   8→\n   9→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  10→const REPO_ROOT = path.resolve(HERE, '..')\n  11→\n  12→const EXPECTED_OS = ['macos', 'ubuntu', 'windows']\n  13→const EXPECTED_NODE = [20, 22]\n  14→const EXPECTED_ARTIFACTS = ['files-executed.json', 'skips.jsonl']\n  15→const CHECK_COMMAND = 'npm run check'\n  16→\n  17→function sortedCopy(value) {\n  18→  return Array.isArray(value) ? [...value].sort() : null\n  19→}\n  20→\n  21→function sameArray(actual, expected) {\n  22→  if (!Array.isArray(actual) || actual.length !== expected.length) return false\n  23→  return actual.every((item, i) => item === expected[i])\n  24→}\n  25→\n  26→function validateMatrix(matrix) {\n  27→  const problems = []\n  28→  if (!matrix || typeof matrix !== 'object' || Array.isArray(matrix)) {\n  29→    problems.push('matrix must be a JSON object')\n  30→    return problems\n  31→  }\n  32→\n  33→  const names = sortedCopy((Array.isArray(matrix.os) ? matrix.os : []).map((item) => item && item.name))\n  34→  if (!names || !sameArray(names, EXPECTED_OS)) {\n  35→    problems.push(`os names must be ${EXPECTED_OS.join('|')}`)\n  36→  }\n  37→  if (!sameArray(matrix.node, EXPECTED_NODE)) {\n  38→    problems.push(`node must be ${EXPECTED_NODE.join(',')}`)\n  39→  }\n  40→  if (matrix.check_command !== CHECK_COMMAND) {\n  41→    problems.push(`check_command must be \"${CHECK_COMMAND}\"`)\n  42→  }\n  43→  if (!sameArray(matrix.artifacts, EXPECTED_ARTIFACTS)) {\n  44→    problems.push(`artifacts must be ${EXPECTED_ARTIFACTS.join(',')}`)\n  45→  }\n  46→  if (!matrix.perf || matrix.perf.blocking !== false) {\n  47→    problems.push('perf.blocking must be false')\n  48→  }\n  49→  return problems\n  50→}\n  51→\n  52→export function checkCi(root = REPO_ROOT) {\n  53→  const errors = []\n  54→  const matrixFile = path.join(root, 'scripts', 'ci-matrix.json')\n  55→  const workflowFile = path.join(root, '.github', 'workflows', 'ci.yml')\n  56→\n  57→  let matrix = null\n  58→  try {\n  59→    matrix = JSON.parse(fs.readFileSync(matrixFile, 'utf8'))\n  60→  } catch {\n  61→    errors.push({ id: 'ci.matrix_invalid', detail: `cannot read ${matrixFile}` })\n  62→    return errors\n  63→  }\n  64→\n  65→  const problems = validateMatrix(matrix)\n  66→  if (problems.length > 0) {\n  67→    for (const problem of problems) errors.push({ id: 'ci.matrix_invalid', detail: problem })\n  68→    return errors\n  69→  }\n  70→\n  71→  let actual = null\n  72→  try {\n  73→    actual = fs.readFileSync(workflowFile, 'utf8')\n  74→  } catch {\n  75→    errors.push({ id: 'ci.missing', detail: '.github/workflows/ci.yml is missing' })\n  76→    return errors\n  77→  }\n  78→\n  79→  const expected = renderCi(matrix)\n  80→  if (actual.replace(/\\r\\n/g, '\\n') !== expected.replace(/\\r\\n/g, '\\n')) {\n  81→    errors.push({ id: 'ci.stale', detail: '.github/workflows/ci.yml is not the current generated output' })\n  82→  }\n  83→\n  84→  if (!expected.includes('continue-on-error: true')) {\n  85→    errors.push({ id: 'ci.perf_blocking', detail: 'perf job is missing continue-on-error: true' })\n  86→  }\n  87→  if (expected.includes('needs: perf')) {\n  88→    errors.push({ id: 'ci.perf_blocking', detail: 'a job depends on perf' })\n  89→  }\n  90→\n  91→  return errors\n  92→}\n  93→\n  94→function main() {\n  95→  const args = process.argv.slice(2)\n  96→  let root = REPO_ROOT\n  97→\n  98→  for (let i = 0; i < args.length; i += 1) {\n  99→    const flag = args[i]\n 100→    if (flag === '--root') {\n 101→      const value = args[i + 1]\n 102→      if (typeof value !== 'string' || value === '') {\n 103→        process.stderr.write('--root requires a directory\\n')\n 104→        process.exitCode = 2\n 105→        return\n 106→      }\n 107→      root = path.resolve(value)\n 108→      i += 1\n 109→    } else {\n 110→      process.stderr.write(`unknown argument: ${flag}\\nusage: node scripts/check-ci.mjs [--root <dir>]\\n`)\n 111→      process.exitCode = 2\n 112→      return\n 113→    }\n 114→  }\n 115→\n 116→  const errors = checkCi(root)\n 117→  if (errors.length === 0) {\n 118→    process.stdout.write('check-ci: ok\\n')\n 119→    process.exitCode = 0\n 120→    return\n 121→  }\n 122→  for (const error of errors) process.stdout.write(`FAIL ${error.id} ${error.detail}\\n`)\n 123→  process.stdout.write(`check-ci: FAILED (${errors.length} errors)\\n`)\n 124→  process.exitCode = 1\n 125→}\n 126→\n 127→const invokedDirectly =\n 128→  process.argv[1] && path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 129→\n 130→if (invokedDirectly) main()\n 131→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b76fcabd7d4ca301cf1d513a6538","_messageId":"01a1b77155d07b54bed2f20b0947b5f3","_meta":{"codebuddy.ai/conversationRequestId":"01a1b76fcabd7d4ca301cf1d513a6538","codebuddy.ai/modelRequestId":"01a1b77155d07b54bed2f20b0947b5f3","codebuddy.ai/llmMessageId":"01a1b77155d07b54bed2f20b0947b5f3","traceparent":"00-c44ab554f795b9b062607ca3688ee7fa-85ce4a6cebf7295d-01","baggage":"codebuddy.session_id=01a1b76f-c764-7902-805e-3362c00095cd,codebuddy.conversation_request_id=01a1b76fcabd7d4ca301cf1d513a6538"},"__timestamp":"2026-11-07T19:19:02.666Z"}
