TATUS })\n  assert.equal(allowed.ok, true)\n  assert.deepEqual(allowed.models.map((m) => m.key), ['unverified'])\n})\n\ntest('[AC-005] stable: level filter rejects other levels', () => {\n  const cfg = config({ quick: claudeModel('quick'), top: claudeModel('top', { level: 'Top' }) })\n\ntest/characterization/canary:\na1-quota\na2-pack\na3-runner\na4-null-config\na4-paths\na5-dup-call\na5-forecast-x3\na5-ignored-fields\na5-nocache\na5-shell\na5-unused\n\ntest/characterization/canary/a5-unused:\ncanary.json\noverlay\n\ntest/characterization/canary/a5-unused/overlay/lib:\ncli.mjs\nselect.mjs\n{\r\n  \"schema\": \"cliworker.surfaces/v1\",\r\n  \"preserved\": [\r\n    {\r\n      \"id\": \"candidate.deprecated_unverified_excluded\",\r\n      \"description\": \"Deprecated models and models with unverified identity never enter the candidate list\"\r\n    },\r\n    {\r\n      \"id\": \"candidate.level_filter\",\r\n      \"description\": \"Candidates are filtered by exact level; no silent downgrade\"\r\n    },\r\n    {\r\n      \"id\": \"candidate.exclude_reason\",\r\n      \"description\": \"A model listed in exclude is rejected with reason excluded\"\r\n    },\r\n    {\r\n      \"id\": \"schema_names\",\r\n      \"description\": \"The four schema name strings are kept\",\r\n      \"values\": [\r\n        \"cliworker.selection/v1\",\r\n        \"cliworker.handle/v1\",\r\n        \"cliworker.model/v1\",\r\n        \"cliworker.forecast/v1\"\r\n      ]\r\n    }\r\n  ],\r\n  \"semantic_change\": [\r\n    {\r\n      \"id\": \"forecast.tasks_left\",\r\n      \"description\": \"tasks_left may be null and comes with tasks_left_basis\"\r\n    },\r\n    {\r\n      \"id\": \"forecast.risk\",\r\n      \"description\": \"risk is derived with risk_basis and the threshold tables in the registry snapshot\"\r\n    },\r\n    { \"id\": \"handle.cli_removed\", \"description\": \"The duplicate cli key is removed from the handle\" },\r\n    {\r\n      \"id\": \"draft_reason_mapping\",\r\n      \"