\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\n35-    { \"ac\": \"AC-032\", \"owner\": \"T-013\", \"milestone\": \"M2\", \"levels\": [\"integration\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\n36-    { \"ac\": \"AC-033\", \"owner\": \"T-013\", \"milestone\": \"M2\", \"levels\": [\"unit\"], \"baseline\": [\"linux\"] },\n37-    { \"ac\": \"AC-034\", \"owner\": \"T-014\", \"milestone\": \"M2\", \"levels\": [\"unit\"], \"baseline\": [\"darwin\", \"linux\", \"win32\"] },\n  }\n\n  if (enumerated.length === 0) errors.push({ id: 'discovery.no_files', path: '' })\n\n  return { ok: errors.length === 0, errors }\n}\n\nfunction normalizePath(value) {\n  const resolved = path.resolve(value).replace(/[\\\\/]+$/, '')\n  return process.platform === 'win32' ? resolved.toLowerCase() : resolved\n}\n\nfunction defaultOutDir(root) {\n  const key = process.platform === 'win32' ? root.toLowerCase() : root\n  const hash = crypto.createHash('sha256').update(key).digest('hex').slice(0, 12)\n  return path.join(os.tmpdir(), 'cliworker-test-results', hash)\n}\n\nfunction usageError(message) {\n  process.stderr.write(`${message}\\n${USAGE}\\n`)\n  process.exitCode = 2\n}\n\nfunction parseArgs(argv) {\n  const options = { acs: [], root: REPO_ROOT, outDir: null, perf: false, updateSnapshots: false }\n  for (let i = 0; i < argv.length; i += 1) {\n    const flag = argv[i]\n    if (flag === '--ac') {\n      const value = argv[i + 1]\n      if (typeof value !== 'string' || !AC_PATTERN.test(value)) {\n        return { error: `--ac requires a value matching ^AC-\\\\d{3}$ (got ${JSON.stringify(value ?? null)})` }\n      }\n      options.acs.push(value)\n      i += 1\n    } else if (flag === '--root') {\n      const value = argv[i + 1]\n      if (typeof value !== 'string' || value === '') return { error: '--root requires a directory' }\n      options.root = path.resolve(value)\n      i += 1\n    } else if (flag === '--out-dir') {\n      const value = argv[i + 1]\n      if (typeof value !== 'string' || value === '') return { error: '--out-dir requires a directory' }\n      options.outDir = path.resolve(value)\n      i += 1\n    } else if (flag === '--perf') {\n      options.perf = true\n    } else if (flag === '--update-snapshots') {\n      options.updateSnapshots = true\n    } else {\n      return { error: `unknown argument: ${flag}` }\n    }\n  }\n  options.acs = [...new Set(options.acs)]\n  return { options }\n}\n\nfunction runNode(args, spawnOptions) {\n  return new Promise((resolve) => {\n    // A nested `node --test` refuses to run its files when it inherits NODE_TEST_CONTEXT from\n    // the parent test process. Nested runs are legitimate here (self-tests and the milestone\n    // gate spawn run-tests), so the child must look like a top-level run.\n    const env = { ...(spawnOptions.env ?? process.env) }\n    delete env.NODE_TEST_CONTEXT\n    const child = spawn(process.execPath, args, { ...spawnOptions, env })\n    child.on('error', () => resolve({ code: null, signal: null }))\n    child.on('close', (code, signal) => resolve({ code, signal }))\n  })\n}\n\nfunction readManifest(file) {\n  try {\n    return JSON.parse(fs.readFileSync(file, 'utf8'))\n  } catch {\n    return null\n  }\n}\n\nasync function main() {\n  const parsed = parseArgs(process.argv.slice(2))\n  if (parsed.error) {\n    usageError(parsed.error)\n#!/usr/bin/env node\r\n// Defect ledger check: every defect that must already be fixed needs a plain [fixed] test.\r\nimport crypto from 'node:crypto'\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport { spawnSync } from 'node:child_process'\r\nimport { fileURLToPath, pathToFileURL } from 'node:url'\r\n\r\nimport { mergeShards, extractTitles } from './check-traceability.mjs'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst REPO_ROOT = path.resolve(HERE, '..')\r\n\r\nconst MILESTONES = ['M1', 'M2', 'M3', 'M4', 'M5']\r\nconst EXPECTED_IDS = [\r\n  'a1-quota',\r\n  'a2-pack',\r\n  'a3-runner',\r\n  'a4-paths',\r\n  'a4-null-config',\r\n  'a5-dup-call',\r\n  'a5-forecast-x3',\r\n  'a5-unused',\r\n  'a5-ignored-fields',\r\n  'a5-shell',\r\n  'a5-nocache',\r\n]\r\n\r\nconst LEDGER = ['test', 'characterization', 'defects.json']\r\nconst DEFECTS_DIR = ['test', 'characterization', 'defects']\r\nconst CANARY_DIR = ['test', 'characterization', 'canary']\r\nconst COPY_DIR = ['test', 'fixtures', 'characterization', 'v0.1']\r\n\r\nconst RUN_TIMEOUT_MS = 60_000\r\nconst REPRO_OPEN_RE = /^test\\(['\"`]\\[repro\\]/\r\nconst TAP_REPRO_OK_RE = /^\\s*ok \\d+ - \\[repro\\]/m\r\nconst TAP_REPRO_NOT_OK_RE = /^\\s*not ok \\d+ - \\[repro\\]/m\r\nconst RELATIVE_IMPORT_RE = /(\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\bimport\\s+)(['\"])(\\.[^'\"]*)\\2/g\r\n\r\nexport function milestoneRank(value) {\r\n  const index = MILESTONES.indexOf(value)\r\n  return index < 0 ? Number.NaN : index + 1\r\n}\r\n\r\nexport function hasFixedSection(source) {\r\n  return extractTitles(source).some((item) => item.kind === 'plain' && item.title.startsWith('[fixed]'))\r\n}\r\n\r\nexport function checkDefects({ root, index, milestone }) {\r\n  const errors = []\r\n  const ledgerFile = path.join(root, ...LEDGER)\r\n\r\n  if (!fs.existsSync(ledgerFile)) {\r\n    if (milestone) errors.push({ id: 'defects.file_missing', detail: 'test/characterization/defects.json' })\r\n    return { errors, absent: true }\r\n  }\r\n\r\n  let ledger = null\r\n  try {\r\nimport fs from 'node:fs'\r\nimport { run } from './exec.mjs'\r\n\r\nexport const TEST_CLOCK_ENV = 'CLIWORKER_TEST_CLOCK_FILE'\r\n\r\nconst NUMBER_RE = /^[0-9]+(\\.[0-9]+)?$/\r\n\r\nfunction resolve(value, fallback) {\r\n  return value === undefined ? fallback : value\r\n}\r\n\r\nexport function createRealClock({ env, fs: fsApi } = {}) {\r\n  const readEnv = env || {}\r\n  const io = fsApi || fs\r\n\r\n  const clock = {\r\n    now() {\r\n      const file = readEnv[TEST_CLOCK_ENV]\r\n      if (typeof file !== 'string' || file === '') return Date.now()\r\n      const raw = String(io.readFileSync(file, 'utf8')).trim()\r\n      const value = NUMBER_RE.test(raw) ? Number(raw) : Date.parse(raw)\r\n      if (!Number.isFinite(value)) throw new Error(`invalid ${TEST_CLOCK_ENV} content`)\r\n      return value\r\n    },\r\n    nowIso() {\r\n      return new Date(clock.now()).toISOString()\r\n    },\r\n    setTimeout(fn, ms) {\r\n      return setTimeout(fn, ms)\r\n    },\r\n    clearTimeout(handle) {\r\n      clearTimeout(handle)\r\n    },\r\n    sleep(ms) {\r\n      return new Promise((done) => { setTimeout(done, ms) })\r\n    },\r\n  }\r\n\r\n  return clock\r\n}\r\n\r\nexport function createContext(overrides = {}) {\r\n  const o = overrides || {}\r\n  const env = resolve(o.env, process.env)\r\n  const fsApi = resolve(o.fs, fs)\r\n  const exec = resolve(o.exec, run)\r\n  const clock = resolve(o.clock, createRealClock({ env, fs: fsApi }))\r\n\r\n  return {\r\n    exec,\r\n    fs: fsApi,\r\n    fetch: resolve(o.fetch, (...a) => globalThis.fetch(...a)),\r\n    env,\r\n    platform: resolve(o.platform, process.platform),\r\n    stdout: resolve(o.stdout, process.stdout),\r\n    stderr: resolve(o.stderr, process.stderr),\r\n    random: resolve(o.random, () => Math.random()),\r\n    clock,\r\n    now: resolve(o.now, () => clock.now()),\r\n  }","is_error":false}]},"parent_tool_use_id":null,"session_id":"431fe411-7cc1-4856-b3b1-5ba30e130aba","uuid":"16e240a5-9b60-46e6-942a-ea609b957730","timestamp":"2026-11-07T21:55:51.051Z","tool_use_result":{"stdout":"contracts/golden/forecast:\nburn-eta.json\nconfidence.json\nquantiles.json\nthresholds.json\n\ncontracts/golden/policy:\np1-order.json\np2-quota-low.json\np3-unknown.json\np4-identity-group.json\n\ncontracts/spec:\nac-index.json\nmigration-map.json\nsurfaces.json\n{\r\n  \"schema\": \"cliworker.golden/v1\",\r\n  \"kind\": \"quota-shapes\",\r\n  \"description\": \"Quota shape readings turn into remaining fraction, tasks left and risk\",\r\n  \"cases\": [\r\n   