ileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\nconst MANIFEST_REL = 'contracts/golden/manifest.json'\nconst SCHEMA_REL = 'contracts/schemas/golden-manifest.schema.json'\nconst PRESERVED_DIRS = ['contracts/spec', 'contracts/golden']\nconst USAGE = 'usage: node scripts/check-golden-frozen.mjs [--root <dir>] [--write]'\n\nfunction toPosix(value) {\n  return value.split(path.sep).join('/')\n}\n\nfunction byCodePoint(a, b) {\n  if (a < b) return -1\n  if (a > b) return 1\n  return 0\n}\n\nfunction walk(dir, base, out) {\n  let entries\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true })\n  } catch {\n    return\n  }\n  for (const entry of entries) {\n    const full = path.join(dir, entry.name)\n    if (entry.isDirectory()) walk(full, base, out)\n    else if (entry.isFile()) out.push(toPosix(path.relative(base, full)))\n  }\n}\n\nfunction listFiles(root) {\n  const found = []\n  for (const rel of PRESERVED_DIRS) {\n    walk(path.join(root, rel), root, found)\n  }\n  return found\n    .filter((rel) => rel !== MANIFEST_REL)\n    .sort(byCodePoint)\n}\n\nfunction normalizedSha256(file) {\n  const text = fs.readFileSync(file).toString('utf8').replace(/\\r\\n/g, '\\n')\n  return crypto.createHash('sha256').update(text, 'utf8').digest('hex')\n}\n\nfunction writeManifest(root, files) {\n  const payload = {\n    schema: 'cliworker.golden-manifest/v1',\n    files: files.map((rel) => ({ path: rel, sha256: normalizedSha256(path.join(root, rel)) })),"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c6b0e77778fdcf33a22d748cd","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c6b0e77778fdcf33a22d748cd","codebuddy.ai/llmMessageId":"01a1b80c6b0e77778fdcf33a22d748cd","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_id=01a1b80c-10a1-714c-94fe-186218e3e224,codebu