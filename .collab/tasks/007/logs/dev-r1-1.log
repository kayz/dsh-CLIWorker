{"type":"user","uuid":"01a1b80c-363f-7fb8-8267-99af82e070d9","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_LKYZYy9WdTGBcSPI68Qi8423","content":[{"type":"text","text":"   1→import fs from 'node:fs'\n   2→import { run } from './exec.mjs'\n   3→\n   4→export const TEST_CLOCK_ENV = 'CLIWORKER_TEST_CLOCK_FILE'\n   5→\n   6→const NUMBER_RE = /^[0-9]+(\\.[0-9]+)?$/\n   7→\n   8→function resolve(value, fallback) {\n   9→  return value === undefined ? fallback : value\n  10→}\n  11→\n  12→export function createRealClock({ env, fs: fsApi } = {}) {\n  13→  const readEnv = env || {}\n  14→  const io = fsApi || fs\n  15→\n  16→  const clock = {\n  17→    now() {\n  18→      const file = readEnv[TEST_CLOCK_ENV]\n  19→      if (typeof file !== 'string' || file === '') return Date.now()\n  20→      const raw = String(io.readFileSync(file, 'utf8')).trim()\n  21→      const value = NUMBER_RE.test(raw) ? Number(raw) : Date.parse(raw)\n  22→      if (!Number.isFinite(value)) throw new Error(`invalid ${TEST_CLOCK_ENV} content`)\n  23→      return value\n  24→    },\n  25→    nowIso() {\n  26→      return new Date(clock.now()).toISOString()\n  27→    },\n  28→    setTimeout(fn, ms) {\n  29→      return setTimeout(fn, ms)\n  30→    },\n  31→    clearTimeout(handle) {\n  32→      clearTimeout(handle)\n  33→    },\n  34→    sleep(ms) {\n  35→      return new Promise((done) => { setTimeout(done, ms) })\n  36→    },\n  37→  }\n  38→\n  39→  return clock\n  40→}\n  41→\n  42→export function createContext(overrides = {}) {\n  43→  const o = overrides || {}\n  44→  const env = resolve(o.env, process.env)\n  45→  const fsApi = resolve(o.fs, fs)\n  46→  const exec = resolve(o.exec, run)\n  47→  const clock = resolve(o.clock, createRealClock({ env, fs: fsApi }))\n  48→\n  49→  return {\n  50→    exec,\n  51→    fs: fsApi,\n  52→    fetch: resolve(o.fetch, (...a) => globalThis.fetch(...a)),\n  53→    env,\n  54→    platform: resolve(o.platform, process.platform),\n  55→    stdout: resolve(o.stdout, process.stdout),\n  56→    stderr: resolve(o.stderr, process.stderr),\n  57→    random: resolve(o.random, () => Math.random()),\n  58→    clock,\n  59→    now: resolve(o.now, () => clock.now()),\n  60→  }\n  61→}\n  62→\n  63→export function systemNow() {\n  64→  return createRealClock({ env: process.env, fs }).now()\n  65→}\n  66→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c2afd73af8001ace5ef03299e","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c2afd73af8001ace5ef03299e","codebuddy.ai/llmMessageId":"01a1b80c2afd73af8001ace5ef03299e","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_id=01a1b80c-10a1-714c-94fe-186218e3e224,codebuddy.conversation_request_id=01a1b80c14647279947af18522731dd8"},"__timestamp":"2026-11-07T22:06:10.496Z"}
