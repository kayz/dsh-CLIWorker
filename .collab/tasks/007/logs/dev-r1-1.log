s','q-usd']; for (const id of ids) { if (o.includes('[AC-015] ' + id) === false) { console.error(id); process.exit(1); } } if (o.includes('[AC-015] golden case count') === false) process.exit(1); if (o.includes('[fixed] [AC-015] live forecast reads percentage and credits quotas') === false) process.exit(1); console.log('AC-015 OK')\"\r\n```\r\n\r\n- 期望: stdout 最后一行是 `AC-015 OK`，退出码 0。\r\n- 期望: `run-tests` 选中 2 个文件（`pools.test.mjs` 与追加了 `[AC-015]` 的 `a1-quota.test.mjs`）。9 个 quota-shapes case 标题、`[AC-015] golden case count` 和 `[fixed] [AC-015] live forecast reads percentage and credits quotas` 都出现，没有失败标记，且含 `fail 0`。\r\n\r\n## AC-015 A-2 金标深相等\r\n\r\n```\r\nnode --input-type=module -e \"import fs from 'node:fs'; import assert from 'node:assert/strict'; import { buildForecast } from './lib/forecast.mjs'; const g = JSON.parse(fs.readFileSync('contracts/golden/quota-shapes.json', 'utf8')); if (g.cases.length === 9) { /* ok */ } else process.exit(1); for (const c of g.cases) { const actual = buildForecast({ quota: c.input.quota, samples: c.input.samples, usage: c.input.usage, now: 0 }); for (const key of Object.keys(c.expected)) assert.deepStrictEqual(actual[key], c.expected[key], c.id + ' ' + key); } console.log('AC-015 OK')\"\r\n```\r\n\r\n- 期望: stdout 最后一行是 `AC-015 OK`，退出码 0。\r\n- 期望: quota-shapes 的 9 个 case，`buildForecast` 在 `expected` 的每个键上与金标深相等。\r\n\r\n## AC-015 A-3 旧 forecast 仍给出 tasks_left 10\r\n\r\n```\r\nnode --input-type=module -e \"import { forecast, estimateCost, normalizePrices, DEFAULT_PRICES } from './lib/forecast.mjs'; const now = Date.parse('2026-11-07T00:00:00.000Z'); const records = [{ model: 'a', at: '2026-11-06T23:00:00.000Z', input_tokens: 1000000, output_tokens: 0, cost_usd: 10 }, { model: 'a', at: '2026-11-06T23:30:00.000Z', input_tokens: 1000000, output_tokens: 0, cost_usd: 10 }]; const f = forecast({ records, model: 'a', now, quota: { remaining_usd: 100 } }); if (f.status === 'known' && f.tasks_left === 10 && f.burn_per_task === 10 && f.risk ==