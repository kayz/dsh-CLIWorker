typeof value === 'object' && !Array.isArray(value)\n  58→  if (type === 'null') return value === null\n  59→  return typeof value === type\n  60→}\n  61→\n  62→function schemaKeywords(schema) {\n  63→  return Object.keys(schema).filter((key) => !ANNOTATIONS.has(key))\n  64→}\n  65→\n  66→export function checkSchema(schema) {\n  67→  const problems = []\n  68→\n  69→  function walk(node, pointer) {\n  70→    if (!node || typeof node !== 'object' || Array.isArray(node)) return\n  71→    for (const key of schemaKeywords(node)) {\n  72→      if (!SUPPORTED.has(key)) problems.push(`${pointer}: ${key}`)\n  73→    }\n  74→    if (node.$defs && typeof node.$defs === 'object') {\n  75→      for (const name of Object.keys(node.$defs)) {\n  76→        walk(node.$defs[name], childPath(`${pointer}/$defs`, name))\n  77→      }\n  78→    }\n  79→    if (node.properties && typeof node.properties === 'object') {\n  80→      for (const name of Object.keys(node.properties)) {\n  81→        walk(node.properties[name], childPath(`${pointer}/properties`, name))\n  82→      }\n  83→    }\n  84→    if (node.additionalProperties && typeof node.additionalProperties === 'object') {\n  85→      walk(node.additionalProperties, `${pointer}/additionalProperties`)\n  86→    }\n  87→    if (node.items && typeof node.items === 'object' && !Array.isArray(node.items)) {\n  88→      walk(node.items, `${pointer}/items`)\n  89→    }\n  90→  }\n  91→\n  92→  walk(schema, '')\n  93→  return problems\n  94→}\n  95→\n  96→function resolveRef(ref, currentRoot, loadSchema) {\n  97→  if (typeof ref !== 'string') throw new TypeError(`$ref must be a string`)\n  98→  const hash = ref.indexOf('#')\n  99→  const filePart = hash === -1 ? ref : ref.slice(0, hash)\n 100→  const pointerPart = hash === -1 ? '' : ref.slice(hash + 1)\n 101→  let target = currentRoot\n 102→  if (filePart !== '') {\n 103→    if (typeof loadSchema !== 'function') throw new TypeError(`cannot resolve $ref without loadSchema: ${ref}`)\n 104→    target = loadSchema(filePart)\n 105→    if (!target || typeof target !== 'object') throw new TypeError(`cannot resolve $ref: ${ref}`)\n 106→  }\n 107→  if (pointerPart === '') return { schema: target, root: target }\n 108→  const match = /^\\/\\$defs\\/([^/]+)$/.exec(pointerPart)\n 109→  if (!match) throw new TypeError(`unsupported $ref: ${ref}`)\n 110→  const name = decodeURIComponent(match[1]).replace(/~1/g, '/').replace(/~0/g, '~')\n 111→  const defs = target.$defs\n 112→  if (!defs || !Object.prototype.hasOwnProperty.call(defs, name)) {\n 113→    throw new TypeError(`cannot resolve $ref: ${ref}`)\n 114→  }\n 115→  return { schema: defs[name], root: target }\n 116→}\n 117→\n 118→export function validate(schema, doc, options = {}) {\n 119→  const loadSchema = options && typeof options.loadSchema === 'function' ? options.loadSchema : null\n 120→  const errors = []\n 121→  const seen = new Set()\n 122→\n 123→  function push(path, keyword, message) {\n 124→    const key = `${path}\\u0000${keyword}`\n 125→    if (seen.has(key)) return\n 126→    seen.add(key)\n 127→    errors.push({ path, keyword, message })\n 128→  }\n 129→\n 130→  function checkKeywords(node) {\n 131→    for (const key of schemaKeywords(node)) {\n 132→      if (!SUPPORTED.has(key)) throw new TypeError(`unsupported keyword: ${key}`)\n 133→    }\n 134→  }\n 135→\n 136→  function validateValue(node, value, pointer, depth, root) {\n 137→    if (depth > MAX_DEPTH) throw new TypeError('schema recursion is too deep')\n 138→    if (!node || typeof node !== 'object' || Array.isArray(node)) {\n 139→      throw new TypeError(`schema at ${pointer} is not an object`)\n 140→    }\n 141→    checkKeywords(node)\n 142→\n 143→    if (typeof node.$ref === 'string') {\n 144→      const resolved = resolveRef(node.$ref, root, loadSchema)\n 145→      validateValue(resolved.schema, value, pointer, depth + 1, resolved.root)\n 146→      return\n 147→    }\n 148→\n 149→    if (Object.prototype.hasOwnProperty.call(node, 'type')