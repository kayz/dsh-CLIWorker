{"type":"user","uuid":"01a1b80c-363a-727b-b286-1d8d828e826b","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_hoT36eFc2QY2MbM4h6Rv2859","content":[{"type":"text","text":"   1→import { systemNow } from './context.mjs'\n   2→import { round3, normalizeQuota, evaluatePools } from './pools.mjs'\n   3→\n   4→export { round3 }\n   5→\n   6→export const DEFAULT_PRICES = { input_per_mtok: 0, output_per_mtok: 0 }\n   7→\n   8→export function normalizePrices(m = {}) {\n   9→  const p = m.prices || {}\n  10→  return {\n  11→    input_per_mtok: Number(p.input_per_mtok ?? DEFAULT_PRICES.input_per_mtok),\n  12→    output_per_mtok: Number(p.output_per_mtok ?? DEFAULT_PRICES.output_per_mtok),\n  13→  }\n  14→}\n  15→\n  16→export function estimateCost({ input_tokens = 0, output_tokens = 0, prices = DEFAULT_PRICES }) {\n  17→  const p = { ...DEFAULT_PRICES, ...prices }\n  18→  return (Number(input_tokens) / 1e6) * p.input_per_mtok + (Number(output_tokens) / 1e6) * p.output_per_mtok\n  19→}\n  20→\n  21→/**\n  22→ * Deterministic, intentionally simple forecast. Unknown is a first-class state.\n  23→ * @deprecated Superseded by buildForecast; kept until lib/select.mjs migrates (T-007).\n  24→ */\n  25→export function forecast({ records = [], model, prices, quota = null, now = systemNow() } = {}) {\n  26→  const rows = records.filter((r) => !model || r.model === model)\n  27→  const samples = rows.map((r) => ({\n  28→    at: Date.parse(r.at || 0), input: Number(r.input_tokens || 0), output: Number(r.output_tokens || 0),\n  29→    cost: Number(r.cost_usd ?? estimateCost({ input_tokens: r.input_tokens, output_tokens: r.output_tokens, prices })),\n  30→  })).filter((r) => Number.isFinite(r.at) && r.at > 0)\n  31→  if (!samples.length) {\n  32→    return { status: 'unknown', samples: 0, reason: 'no usage samples', burn_per_task: null, tasks_left: null, eta_hours: null, confidence: 'none' }\n  33→  }\n  34→  const recent = samples.filter((r) => now - r.at <= 24 * 3600_000)\n  35→  const use = recent.length ? recent : samples.slice(-10)\n  36→  const burn = use.reduce((a, r) => a + r.cost, 0) / use.length\n  37→  const tokens = use.reduce((a, r) => a + r.input + r.output, 0) / use.length\n  38→  const spanHours = Math.max(1 / 60, (now - Math.min(...use.map((r) => r.at))) / 3600_000)\n  39→  const burnPerHour = use.reduce((a, r) => a + r.cost, 0) / spanHours\n  40→  let tasksLeft = null\n  41→  let etaHours = null\n  42→  if (quota && Number.isFinite(Number(quota.remaining_usd)) && burn > 0) {\n  43→    tasksLeft = Math.floor(Number(quota.remaining_usd) / burn)\n  44→    etaHours = burnPerHour > 0 ? Number(quota.remaining_usd) / burnPerHour : null\n  45→  } else if (quota && Number.isFinite(Number(quota.remaining)) && Number(quota.remaining) > 0 && tokens > 0 && quota.unit === 'tokens') {\n  46→    tasksLeft = Math.floor(Number(quota.remaining) / tokens)\n  47→  }\n  48→  const confidence = use.length >= 5 ? 'medium' : 'low'\n  49→  const risk = tasksLeft == null ? 'unknown' : tasksLeft <= 0 ? 'exhausted' : tasksLeft <= 2 ? 'critical' : tasksLeft <= 5 ? 'low_reserve' : 'ok'\n  50→  return {\n  51→    status: 'known', samples: use.length, burn_per_task: round(burn), tokens_per_task: Math.round(tokens),\n  52→    burn_per_hour: round(burnPerHour), tasks_left: tasksLeft, eta_hours: etaHours == null ? null : round(etaHours),\n  53→    confidence, risk,\n  54→  }\n  55→}\n  56→\n  57→function round(n) { return Math.round(n * 1e6) / 1e6 }\n  58→\n  59→const HOUR_MS = 3_600_000\n  60→\n  61→const USAGE_P = { Heavy: 0.9, Normal: 0.5, Light: 0.25 }\n  62→\n  63→export const DEFAULT_POLICY = {\n  64→  reading_ttl_s: 600,\n  65→  cache_read_weight: 0,\n  66→  usage_estimate_mtok: { Heavy: 2, Normal: 0.5, Light: 0.1 },\n  67→}\n  68→\n  69→function requireNow(now) {\n  70→  if (!Number.isFinite(now)) throw new TypeError('now must be a finite millisecond timestamp')\n  71→  return now\n  72→}\n  73→\n  74→function finiteNumber(value) {\n  75→  if (typeof value === 'number') return Number.isFinite(value) ? value : null\n  76→  return null\n  77→}\n  78→\n  79→function usageWeight(usage) {\n  80→  return Object.prototype.hasOwnProperty.call(USAGE_P, usage) ? USAGE_P[usage] : USAGE_P.Normal\n  81→}\n  82→\n  83→/** Nearest-rank quantile of the finite samples for a usage class; fewer than three samples is null. */\n  84→export function quantileForUsage(samples, usage) {\n  85→  const values = (Array.isArray(samples) ? samples : []).filter((item) => Number.isFinite(item))\n  86→  const n = values.length\n  87→  if (n < 3) return null\n  88→  const sorted = values.slice().sort((a, b) => a - b)\n  89→  const rank = Math.ceil(usageWeight(usage) * n) - 1\n  90→  return sorted[rank]\n  91→}\n  92→\n  93→/** Confidence from sample count, downgraded when the coefficient of variation exceeds one. */\n  94→export function confidenceFor(n, cv) {\n  95→  const count = Number.isFinite(n) ? n : 0\n  96→  if (count <= 0) return 'none'\n  97→  if (count < 5) return 'low'\n  98→  if (count < 20) return 'medium'\n  99→  return Number.isFinite(cv) && cv > 1 ? 'medium' : 'high'\n 100→}\n 101→\n 102→/** Risk from tasks left (tasks or usd basis) first, then the remaining fraction. */\n 103→export function classifyRisk({ tasks_left = null, tasks_left_basis = 'none', remaining_fraction = null } = {}) {\n 104→  if (Number.isFinite(tasks_left) && (tasks_left_basis === 'tasks' || tasks_left_basis === 'usd')) {\n 105→    const risk = tasks_left <= 0 ? 'exhausted' : tasks_left <= 2 ? 'critical' : tasks_left <= 5 ? 'low_reserve' : 'ok'\n 106→    return { risk, risk_basis: tasks_left_basis }\n 107→  }\n 108→  if (Number.isFinite(remaining_fraction)) {\n 109→    const risk = remaining_fraction <= 0 ? 'exhausted' : remaining_fraction < 0.05 ? 'critical' : remaining_fraction < 0.15 ? 'low_reserve' : 'ok'\n 110→    return { risk, risk_basis: 'fraction' }\n 111→  }\n 112→  return { risk: 'unknown', risk_basis: 'none' }\n 113→}\n 114→\n 115→/** Burn rate in Mtok per hour, clamped to at least one minute of elapsed time. */\n 116→export function burnMtokPerHour({ used_mtok = 0, hours_since_window_start = 0 } = {}) {\n 117→  const used = Number.isFinite(used_mtok) ? used_mtok : 0\n 118→  const hours = Number.isFinite(hours_since_window_start) ? hours_since_window_start : 0\n 119→  return round3(used / Math.max(hours, 1 / 60))\n 120→}\n 121→\n 122→/** Exhaustion instant and whether it lands strictly before the reset. */\n 123→export function etaExhaust({ now, remaining_mtok = 0, burn_mtok_per_hour = 0, reset_at = null } = {}) {\n 124→  const nowMs = requireNow(now)\n 125→  const remaining = Number.isFinite(remaining_mtok) ? remaining_mtok : 0\n 126→  const burn = Number.isFinite(burn_mtok_per_hour) ? burn_mtok_per_hour : 0\n 127→  const resetMs = typeof reset_at === 'string' ? Date.parse(reset_at) : Number.NaN\n 128→  const hasReset = Number.isFinite(resetMs)\n 129→\n 130→  let etaMs = null\n 131→  if (remaining <= 0) etaMs = nowMs\n 132→  else if (burn > 0) etaMs = nowMs + Math.round((remaining / burn) * HOUR_MS)\n 133→\n 134→  let exhausts = null\n 135→  if (hasReset) exhausts = etaMs === null ? false : etaMs < resetMs\n 136→\n 137→  return { eta_exhaust_at: etaMs === null ? null : new Date(etaMs).toISOString(), exhausts_before_reset: exhausts }\n 138→}\n 139→\n 140→function coefficientOfVariation(values) {\n 141→  if (!Array.isArray(values) || values.length < 2) return null\n 142→  const mean = values.reduce((total, value) => total + value, 0) / values.length\n 143→  if (mean === 0) return null\n 144→  const variance = values.reduce((total, value) => total + (value - mean) ** 2, 0) / values.length\n 145→  return Math.sqrt(variance) / mean\n 146→}\n 147→\n 148→function mergePolicy(policy) {\n 149→  const overrides = policy && typeof policy === 'object' ? policy : {}\n 150→  const merged = { ...DEFAULT_POLICY, ...overrides }\n 151→  const estimates = merged.usage_estimate_mtok && typeof merged.usage_estimate_mtok === 'object'\n 152→    ? merged.usage_estimate_mtok\n 153→    : DEFAULT_POLICY.usage_estimate_mtok\n 154→  merged.usage_estimate_mtok = estimates\n 155→  return merged\n 156→}\n 157→\n 158→function effectiveWindowStart(poolList, detail, nowMs) {\n 159→  const pool = poolList.find((item) => item && String(item.id ?? '') === detail.pool_id) ?? null\n 160→  const window = pool && pool.window && typeof pool.window === 'object' ? pool.window : null\n 161→  if (detail.reset_source === 'cli' && typeof detail.reset_at === 'string') {\n 162→    const resetMs = Date.parse(detail.reset_at)\n 163→    if (Number.isFinite(resetMs) && nowMs >= resetMs) return resetMs\n 164→  }\n 165→  if (window && typeof window.start_at === 'string') {\n 166→    const startMs = Date.parse(window.start_at)\n 167→    if (Number.isFinite(startMs)) return startMs\n 168→  }\n 169→  return null\n 170→}\n 171→\n 172→/**\n 173→ * The cliworker.forecast/v1 projection: remaining capacity, task estimate, risk, confidence,\n 174→ * burn and exhaustion time. All time arrives through `now`; nothing is read from the clock.\n 175→ */\n 176→export function buildForecast({\n 177→  model = '',\n 178→  quota = null,\n 179→  pools = null,\n 180→  rows = [],\n 181→  samples = [],\n 182→  usage = 'Normal',\n 183→  now,\n 184→  policy = null,\n 185→} = {}) {\n 186→  const nowMs = requireNow(now)\n 187→  const settings = mergePolicy(policy)\n 188→  const poolList = Array.isArray(pools) ? pools : []\n 189→  const sampleList = Array.isArray(samples) ? samples : []\n 190→\n 191→  let remaining_mtok = null\n 192→  let remaining_fraction = null\n 193→  let remaining_usd = null\n 194→  let fractionForRisk = null\n 195→  let quotaReason = null\n 196→  let evaluated = null\n 197→\n 198→  if (poolList.length > 0) {\n 199→    evaluated = evaluatePools({\n 200→      models: [model],\n 201→      pools: poolList,\n 202→      rows,\n 203→      now: nowMs,\n 204→      reading_ttl_s: settings.reading_ttl_s,\n 205→      cache_read_weight: settings.cache_read_weight,\n 206→    })\n 207→    const entry = evaluated[model]\n 208→    if (entry) {\n 209→      remaining_mtok = entry.remaining_mtok\n 210→      remaining_fraction = entry.remaining_fraction\n 211→      quotaReason = entry.reason\n 212→      const fractions = entry.pools\n 213→        .filter((item) => Number.isFinite(item.used_fraction))\n 214→        .map((item) => 1 - item.used_fraction)\n 215→      if (fractions.length > 0) fractionForRisk = Math.min(...fractions)\n 216→    }\n 217→    if (quota && Number.isFinite(quota.remaining_usd)) remaining_usd = quota.remaining_usd\n 218→  } else {\n 219→    const normalized = normalizeQuota(quota)\n 220→    remaining_mtok = normalized.remaining_mtok\n 221→    remaining_fraction = normalized.remaining_fraction\n 222→    remaining_usd = normalized.remaining_usd\n 223→    quotaReason = normalized.reason\n 224→  }\n 225→  if (fractionForRisk === null) fractionForRisk = remaining_fraction\n 226→\n 227→  const tokenSeries = []\n 228→  const costSeries = []\n 229→  for (const sample of sampleList) {\n 230→    if (!sample || typeof sample !== 'object') continue\n 231→    if (Number.isFinite(sample.mtok)) tokenSeries.push(sample.mtok)\n 232→    if (Number.isFinite(sample.cost_usd)) costSeries.push(sample.cost_usd)\n 233→  }\n 234→\n 235→  const tokens_per_task = {\n 236→    p25: quantileForUsage(tokenSeries, 'Light'),\n 237→    p50: quantileForUsage(tokenSeries, 'Normal'),\n 238→    p90: quantileForUsage(tokenSeries, 'Heavy'),\n 239→    n: tokenSeries.length,\n 240→  }\n 241→\n 242→  const tokenQuantile = quantileForUsage(tokenSeries, usage)\n 243→  const costQuantile = quantileForUsage(costSeries, usage)\n 244→\n 245→  let tasks_left = null\n 246→  let tasks_left_basis = 'none'\n 247→  if (remaining_mtok !== null && tokenQuantile !== null && tokenQuantile > 0) {\n 248→    tasks_left = Math.floor(remaining_mtok / tokenQuantile)\n 249→    tasks_left_basis = 'tasks'\n 250→  } else if (remaining_usd !== null && costQuantile !== null && costQuantile > 0) {\n 251→    tasks_left = Math.floor(remaining_usd / costQuantile)\n 252→    tasks_left_basis = 'usd'\n 253→  }\n 254→\n 255→  const estimate = finiteNumber(settings.usage_estimate_mtok[usage])\n 256→    ?? finiteNumber(settings.usage_estimate_mtok.Normal)\n 257→    ?? DEFAULT_POLICY.usage_estimate_mtok.Normal\n 258→  let tasks_left_assumed = null\n 259→  if (tasks_left === null && remaining_mtok !== null && estimate > 0) {\n 260→    tasks_left_assumed = Math.floor(remaining_mtok / estimate)\n 261→  }\n 262→\n 263→  let { risk, risk_basis } = classifyRisk({ tasks_left, tasks_left_basis, remaining_fraction: fractionForRisk })\n 264→  if (risk === 'unknown' && (remaining_mtok === 0 || remaining_usd === 0)) {\n 265→    risk = 'exhausted'\n 266→    risk_basis = 'none'\n 267→  }\n 268→\n 269→  if (tasks_left !== null && tasks_left < 0) tasks_left = 0\n 270→  if (tasks_left_assumed !== null && tasks_left_assumed < 0) tasks_left_assumed = 0\n 271→\n 272→  let cv = null\n 273→  if (tasks_left !== null) cv = coefficientOfVariation(tasks_left_basis === 'usd' ? costSeries : tokenSeries)\n 274→  const confidence = confidenceFor(sampleList.length, cv)\n 275→\n 276→  const known = remaining_mtok !== null || remaining_fraction !== null || remaining_usd !== null\n 277→  const status = known ? 'known' : 'unknown'\n 278→  if (!known) {\n 279→    risk = 'unknown'\n 280→    risk_basis = 'none'\n 281→  }\n 282→\n 283→  let reason = null\n 284→  if (!known) {\n 285→    reason = quotaReason ?? 'capacity_unknown'\n 286→  } else if (tasks_left === null) {\n 287→    const onlyUsd = remaining_mtok === null && remaining_fraction === null && remaining_usd !== null\n 288→    reason = onlyUsd ? 'usd_samples_missing' : 'no_samples'\n 289→  }\n 290→\n 291→  let burn_mtok_per_hour = null\n 292→  let eta_exhaust_at = null\n 293→  let exhausts_before_reset = null\n 294→  let poolDetails = []\n 295→\n 296→  if (evaluated && evaluated[model]) {\n 297→    poolDetails = evaluated[model].pools\n 298→    if (status === 'known') {\n 299→      let pick = null\n 300→      for (const item of poolDetails) {\n 301→        if (item.remaining_mtok === null) continue\n 302→        if (pick === null || item.remaining_mtok < pick.remaining_mtok) pick = item\n 303→      }\n 304→      if (pick) {\n 305→        const startMs = effectiveWindowStart(poolList, pick, nowMs)\n 306→        if (startMs !== null) {\n 307→          burn_mtok_per_hour = burnMtokPerHour({\n 308→            used_mtok: pick.used_mtok,\n 309→            hours_since_window_start: (nowMs - startMs) / HOUR_MS,\n 310→          })\n 311→          const eta = etaExhaust({\n 312→            now: nowMs,\n 313→            remaining_mtok: pick.remaining_mtok,\n 314→            burn_mtok_per_hour,\n 315→            reset_at: pick.reset_at,\n 316→          })\n 317→          eta_exhaust_at = eta.eta_exhaust_at\n 318→          exhausts_before_reset = eta.exhausts_before_reset\n 319→        }\n 320→      }\n 321→    }\n 322→  }\n 323→\n 324→  const burn_per_task = costSeries.length > 0\n 325→    ? round3(costSeries.reduce((total, value) => total + value, 0) / costSeries.length)\n 326→    : null\n 327→\n 328→  return {\n 329→    schema: 'cliworker.forecast/v1',\n 330→    status,\n 331→    model,\n 332→    remaining_mtok: remaining_mtok === null ? null : round3(remaining_mtok),\n 333→    remaining_fraction: remaining_fraction === null ? null : round3(remaining_fraction),\n 334→    pools: poolDetails.map((item) => ({\n 335→      pool_id: item.pool_id,\n 336→      remaining_mtok: item.remaining_mtok,\n 337→      remaining_fraction: item.remaining_fraction,\n 338→      reset_at: item.reset_at,\n 339→      reset_in_h: item.reset_in_h,\n 340→      reset_source: item.reset_source,\n 341→    })),\n 342→    tokens_per_task,\n 343→    tasks_left,\n 344→    tasks_left_basis,\n 345→    tasks_left_assumed,\n 346→    burn_mtok_per_hour,\n 347→   