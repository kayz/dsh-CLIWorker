catch {\n 399→    return false\n 400→  }\n 401→  if (stat.isDirectory()) {\n 402→    const entries = fs.readdirSync(full, { withFileTypes: true }).sort((a, b) => byCodePoint(a.name, b.name))\n 403→    for (const entry of entries) {\n 404→      const child = path.join(full, entry.name)\n 405→      if (entry.isDirectory()) collectFiles(child, anchor, found, seen)\n 406→      else if (entry.isFile() && SOURCE_EXT.test(entry.name)) collectFiles(child, anchor, found, seen)\n 407→    }\n 408→    return true\n 409→  }\n 410→  if (!stat.isFile()) return true\n 411→  const absolute = path.resolve(full)\n 412→  if (seen.has(absolute)) return true\n 413→  seen.add(absolute)\n 414→  found.push({ rel: toPosix(path.relative(anchor, absolute)), full: absolute })\n 415→  return true\n 416→}\n 417→\n 418→/** Scans the given paths (relative to `root`, defaulting to `lib`) and returns `{ files, items }`. */\n 419→export function scanPaths(paths, { root = REPO_ROOT } = {}) {\n 420→  const base = path.resolve(root)\n 421→  const list = Array.isArray(paths) && paths.length > 0 ? paths : ['lib']\n 422→  const found = []\n 423→  const seen = new Set()\n 424→\n 425→  for (const rel of list) {\n 426→    const full = path.resolve(base, rel)\n 427→    let stat\n 428→    try {\n 429→      stat = fs.statSync(full)\n 430→    } catch {\n 431→      const error = new Error(`no such file or directory: ${rel}`)\n 432→      error.code = 'ENOENT'\n 433→      throw error\n 434→    }\n 435→    const anchor = stat.isDirectory() ? full : path.dirname(full)\n 436→    collectFiles(full, anchor, found, seen)\n 437→  }\n 438→\n 439→  found.sort((a, b) => byCodePoint(a.rel, b.rel))\n 440→  const items = []\n 441→  for (const file of found) {\n 442→    let source = ''\n 443→    try {\n 444→      source = fs.readFileSync(file.full, 'utf8')\n 445→    } catch {\n 446→      continue\n 447→    }\n 448→    for (const item of scanSource(source)) {\n 449→      items.push({ file: file.rel, line: item.line, kind: item.kind