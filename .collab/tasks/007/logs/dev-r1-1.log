{"type":"user","uuid":"01a1b80c-5fa5-7aa9-b46d-2e07686e831f","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_E82RKgd8rcdYdxjHjCPK5376","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→import os from 'node:os'\n   5→import path from 'node:path'\n   6→import { selectModels, listModels } from '../../lib/select.mjs'\n   7→import { forecast, estimateCost } from '../../lib/forecast.mjs'\n   8→\n   9→function config() {\n  10→  return {\n  11→    providers: {\n  12→      claude: { cli: 'claude', adapter: 'claude', readonly: true },\n  13→      codebuddy: { cli: 'codebuddy', adapter: 'codebuddy', readonly: true },\n  14→      codex: { cli: 'codex', adapter: 'codex', readonly: true },\n  15→    },\n  16→    models: {\n  17→      a: { provider: 'claude', id: 'a', tier: 'top', identity: 'verified', identity_group: 'a', vendor: 'anthropic', prices: { input_per_mtok: 10, output_per_mtok: 20 } },\n  18→      b: { provider: 'codebuddy', id: 'b', tier: 'top', identity: 'verified', identity_group: 'b', vendor: 'tencent', prices: { input_per_mtok: 0, output_per_mtok: 0 } },\n  19→      old: { provider: 'codebuddy', id: 'old', tier: 'top', identity: 'verified', identity_group: 'old', vendor: 'tencent', deprecated: true },\n  20→      unverified: { provider: 'codex', id: 'u', tier: 'top', identity: 'unverified', identity_group: 'u', vendor: 'openai' },\n  21→    },\n  22→    quotas: {},\n  23→  }\n  24→}\n  25→\n  26→test('deprecated and unverified models never enter candidates', () => {\n  27→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  28→  const r = selectModels(config(), { level: 'Top', count: 3 }, { status })\n  29→  assert.deepEqual(r.models.map((m) => m.key).sort(), ['a', 'b'])\n  30→  assert.ok(r.rejected.some((x) => x.key === 'old' && /availability/.test(x.reason)))\n  31→  assert.ok(r.rejected.some((x) => x.key === 'unverified' && x.reason === 'identity_unverified'))\n  32→})\n  33→\n  34→test('read-only requirement rejects providers without it', () => {\n  35→  const c = config()\n  36→  c.models.b.readonly = false\n  37→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  38→  const r = selectModels(c, { level: 'Top', count: 3, require_readonly: true }, { status })\n  39→  assert.deepEqual(r.models.map((m) => m.key), ['a'])\n  40→  assert.ok(r.rejected.some((x) => x.key === 'b' && x.reason === 'readonly_unavailable'))\n  41→})\n  42→\n  43→test('forecast is unknown without samples and deterministic with fixed samples', () => {\n  44→  assert.equal(forecast({ records: [], model: 'a' }).status, 'unknown')\n  45→  const now = Date.parse('2026-11-07T00:00:00Z')\n  46→  const records = [\n  47→    { model: 'a', at: '2026-11-06T23:00:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n  48→    { model: 'a', at: '2026-11-06T23:30:00Z', input_tokens: 1_000_000, output_tokens: 0, cost_usd: 10 },\n  49→  ]\n  50→  const f = forecast({ records, model: 'a', now, quota: { remaining_usd: 100 } })\n  51→  assert.equal(f.status, 'known')\n  52→  assert.equal(f.burn_per_task, 10)\n  53→  assert.equal(f.tasks_left, 10)\n  54→  assert.equal(f.risk, 'ok')\n  55→  assert.equal(estimateCost({ input_tokens: 1_000_000, output_tokens: 0, prices: { input_per_mtok: 10, output_per_mtok: 20 } }), 10)\n  56→})\n  57→\n  58→test('models list hides deprecated by default, includes with flag', () => {\n  59→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  60→  const a = listModels(config(), { status })\n  61→  assert.ok(!a.some((m) => m.key === 'old'))\n  62→  const b = listModels(config(), { status, includeDeprecated: true })\n  63→  assert.ok(b.some((m) => m.key === 'old' && m.deprecated))\n  64→})\n  65→\n  66→\n  67→test('requests return CLI calls and honor level/usage/count', () => {\n  68→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  69→  const c = config()\n  70→  c.models.a.level = 'Top'; c.models.b.level = 'Top'; c.models.old.level = 'Top'; c.models.unverified.level = 'High'\n  71→  const r = selectModels(c, { level: 'Top', count: 2, usage: 'Heavy' }, { status })\n  72→  assert.equal(r.ok, true)\n  73→  assert.equal(r.level, 'Top')\n  74→  assert.equal(r.calls.length, 2)\n  75→  assert.ok(r.calls.every((x) => x.command && Array.isArray(x.args) && x.input === 'stdin'))\n  76→  assert.equal(r.calls[0].cwd, '<workspace>')\n  77→})\n  78→\n  79→test('missing level is rejected and no model is returned', () => {\n  80→  const status = { claude: { state: 'callable' }, codebuddy: { state: 'callable' }, codex: { state: 'callable' } }\n  81→  const r = selectModels(config(), { count: 2 }, { status })\n  82→  assert.equal(r.ok, false)\n  83→  assert.equal(r.reason, 'E_LEVEL_REQUIRED')\n  84→  assert.deepEqual(r.models, [])\n  85→})\n  86→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c54ad7ecd8b5f726007245167","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c54ad7ecd8b5f726007245167","codebuddy.ai/llmMessageId":"01a1b80c54ad7ecd8b5f726007245167","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_id=01a1b80c-10a1-714c-94fe-186218e3e224,codebuddy.conversation_request_id=01a1b80c14647279947af18522731dd8"},"__timestamp":"2026-11-07T22:06:21.093Z"}
{"type":"user","uuid":"01a1b80c-5fa8-7ad6-9ea5-90598d4e975d","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_VWO605rx8Mml73NGR0Jp9101","content":[{"type":"text","text":"   1→// Pure quota-pool arithmetic: quota shape normalization, pooled remaining capacity, reset\n   2→// resolution and three decimal rounding. Every time value is an explicit millisecond number;\n   3→// this module never reads a wall clock, never schedules work and never touches IO.\n   4→\n   5→const DEFAULT_CACHE_READ_WEIGHT = 0\n   6→const DEFAULT_READING_TTL_S = 600\n   7→const HOUR_MS = 3_600_000\n   8→\n   9→function finiteNumber(value) {\n  10→  if (typeof value === 'number') return Number.isFinite(value) ? value : null\n  11→  if (typeof value === 'string' && value.trim() !== '') {\n  12→    const parsed = Number(value)\n  13→    return Number.isFinite(parsed) ? parsed : null\n  14→  }\n  15→  return null\n  16→}\n  17→\n  18→function timeMs(value) {\n  19→  if (typeof value === 'number') return Number.isFinite(value) ? value : null\n  20→  if (typeof value === 'string' && value.trim() !== '') {\n  21→    const parsed = Date.parse(value)\n  22→    return Number.isFinite(parsed) ? parsed : null\n  23→  }\n  24→  return null\n  25→}\n  26→\n  27→function isoOrNull(ms) {\n  28→  return ms === null ? null : new Date(ms).toISOString()\n  29→}\n  30→\n  31→function requireNow(now) {\n  32→  if (!Number.isFinite(now)) throw new TypeError('now must be a finite millisecond timestamp')\n  33→  return now\n  34→}\n  35→\n  36→function clamp01(value) {\n  37→  if (value < 0) return 0\n  38→  if (value > 1) return 1\n  39→  return value\n  40→}\n  41→\n  42→/** Round half away from zero to three decimals; `-0` becomes `0`; non-finite passes through. */\n  43→export function round3(value) {\n  44→  const number = Number(value)\n  45→  if (!Number.isFinite(number)) return value\n  46→  const magnitude = Number((Math.abs(number) * 1000).toPrecision(15))\n  47→  const rounded = Math.round(magnitude) / 1000\n  48→  const signed = number < 0 ? -rounded : rounded\n  49→  return signed + 0\n  50→}\n  51→\n  52→/** Billed tokens of one ledger row, weighting cache reads by `cache_read_weight`. */\n  53→export function billedTokens(row, cache_read_weight = DEFAULT_CACHE_READ_WEIGHT) {\n  54→  if (!row || typeof row !== 'object') return 0\n  55→  if (typeof row.tokens === 'number' && Number.isFinite(row.tokens)) return row.tokens\n  56→  const weight = finiteNumber(cache_read_weight)\n  57→  const w = weight === null ? DEFAULT_CACHE_READ_WEIGHT : weight\n  58→  const input = finiteNumber(row.input_tokens) ?? 0\n  59→  const output = finiteNumber(row.output_tokens) ?? 0\n  60→  const written = finiteNumber(row.cache_write_tokens) ?? 0\n  61→  const read = finiteNumber(row.cache_read_tokens) ?? 0\n  62→  return input + output + written + w * read\n  63→}\n  64→\n  65→/**\n  66→ * Normalizes the four legacy quota shapes. Fields are computed independently; missing parts are\n  67→ * null. `reason` is only set when nothing usable could be read.\n  68→ */\n  69→export function normalizeQuota(quota) {\n  70→  const source = quota && typeof quota === 'object' ? quota : {}\n  71→  let remaining_fraction = null\n  72→  let remaining_mtok = null\n  73→  let remaining_usd = null\n  74→  let reason = null\n  75→\n  76→  const percent = finiteNumber(source.remaining_pct)\n  77→  if (percent !== null) remaining_fraction = clamp01(percent / 100)\n  78→\n  79→  const remaining = finiteNumber(source.remaining)\n  80→  const unit = typeof source.unit === 'string' ? source.unit : null\n  81→  if (remaining !== null && unit === 'credits') {\n  82→    const rate = finiteNumber(source.credits_per_mtok)\n  83→    if (rate !== null && rate > 0) remaining_mtok = remaining / rate\n  84→    else if (remaining === 0) remaining_mtok = 0\n  85→    else reason = 'credits_conversion_missing'\n  86→  } else if (remaining !== null && unit === 'tokens') {\n  87→    remaining_mtok = remaining / 1e6\n  88→  }\n  89→\n  90→  const usd = finiteNumber(source.remaining_usd)\n  91→  if (usd !== null) remaining_usd = usd\n  92→\n  93→  const anyValue = remaining_fraction !== null || remaining_mtok !== null || remaining_usd !== null\n  94→  if (!anyValue && reason === null) reason = 'capacity_unknown'\n  95→\n  96→  return { remaining_fraction, remaining_mtok, remaining_usd, reason }\n  97→}\n  98→\n  99→/**\n 100→ * Reset time priority: cli > config > estimated rolling window > unknown.\n 101→ * Returns the ISO form of the resolved instant and where it came from.\n 102→ */\n 103→export function resolveResetAt({ cli = null, config = null, window = null, rows = [], now } = {}) {\n 104→  const nowMs = requireNow(now)\n 105→\n 106→  const cliMs = timeMs(cli)\n 107→  if (cliMs !== null) return { reset_at: isoOrNull(cliMs), reset_source: 'cli' }\n 108→\n 109→  const configMs = timeMs(config)\n 110→  if (configMs !== null) return { reset_at: isoOrNull(configMs), reset_source: 'config' }\n 111→\n 112→  const win = window && typeof window === 'object' ? window : null\n 113→  const lengthS = win ? finiteNumber(win.length_s) : null\n 114→  if (win && win.anchor === 'rolling' && lengthS !== null && lengthS > 0) {\n 115→    const lower = nowMs - lengthS * 1000\n 116→    let earliest = null\n 117→    for (const row of Array.isArray(rows) ? rows : []) {\n 118→      const at = timeMs(row && row.at)\n 119→      if (at === null) continue\n 120→      if (at > lower && at <= nowMs && (earliest === null || at < earliest)) earliest = at\n 121→    }\n 122→    if (earliest !== null) return { reset_at: isoOrNull(earliest + lengthS * 1000), reset_source: 'estimated' }\n 123→  }\n 124→\n 125→  return { reset_at: null, reset_source: 'unknown' }\n 126→}\n 127→\n 128→function capacityFor(pool, model) {\n 129→  const map = pool && pool.capacity_mtok && typeof pool.capacity_mtok === 'object' ? pool.capacity_mtok : null\n 130→  if (!map) return null\n 131→  const raw = map[model]\n 132→  if (raw && typeof raw === 'object') return finiteNumber(raw.value)\n 133→  return finiteNumber(raw)\n 134→}\n 135→\n 136→function readingFor(pool) {\n 137→  if (pool && pool.reading && typeof pool.reading === 'object') {\n 138→    const value = finiteNumber(pool.reading.value)\n 139→    const at = timeMs(pool.reading.at)\n 140→    if (value !== null && at !== null) return { value, at }\n 141→    return null\n 142→  }\n 143→  if (pool && pool.used_fraction && typeof pool.used_fraction === 'object') {\n 144→    const value = finiteNumber(pool.used_fraction.value)\n 145→    const at = timeMs(pool.used_fraction.at)\n 146→    if (value !== null && at !== null) return { value, at }\n 147→  }\n 148→  return null\n 149→}\n 150→\n 151→function resetCandidates(pool) {\n 152→  const win = pool && pool.window && typeof pool.window === 'object' ? pool.window : null\n 153→  if (!win) return { window: null, cli: null, config: null }\n 154→  const source = win.reset_source ?? null\n 155→  if (source === 'cli') return { window: win, cli: win.reset_at ?? null, config: null }\n 156→  if (source === 'config' || source === null) return { window: win, cli: null, config: win.reset_at ?? null }\n 157→  return { window: win, cli: null, config: null }\n 158→}\n 159→\n 160→function poolState(pool, rows, nowMs, ttlMs, cacheReadWeight) {\n 161→  const candidates = resetCandidates(pool)\n 162→  const resolved = resolveResetAt({\n 163→    cli: candidates.cli,\n 164→    config: candidates.config,\n 165→    window: candidates.window,\n 166→    rows,\n 167→    now: nowMs,\n 168→  })\n 169→  const resetMs = timeMs(resolved.reset_at)\n 170→  const crossed = resetMs !== null && nowMs >= resetMs\n 171→  const cliReset = crossed && resolved.reset_source === 'cli'\n 172→  const recheck = crossed && resolved.reset_source !== 'cli'\n 173→  const windowStart = candidates.window ? timeMs(candidates.window.start_at) : null\n 174→  const startMs = cliReset ? resetMs : windowStart\n 175→\n 176→  const reading = readingFor(pool)\n 177→  const readingUsable = reading !== null\n 178→    && !(cliReset && reading.at < resetMs)\n 179→    && nowMs - reading.at <= ttlMs\n 180→\n 181→  let used = null\n 182→  let reason = null\n 183→  const contributing = []\n 184→\n 185→  if (readingUsable) {\n 186→    used = reading.value\n 187→    for (const row of rows) {\n 188→      const at = timeMs(row && row.at)\n 189→      if (at === null || at <= reading.at || at > nowMs) continue\n 190→      contributing.push(row)\n 191→    }\n 192→  } else {\n 193→    const relevant = []\n 194→    for (const row of rows) {\n 195→      const at = timeMs(row && row.at)\n 196→      if (at === null || at > nowMs) continue\n 197→      if (startMs !== null && at < startMs) continue\n 198→      relevant.push(row)\n 199→    }\n 200→    if (startMs === null && relevant.length > 0) {\n 201→      reason = 'window_unknown'\n 202→    } else {\n 203→      used = 0\n 204→      for (const row of relevant) contributing.push(row)\n 205→    }\n 206→  }\n 207→\n 208→  if (reason === null) {\n 209→    for (const row of contributing) {\n 210→      const capacity = capacityFor(pool, row.model)\n 211→      if (capacity === null || capacity <= 0) {\n 212→        reason = 'ledger_capacity_unknown'\n 213→        break\n 214→      }\n 215→      used += billedTokens(row, cacheReadWeight) / (capacity * 1e6)\n 216→    }\n 217→  }\n 218→\n 219→  return {\n 220→    used: reason === null && used !== null ? clamp01(used) : null,\n 221→    reason,\n 222→    startMs,\n 223→    resetMs,\n 224→    resetAt: resolved.reset_at,\n 225→    resetSource: resolved.reset_source,\n 226→    recheck,\n 227→  }\n 228→}\n 229→\n 230→function poolDetail(pool, state, capacity, nowMs) {\n 231→  const known = state.used !== null\n 232→  const remainingFraction = known ? 1 - state.used : null\n 233→  return {\n 234→    pool_id: typeof pool.id === 'string' ? pool.id : String(pool.id ?? ''),\n 235→    remaining_mtok: known ? round3(capacity * remainingFraction) : null,\n 236→    remaining_fraction: known ? round3(remainingFraction) : null,\n 237→    used_fraction: known ? state.used : null,\n 238→    used_mtok: known ? capacity * state.used : null,\n 239→    reset_at: state.resetAt,\n 240→    reset_in_h: state.resetMs === null ? null : Math.max(0, round3((state.resetMs - nowMs) / HOUR_MS)),\n 241→    reset_source: state.resetSource,\n 242→    recheck: state.recheck,\n 243→  }\n 244→}\n 245→\n 246→function modelResult(members, nowMs) {\n 247→  if (members.length === 0) {\n 248→    return { status: 'unknown', remaining_mtok: null, remaining_fraction: null, reason: 'capacity_unknown', pools: [] }\n 249→  }\n 250→\n 251→  const details = members.map((member) => poolDetail(member.pool, member.state, member.capacity, nowMs))\n 252→  const unknown = members.find((member) => member.state.used === null)\n 253→  if (unknown) {\n 254→    return {\n 255→      status: 'unknown',\n 256→      remaining_mtok: null,\n 257→      remaining_fraction: null,\n 258→      reason: unknown.state.reason ?? 'capacity_unknown',\n 259→      pools: details,\n 260→    }\n 261→  }\n 262→\n 263→  const remaining = members.map((member) => member.capacity * (1 - member.state.used))\n 264→  const fractions = members.map((member) => 1 - member.state.used)\n 265→  return {\n 266→    status: 'known',\n 267→    remaining_mtok: round3(Math.min(...remaining)),\n 268→    remaining_fraction: round3(Math.min(...fractions)),\n 269→    reason: null,\n 270→    pools: details,\n 271→  }\n 272→}\n 273→\n 274→/** Per-model pool evaluation; the `pools` array keeps the spec detail shape. */\n 275→export function evaluatePools({\n 276→  models = [],\n 277→  pools = [],\n 278→  rows = [],\n 279→  now,\n 280→  reading_ttl_s = DEFAULT_READING_TTL_S,\n 281→  cache_read_weight = DEFAULT_CACHE_READ_WEIGHT,\n 282→} = {}) {\n 283→  const nowMs = requireNow(now)\n 284→  const ttl = finiteNumber(reading_ttl_s)\n 285→  const ttlMs = (ttl === null ? DEFAULT_READING_TTL_S : ttl) * 1000\n 286→  const poolList = Array.isArray(pools) ? pools : []\n 287→  const rowList = Array.isArray(rows) ? rows : []\n 288→  const modelList = Array.isArray(models) ? models : []\n 289→\n 290→  const states = poolList.map((pool) => poolState(pool, rowList, nowMs, ttlMs, cache_read_weight))\n 291→\n 292→  const evaluated = {}\n 293→  for (const model of modelList) {\n 294→    const members = []\n 295→    for (let index = 0; index < poolList.length; index += 1) {\n 296→      const capacity = capacityFor(poolList[index], model)\n 297→      if (capacity === null) continue\n 298→      members.push({ pool: poolList[index], state: states[index], capacity })\n 299→    }\n 300→    evaluated[model] = modelResult(members, nowMs)\n 301→  }\n 302→  return evaluated\n 303→}\n 304→\n 305→/** Projection used by the golden fixtures: status, remaining and reason only. */\n 306→export function remainingForModels({\n 307→  models = [],\n 308→  pools = [],\n 309→  rows = [],\n 310→  now,\n 311→  reading_ttl_s = DEFAULT_READING_TTL_S,\n 312→  cache_read_weight = DEFAULT_CACHE_READ_WEIGHT,\n 313→} = {}) {\n 314→  const evaluated = evaluatePools({ models, pools, rows, now, reading_ttl_s, cache_read_weight })\n 315→  const projected = {}\n 316→  for (const model of Object.keys(evaluated)) {\n 317→    const item = evaluated[model]\n 318→    projected[model] = { status: item.status, remaining_mtok: item.remaining_mtok, reason: item.reason }\n 319→  }\n 320→  return projected\n 321→}\n 322→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c54ad7ecd8b5f726007245167","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c54ad7ecd8b5f726007245167","codebuddy.ai/llmMessageId":"01a1b80c54ad7ecd8b5f726007245167","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_i