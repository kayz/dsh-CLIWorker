{"type":"user","uuid":"01a1b80c-9a1a-7bc8-999c-850f23c603e7","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_P82qoeHaCflFQgAJaA6P3595","content":[{"type":"text","text":"Stdout: import { providerStatus } from '../../availability.mjs'\nimport { selectModels } from '../../select.mjs'\nimport { readUsage } from '../../config.mjs'\nimport { arg, usageFile } from '../_util.mjs'\n\nexport async function run({ argv, ctx, config }) {\n  let req = {}\n  const raw = arg(argv, '--request')\n  if (raw) {\n    try { req = JSON.parse(raw) } catch (e) { throw new Error(`bad --request JSON: ${e.message}`) }\n  }\n  const status = providerStatus(config, { ctx })\n  return selectModels(config, req, { status, usage: readUsage(usageFile(config, ctx), ctx) })\n}\n----\n  }\n\n  try {\n    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\n    hostCtx.inject(['webServer'], (httpCtx) => {\n      route(httpCtx, '/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c, { ctx }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n      route(httpCtx, '/cliworker/models', 'cliworker: models', async (_req, res) => {\n        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c, { ctx }), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n      route(httpCtx, '/cliworker/select', 'cliworker: select', async (req, res) => {\n        try {\n          const c = getConfig()\n          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n          const request = body.request || body\n          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c, { ctx }) }) })\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n      })\n      route(httpCtx, '/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n        try {\n          const c = getConfig()\n          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null, now: ctx.now() }) })\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n    })\n  } catch (e) {\n    fail(null, e)\n  }\n\n  return { registered, errors }\n}\n\nexport function getRegistration() {\n  if (!report) return { status: 'failed', registered: [], errors: [{ path: null, message: 'plugin not applied' }] }\n----\n#!/usr/bin/env node\r\n// Self-test for the test discovery rules: proves the runner notices drift, that a filtered\r\n// manifest cannot stand in for a full one, and that decoys and orphans are handled correctly.\r\nimport fs from 'node:fs'\r\nimport os from 'node:os'\r\nimport path from 'node:path'\r\nimport { spawnSync } from 'node:child_process'\r\nimport { fileURLToPath } from 'node:url'\r\n\r\nimport { enumerateTestFiles, findOrphans, verifyFullRun } from './run-tests.mjs'\r\n\r\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\r\nconst REPO_ROOT = path.resolve(HERE, '..')\r\nconst RUN_TESTS = path.join(HERE, 'run-tests.mjs')\r\nconst FIXTURES = path.join(REPO_ROOT, 'test', 'fixtures', 'discovery-selftest')\r\nconst EXCLUDED_PREFIXES = ['test/fixtures/', 'test/helpers/', 'test/perf/']\r\n\r\nfunction printErrors(errors) {\r\n  for (const error of errors) {\r\n    process.stdout.write(`FAIL ${error.id} ${error.path ?? ''}`.trimEnd() + '\\n')\r\n  }\r\n}\r\n\r\nfunction checkRoot(root, manifestPath) {\r\n  const errors = findOrphans(root).map((file) => ({ id: 'discovery.orphan', path: file }))\r\n  if (manifestPath) {\r\n    let manifest = null\r\n    try {\r\n      manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\r\n    } catch {\r\n      manifest = null\r\n    }\r\n    const verification = verifyFullRun({ enumerated: enumerateTestFiles(root), manifest })\r\n    errors.push(...verification.errors)\r\n  }\r\n  printErrors(errors)\r\n  if (errors.length > 0) {\r\n    process.exitCode = 1\r\n    return\r\n  }\r\n  process.stdout.write('check-test-discovery: ok\\n')\r\n}\r\n\r\nfunction runRunner(root) {\r\n  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\r\n  const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\r\n    encoding: 'utf8',\r\n  })\r\n  const manifestPath = path.join(outDir, 'files-executed.json')\r\n  let manifest = null\r\n----\n{\r\n  \"name\": \"dsh-cliworker\",\r\n  \"version\": \"0.1.0\",\r\n  \"description\": \"DSH plugin: independent CLI/model layer for AgentLine (providers, models, availability, cost, selection).\",\r\n  \"type\": \"module\",\r\n  \"main\": \"lib/index.js\",\r\n  \"exports\": {\r\n    \".\": \"./lib/index.js\",\r\n    \"./package.json\": \"./package.json\"\r\n  },\r\n  \"scripts\": {\r\n    \"test\": \"node scripts/run-tests.mjs\",\r\n    \"check\": \"node scripts/check-fast.mjs\",\r\n    \"perf\": \"node scripts/run-tests.mjs --perf\",\r\n    \"snapshot:update\": \"node scripts/run-tests.mjs --update-snapshots\"\r\n  },\r\n  \"dsh\": {\r\n    \"bundle\": {\r\n      \"patch\": \"./cordis.patch.yml\"\r\n    }\r\n  },\r\n  \"files\": [\r\n    \"lib\",\r\n    \"cordis.patch.yml\",\r\n    \"dsh.plugin.json\",\r\n    \"README.md\"\r\n  ],\r\n  \"engines\": {\r\n    \"node\": \">=20\"\r\n  },\r\n  \"license\": \"MIT\"\r\n}\r\n\nStderr: (empty)\nExit Code: 0\nSignal: (none)"}],"is_error":false,"_meta":{"rawResponse":{"exitCode":0,"signal":null,"interrupted":false,"sandboxDenied":false,"stderrBytesTruncated":0,"stdoutBytesTruncated":0,"tool_error_code":"0"},"renderer":{"type":"text","value":"import { providerStatus } from '../../availability.mjs'\nimport { selectModels } from '../../select.mjs'\nimport { readUsage } from '../../config.mjs'\nimport { arg, usageFile } from '../_util.mjs'\n\nexport async function run({ argv, ctx, config }) {\n  let req = {}\n  const raw = arg(argv, '--request')\n  if (raw) {\n    try { req = JSON.parse(raw) } catch (e) { throw new Error(`bad --request JSON: ${e.message}`) }\n  }\n  const status = providerStatus(config, { ctx })\n  return selectModels(config, req, { status, usage: readUsage(usageFile(config, ctx), ctx) })\n}\n----\n  }\n\n  try {\n    if (!hostCtx || typeof hostCtx.inject !== 'function') throw new Error('host context has no inject()')\n    hostCtx.inject(['webServer'], (httpCtx) => {\n      route(httpCtx, '/cliworker/providers', 'cliworker: providers', async (_req, res) => {\n        try { const c = getConfig(); send(res, { ok: true, providers: providerStatus(c, { ctx }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n      route(httpCtx, '/cliworker/models', 'cliworker: models', async (_req, res) => {\n        try { const c = getConfig(); send(res, { ok: true, models: listModels(c, { status: providerStatus(c, { ctx }), includeDeprecated: false }) }) } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n      route(httpCtx, '/cliworker/select', 'cliworker: select', async (req, res) => {\n        try {\n          const c = getConfig()\n          const body = req.method === 'GET' ? { request: JSON.parse(new URL(req.url || '/', 'http://local').searchParams.get('request') || '{}') } : await readBody(req)\n          const request = body.request || body\n          send(res, { ok: true, ...selectModels(c, request, { status: providerStatus(c, { ctx }) }) })\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 400) }\n      })\n      route(httpCtx, '/cliworker/forecast', 'cliworker: forecast', async (req, res) => {\n        try {\n          const c = getConfig()\n          const model = new URL(req.url || '/', 'http://local').searchParams.get('model')\n          send(res, { ok: true, forecast: forecast({ model, prices: model ? c.models[model]?.prices : undefined, quota: model ? c.quotas?.[c.models[model]?.provider] : null, now: ctx.now() }) })\n        } catch (e) { send(res, { ok: false, error: String(e.message || e) }, 500) }\n      })\n    })\n  } catch (e) {\n    fail(null, e)\n  }\n\n  return { registered, errors }\n}\n\nexport function getRegistration() {\n  if (!report) return { status: 'failed', registered: [], errors: [{ path: null, message: 'plugin not applied' }] }\n----\n#!/usr/bin/env node\n// Self-test for the test discovery rules: proves the runner notices drift, that a filtered\n// manifest cannot stand in for a full one, and that decoys and orphans are handled correctly.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { spawnSync } from 'node:child_process'\nimport { fileURLToPath } from 'node:url'\n\nimport { enumerateTestFiles, findOrphans, verifyFullRun } from './run-tests.mjs'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nconst REPO_ROOT = path.resolve(HERE, '..')\nconst RUN_TESTS = path.join(HERE, 'run-tests.mjs')\nconst FIXTURES = path.join(REPO_ROOT, 'test', 'fixtures', 'discovery-selftest')\nconst EXCLUDED_PREFIXES = ['test/fixtures/', 'test/helpers/', 'test/perf/']\n\nfunction printErrors(errors) {\n  for (const error of errors) {\n    process.stdout.write(`FAIL ${error.id} ${error.path ?? ''}`.trimEnd() + '\\n')\n  }\n}\n\nfunction checkRoot(root, manifestPath) {\n  const errors = findOrphans(root).map((file) => ({ id: 'discovery.orphan', path: file }))\n  if (manifestPath) {\n    let manifest = null\n    try {\n      manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))\n    } catch {\n      manifest = null\n    }\n    const verification = verifyFullRun({ enumerated: enumerateTestFiles(root), manifest })\n    errors.push(...verification.errors)\n  }\n  printErrors(errors)\n  if (errors.length > 0) {\n    process.exitCode = 1\n    return\n  }\n  process.stdout.write('check-test-discovery: ok\\n')\n}\n\nfunction runRunner(root) {\n  const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cliworker-discovery-'))\n  const result = spawnSync(process.execPath, [RUN_TESTS, '--root', root, '--out-dir', outDir], {\n    encoding: 'utf8',\n  })\n  const manifestPath = path.join(outDir, 'files-executed.json')\n  let manifest = null\n----\n{\n  \"name\": \"dsh-cliworker\",\n  \"version\": \"0.1.0\",\n  \"description\": \"DSH plugin: independent CLI/model layer for AgentLine (providers, models, availability, cost, selection).\",\n  \"type\": \"module\",\n  \"main\": \"lib/index.js\",\n  \"exports\": {\n    \".\": \"./lib/index.js\",\n    \"./package.json\": \"./package.json\"\n  },\n  \"scripts\": {\n    \"test\": \"node scripts/run-tests.mjs\",\n    \"check\": \"node scripts/check-fast.mjs\",\n    \"perf\": \"node scripts/run-tests.mjs --perf\",\n    \"snapshot:update\": \"node scripts/run-tests.mjs --update-snapshots\"\n  },\n  \"dsh\": {\n    \"bundle\": {\n      \"patch\": \"./cordis.patch.yml\"\n    }\n  },\n  \"files\": [\n    \"lib\",\n    \"cordis.patch.yml\",\n    \"dsh.plugin.json\",\n    \"README.md\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}"}}}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c86da7549a1f9c08c7dd29af5","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c86da7549a1f9c08c7dd29af5","codebuddy.ai/llmMessageId":"01a1b80c86da7549a1f9c08c7dd29af5","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_id=01a1b80c-10a1-714c-94fe-186218e3e224,codebuddy.conversation_request_id=01a1b80c14647279947af18522731dd8"},"__timestamp":"2026-11-07T22:06:36.059Z"}
{"type":"assistant","uuid":"01a1b80c-9a22-728d-8c7a-3e55bad20d8e","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"id":"01a1b80c9a22728d8c7a3e532f308a92","content":[{"type":"thinking","thinking":"Now I need to plan the implementation carefully.\n\nKey correctness details:\n\n### lib/select-draft.mjs\n\nExports exactly: SELECTION_SCHEMA, HANDLE_SCHEMA, HEAVY_REJECT_RISKS, heavyRejection, draftHandle, draftSelection.\n\nA-09 asserts `Object.keys(m).sort().join(',')` = `HANDLE_SCHEMA,HEAVY_REJECT_RISKS,SELECTION_SCHEMA,draftHandle,draftSelection,heavyRejection`. Note that `Object.keys` of a module namespace object returns exports; sort order: capital letters come before lowercase in code point order, so HANDLE_SCHEMA, HEAVY_REJECT_RISKS, SELECTION_SCHEMA, draftHandle, draftSelection, heavyRejection. Good — exactly these 6 exports. So no extra exports allowed.\n\ndraftHandle({ model, call, forecast, quota, adapter }) returns handle with exactly keys: schema, key, provider, id, level, adapter, identity, identity_group, vendor, readonly, prices, quota, forecast, call.\n\n`model` is a listModels item. `adapter` provided by caller (config.providers[provider]?.adapter ?? null).\n\ndraftSelection({ request, level, usage, models, rejected, reason = null, count = 1 }) returns envelope keys exactly: schema, ok, request, level, usage, models, calls, rejected, reason, truncated. ok = models.length > 0; calls = models.map(x => x.call); truncated = models.length < count; reason: if models empty and caller didn't give → 'no_eligible_model', otherwise null when models present. Hmm \"reason 在 models 为空且调用方没给时为 'no_eligible_model'，有模型时为 null.\" So logic: if models.length > 0 → null. Else if reason given (non-null) → that reason. Else 'no_eligible_model'. Implementation:\n\n```js\nconst resolvedReason = models.length > 0 ? null : (reason == null ? 'no_eligible_model' : reason)\n```\n\nFor missing-level path: level: null, reason: 'E_LEVEL_REQUIRED', count: 0. Then truncated = 0 < 0 = false. Original baseline returned no `truncated` key at all in the missing-level path... but design says draftSelection returns key exactly truncated, and the missing-level path passes count: 0 → truncated false. Acceptance doesn't assert that. But test/unit/select.test.mjs just checks reason and models deep equal []. Fine. Hmm, but A-02 json etc not affected.\n\nWait — backward compat: does any existing test assert the exact keys of the selection envelope? Let's check stable.test.mjs — it imports v0.1 copy, not live. Others: test/unit/select.test.mjs checks fields. So adding `truncated: false` to missing-level envelope is fine? Hmm design says draftSelection returns keys exactly including truncated; and selectModels uses it for all paths. So yes.\n\nheavyRejection: usage === 'Heavy' && HEAVY_REJECT_RISKS.includes(forecast?.risk) → { key, reason: 'E_FORECAST_EXHAUSTION', forecast } else null.\n\n### lib/select.mjs\n\n- imports: `normalizePrices` from './forecast.mjs' (still needed by listModels), `buildForecast` from './forecast.mjs', `billedTokens` from './pools.mjs', `systemNow` from './context.mjs', and from './select-draft.mjs': SELECTION_SCHEMA, heavyRejection, draftHandle, draftSelection.\n\n- Remove isObject, remove `forecast` import.\n\n- SCHEMA: \"select.mjs 的 SCHEMA 常量改为从 select-draft.mjs 取值后重导出\" — `export const SCHEMA = SELECTION_SCHEMA`.\n\n- selectModels(config, request = {}, { status = {}, usage = [], ctx } = {}).\n\nMemoization: Map<modelKey, { quota, forecast }>. Build lazily.\n\n```js\nconst cache = new Map()\nlet nowMs = null\nconst currentNow = () => {\n  if (nowMs === null) nowMs = typeof ctx?.now === 'function' ? ctx.now() : systemNow()\n  return nowMs\n}\nconst forecastFn = typeof ctx?.forecast === 'function' ? ctx.forecast : defaultForecast\nconst forecastOf = (m) => {\n  const hit = cache.get(m.key)\n  if (hit) return hit\n  const quota = config.quotas?.[m.provider] ?? null\n  const value = {\n    quota,\n    forecast: forecastFn({ model: m.key, prices: m.prices, quota, records: usage, usage: usageKind, now: currentNow() }),\n  }\n  cache.set(m.key, value)\n  return value\n}\n```\n\nWait — `config.quotas?.[m.provider] ?? null` reads quota exactly once per model. In A-03 Proxy counts `p === 'claude'` reads: 12 models, each reads quotas.claude once → 12. But careful: Proxy `get` also triggers for `Symbol.toPrimitive` etc.? `config.quotas?.[m.provider]` — access on the `quotas` object with key 'claude'; the hook increments. Also `?.` on `config.quotas` itself reads config.quotas (property of config, not the proxy) — fine.\n\nBut: does anything else read config.quotas? We must not. draftHandle receives quota from forecastOf. Good.\n\nNote: quota computed in forecastOf before calling forecastFn — each exactly once.\n\nOnly models passing pre-filters enter forecastOf. Order: exclude, allowed, level, callable, identity, readonly, then heavy rejection.\n\nThe heavy rejection needs forecast before decide, and rejected entry includes forecast.\n\nNow important: for the default forecast, we need forecast args { model, quota, samples, usage, now }. Default fn:\n\n```js\nfunction defaultForecast({ model, quota, records, usage, now }) {\n  return buildForecast({ model, quota, samples: usageSamples(records, model), usage, now })\n}\n```\n\nusageSamples exported:\n\n```js\nexport function usageSamples(records = [], model) {\n  if (!Array.isArray(records)) return []\n  return records.filter((row) => row && row.model === model).map((row) => {\n    const mtok = billedTokens(row) / 1e6\n    return {\n      mtok: Number.isFinite(mtok) && mtok > 0 ? mtok : null,\n      cost_usd: typeof row.cost_usd === 'number' && Number.isFinite(row.cost_usd) ? row.cost_usd : null,\n    }\n  })\n}\n```\n\ndesign says: `cost_usd` = `row.cost_usd` 为有限数则取它，否则 `null`. \"为有限数\" — could be numeric string? Use Number.isFinite(row.cost_usd) (a number). Design test 6.1: \"cost_usd 非有限数时为 null\". Use Number.isFinite(row.cost_usd) ? row.cost_usd : null. Hmm but if cost_usd is a numeric string \"0.5\", Number.isFinite(\"0.5\") is false → null. Design says \"为有限数\" ambiguous, but finite number check is right.\n\n`mtok` = billedTokens(row)/1e6; if not >0 finite → null.\n\nCareful: A-21 check-unused scans lib and requires zero unused imports/functions. usageSamples is exported → not reported. defaultForecast is a top-level non-exported function used → fine.\n\nAlso `cliCall` unchanged. `vendorOf`, `levelOf` still used.\n\nRanking: use forecastOf. Note rank is called inside sort comparator many times, but forecastOf memoizes → no extra forecast calls. A-04's counter asserts seen.length===8 and unique 8.\n\nBut careful: after filtering, rank uses forecastOf(m) which is cached. Good.\n\nHandle construction via draftHandle({ model: m, call: cliCall(...), forecast: f, quota, adapter }). We need quota from forecastOf entry. So:\n\n```js\nconst picked = candidates.slice(0, count).map((m) => {\n  const entry = forecastOf(m)\n  return draftHandle({\n    model: m,\n    call: cliCall(config, m, request),\n    forecast: entry.forecast,\n    quota: entry.quota,\n    adapter: config.providers?.[m.provider]?.adapter ?? null,\n  })\n})\n```\n\nNote baseline used `config.providers[m.provider]?.adapter || null` — with `??` design says `config.providers[provider]?.adapter ?? null`. Fine.\n\nEnvelope:\n\n```js\nreturn draftSelection({ request, level, usage: usageKind, models: picked, rejected, count })\n```\n\nFor missing level:\n\n```js\nif (!level) return draftSelection({ request, level: null, usage: usageKind, models: [], rejected, reason: 'E_LEVEL_REQUIRED', count: 0 })\n```\n\ndraftSelection gives ok:false, calls: [], truncated: 0<0=false, reason 'E_LEVEL_REQUIRED'.\n\nHmm, baseline missing-level envelope lacked `truncated`. Any test? test/unit/select.test.mjs: reason E_LEVEL_REQUIRED, models []. OK.\n\n### A-08 nuance\n\nUses golden cases with expected.risk. For each case, a Quick model with separate provider, quotas[provider]=case.input.quota; ctx.forecast = buildForecast({quota: a.quota, samples: case.input.samples, usage: a.usage, now: 0}). Then Heavy count 10 — expect `h.rejected.length === want.length` (5 cases? let's count risky: q-pct-5 low_reserve, q-pct-4 critical, q-pct-0 exhausted, q-pct-15 ok, q-credits-no-rate unknown, q-credits-zero exhausted, q-credits-rate exhausted, q-tokens (risk undefined! expected.risk missing → filtered out by c.expected.risk), q-usd ok. So cases with risk: 8. bad ones: q-pct-5, q-pct-4, q-pct-0, q-credits-zero, q-credits-rate = 5 → want.length 5 ≥5 true. h.rejected must have length exactly 5: all models pass pre-filters (Quick, verified, callable, readonly? request.require_readonly not set → no check; identity verified). So only Heavy rejections in rejected. Good.\n\nNormal and Light: rejected.length must be 0.\n\nImportant: `count: 10`, 8 models, all fine.\n\nNote that the forecast injected uses `a.quota`, which comes from config.quotas[provider]. Since each model has its own provider with its own quota, memoization keyed by model works fine.\n\n### A-02\n\nhandle keys: `'cli' in h === false`, `'call' in h === true`, JSON.stringify(h.call) === JSON.stringify(r.calls[0]). draftSelection calls = models.map(x => x.call) → same object. Good.\n\nDefault forecast with no usage records: buildForecast({ model, quota: null, samples: [], usage: 'Normal', now }) → requires finite now. systemNow() from context uses Date.now (allowed there). should be fine.\n\n### check-seams\n\nselect.mjs must not contain `Date.now` or zero-arg `new Date`. We use systemNow only. Also check-seams scans lib only. select-draft.mjs pure.\n\nWait: check-seams `collectImportSpecifiers` — importing './context.mjs' is fine (no rule).\n\nBut hmm — `systemNow` in select.mjs: check-seams allows date_now only in lib/context.mjs; we don't call Date.now directly. Fine.\n\n### check-unused on lib\n\nMust report zero. That means select.mjs's imports all used, no unused top-level non-exported functions. lib/contract/validate.mjs `typeOf` removed.\n\nBut also check-unused scans the entire lib. Are there other unused imports/functions in lib? Design says expected only select.mjs isObject and validate typeOf. But our scanner is heuristic; need to check actual results after implementing.\n\nImportant subtlety: my scanner counts identifier occurrences with `.` prefix excluded. Potential false positives... e.g., an import used only as a member expression `fs.readFileSync` — preceded by '.', excluded → `fs` would be reported as unused! Wait: rule 4 says \"前一个字符是 `.`（含 `?.`）的不计\" — that applies to the *identifier occurrence* being counted: `fs.readFileSync` — `fs` at line start is preceded by whitespace, so it counts. `readFileSync` preceded by '.' → doesn't count as reference to import `readFileSync` if imported named. That's intended: if you import {readFileSync} and use `fs.readFileSync`, readFileSync isn't used. OK.\n\nBut what about `import fs from 'node:fs'` then using `fs.readFileSync` — `fs` occurrence preceded by newline/space → counted. Good.\n\nPotential false report in lib: some import used only inside a template literal `${...}`? We keep expressions. Good.\n\nAlso `export { X }` counts as reference. Some files may `export { foo }`.\n\nAlso default exports? `export default function name` not reported.\n\nOthers: identifier used only as object-shorthand `{ foo }` counted (good).\n\nAlso property access `obj.helper` won't count, e.g. `expect(...)`.\n\nPotential false positives in lib: an import used only in a `.mjs` type? Hmm.\n\nLet's just implement and run, then inspect reports.\n\n### check-unused requirements detail\n\n- CLI: `node scripts/check-unused.mjs [--root <dir>] [--json] [path...]`\n- No path → scan `lib`.\n- Paths relative to root (default repo root).\n- Directories recursive, only .mjs/.js/.cjs, sorted by code point.\n- Text output per item: `<posix rel path>:<line> unused-import <name>` / `unused-function <name>`.\n- Last line: