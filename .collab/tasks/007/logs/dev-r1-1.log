{"type":"user","uuid":"01a1b80c-5fb0-752c-9e51-f5a5f258d8d5","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_02_DOyZuevtfqYLS346jqCB1156","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Fails when any repository file refers to the blueprint working directory.\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { fileURLToPath } from 'node:url'\n   6→\n   7→const HERE = path.dirname(fileURLToPath(import.meta.url))\n   8→const REPO_ROOT = path.resolve(HERE, '..')\n   9→const SCAN_DIRS = ['lib', 'scripts', 'test', 'contracts', 'docs']\n  10→const SKIP_NAMES = new Set(['node_modules', '.git'])\n  11→const FIXTURE_PREFIX = 'test/fixtures/no-collab/'\n  12→const USAGE = 'usage: node scripts/check-no-collab.mjs [--root <dir>]'\n  13→\n  14→// Built by concatenation so this file does not match itself.\n  15→const NEEDLE = ['.', 'coll', 'ab'].join('')\n  16→\n  17→function toPosix(value) {\n  18→  return value.split(path.sep).join('/')\n  19→}\n  20→\n  21→function byCodePoint(a, b) {\n  22→  if (a < b) return -1\n  23→  if (a > b) return 1\n  24→  return 0\n  25→}\n  26→\n  27→function walk(dir, base, out) {\n  28→  let entries\n  29→  try {\n  30→    entries = fs.readdirSync(dir, { withFileTypes: true })\n  31→  } catch {\n  32→    return\n  33→  }\n  34→  for (const entry of entries) {\n  35→    if (SKIP_NAMES.has(entry.name)) continue\n  36→    const full = path.join(dir, entry.name)\n  37→    if (entry.isDirectory()) walk(full, base, out)\n  38→    else if (entry.isFile()) out.push(toPosix(path.relative(base, full)))\n  39→  }\n  40→}\n  41→\n  42→function listFiles(root, skipFixture) {\n  43→  const found = []\n  44→  if (fs.existsSync(path.join(root, 'package.json'))) found.push('package.json')\n  45→  for (const dir of SCAN_DIRS) walk(path.join(root, dir), root, found)\n  46→  const unique = [...new Set(found)].sort(byCodePoint)\n  47→  if (!skipFixture) return unique\n  48→  return unique.filter((rel) => !rel.startsWith(FIXTURE_PREFIX))\n  49→}\n  50→\n  51→function main(argv) {\n  52→  let root = REPO_ROOT\n  53→  for (let i = 0; i < argv.length; i += 1) {\n  54→    const flag = argv[i]\n  55→    if (flag === '--root') {\n  56→      const value = argv[i + 1]\n  57→      if (typeof value !== 'string' || value === '') {\n  58→        process.stderr.write(`check-no-collab: --root requires a directory\\n${USAGE}\\n`)\n  59→        process.exitCode = 2\n  60→        return\n  61→      }\n  62→      root = path.resolve(value)\n  63→      i += 1\n  64→    } else {\n  65→      process.stderr.write(`check-no-collab: unknown argument: ${flag}\\n${USAGE}\\n`)\n  66→      process.exitCode = 2\n  67→      return\n  68→    }\n  69→  }\n  70→\n  71→  const files = listFiles(root, true)\n  72→  const violations = []\n  73→\n  74→  for (const rel of files) {\n  75→    let text\n  76→    try {\n  77→      text = fs.readFileSync(path.join(root, rel), 'utf8')\n  78→    } catch {\n  79→      continue\n  80→    }\n  81→    const lines = text.split(/\\r?\\n/)\n  82→    for (let i = 0; i < lines.length; i += 1) {\n  83→      if (lines[i].toLowerCase().includes(NEEDLE)) violations.push({ rel, line: i + 1 })\n  84→    }\n  85→  }\n  86→\n  87→  if (violations.length > 0) {\n  88→    violations.sort((a, b) => byCodePoint(a.rel, b.rel) || a.line - b.line)\n  89→    for (const hit of violations) process.stdout.write(`FAIL no_collab ${hit.rel}:${hit.line}\\n`)\n  90→    process.stdout.write(`check-no-collab: FAILED (${violations.length} violations)\\n`)\n  91→    process.exitCode = 1\n  92→    return\n  93→  }\n  94→\n  95→  process.stdout.write(`check-no-collab: ok (scanned ${files.length} files)\\n`)\n  96→  process.exitCode = 0\n  97→}\n  98→\n  99→const invokedDirectly =\n 100→  process.argv[1] &&\n 101→  path.resolve(process.argv[1]).toLowerCase() === fileURLToPath(import.meta.url).toLowerCase()\n 102→\n 103→if (invokedDirectly) main(process.argv.slice(2))\n 104→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c54ad7ecd8b5f726007245167","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c54ad7ecd8b5f726007245167","codebuddy.ai/llmMessageId":"01a1b80c54ad7ecd8b5f726007245167","traceparent":"00-3f40958935830439216b9e572e25ec75-edb47074163b0488-01","baggage":"codebuddy.session_id=01a1b80c-10a1-714c-94fe-186218e3e224,codebuddy.conversation_request_id=01a1b80c14647279947af18522731dd8"},"__timestamp":"2026-11-07T22:06:21.105Z"}
