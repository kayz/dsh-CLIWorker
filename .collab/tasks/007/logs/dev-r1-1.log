:{state:'callable'}}});console.log(r.ok,r.models.length,reads)})\"\n  31→```\n  32→\n  33→期望：输出恰为一行 `true 12 12`，退出码 0。基准上 `reads` 大于 12。\n  34→\n  35→**A-04** 注入的 forecast 计数器等于通过前置过滤的模型数，与 count、usage 无关\n  36→\n  37→```\n  38→node -e \"import('./lib/select.mjs').then(({selectModels})=>{const models={};for(let i=0;i<12;i++)models['m'+i]={provider:'claude',id:'m'+i,level:'Quick',identity:'verified',prices:{input_per_mtok:i,output_per_mtok:1}};models.m0.level='Top';models.m1.deprecated=true;models.m2.identity='unverified';const c={providers:{claude:{cli:'claude',readonly:true}},models};const out=[];for(const usage of ['Normal','Light','Heavy'])for(const count of [1,3,8]){const seen=[];const ctx={forecast:(a)=>{seen.push(a.model);return {risk:'ok',tasks_left:9}}};selectModels(c,{level:'Quick',count,usage,exclude:['m3']},{status:{claude:{state:'callable'}},ctx});out.push(seen.length+'/'+new Set(seen).size)}console.log([...new Set(out)].join(','))})\"\n  39→```\n  40→\n  41→期望：输出恰为一行 `8/8`（12 个模型减去 level 不符、deprecated、identity 未验证、被 exclude 的 4 个），退出码 0。\n  42→\n  43→**A-05** 三个缺陷文件的 `[fixed]` 段存在且通过，`[repro]` 未被改动\n  44→\n  45→```\n  46→node scripts/check-defects.mjs; $LASTEXITCODE\n  47→```\n  48→\n  49→期望：输出 `check-defects: ok`，最后一行 `0`。\n  50→\n  51→```\n  52→node --test test/characterization/defects/a5-dup-call.test.mjs test/characterization/defects/a5-forecast-x3.test.mjs; $LASTEXITCODE\n  53→```\n  54→\n  55→期望：输出含 `ℹ fail 0`，且 `ℹ pass 4`（每个文件各 1 个 `[repro]` + 1 个 `[fixed]`），最后一行 `0`。\n  56→\n  57→**A-06** `[repro]` 段哈希未变\n  58→\n  59→```\n  60→git diff f6f6057 -- test/characterization/defects.json; $LASTEXITCODE\n  61→```\n  62→\n  63→期望：无输出（`defects.json` 未被修改），退出码 0。（`check-defects` 在 A-05 里校验各 `[repro]` 的 sha256。）\n  64→\n  65→## 二、AC-021：draft 视图的 Heavy 拒选\n  66→\n  67→**A-07** 过滤运行 AC-021\n  68→\n  69→```\n  70→node scripts/run-tests.mjs --ac AC-021; $LASTEXITCODE\n  71→```\n  72→\n  73→期望：输出含 `ℹ fail 0`，含 `run-tests: filtered 1 files`，最后一行 `0`。\n  74→\n  