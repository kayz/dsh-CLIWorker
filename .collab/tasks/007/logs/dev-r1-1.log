{"type":"user","uuid":"01a1b80c-2aeb-7252-8fe0-57c60c229c88","session_id":"01a1b80c-10a1-714c-94fe-186218e3e224","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_ZUhyyGia38yGJL2PxxIq0575","content":[{"type":"text","text":"   1→import { normalizePrices, forecast } from './forecast.mjs'\n   2→\n   3→export const SCHEMA = 'cliworker.selection/v1'\n   4→export const LEVELS = ['Top', 'High', 'Middle', 'Quick']\n   5→export const USAGES = ['Heavy', 'Normal', 'Light']\n   6→\n   7→function isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v) }\n   8→function normLevel(v) {\n   9→  const s = String(v || '').trim().toLowerCase()\n  10→  return LEVELS.find((x) => x.toLowerCase() === s) || null\n  11→}\n  12→function normUsage(v) {\n  13→  const s = String(v || '').trim().toLowerCase()\n  14→  return USAGES.find((x) => x.toLowerCase() === s) || 'Normal'\n  15→}\n  16→\n  17→function vendorOf(provider) {\n  18→  const p = String(provider || '').toLowerCase()\n  19→  if (p.includes('claude')) return 'anthropic'\n  20→  if (p.includes('codex') || p.includes('openai')) return 'openai'\n  21→  if (p.includes('codebuddy') || p.includes('tencent')) return 'tencent'\n  22→  if (p.includes('cursor') || p.includes('xai') || p.includes('grok')) return 'xai'\n  23→  if (p.includes('gemini') || p.includes('google')) return 'google'\n  24→  return p\n  25→}\n  26→\n  27→function levelOf(m) {\n  28→  if (m.level && LEVELS.includes(m.level)) return m.level\n  29→  if (m.tier === 'top') return 'Top'\n  30→  if (m.tier === 'advanced') return 'High'\n  31→  if (m.tier === 'standard') return 'Middle'\n  32→  return 'Quick'\n  33→}\n  34→\n  35→function cliCall(config, model, request) {\n  36→  const p = config.providers?.[model.provider] || {}\n  37→  const id = model.id\n  38→  const cwd = request.cwd || '<workspace>'\n  39→  if (model.provider === 'claude') {\n  40→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  41→  }\n  42→  if (model.provider === 'codex') {\n  43→    return { command: p.cli, args: ['exec', '--model', id, '-s', 'read-only', '--skip-git-repo-check', '--json'], input: 'stdin', cwd }\n  44→  }\n  45→  if (model.provider === 'codebuddy') {\n  46→    return { command: p.cli, args: ['-p', '--model', id, '--output-format', 'stream-json', '--verbose'], input: 'stdin', cwd }\n  47→  }\n  48→  if (model.provider === 'cursor-wsl') {\n  49→    return { command: p.cli, args: ['-e', 'bash', '-lc', `cd '${cwd}' && agent -p --force --model '${id}'`], input: 'stdin', cwd }\n  50→  }\n  51→  if (model.provider === 'gemini') {\n  52→    return { command: p.cli, args: ['-m', id, '-p'], input: 'stdin', cwd }\n  53→  }\n  54→  return { command: p.cli || null, args: [], input: 'stdin', cwd }\n  55→}\n  56→\n  57→export function listModels(config, { status = {}, includeDeprecated = false } = {}) {\n  58→  return Object.entries(config.models).map(([key, m]) => {\n  59→    const st = status[m.provider] || { state: 'unavailable', detail: 'provider not checked' }\n  60→    const callable = st.state === 'callable' && !m.deprecated\n  61→    return {\n  62→      schema: 'cliworker.model/v1', key, provider: m.provider, id: m.id || key,\n  63→      vendor: m.vendor || vendorOf(m.provider), tier: m.tier || 'unknown', level: levelOf(m),\n  64→      identity: m.identity === 'verified' ? 'verified' : 'unverified',\n  65→      identity_group: m.identity_group || null,\n  66→      deprecated: !!m.deprecated, deprecated_reason: m.deprecated_reason || null,\n  67→      callable, availability: callable ? 'callable' : (m.deprecated ? 'deprecated' : st.state),\n  68→      readonly: m.readonly === undefined ? !!(config.providers?.[m.provider]?.readonly) : !!m.readonly,\n  69→      prices: normalizePrices(m), source: 'config',\n  70→      provider_detail: st.detail || null,\n  71→    }\n  72→  }).filter((m) => includeDeprecated || !m.deprecated)\n  73→}\n  74→\n  75→export function selectModels(config, request = {}, { status = {}, usage = [] } = {}) {\n  76→  const level = normLevel(request.level || request.tier)\n  77→  const usageKind = normUsage(request.usage)\n  78→  const models = listModels(config, { status, includeDeprecated: true })\n  79→  const count = Math.max(1, Math.min(10, Number(request.count || 1)))\n  80→  const requireVerified = request.require_verified !== false\n  81→  const requireReadonly = request.require_readonly === true\n  82→  const exclude = new Set(request.exclude || [])\n  83→  const allowed = request.candidates ? new Set(request.candidates) : null\n  84→  const rejected = []\n  85→  if (!level) return { schema: SCHEMA, ok: false, request, level: null, usage: usageKind, models: [], calls: [], rejected, reason: 'E_LEVEL_REQUIRED' }\n  86→\n  87→  const candidates = models.filter((m) => {\n  88→    if (exclude.has(m.key)) { rejected.push({ key: m.key, reason: 'excluded' }); return false }\n  89→    if (allowed && !allowed.has(m.key)) { rejected.push({ key: m.key, reason: 'not_in_workspace_order' }); return false }\n  90→    if (m.level !== level) { rejected.push({ key: m.key, reason: `level:${m.level}` }); return false }\n  91→    if (!m.callable) { rejected.push({ key: m.key, reason: `availability:${m.availability}` }); return false }\n  92→    if (requireVerified && m.identity !== 'verified') { rejected.push({ key: m.key, reason: 'identity_unverified' }); return false }\n  93→    if (requireReadonly && !m.readonly) { rejected.push({ key: m.key, reason: 'readonly_unavailable' }); return false }\n  94→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n  95→    if (usageKind === 'Heavy' && (f.risk === 'critical' || f.risk === 'exhausted' || f.risk === 'low_reserve')) {\n  96→      rejected.push({ key: m.key, reason: 'E_FORECAST_EXHAUSTION', forecast: f }); return false\n  97→    }\n  98→    return true\n  99→  })\n 100→\n 101→  const rank = (m) => {\n 102→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 103→    const price = m.prices.input_per_mtok + m.prices.output_per_mtok\n 104→    const unknown = f.risk === 'unknown' ? 1 : 0\n 105→    if (usageKind === 'Heavy') return [unknown, -(f.tasks_left ?? -1), price, m.key]\n 106→    if (usageKind === 'Light') return [price, unknown, m.key]\n 107→    return [unknown, price, m.key]\n 108→  }\n 109→  candidates.sort((a, b) => {\n 110→    const ra = rank(a), rb = rank(b)\n 111→    for (let i = 0; i < ra.length; i++) { if (ra[i] < rb[i]) return -1; if (ra[i] > rb[i]) return 1 }\n 112→    return 0\n 113→  })\n 114→\n 115→  const picked = candidates.slice(0, count).map((m) => {\n 116→    const f = forecast({ records: usage, model: m.key, prices: m.prices, quota: config.quotas?.[m.provider] || null })\n 117→    const call = cliCall(config, m, request)\n 118→    return {\n 119→      schema: 'cliworker.handle/v1', key: m.key, provider: m.provider, id: m.id, level: m.level,\n 120→      adapter: config.providers[m.provider]?.adapter || null,\n 121→      identity: m.identity, identity_group: m.identity_group, vendor: m.vendor,\n 122→      readonly: m.readonly, prices: m.prices, quota: config.quotas?.[m.provider] || null,\n 123→      forecast: f, cli: call, call,\n 124→    }\n 125→  })\n 126→  return {\n 127→    schema: SCHEMA, ok: picked.length > 0, request, level, usage: usageKind,\n 128→    models: picked, calls: picked.map((x) => x.call), rejected,\n 129→    reason: picked.length ? null : 'no_eligible_model',\n 130→    truncated: picked.length < count,\n 131→  }\n 132→}\n 133→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b80c14647279947af18522731dd8","_messageId":"01a1b80c21dc74c9a375f3018f3b8baa","_meta":{"codebuddy.ai/conversationRequestId":"01a1b80c14647279947af18522731dd8","codebuddy.ai/modelRequestId":"01a1b80c21dc74c9a375f3018f3b8baa","co