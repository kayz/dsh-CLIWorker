{"type":"file-history-snapshot","messageId":"01a1b80c-145c-7a18-99a8-89a77117a416","timestamp":1794089627936,"isSnapshotUpdate":true,"snapshot":{"messageId":"01a1b80c-145c-7a18-99a8-89a77117a416","trackedFileBackups":{"scripts\\check-unused.mjs":{"backupFileName":"bd10f18b9226016e@v3","version":3,"backupTime":1794089530258,"existedAtTrack":false},"test\\fixtures\\unused\\clean\\ok.mjs":{"version":1,"backupTime":1794089380542,"existedAtTrack":false},"test\\fixtures\\unused\\dirty\\imports.mjs":{"version":1,"backupTime":1794089380562,"existedAtTrack":false},"test\\fixtures\\unused\\dirty\\functions.mjs":{"version":1,"backupTime":1794089380583,"existedAtTrack":false},"test\\fixtures\\unused\\expected.json":{"version":1,"backupTime":1794089380601,"existedAtTrack":false},"test\\unit\\check-unused.test.mjs":{"version":1,"backupTime":1794089407394,"existedAtTrack":false},"lib\\select-draft.mjs":{"version":1,"backupTime":1794089414620,"existedAtTrack":false},"lib\\select.mjs":{"backupFileName":"065cbf18ba375e54@v2","version":2,"backupTime":1794089477319,"existedAtTrack":true},"lib\\contract\\validate.mjs":{"backupFileName":"5b54307c60de7b19@v1","version":1,"backupTime":1794089436993,"existedAtTrack":true},"test\\unit\\select-draft.test.mjs":{"version":1,"backupTime":1794089506430,"existedAtTrack":false},"test\\characterization\\defects\\a5-dup-call.test.mjs":{"backupFileName":"3997780282a912d5@v1","version":1,"backupTime":1794089545534,"existedAtTrack":true},"test\\characterization\\defects\\a5-forecast-x3.test.mjs":{"backupFileName":"a1b9537643400653@v1","version":1,"backupTime":1794089545564,"existedAtTrack":true},"test\\characterization\\defects\\a5-unused.test.mjs":{"backupFileName":"7a571a8f9d63054c@v1","version":1,"backupTime":1794089545600,"existedAtTrack":true},"test\\traceability\\T-007.json":{"version":1,"backupTime":1794089548382,"existedAtTrack":false},".collab\\tasks\\007\\impl.md":{"version":1,"backupTime":1794089627935,"existedAtTrack":false}}},"__timestamp":