{"type":"user","uuid":"01a1b813-df4c-72e5-8d27-db2e0ac59bb8","session_id":"01a1b813-aa3c-75ba-9e48-8f7976f3c165","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_3nFyqUSDCtumdWVqrQoN0243","content":[{"type":"text","text":"   1→// Minimal JSON Schema subset used to validate the contract files. Pure functions only:\n   2→// no imports, no IO. The caller supplies schemas and a cross-file loader.\n   3→\n   4→const ANNOTATIONS = new Set([\n   5→  '$schema',\n   6→  '$id',\n   7→  'title',\n   8→  'description',\n   9→  '$defs',\n  10→  'examples',\n  11→  'default',\n  12→])\n  13→\n  14→const SUPPORTED = new Set([\n  15→  'type',\n  16→  'enum',\n  17→  'const',\n  18→  'required',\n  19→  'properties',\n  20→  'additionalProperties',\n  21→  'items',\n  22→  'minItems',\n  23→  'maxItems',\n  24→  'uniqueItems',\n  25→  'minLength',\n  26→  'maxLength',\n  27→  'pattern',\n  28→  'minimum',\n  29→  'maximum',\n  30→  '$ref',\n  31→])\n  32→\n  33→const MAX_DEPTH = 64\n  34→\n  35→const TYPE_NAMES = new Set(['object', 'array', 'string', 'number', 'integer', 'boolean', 'null'])\n  36→\n  37→function escapePointer(value) {\n  38→  return String(value).replace(/~/g, '~0').replace(/\\//g, '~1')\n  39→}\n  40→\n  41→function childPath(pointer, key) {\n  42→  return `${pointer}/${escapePointer(key)}`\n  43→}\n  44→\n  45→function matchesType(type, value) {\n  46→  if (!TYPE_NAMES.has(type)) throw new TypeError(`unsupported type: ${type}`)\n  47→  if (type === 'integer') return typeof value === 'number' && Number.isInteger(value)\n  48→  if (type === 'number') return typeof value === 'number'\n  49→  if (type === 'array') return Array.isArray(value)\n  50→  if (type === 'object') return value !== null && typeof value === 'object' && !Array.isArray(value)\n  51→  if (type === 'null') return value === null\n  52→  return typeof value === type\n  53→}\n  54→\n  55→function schemaKeywords(schema) {\n  56→  return Object.keys(schema).filter((key) => !ANNOTATIONS.has(key))\n  57→}\n  58→\n  59→export function checkSchema(schema) {\n  60→  const problems = []\n  61→\n  62→  function walk(node, pointer) {\n  63→    if (!node || typeof node !== 'object' || Array.isArray(node)) return\n  64→    for (const key of schemaKeywords(node)) {\n  65→      if (!SUPPORTED.has(key)) problems.push(`${pointer}: ${key}`)\n  66→    }\n  67→    if (node.$defs && typeof node.$defs === 'object') {\n  68→      for (const name of Object.keys(node.$defs)) {\n  69→        walk(node.$defs[name], childPath(`${pointer}/$defs`, name))\n  70→      }\n  71→    }\n  72→    if (node.properties && typeof node.properties === 'object') {\n  73→      for (const name of Object.keys(node.properties)) {\n  74→        walk(node.properties[name], childPath(`${pointer}/properties`, name))\n  75→      }\n  76→    }\n  77→    if (node.additionalProperties && typeof node.additionalProperties === 'object') {\n  78→      walk(node.additionalProperties, `${pointer}/additionalProperties`)\n  79→    }\n  80→    if (node.items && typeof node.items === 'object' && !Array.isArray(node.items)) {\n  81→      walk(node.items, `${pointer}/items`)\n  82→    }\n  83→  }\n  84→\n  85→  walk(schema, '')\n  86→  return problems\n  87→}\n  88→\n  89→function resolveRef(ref, currentRoot, loadSchema) {\n  90→  if (typeof ref !== 'string') throw new TypeError(`$ref must be a string`)\n  91→  const hash = ref.indexOf('#')\n  92→  const filePart = hash === -1 ? ref : ref.slice(0, hash)\n  93→  const pointerPart = hash === -1 ? '' : ref.slice(hash + 1)\n  94→  let target = currentRoot\n  95→  if (filePart !== '') {\n  96→    if (typeof loadSchema !== 'function') throw new TypeError(`cannot resolve $ref without loadSchema: ${ref}`)\n  97→    target = loadSchema(filePart)\n  98→    if (!target || typeof target !== 'object') throw new TypeError(`cannot resolve $ref: ${ref}`)\n  99→  }\n 100→  if (pointerPart === '') return { schema: target, root: target }\n 101→  const match = /^\\/\\$defs\\/([^/]+)$/.exec(pointerPart)\n 102→  if (!match) throw new TypeError(`unsupported $ref: ${ref}`)\n 103→  const name = decodeURIComponent(match[1]).replace(/~1/g, '/').replace(/~0/g, '~')\n 104→  const defs = target.$defs\n 105→  if (!defs || !Object.prototype.hasOwnProperty.call(defs, name)) {\n 106→    throw new TypeError(`cannot resolve $ref: ${ref}`)\n 107→  }\n 108→  return { schema: defs[name], root: target }\n 109→}\n 110→\n 111→export function validate(schema, doc, options = {}) {\n 112→  const loadSchema = options && typeof options.loadSchema === 'function' ? options.loadSchema : null\n 113→  const errors = []\n 114→  const seen = new Set()\n 115→\n 116→  function push(path, keyword, message) {\n 117→    const key = `${path}\\u0000${keyword}`\n 118→    if (seen.has(key)) return\n 119→    seen.add(key)\n 120→    errors.push({ path, keyword, message })\n 121→  }\n 122→\n 123→  function checkKeywords(node) {\n 124→    for (const key of schemaKeywords(node)) {\n 125→      if (!SUPPORTED.has(key)) throw new TypeError(`unsupported keyword: ${key}`)\n 126→    }\n 127→  }\n 128→\n 129→  function validateValue(node, value, pointer, depth, root) {\n 130→    if (depth > MAX_DEPTH) throw new TypeError('schema recursion is too deep')\n 131→    if (!node || typeof node !== 'object' || Array.isArray(node)) {\n 132→      throw new TypeError(`schema at ${pointer} is not an object`)\n 133→    }\n 134→    checkKeywords(node)\n 135→\n 136→    if (typeof node.$ref === 'string') {\n 137→      const resolved = resolveRef(node.$ref, root, loadSchema)\n 138→      validateValue(resolved.schema, value, pointer, depth + 1, resolved.root)\n 139→      return\n 140→    }\n 141→\n 142→    if (Object.prototype.hasOwnProperty.call(node, 'type')) {\n 143→      const types = Array.isArray(node.type) ? node.type : [node.type]\n 144→      if (!types.some((type) => matchesType(type, value))) {\n 145→        push(pointer, 'type', `expected ${types.join('|')}`)\n 146→        return\n 147→      }\n 148→    }\n 149→\n 150→    if (Object.prototype.hasOwnProperty.call(node, 'enum')) {\n 151→      const list = node.enum\n 152→      if (!Array.isArray(list) || !list.some((item) => deepSame(item, value))) {\n 153→        push(pointer, 'enum', 'value is not in the enum')\n 154→      }\n 155→    }\n 156→\n 157→    if (Object.prototype.hasOwnProperty.call(node, 'const')) {\n 158→      if (!deepSame(node.const, value)) push(pointer, 'const', 'value does not equal const')\n 159→    }\n 160→\n 161→    if (typeof value === 'string') {\n 162→      if (typeof node.minLength === 'number' && value.length < node.minLength) {\n 163→        push(pointer, 'minLength', `string is shorter than ${node.minLength}`)\n 164→      }\n 165→      if (typeof node.maxLength === 'number' && value.length > node.maxLength) {\n 166→        push(pointer, 'maxLength', `string is longer than ${node.maxLength}`)\n 167→      }\n 168→      if (typeof node.pattern === 'string' && !new RegExp(node.pattern).test(value)) {\n 169→        push(pointer, 'pattern', `string does not match ${node.pattern}`)\n 170→      }\n 171→    }\n 172→\n 173→    if (typeof value === 'number') {\n 174→      if (typeof node.minimum === 'number' && value < node.minimum) {\n 175→        push(pointer, 'minimum', `number is smaller than ${node.minimum}`)\n 176→      }\n 177→      if (typeof node.maximum === 'number' && value > node.maximum) {\n 178→        push(pointer, 'maximum', `number is larger than ${node.maximum}`)\n 179→      }\n 180→    }\n 181→\n 182→    if (Array.isArray(value)) {\n 183→      if (typeof node.minItems === 'number' && value.length < node.minItems) {\n 184→        push(pointer, 'minItems', `array is shorter than ${node.minItems}`)\n 185→      }\n 186→      if (typeof node.maxItems === 'number' && value.length > node.maxItems) {\n 187→        push(pointer, 'maxItems', `array is longer than ${node.maxItems}`)\n 188→      }\n 189→      if (node.uniqueItems === true) {\n 190→        const strings = value.map((item) => JSON.stringify(item))\n 191→        if (new Set(strings).size !== strings.length) push(pointer, 'uniqueItems', 'array has duplicates')\n 192→      }\n 193→      if (node.items && typeof node.items === 'object' && !Array.isArray(node.items)) {\n 194→        value.forEach((item, index) =>\n 195→          validateValue(node.items, item, childPath(pointer, index), depth + 1, root)\n 196→        )\n 197→      }\n 198→    }\n 199→\n 200→    if (value !== null && typeof value === 'object' && !Array.isArray(value)) {\n 201→      const properties = node.properties && typeof node.properties === 'object' ? node.properties : {}\n 202→      if (Array.isArray(node.required)) {\n 203→        for (const name of node.required) {\n 204→          if (!Object.prototype.hasOwnProperty.call(value, name)) {\n 205→            push(childPath(pointer, name), 'required', `missing required property ${name}`)\n 206→          }\n 207→        }\n 208→      }\n 209→      for (const name of Object.keys(value)) {\n 210→        if (Object.prototype.hasOwnProperty.call(properties, name)) {\n 211→          validateValue(properties[name], value[name], childPath(pointer, name), depth + 1, root)\n 212→        } else if (node.additionalProperties === false) {\n 213→          push(childPath(pointer, name), 'additionalProperties', `unexpected property ${name}`)\n 214→        } else if (node.additionalProperties && typeof node.additionalProperties === 'object') {\n 215→          validateValue(node.additionalProperties, value[name], childPath(pointer, name), depth + 1, root)\n 216→        }\n 217→      }\n 218→    }\n 219→  }\n 220→\n 221→  validateValue(schema, doc, '', 0, schema)\n 222→  return { ok: errors.length === 0, errors }\n 223→}\n 224→\n 225→function deepSame(a, b) {\n 226→  if (a === b) return true\n 227→  if (typeof a !== typeof b) return false\n 228→  if (a === null || b === null || typeof a !== 'object') return false\n 229→  if (Array.isArray(a) !== Array.isArray(b)) return false\n 230→  if (Array.isArray(a)) {\n 231→    if (a.length !== b.length) return false\n 232→    for (let i = 0; i < a.length; i += 1) if (!deepSame(a[i], b[i])) return false\n 233→    return true\n 234→  }\n 235→  const aKeys = Object.keys(a)\n 236→  const bKeys = Object.keys(b)\n 237→  if (aKeys.length !== bKeys.length) return false\n 238→  for (const key of aKeys) {\n 239→    if (!Object.prototype.hasOwnProperty.call(b, key)) return false\n 240→    if (!deepSame(a[key], b[key])) return false\n 241→  }\n 242→  return true\n 243→}\n 244→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b813adcf7aafa9d7938507fa16aa","_messageId":"01a1b813d678796283365072f9cdb70d","_meta":{"codebuddy.ai/conversationRequestId":"01a1b813adcf7aafa9d7938507fa16aa","codebuddy.ai/modelRequestId":"01a1b813d678796283365072f9cdb70d","codebuddy.ai/llmMessageId":"01a1b813d678796283365072f9cdb70d","traceparent":"00-1a493382b8228aa4280ce3141c26cb18-2b3e4729f0211ab8-01","baggage":"codebuddy.session_id=01a1b813-aa3c-75ba-9e48-8f7976f3c165,codebuddy.conversation_request_id=01a1b813adcf7aafa9d7938507fa16aa"},"__timestamp":"2026-11-07T22:14:32.525Z"}
