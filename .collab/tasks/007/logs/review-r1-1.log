tx = { forecast: (a) => buildForecast({ quota: a.quota, samples: byKey[a.model].input.samples, usage: a.usage, now: 0 }) };\nconst bad = ['exhausted', 'critical', 'low_reserve'];\nconst want = cases.filter(x => bad.includes(x.expected.risk)).map(x => 'm-' + x.id).sort();\nconst hv = selectModels(cfg, { level: 'Quick', count: 10, usage: 'Heavy' }, { status, ctx });\nconst got = hv.rejected.filter(x => x.reason === 'E_FORECAST_EXHAUSTION').map(x => x.key).sort();\nconst nv = selectModels(cfg, { level: 'Quick', count: 10, usage: 'Normal' }, { status, ctx });\nconst lv = selectModels(cfg, { level: 'Quick', count: 10, usage: 'Light' }, { status, ctx });\nconsole.log('  goldenCasesWithRisk=' + cases.length + ' want=' + want.length + ' got=' + got.length + ' setsEqual=' + (JSON.stringify(got) === JSON.stringify(want)) + ' heavyRejectedTotal=' + hv.rejected.length + ' normalRej=' + nv.rejected.length + ' lightRej=' + lv.rejected.length + ' normalModels=' + nv.models.length + ' lightModels=' + lv.models.length);\n\nconsole.log('=== check-unused scanPaths ===');\nconst rep = scanPaths(['test/fixtures/unused'], { root: 'C:/git/dsh-CLIWorker/.collab/worktrees/007' });\nconsole.log('  fixture: files=' + rep.files + ' items=' + rep.items.length + ' names=' + rep.items.map(x => x.kind + ':' + x.name).join(','));\nconst repLib = scanPaths(['lib'], { root: 'C:/git/dsh-CLIWorker/.collab/worktrees/007' });\nconsole.log('  lib: files=' + repLib.files + ' items=' + repLib.items.length);\nconst repSelf = scanPaths(['scripts/check-unused.mjs'], { root: 'C:/git/dsh-CLIWorker/.collab/worktrees/007' });\nconsole.log('  self: files=' + repSelf.files + ' items=' + repSelf.items.length);\nEOF","description":"In-memory read-only behavior verification of core ACs"}}],"model":"hy4-free","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":132012,"output_tokens":10080,"cache_creation_input_tokens":0,"cache_read_input_tokens":128896,"cache_creatio