  level -= 1\n 248→      if (level === 0) return k\n 249→    }\n 250→  }\n 251→  return -1\n 252→}\n 253→\n 254→function collectImports(tokens, text) {\n 255→  const bindings = []\n 256→  const scope = new Set()\n 257→\n 258→  for (let k = 0; k < tokens.length; k += 1) {\n 259→    const token = tokens[k]\n 260→    if (token.type !== 'word' || token.value !== 'import' || token.depth !== 0) continue\n 261→    const next = tokens[k + 1]\n 262→    if (next && next.type === 'char' && (next.value === '(' || next.value === '.')) continue\n 263→\n 264→    let cursor = token.index + 'import'.length\n 265→    while (cursor < text.length && /\\s/.test(text[cursor])) cursor += 1\n 266→    if (text[cursor] === \"'\" || text[cursor] === '\"') {\n 267→      scope.add(k)\n 268→      continue\n 269→    }\n 270→\n 271→    let fromIndex = -1\n 272→    for (let j = k + 1; j < tokens.length; j += 1) {\n 273→      const inner = tokens[j]\n 274→      if (inner.type === 'word' && inner.value === 'from' && inner.depth === 0) {\n 275→        fromIndex = j\n 276→        break\n 277→      }\n 278→      if (inner.type === 'char' && inner.value === ';' && inner.depth === 0) break\n 279→      if (inner.type === 'word' && inner.value === 'import' && inner.depth === 0) break\n 280→    }\n 281→    if (fromIndex < 0) continue\n 282→    for (let j = k; j <= fromIndex; j += 1) scope.add(j)\n 283→\n 284→    let j = k + 1\n 285→    while (j < fromIndex) {\n 286→      const inner = tokens[j]\n 287→      if (inner.type !== 'word' || inner.value === 'as') {\n 288→        j += 1\n 289→        continue\n 290→      }\n 291→      const after = tokens[j + 1]\n 292→      if (after && after.type === 'word' && after.value === 'as') {\n 293→        const local = tokens[j + 2]\n 294→        if (local && local.type === 'word' && j + 2 < fromIndex) bindings.push(local)\n 295→        j += 3\n 296→        continue\n 297→      }\n 298→      bindings.push(inner)\n 299→      j += 1\n 300→    }\n 301→  }\n 302→\n 303→  return { bindings, scope }\n 304→}\n 305→\n 306→function collectFunctions(tokens) {\n 307→  const found = []\n 308→  for (let k = 0; k < tokens.length; k += 1) {\n 309→    const token = tokens[k]\n 310→    if (token.type !== 'word' || token.value !== 'function' || token.depth !== 0) continue\n 311→\n 312→    let before = k - 1\n 313→    while (before >= 0 && tokens[before].type === 'word' && (tokens[before].value === 'async' || tokens[before].value === 'default')) {\n 314→      before -= 1\n 315→    }\n 316→    const leading = tokens[before]\n 317→    if (leading && leading.type === 'word' && leading.value === 'export') continue\n 318→    if (leading && leading.type === 'char' && leading.value === '.') continue\n 319→\n 320→    let nameIndex = k + 1\n 321→    if (tokens[nameIndex] && tokens[nameIndex].type === 'char' && tokens[nameIndex].value === '*') nameIndex += 1\n 322→    const name = tokens[nameIndex]\n 323→    if (!name || name.type !== 'word') continue\n 324→\n 325→    let open = nameIndex + 1\n 326→    while (open < tokens.length && !(tokens[open].type === 'char' && tokens[open].value === '(')) open += 1\n 327→    if (open >= tokens.length) continue\n 328→    const closeParen = matchPair(tokens, open, '(', ')')\n 329→    if (closeParen < 0) continue\n 330→\n 331→    let bodyOpen = closeParen + 1\n 332→    while (bodyOpen < tokens.length && !(tokens[bodyOpen].type === 'char' && tokens[bodyOpen].value === '{')) bodyOpen += 1\n 333→    if (bodyOpen >= tokens.length) continue\n 334→    const bodyClose = matchPair(tokens, bodyOpen, '{', '}')\n 335→    if (bodyClose < 0) continue\n 336→\n 337→    found.push({ name: name.value, nameIndex, bodyOpen, bodyClose })\n 338→  }\n 339→  return found\n 340→}\n 341→\n 342→function lineAt(source, index) {\n 343→  let line = 1\n 344→  for (let i = 0; i < index && i < source.length; i += 1) if (source[i] === '\\n') line += 1\n 345→  return line\n 346→}\n 347→\n 348→/**\n 349→ * Unused imports and unused top-level functions of one source text, sorted by line then name.\n 350→ * Only plain `function` declarations and static `import` declarations are analysed.\n 351→ */\n 352→export function scanSource(source) {\n 353→  const text = String(source ?? '')\n 354→  const bare = maskSource(text)\n 355→  const tokens = tokenize(bare)\n 356→\n 357→  const occurrences = new Map()\n 358→  tokens.forEach((token, index) => {\n 359→    if (token.type !== 'word') return\n 360→    // `obj.name` and `obj?.name` are property access, but `...name` is a spread of the binding.\n 361→    if (text[token.index - 1] === '.' && text[token.index - 2] !== '.') return\n 362→    if (!occurrences.has(token.value)) occurrences.set(token.value, [])\n 363→    occurrences.get(token.value).push(index)\n 364→  })\n 365→\n 366→  const items = []\n 367→  const imported = collectImports(tokens, text)\n 368→  for (const binding of imported.bindings) {\n 369→    const hits = (occurrences.get(binding.value) ?? []).filter((index) => !imported.scope.has(index))\n 370→    if (hits.length === 0) items.push({ line: lineAt(bare, binding.index), kind: 'import', name: binding.value })\n 371→  }\n 372→\n 373→  for (const fn of collectFunctions(tokens)) {\n 374→    const hits = (occurrences.get(fn.name) ?? []).filter(\n 375→      (index) => index !== fn.nameIndex && !(index > fn.bodyOpen && index < fn.bodyClose)\n 376→    )\n 377→    if (hits.length === 0) items.push({ line: lineAt(bare, tokens[fn.nameIndex].index), kind: 'function', name: fn.name })\n 378→  }\n 379→\n 380→  items.sort((a, b) => a.line - b.line || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))\n 381→  return items\n 382→}\n 383→\n 384→function toPosix(value) {\n 385→  return value.split(path.sep).join('/')\n 386→}\n 387→\n 388→function byCodePoint(a, b) {\n 389→  if (a < b) return -1\n 390→  if (a > b) return 1\n 391→  return 0\n 392→}\n 393→\n 394→function collectFiles(full, anchor, found, seen) {\n 395→  let stat\n 396→  try {\n 397→    stat = fs.statSync(full)\n 398→  } catch {\n 399→    return false\n 400→  }\n 401→  if (stat.isDirectory()) {\n 402→    const entries = fs.readdirSync(full, { withFileTypes: true }).sort((a, b) => byCodePoint(a.name, b.name))\n 403→    for (const entry of entries) {\n 404→      const child = path.join(full, entry.name)\n 405→      if (entry.isDirectory()) collectFiles(child, anchor, found, seen)\n 406→      else if (entry.isFile() && SOURCE_EXT.test(entry.name)) collectFiles(child, anchor, found, seen)\n 407→    }\n 408→    return true\n 409→  }\n 410→  if (!stat.isFile()) return true\n 411→  const absolute = path.resolve(full)\n 412→  if (seen.has(absolute)) return true\n 413→  seen.add(absolute)\n 414→  found.push({ rel: toPosix(path.relative(anchor, absolute)), full: absolute })\n 415→  return true\n 416→}\n 417→\n 418→/** Scans the given paths (relative to `root`, defaulting to `lib`) and returns `{ files, items }`. */\n 419→export function scanPaths(paths, { root = REPO_ROOT } = {}) {\n 420→  const base = path.resolve(root)\n 421→  const list = Array.isArray(paths) && paths.length > 0 ? paths : ['lib']\n 422→  const found = []\n 423→  const seen = new Set()\n 424→\n 425→  for (const rel of list) {\n 426→    const full = path.resolve(base, rel)\n 427→    let stat\n 428→    try {\n 429→      stat = fs.statSync(full)\n 430→    } catch {\n 431→      const error = new Error(`no such file or directory: ${rel}`)\n 432→      error.code = 'ENOENT'\n 433→      throw error\n 434→    }\n 435→    const anchor = stat.isDirectory() ? full : path.dirname(full)\n 436→    collectFiles(full, anchor, found, seen)\n 437→  }\n 438→\n 439→  found.sort((a, b) => byCodePoint(a.rel, b.rel))\n 440→  const items = []\n 441→  for (const file of found) {\n 442→    let source = ''\n 443→    try {\n 444→      source = fs.readFileSync(file.full, 'utf8')\n 445→    } catch {\n 446→      continue\n 447→    }\n 448→    for (const item of scanSource(source)) {\n 449→      items.push({ file: file.rel, line: item.line, kind: item.kind, name: item.name })\n 450→    }\n 451→  }\n 452→  items.sort((a, b) => byCodePoint(a.file, b.file) || a.line - b.line || byCodePoint(a.name, b.name))\n 453→\n 454→  return { files: found.length, items }\n 455→}\n 456→\n 457→function usageError(message) {\n 458→  process.stderr.write(`${message}\\n${USAGE}\\n`)\n 459→  process.exitCode = 2\n 460→}\n 461→\n 462→function main(argv) {\n 463→  let root = REPO_ROOT\n 464→  let json = false\n 465→  const paths = []\n 466→\n 467→  for (let i = 0; i < argv.length; i += 1) {\n 468→    const flag = argv[i]\n 469→    if (flag === '--root') {\n 470→      const value = argv[i + 1]\n 471→      if (typeof value !== 'string' || value === '') {\n 472→        usageError('--root requires a directory')\n 473→        return\n 474→      }\n 475→      root = path.resolve(value)\n 476→      i += 1\n 477→    } else if (flag === '--json') {\n 478→      json = true\n 479→    } else if (flag.startsWith('-')) {\n 480→      usageError(`unknown argument: ${flag}`)\n 481→      return\n 482→    } else {\n 483→      paths.push(flag)\n 484→    }\n 485→  }\n 486→\n 487→  let report\n 488→  try {\n 489→    report = scanPaths(paths, { root })\n 490→  } catch (error) {\n 491→    usageError(`check-unused: ${error.message}`)\n 492→    return\n 493→  }\n 494→\n 495→  if (json) {\n 496→    process.stdout.write(`${JSON.stringify({ files: report.files, items: report.items })}\\n`)\n 497→    process.exitCode = report.items.length === 0 ? 0 : 1\n 498→    return\n 499→  }\n 500→\n 501→  for (const item of report.items) {\n 502→    process.stdout.write(`${item.file}:${item.line} unused-${item.kind} ${item.name}\\n`)\n 503→  }\n 504→  process.stdout.write(\n 505→    report.items.length === 0\n 506→      ? `check-unused: ok (files=${report.files})\\n`\n 507→      : `check-unused: FAIL (${report.items.length} unused)\\n`\n 508→  )\n 509→  process.exitCode = report.items.length === 0 ? 0 : 1\n 510→}\n 511→\n 512→const invokedDirectly =\n 513→  process.argv[1] && path.re