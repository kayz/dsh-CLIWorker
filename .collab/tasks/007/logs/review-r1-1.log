{"type":"user","uuid":"01a1b826-cb7c-7b35-8fd5-82f92dbac053","session_id":"01a1b824-ffca-72a9-8d1d-a82a9e9bca00","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-baeef408ba5a8074","content":[{"type":"text","text":"   1→#!/usr/bin/env node\n   2→// Zero-dependency scanner: reports unused imports and unused top-level functions. The lexer is a\n   3→// hand-written masking pass. Comments, string bodies, template text and regex literals are\n   4→// blanked in place (newlines survive so line numbers stay exact) while template `${...}`\n   5→// expressions stay visible, so a binding used only inside an interpolation still counts.\n   6→import fs from 'node:fs'\n   7→import path from 'node:path'\n   8→import { fileURLToPath } from 'node:url'\n   9→\n  10→const HERE = path.dirname(fileURLToPath(import.meta.url))\n  11→const REPO_ROOT = path.resolve(HERE, '..')\n  12→const USAGE = 'usage: node scripts/check-unused.mjs [--root <dir>] [--json] [path...]'\n  13→const SOURCE_EXT = /\\.(mjs|js|cjs)$/\n  14→const WORD_START = /[A-Za-z_$]/\n  15→const WORD_PART = /[\\w$]/\n  16→// A `/` after one of these tokens starts a regular expression, otherwise it is division.\n  17→const REGEX_AFTER_CHARS = '(,=:[!&|?{};+-*%<>~^'\n  18→const REGEX_AFTER_WORDS = new Set([\n  19→  'return',\n  20→  'typeof',\n  21→  'case',\n  22→  'in',\n  23→  'of',\n  24→  'delete',\n  25→  'void',\n  26→  'throw',\n  27→  'new',\n  28→  'else',\n  29→  'do',\n  30→])\n  31→\n  32→function isLineEnd(ch) {\n  33→  return ch === '\\n' || ch === '\\r'\n  34→}\n  35→\n  36→function beginsRegex(previous) {\n  37→  if (!previous) return true\n  38→  if (previous.type === 'char') return REGEX_AFTER_CHARS.includes(previous.value)\n  39→  return REGEX_AFTER_WORDS.has(previous.value)\n  40→}\n  41→\n  42→/**\n  43→ * Same-length copy of `source` where comments, string bodies, template text and regex literals\n  44→ * are replaced by spaces. Template `${...}` expressions are copied through untouched.\n  45→ */\n  46→function maskSource(source) {\n  47→  const text = String(source ?? '')\n  48→  const size = text.length\n  49→  const out = text.split('')\n  50→  const stack = [{ kind: 'code', expr: false, depth: 0 }]\n  51→  let previous = null\n  52→  let i = 0\n  53→\n  54→  const hide = (index) => {\n  55→    if (!isLineEnd(out[index])) out[index] = ' '\n  56→  }\n  57→\n  58→  while (i < size) {\n  59→    const frame = stack[stack.length - 1]\n  60→    const ch = text[i]\n  61→\n  62→    if (frame.kind === 'template') {\n  63→      if (ch === '\\\\') {\n  64→        hide(i)\n  65→        if (i + 1 < size) hide(i + 1)\n  66→        i += 2\n  67→        continue\n  68→      }\n  69→      if (ch === '`') {\n  70→        hide(i)\n  71→        stack.pop()\n  72→        previous = { type: 'char', value: '`' }\n  73→        i += 1\n  74→        continue\n  75→      }\n  76→      if (ch === '$' && text[i + 1] === '{') {\n  77→        stack.push({ kind: 'code', expr: true, depth: 0 })\n  78→        previous = { type: 'char', value: '{' }\n  79→        i += 2\n  80→        continue\n  81→      }\n  82→      hide(i)\n  83→      i += 1\n  84→      continue\n  85→    }\n  86→\n  87→    if (ch === '/' && text[i + 1] === '/') {\n  88→      while (i < size && text[i] !== '\\n') {\n  89→        hide(i)\n  90→        i += 1\n  91→      }\n  92→      continue\n  93→    }\n  94→    if (ch === '/' && text[i + 1] === '*') {\n  95→      hide(i)\n  96→      hide(i + 1)\n  97→      i += 2\n  98→      while (i < size && !(text[i] === '*' && text[i + 1] === '/')) {\n  99→        hide(i)\n 100→        i += 1\n 101→      }\n 102→      if (i < size) {\n 103→        hide(i)\n 104→        hide(i + 1)\n 105→        i += 2\n 106→      }\n 107→      continue\n 108→    }\n 109→    if (ch === '/' && beginsRegex(previous)) {\n 110→      hide(i)\n 111→      i += 1\n 112→      let inClass = false\n 113→      while (i < size) {\n 114→        const inner = text[i]\n 115→        if (inner === '\\\\') {\n 116→          hide(i)\n 117→          if (i + 1 < size) hide(i + 1)\n 118→          i += 2\n 119→          continue\n 120→        }\n 121→        if (inner === '\\n') break\n 122→        if (inner === '[') inClass = true\n 123→        else if (inner === ']') inClass = false\n 124→        else if (inner === '/' && !inClass) {\n 125→          hide(i)\n 126→          i += 1\n 127→          break\n 128→        }\n 129→        hide(i)\n 130→        i += 1\n 131→      }\n 132→      while (i < size && /[a-z]/i.test(text[i])) {\n 133→        hide(i)\n 134→        i += 1\n 135→      }\n 136→      previous = { type: 'word', value: 'regex' }\n 137→      continue\n 138→    }\n 139→    if (ch === \"'\" || ch === '\"') {\n 140→      const quote = ch\n 141→      hide(i)\n 142→      i += 1\n 143→      while (i < size) {\n 144→        const inner = text[i]\n 145→        if (inner === '\\\\') {\n 146→          hide(i)\n 147→          if (i + 1 < size) hide(i + 1)\n 148→          i += 2\n 149→          continue\n 150→        }\n 151→        if (inner === quote) {\n 152→          hide(i)\n 153→          i += 1\n 154→          break\n 155→        }\n 156→        if (inner === '\\n') break\n 157→        hide(i)\n 158→        i += 1\n 159→      }\n 160→      previous = { type: 'word', value: 'string' }\n 161→      continue\n 162→    }\n 163→    if (ch === '`') {\n 164→      hide(i)\n 165→      stack.push({ kind: 'template' })\n 166→      i += 1\n 167→      continue\n 168→    }\n 169→    if (frame.expr) {\n 170→      if (ch === '{') {\n 171→        frame.depth += 1\n 172→        previous = { type: 'char', value: '{' }\n 173→        i += 1\n 174→        continue\n 175→      }\n 176→      if (ch === '}') {\n 177→        if (frame.depth === 0) stack.pop()\n 178→        else frame.depth -= 1\n 179→        previous = { type: 'char', value: '}' }\n 180→        i += 1\n 181→        continue\n 182→      }\n 183→    }\n 184→    if (ch === ' ' || ch === '\\t' || ch === '\\n' || ch === '\