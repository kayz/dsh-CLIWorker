{"type":"assistant","uuid":"01a1b827-9e28-7501-95a7-73a1c48415d8","session_id":"01a1b824-ffca-72a9-8d1d-a82a9e9bca00","message":{"id":"01a1b82793ac7b129e333950170fd653","content":[{"type":"tool_use","id":"chatcmpl-tool-80776c17cdf33667","name":"Read","input":{"file_path":"C:\\git\\dsh-CLIWorker\\.collab\\worktrees\\007\\test\\unit\\check-unused.test.mjs"}}],"model":"hy4-free","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":106753,"output_tokens":92,"cache_creation_input_tokens":0,"cache_read_input_tokens":100608,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a1b82503867dc9a59eebf43d351406","_messageId":"01a1b82793ac7b129e333950170fd653","_meta":{"codebuddy.ai/conversationRequestId":"01a1b82503867dc9a59eebf43d351406","codebuddy.ai/modelRequestId":"01a1b82793ac7b129e333950170fd653","codebuddy.ai/llmMessageId":"01a1b82793ac7b129e333950170fd653","traceparent":"00-f944219030f6ae1de14748515e23871f-f61d0953c7333827-01","baggage":"codebuddy.session_id=01a1b824-ffca-72a9-8d1d-a82a9e9bca00,codebuddy.conversation_request_id=01a1b82503867dc9a59eebf43d351406"},"__timestamp":"2026-11-07T22:36:06.569Z"}
{"type":"user","uuid":"01a1b827-9e5e-70e2-a062-2fe5e8dcfdda","session_id":"01a1b824-ffca-72a9-8d1d-a82a9e9bca00","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-a854ba5cff723e28","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { fileURLToPath } from 'node:url'\n   6→\n   7→import { selectModels, usageSamples } from '../../lib/select.mjs'\n   8→import { buildForecast } from '../../lib/forecast.mjs'\n   9→import { HANDLE_SCHEMA, HEAVY_REJECT_RISKS, SELECTION_SCHEMA, heavyRejection } from '../../lib/select-draft.mjs'\n  10→\n  11→const ROOT = fileURLToPath(new URL('../../', import.meta.url))\n  12→const STATUS = { claude: { state: 'callable' } }\n  13→const HANDLE_KEYS = [\n  14→  'adapter',\n  15→  'call',\n  16→  'forecast',\n  17→  'id',\n  18→  'identity',\n  19→  'identity_group',\n  20→  'key',\n  21→  'level',\n  22→  'prices',\n  23→  'provider',\n  24→  'quota',\n  25→  'readonly',\n  26→  'schema',\n  27→  'vendor',\n  28→]\n  29→\n  30→function singleConfig() {\n  31→  return {\n  32→    providers: { claude: { cli: 'claude', readonly: true } },\n  33→    models: { quick: { provider: 'claude', id: 'q', level: 'Quick', identity: 'verified' } },\n  34→  }\n  35→}\n  36→\n  37→/** Twelve models of one provider; four of them never clear the pre-filter, so eight remain. */\n  38→function twelveConfig() {\n  39→  const models = {}\n  40→  for (let i = 0; i < 12; i += 1) {\n  41→    models[`m${i}`] = {\n  42→      provider: 'claude',\n  43→      id: `m${i}`,\n  44→      level: 'Quick',\n  45→      identity: 'verified',\n  46→      prices: { input_per_mtok: i + 1, output_per_mtok: 1 },\n  47→    }\n  48→  }\n  49→  models.m0.level = 'Top'\n  50→  models.m1.deprecated = true\n  51→  models.m2.identity = 'unverified'\n  52→  return { providers: { claude: { cli: 'claude', readonly: true } }, models }\n  53→}\n  54→\n  55→function goldenCases() {\n  56→  const file = path.join(ROOT, 'contracts', 'golden', 'quota-shapes.json')\n  57→  const golden = JSON.parse(fs.readFileSync(file, 'utf8'))\n  58→  return golden.cases.filter((item) => item.expected && item.expected.risk)\n  59→}\n  60→\n  61→/** One Quick model per golden case, each on its own provider with that case's quota. */\n  62→function goldenFixture(cases) {\n  63→  const providers = {}\n  64→  const models = {}\n  65→  const quotas = {}\n  66→  const byKey = {}\n  67→  cases.forEach((item, index) => {\n  68→    providers[`p${index}`] = { cli: `p${index}`, readonly: true }\n  69→    models[`m-${item.id}`] = { provider: `p${index}`, id: `x${index}`, level: 'Quick', identity: 'verified' }\n  70→    quotas[`p${index}`] = item.input.quota\n  71→    byKey[`m-${item.id}`] = item\n  72→  })\n  73→  const status = {}\n  74→  for (const provider of Object.keys(providers)) status[provider] = { state: 'callable' }\n  75→  const ctx = {\n  76→    forecast: (args) => buildForecast({\n  77→      quota: args.quota,\n  78→      samples: byKey[args.model].input.samples,\n  79→      usage: args.usage,\n  80→      now: 0,\n  81→    }),\n  82→  }\n  83→  return { config: { providers, models, quotas }, status, ctx, cases }\n  84→}\n  85→\n  86→test('[AC-020] a handle carries call but never cli', () => {\n  87→  const result = selectModels(singleConfig(), { level: 'Quick' }, { status: STATUS })\n  88→\n  89→  assert.equal(result.ok, true)\n  90→  assert.equal(result.schema, SELECTION_SCHEMA)\n  91→  const handle = result.models[0]\n  92→  assert.equal(handle.schema, HANDLE_SCHEMA)\n  93→  assert.deepEqual(Object.keys(handle).sort(), HANDLE_KEYS)\n  94→  assert.equal('cli' in handle, false)\n  95→  assert.equal('call' in handle, true)\n  96→  assert.deepEqual(result.calls[0], handle.call)\n  97→})\n  98→\n  99→test('[AC-020] forecast runs once per model that clears the pre-filter, whatever count and usage are', () => {\n 100→  const observed = []\n 101→  for (const usage of ['Normal', 'Light', 'Heavy']) {\n 102→    for (const count of [1, 3, 8]) {\n 103→      const seen = []\n 104→      const ctx = {\n 105→        forecast: (args) => {\n 106→          seen.push(args.model)\n 107→          return { risk: 'ok', tasks_left: 9 }\n 108→        },\n 109→      }\n 110→      selectModels(twelveConfig(), { level: 'Quick', count, usage, exclude: ['m3'] }, { status: STATUS, ctx })\n 111→      observed.push({ usage, count, size: seen.length, unique: new Set(seen).size })\n 112→    }\n 113→  }\n 114→\n 115→  assert.deepEqual(observed, observed.map((item) => ({ ...item, size: 8, unique: 8 })))\n 116→})\n 117→\n 118→test('[AC-020] every forecast call receives model, prices, quota, records, usage and now', () => {\n 119→  const records = [{ model: 'm4', input_tokens: 1000, output_tokens: 0, cost_usd: 0.2 }]\n 120→  const now = 1_700_000_000_000\n 121→  const seen = []\n 122→  const ctx = {\n 123→    now: () => now,\n 124→    forecast: (args) => {\n 125→      seen.push(args)\n 126→      return { risk: 'ok', tasks_left: 9 }\n 127→    },\n 128→  }\n 129→  const config = twelveConfig()\n 130→\n 131→  selectModels(config, { level: 'Quick', count: 1, exclude: ['m3'] }, { status: STATUS, usage: records, ctx })\n 132→\n 133→  assert.equal(seen.length, 8)\n 134→  for (const args of seen) {\n 135→    assert.equal(typeof args.model, 'string')\n 136→    assert.deepEqual(args.prices, config.models[args.model].prices)\n 137→    assert.equal(args.records, records)\n 138→    assert.equal(args.usage, 'Normal')\n 139→    assert.equal(args.now, now)\n 140→    assert.ok(Object.prototype.hasOwnProperty.call(args, 'quota'))\n 141→  }\n 142→})\n 143→\n 144→test('[AC-020] without ctx.forecast the default buildForecast path is used', () => {\n 145→  const now = 1_700_000_000_000\n 146→  const records = [\n 147→    { model: 'quick', input_tokens: 1_000_000, output_tokens: 500_000, cost_usd: 2 },\n 148→    { model: 'quick', input_tokens: 1_000_000, output_tokens: 500_000, cost_usd: 2 },\n 149→    { model: 'quick', input_tokens: 1_000_000, output_tokens: 500_000, cost_usd: 2 },\n 150→  ]\n 151→  const ctx = { now: () => now }\n 152→\n 153→  const result = selectModels(singleConfig(), { level: 'Quick' }, { status: STATUS, usage: records, ctx })\n 154→\n 155→  assert.equal(result.models.length, 1)\n 156→  assert.equal(result.models[0].forecast.schema, 'cliworker.forecast/v1')\n 157→  assert.equal(typeof result.models[0].forecast.risk, 'string')\n 158→})\n 159→\n 160→test('[AC-020] usageSamples filters by model and projects tokens and cost', () => {\n 161→  const records = [\n 162→    { model: 'a', input_tokens: 1_000_000, output_tokens: 500_000, cost_usd: 2 },\n 163→    { model: 'b', input_tokens: 10, output_tokens: 0, cost_usd: 1 },\n 164→    { model: 'a', input_tokens: 0, output_tokens: 0 },\n 165→    { model: 'a', input_tokens: 10, output_tokens: 0, cost_usd: '5' },\n 166→  ]\n 167→\n 168→  assert.deepEqual(usageSamples(records, 'a'), [\n 169→    { mtok: 1.5, cost_usd: 2 },\n 170→    { mtok: null, cost_usd: null },\n 171→    { mtok: 0.00001, cost_usd: null },\n 172→  ])\n 173→  assert.deepEqual(usageSamples('not-an-array', 'a'), [])\n 174→  assert.deepEqual(usageSamples(undefined, 'a'), [])\n 175→})\n 176→\n 177→test('[AC-021] Heavy rejects exactly the risky golden cases and Normal and Light reject none', () => {\n 178→  const cases = goldenCases()\n 179→  const { config, status, ctx } = goldenFixture(cases)\n 180→  const bad = HEAVY_REJECT_RISKS\n 181→  const expected = cases\n 182→    .filter((item) => bad.includes(item.expected.risk))\n 183→    .map((item) => `m-${item.id}`)\n 184→    .sort()\n 185→  assert.ok(expected.length >= 5)\n 186→\n 187→  const heavy = selectModels(config, { level: 'Quick', count: 10, usage: 'Heavy' }, { status, ctx })\n 188→  const rejected = heavy.rejected\n 189→    .filter((item) => item.reason === 'E_FORECAST_EXHAUSTION')\n 190→    .map((item) => item.key)\n 191→    .sort()\n 192→  assert.deepEqual(rejected, expected)\n 193→  assert.equal(heavy.rejected.length, expected.length)\n 194→  assert.deepEqual(\n 195→    heavy.models.map((item) => item.key).sort(),\n 196→    cases.map((item) => `m-${item.id}`).filter((key) => !expected.includes(key)).sort()\n 197→  )\n 198→\n 199→  for (const usage of ['Normal', 'Light']) {\n 200→    const result = selectModels(config, { level: 'Quick', count: 10, usage }, { status, ctx })\n 201→    assert.deepEqual(result.rejected.filter((item) => item.reason === 'E_FORECAST_EXHAUSTION'), [])\n 202→    assert.equal(result.rejected.length, 0)\n 203→    assert.equal(result.models.length, cases.length)\n 204→  }\n 205→})\n 206→\n 207→test('[AC-021] heavyRejection follows the risk list and the Heavy-only rule', () => {\n 208→  const forecast = (risk) => ({ risk })\n 209→\n 210→  for (const risk of ['exhausted', 'critical', 'low_reserve']) {\n 211→    assert.deepEqual(heavyRejection({ key: 'k', usage: 'Heavy', forecast: forecast(risk) }), {\n 212→      key: 'k',\n 213→      reason: 'E_FORECAST_EXHAUSTION',\n 214→      forecast: forecast(risk),\n 215→    })\n 216→  }\n 217→  assert.equal(heavyRejection({ key: 'k', usage: 'Heavy', forecast: forecast('ok') }), null)\n 218→  assert.equal(heavyRejection({ key: 'k', usage: 'Heavy', forecast: forecast('unknown') }), null)\n 219→  assert.equal(heavyRejection({ key: 'k', usage: 'Heavy', forecast: undefined }), null)\n 220→  assert.equal(heavyRejection({ key: 'k', usage: 'Normal', forecast: forecast('exhausted') }), null)\n 221→  assert.equal(heavyRejection({ key: 'k', usage: 'Light', forecast: forecast('critical') }), null)\n 222→  assert.deepEqual(HEAVY_REJECT_RISKS, ['exhausted', 'critical', 'low_reserve'])\n 223→})\n 224→\n 225→test('[AC-021] a real usage ledger row keeps the q-usd model selectable under Heavy', () => {\n 226→  const item = goldenCases().find((entry) => entry.id === 'q-usd')\n 227→  const key = 'golden-q-usd'\n 228→  const config = {\n 229→    providers: { claude: { cli: 'claude', readonly: true } },\n 230→    models: { [key]: { provider: 'claude', id: 'q-usd', level: 'Quick', identity: 'verified' } },\n 231→    quotas: { claude: item.input.quota },\n 232→  }\n 233→  const usage = item.input.samples.map((sample) => ({ model: key, cost_usd: sample.cost_usd }))\n 234→\n 235→  const result = selectModels(config, { level: 'Quick', usage: 'Heavy' }, { status: STATUS, usage })\n 236→\n 237→  assert.equal(result.rejected.length, 0)\n 238→  assert.equal(result.models.length, 1)\n 239→  assert.equal(result.models[0].forecast.risk, 'ok')\n 240→  assert.equal(result.models[0].forecast.tasks_left, item.expected.tasks_left)\n 241→})\n 242→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b82503867dc9a59eebf43d351406","_messageId":"01a1b82793ac7b129e333950170fd653","_meta":{"codebuddy.ai/conversationRequestId":"01a1b82503867dc9a59eebf43d351406","codebuddy.ai/modelRequestId":"01a1b82793ac7b129e333950170fd653","codebuddy.ai/llmMessageId":"01a1b82793ac7b129e333950170fd653","traceparent":"00-f944219030f6ae1de14748515e23871f-f61d0953c7333827-01","baggage":"codebuddy.session_id=01a1b824-ffca-72a9-8d1d-a82a9e9bca00,codebuddy.conversation_request_id=01a1b82503867dc9a59eebf43d351406"},"__timestamp":"2026-11-07T22:36:06.622Z"}
{"type":"user","uuid":"01a1b827-9e63-7ca2-8d83-31ecd660102d","session_id":"01a1b824-ffca-72a9-8d1d-a82a9e9bca00","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-80776c17cdf33667","content":[{"type":"text","text":"   1→import test from 'node:test'\n   2→import assert from 'node:assert/strict'\n   3→import fs from 'node:fs'\n   4→import path from 'node:path'\n   5→import { spawnSync } from 'node:child_process'\n   6→import { fileURLToPath } from 'node:url'\n   7→\n   8→import { scanPaths, scanSource } from '../../scripts/check-unused.mjs'\n   9→\n  10→const ROOT = fileURLToPath(new URL('../../', import.meta.url))\n  11→const FIXTURE = 'test/fixtures/unused'\n  12→const SCRIPT = 'scripts/check-unused.mjs'\n  13→\n  14→function key(item) {\n  15→  return `${item.file}|${item.kind}|${item.name}`\n  16→}\n  17→\n  18→function readExpected() {\n  19→  return JSON.parse(fs.readFileSync(path.join(ROOT, FIXTURE, 'expected.json'), 'utf8')).items\n  20→}\n  21→\n  22→function runCli(args) {\n  23→  return spawnSync(process.execPath, [SCRIPT, ...args], { cwd: ROOT, encoding: 'utf8' })\n  24→}\n  25→\n  26→test('[AC-022] scanPaths reports exactly the eight declarations of the fixture', () => {\n  27→  const report = scanPaths([FIXTURE], { root: ROOT })\n  28→  const expected = readExpected()\n  29→\n  30→  assert.equal(report.files, 3)\n  31→  assert.equal(report.items.length, 8)\n  32→  assert.deepEqual(report.items.map(key).sort(), expected.map(key).sort())\n  33→  assert.deepEqual(\n  34→    report.items,\n  35→    [...report.items].sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : a.line - b.line || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0)))\n  36→  )\n  37→})\n  38→\n  39→test('[AC-022] the clean fixture reports nothing', () => {\n  40→  const report = scanPaths([`${FIXTURE}/clean`], { root: ROOT })\n  41→  assert.equal(report.files, 1)\n  42→  assert.deepEqual(report.items, [])\n  43→})\n  44→\n  45→test('[AC-022] lib reports nothing', () => {\n  46→  const report = scanPaths(['lib'], { root: ROOT })\n  47→  assert.ok(report.files > 0)\n  48→  assert.deepEqual(report.items, [])\n  49→})\n  50→\n  51→test('[AC-022] the CLI exits 1 on the fixture and 0 on lib', () => {\n  52→  const dirty = runCli([FIXTURE])\n  53→  assert.equal(dirty.status, 1)\n  54→  assert.match(dirty.stdout, /^check-unused: FAIL \\(8 unused\\)$/m)\n  55→\n  56→  const json = runCli(['--json', FIXTURE])\n  57→  assert.equal(json.status, 1)\n  58→  const parsed = JSON.parse(json.stdout)\n  59→  assert.equal(parsed.files, 3)\n  60→  assert.deepEqual(parsed.items.map(key).sort(), readExpected().map(key).sort())\n  61→\n  62→  const lib = runCli([])\n  63→  assert.equal(lib.status, 0)\n  64→  const lines = lib.stdout.trim().split('\\n')\n  65→  assert.ok(lines[lines.length - 1].startsWith('check-unused: ok (files='))\n  66→})\n  67→\n  68→test('[AC-022] the CLI rejects unknown flags and missing paths with exit 2', () => {\n  69→  const unknown = runCli(['--no-such-flag'])\n  70→  assert.equal(unknown.status, 2)\n  71→  assert.match(unknown.stderr, /usage: node scripts\\/check-unused\\.mjs/)\n  72→  assert.equal(unknown.stdout.includes('check-unused: ok'), false)\n  73→\n  74→  const missing = runCli(['no/such/dir'])\n  75→  assert.equal(missing.status, 2)\n  76→  assert.match(missing.stderr, /usage: node scripts\\/check-unused\\.mjs/)\n  77→})\n  78→\n  79→test('[AC-022] scanSource ignores comments, strings and template text', () => {\n  80→  const source = [\n  81→    \"import { a, b, c, d } from './dep.mjs'\",\n  82→    '// a is mentioned in a comment',\n  83→    \"const text = 'b lives in a string'\",\n  84→    'const template = `c lives in template text`',\n  85→    'const used = `${d}`',\n  86→    'export { used }',\n  87→  ].join('\\n')\n  88→\n  89→  assert.deepEqual(scanSource(source), [\n  90→    { line: 1, kind: 'import', name: 'a' },\n  91→    { line: 1, kind: 'import', name: 'b' },\n  92→    { line: 1, kind: 'import', name: 'c' },\n  93→  ])\n  94→})\n  95→\n  96→test('[AC-022] scanSource treats obj.name as property access but spreads as references', () => {\n  97→  const propertyOnly = [\"import fs from 'node:fs'\", 'const holder = {}', 'export const value = holder.fs'].join('\\n')\n  98→  assert.deepEqual(scanSource(propertyOnly), [{ line: 1, kind: 'import', name: 'fs' }])\n  99→\n 100→  const spread = [\"import { join } from 'node:path'\", 'export const parts = [...join(\"a\")]'].join('\\n')\n 101→  assert.deepEqual(scanSource(spread), [])\n 102→})\n 103→\n 104→test('[AC-022] a regex literal with quotes does not disturb later scanning', () => {\n 105→  const source = [\n 106→    \"import { join } from 'node:path'\",\n 107→    'const re = /[\"\\']/',\n 108→    \"export const value = join('a', 'b')\",\n 109→  ].join('\\n')\n 110→  assert.deepEqual(scanSource(source), [])\n 111→})\n 112→\n 113→test('[AC-022] export lists and self-recursion follow the documented rules', () => {\n 114→  const exportList = [\"import { a } from './dep.mjs'\", 'export { a as b }'].join('\\n')\n 115→  assert.deepEqual(scanSource(exportList), [])\n 116→\n 117→  const recursive = ['function spin(n) {', '  return n > 0 ? spin(n - 1) : 0', '}'].join('\\n')\n 118→  assert.deepEqual(scanSource(recursive), [{ line: 1, kind: 'function', name: 'spin' }])\n 119→\n 120→  const exported = ['export function kept() {', '  return 1', '}'].join('\\n')\n 121→  assert.deepEqual(scanSource(exported), [])\n 122→})\n 123→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a1b82503867dc9a59eebf43d351406","_messageId":"01a1b82793ac7b129e333950170fd653","_meta":{"codebuddy.ai/conversationRequestId":"01a1b82503867dc9a59eebf43d351406","codebuddy.ai/modelRequestId":"01a1b82793ac7b129e333950170fd653","codebuddy.ai/llmMessageId":"01a1b82793ac7b129e333950170fd653","traceparent":"00-f944219030f6ae1de14748515e23871f-f61d0953c7333827-01","baggage":"codebuddy.session_id=01a1b824-ffca-72a9-8d1d-a82a9e9bca