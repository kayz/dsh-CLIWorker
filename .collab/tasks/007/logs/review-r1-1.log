}\n 149→\n 150→    if (Object.prototype.hasOwnProperty.call(node, 'enum')) {\n 151→      const list = node.enum\n 152→      if (!Array.isArray(list) || !list.some((item) => deepSame(item, value))) {\n 153→        push(pointer, 'enum', 'value is not in the enum')\n 154→      }\n 155→    }\n 156→\n 157→    if (Object.prototype.hasOwnProperty.call(node, 'const')) {\n 158→      if (!deepSame(node.const, value)) push(pointer, 'const', 'value does not equal const')\n 159→    }\n 160→\n 161→    if (typeof value === 'string') {\n 162→      if (typeof node.minLength === 'number' && value.length < node.minLength) {\n 163→        push(pointer, 'minLength', `string is shorter than ${node.minLength}`)\n 164→      }\n 165→      if (typeof node.maxLength === 'number' && value.length > node.maxLength) {\n 166→        push(pointer, 'maxLength', `string is longer than ${node.maxLength}`)\n 167→      }\n 168→      if (typeof node.pattern === 'string' && !new RegExp(node.pattern).test(value)) {\n 169→        push(pointer, 'pattern', `string does not match ${node.pattern}`)\n 170→      }\n 171→    }\n 172→\n 173→    if (typeof value === 'number') {\n 174→      if (typeof node.minimum === 'number' && value < node.minimum) {\n 175→        push(pointer, 'minimum', `number is smaller than ${node.minimum}`)\n 176→      }\n 177→      if (typeof node.maximum === 'number' && value > node.maximum) {\n 178→        push(pointer, 'maximum', `number is larger than ${node.maximum}`)\n 179→      }\n 180→    }\n 181→\n 182→    if (Array.isArray(value)) {\n 183→      if (typeof node.minItems === 'number' && value.length < node.minItems) {\n 184→        push(pointer, 'minItems', `array is shorter than ${node.minItems}`)\n 185→      }\n 186→      if (typeof node.maxItems === 'number' && value.length > node.maxItems) {\n 187→        push(pointer, 'maxItems', `array is longer than ${node.maxItems}`)\n 188→      }\n 189→      if (node.uniqueItems === true) {\n 190→        const strings = value.map((item) => 