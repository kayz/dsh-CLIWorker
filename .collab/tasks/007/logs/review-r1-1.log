{"type":"user","uuid":"01a1b826-cb82-781c-8afc-475022a2f6ad","session_id":"01a1b824-ffca-72a9-8d1d-a82a9e9bca00","message":{"content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-ac70f4caf8a9ef56","content":[{"type":"text","text":"   1→// Minimal JSON Schema subset used to validate the contract files. Pure functions only:\n   2→// no imports, no IO. The caller supplies schemas and a cross-file loader.\n   3→\n   4→const ANNOTATIONS = new Set([\n   5→  '$schema',\n   6→  '$id',\n   7→  'title',\n   8→  'description',\n   9→  '$defs',\n  10→  'examples',\n  11→  'default',\n  12→])\n  13→\n  14→const SUPPORTED = new Set([\n  15→  'type',\n  16→  'enum',\n  17→  'const',\n  18→  'required',\n  19→  'properties',\n  20→  'additionalProperties',\n  21→  'items',\n  22→  'minItems',\n  23→  'maxItems',\n  24→  'uniqueItems',\n  25→  'minLength',\n  26→  'maxLength',\n  27→  'pattern',\n  28→  'minimum',\n  29→  'maximum',\n  30→  '$ref',\n  31→])\n  32→\n  33→const MAX_DEPTH = 64\n  34→\n  35→const TYPE_NAMES = new Set(['object', 'array', 'string', 'number', 'integer', 'boolean', 'null'])\n  36→\n  37→function escapePointer(value) {\n  38→  return String(value).replace(/~/g, '~0').replace(/\\//g, '~1')\n  39→}\n  40→\n  41→function childPath(pointer, key) {\n  42→  return `${pointer}/${escapePointer(key)}`\n  43→}\n  44→\n  45→function matchesType(type, value) {\n  46→  if (!TYPE_NAMES.has(type)) throw new TypeError(`unsupported type: ${type}`)\n  47→  if (type === 'integer') return typeof value === 'number' && Number.isInteger(value)\n  48→  if (type === 'number') return typeof value === 'number'\n  49→  if (type === 'array') return Array.isArray(value)\n  50→  if (type === 'object') return value !== null && typeof value === 'object' && !Array.isArray(value)\n  51→  if (type === 'null') return value === null\n  52→  return typeof value === type\n  53→}\n  54→\n  55→function schemaKeywords(schema) {\n  56→  return Object.keys(schema).filter((key) => !ANNOTATIONS.has(key))\n  57→}\n  58→\n  59→export function checkSchema(schema) {\n  60→  const problems = []\n  61→\n  62→  function walk(node, pointer) {\n  63→    if (!node || typeof node !== 'object' || Array.isArray(node)) return\n  64→    for (const key of schemaKeywords(node)) {\n  65→      if (!SUPPORTED.has(key)) problems.push(`${pointer}: ${key}`)\n  66→    }\n  67→    if (node.$defs && typeof node.$defs === 'object') {\n  68→      for (const name of Object.keys(node.$defs)) {\n  69→        walk(node.$defs[name], childPath(`${pointer}/$defs`, name))\n  70→      }\n  71→    }\n  72→    if (node.properties && typeof node.properties === 'object') {\n  73→      for (const name of Object.keys(node.properties)) {\n  74→        walk(node.properties[name], childPath(`${pointer}/properties`, name))\n  75→      }\n  76→    }\n  77→    if (node.additionalProperties && typeof node.additionalProperties === 'object') {\n  78→      walk(node.additionalProperties, `${pointer}/additionalProperties`)\n  79→    }\n  80→    if (node.items && typeof node.items === 'object' && !Array.isArray(node.items)) {\n  81→      walk(node.items, `${pointer}/items`)\n  82→    }\n  83→  }\n  84→\n  85→  walk(schema, '')\n  86→  return problems\n  87→}\n  88→\n  89→function resolveRef(ref, currentRoot, loadSchema) {\n  90→  if (typeof ref !== 'string') throw new TypeError(`$ref must be a string`)\n  91→  const hash = ref.indexOf('#')\n  92→  const filePart = hash === -1 ? ref : ref.slice(0, hash)\n  93→  const pointerPart = hash === -1 ? '' : ref.slice(hash + 1)\n  94→  let target = currentRoot\n  95→  if (filePart !== '') {\n  96→    if (typeof loadSchema !== 'function') throw new TypeError(`cannot resolve $ref without loadSchema: ${ref}`)\n  97→    target = loadSchema(filePart)\n  98→    if (!target || typeof target !== 'object') throw new TypeError(`cannot resolve $ref: ${ref}`)\n  99→  }\n 100→  if (pointerPart === '') return { schema: target, root: target }\n 101→  const match = /^\\/\\$defs\\/([^/]+)