Hash('sha256').update(buf).digest('hex'); }\n\nconst baseTree = treeOfCommit(BASE);\nconst headTree = treeOfCommit(HEAD);\nconst baseMap = new Map(); walkTree(baseTree, '', baseMap);\nconst headMap = new Map(); walkTree(headTree, '', headMap);\n\nconst added = [], removed = [], modified = [];\nfor (const [k, v] of headMap) if (!baseMap.has(k)) added.push(k); else if (baseMap.get(k) !== v) modified.push(k);\nfor (const k of baseMap.keys()) if (!headMap.has(k)) removed.push(k);\n\nconsole.log('=== base tracked files:', baseMap.size, '| head tracked files:', headMap.size, '===');\nconsole.log('ADDED (' + added.length + '):'); added.sort().forEach(x => console.log('  + ' + x));\nconsole.log('REMOVED (' + removed.length + '):'); removed.sort().forEach(x => console.log('  - ' + x));\nconsole.log('MODIFIED (' + modified.length + '):'); modified.sort().forEach(x => console.log('  M ' + x));\n\n// Compare worktree files with HEAD blobs (detect uncommitted changes / content drift)\nconsole.log('=== worktree vs HEAD content check for changed files ===');\nfor (const k of [...added, ...modified].sort()) {\n  const wtPath = path.join(WT, k);\n  let wbuf = null;\n  try { wbuf = fs.readFileSync(wtPath); } catch { /* missing */ }\n  const hbuf = readObj(headMap.get(k)).body;\n  const eq = wbuf && norm(wbuf) === norm(hbuf);\n  console.log('  ' + k + ': wtMatchesHEAD=' + eq);\n}\n\n// Must-be-unchanged files (AC-06,07,11,27, golden frozen, non-write-scope lib files)\nconsole.log('=== must-be-unchanged: base == HEAD == worktree ===');\nconst mustEqual = [\n  'test/characterization/defects.json',\n  'test/unit/select.test.mjs',\n  'test/characterization/defects/a1-quota.test.mjs',\n  'package.json',\n  'package-lock.json',\n  'contracts/golden/quota-shapes.json',\n  'lib/forecast.mjs',\n  'lib/pools.mjs',\n  'lib/context.mjs',\n  'lib/commands/models/select.mjs',\n  'lib/index.js',\n];\nfor (const k of mustEqual) {\n  const b = baseMap.has(k) ? readObj(baseMap.get(k)).body : null;\n  c