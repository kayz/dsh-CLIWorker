d be touched). Hash comparison is stronger.\n\nLet me do the git object approach. Let me first verify zlib works on git objects.\n\nPlan for the Node script:\n```js\nconst fs = require('node:fs'), zlib = require('node:zlib'), path = require('node:path'), crypto = require('node:crypto');\nconst gitdir = 'C:/git/dsh-CLIWorker/.git';\nfunction readObj(sha) {\n  const p = path.join(gitdir, 'objects', sha.slice(0,2), sha.slice(2));\n  const raw = zlib.inflateSync(fs.readFileSync(p));\n  const nul = raw.indexOf(0);\n  const header = raw.slice(0, nul).toString(); // \"commit <size>\" etc\n  const body = raw.slice(nul+1);\n  return { type: header.split(' ')[0], body };\n}\nfunction parseTree(body) {\n  const entries = [];\n  let i = 0;\n  while (i < body.length) {\n    const sp = body.indexOf(32, i); // space\n    const mode = body.slice(i, sp).toString();\n    const nul = body.indexOf(0, sp);\n    const name = body.slice(sp+1, nul).toString();\n    const sha = body.slice(nul+1, nul+21).toString('hex');\n    entries.push({mode, name, sha});\n    i = nul+21;\n  }\n  return entries;\n}\n```\nThen walk from commit tree to get blob for path.\n\nLet me implement `getBlobAtPath(commitSha, filePath)`:\n```js\nfunction commitTree(sha) {\n  const c = readObj(sha);\n  const m = /tree ([0-9a-f]{40})/.exec(c.body.toString());\n  return m[1];\n}\nfunction findPath(treeSha, parts) {\n  let sha = treeSha;\n  for (const part of parts) {\n    const t = readObj(sha);\n    const entries = parseTree(t.body);\n    const e = entries.find(x => x.name === part);\n    if (!e) return null;\n    sha = e.sha;\n  }\n  return sha; // blob sha\n}\nfunction blobContent(sha) { return readObj(sha).body; }\n```\n\nThen compare with worktree file (with CRLF→LF normalization maybe).\n\nLet me do this. I'll compute a list of specific files:\n- lib/select.mjs (changed — expected)\n- lib/select-draft.mjs (new)\n- lib/contract/validate.mjs (should differ by exactly 7 lines)\n- scripts/check-unused.mjs (new)\n- tes