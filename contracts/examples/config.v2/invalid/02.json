{
  "expect": { "path": "/secrets/kimi/ref", "keyword": "pattern" },
  "document": {
    "schema": "cliworker.config/v2",
    "state_dir": "./state",
    "secrets": { "kimi": { "ref": "KIMI_API_KEY" } },
    "discovery": {
      "extra_dirs": [],
      "wsl": false,
      "probe_unknown": false,
      "unknown_patterns": [],
      "cli_overrides": {}
    },
    "catalog": { "allow": [], "levels": {}, "aliases": {}, "deprecated": {}, "manual": [] },
    "pools": [],
    "policy": {
      "probe_ttl_s": 21600,
      "lease_ttl_s": 7200,
      "reading_ttl_s": 600,
      "lock_stale_ms": 30000,
      "lock_wait_ms": 5000,
      "lock_poll_ms": 50,
      "session_ttl_s": 43200,
      "reserve_fraction_for_high": 0.15,
      "unknown_policy": "after_known",
      "usage_estimate_mtok": { "Heavy": 2, "Normal": 0.5, "Light": 0.1 },
      "cache_read_weight": 0,
      "probe_schedule": null
    }
  }
}
