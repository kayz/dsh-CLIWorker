{
  "schema": "cliworker.config/v2",
  "state_dir": "./state",
  "secrets": { "kimi": { "ref": "env:KIMI_API_KEY" } },
  "discovery": {
    "extra_dirs": [],
    "wsl": true,
    "probe_unknown": false,
    "unknown_patterns": ["*-cli", "*agent*"],
    "cli_overrides": {}
  },
  "catalog": { "allow": [], "levels": {}, "aliases": {}, "deprecated": {}, "manual": [] },
  "pools": [
    {
      "id": "claude:plan-5h",
      "cli": "claude",
      "kind": "plan_window",
      "funding": "plan",
      "window": {
        "length_s": 18000,
        "anchor": "rolling",
        "start_at": "2026-11-07T07:00:00Z",
        "reset_at": "2026-11-07T12:00:00Z",
        "reset_source": "cli"
      },
      "capacity_mtok": {
        "claude:claude-sonnet-5-5": { "value": 10, "source": "measured", "confidence": "medium" }
      },
      "used_fraction": { "value": 0.5, "source": "cli", "at": "2026-11-07T09:55:00Z" },
      "credits_per_mtok": null
    }
  ],
  "policy": {
    "probe_ttl_s": 21600,
    "lease_ttl_s": 7200,
    "reading_ttl_s": 600,
    "lock_stale_ms": 30000,
    "lock_wait_ms": 5000,
    "lock_poll_ms": 50,
    "session_ttl_s": 43200,
    "reserve_fraction_for_high": 0.15,
    "unknown_policy": "after_known",
    "usage_estimate_mtok": { "Heavy": 2, "Normal": 0.5, "Light": 0.1 },
    "cache_read_weight": 0,
    "probe_schedule": null
  }
}
