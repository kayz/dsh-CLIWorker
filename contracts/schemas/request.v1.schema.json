{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.v1.schema.json",
  "title": "cliworker.request/v1",
  "type": "object",
  "required": ["schema", "level"],
  "properties": {
    "schema": { "const": "cliworker.request/v1" },
    "request_id": { "type": "string" },
    "level": { "enum": ["Top", "High", "Middle", "Quick"] },
    "count": { "type": "integer", "minimum": 1, "maximum": 10 },
    "usage": { "enum": ["Heavy", "Normal", "Light"] },
    "importance": { "enum": ["normal", "high"] },
    "require_readonly": { "type": "boolean" },
    "cwd": { "type": "string" },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "exclude_handles": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
