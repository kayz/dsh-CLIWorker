{
  "name": "dsh-cliworker",
  "version": "0.1.0",
  "description": "DSH plugin: independent CLI/model layer for AgentLine (providers, models, availability, cost, selection).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-fast.mjs",
    "perf": "node scripts/run-tests.mjs --perf",
    "snapshot:update": "node scripts/run-tests.mjs --update-snapshots"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
